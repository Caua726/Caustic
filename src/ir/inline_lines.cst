// Where an instruction copied into another function was written. Its `line` is
// then BASE + k: entry k of this table, (the function it came from, the line
// there). Only kept when line rows are emitted.
use "opt_mem.cst" as om;
use "../../std/mem.cst" only core as mem;

let is i32 as BASE with imut = 100000;       // above every plain line (emit_driver.cst)

struct Origin { name as *u8; nlen as i32; line as i32; next as i32; }

let is *Origin as tab with mut = cast(*Origin, 0);
let is i32 as count with mut = 0;
let is i32 as cap with mut = 0;
let is *i32 as heads with mut = cast(*i32, 0);
let is i32 as HEADS with imut = 4096;

fn get(line as i32) as *Origin { return &tab[line - BASE]; }

fn _add(name as *u8, nlen as i32, line as i32) as i32 {
    if (cast(i64, heads) == 0) {
        heads = cast(*i32, om.opt_alloc(cast(i64, HEADS) * 4));
        let is i32 as z with mut = 0;
        while (z < HEADS) { heads[z] = 0 - 1; z = z + 1; }
    }
    let is i64 as h = (cast(i64, name) >> 4) + cast(i64, line) * 31;
    let is i32 as b = cast(i32, h & cast(i64, HEADS - 1));
    let is i32 as k with mut = heads[b];
    while (k >= 0) {
        if (cast(i64, tab[k].name) == cast(i64, name) && tab[k].line == line) { return BASE + k; }
        k = tab[k].next;
    }
    if (count >= cap) {
        let is i32 as nc with mut = cap * 2;
        if (nc < 256) { nc = 256; }
        let is *Origin as nt = cast(*Origin, om.opt_alloc(cast(i64, nc) * sizeof(Origin)));
        if (count > 0) { mem.memcpy(cast(*u8, nt), cast(*u8, tab), cast(i64, count) * sizeof(Origin)); om.opt_free(cast(*u8, tab)); }
        tab = nt; cap = nc;
    }
    tab[count].name = name; tab[count].nlen = nlen;
    tab[count].line = line;
    tab[count].next = heads[b];
    heads[b] = count;
    count = count + 1;
    return BASE + count - 1;
}

// `line` of an instruction of function `name`, copied in place of a call at
// line `at` of another function.
fn copied(line as i32, name as *u8, nlen as i32, at as i32) as i32 {
    if (line <= 0) { return at; }
    if (line >= BASE) { return line; }          // copied before: its own function's
    return _add(name, nlen, line);
}
