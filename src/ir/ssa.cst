use "defs.cst" as d;
use "cfg.cst" as cfg;
use "dom.cst" as dom;
use "phi.cst" as phi;

// === SSA mem2reg pass ===
// Promotes scalar stack variables (accessed via IR_LOAD/IR_STORE with IMM offsets)
// to SSA vregs with phi nodes, then destructs SSA back to conventional form.

let is i32 as MAX_SLOTS with imut = 256;

// === Step 0: Find promotable stack slots ===

struct SlotInfo {
    offset as i64;
    type_ptr as *u8;
    promotable as i32;
    store_count as i32;
    load_count as i32;
}

fn find_promotable(func as *d.IRFunction, slots as *SlotInfo, out_count as *i32) as void {
    let is i32 as count with mut = 0;

    // Pass 1: collect address-taken offsets (IR_ADDR with IMM). Sized from a
    // count first: the old fixed [256]i64 stopped recording past the 256th, and
    // an offset missing from this list means a local whose address is taken is
    // never marked non-promotable — it gets promoted, and the code reading it
    // through the pointer sees a stale value. Silent miscompile, not a rejection.
    let is i32 as at_total with mut = 0;
    let is *d.IRInst as cnt with mut = func.instructions;
    while (cast(i64, cnt) != 0) {
        if (cnt.is_dead == 0 && cnt.op == d.IR_ADDR && cnt.src1.op_type == d.OP_IMM) {
            at_total = at_total + 1;
        }
        cnt = cnt.next;
    }
    let is *i64 as addr_taken = cast(*i64, d.opt_alloc(cast(i64, at_total) * 8 + 8));
    let is i32 as at_count with mut = 0;
    let is *d.IRInst as pre with mut = func.instructions;
    while (cast(i64, pre) != 0) {
        if (pre.is_dead == 0 && pre.op == d.IR_ADDR && pre.src1.op_type == d.OP_IMM) {
            let is *i64 as ap = cast(*i64, cast(i64, addr_taken) + cast(i64, at_count) * 8);
            *ap = pre.src1.imm;
            at_count = at_count + 1;
        }
        pre = pre.next;
    }

    // Pass 2: scan LOAD/STORE with IMM offsets, skip address-taken
    let is *d.IRInst as inst with mut = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 0) {
            let is i64 as off with mut = 0 - 1;
            let is *u8 as ty with mut = cast(*u8, 0);
            let is i32 as is_store with mut = 0;

            if (inst.op == d.IR_LOAD && inst.src1.op_type == d.OP_IMM) {
                off = inst.src1.imm;
                ty = inst.cast_to;
            }
            if (inst.op == d.IR_STORE && inst.dest.op_type == d.OP_IMM) {
                off = inst.dest.imm;
                ty = inst.cast_to;
                is_store = 1;
            }

            if (off >= 0) {
                // Find or add slot
                let is i32 as idx with mut = cast(i32, 0 - 1);
                let is i32 as si with mut = 0;
                while (si < count) {
                    let is *SlotInfo as s = cast(*SlotInfo, cast(i64, slots) + cast(i64, si) * sizeof(SlotInfo));
                    if (s.offset == off) { idx = si; si = count; }
                    si = si + 1;
                }
                if (idx < 0 && count < MAX_SLOTS) {
                    idx = count;
                    let is *SlotInfo as s = cast(*SlotInfo, cast(i64, slots) + cast(i64, idx) * sizeof(SlotInfo));
                    s.offset = off;
                    s.type_ptr = ty;
                    s.promotable = 1;
                    s.store_count = 0;
                    s.load_count = 0;
                    count = count + 1;
                }
                if (idx >= 0) {
                    let is *SlotInfo as s = cast(*SlotInfo, cast(i64, slots) + cast(i64, idx) * sizeof(SlotInfo));
                    if (is_store == 1) { s.store_count = s.store_count + 1; }
                    else { s.load_count = s.load_count + 1; }
                    if (cast(i64, ty) != 0) { s.type_ptr = ty; }
                }
            }
        }
        inst = inst.next;
    }

    // Mark address-taken slots as non-promotable
    let is i32 as ai with mut = 0;
    while (ai < at_count) {
        let is i64 as addr_off = *(cast(*i64, cast(i64, addr_taken) + cast(i64, ai) * 8));
        let is i32 as si with mut = 0;
        while (si < count) {
            let is *SlotInfo as s = cast(*SlotInfo, cast(i64, slots) + cast(i64, si) * sizeof(SlotInfo));
            if (s.offset == addr_off) { s.promotable = 0; si = count; }
            si = si + 1;
        }
        ai = ai + 1;
    }

    d.opt_free(cast(*u8, addr_taken));
    *out_count = count;
}

// Offset -> promotable-slot-index lookup. Offsets below OFF_MAP_MAX go through
// a direct-mapped table; the rest through a list sorted by offset. Every
// promotable slot is reachable, whatever its offset: a slot past the table
// used to read as "not promotable" here while insert_phis still placed phis
// for it, so a scalar declared after a large local array stayed in memory.
let is i32 as OFF_MAP_MAX with imut = 8192;

struct OffMap {
    map as *i32;
    far_off as *i64;
    far_idx as *i32;
    nfar as i32;
}

fn build_off_map(slots as *SlotInfo, count as i32) as *OffMap {
    let is *OffMap as m = cast(*OffMap, d.opt_alloc(sizeof(OffMap)));
    m.map = cast(*i32, d.opt_alloc(cast(i64, OFF_MAP_MAX) * 4));
    m.far_off = cast(*i64, d.opt_alloc(cast(i64, count + 1) * 8));
    m.far_idx = cast(*i32, d.opt_alloc(cast(i64, count + 1) * 4));
    m.nfar = 0;
    let is i32 as i with mut = 0;
    while (i < OFF_MAP_MAX) {
        let is *i32 as p = cast(*i32, cast(i64, m.map) + cast(i64, i) * 4);
        *p = cast(i32, 0 - 1);
        i = i + 1;
    }
    i = 0;
    while (i < count) {
        let is *SlotInfo as s = cast(*SlotInfo, cast(i64, slots) + cast(i64, i) * sizeof(SlotInfo));
        if (s.promotable == 1 && s.offset >= 0) {
            if (s.offset < cast(i64, OFF_MAP_MAX)) {
                let is *i32 as p = cast(*i32, cast(i64, m.map) + cast(i64, s.offset) * 4);
                *p = i;
            } else {
                // insertion sort by offset (count <= MAX_SLOTS)
                let is i32 as b with mut = m.nfar - 1;
                while (b >= 0 && *(cast(*i64, cast(i64, m.far_off) + cast(i64, b) * 8)) > s.offset) {
                    let is *i64 as d_off = cast(*i64, cast(i64, m.far_off) + cast(i64, b + 1) * 8);
                    *d_off = *(cast(*i64, cast(i64, m.far_off) + cast(i64, b) * 8));
                    let is *i32 as d_idx = cast(*i32, cast(i64, m.far_idx) + cast(i64, b + 1) * 4);
                    *d_idx = *(cast(*i32, cast(i64, m.far_idx) + cast(i64, b) * 4));
                    b = b - 1;
                }
                let is *i64 as ko = cast(*i64, cast(i64, m.far_off) + cast(i64, b + 1) * 8); *ko = s.offset;
                let is *i32 as ki = cast(*i32, cast(i64, m.far_idx) + cast(i64, b + 1) * 4); *ki = i;
                m.nfar = m.nfar + 1;
            }
        }
        i = i + 1;
    }
    return m;
}

fn free_off_map(m as *OffMap) as void {
    d.opt_free(cast(*u8, m.map));
    d.opt_free(cast(*u8, m.far_off));
    d.opt_free(cast(*u8, m.far_idx));
    d.opt_free(cast(*u8, m));
}

fn fast_slot_index(m as *OffMap, off as i64) as i32 {
    if (off < 0) { return cast(i32, 0 - 1); }
    if (off >= cast(i64, OFF_MAP_MAX)) { return slot_bsearch(m.far_off, m.far_idx, m.nfar, off); }
    let is *i32 as p = cast(*i32, cast(i64, m.map) + cast(i64, off) * 4);
    return *p;
}

// Exact offset -> promotable-slot-index lookup over a (offset, idx) array kept
// sorted by offset. Unlike the direct-mapped off_map this handles any offset
// (including frames > OFF_MAP_MAX), so it matches the old exact `imm == offset`
// comparison for every slot. Returns -1 if no promotable slot owns `off`.
fn slot_bsearch(srt_off as *i64, srt_idx as *i32, np as i32, off as i64) as i32 {
    let is i32 as lo with mut = 0;
    let is i32 as hi with mut = np - 1;
    while (lo <= hi) {
        let is i32 as mid = lo + (hi - lo) / 2;
        let is i64 as mo = *(cast(*i64, cast(i64, srt_off) + cast(i64, mid) * 8));
        if (mo == off) { return *(cast(*i32, cast(i64, srt_idx) + cast(i64, mid) * 4)); }
        if (mo < off) { lo = mid + 1; } else { hi = mid - 1; }
    }
    return cast(i32, 0 - 1);
}

// === SSA construction ===
//
// The variables put into SSA form are the promotable stack slots (what mem2reg
// always did) and the vregs defined more than once — the copies an earlier
// round's phis left, a value assigned on several paths. Phis go at the
// iterated dominance frontier of each variable's definition blocks (Cytron et
// al.), as IR_PHI instructions right after their block's label; the renaming
// walk over the dominator tree then turns each load of a promoted slot into a
// copy of the reaching value, drops the stores, gives every definition of a
// multi-def vreg a fresh vreg and points each use at the reaching one. A slot
// read before any store keeps its load; a vreg read where no definition
// reaches keeps its name. Phi arguments start undefined (-1) and are filled in
// from each predecessor as the walk leaves it.
//
// Variable ids: a promotable slot is its slot index (< nslots); multi-def vreg
// number k is nslots + k.

// Growable i32 vector.
struct IVec {
    p as *i32;
    n as i32;
    cap as i32;
}

fn iv_init(v as *IVec, cap as i32) as void {
    let is i32 as c with mut = cap;
    if (c < 8) { c = 8; }
    v.p = cast(*i32, d.opt_alloc(cast(i64, c) * 4));
    v.n = 0;
    v.cap = c;
}

fn iv_push(v as *IVec, x as i32) as void {
    if (v.n >= v.cap) {
        let is i32 as nc = v.cap * 2;
        let is *i32 as np = cast(*i32, d.opt_alloc(cast(i64, nc) * 4));
        let is i32 as k with mut = 0;
        while (k < v.n) { np[k] = v.p[k]; k = k + 1; }
        d.opt_free(cast(*u8, v.p));
        v.p = np;
        v.cap = nc;
    }
    v.p[v.n] = x;
    v.n = v.n + 1;
}

fn iv_free(v as *IVec) as void { d.opt_free(cast(*u8, v.p)); }

fn _bb(blocks as *cfg.BasicBlock, b as i32) as *cfg.BasicBlock {
    return cast(*cfg.BasicBlock, cast(i64, blocks) + cast(i64, b) * sizeof(cfg.BasicBlock));
}

// start[k] = cnt[0] + ... + cnt[k-1] for k in 0..n, then cnt[] = 0. The sum
// is carried through start[] itself: the -O2 vectorizer takes the usual
// `start[k] = tot; tot = tot + cnt[k]` for a plain reduction and drops the
// stores.
fn prefix_sums(cnt as *i32, start as *i32, n as i32) as void {
    start[0] = 0;
    let is i32 as k with mut = 0;
    while (k < n) { start[k + 1] = start[k] + cnt[k]; k = k + 1; }
    k = 0;
    while (k < n) { cnt[k] = 0; k = k + 1; }
}

// Dominance frontiers as lists df[df_start[b] .. df_start[b+1]), in the order
// the frontier walk finds them: join blocks ascending, then predecessors in
// order. A block joins a runner's frontier once (the last block added to it is
// the only possible repeat, since one join block is handled at a time).
fn build_df(blocks as *cfg.BasicBlock, nb as i32, preds as *i32, pred_start as *i32, pred_count as *i32,
            df_start as *i32) as *i32 {
    let is *i32 as last = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is *i32 as cnt = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is i32 as pass with mut = 0;
    let is *i32 as df with mut = cast(*i32, 0);
    while (pass < 2) {
        let is i32 as k with mut = 0;
        while (k < nb) { last[k] = 0 - 1; if (pass == 0) { cnt[k] = 0; } k = k + 1; }
        if (pass == 1) {
            prefix_sums(cnt, df_start, nb);
            df = cast(*i32, d.opt_alloc(cast(i64, df_start[nb] + 1) * 4));
        }
        let is i32 as bi with mut = 0;
        while (bi < nb) {
            if (pred_count[bi] >= 2) {
                let is i32 as idom = _bb(blocks, bi).idom;
                let is i32 as pi with mut = 0;
                while (pi < pred_count[bi]) {
                    let is i32 as runner with mut = preds[pred_start[bi] + pi];
                    while (runner != idom && runner >= 0) {
                        if (last[runner] != bi) {
                            last[runner] = bi;
                            if (pass == 1) { df[df_start[runner] + cnt[runner]] = bi; }
                            cnt[runner] = cnt[runner] + 1;
                        }
                        runner = _bb(blocks, runner).idom;
                    }
                    pi = pi + 1;
                }
            }
            bi = bi + 1;
        }
        pass = pass + 1;
    }
    d.opt_free(cast(*u8, last));
    d.opt_free(cast(*u8, cnt));
    return df;
}

// Does `inst` write its dest vreg? (STORE/COPY read dest as an address.)
fn dest_is_def(inst as *d.IRInst) as i32 {
    if (inst.dest.op_type != d.OP_VREG) { return 0; }
    let is i32 as op = inst.op;
    if (op == d.IR_STORE || op == d.IR_COPY || op == d.IR_ATOMIC_STORE || op == d.IR_CMOV
        || op == d.IR_VSTOREQ || op == d.IR_VSTOREQ256) { return 0; }
    return 1;
}

// The single-block form: no phis, the reaching store is the last one above.
fn promote_one_block(func as *d.IRFunction, slots as *SlotInfo, nslots as i32) as void {
    let is *OffMap as sb_off_map = build_off_map(slots, nslots);
    let is i32 as oi with mut = 0;
    let is *i32 as cur_def = cast(*i32, d.opt_alloc(cast(i64, nslots + 1) * 4));
    while (oi < nslots) { cur_def[oi] = 0 - 1; oi = oi + 1; }
    let is *d.IRInst as sb_inst with mut = func.instructions;
    while (cast(i64, sb_inst) != 0) {
        if (sb_inst.is_dead == 0) {
            if (sb_inst.op == d.IR_LOAD && sb_inst.src1.op_type == d.OP_IMM) {
                let is i32 as sb_sidx = fast_slot_index(sb_off_map, sb_inst.src1.imm);
                if (sb_sidx >= 0 && cur_def[sb_sidx] >= 0) { load_to_copy(sb_inst, cur_def[sb_sidx]); }
            }
            if (sb_inst.op == d.IR_STORE && sb_inst.dest.op_type == d.OP_IMM) {
                let is i32 as sb_sidx = fast_slot_index(sb_off_map, sb_inst.dest.imm);
                if (sb_sidx >= 0) {
                    if (sb_inst.src1.op_type == d.OP_VREG) { cur_def[sb_sidx] = sb_inst.src1.vreg; }
                    sb_inst.is_dead = 1;
                }
            }
        }
        sb_inst = sb_inst.next;
    }
    d.opt_free(cast(*u8, cur_def));
    free_off_map(sb_off_map);
}

// A load of a promoted slot becomes a copy of the value v that reaches it; a
// narrow one re-truncates and extends it (CAST from the slot's own type).
fn load_to_copy(inst as *d.IRInst, v as i32) as void {
    let is i32 as need_cast with mut = 0;
    if (cast(i64, inst.cast_to) != 0) {
        let is *i32 as szp = cast(*i32, cast(i64, inst.cast_to) + 28);
        if (*szp < 8) { need_cast = 1; }
    }
    if (need_cast == 1) {
        inst.op = d.IR_CAST;
        inst.cast_from = inst.cast_to;
    } else {
        inst.op = d.IR_MOV;
    }
    inst.src1.op_type = d.OP_VREG;
    inst.src1.vreg = v;
}

// Undo log of the renaming walk: (variable, value it had before).
let is IVec as un_var with mut;
let is IVec as un_old with mut;

fn _def(cur as *i32, var as i32, v as i32) as void {
    iv_push(&un_var, var);
    iv_push(&un_old, cur[var]);
    cur[var] = v;
}

fn _use(o as *d.Operand, var_of as *i32, vc0 as i32, cur as *i32) as void {
    if (o.op_type != d.OP_VREG) { return; }
    let is i32 as v = o.vreg;
    if (v < 0 || v >= vc0) { return; }
    let is i32 as x = var_of[v];
    if (x < 0) { return; }
    if (cur[x] >= 0) { o.vreg = cur[x]; }
}

// Build SSA form for func. promote: also promote stack slots (off under -g,
// where locals must stay in their slots for the debug info).
fn build(func as *d.IRFunction, promote as i32) as void {
    let is i32 as vc0 = func.vreg_count;
    if (vc0 == 0) { return; }

    // Step 0: promotable slots
    let is *SlotInfo as slots = cast(*SlotInfo, d.opt_alloc(cast(i64, MAX_SLOTS) * sizeof(SlotInfo)));
    let is i32 as nslots with mut = 0;
    if (promote == 1) { find_promotable(func, slots, &nslots); }
    let is i32 as any_promo with mut = 0;
    let is i32 as si with mut = 0;
    while (si < nslots) {
        let is *SlotInfo as s = cast(*SlotInfo, cast(i64, slots) + cast(i64, si) * sizeof(SlotInfo));
        if (s.promotable == 1) { any_promo = 1; }
        si = si + 1;
    }

    // Step 1: vregs defined more than once
    let is *i32 as var_of = cast(*i32, d.opt_alloc(cast(i64, vc0) * 4));
    let is i32 as v with mut = 0;
    while (v < vc0) { var_of[v] = 0; v = v + 1; }
    let is *d.IRInst as it with mut = func.instructions;
    while (cast(i64, it) != 0) {
        if (it.is_dead == 0 && dest_is_def(it) == 1 && it.dest.vreg >= 0 && it.dest.vreg < vc0) {
            var_of[it.dest.vreg] = var_of[it.dest.vreg] + 1;
        }
        it = it.next;
    }
    let is i32 as nmd with mut = 0;
    let is i32 as md_defs with mut = 0;
    v = 0;
    while (v < vc0) {
        if (var_of[v] >= 2) { md_defs = md_defs + var_of[v]; var_of[v] = nslots + nmd; nmd = nmd + 1; }
        else { var_of[v] = 0 - 1; }
        v = v + 1;
    }
    if (any_promo == 0 && nmd == 0) {
        d.opt_free(cast(*u8, slots)); d.opt_free(cast(*u8, var_of));
        return;
    }

    // Step 2: CFG
    let is i32 as cfg_cap = cfg.count_blocks(func) + 1;
    let is *cfg.BasicBlock as blocks = cast(*cfg.BasicBlock, d.opt_alloc(cast(i64, cfg_cap) * sizeof(cfg.BasicBlock)));
    let is i32 as lc = func.label_count + 1;
    let is *i32 as label_to_bb = cast(*i32, d.opt_alloc(cast(i64, lc) * 4));
    let is i32 as li with mut = 0;
    while (li < lc) { label_to_bb[li] = 0; li = li + 1; }
    let is i32 as nb with mut = 0;
    cfg.build_cfg(func, blocks, cfg_cap, &nb, label_to_bb);
    if (nb <= 1) {
        // One block: no phis; vregs stay as they are.
        if (any_promo == 1) { promote_one_block(func, slots, nslots); }
        d.opt_free(cast(*u8, slots)); d.opt_free(cast(*u8, var_of));
        d.opt_free(cast(*u8, blocks)); d.opt_free(cast(*u8, label_to_bb));
        return;
    }
    let is *i32 as preds = cast(*i32, d.opt_alloc(cast(i64, nb * 2 + 4) * 4));
    let is *i32 as pred_start = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is *i32 as pred_count = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    cfg.build_preds(blocks, nb, preds, pred_start, pred_count);
    let is *i32 as rpo = cast(*i32, d.opt_alloc(cast(i64, nb) * 4));
    let is i32 as rpo_n with mut = 0;
    cfg.compute_rpo(blocks, nb, rpo, &rpo_n);
    dom.compute_idom(blocks, nb, rpo, rpo_n, preds, pred_start, pred_count);
    let is *i32 as df_start = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is *i32 as df = build_df(blocks, nb, preds, pred_start, pred_count, df_start);

    // Every block gets a label: a phi names its predecessors by label.
    phi.ssa_begin(func);
    phi.ssa_label_blocks(func, blocks, nb);

    // Step 3: definition blocks of each variable, ascending
    let is i32 as nvars = nslots + nmd;
    let is *OffMap as off_map = build_off_map(slots, nslots);
    let is *i32 as dstamp = cast(*i32, d.opt_alloc(cast(i64, nvars + 1) * 4));
    let is *i32 as dcnt = cast(*i32, d.opt_alloc(cast(i64, nvars + 1) * 4));
    let is *i32 as dstart = cast(*i32, d.opt_alloc(cast(i64, nvars + 1) * 4));
    let is *i32 as dblk with mut = cast(*i32, 0);
    let is i32 as pass with mut = 0;
    while (pass < 2) {
        let is i32 as x with mut = 0;
        while (x < nvars) { dstamp[x] = 0 - 1; if (pass == 0) { dcnt[x] = 0; } x = x + 1; }
        if (pass == 1) {
            prefix_sums(dcnt, dstart, nvars);
            dblk = cast(*i32, d.opt_alloc(cast(i64, dstart[nvars] + 1) * 4));
        }
        let is i32 as b with mut = 0;
        while (b < nb) {
            let is *cfg.BasicBlock as bb = _bb(blocks, b);
            let is *d.IRInst as ins with mut = bb.first;
            let is i32 as done with mut = 0;
            while (done == 0) {
                if (ins.is_dead == 0) {
                    let is i32 as var with mut = 0 - 1;
                    if (ins.op == d.IR_STORE && ins.dest.op_type == d.OP_IMM) {
                        var = fast_slot_index(off_map, ins.dest.imm);
                    } else if (dest_is_def(ins) == 1 && ins.dest.vreg >= 0 && ins.dest.vreg < vc0) {
                        var = var_of[ins.dest.vreg];
                    }
                    if (var >= 0 && dstamp[var] != b) {
                        dstamp[var] = b;
                        if (pass == 1) { dblk[dstart[var] + dcnt[var]] = b; }
                        dcnt[var] = dcnt[var] + 1;
                    }
                }
                if (cast(i64, ins) == cast(i64, bb.last)) { done = 1; } else { ins = ins.next; }
            }
            b = b + 1;
        }
        pass = pass + 1;
    }

    // Step 4: phis at the iterated dominance frontiers
    let is *i64 as ptail = cast(*i64, d.opt_alloc(cast(i64, nb) * 8));
    let is *i32 as has_phi = cast(*i32, d.opt_alloc(cast(i64, nb) * 4));
    let is i32 as b with mut = 0;
    while (b < nb) { ptail[b] = cast(i64, _bb(blocks, b).first); has_phi[b] = 0 - 1; b = b + 1; }
    let is IVec as wl;
    iv_init(&wl, 64);
    let is i32 as vc_slot_phis with mut = func.vreg_count;
    let is i32 as x with mut = 0;
    while (x < nvars) {
        wl.n = 0;
        let is i32 as k with mut = dstart[x];
        while (k < dstart[x + 1]) { iv_push(&wl, dblk[k]); k = k + 1; }
        let is i32 as wi with mut = 0;
        while (wi < wl.n) {
            let is i32 as db = wl.p[wi];
            let is i32 as fi with mut = df_start[db];
            while (fi < df_start[db + 1]) {
                let is i32 as fb = df[fi];
                if (has_phi[fb] != x) {
                    has_phi[fb] = x;
                    let is i32 as pv = func.vreg_count;
                    func.vreg_count = func.vreg_count + 1;
                    let is *d.IRInst as p = phi.phi_new(pv, pred_count[fb]);
                    p.dest.imm = cast(i64, x);
                    if (x < nslots) {
                        let is *SlotInfo as slot = cast(*SlotInfo, cast(i64, slots) + cast(i64, x) * sizeof(SlotInfo));
                        phi.phi_mark_slot(p);
                        if (cast(i64, slot.type_ptr) != 0) {
                            let is *i32 as szp = cast(*i32, cast(i64, slot.type_ptr) + 28);
                            if (*szp < 8) { p.cast_to = slot.type_ptr; p.cast_from = slot.type_ptr; }
                        }
                    }
                    let is i32 as pi with mut = 0;
                    while (pi < pred_count[fb]) {
                        let is *cfg.BasicBlock as pbb = _bb(blocks, preds[pred_start[fb] + pi]);
                        let is i32 as pl = pbb.first.dest.label;
                        if (phi.phi_find(p, pl) < 0) { phi.phi_add(p, pl, 0 - 1); }
                        pi = pi + 1;
                    }
                    let is *cfg.BasicBlock as fbb = _bb(blocks, fb);
                    let is *d.IRInst as at = cast(*d.IRInst, ptail[fb]);
                    cfg.insert_after(at, p);
                    if (cast(i64, at) == cast(i64, fbb.last)) { fbb.last = p; }
                    ptail[fb] = cast(i64, p);
                    iv_push(&wl, fb);
                }
                fi = fi + 1;
            }
            wi = wi + 1;
        }
        x = x + 1;
        if (x == nslots) { vc_slot_phis = func.vreg_count; }
    }
    if (nslots == 0) { vc_slot_phis = vc0; }
    iv_free(&wl);

    // Step 5: rename, walking the dominator tree
    let is i32 as orig_n = func.vreg_count + md_defs + 1;
    let is *i32 as orig = cast(*i32, d.opt_alloc(cast(i64, orig_n) * 4));
    let is i32 as oi with mut = 0;
    while (oi < orig_n) { orig[oi] = 0 - 1; oi = oi + 1; }
    // a multi-def vreg's phis are versions of it
    let is *i32 as var_vreg = cast(*i32, d.opt_alloc(cast(i64, nmd + 1) * 4));
    v = 0;
    while (v < vc0) { if (var_of[v] >= 0) { var_vreg[var_of[v] - nslots] = v; } v = v + 1; }
    it = func.instructions;
    while (cast(i64, it) != 0) {
        if (it.op == d.IR_PHI && cast(i32, it.dest.imm) >= nslots) {
            orig[it.dest.vreg] = var_vreg[cast(i32, it.dest.imm) - nslots];
        }
        it = it.next;
    }

    // dominator tree children, ascending
    let is *i32 as ch_start = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is *i32 as ch_cnt = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is *i32 as ch = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    b = 0;
    while (b < nb) { ch_cnt[b] = 0; b = b + 1; }
    b = 1;
    while (b < nb) { let is i32 as id = _bb(blocks, b).idom; if (id >= 0) { ch_cnt[id] = ch_cnt[id] + 1; } b = b + 1; }
    prefix_sums(ch_cnt, ch_start, nb);
    b = 1;
    while (b < nb) {
        let is i32 as id = _bb(blocks, b).idom;
        if (id >= 0) { ch[ch_start[id] + ch_cnt[id]] = b; ch_cnt[id] = ch_cnt[id] + 1; }
        b = b + 1;
    }

    let is *i32 as cur = cast(*i32, d.opt_alloc(cast(i64, nvars + 1) * 4));
    x = 0;
    while (x < nvars) { cur[x] = 0 - 1; x = x + 1; }
    iv_init(&un_var, 256);
    iv_init(&un_old, 256);
    let is *i32 as fr_b = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is *i32 as fr_c = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is *i32 as fr_u = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is i32 as sp with mut = 1;
    fr_b[0] = 0; fr_c[0] = 0; fr_u[0] = 0;
    while (sp > 0) {
        let is i32 as top = sp - 1;
        let is i32 as bk = fr_b[top];
        let is *cfg.BasicBlock as bb = _bb(blocks, bk);
        if (fr_c[top] == 0) {
            fr_u[top] = un_var.n;
            let is *d.IRInst as ins with mut = bb.first;
            let is i32 as done with mut = 0;
            while (done == 0) {
                if (ins.is_dead == 0) {
                    if (ins.op == d.IR_PHI) {
                        _def(cur, cast(i32, ins.dest.imm), ins.dest.vreg);
                    } else {
                        _use(&ins.src1, var_of, vc0, cur);
                        _use(&ins.src2, var_of, vc0, cur);
                        if (ins.op == d.IR_STORE || ins.op == d.IR_COPY) { _use(&ins.dest, var_of, vc0, cur); }
                        if (ins.op == d.IR_LOAD && ins.src1.op_type == d.OP_IMM) {
                            let is i32 as sidx = fast_slot_index(off_map, ins.src1.imm);
                            if (sidx >= 0 && cur[sidx] >= 0) { load_to_copy(ins, cur[sidx]); }
                        } else if (ins.op == d.IR_STORE && ins.dest.op_type == d.OP_IMM) {
                            let is i32 as sidx = fast_slot_index(off_map, ins.dest.imm);
                            if (sidx >= 0) {
                                if (ins.src1.op_type == d.OP_VREG) { _def(cur, sidx, ins.src1.vreg); }
                                ins.is_dead = 1;
                            }
                        } else if (dest_is_def(ins) == 1 && ins.dest.vreg >= 0 && ins.dest.vreg < vc0
                                   && var_of[ins.dest.vreg] >= 0) {
                            let is i32 as nv = func.vreg_count;
                            func.vreg_count = func.vreg_count + 1;
                            orig[nv] = ins.dest.vreg;
                            _def(cur, var_of[ins.dest.vreg], nv);
                            ins.dest.vreg = nv;
                        }
                    }
                }
                if (cast(i64, ins) == cast(i64, bb.last)) { done = 1; } else { ins = ins.next; }
            }
            // arguments of the successors' phis on the edges from this block
            let is i32 as bl = bb.first.dest.label;
            let is i32 as sk with mut = 0;
            while (sk < 2) {
                let is i32 as su with mut = bb.succ0;
                if (sk == 1) { su = bb.succ1; if (su == bb.succ0) { su = 0 - 1; } }
                if (su >= 0) {
                    let is *cfg.BasicBlock as sbb = _bb(blocks, su);
                    let is *d.IRInst as p with mut = sbb.first.next;
                    let is i32 as pdone with mut = 0;
                    if (cast(i64, sbb.first) == cast(i64, sbb.last)) { pdone = 1; }
                    while (pdone == 0) {
                        if (p.op != d.IR_PHI) { pdone = 1; }
                        else {
                            let is i32 as ai = phi.phi_find(p, bl);
                            if (ai >= 0) { phi.phi_set_val(p, ai, cur[cast(i32, p.dest.imm)]); }
                            if (cast(i64, p) == cast(i64, sbb.last)) { pdone = 1; } else { p = p.next; }
                        }
                    }
                }
                sk = sk + 1;
            }
        }
        if (fr_c[top] < ch_cnt[bk]) {
            let is i32 as child = ch[ch_start[bk] + fr_c[top]];
            fr_c[top] = fr_c[top] + 1;
            fr_b[sp] = child; fr_c[sp] = 0; fr_u[sp] = un_var.n;
            sp = sp + 1;
        } else {
            // leave the block: restore what it defined
            while (un_var.n > fr_u[top]) {
                un_var.n = un_var.n - 1;
                un_old.n = un_old.n - 1;
                cur[un_var.p[un_var.n]] = un_old.p[un_old.n];
            }
            sp = sp - 1;
        }
    }
    // the variable ids parked in the phis' dest.imm are no longer needed
    it = func.instructions;
    while (cast(i64, it) != 0) {
        if (it.op == d.IR_PHI) { it.dest.imm = 0; }
        it = it.next;
    }
    phi.ssa_set_versions(orig, orig_n, func.vreg_count, vc_slot_phis);

    iv_free(&un_var); iv_free(&un_old);
    d.opt_free(cast(*u8, fr_b)); d.opt_free(cast(*u8, fr_c)); d.opt_free(cast(*u8, fr_u));
    d.opt_free(cast(*u8, cur));
    d.opt_free(cast(*u8, ch_start)); d.opt_free(cast(*u8, ch_cnt)); d.opt_free(cast(*u8, ch));
    d.opt_free(cast(*u8, var_vreg));
    d.opt_free(cast(*u8, ptail)); d.opt_free(cast(*u8, has_phi));
    d.opt_free(cast(*u8, dstamp)); d.opt_free(cast(*u8, dcnt)); d.opt_free(cast(*u8, dstart));
    if (cast(i64, dblk) != 0) { d.opt_free(cast(*u8, dblk)); }
    free_off_map(off_map);
    d.opt_free(cast(*u8, df)); d.opt_free(cast(*u8, df_start));
    d.opt_free(cast(*u8, rpo));
    d.opt_free(cast(*u8, preds)); d.opt_free(cast(*u8, pred_start)); d.opt_free(cast(*u8, pred_count));
    d.opt_free(cast(*u8, blocks)); d.opt_free(cast(*u8, label_to_bb));
    d.opt_free(cast(*u8, slots)); d.opt_free(cast(*u8, var_of));
}

// mem2reg as the optimizer has always called it: SSA in, copies out.
fn mem2reg(func as *d.IRFunction) as void {
    build(func, 1);
    phi.ssa_destroy(func);
}
