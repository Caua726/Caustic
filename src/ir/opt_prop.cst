use "defs.cst" as d;
use "../../std/mem.cst" as _fillmem;
use "opt_helpers.cst" as oh;
use "phi.cst" as phi;

// === Block-local copy propagation ===
//
// The global pass above follows copies only when the source has a single
// definition. After mem2reg the IR reads every loop variable through a fresh
// copy of a multi-def vreg (`MOV v6 = v4; NE v7 = v6, v5`, with v4 redefined
// on the back edge), so those copies all survive to the register allocator.
//
// Inside one block the question is simpler: from `MOV a = b` until the next
// definition of a or of b, a and b hold the same bits, so a use of a may read b
// instead. Facts die at a label a jump names (another path may enter there)
// and when either side is redefined. IR_MOV is a plain 64-bit copy in every
// backend, so no type check is needed. The copies left without uses are
// removed by DCE.
//
// On the SSA form nothing is redefined, but the members of a web (a vreg's
// versions, a phi with its arguments) become one vreg at destruction: a
// definition of a member ends the facts about every member, so that a use is
// never moved past another member's definition, where the two would overlap.
// A label no jump names is entered only by falling into it and ends nothing.
// Phi arguments are left alone: the copy they read is joined to the phi's
// web.
//
// LCP_MAX bounds the facts live at once so a long block stays linear.
let is i32 as LCP_MAX with imut = 64;

fn _lcp_root(web as *i32, v as i32, n as i32) as i32 {
    if (cast(i64, web) == 0 || v < 0 || v >= n) { return v; }
    return web[v];
}

fn _lcp_kill(v as i32, src_of as *i32, active as *i32, n_active as *i32, web as *i32, n as i32) as void {
    // v is redefined: drop its own fact and every fact that copies from it.
    let is i32 as rv = _lcp_root(web, v, n);
    let is i32 as k with mut = 0;
    while (k < *n_active) {
        let is i32 as a = active[k];
        if (a == v || src_of[a] == v || _lcp_root(web, a, n) == rv || _lcp_root(web, src_of[a], n) == rv) {
            src_of[a] = 0 - 1;
            *n_active = *n_active - 1;
            active[k] = active[*n_active];
        } else {
            k = k + 1;
        }
    }
}

fn _lcp_clear(src_of as *i32, active as *i32, n_active as *i32) as void {
    let is i32 as k with mut = 0;
    while (k < *n_active) { src_of[active[k]] = 0 - 1; k = k + 1; }
    *n_active = 0;
}

fn _lcp_sub(o as *d.Operand, src_of as *i32, vc as i32) as void {
    if (o.op_type != d.OP_VREG) { return; }
    let is i32 as v = o.vreg;
    if (v < 0 || v >= vc) { return; }
    if (src_of[v] >= 0) { o.vreg = src_of[v]; }
}

fn _lcp_lref(o as *d.Operand, refd as *u8, nl as i32) as void {
    if (o.op_type == d.OP_LABEL && o.label >= 0 && o.label < nl) { refd[o.label] = cast(u8, 1); }
}

fn pass_local_copy_prop(func as *d.IRFunction) as void {
    let is i32 as vc = func.vreg_count;
    if (vc == 0) { return; }
    let is *i32 as src_of = cast(*i32, d.opt_alloc(cast(i64, vc) * 4));
    _fillmem.memset(cast(*u8, src_of), 255, cast(i64, vc) * 4);   // every entry -1
    let is *i32 as active = cast(*i32, d.opt_alloc(cast(i64, LCP_MAX) * 4));
    let is i32 as n_active with mut = 0;
    // labels something refers to
    let is i32 as nl = func.label_count + 1;
    let is *u8 as refd = d.opt_alloc(cast(i64, nl + 1));
    _fillmem.memset(refd, 0, cast(i64, nl));
    let is i32 as any_phi with mut = 0;
    let is *d.IRInst as inst with mut = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 0 && inst.op != d.IR_LABEL) {
            _lcp_lref(&inst.dest, refd, nl);
            _lcp_lref(&inst.src1, refd, nl);
            _lcp_lref(&inst.src2, refd, nl);
        }
        if (inst.op == d.IR_PHI) { any_phi = 1; }
        inst = inst.next;
    }
    let is *i32 as web with mut = cast(*i32, 0);
    if (any_phi == 1 || phi.ssa_active == 1) { web = phi.ssa_web_uf(func); }

    inst = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 0) {
            let is i32 as op = inst.op;
            if (op == d.IR_LABEL) {
                let is i32 as lb = inst.dest.label;
                if (lb < 0 || lb >= nl || refd[lb] == cast(u8, 1)) { _lcp_clear(src_of, active, &n_active); }
            } else if (op == d.IR_PHI) {
                // a phi is a definition (its block's label already ended the facts)
                if (inst.dest.op_type == d.OP_VREG && inst.dest.vreg >= 0 && inst.dest.vreg < vc) {
                    _lcp_kill(inst.dest.vreg, src_of, active, &n_active, web, vc);
                }
            } else {
                // Uses first: they read the values from before this instruction.
                _lcp_sub(&inst.src1, src_of, vc);
                _lcp_sub(&inst.src2, src_of, vc);
                // STORE and COPY read dest as an address; they define nothing.
                let is i32 as dest_is_use = op == d.IR_STORE || op == d.IR_COPY;
                if (dest_is_use == 1) { _lcp_sub(&inst.dest, src_of, vc); }
                // Then the definition, which ends the facts it overwrites.
                if (dest_is_use == 0 && inst.dest.op_type == d.OP_VREG && inst.dest.vreg >= 0 && inst.dest.vreg < vc) {
                    let is i32 as dv = inst.dest.vreg;
                    _lcp_kill(dv, src_of, active, &n_active, web, vc);
                    if (op == d.IR_MOV && inst.src1.op_type == d.OP_VREG && inst.src1.vreg != dv
                        && inst.src1.vreg >= 0 && inst.src1.vreg < vc && n_active < LCP_MAX) {
                        src_of[dv] = inst.src1.vreg;
                        active[n_active] = dv;
                        n_active = n_active + 1;
                    }
                }
            }
        }
        inst = inst.next;
    }
    if (cast(i64, web) != 0) { d.opt_free(cast(*u8, web)); }
    d.opt_free(refd);
    d.opt_free(cast(*u8, active));
    d.opt_free(cast(*u8, src_of));
}

// === Copies of a value defined once (-O2, after SSA destruction) ===
//
// `MOV v = u` with v and u each defined once: u's definition comes before
// v's, which comes before every read of v, and u never changes, so every read
// of v may read u. Block-local copy propagation stops at the first label; this
// one reaches the reads in other blocks (an address copied before a loop and
// read inside it). The copies are left dead.
//
// Except a copy that splits a value's life at a loop: the copy sits right
// before a loop's head and is read only inside that loop, which makes no
// call, and the value it copies lives across a call that more values live
// across than there are callee-saved registers (5). Some of those go to the
// stack; read whole, the value is one of the cheapest to put there, and every
// read of it in the loop would load it back. The copy can take any register
// the loop leaves free.
let is i32 as SCP_SAVED with imut = 5;

fn _scp_isp(a as *i32, i as i32) as *i32 { return cast(*i32, cast(i64, a) + cast(i64, i) * 4); }
fn _scp_get(a as *i32, i as i32) as i32 { return *_scp_isp(a, i); }
fn _scp_put(a as *i32, i as i32, v as i32) as void { *_scp_isp(a, i) = v; }

fn _scp_is_call(op as i32) as i32 {
    if (op == d.IR_CALL || op == d.IR_CALL_INDIRECT || op == d.IR_FFI_CALL || op == d.IR_SYSCALL) { return 1; }
    return 0;
}

// A read of x at position k: x lives from its first definition (or the head
// of the loop it is read in before that) to k, or to the end of the outermost
// loop around k that it enters from outside.
fn _scp_read(x as i32, k as i32, vc as i32, st as *i32, endp as *i32, minr as *i32, maxr as *i32,
             inner as *i32, par as *i32, hend as *i32) as void {
    if (x < 0 || x >= vc) { return; }
    let is i32 as s with mut = _scp_get(st, x);
    if (s < 0) { return; }
    let is i32 as e with mut = k;
    let is i32 as h with mut = _scp_get(inner, k);
    if (k < s) {
        if (h >= 0) { s = h; e = _scp_get(hend, h); }
        else { s = k; }
        _scp_put(st, x, s);
    }
    while (h >= 0 && h > s) {
        if (_scp_get(hend, h) > e) { e = _scp_get(hend, h); }
        h = _scp_get(par, h);
    }
    if (e > _scp_get(endp, x)) { _scp_put(endp, x, e); }
    if (_scp_get(minr, x) < 0 || k < _scp_get(minr, x)) { _scp_put(minr, x, k); }
    if (k > _scp_get(maxr, x)) { _scp_put(maxr, x, k); }
}

fn _scp_keep_splits(func as *d.IRFunction, vc as i32, src as *i32) as void {
    let is i32 as nl with mut = func.label_count + 1;
    let is i32 as n with mut = 0;
    let is *d.IRInst as it with mut = func.instructions;
    while (cast(i64, it) != 0) {
        if (it.op == d.IR_LABEL && it.dest.label >= nl) { nl = it.dest.label + 1; }
        n = n + 1;
        it = it.next;
    }
    let is *i32 as lpos = cast(*i32, d.opt_alloc(cast(i64, nl) * 4));
    // per position: calls before it, end of the loop headed there, innermost
    // loop around it, the loop around that one, the loop entered from it
    // through copies and labels only, values live across it, heavy calls
    // before it
    let is *i32 as ncall = cast(*i32, d.opt_alloc(cast(i64, n + 2) * 4));
    let is *i32 as hend = cast(*i32, d.opt_alloc(cast(i64, n + 2) * 4));
    let is *i32 as inner = cast(*i32, d.opt_alloc(cast(i64, n + 2) * 4));
    let is *i32 as par = cast(*i32, d.opt_alloc(cast(i64, n + 2) * 4));
    let is *i32 as nxl = cast(*i32, d.opt_alloc(cast(i64, n + 2) * 4));
    let is *i32 as live = cast(*i32, d.opt_alloc(cast(i64, n + 2) * 4));
    let is *i32 as heavy = cast(*i32, d.opt_alloc(cast(i64, n + 2) * 4));
    let is *u8 as kind = d.opt_alloc(cast(i64, n) + 2);
    let is *i32 as st = cast(*i32, d.opt_alloc(cast(i64, vc) * 4));
    let is *i32 as endp = cast(*i32, d.opt_alloc(cast(i64, vc) * 4));
    let is *i32 as minr = cast(*i32, d.opt_alloc(cast(i64, vc) * 4));
    let is *i32 as maxr = cast(*i32, d.opt_alloc(cast(i64, vc) * 4));
    let is *i32 as stk = cast(*i32, d.opt_alloc(cast(i64, n + 2) * 4));
    let is i32 as i with mut = 0;
    while (i < nl) { _scp_put(lpos, i, 0 - 1); i = i + 1; }
    i = 0;
    while (i <= n + 1) {
        _scp_put(ncall, i, 0); _scp_put(hend, i, 0 - 1); _scp_put(inner, i, 0 - 1); _scp_put(par, i, 0 - 1);
        _scp_put(nxl, i, 0 - 1); _scp_put(live, i, 0); _scp_put(heavy, i, 0); kind[i] = cast(u8, 0);
        i = i + 1;
    }
    i = 0;
    while (i < vc) {
        _scp_put(st, i, 0 - 1); _scp_put(endp, i, 0 - 1); _scp_put(minr, i, 0 - 1); _scp_put(maxr, i, 0 - 1);
        i = i + 1;
    }
    // labels, calls, first definitions, loops (a label to its last jump back)
    let is i32 as k with mut = 0;
    it = func.instructions;
    while (cast(i64, it) != 0) {
        let is i32 as c with mut = 0;
        if (it.is_dead == 1 || it.op == d.IR_MOV) { kind[k] = cast(u8, 2); }
        if (it.is_dead == 0) {
            let is i32 as op = it.op;
            if (op == d.IR_LABEL && it.dest.label >= 0) { _scp_put(lpos, it.dest.label, k); kind[k] = cast(u8, 1); }
            if (_scp_is_call(op) == 1) { c = 1; }
            if ((op == d.IR_JMP || op == d.IR_JZ || op == d.IR_JNZ) && it.dest.op_type == d.OP_LABEL
                && it.dest.label >= 0 && it.dest.label < nl) {
                let is i32 as l = _scp_get(lpos, it.dest.label);
                if (l >= 0 && l <= k && k > _scp_get(hend, l)) { _scp_put(hend, l, k); }
            }
            if (it.dest.op_type == d.OP_VREG && it.dest.vreg >= 0 && it.dest.vreg < vc
                && op != d.IR_STORE && op != d.IR_COPY && op != d.IR_ATOMIC_STORE && op != d.IR_CMOV
                && op != d.IR_VSTOREQ && op != d.IR_VSTOREQ256 && _scp_get(st, it.dest.vreg) < 0) {
                _scp_put(st, it.dest.vreg, k); _scp_put(endp, it.dest.vreg, k);
            }
        }
        _scp_put(ncall, k + 1, _scp_get(ncall, k) + c);
        k = k + 1;
        it = it.next;
    }
    // loop nesting
    let is i32 as sp with mut = 0;
    k = 0;
    while (k < n) {
        while (sp > 0 && _scp_get(hend, _scp_get(stk, sp - 1)) < k) { sp = sp - 1; }
        if (_scp_get(hend, k) >= 0) {
            if (sp > 0) { _scp_put(par, k, _scp_get(stk, sp - 1)); }
            _scp_put(stk, sp, k); sp = sp + 1;
        }
        if (sp > 0) { _scp_put(inner, k, _scp_get(stk, sp - 1)); }
        k = k + 1;
    }
    k = n - 1;
    while (k >= 0) {
        if (kind[k] == cast(u8, 1) && _scp_get(hend, k) >= 0) { _scp_put(nxl, k, k); }
        else if (kind[k] != cast(u8, 0)) { _scp_put(nxl, k, _scp_get(nxl, k + 1)); }
        k = k - 1;
    }
    // how far each value lives, and where each one is read
    k = 0;
    it = func.instructions;
    while (cast(i64, it) != 0) {
        if (it.is_dead == 0) {
            if (it.src1.op_type == d.OP_VREG) { _scp_read(it.src1.vreg, k, vc, st, endp, minr, maxr, inner, par, hend); }
            if (it.src2.op_type == d.OP_VREG) { _scp_read(it.src2.vreg, k, vc, st, endp, minr, maxr, inner, par, hend); }
            let is i32 as op = it.op;
            if ((op == d.IR_STORE || op == d.IR_COPY || op == d.IR_ATOMIC_STORE || op == d.IR_CMOV
                 || op == d.IR_VSTOREQ || op == d.IR_VSTOREQ256) && it.dest.op_type == d.OP_VREG) {
                _scp_read(it.dest.vreg, k, vc, st, endp, minr, maxr, inner, par, hend);
            }
        }
        k = k + 1;
        it = it.next;
    }
    // values live across each position (strictly inside their lives), and
    // the calls more of them live across than there are saved registers
    i = 0;
    while (i < vc) {
        let is i32 as s = _scp_get(st, i);
        let is i32 as e = _scp_get(endp, i);
        if (s >= 0 && e > s + 1) {
            _scp_put(live, s + 1, _scp_get(live, s + 1) + 1);
            _scp_put(live, e, _scp_get(live, e) - 1);
        }
        i = i + 1;
    }
    let is i32 as run with mut = 0;
    k = 0;
    while (k < n) {
        run = run + _scp_get(live, k);
        let is i32 as hv with mut = 0;
        if (_scp_get(ncall, k + 1) > _scp_get(ncall, k) && run > SCP_SAVED) { hv = 1; }
        _scp_put(heavy, k + 1, _scp_get(heavy, k) + hv);
        k = k + 1;
    }
    i = 0;
    while (i < vc) {
        let is i32 as u = _scp_get(src, i);
        let is i32 as cp = _scp_get(st, i);
        if (u >= 0 && cp >= 0 && _scp_get(st, u) >= 0 && _scp_get(minr, i) >= 0) {
            let is i32 as l = _scp_get(nxl, cp + 1);
            if (l >= 0) {
                let is i32 as j = _scp_get(hend, l);
                let is i32 as hu = _scp_get(heavy, _scp_get(endp, u)) - _scp_get(heavy, _scp_get(st, u) + 1);
                if (_scp_get(minr, i) >= l && _scp_get(maxr, i) <= j
                    && _scp_get(ncall, j + 1) - _scp_get(ncall, l) == 0 && hu > 0) {
                    _scp_put(src, i, 0 - 1);
                }
            }
        }
        i = i + 1;
    }
    d.opt_free(cast(*u8, lpos)); d.opt_free(cast(*u8, ncall)); d.opt_free(cast(*u8, hend));
    d.opt_free(cast(*u8, inner)); d.opt_free(cast(*u8, par)); d.opt_free(cast(*u8, nxl));
    d.opt_free(cast(*u8, live)); d.opt_free(cast(*u8, heavy)); d.opt_free(kind);
    d.opt_free(cast(*u8, st)); d.opt_free(cast(*u8, endp));
    d.opt_free(cast(*u8, minr)); d.opt_free(cast(*u8, maxr)); d.opt_free(cast(*u8, stk));
}

fn pass_single_copy_prop(func as *d.IRFunction) as void {
    let is i32 as vc = func.vreg_count;
    if (vc == 0) { return; }
    let is *i32 as ndef = cast(*i32, d.opt_alloc(cast(i64, vc) * 4));
    let is *i32 as src = cast(*i32, d.opt_alloc(cast(i64, vc) * 4));
    let is i32 as i with mut = 0;
    while (i < vc) { ndef[i] = 0; src[i] = 0 - 1; i = i + 1; }
    let is *d.IRInst as it with mut = func.instructions;
    while (cast(i64, it) != 0) {
        if (it.is_dead == 0) {
            let is i32 as op = it.op;
            if ((op == d.IR_ASM && d.is_stack_adjust(it) == 0) || op == d.IR_PHI) {
                d.opt_free(cast(*u8, ndef)); d.opt_free(cast(*u8, src));
                return;
            }
            if (it.dest.op_type == d.OP_VREG && it.dest.vreg >= 0 && it.dest.vreg < vc
                && op != d.IR_STORE && op != d.IR_COPY && op != d.IR_ATOMIC_STORE
                && op != d.IR_VSTOREQ && op != d.IR_VSTOREQ256) {
                // (a CMOV both reads and writes its dest: one more definition)
                ndef[it.dest.vreg] = ndef[it.dest.vreg] + 1;
                if (op == d.IR_MOV && it.src1.op_type == d.OP_VREG && it.src1.vreg >= 0 && it.src1.vreg < vc
                    && it.src1.vreg != it.dest.vreg) {
                    src[it.dest.vreg] = it.src1.vreg;
                }
            }
        }
        it = it.next;
    }
    // the end of each chain of such copies
    let is i32 as any with mut = 0;
    i = 0;
    while (i < vc) {
        if (ndef[i] != 1) { src[i] = 0 - 1; }
        else if (src[i] >= 0 && ndef[src[i]] != 1) { src[i] = 0 - 1; }
        if (src[i] >= 0) { any = 1; }
        i = i + 1;
    }
    if (any == 1) { _scp_keep_splits(func, vc, src); }
    if (any == 1) {
        i = 0;
        while (i < vc) {
            if (src[i] >= 0) {
                let is i32 as r with mut = src[i];
                let is i32 as g with mut = 0;
                while (src[r] >= 0 && g < 64) { r = src[r]; g = g + 1; }
                src[i] = r;
            }
            i = i + 1;
        }
        it = func.instructions;
        while (cast(i64, it) != 0) {
            if (it.is_dead == 0) {
                if (it.op == d.IR_MOV && it.dest.op_type == d.OP_VREG && it.dest.vreg >= 0 && it.dest.vreg < vc
                    && src[it.dest.vreg] >= 0) {
                    it.is_dead = 1;
                } else {
                    if (it.src1.op_type == d.OP_VREG && it.src1.vreg >= 0 && it.src1.vreg < vc && src[it.src1.vreg] >= 0) { it.src1.vreg = src[it.src1.vreg]; }
                    if (it.src2.op_type == d.OP_VREG && it.src2.vreg >= 0 && it.src2.vreg < vc && src[it.src2.vreg] >= 0) { it.src2.vreg = src[it.src2.vreg]; }
                    let is i32 as op = it.op;
                    if ((op == d.IR_STORE || op == d.IR_COPY || op == d.IR_ATOMIC_STORE || op == d.IR_CMOV
                         || op == d.IR_VSTOREQ || op == d.IR_VSTOREQ256)
                        && it.dest.op_type == d.OP_VREG && it.dest.vreg >= 0 && it.dest.vreg < vc && src[it.dest.vreg] >= 0) {
                        it.dest.vreg = src[it.dest.vreg];
                    }
                }
            }
            it = it.next;
        }
    }
    d.opt_free(cast(*u8, ndef)); d.opt_free(cast(*u8, src));
}

// === Pass 1: Constant Prop + Copy Prop (forward) ===

// Type kind of an integer cast operand (ast.TY_I8..TY_U64 = 1..8), else 0.
fn _int_kind(tp as *u8) as i32 {
    if (cast(i64, tp) == 0) { return 0; }
    let is i32 as k = *cast(*i32, tp);
    if (k >= 1 && k <= 8) { return k; }
    return 0;
}

// The value `v` takes after a cast to integer kind `k` (truncate, then
// zero- or sign-extend to 64 bits, as the x86 cast does).
fn _cast_const(v as i64, k as i32) as i64 {
    if (k == 5) { return v & 255; }
    if (k == 6) { return v & 65535; }
    if (k == 7) { return v & 4294967295; }
    if (k == 1) { return ((v & 255) ^ 128) - 128; }
    if (k == 2) { return ((v & 65535) ^ 32768) - 32768; }
    if (k == 3) { return ((v & 4294967295) ^ 2147483648) - 2147483648; }
    return v;
}

fn pass_const_copy_prop(func as *d.IRFunction, is_const as *i32, imm_val as *i64, copy_of as *i32, vc as i32) as void {
    let is i32 as vc_ext = vc + 512;
    // Pre-compute def counts: vregs with multiple defs cannot be safely marked const
    let is *i32 as ccp_defs = cast(*i32, d.opt_alloc(cast(i64, vc_ext) * 4));
    let is i32 as cdi with mut = 0;
    while (cdi < vc_ext) {
        let is *i32 as cdp = cast(*i32, cast(i64, ccp_defs) + cast(i64, cdi) * 4);
        *cdp = 0;
        cdi = cdi + 1;
    }
    let is *d.IRInst as cdinst with mut = func.instructions;
    while (cast(i64, cdinst) != 0) {
        if (cdinst.is_dead == 0 && cdinst.dest.op_type == d.OP_VREG && cdinst.op != d.IR_STORE && cdinst.op != d.IR_COPY) {
            let is i32 as cdv = cdinst.dest.vreg;
            if (cdv >= 0 && cdv < vc_ext) {
                let is *i32 as cdp = cast(*i32, cast(i64, ccp_defs) + cast(i64, cdv) * 4);
                *cdp = *cdp + 1;
            }
        }
        cdinst = cdinst.next;
    }
    let is *d.IRInst as inst with mut = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 1) { inst = inst.next; }
        else {
            let is i32 as op = inst.op;

            // A phi reads its arguments on the incoming edges: resolve those.
            if (op == d.IR_PHI) {
                let is i32 as pk with mut = 0;
                while (pk < phi.phi_nargs(inst)) {
                    let is i32 as pv = phi.phi_val(inst, pk);
                    if (pv >= 0 && pv < vc_ext) { phi.phi_set_val(inst, pk, oh.resolve(copy_of, pv)); }
                    pk = pk + 1;
                }
            }

            // Resolve src1 copy chain
            if (inst.src1.op_type == d.OP_VREG) {
                let is i32 as r1 = oh.resolve(copy_of, inst.src1.vreg);
                if (r1 != inst.src1.vreg) { inst.src1.vreg = r1; }
            }
            // Resolve src2 copy chain
            if (inst.src2.op_type == d.OP_VREG) {
                let is i32 as r2 = oh.resolve(copy_of, inst.src2.vreg);
                if (r2 != inst.src2.vreg) { inst.src2.vreg = r2; }
            }
            // Also resolve dest for STORE (dest is the address vreg)
            if (op == d.IR_STORE && inst.dest.op_type == d.OP_VREG) {
                let is i32 as rd = oh.resolve(copy_of, inst.dest.vreg);
                if (rd != inst.dest.vreg) { inst.dest.vreg = rd; }
            }
            // Resolve for COPY (dest is address vreg)
            if (op == d.IR_COPY && inst.dest.op_type == d.OP_VREG) {
                let is i32 as rd = oh.resolve(copy_of, inst.dest.vreg);
                if (rd != inst.dest.vreg) { inst.dest.vreg = rd; }
            }
            // Resolve for JZ/JNZ (src1 is condition)
            // Already handled above

            // Track IR_IMM (only if vreg has single definition — safe from loop re-defs)
            if (op == d.IR_IMM) {
                let is i32 as dv = inst.dest.vreg;
                let is i32 as dv_single with mut = 0;
                if (dv >= 0 && dv < vc + 512) {
                    let is *i32 as cdp = cast(*i32, cast(i64, ccp_defs) + cast(i64, dv) * 4);
                    if (*cdp == 1) { dv_single = 1; }
                }
                if (dv_single == 1) {
                    let is *i32 as icp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                    *icp = 1;
                    let is *i64 as ivp = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                    *ivp = inst.src1.imm;
                }
            }

            // Track IR_MOV: propagate constants through MOVs (no copy_of chain)
            if (op == d.IR_MOV && inst.src1.op_type == d.OP_VREG) {
                let is i32 as dv = inst.dest.vreg;
                let is i32 as sv = inst.src1.vreg;
                let is i32 as mov_single with mut = 0;
                if (dv >= 0 && dv < vc_ext) {
                    let is *i32 as cdp = cast(*i32, cast(i64, ccp_defs) + cast(i64, dv) * 4);
                    if (*cdp == 1) { mov_single = 1; }
                }
                if (mov_single == 1) {
                    // Only propagate constant info, don't set copy_of (safe)
                    let is *i32 as src_const = cast(*i32, cast(i64, is_const) + cast(i64, sv) * 4);
                    if (*src_const == 1) {
                        let is *i32 as dst_const = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                        *dst_const = 1;
                        let is *i64 as src_val = cast(*i64, cast(i64, imm_val) + cast(i64, sv) * 8);
                        let is *i64 as dst_val = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                        *dst_val = *src_val;
                    }
                }
            }

            // -O2: an integer cast of a constant is the constant, already
            // truncated and extended (`cast(u8, 1)` stores and compares an
            // immediate instead of materializing and re-extending it).
            if (op == d.IR_CAST && d.ir_opt_level >= 2 && inst.src1.op_type == d.OP_VREG) {
                let is i32 as sv = inst.src1.vreg;
                let is i32 as dv = inst.dest.vreg;
                let is *i32 as scp = cast(*i32, cast(i64, is_const) + cast(i64, sv) * 4);
                let is i32 as kt = _int_kind(inst.cast_to);
                let is i32 as kf = _int_kind(inst.cast_from);
                if (*scp == 1 && kt != 0 && kf != 0 && dv >= 0 && dv < vc_ext) {
                    let is *i64 as svp = cast(*i64, cast(i64, imm_val) + cast(i64, sv) * 8);
                    let is i64 as cv = _cast_const(*svp, kt);
                    inst.op = d.IR_IMM;
                    inst.src1.op_type = d.OP_IMM;
                    inst.src1.imm = cv;
                    inst.src2.op_type = d.OP_NONE;
                    let is *i32 as cdp = cast(*i32, cast(i64, ccp_defs) + cast(i64, dv) * 4);
                    if (*cdp == 1) {
                        let is *i32 as dcp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                        *dcp = 1;
                        let is *i64 as dvp = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                        *dvp = cv;
                    }
                }
            }

            // the bits of a constant are the constant: an IR_IMM holds bits
            if (op == d.IR_BITS && inst.src1.op_type == d.OP_VREG
                && *cast(*i32, cast(i64, is_const) + cast(i64, inst.src1.vreg) * 4) == 1) {
                let is i64 as bv = *cast(*i64, cast(i64, imm_val) + cast(i64, inst.src1.vreg) * 8);
                inst.op = d.IR_IMM;
                inst.src1 = d.op_imm(bv);
                *cast(*i32, cast(i64, is_const) + cast(i64, inst.dest.vreg) * 4) = 1;
                *cast(*i64, cast(i64, imm_val) + cast(i64, inst.dest.vreg) * 8) = bv;
            }

            // f64 arithmetic on constants: the same IEEE operation the program
            // would run. A NaN stays at run time, its bits are the machine's.
            if ((op == d.IR_FADD || op == d.IR_FSUB || op == d.IR_FMUL || op == d.IR_FDIV)
                && inst.src1.op_type == d.OP_VREG && inst.src2.op_type == d.OP_VREG
                && d.ty_is_f64(inst.cast_to) == 1) {
                let is i32 as fa = inst.src1.vreg;
                let is i32 as fb = inst.src2.vreg;
                if (*cast(*i32, cast(i64, is_const) + cast(i64, fa) * 4) == 1
                    && *cast(*i32, cast(i64, is_const) + cast(i64, fb) * 4) == 1) {
                    let is i64 as ba with mut = *cast(*i64, cast(i64, imm_val) + cast(i64, fa) * 8);
                    let is i64 as bb with mut = *cast(*i64, cast(i64, imm_val) + cast(i64, fb) * 8);
                    let is f64 as x = *cast(*f64, &ba);
                    let is f64 as y = *cast(*f64, &bb);
                    let is f64 as fr with mut = 0.0;
                    if (op == d.IR_FADD) { fr = x + y; }
                    if (op == d.IR_FSUB) { fr = x - y; }
                    if (op == d.IR_FMUL) { fr = x * y; }
                    if (op == d.IR_FDIV) { fr = x / y; }
                    if (fr == fr) {
                        let is i64 as frb = *cast(*i64, &fr);
                        inst.op = d.IR_IMM;
                        inst.src1.op_type = d.OP_IMM;
                        inst.src1.imm = frb;
                        inst.src2.op_type = d.OP_NONE;
                        let is i32 as fdv = inst.dest.vreg;
                        *cast(*i32, cast(i64, is_const) + cast(i64, fdv) * 4) = 1;
                        *cast(*i64, cast(i64, imm_val) + cast(i64, fdv) * 8) = frb;
                    }
                }
            }

            // Identity elimination and constant folding for binary ops
            if (op == d.IR_ADD || op == d.IR_SUB || op == d.IR_MUL ||
                op == d.IR_AND || op == d.IR_OR || op == d.IR_XOR ||
                op == d.IR_SHL || op == d.IR_SHR) {
                // Guard: both operands must be vregs for constant/copy tracking
                if (inst.src1.op_type == d.OP_VREG && inst.src2.op_type == d.OP_VREG) {
                let is i32 as s1v = inst.src1.vreg;
                let is i32 as s2v = inst.src2.vreg;
                let is *i32 as c1p = cast(*i32, cast(i64, is_const) + cast(i64, s1v) * 4);
                let is *i32 as c2p = cast(*i32, cast(i64, is_const) + cast(i64, s2v) * 4);
                let is i32 as c1 = *c1p;
                let is i32 as c2 = *c2p;

                if (c1 == 1 && c2 == 1) {
                    // Constant folding: both operands constant
                    let is *i64 as v1p = cast(*i64, cast(i64, imm_val) + cast(i64, s1v) * 8);
                    let is *i64 as v2p = cast(*i64, cast(i64, imm_val) + cast(i64, s2v) * 8);
                    let is i64 as v1 = *v1p;
                    let is i64 as v2 = *v2p;
                    let is i64 as result with mut = 0;
                    if (op == d.IR_ADD) { result = v1 + v2; }
                    if (op == d.IR_SUB) { result = v1 - v2; }
                    if (op == d.IR_MUL) { result = v1 * v2; }
                    if (op == d.IR_AND) { result = v1 & v2; }
                    if (op == d.IR_OR) { result = v1 | v2; }
                    if (op == d.IR_XOR) { result = v1 ^ v2; }
                    // Shift counts are taken mod 64, as the shift instructions do;
                    // an unsigned type shifts zeros in from the left.
                    if (op == d.IR_SHL) { result = v1 << (v2 & 63); }
                    if (op == d.IR_SHR) {
                        if (d.ty_shr_is_arith(inst.cast_to) == 1) { result = v1 >> (v2 & 63); }
                        else { result = cast(i64, cast(u64, v1) >> cast(u64, v2 & 63)); }
                    }
                    // Convert to IR_IMM
                    inst.op = d.IR_IMM;
                    inst.src1.op_type = d.OP_IMM;
                    inst.src1.imm = result;
                    inst.src2.op_type = d.OP_NONE;
                    let is i32 as dv = inst.dest.vreg;
                    let is *i32 as dcp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                    *dcp = 1;
                    let is *i64 as dvp = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                    *dvp = result;
                } else if (c2 == 1) {
                    // Right operand constant: identity elimination
                    let is *i64 as v2p = cast(*i64, cast(i64, imm_val) + cast(i64, s2v) * 8);
                    let is i64 as v2 = *v2p;

                    // x + 0, x - 0, x | 0, x ^ 0, x << 0, x >> 0 → copy x
                    if ((op == d.IR_ADD || op == d.IR_SUB || op == d.IR_OR ||
                         op == d.IR_XOR || op == d.IR_SHL || op == d.IR_SHR) && v2 == 0) {
                        let is i32 as dv = inst.dest.vreg;
                        let is *i32 as pp = cast(*i32, cast(i64, copy_of) + cast(i64, dv) * 4);
                        *pp = s1v;
                        if (c1 == 1) {
                            let is *i32 as dcp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                            *dcp = 1;
                            let is *i64 as sv1p = cast(*i64, cast(i64, imm_val) + cast(i64, s1v) * 8);
                            let is *i64 as dvp = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                            *dvp = *sv1p;
                        }
                    }
                    // x * 1 → copy x
                    if (op == d.IR_MUL && v2 == 1) {
                        let is i32 as dv = inst.dest.vreg;
                        let is *i32 as pp = cast(*i32, cast(i64, copy_of) + cast(i64, dv) * 4);
                        *pp = s1v;
                        if (c1 == 1) {
                            let is *i32 as dcp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                            *dcp = 1;
                            let is *i64 as sv1p = cast(*i64, cast(i64, imm_val) + cast(i64, s1v) * 8);
                            let is *i64 as dvp = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                            *dvp = *sv1p;
                        }
                    }
                    // x * 0, x & 0 → IMM 0
                    if ((op == d.IR_MUL || op == d.IR_AND) && v2 == 0) {
                        inst.op = d.IR_IMM;
                        inst.src1.op_type = d.OP_IMM;
                        inst.src1.imm = 0;
                        inst.src2.op_type = d.OP_NONE;
                        let is i32 as dv = inst.dest.vreg;
                        let is *i32 as dcp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                        *dcp = 1;
                        let is *i64 as dvp = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                        *dvp = 0;
                    }
                } else if (c1 == 1) {
                    // Left operand constant: identity for commutative ops
                    let is *i64 as v1p = cast(*i64, cast(i64, imm_val) + cast(i64, s1v) * 8);
                    let is i64 as v1 = *v1p;

                    // 0 + x, 0 | x, 0 ^ x → copy x
                    if ((op == d.IR_ADD || op == d.IR_OR || op == d.IR_XOR) && v1 == 0) {
                        let is i32 as dv = inst.dest.vreg;
                        let is *i32 as pp = cast(*i32, cast(i64, copy_of) + cast(i64, dv) * 4);
                        *pp = s2v;
                    }
                    // 1 * x → copy x
                    if (op == d.IR_MUL && v1 == 1) {
                        let is i32 as dv = inst.dest.vreg;
                        let is *i32 as pp = cast(*i32, cast(i64, copy_of) + cast(i64, dv) * 4);
                        *pp = s2v;
                    }
                    // 0 * x, 0 & x → IMM 0
                    if ((op == d.IR_MUL || op == d.IR_AND) && v1 == 0) {
                        inst.op = d.IR_IMM;
                        inst.src1.op_type = d.OP_IMM;
                        inst.src1.imm = 0;
                        inst.src2.op_type = d.OP_NONE;
                        let is i32 as dv = inst.dest.vreg;
                        let is *i32 as dcp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                        *dcp = 1;
                        let is *i64 as dvp = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                        *dvp = 0;
                    }
                }
                } // end guard (both operands are vregs)
            }

            // Strength reduction: DIV/MOD/MUL with constant power-of-2
            if (op == d.IR_DIV || op == d.IR_MOD || op == d.IR_MUL) {
                if (inst.src2.op_type == d.OP_VREG) {
                    let is i32 as s2v = inst.src2.vreg;
                    let is *i32 as c2p = cast(*i32, cast(i64, is_const) + cast(i64, s2v) * 4);
                    if (*c2p == 1) {
                        let is *i64 as v2p = cast(*i64, cast(i64, imm_val) + cast(i64, s2v) * 8);
                        let is i64 as v2 = *v2p;
                        if (oh.is_power_of_2(v2) == 1) {
                            let is i64 as shift = oh.log2_of(v2);
                            // Check if unsigned: cast_to kind 5-8 are unsigned
                            let is i32 as is_unsigned with mut = 0;
                            if (cast(i64, inst.cast_to) != 0) {
                                let is *i32 as kp = cast(*i32, inst.cast_to);
                                let is i32 as kind = *kp;
                                if (kind >= 5 && kind <= 8) { is_unsigned = 1; }
                            }
                            if (op == d.IR_MUL) {
                                // x * pow2 → x << log2(pow2) (works for both signed/unsigned)
                                inst.op = d.IR_SHL;
                                // Set src2 to IMM shift amount
                                inst.src2.op_type = d.OP_IMM;
                                inst.src2.imm = shift;
                            }
                            if (op == d.IR_DIV && is_unsigned == 1) {
                                // unsigned: x / pow2 → x >> log2(pow2)
                                inst.op = d.IR_SHR;
                                inst.src2.op_type = d.OP_IMM;
                                inst.src2.imm = shift;
                            }
                            if (op == d.IR_MOD && is_unsigned == 1) {
                                // unsigned: x % pow2 → x & (pow2-1)
                                inst.op = d.IR_AND;
                                inst.src2.op_type = d.OP_IMM;
                                inst.src2.imm = v2 - 1;
                            }
                        }
                    }
                }
                // Constant folding: both operands known
                if (inst.src1.op_type == d.OP_VREG && inst.src2.op_type == d.OP_VREG) {
                    let is i32 as s1v = inst.src1.vreg;
                    let is i32 as s2v = inst.src2.vreg;
                    let is *i32 as c1p = cast(*i32, cast(i64, is_const) + cast(i64, s1v) * 4);
                    let is *i32 as c2p = cast(*i32, cast(i64, is_const) + cast(i64, s2v) * 4);
                    if (*c1p == 1 && *c2p == 1) {
                        let is *i64 as v1p = cast(*i64, cast(i64, imm_val) + cast(i64, s1v) * 8);
                        let is *i64 as v2p = cast(*i64, cast(i64, imm_val) + cast(i64, s2v) * 8);
                        let is i64 as v2 = *v2p;
                        if (v2 != 0) {
                            let is i64 as v1 = *v1p;
                            let is i64 as result with mut = 0;
                            if (op == d.IR_DIV) { result = v1 / v2; }
                            if (op == d.IR_MOD) { result = v1 % v2; }
                            if (op == d.IR_MUL) { result = v1 * v2; }
                            inst.op = d.IR_IMM;
                            inst.src1.op_type = d.OP_IMM;
                            inst.src1.imm = result;
                            inst.src2.op_type = d.OP_NONE;
                            let is i32 as dv = inst.dest.vreg;
                            let is *i32 as dcp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                            *dcp = 1;
                            let is *i64 as dvp = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                            *dvp = result;
                        }
                    }
                }
            }

            // Constant folding for unary ops (NEG, NOT)
            if (op == d.IR_NEG && inst.src1.op_type == d.OP_VREG) {
                let is i32 as sv = inst.src1.vreg;
                let is *i32 as cp = cast(*i32, cast(i64, is_const) + cast(i64, sv) * 4);
                if (*cp == 1) {
                    let is *i64 as vp = cast(*i64, cast(i64, imm_val) + cast(i64, sv) * 8);
                    let is i64 as result = 0 - *vp;
                    inst.op = d.IR_IMM;
                    inst.src1.op_type = d.OP_IMM;
                    inst.src1.imm = result;
                    let is i32 as dv = inst.dest.vreg;
                    let is *i32 as dcp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                    *dcp = 1;
                    let is *i64 as dvp = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                    *dvp = result;
                }
            }
            if (op == d.IR_NOT && inst.src1.op_type == d.OP_VREG) {
                let is i32 as sv = inst.src1.vreg;
                let is *i32 as cp = cast(*i32, cast(i64, is_const) + cast(i64, sv) * 4);
                if (*cp == 1) {
                    let is *i64 as vp = cast(*i64, cast(i64, imm_val) + cast(i64, sv) * 8);
                    // Bitwise NOT: ~x = -1 ^ x (or we can use 0 - 1 - x)
                    let is i64 as all_ones = 0 - 1;
                    let is i64 as result = all_ones ^ *vp;
                    inst.op = d.IR_IMM;
                    inst.src1.op_type = d.OP_IMM;
                    inst.src1.imm = result;
                    let is i32 as dv = inst.dest.vreg;
                    let is *i32 as dcp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                    *dcp = 1;
                    let is *i64 as dvp = cast(*i64, cast(i64, imm_val) + cast(i64, dv) * 8);
                    *dvp = result;
                }
            }

            // Invalidate const/copy tracking when dest is redefined by non-IMM/non-MOV
            if (inst.is_dead == 0 && inst.dest.op_type == d.OP_VREG) {
                let is i32 as dv = inst.dest.vreg;
                if (op != d.IR_IMM && op != d.IR_MOV && dv >= 0 && dv < vc + 512) {
                    let is *i32 as dcp = cast(*i32, cast(i64, is_const) + cast(i64, dv) * 4);
                    if (inst.op != d.IR_IMM) {
                        *dcp = 0;
                        let is *i32 as pp = cast(*i32, cast(i64, copy_of) + cast(i64, dv) * 4);
                        *pp = 0 - 1;
                    }
                }
            }

            inst = inst.next;
        }
    }
    d.opt_free(cast(*u8, ccp_defs));
}

// === Pass 1.1: Fuse ADDR+STORE/LOAD into direct stack ops ===

// A pointer to an 8-byte scalar (i64, u64, f64 or a pointer): a load or store
// through it covers the whole slot, whatever the slot was declared as.
// (An f64 read as an integer, or the other way round, is the program asking for
// the bits: that stays a load, a copy between the register classes would not be.)
fn _word_is_f64(t as *u8) as i32 {
    let is *u8 as b = *cast(**u8, cast(i64, t) + 4);
    return cast(i32, *cast(*i32, b) == 10);
}

fn _word_ptr(t as *u8) as i32 {
    if (cast(i64, t) == 0) { return 0; }
    if (*cast(*i32, t) != 14) { return 0; }
    let is *u8 as b = *cast(**u8, cast(i64, t) + 4);
    if (cast(i64, b) == 0) { return 0; }
    let is i32 as k = *cast(*i32, b);
    if (k != 4 && k != 8 && k != 10 && k != 14) { return 0; }
    if (*cast(*i32, cast(i64, b) + 28) != 8) { return 0; }
    return 1;
}

fn pass_addr_fusion(func as *d.IRFunction, vc_alloc as i32) as void {
    // Count uses of each vreg (as src1, src2, or dest-of-STORE/COPY)
    let is *i32 as use_count = cast(*i32, d.opt_alloc(cast(i64, vc_alloc) * 4));
    let is i32 as i with mut = 0;
    while (i < vc_alloc) {
        let is *i32 as ucp = cast(*i32, cast(i64, use_count) + cast(i64, i) * 4);
        *ucp = 0;
        i = i + 1;
    }
    let is *d.IRInst as inst with mut = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 0) {
            if (inst.src1.op_type == d.OP_VREG && inst.src1.vreg >= 0 && inst.src1.vreg < vc_alloc) {
                let is *i32 as ucp = cast(*i32, cast(i64, use_count) + cast(i64, inst.src1.vreg) * 4);
                *ucp = *ucp + 1;
            }
            if (inst.src2.op_type == d.OP_VREG && inst.src2.vreg >= 0 && inst.src2.vreg < vc_alloc) {
                let is *i32 as ucp = cast(*i32, cast(i64, use_count) + cast(i64, inst.src2.vreg) * 4);
                *ucp = *ucp + 1;
            }
            // STORE/COPY dest is a use (address), not a def
            if ((inst.op == d.IR_STORE || inst.op == d.IR_COPY) && inst.dest.op_type == d.OP_VREG && inst.dest.vreg >= 0 && inst.dest.vreg < vc_alloc) {
                let is *i32 as ucp = cast(*i32, cast(i64, use_count) + cast(i64, inst.dest.vreg) * 4);
                *ucp = *ucp + 1;
            }
        }
        inst = inst.next;
    }
    // Track which vregs come from IR_ADDR with IMM (local var address)
    // addr_offset[v] = stack offset if v was defined by IR_ADDR(IMM), else -1
    let is *i64 as addr_offset = cast(*i64, d.opt_alloc(cast(i64, vc_alloc) * 8));
    i = 0;
    while (i < vc_alloc) {
        let is *i64 as aop = cast(*i64, cast(i64, addr_offset) + cast(i64, i) * 8);
        *aop = 0 - 1;
        i = i + 1;
    }
    inst = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 0 && inst.op == d.IR_ADDR && inst.src1.op_type == d.OP_IMM) {
            let is i32 as dv = inst.dest.vreg;
            if (dv >= 0 && dv < vc_alloc) {
            let is *i64 as aop = cast(*i64, cast(i64, addr_offset) + cast(i64, dv) * 8);
            *aop = inst.src1.imm;
            }
        }
        inst = inst.next;
    }
    // The bit view of a word local, `*cast(*f64, &x)`: the address goes once
    // through a CAST between two word pointer types. It fuses like a direct
    // access; once the slot is promoted the value crosses as a MOV, which is
    // a bit copy (movq between a general and an xmm register).
    let is *i32 as via = cast(*i32, d.opt_alloc(cast(i64, vc_alloc) * 4));
    i = 0;
    while (i < vc_alloc) { via[i] = 0 - 1; i = i + 1; }
    inst = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 0 && inst.op == d.IR_CAST && inst.dest.op_type == d.OP_VREG
            && inst.src1.op_type == d.OP_VREG) {
            let is i32 as cv = inst.src1.vreg;
            let is i32 as cd = inst.dest.vreg;
            if (cv >= 0 && cv < vc_alloc && cd >= 0 && cd < vc_alloc
                && addr_offset[cv] >= 0 && use_count[cv] == 1
                && _word_ptr(inst.cast_from) == 1 && _word_ptr(inst.cast_to) == 1
                && _word_is_f64(inst.cast_from) == _word_is_f64(inst.cast_to)) {
                addr_offset[cd] = addr_offset[cv];
                via[cd] = cv;
            }
        }
        inst = inst.next;
    }
    // Now scan: for each STORE/LOAD whose address vreg comes from ADDR(IMM) with use_count==1
    inst = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 0) {
            // Fuse ADDR+STORE: IR_STORE dest=vA(addr), src1=vB(value)
            if (inst.op == d.IR_STORE && inst.dest.op_type == d.OP_VREG && inst.dest.vreg >= 0 && inst.dest.vreg < vc_alloc) {
                let is i32 as av = inst.dest.vreg;
                let is *i64 as aop = cast(*i64, cast(i64, addr_offset) + cast(i64, av) * 8);
                let is i64 as off = *aop;
                if (off >= 0) {
                    let is *i32 as ucp = cast(*i32, cast(i64, use_count) + cast(i64, av) * 4);
                    if (*ucp == 1) {
                        // Replace STORE dest with direct IMM offset
                        inst.dest.op_type = d.OP_IMM;
                        inst.dest.imm = off;
                        // Mark the ADDR instruction as dead (find it)
                        _kill_addr(func, av, via[av]);
                    }
                }
            }
            // Fuse ADDR+LOAD: IR_LOAD dest=vB, src1=vA(addr vreg)
            if (inst.op == d.IR_LOAD && inst.src1.op_type == d.OP_VREG && inst.src1.vreg >= 0 && inst.src1.vreg < vc_alloc) {
                let is i32 as av = inst.src1.vreg;
                let is *i64 as aop = cast(*i64, cast(i64, addr_offset) + cast(i64, av) * 8);
                let is i64 as off = *aop;
                if (off >= 0) {
                    let is *i32 as ucp = cast(*i32, cast(i64, use_count) + cast(i64, av) * 4);
                    if (*ucp == 1) {
                        inst.src1.op_type = d.OP_IMM;
                        inst.src1.imm = off;
                        _kill_addr(func, av, via[av]);
                    }
                }
            }
        }
        inst = inst.next;
    }
    d.opt_free(cast(*u8, use_count));
    d.opt_free(cast(*u8, addr_offset));
    d.opt_free(cast(*u8, via));
}

// The ADDR whose value av is, gone with the access it was fused into; with
// the CAST it went through (av its result, src the ADDR's), both are.
fn _kill_addr(func as *d.IRFunction, av as i32, src as i32) as void {
    let is *d.IRInst as scan with mut = func.instructions;
    while (cast(i64, scan) != 0) {
        if (scan.is_dead == 0 && scan.dest.op_type == d.OP_VREG) {
            if (src < 0) {
                if (scan.op == d.IR_ADDR && scan.dest.vreg == av) { scan.is_dead = 1; }
            } else {
                if (scan.op == d.IR_CAST && scan.dest.vreg == av) { scan.is_dead = 1; }
                if (scan.op == d.IR_ADDR && scan.dest.vreg == src) { scan.is_dead = 1; }
            }
        }
        scan = scan.next;
    }
}

// === Pass 1.2: Store-Load Forwarding ===

fn pass_store_load_fwd(func as *d.IRFunction) as void {
    let is [64]i64 as slf_offsets;
    let is [64]i32 as slf_vregs;
    let is [64]i32 as slf_sizes;
    let is i32 as slf_count with mut = 0;
    let is *d.IRInst as inst with mut = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 0) {
            let is i32 as sop = inst.op;
            // Invalidate at labels, calls, and indirect stores (may alias stack slots)
            if (sop == d.IR_LABEL || sop == d.IR_CALL || sop == d.IR_CALL_INDIRECT || sop == d.IR_FFI_CALL || sop == d.IR_SYSCALL || sop == d.IR_JMP || sop == d.IR_JZ || sop == d.IR_JNZ
                || sop == d.IR_ATOMIC_LOAD || sop == d.IR_ATOMIC_STORE || sop == d.IR_ATOMIC_ADD || sop == d.IR_ATOMIC_XCHG || sop == d.IR_CAS_EXPECTED || sop == d.IR_ATOMIC_CAS || sop == d.IR_FENCE) {
                slf_count = 0;
            }
            else if (sop == d.IR_STORE && inst.dest.op_type == d.OP_VREG) {
                // Indirect store through pointer: may write to any stack slot
                slf_count = 0;
            }
            else if (sop == d.IR_COPY) {
                // Memory copy: may overwrite stack slots
                slf_count = 0;
            }
            else if (sop == d.IR_STORE && inst.dest.op_type == d.OP_IMM && inst.src1.op_type == d.OP_VREG) {
                // Store to stack slot: only track 8-byte stores (i32 truncates, unsafe to forward)
                let is i32 as st_sz with mut = 8;
                if (cast(i64, inst.cast_to) != 0) {
                    let is *i32 as stzp = cast(*i32, cast(i64, inst.cast_to) + 28);
                    st_sz = *stzp;
                }
                if (st_sz == 8 || st_sz == 4 || st_sz == 2 || st_sz == 1) {
                    let is i64 as off = inst.dest.imm;
                    let is i32 as sv = inst.src1.vreg;
                    let is i32 as found with mut = 0;
                    let is i32 as si with mut = 0;
                    while (si < slf_count) {
                        if (slf_offsets[si] == off) { slf_vregs[si] = sv; slf_sizes[si] = st_sz; found = 1; si = slf_count; }
                        si = si + 1;
                    }
                    if (found == 0 && slf_count < 64) {
                        slf_offsets[slf_count] = off;
                        slf_vregs[slf_count] = sv;
                        slf_sizes[slf_count] = st_sz;
                        slf_count = slf_count + 1;
                    }
                } else {
                    // Partial-width store: invalidate any existing entry for this offset
                    let is i64 as off = inst.dest.imm;
                    let is i32 as si with mut = 0;
                    while (si < slf_count) {
                        if (slf_offsets[si] == off) {
                            slf_offsets[si] = slf_offsets[slf_count - 1];
                            slf_vregs[si] = slf_vregs[slf_count - 1];
                            slf_sizes[si] = slf_sizes[slf_count - 1];
                            slf_count = slf_count - 1;
                            si = slf_count;
                        }
                        si = si + 1;
                    }
                }
            }
            else if (sop == d.IR_LOAD && inst.src1.op_type == d.OP_IMM) {
                // Load from stack slot: only forward 8-byte loads (i32 needs sign extension)
                let is i32 as ld_sz with mut = 8;
                if (cast(i64, inst.cast_to) != 0) {
                    let is *i32 as ldzp = cast(*i32, cast(i64, inst.cast_to) + 28);
                    ld_sz = *ldzp;
                }
                if (ld_sz >= 1) {
                // Check if we have a forwarded value
                let is i64 as off = inst.src1.imm;
                let is i32 as si with mut = 0;
                let is i32 as fwd with mut = 0;
                while (si < slf_count) {
                    if (slf_offsets[si] == off && slf_sizes[si] == ld_sz) {
                        // Forward: replace load with MOV from tracked vreg
                        inst.op = d.IR_MOV;
                        inst.src1.op_type = d.OP_VREG;
                        inst.src1.vreg = slf_vregs[si];
                        fwd = 1;
                        si = slf_count;
                    }
                    si = si + 1;
                }
                if (fwd == 0) {
                    // First load of this offset: track the loaded vreg
                    let is i32 as dv = inst.dest.vreg;
                    if (slf_count < 64) {
                        let is i32 as found2 with mut = 0;
                        si = 0;
                        while (si < slf_count) {
                            if (slf_offsets[si] == off) { slf_vregs[si] = dv; slf_sizes[si] = ld_sz; found2 = 1; si = slf_count; }
                            si = si + 1;
                        }
                        if (found2 == 0) {
                            slf_offsets[slf_count] = off;
                            slf_vregs[slf_count] = dv;
                            slf_sizes[slf_count] = ld_sz;
                            slf_count = slf_count + 1;
                        }
                    }
                }
                } // end ld_sz >= 1
            }
        }
        inst = inst.next;
    }
}

// === Additions of constants, one after the other ===
//
// -O2, on the SSA form: x2 = x1 + c2 with x1 = x0 + c1 is x2 = x0 + (c1 + c2),
// of the same width (a narrow sum wraps the same either way). What is left of
// x1 goes in DCE, and an address that was two steps from its base is one, a
// displacement for the access that reads it. Unrolling a loop leaves these:
// the pointer that stepped through it, one step per copy.
fn _ac_size(t as *u8) as i32 {
    if (cast(i64, t) == 0) { return 8; }
    return *cast(*i32, cast(i64, t) + 28);
}

fn pass_add_chain(func as *d.IRFunction) as void {
    let is i32 as vc = func.vreg_count;
    if (vc <= 0) { return; }
    let is *i64 as def = cast(*i64, d.opt_alloc(cast(i64, vc) * 8));
    let is *u8 as many = d.opt_alloc(cast(i64, vc) + 1);
    let is i32 as i with mut = 0;
    while (i < vc) {
        *cast(*i64, cast(i64, def) + cast(i64, i) * 8) = 0;
        many[i] = cast(u8, 0);
        i = i + 1;
    }
    let is *d.IRInst as it with mut = func.instructions;
    while (cast(i64, it) != 0) {
        if (it.is_dead == 0 && it.dest.op_type == d.OP_VREG && it.dest.vreg >= 0 && it.dest.vreg < vc
            && it.op != d.IR_STORE && it.op != d.IR_COPY && it.op != d.IR_VSTOREQ && it.op != d.IR_VSTOREQ256) {
            let is *i64 as q = cast(*i64, cast(i64, def) + cast(i64, it.dest.vreg) * 8);
            if (*q != 0) { many[it.dest.vreg] = cast(u8, 1); }
            *q = cast(i64, it);
        }
        it = it.next;
    }
    it = func.instructions;
    while (cast(i64, it) != 0) {
        if (it.is_dead == 0 && (it.op == d.IR_ADD || it.op == d.IR_SUB)
            && it.src1.op_type == d.OP_VREG && it.src2.op_type == d.OP_IMM
            && it.src1.vreg >= 0 && it.src1.vreg < vc && many[it.src1.vreg] == cast(u8, 0)) {
            let is *d.IRInst as a = cast(*d.IRInst, *cast(*i64, cast(i64, def) + cast(i64, it.src1.vreg) * 8));
            if (cast(i64, a) != 0 && a.is_dead == 0 && (a.op == d.IR_ADD || a.op == d.IR_SUB)
                && a.src1.op_type == d.OP_VREG && a.src2.op_type == d.OP_IMM
                && a.src1.vreg >= 0 && a.src1.vreg < vc && many[a.src1.vreg] == cast(u8, 0)
                && a.src1.vreg != it.dest.vreg && _ac_size(a.cast_to) == _ac_size(it.cast_to)) {
                let is i64 as c1 with mut = a.src2.imm;
                let is i64 as c2 with mut = it.src2.imm;
                if (a.op == d.IR_SUB) { c1 = 0 - c1; }
                if (it.op == d.IR_SUB) { c2 = 0 - c2; }
                let is i64 as c = c1 + c2;
                if (c >= 0 - 2147483647 && c <= 2147483647) {
                    it.op = cast(i8, d.IR_ADD);
                    it.src1 = d.op_vreg(a.src1.vreg);
                    it.src2 = d.op_imm(c);
                }
            }
        }
        it = it.next;
    }
    d.opt_free(cast(*u8, def));
    d.opt_free(many);
}
