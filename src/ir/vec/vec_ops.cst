// === vec2: the generic SIMD operations (IR_VOP / IR_VOPG) ===
//
// The loop widener (vec_widen.cst) speaks to the backend through two opcodes
// instead of one opcode per instruction and width:
//
//   IR_VOP   dest (an xmm-class vreg: a vector, or a scalar float for VO_FOLD)
//            = op(src1, src2)
//   IR_VOPG  dest (a general register) = op(src1)          (VO_HRED)
//
// The operation and its shape ride in dest.label, which no pass reads on an
// instruction that defines a vreg:
//
//   bits  0..7   VO_* code
//   bits  8..11  lane size in bytes (1, 2, 4, 8)
//   bit   12     1: AVX2 path, every instruction VEX-encoded (no SSE/AVX
//                transition inside the loop); 0: SSE2 path
//   bits 13..18  lanes (VF); the value spans lanes * lane size bytes (<= 32)
//   bits 19..26  immediate (shift count, compare predicate, reduction kind)
//
// Vector stores keep IR_VSTOREQ / IR_VSTOREQ256 (every pass already treats
// them as memory writes); IR_VSTOREQ takes a byte count and the VEX flag in
// dest.label (bits 0..7 bytes, 0 meaning 16; bit 8 VEX).

let is i32 as VO_LOAD   with imut = 1;   // [src1 + src2.imm], lanes*ls bytes
let is i32 as VO_SPLAT  with imut = 2;   // integer src1 (GPR) in every lane
let is i32 as VO_SPLATF with imut = 3;   // float src1 (f32 for ls 4, f64 for ls 8) in every lane
let is i32 as VO_ZERO   with imut = 4;
let is i32 as VO_ONES   with imut = 5;   // every bit set
let is i32 as VO_IOTA   with imut = 6;   // lane k = k
let is i32 as VO_PACK   with imut = 7;   // f64 lanes: lane 0 = scalar src1, lane 1 = scalar src2 (opt_slp.cst)
let is i32 as VO_SWAP   with imut = 8;   // the two 64-bit halves of src1 exchanged (opt_slp.cst)
let is i32 as VO_ADD    with imut = 10;
let is i32 as VO_SUB    with imut = 11;
let is i32 as VO_AND    with imut = 12;
let is i32 as VO_OR     with imut = 13;
let is i32 as VO_XOR    with imut = 14;
let is i32 as VO_ANDN   with imut = 15;  // ~src1 & src2
let is i32 as VO_MUL    with imut = 16;  // low half of the product (ls 2, 4)
let is i32 as VO_CMPEQ  with imut = 17;  // all ones where equal
let is i32 as VO_CMPGT  with imut = 18;  // all ones where src1 > src2, signed
let is i32 as VO_SHL    with imut = 19;  // by imm
let is i32 as VO_SHR    with imut = 20;  // logical, by imm
let is i32 as VO_SAR    with imut = 21;  // arithmetic, by imm (ls 2, 4)
let is i32 as VO_FADD   with imut = 30;
let is i32 as VO_FSUB   with imut = 31;
let is i32 as VO_FMUL   with imut = 32;
let is i32 as VO_FDIV   with imut = 33;
let is i32 as VO_FCMP   with imut = 34;  // cmpps/cmppd, predicate in imm
let is i32 as VO_FSQRT  with imut = 35;
let is i32 as VO_FADDSUB with imut = 36; // f64 lanes: lane 0 src1 - src2, lane 1 src1 + src2 (addsubpd)
let is i32 as VO_I2F    with imut = 40;  // i32 lanes -> f32 (ls 4) or f64 (ls 8) lanes
let is i32 as VO_F2F    with imut = 41;  // f32 -> f64 (ls 8) or f64 -> f32 (ls 4)
let is i32 as VO_ZEXT   with imut = 43;  // lanes of ls/2 -> ls, zero-extended
let is i32 as VO_SEXT   with imut = 44;  // lanes of ls/2 -> ls, sign-extended
let is i32 as VO_TRUNC  with imut = 45;  // lanes of 2*ls -> ls, low bits
let is i32 as VO_FOLD   with imut = 50;  // scalar dest = src1, then + (imm 0) or * (imm 1) each lane of src2 in order
let is i32 as VO_VZU    with imut = 51;  // vzeroupper (no dest)
let is i32 as VO_HRED   with imut = 60;  // IR_VOPG: imm 0 add, 1 xor, 2 or, 3 and; +16 signed lanes

fn vo_pack(code as i32, ls as i32, vex as i32, lanes as i32, imm as i32) as i32 {
    return code | (ls << 8) | (vex << 12) | (lanes << 13) | ((imm & 255) << 19);
}
fn vo_code(s as i32) as i32 { return s & 255; }
fn vo_ls(s as i32) as i32 { return (s >> 8) & 15; }
fn vo_vex(s as i32) as i32 { return (s >> 12) & 1; }
fn vo_lanes(s as i32) as i32 { return (s >> 13) & 63; }
fn vo_imm(s as i32) as i32 { return (s >> 19) & 255; }
