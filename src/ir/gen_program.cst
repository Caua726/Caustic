use "../../std/mem.cst" as mem;
use "../../std/io.cst" as io;
use "../parser/ast.cst" as ast;
use "../semantic/scope.cst" as sc;
use "../semantic/defs.cst" as sd;
use "../semantic/types.cst" as wt;
use "defs.cst" as d;
use "gen.cst" as g;
use "gen_expr.cst" as ge;
use "gen_stmt.cst" as gs;
use "opt.cst" as opt;
use "../codegen/dynsyms.cst" as dyns;
use "../semantic/modules.cst" as smod;
use "../codegen/target.cst" as tgt;

// === eval_const_expr ===

fn _const_float_value(node as *ast.Node) as f64 {
    let is i64 as value = eval_const_expr(node);
    if (g.is_float_kind(node.ty.kind) == 1) { return ast.i64_to_f64(value); }
    return ast.integer_to_f64(value, wt.is_signed_type(cast(*u8, node.ty)));
}

fn eval_const_expr(node as *ast.Node) as i64 {
    if (node.kind == ast.NK_NUM) {
        // Float literals: value is in fval, not val
        if (cast(i64, node.ty) != 0 && (node.ty.kind == ast.TY_F32 || node.ty.kind == ast.TY_F64)) {
            let is f64 as value with mut = node.fval;
            if (node.ty.kind == ast.TY_F32) { value = ast.round_f32(value); }
            return ast.f64_to_i64(value);
        }
        return node.val;
    }
    // Reference to another `with imut` global whose init was folded in
    // semantic — pick up the value so `let X with imut = A + B;` works
    // when A and B are imut globals themselves.
    if (node.kind == ast.NK_IDENT) {
        let is *sd.Variable as v = sc.lookup_var(node.name_ptr, node.name_len);
        if (cast(i64, v) != 0 && v.has_folded_init != 0) {
            return v.folded_init_val;
        }
    }
    if (node.kind == ast.NK_NEG) {
        let is i64 as value = eval_const_expr(node.expr);
        if (g.is_float_kind(node.ty.kind) == 1) { return value ^ (cast(i64, 1) << 63); }
        return 0 - value;
    }
    if (g.is_float_kind(node.ty.kind) == 1 &&
        (node.kind == ast.NK_ADD || node.kind == ast.NK_SUB || node.kind == ast.NK_MUL || node.kind == ast.NK_DIV)) {
        let is f64 as lhs = _const_float_value(node.lhs);
        let is f64 as rhs = _const_float_value(node.rhs);
        let is f64 as result with mut = lhs + rhs;
        if (node.kind == ast.NK_SUB) { result = lhs - rhs; }
        else if (node.kind == ast.NK_MUL) { result = lhs * rhs; }
        else if (node.kind == ast.NK_DIV) { result = lhs / rhs; }
        if (node.ty.kind == ast.TY_F32) { result = ast.round_f32(result); }
        return ast.f64_to_i64(result);
    }
    if (node.kind == ast.NK_ADD || node.kind == ast.NK_SUB || node.kind == ast.NK_MUL
        || node.kind == ast.NK_DIV || node.kind == ast.NK_MOD
        || node.kind == ast.NK_SHL || node.kind == ast.NK_SHR
        || node.kind == ast.NK_BAND || node.kind == ast.NK_BOR || node.kind == ast.NK_BXOR) {
        let is i64 as res with mut = 0;
        if (ast.const_op(node.kind, eval_const_expr(node.lhs), eval_const_expr(node.rhs),
                node.lhs.ty, node.rhs.ty, node.ty, &res) == 1) { return res; }
        io.write_str(io.STDERR, "ir: division by zero or overflow in global init\n");
        io.exit(1);
    }
    if (node.kind == ast.NK_CAST) {
        let is i64 as value with mut = eval_const_expr(node.expr);
        let is i32 as from_float = g.is_float_kind(node.expr.ty.kind);
        let is i32 as to_float = g.is_float_kind(node.ty.kind);
        if (to_float == 1) {
            let is f64 as converted with mut = 0.0;
            if (from_float == 1) { converted = ast.i64_to_f64(value); }
            else {
                if (node.ty.kind == ast.TY_F32) {
                    return ast.f64_to_i64(ast.integer_to_f32(value, wt.is_signed_type(cast(*u8, node.expr.ty))));
                }
                converted = ast.integer_to_f64(value, wt.is_signed_type(cast(*u8, node.expr.ty)));
            }
            if (node.ty.kind == ast.TY_F32) { converted = ast.round_f32(converted); }
            return ast.f64_to_i64(converted);
        }
        if (from_float == 1) { value = cast(i64, ast.i64_to_f64(value)); }
        if (node.ty.size > 0 && node.ty.size < 8) {
            let is i32 as width = node.ty.size * 8;
            value = value & ((cast(i64, 1) << width) - 1);
            if (wt.is_signed_type(cast(*u8, node.ty)) == 1 && (value & (cast(i64, 1) << (width - 1))) != 0) {
                value = value - (cast(i64, 1) << width);
            }
        }
        return value;
    }
    io.write_str(io.STDERR, "ir: non-constant expr in global init\n");
    io.exit(1);
    return 0;
}

// === mark_reachable ===

// Hash table for mark_reachable. DJB2 + chaining, power-of-2 buckets.
// Built once per top-level mark_reachable invocation; turns _reach_by_name
// from O(F+G) into O(1) average.
let is i32 as REACH_HASH_BUCKETS with imut = 4096;
let is *i32 as _reach_fn_buckets with mut;
let is *i64 as _reach_fn_ptrs with mut;
let is *i32 as _reach_fn_next with mut;
let is i32 as _reach_fn_count with mut = 0;
let is *i32 as _reach_gl_buckets with mut;
let is *i64 as _reach_gl_ptrs with mut;
let is *i32 as _reach_gl_next with mut;
let is i32 as _reach_gl_count with mut = 0;
let is i32 as _reach_index_ready with mut = 0;

fn _reach_hash(name_ptr as *u8, name_len as i32) as i32 {
    let is i64 as h with mut = 5381;
    let is i32 as i with mut = 0;
    while (i < name_len) {
        h = h * 33 + cast(i64, name_ptr[i]);
        i = i + 1;
    }
    h = h & 9223372036854775807;
    return cast(i32, h & cast(i64, REACH_HASH_BUCKETS - 1));
}

fn _reach_build_index(prog as *d.IRProgram) as void {
    let is i32 as fcount with mut = 0;
    let is *d.IRFunction as fc with mut = prog.functions;
    while (cast(i64, fc) != 0) { fcount = fcount + 1; fc = fc.next; }
    let is i32 as gcount with mut = 0;
    let is *d.IRGlobal as gc with mut = prog.globals;
    while (cast(i64, gc) != 0) { gcount = gcount + 1; gc = gc.next; }

    let is i32 as fcap with mut = fcount;
    if (fcap < 1) { fcap = 1; }
    let is i32 as gcap with mut = gcount;
    if (gcap < 1) { gcap = 1; }

    _reach_fn_buckets = cast(*i32, d.opt_alloc(cast(i64, REACH_HASH_BUCKETS) * 4));
    _reach_fn_ptrs    = cast(*i64, d.opt_alloc(cast(i64, fcap) * 8));
    _reach_fn_next    = cast(*i32, d.opt_alloc(cast(i64, fcap) * 4));
    _reach_gl_buckets = cast(*i32, d.opt_alloc(cast(i64, REACH_HASH_BUCKETS) * 4));
    _reach_gl_ptrs    = cast(*i64, d.opt_alloc(cast(i64, gcap) * 8));
    _reach_gl_next    = cast(*i32, d.opt_alloc(cast(i64, gcap) * 4));

    let is i32 as i with mut = 0;
    while (i < REACH_HASH_BUCKETS) {
        _reach_fn_buckets[i] = 0 - 1;
        _reach_gl_buckets[i] = 0 - 1;
        i = i + 1;
    }

    _reach_fn_count = 0;
    let is *d.IRFunction as f with mut = prog.functions;
    while (cast(i64, f) != 0) {
        let is *u8 as fname with mut = f.name_ptr;
        let is i32 as flen with mut = f.name_len;
        if (f.asm_name_len > 0) { fname = f.asm_name_ptr; flen = f.asm_name_len; }
        let is i32 as b = _reach_hash(fname, flen);
        let is *i64 as pp = cast(*i64, cast(i64, _reach_fn_ptrs) + cast(i64, _reach_fn_count) * 8);
        let is *i32 as np = cast(*i32, cast(i64, _reach_fn_next) + cast(i64, _reach_fn_count) * 4);
        *pp = cast(i64, f);
        *np = _reach_fn_buckets[b];
        _reach_fn_buckets[b] = _reach_fn_count;
        _reach_fn_count = _reach_fn_count + 1;
        f = f.next;
    }

    _reach_gl_count = 0;
    let is *d.IRGlobal as gg with mut = prog.globals;
    while (cast(i64, gg) != 0) {
        let is i32 as b = _reach_hash(gg.name_ptr, gg.name_len);
        let is *i64 as pp = cast(*i64, cast(i64, _reach_gl_ptrs) + cast(i64, _reach_gl_count) * 8);
        let is *i32 as np = cast(*i32, cast(i64, _reach_gl_next) + cast(i64, _reach_gl_count) * 4);
        *pp = cast(i64, gg);
        *np = _reach_gl_buckets[b];
        _reach_gl_buckets[b] = _reach_gl_count;
        _reach_gl_count = _reach_gl_count + 1;
        gg = gg.next;
    }

    _reach_index_ready = 1;
}

// Bumped whenever a function or global turns reachable: the walk over the globals'
// initializers repeats until a pass adds nothing.
let is i64 as _reach_marks with mut = 0;

fn _reach_global_by_name(tname as *u8, tlen as i32) as void {
    let is i32 as b = _reach_hash(tname, tlen);
    let is i32 as ix with mut = _reach_gl_buckets[b];
    while (ix >= 0) {
        let is *i64 as pp = cast(*i64, cast(i64, _reach_gl_ptrs) + cast(i64, ix) * 8);
        let is *d.IRGlobal as gg = cast(*d.IRGlobal, *pp);
        if (d.str_eq(gg.name_ptr, gg.name_len, tname, tlen) == 1 && gg.is_reachable == 0) {
            gg.is_reachable = 1;
            _reach_marks = _reach_marks + 1;
        }
        let is *i32 as np = cast(*i32, cast(i64, _reach_gl_next) + cast(i64, ix) * 4);
        ix = *np;
    }
}

// Cache call/fn_addr target names before freeing instructions
fn cache_call_targets(func as *d.IRFunction) as void {
    let is i32 as count with mut = 0;
    let is *d.IRInst as inst with mut = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.op == d.IR_CALL && inst.call_name_len > 0) { count = count + 1; }
        if (inst.op == d.IR_FN_ADDR && inst.global_name_len > 0) { count = count + 1; }
        if (inst.op == d.IR_ADDR_GLOBAL && inst.global_name_len > 0) { count = count + 1; }
        inst = inst.next;
    }
    if (count == 0) { func.call_target_count = 0; return; }
    // Each entry: 8 bytes ptr + 4 bytes len = 12 bytes. Names refer to either
    // functions or globals; mark_reachable resolves both kinds by lookup.
    let is *u8 as buf = d.opt_alloc(cast(i64, count) * 12);
    let is i32 as idx with mut = 0;
    inst = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.op == d.IR_CALL && inst.call_name_len > 0) {
            let is *i64 as pp = cast(*i64, cast(i64, buf) + cast(i64, idx) * 12);
            let is *i32 as pl = cast(*i32, cast(i64, buf) + cast(i64, idx) * 12 + 8);
            *pp = cast(i64, inst.call_name_ptr);
            *pl = inst.call_name_len;
            idx = idx + 1;
        }
        if (inst.op == d.IR_FN_ADDR && inst.global_name_len > 0) {
            let is *i64 as pp = cast(*i64, cast(i64, buf) + cast(i64, idx) * 12);
            let is *i32 as pl = cast(*i32, cast(i64, buf) + cast(i64, idx) * 12 + 8);
            *pp = cast(i64, inst.global_name_ptr);
            *pl = inst.global_name_len;
            idx = idx + 1;
        }
        if (inst.op == d.IR_ADDR_GLOBAL && inst.global_name_len > 0) {
            let is *i64 as pp = cast(*i64, cast(i64, buf) + cast(i64, idx) * 12);
            let is *i32 as pl = cast(*i32, cast(i64, buf) + cast(i64, idx) * 12 + 8);
            *pp = cast(i64, inst.global_name_ptr);
            *pl = inst.global_name_len;
            idx = idx + 1;
        }
        inst = inst.next;
    }
    func.call_targets = buf;
    func.call_target_count = count;
}

fn _reach_by_name(prog as *d.IRProgram, tname as *u8, tlen as i32) as void {
    let is i32 as b = _reach_hash(tname, tlen);
    let is i32 as ix with mut = _reach_fn_buckets[b];
    while (ix >= 0) {
        let is *i64 as pp = cast(*i64, cast(i64, _reach_fn_ptrs) + cast(i64, ix) * 8);
        let is *d.IRFunction as f = cast(*d.IRFunction, *pp);
        let is *u8 as fname with mut = f.name_ptr;
        let is i32 as flen with mut = f.name_len;
        if (f.asm_name_len > 0) { fname = f.asm_name_ptr; flen = f.asm_name_len; }
        if (d.str_eq(fname, flen, tname, tlen) == 1) {
            mark_reachable(prog, f);
        }
        let is *i32 as np = cast(*i32, cast(i64, _reach_fn_next) + cast(i64, ix) * 4);
        ix = *np;
    }
    _reach_global_by_name(tname, tlen);
}

fn _fn_name_is(f as *d.IRFunction, suf as *u8, sl as i32, plen as *i32) as i32 {
    let is *u8 as fp with mut = f.name_ptr;
    let is i32 as fl with mut = f.name_len;
    if (f.asm_name_len > 0) { fp = f.asm_name_ptr; fl = f.asm_name_len; }
    if (fl < sl || d.str_eq(fp + cast(i64, fl - sl), sl, suf, sl) == 0) { return 0; }
    if (fl > sl && fp[fl - sl - 1] != cast(u8, 95)) { return 0; }
    *plen = fl - sl;
    return 1;
}

fn _fn_nm(f as *d.IRFunction) as *u8 {
    if (f.asm_name_len > 0) { return f.asm_name_ptr; }
    return f.name_ptr;
}

fn _reach_sincos(prog as *d.IRProgram) as void {
    let is *d.IRFunction as fs with mut = prog.functions;
    while (cast(i64, fs) != 0) {
        let is i32 as ls with mut = 0;
        if (fs.is_reachable == 1 && _fn_name_is(fs, "std_math_cst_sin", 16, &ls) == 1) {
            let is *d.IRFunction as fc with mut = prog.functions;
            while (cast(i64, fc) != 0) {
                let is i32 as lc with mut = 0;
                if (fc.is_reachable == 1 && _fn_name_is(fc, "std_math_cst_cos", 16, &lc) == 1 && lc == ls
                    && d.str_eq(_fn_nm(fc), lc, _fn_nm(fs), ls) == 1) {
                    let is *d.IRFunction as fb with mut = prog.functions;
                    while (cast(i64, fb) != 0) {
                        let is i32 as lb with mut = 0;
                        if (_fn_name_is(fb, "std_math_cst_sincos", 19, &lb) == 1 && lb == ls
                            && d.str_eq(_fn_nm(fb), lb, _fn_nm(fs), ls) == 1) { mark_reachable(prog, fb); }
                        fb = fb.next;
                    }
                }
                fc = fc.next;
            }
        }
        fs = fs.next;
    }
}

// Inline asm names symbols in its text, where no call instruction shows them. Every
// word that could be a symbol is looked up; a word that names nothing marks nothing.
fn _reach_asm(prog as *d.IRProgram, inst as *d.IRInst) as void {
    let is *u8 as s = inst.asm_str_ptr;
    let is i32 as n = inst.asm_str_len;
    let is i32 as i with mut = 0;
    while (i < n) {
        let is i32 as st = i;
        while (i < n && (s[i] == cast(u8, 95) || s[i] == cast(u8, 46) || s[i] == cast(u8, 36)
                || (s[i] >= cast(u8, 48) && s[i] <= cast(u8, 57))
                || (s[i] >= cast(u8, 65) && s[i] <= cast(u8, 90))
                || (s[i] >= cast(u8, 97) && s[i] <= cast(u8, 122)))) {
            i = i + 1;
        }
        if (i > st) { _reach_by_name(prog, cast(*u8, cast(i64, s) + cast(i64, st)), i - st); }
        else { i = i + 1; }
    }
}

fn mark_reachable(prog as *d.IRProgram, func as *d.IRFunction) as void {
    if (cast(i64, func) == 0) { return; }
    if (func.is_reachable == 1) { return; }
    func.is_reachable = 1;
    _reach_marks = _reach_marks + 1;

    // A library provides this function: the call stays and resolves at load, but the
    // body is never emitted here, so nothing it names is needed here either.
    if (dyns.dynsyms_count() > 0
        && dyns.dynsyms_lookup(func.asm_name_ptr, cast(i64, func.asm_name_len)) >= 0) { return; }

    if (func.ir_blob_count > 0 && cast(i64, func.instructions) == 0) {
        // Packed: the targets were cached before packing, and the list is opened only
        // for inline asm.
        if (func.has_asm != 0) {
            let is *d.IRInst as hd = d.func_unpack(func);
            let is *d.IRInst as pi with mut = hd;
            while (cast(i64, pi) != 0) {
                if (pi.op == d.IR_ASM) { _reach_asm(prog, pi); }
                pi = pi.next;
            }
            d.free_inst_list(hd);
        }
        let is i32 as pc with mut = 0;
        while (pc < func.call_target_count) {
            let is *i64 as ppk = cast(*i64, cast(i64, func.call_targets) + cast(i64, pc) * 12);
            let is *i32 as plk = cast(*i32, cast(i64, func.call_targets) + cast(i64, pc) * 12 + 8);
            _reach_by_name(prog, cast(*u8, *ppk), *plk);
            pc = pc + 1;
        }
        return;
    }

    // Use cached call targets if instructions were freed
    if (func.call_target_count > 0 && cast(i64, func.call_targets) != 0) {
        let is i32 as ci with mut = 0;
        while (ci < func.call_target_count) {
            let is *i64 as pp = cast(*i64, cast(i64, func.call_targets) + cast(i64, ci) * 12);
            let is *i32 as pl = cast(*i32, cast(i64, func.call_targets) + cast(i64, ci) * 12 + 8);
            _reach_by_name(prog, cast(*u8, *pp), *pl);
            ci = ci + 1;
        }
        let is *d.IRInst as ai with mut = func.instructions;
        while (cast(i64, ai) != 0) {
            if (ai.op == d.IR_ASM) { _reach_asm(prog, ai); }
            ai = ai.next;
        }
        return;
    }

    // Scan instructions directly
    let is *d.IRInst as inst with mut = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.op == d.IR_CALL && inst.call_name_len > 0) {
            _reach_by_name(prog, inst.call_name_ptr, inst.call_name_len);
        }
        if (inst.op == d.IR_FN_ADDR && inst.global_name_len > 0) {
            _reach_by_name(prog, inst.global_name_ptr, inst.global_name_len);
        }
        if (inst.op == d.IR_ADDR_GLOBAL && inst.global_name_len > 0) {
            _reach_global_by_name(inst.global_name_ptr, inst.global_name_len);
        }
        if (inst.op == d.IR_ASM) { _reach_asm(prog, inst); }
        inst = inst.next;
    }
}

// What keeps code alive other than being called from main. Repeats, since a function
// reached through one global's initializer can name the next global.
fn _reach_roots(prog as *d.IRProgram) as void {
    // A section is there for a side effect: the named section in the output.
    let is *d.IRGlobal as sg with mut = prog.globals;
    while (cast(i64, sg) != 0) {
        if (sg.section_len > 0 && sg.is_reachable == 0) {
            sg.is_reachable = 1;
            _reach_marks = _reach_marks + 1;
        }
        sg = sg.next;
    }
    let is *d.IRFunction as sf with mut = prog.functions;
    while (cast(i64, sf) != 0) {
        if (sf.fn_section_len > 0) { mark_reachable(prog, sf); }
        sf = sf.next;
    }
    let is i64 as before with mut = _reach_marks - 1;
    while (before != _reach_marks) {
        before = _reach_marks;
        let is *d.IRGlobal as fg with mut = prog.globals;
        while (cast(i64, fg) != 0) {
            if (fg.is_reachable == 1 && fg.is_fn_ptr_init == 1) {
                _reach_by_name(prog, fg.init_fn_name_ptr, fg.init_fn_name_len);
            }
            if (fg.is_reachable == 1 && fg.is_struct_lit_init == 1) {
                let is *ast.Node as lit = cast(*ast.Node, fg.struct_lit_ast);
                let is *ast.Node as e with mut = lit.args;
                while (cast(i64, e) != 0) {
                    if (cast(i64, e.expr) != 0 && e.expr.kind == ast.NK_FN_PTR) {
                        _reach_by_name(prog, e.expr.name_ptr, e.expr.name_len);
                    }
                    e = e.next;
                }
            }
            fg = fg.next;
        }
        // -O2 turns sin(v) and cos(v) into one call of math.sincos
        // (opt_sincos.cst): keep it when both are kept.
        if (d.ir_opt_level >= 2) { _reach_sincos(prog); }
    }
}

// The per-module path names main `<root prefix>_main`, which gen_ir does not know
// for main and so left every function reachable, to be compiled and then dropped by
// the linker: a third of a large program's functions. No such function (the root has
// no main) leaves them all reachable, as a library needs.
fn reach_from_entry(prog as *d.IRProgram, prefix as *u8, plen as i32) as void {
    let is *d.IRFunction as root with mut = cast(*d.IRFunction, 0);
    let is *d.IRFunction as f with mut = prog.functions;
    while (cast(i64, f) != 0) {
        if (f.asm_name_len == plen + 5 && d.str_eq(f.asm_name_ptr, plen, prefix, plen) == 1
            && d.str_eq(f.asm_name_ptr + cast(i64, plen), 5, "_main", 5) == 1) { root = f; }
        f = f.next;
    }
    if (cast(i64, root) == 0) { return; }
    f = prog.functions;
    while (cast(i64, f) != 0) { f.is_reachable = 0; f = f.next; }
    let is *d.IRGlobal as gv with mut = prog.globals;
    while (cast(i64, gv) != 0) { gv.is_reachable = 0; gv = gv.next; }
    _reach_build_index(prog);
    mark_reachable(prog, root);
    _reach_roots(prog);
}

fn get_string_head() as *u8 { return cast(*u8, g.string_head); }

// When 1, gen_ir's per-function Phase-1 skips optimize_func and only computes the
// cheap inline-decision metadata — the heavy optimize is deferred to the parallel
// workers (which optimize each function post-inline anyway). Set by
// run_parallel_exe before the frontend; off (full optimize in gen_ir) otherwise.
let is i32 as g_defer_optimize with mut = 0;
fn set_defer_optimize(v as i32) as void { g_defer_optimize = v; opt.set_raw_bodies(v); }

// === Regenerate IR for a single function from its AST node ===

// IRFunction.ret_kind for a function declaration.
fn _ret_kind(node as *ast.Node) as i64 {
    let is *ast.Type as rt = node.return_type;
    if (cast(i64, rt) == 0) { return 0; }
    if (rt.kind == ast.TY_VOID) { return 1; }
    if (rt.size > 8) { return 3; }
    return 2;
}

// The System V places of a function's arguments (g.abi_codes), the hidden
// sret pointer first when there is one, or null when its arguments keep
// their positions: a target other than x86_64, a variadic or naked
// function, or no float parameter.
fn _param_codes(node as *ast.Node, has_sret as i32, n as i32) as *i32 {
    if (g.xmm_args_abi() == 0 || node.is_variadic == 1 || ast.nx_is_naked(node) == 1 || n <= 0) { return cast(*i32, 0); }
    let is *u8 as is_flt = d.opt_alloc(cast(i64, n) + 8);
    let is i32 as k with mut = 0;
    let is i32 as any with mut = 0;
    if (has_sret == 1) { is_flt[0] = cast(u8, 0); k = 1; }
    let is *ast.Node as p with mut = node.params;
    while (cast(i64, p) != 0 && k < n) {
        is_flt[k] = cast(u8, 0);
        if (cast(i64, p.ty) != 0 && g.is_float_kind(p.ty.kind) == 1) { is_flt[k] = cast(u8, 1); any = 1; }
        k = k + 1;
        p = p.next;
    }
    if (any == 0) { d.opt_free(is_flt); return cast(*i32, 0); }
    let is *i32 as codes = cast(*i32, d.opt_alloc(cast(i64, n) * 4 + 8));
    g.abi_codes(is_flt, n, codes);
    d.opt_free(is_flt);
    return codes;
}

fn _param_get_arg(codes as *i32, idx as i32, line as i32) as i32 {
    if (cast(i64, codes) == 0) { return g.emit_get_arg(idx, line); }
    return g.emit_get_arg_at(idx, *(cast(*i32, cast(i64, codes) + cast(i64, idx) * 4)), line);
}

// An integer parameter's GET_ARG records its type (d.params_canonical).
fn _param_type(t as *ast.Type) as void {
    if (d.ir_opt_level < 2 || cast(i64, t) == 0) { return; }
    let is i32 as k = t.kind;
    if ((k >= ast.TY_I8 && k <= ast.TY_U64) || k == ast.TY_BOOL || k == ast.TY_CHAR) { g.ctx_tail.cast_to = cast(*u8, t); }
}

fn regen_func_ir(func as *d.IRFunction) as void {
    let is *ast.Node as node = cast(*ast.Node, func.ast_node);
    if (cast(i64, node) == 0 || cast(i64, node.body) == 0) { return; }

    // Save/nullify ir_tl: regen'd functions may be from imported modules
    // whose tok_idx are relative to a different token list
    let is *u8 as saved_tl = g.ir_tl;
    g.ir_tl = cast(*u8, 0);
    g.ctx_head = cast(*d.IRInst, 0);
    g.ctx_tail = cast(*d.IRInst, 0);
    g.ctx_vreg = 0;
    g.ctx_label = 0;
    g.ctx_loop_depth = 0;
    g.ctx_has_sret = 0;
    g.ctx_has_returned = 0;
    g.defer_count = 0;
    g.ctx_func = func;
    func.alloc_stack_size = 0;
    func.ret_kind = _ret_kind(node);
    g.set_ret_float(node.return_type);

    if (node.body.kind == ast.NK_BLOCK) {
        let is i32 as param_count with mut = 0;
        let is *ast.Node as p with mut = node.params;
        while (cast(i64, p) != 0) { param_count = param_count + 1; p = p.next; }
        let is i32 as arg_idx with mut = 0;
        if (cast(i64, node.return_type) != 0 && node.return_type.size > 8) {
            g.ctx_has_sret = 1;
            g.ctx_sret_vreg = g.emit_get_arg(arg_idx, g.tok_line(node.tok_idx));
            arg_idx = arg_idx + 1;
            param_count = param_count + 1;
        }
        func.num_args = param_count;
        // One entry per parameter (plus the hidden sret slot, which is read
        // into its own vreg before this array is filled). Was a fixed [32]i32:
        // a 33rd parameter overwrote the adjacent stack arrays instead of
        // overflowing anything detectable, so `fn f(p0..p32)` compiled and
        // returned a wrong value with no diagnostic at all.
        let is i64 as av_bytes with mut = cast(i64, param_count) * 4;
        if (av_bytes < 8) { av_bytes = 8; }
        let is *i32 as arg_vregs = cast(*i32, d.opt_alloc(av_bytes));
        let is *i32 as pcodes = _param_codes(node, g.ctx_has_sret, param_count);
        let is i32 as avi with mut = 0;
        p = node.params;
        while (cast(i64, p) != 0) {
            arg_vregs[avi] = _param_get_arg(pcodes, arg_idx, g.tok_line(p.tok_idx));
            _param_type(p.ty);
            avi = avi + 1; arg_idx = arg_idx + 1; p = p.next;
        }
        if (cast(i64, pcodes) != 0) { d.opt_free(cast(*u8, pcodes)); }
        avi = 0; p = node.params;
        while (cast(i64, p) != 0) {
            let is i32 as av = arg_vregs[avi];
            let is *ast.Type as pty = p.ty;
            if (cast(i64, pty) != 0 && pty.size > 8) {
                let is i32 as da = g.new_vreg();
                let is *d.IRInst as ai = d.new_inst(d.IR_ADDR);
                ai.dest = d.op_vreg(da); ai.src1 = d.op_imm(cast(i64, p.var_offset));
                ai.line = g.tok_line(p.tok_idx); g.emit(ai);
                let is *d.IRInst as cp = d.new_inst(d.IR_COPY);
                cp.dest = d.op_vreg(da); cp.src1 = d.op_vreg(av);
                cp.src2 = d.op_imm(cast(i64, pty.size));
                cp.line = g.tok_line(p.tok_idx); g.emit(cp);
            } else {
                let is *d.IRInst as si = d.new_inst(d.IR_STORE);
                si.dest = d.op_imm(cast(i64, p.var_offset));
                si.src1 = d.op_vreg(av); si.cast_to = cast(*u8, p.ty);
                si.line = g.tok_line(p.tok_idx); g.emit(si);
            }
            avi = avi + 1; p = p.next;
        }
        d.opt_free(cast(*u8, arg_vregs));
        gs.gen_stmt(node.body.stmts);
        ge.emit_deferred_calls();
        let is i32 as zero = g.emit_imm(0, 0);
        g.emit_return(zero, 0);
    }

    func.instructions = g.ctx_head;
    func.vreg_count = g.ctx_vreg;
    func.label_count = g.ctx_label;
    g.ir_tl = saved_tl;
}

// === gen_ir entry ===

// One function's IR, with what the inliner wants to know about it.
fn _gen_fn(node as *ast.Node) as *d.IRFunction {
    // Reset context
    g.ctx_head = cast(*d.IRInst, 0);
    g.ctx_tail = cast(*d.IRInst, 0);
    g.ctx_vreg = 0;
    g.ctx_loop_depth = 0;
    g.ctx_has_sret = 0;
    g.ctx_has_returned = 0;
    g.defer_count = 0;

    let is *d.IRFunction as func = d.new_irfunc();
    if (node.asm_name_len > 0) {
        func.name_ptr = d.str_dup(node.asm_name_ptr, node.asm_name_len);
        func.name_len = node.asm_name_len;
        func.asm_name_ptr = d.str_dup(node.asm_name_ptr, node.asm_name_len);
        func.asm_name_len = node.asm_name_len;
    } else {
        func.name_ptr = d.str_dup(node.name_ptr, node.name_len);
        func.name_len = node.name_len;
        func.asm_name_ptr = d.str_dup(node.name_ptr, node.name_len);
        func.asm_name_len = node.name_len;
    }
    func.is_variadic = node.is_variadic;
    func.is_naked = ast.nx_is_naked(node);
    func.is_noinline = ast.nx_is_noinline(node);
    // `with section(".name")` — same annotation globals use.
    func.fn_section_len = ast.nx_section_len(node);
    if (func.fn_section_len > 0) {
        func.fn_section_ptr = d.str_dup(ast.nx_section_ptr(node), func.fn_section_len);
    }

    let is i32 as param_count with mut = 0;
    let is *ast.Node as p with mut = node.params;
    while (cast(i64, p) != 0) { param_count = param_count + 1; p = p.next; }

    g.ctx_func = func;
    func.ret_kind = _ret_kind(node);
    g.set_ret_float(node.return_type);

    if (node.body.kind == ast.NK_BLOCK && func.is_naked == 1) {
        // Naked: NO parameter materialization (the asm body reads args
        // straight from rdi/rsi/...; there is no frame to store them
        // in — rbp is unset). NO implicit return value. Just the body;
        // a bare IR_RET that codegen drops (the asm terminates itself).
        func.num_args = param_count;
        gs.gen_stmt(node.body.stmts);
        g.emit_return(cast(i32, 0 - 1), 0);
    }
    else if (node.body.kind == ast.NK_BLOCK) {
        let is i32 as arg_idx with mut = 0;
        // SRET check — hidden first arg for struct return > 8 bytes
        if (cast(i64, node.return_type) != 0 && node.return_type.size > 8) {
            g.ctx_has_sret = 1;
            g.ctx_sret_vreg = g.emit_get_arg(arg_idx, g.tok_line(node.tok_idx));
            arg_idx = arg_idx + 1;
            param_count = param_count + 1;
        }
    func.num_args = param_count;
        // Get ALL args first (before any COPY that clobbers regs)
        let is i64 as avf_bytes with mut = cast(i64, func.num_args) * 4;
        if (avf_bytes < 8) { avf_bytes = 8; }
        let is *i32 as arg_vregs_fn = cast(*i32, d.opt_alloc(avf_bytes));
        let is *i32 as pcodes_fn = _param_codes(node, g.ctx_has_sret, func.num_args);
        let is i32 as arg_vi with mut = 0;
        p = node.params;
        while (cast(i64, p) != 0) {
            arg_vregs_fn[arg_vi] = _param_get_arg(pcodes_fn, arg_idx, g.tok_line(p.tok_idx));
            _param_type(p.ty);
            arg_vi = arg_vi + 1;
            arg_idx = arg_idx + 1;
            p = p.next;
        }
        if (cast(i64, pcodes_fn) != 0) { d.opt_free(cast(*u8, pcodes_fn)); }
        // Now store/copy args to local vars
        arg_vi = 0;
        p = node.params;
        while (cast(i64, p) != 0) {
            let is i32 as av = arg_vregs_fn[arg_vi];
            let is *ast.Type as pty = p.ty;
            if (cast(i64, pty) != 0 && pty.size > 8) {
                // Struct param passed by pointer — copy to local stack
                let is i32 as da = g.new_vreg();
                let is *d.IRInst as ai = d.new_inst(d.IR_ADDR);
                ai.dest = d.op_vreg(da);
                ai.src1 = d.op_imm(cast(i64, p.var_offset));
                ai.line = g.tok_line(p.tok_idx);
                g.emit(ai);
                let is *d.IRInst as cp = d.new_inst(d.IR_COPY);
                cp.dest = d.op_vreg(da);
                cp.src1 = d.op_vreg(av);
                cp.src2 = d.op_imm(cast(i64, pty.size));
                cp.line = g.tok_line(p.tok_idx);
                g.emit(cp);
            } else {
                let is *d.IRInst as si = d.new_inst(d.IR_STORE);
                si.dest = d.op_imm(cast(i64, p.var_offset));
                si.src1 = d.op_vreg(av);
                si.cast_to = cast(*u8, p.ty);
                si.line = g.tok_line(p.tok_idx);
                g.emit(si);
            }
            arg_vi = arg_vi + 1;
            p = p.next;
        }
        d.opt_free(cast(*u8, arg_vregs_fn));
        gs.gen_stmt(node.body.stmts);
        ge.emit_deferred_calls();
        // Implicit return
        let is i32 as zero = g.emit_imm(0, 0);
        g.emit_return(zero, 0);
    }

    func.instructions = g.ctx_head;
    func.vreg_count = g.ctx_vreg;
    func.label_count = g.ctx_label;
    func.stack_size = node.stack_size;
    func.ast_node = cast(*u8, node);

    // Per-function Phase 1: optimize + cache call targets. We KEEP
    // every function's IR resident through codegen instead of freeing
    // non-inline functions here and regenerating them from the AST at
    // codegen time. That regen (regen_func_ir) is the ONLY reason the
    // whole function-body AST had to stay live through codegen; with
    // it gone, the body AST can be freed right after IR-gen. Keeping
    // the IR costs a few MB; the freed body AST saves ~100MB.
    if (d.ir_opt_level >= 1 && cast(i64, func.instructions) != 0) {
        // Deferred-optimize (parallel-exe): skip the heavy per-function
        // optimize here and let each worker do it post-inline (it does
        // anyway), halving total optimize work and moving it off the
        // serial frontend. Still compute the cheap inline-decision
        // metadata so cross-module inlining fires in the workers.
        if (g_defer_optimize == 1) {
            opt.compute_inline_meta(func);
        } else {
            opt.optimize_func(func);
        }
        cache_call_targets(func);
    }

    return func;
}

// The streaming build's way in: lower a function now, for gen_ir to link later.
fn gen_stream_fn(node_p as *u8) as void {
    let is *ast.Node as node = cast(*ast.Node, node_p);
    if (node.generic_param_count > 0 || cast(i64, node.body) == 0) { return; }
    if (cast(i64, ast.nx_ir_func(node)) != 0) { return; }
    let is *d.IRFunction as func = _gen_fn(node);
    func.ast_node = cast(*u8, 0);
    ast.node_ensure_extra(node).ir_func = cast(*u8, func);
    if (d.ir_pack == 1) {
        // What reachability will want, while the list is here: -O0 caches none of it.
        if (func.call_target_count == 0) { cache_call_targets(func); }
        func.has_asm = opt.inline_has_asm_of(func);
        // Walking every instruction of every function is only worth it for
        // the --obj-cache key; without the cache nothing reads the hash.
        if (d.ir_hash_needed == 1) { func.ir_hash = d.func_value_hash(func); }
        d.func_pack(func);
    }
}

// The token list of the module whose parsed body this is, or 0.
fn _tl_of_body(body as *u8) as *u8 {
    let is *sd.Module as m with mut = smod.module_list;
    while (cast(i64, m) != 0) {
        if (cast(i64, m.body) == cast(i64, body)) { return m.token_list; }
        m = m.next;
    }
    return cast(*u8, 0);
}

fn gen_ir(root as *u8, no_main as i32) as *d.IRProgram {
    d.ir_alloc_init();
    g.ir_depth = g.ir_depth + 1;
    let is *d.IRProgram as prog = d.new_irprog();
    let is *d.IRFunction as func_tail with mut = cast(*d.IRFunction, 0);
    let is *d.IRGlobal as glob_tail with mut = cast(*d.IRGlobal, 0);

    let is *ast.Node as node with mut = cast(*ast.Node, root);
    while (cast(i64, node) != 0) {
        let is i32 as nk = node.kind;

        // Global LET
        if (nk == ast.NK_LET && node.is_global == 1) {
            if (node.is_extern == 1) { node = node.next; }
            else {
                let is *d.IRGlobal as glob = d.new_irglobal();
                if (node.asm_name_len > 0) {
                    glob.name_ptr = d.str_dup(node.asm_name_ptr, node.asm_name_len);
                    glob.name_len = node.asm_name_len;
                } else {
                    glob.name_ptr = d.str_dup(node.name_ptr, node.name_len);
                    glob.name_len = node.name_len;
                }
                glob.size = node.ty.size;
                if (cast(i64, node.init_expr) != 0) {
                    if (node.init_expr.kind == ast.NK_STRING) {
                        // String literal: register string, store ID
                        let is i32 as sid = g.register_string(node.init_expr.name_ptr, node.init_expr.name_len);
                        glob.init_value = cast(i64, sid);
                        glob.is_string_init = 1;
                        glob.is_string_const = node.is_string_const;
                    } else if (node.init_expr.kind == ast.NK_FN_PTR) {
                        // fn_ptr in global init: emit '.quad <mangled_name>' at codegen.
                        // name_ptr was replaced by the mangled asm name during semantic walk.
                        glob.is_fn_ptr_init = 1;
                        glob.init_fn_name_ptr = d.str_dup(node.init_expr.name_ptr, node.init_expr.name_len);
                        glob.init_fn_name_len = node.init_expr.name_len;
                    } else if (node.init_expr.kind == ast.NK_STRUCT_LIT) {
                        // Struct literal init. Keep the AST; codegen emits
                        // each entry at its field offset.
                        glob.is_struct_lit_init = 1;
                        glob.struct_lit_ast = cast(*u8, node.init_expr);
                    } else {
                        glob.init_value = eval_const_expr(node.init_expr);
                        // f32 global: convert f64 bits to f32 bits
                        if (node.ty.kind == ast.TY_F32) {
                            glob.init_value = ast.f32_bits(ast.i64_to_f64(glob.init_value));
                        }
                    }
                    glob.is_initialized = 1;
                }
                // Copy section attribute
                if (ast.nx_section_len(node) > 0) {
                    glob.section_ptr = d.str_dup(ast.nx_section_ptr(node), ast.nx_section_len(node));
                    glob.section_len = ast.nx_section_len(node);
                }
                if (cast(i64, glob_tail) == 0) {
                    prog.globals = glob;
                } else {
                    glob_tail.next = glob;
                }
                glob_tail = glob;
                node = node.next;
            }
        }
        // NK_FN
        else if (nk == ast.NK_FN) {
            // Skip generic templates
            if (node.generic_param_count > 0) { node = node.next; }
            // Skip extern / no body
            else if (cast(i64, node.body) == 0) { node = node.next; }
            else {
                let is *d.IRFunction as func with mut = cast(*d.IRFunction, ast.nx_ir_func(node));
                if (cast(i64, func) == 0) { func = _gen_fn(node); }

                if (cast(i64, func_tail) == 0) {
                    prog.functions = func;
                } else {
                    func_tail.next = func;
                }
                func_tail = func;

                // Check if main
                if (d.str_eq(func.name_ptr, func.name_len, "main", 4) == 1) {
                    prog.main_func = func;
                }

                node = node.next;
            }
        }
        // NK_USE — recurse
        else if (nk == ast.NK_USE) {
            if (cast(i64, node.body) != 0) {
                // First time this body is seen? note_done_body grows the table
                // as needed, so no module is ever walked twice for want of a
                // free slot.
                if (g.note_done_body(cast(*u8, node.body)) == 1) {
                    // Save/restore ir_tl: submodules have different token lists.
                    // With -g each module's own (kept for it), so its lines exist.
                    let is *u8 as saved_tl = g.ir_tl;
                    g.ir_tl = cast(*u8, 0);
                    if (tgt.debug_get() == 1) { g.ir_tl = _tl_of_body(cast(*u8, node.body)); }
                    let is *d.IRProgram as mod_prog = gen_ir(cast(*u8, node.body), 1);
                    // Merge functions
                    if (cast(i64, mod_prog.functions) != 0) {
                        if (cast(i64, func_tail) == 0) {
                            prog.functions = mod_prog.functions;
                        } else {
                            func_tail.next = mod_prog.functions;
                        }
                        // Find new tail
                        let is *d.IRFunction as ft with mut = mod_prog.functions;
                        while (cast(i64, ft.next) != 0) { ft = ft.next; }
                        func_tail = ft;
                    }
                    // Merge globals
                    if (cast(i64, mod_prog.globals) != 0) {
                        if (cast(i64, glob_tail) == 0) {
                            prog.globals = mod_prog.globals;
                        } else {
                            glob_tail.next = mod_prog.globals;
                        }
                        let is *d.IRGlobal as gt with mut = mod_prog.globals;
                        while (cast(i64, gt.next) != 0) { gt = gt.next; }
                        glob_tail = gt;
                    }
                    g.ir_tl = saved_tl;
                }
            }
            node = node.next;
        }
        else {
            node = node.next;
        }
    }

    // Search main after all merges (only at top level)
    if (g.ir_depth == 1 && cast(i64, prog.main_func) == 0) {
        let is *d.IRFunction as f with mut = prog.functions;
        while (cast(i64, f) != 0) {
            if (d.str_eq(f.name_ptr, f.name_len, "main", 4) == 1) {
                prog.main_func = f;
            }
            f = f.next;
        }
    }

    if (g.ir_depth == 1 && cast(i64, prog.main_func) == 0 && no_main == 0) {
        io.write_str(io.STDERR, "ir: function main not found\n");
        io.exit(1);
    }

    prog.strings = g.string_head;

    if (cast(i64, prog.main_func) != 0) {
        _reach_build_index(prog);
        mark_reachable(prog, prog.main_func);
        _reach_roots(prog);
    } else if (no_main == 1 && g.ir_depth == 1) {
        // Top-level library mode (`-c` with no main): everything is a
        // potential entry point, so mark all functions/globals reachable.
        // Recursive calls (ir_depth > 1) processing imported modules MUST
        // NOT do this — they should leave is_reachable=0 so the top-level
        // mark_reachable can perform proper DFS from real entry points.
        // Without this gate, every imported module's full function surface
        // (e.g. all 49 syscalls in std/linux.cst) gets emitted unconditionally,
        // bloating every binary that imports a stdlib module.
        let is *d.IRFunction as f with mut = prog.functions;
        while (cast(i64, f) != 0) { f.is_reachable = 1; f = f.next; }
        let is *d.IRGlobal as gv with mut = prog.globals;
        while (cast(i64, gv) != 0) { gv.is_reachable = 1; gv = gv.next; }
    }

    g.ir_depth = g.ir_depth - 1;
    return prog;
}
