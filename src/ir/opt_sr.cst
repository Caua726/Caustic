use "defs.cst" as d;
use "cfg.cst" as cfg;
use "dom.cst" as dom;
use "phi.cst" as phi;

// === Loop strength reduction on the SSA form ===
//
// An address that moves by a fixed amount each iteration becomes a pointer
// of its own, stepped once per iteration: the multiply or shift that scaled
// the induction variable leaves the loop.
//
// An induction variable is a phi p in a loop's header whose argument from the
// preheader is its first value x and whose argument from each latch is the
// same nx = q + step (an ADD or SUB of a constant), q being p itself or a copy or
// cast of it. Its first value is simply x. Without the SSA form (debug builds
// keep locals in memory) a stack slot whose loop has exactly one store to it,
// `[s] = load [s] + step`, executed on every iteration, is one too; its first
// value is the slot read in the preheader.
//
// A chain is the address `base + X` (an ADD), base invariant in the loop, X
// read only by that ADD:
//   P3    X = iv << k
//   FULL  X = (other + iv) << k, the sum maybe cast, other invariant; iv
//         may also be iv * K, K a constant (a row index times its width)
//   P4    X = iv * z, z an invariant register
//   P5    X = (iv * K) << sh, K a constant, sh <= 3
// where iv is q (the operand of the step), p, or a cast of either, through
// copies (P3 only q itself: a shift of another reading of the variable is the
// scaled index the addressing mode does for free). The chain
// becomes a header phi acc: acc0 = the chain's value on the first iteration,
// computed in the preheader from x; acc_next = acc + step * stride right after
// the step of the induction variable; the ADD becomes a copy of acc and what
// only fed it is gone. Loops that call are left alone (the pointer would have
// to live through every call), and so are loops without a preheader the
// address can be computed in: a header's one predecessor outside the loop,
// whose only successor it is, or a fall-through into it that a new block can
// be put on.
//
// Loops are taken outermost first, the analysis rebuilt after each loop that
// changed.

let is i32 as SR_MAX_IVS with imut = 8;
let is i32 as SR_MAX_CHAINS with imut = 16;

let is i32 as K_FULL with imut = 1;
let is i32 as K_P3 with imut = 3;
let is i32 as K_P4 with imut = 4;
let is i32 as K_P5 with imut = 5;

struct SrA {
    blocks as *cfg.BasicBlock;
    nb as i32;
    l2b as *i32;
    nlab as i32;
    preds as *i32;
    pred_start as *i32;
    pred_count as *i32;
    rpo as *i32;
    rpo_n as i32;
    reach as *u8;
    nv as i32;
    def_inst as *i64;   // the one live definition of v (0: none, or several)
    def_blk as *i32;    // its block (-1: none, or several)
    uc as *i32;         // live uses of v, phi arguments included
    user as *i64;       // the last live instruction other than a phi that reads v
    depth as *i32;      // number of loops a block is in
    inl as *u8;         // the loop being worked on
    stk as *i32;
    mat as *i32;        // vreg -> its copy in the preheader (-1: none yet)
}

// The loop being worked on.
struct SrL {
    h as i32;
    ph as i32;
    ph_label as i32;
    nlatch as i32;
    latch_label as *i32;
    cur as *d.IRInst;   // insertion point at the end of the preheader
    // induction variables
    niv as i32;
    iv_p as [8]i32;      // header phi (-1: a stack slot)
    iv_q as [8]i32;      // operand of the step
    iv_step as [8]i64;
    iv_add as [8]i64;    // the step: ADD nx = q, step
    iv_x as [8]i32;      // first value (phi argument from the preheader; -1 slot)
    iv_slot as [8]i64;   // stack slot offset
    iv_ld as [8]i64;     // the slot's load that feeds the step
    iv_x0 as [8]i32;     // slot: the preheader's load of the first value (-1 not yet)
    // chains
    nch as i32;
    ch_iv as [16]i32;
    ch_kind as [16]i32;
    ch_end as [16]i64;
    ch_base as [16]i32;
    ch_other as [16]i32;
    ch_shift as [16]i64;
    ch_stride as [16]i64;
    ch_z as [16]i32;
    ch_w as [16]i32;     // the chain's reading of the induction variable
    ch_dead1 as [16]i64;
    ch_dead2 as [16]i64;
    ch_dead3 as [16]i64;
    ch_mulk as [16]i64;  // FULL: the constant the induction variable is scaled by (1: none)
    ch_accp as [16]i32;  // the phi the chain became
    ch_add as [16]i64;   // FULL: a constant added to the sum before the shift
    ch_phic as [16]i64;  // the ch_add the phi in ch_accp stands for
}

fn _bb(a as *SrA, b as i32) as *cfg.BasicBlock {
    return cast(*cfg.BasicBlock, cast(i64, a.blocks) + cast(i64, b) * sizeof(cfg.BasicBlock));
}

fn _dominates(a as *SrA, x as i32, y0 as i32) as i32 {
    let is i32 as y with mut = y0;
    while (y >= 0) {
        if (y == x) { return 1; }
        let is i32 as id = _bb(a, y).idom;
        if (id == y) { return 0; }
        y = id;
    }
    return 0;
}

fn _blabel(a as *SrA, b as i32) as i32 {
    let is *cfg.BasicBlock as bb = _bb(a, b);
    if (bb.first.op == d.IR_LABEL) { return bb.first.dest.label; }
    return 0 - 1;
}

fn _use(a as *SrA, o as *d.Operand, it as *d.IRInst) as void {
    if (o.op_type != d.OP_VREG || o.vreg < 0 || o.vreg >= a.nv) { return; }
    a.uc[o.vreg] = a.uc[o.vreg] + 1;
    a.user[o.vreg] = cast(i64, it);
}

fn _a_free(a as *SrA) as void {
    d.opt_free(cast(*u8, a.blocks)); d.opt_free(cast(*u8, a.l2b));
    d.opt_free(cast(*u8, a.preds)); d.opt_free(cast(*u8, a.pred_start)); d.opt_free(cast(*u8, a.pred_count));
    d.opt_free(cast(*u8, a.rpo)); d.opt_free(a.reach);
    d.opt_free(cast(*u8, a.def_inst)); d.opt_free(cast(*u8, a.def_blk));
    d.opt_free(cast(*u8, a.uc)); d.opt_free(cast(*u8, a.user));
    d.opt_free(cast(*u8, a.depth)); d.opt_free(a.inl); d.opt_free(cast(*u8, a.stk));
    d.opt_free(cast(*u8, a.mat));
}

// inl[] = the loop headed by h (empty when h heads none); returns its latches.
fn _loop_body(a as *SrA, h as i32) as i32 {
    let is i32 as nb = a.nb;
    let is *u8 as inl = a.inl;
    let is i32 as k with mut = 0;
    while (k < nb) { inl[k] = cast(u8, 0); k = k + 1; }
    let is i32 as nl with mut = 0;
    let is i32 as sp with mut = 0;
    inl[h] = cast(u8, 1);
    k = 0;
    while (k < a.pred_count[h]) {
        let is i32 as p = a.preds[a.pred_start[h] + k];
        if (a.reach[p] == cast(u8, 1) && _dominates(a, h, p) == 1) {
            nl = nl + 1;
            if (inl[p] == cast(u8, 0)) { inl[p] = cast(u8, 1); a.stk[sp] = p; sp = sp + 1; }
        }
        k = k + 1;
    }
    if (nl == 0) { inl[h] = cast(u8, 0); return 0; }
    while (sp > 0) {
        sp = sp - 1;
        let is i32 as x = a.stk[sp];
        let is i32 as j with mut = 0;
        while (j < a.pred_count[x]) {
            let is i32 as p = a.preds[a.pred_start[x] + j];
            if (a.reach[p] == cast(u8, 1) && inl[p] == cast(u8, 0)) { inl[p] = cast(u8, 1); a.stk[sp] = p; sp = sp + 1; }
            j = j + 1;
        }
    }
    return nl;
}

fn _a_build(a as *SrA, func as *d.IRFunction) as void {
    let is i32 as cap = cfg.count_blocks(func) + 1;
    a.blocks = cast(*cfg.BasicBlock, d.opt_alloc(cast(i64, cap) * sizeof(cfg.BasicBlock)));
    a.nlab = func.label_count + 1;
    a.l2b = cast(*i32, d.opt_alloc(cast(i64, a.nlab) * 4));
    let is i32 as i with mut = 0;
    while (i < a.nlab) { a.l2b[i] = 0 - 1; i = i + 1; }
    let is i32 as nb with mut = 0;
    cfg.build_cfg(func, a.blocks, cap, &nb, a.l2b);
    a.nb = nb;
    a.preds = cast(*i32, d.opt_alloc(cast(i64, nb * 2 + 4) * 4));
    a.pred_start = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    a.pred_count = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    cfg.build_preds(a.blocks, nb, a.preds, a.pred_start, a.pred_count);
    a.rpo = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is i32 as rn with mut = 0;
    cfg.compute_rpo(a.blocks, nb, a.rpo, &rn);
    a.rpo_n = rn;
    dom.compute_idom(a.blocks, nb, a.rpo, rn, a.preds, a.pred_start, a.pred_count);
    a.reach = d.opt_alloc(cast(i64, nb + 1));
    i = 0;
    while (i < nb) { a.reach[i] = cast(u8, 0); i = i + 1; }
    i = 0;
    while (i < rn) { a.reach[a.rpo[i]] = cast(u8, 1); i = i + 1; }

    let is i32 as nv = func.vreg_count;
    a.nv = nv;
    a.def_inst = cast(*i64, d.opt_alloc(cast(i64, nv + 1) * 8));
    a.def_blk = cast(*i32, d.opt_alloc(cast(i64, nv + 1) * 4));
    a.uc = cast(*i32, d.opt_alloc(cast(i64, nv + 1) * 4));
    a.user = cast(*i64, d.opt_alloc(cast(i64, nv + 1) * 8));
    a.mat = cast(*i32, d.opt_alloc(cast(i64, nv + 1) * 4));
    let is *i32 as ndef = cast(*i32, d.opt_alloc(cast(i64, nv + 1) * 4));
    let is i32 as v with mut = 0;
    while (v < nv) {
        a.def_inst[v] = 0; a.def_blk[v] = 0 - 1; a.uc[v] = 0; a.user[v] = 0; a.mat[v] = 0 - 1; ndef[v] = 0;
        v = v + 1;
    }
    let is i32 as b with mut = 0;
    while (b < nb) {
        let is *cfg.BasicBlock as bb = _bb(a, b);
        let is *d.IRInst as it with mut = bb.first;
        let is i32 as done with mut = 0;
        while (done == 0) {
            if (it.is_dead == 0) {
                if (it.dest.op_type == d.OP_VREG && it.op != d.IR_STORE && it.op != d.IR_COPY
                    && it.dest.vreg >= 0 && it.dest.vreg < nv) {
                    ndef[it.dest.vreg] = ndef[it.dest.vreg] + 1;
                    a.def_inst[it.dest.vreg] = cast(i64, it);
                    a.def_blk[it.dest.vreg] = b;
                }
                if (it.op == d.IR_PHI) {
                    let is i32 as k with mut = 0;
                    while (k < phi.phi_nargs(it)) {
                        let is i32 as pv = phi.phi_val(it, k);
                        if (pv >= 0 && pv < nv) { a.uc[pv] = a.uc[pv] + 1; }
                        k = k + 1;
                    }
                } else {
                    _use(a, &it.src1, it);
                    _use(a, &it.src2, it);
                    if (it.op == d.IR_STORE || it.op == d.IR_COPY) { _use(a, &it.dest, it); }
                }
            }
            if (cast(i64, it) == cast(i64, bb.last)) { done = 1; } else { it = it.next; }
        }
        b = b + 1;
    }
    v = 0;
    while (v < nv) {
        if (ndef[v] != 1) { a.def_inst[v] = 0; a.def_blk[v] = 0 - 1; }
        v = v + 1;
    }
    d.opt_free(cast(*u8, ndef));

    a.inl = d.opt_alloc(cast(i64, nb + 1));
    a.stk = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    a.depth = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    b = 0;
    while (b < nb) { a.depth[b] = 0; b = b + 1; }
    let is i32 as h with mut = 0;
    while (h < nb) {
        if (a.reach[h] == cast(u8, 1) && _loop_body(a, h) > 0) {
            b = 0;
            while (b < nb) { if (a.inl[b] == cast(u8, 1)) { a.depth[b] = a.depth[b] + 1; } b = b + 1; }
        }
        h = h + 1;
    }
}

fn _def(a as *SrA, v as i32) as *d.IRInst {
    if (v < 0 || v >= a.nv) { return cast(*d.IRInst, 0); }
    return cast(*d.IRInst, a.def_inst[v]);
}

fn _in_loop(a as *SrA, v as i32) as i32 {
    if (v < 0 || v >= a.nv) { return 0; }
    let is i32 as b = a.def_blk[v];
    if (b < 0) { return 0; }
    return cast(i32, a.inl[b] == cast(u8, 1));
}

// A cast between integers (or pointers) of four bytes or more: on the values
// an induction variable takes it changes nothing.
fn _int_ty_wide(tp as *u8) as i32 {
    if (cast(i64, tp) == 0) { return 0; }
    let is i32 as k = *cast(*i32, tp);
    let is i32 as sz = *cast(*i32, cast(i64, tp) + 28);
    if (((k >= 1 && k <= 8) || k == 14) && sz >= 4) { return 1; }
    return 0;
}

fn _cast_ok(it as *d.IRInst) as i32 {
    if (cast(i64, it) == 0 || it.op != d.IR_CAST || it.src1.op_type != d.OP_VREG) { return 0; }
    if (_int_ty_wide(it.cast_to) == 0 || _int_ty_wide(it.cast_from) == 0) { return 0; }
    return 1;
}

// Is v defined outside the loop, or computable in the preheader from values
// that are (a constant, an address, arithmetic on such)?
fn _mat_ok(a as *SrA, v as i32, depth as i32) as i32 {
    if (v < 0 || v >= a.nv) { return 0; }
    let is i32 as b = a.def_blk[v];
    if (b < 0) { return 0; }
    if (a.inl[b] == cast(u8, 0)) { return 1; }
    if (depth > 3) { return 0; }
    let is *d.IRInst as it = _def(a, v);
    let is i32 as op = it.op;
    if (op == d.IR_IMM || op == d.IR_ADDR_GLOBAL || op == d.IR_FN_ADDR) { return 1; }
    if (op == d.IR_ADDR) { return cast(i32, it.src1.op_type == d.OP_IMM); }
    if (op != d.IR_MOV && op != d.IR_CAST && op != d.IR_ADD && op != d.IR_SUB && op != d.IR_MUL && op != d.IR_SHL) { return 0; }
    if (it.src1.op_type != d.OP_VREG && it.src1.op_type != d.OP_IMM && it.src1.op_type != d.OP_NONE) { return 0; }
    if (it.src2.op_type != d.OP_VREG && it.src2.op_type != d.OP_IMM && it.src2.op_type != d.OP_NONE) { return 0; }
    if (it.src1.op_type == d.OP_VREG && _mat_ok(a, it.src1.vreg, depth + 1) == 0) { return 0; }
    if (it.src2.op_type == d.OP_VREG && _mat_ok(a, it.src2.vreg, depth + 1) == 0) { return 0; }
    return 1;
}

// Insert after the preheader cursor.
fn _put(l as *SrL, it as *d.IRInst) as void {
    cfg.insert_after(l.cur, it);
    l.cur = it;
}

fn _newv(func as *d.IRFunction) as i32 {
    let is i32 as v = func.vreg_count;
    func.vreg_count = func.vreg_count + 1;
    return v;
}

fn _emit(func as *d.IRFunction, l as *SrL, op as i32, s1 as d.Operand, s2 as d.Operand) as i32 {
    let is i32 as v = _newv(func);
    let is *d.IRInst as it = d.new_inst(op);
    it.dest = d.op_vreg(v);
    it.src1 = s1;
    it.src2 = s2;
    _put(l, it);
    return v;
}

fn _fits32(x as i64) as i32 {
    return cast(i32, x >= 0 - 2147483648 && x <= 2147483647);
}

// src + imm in the preheader.
fn _emit_add_imm(func as *d.IRFunction, l as *SrL, src as i32, imm as i64) as i32 {
    if (_fits32(imm) == 1) { return _emit(func, l, d.IR_ADD, d.op_vreg(src), d.op_imm(imm)); }
    let is i32 as t = _emit(func, l, d.IR_IMM, d.op_imm(imm), d.op_none());
    return _emit(func, l, d.IR_ADD, d.op_vreg(src), d.op_vreg(t));
}

// v's value in the preheader: v itself when it is defined outside the loop,
// else a copy of its computation (made once per loop).
fn _mat(func as *d.IRFunction, a as *SrA, l as *SrL, v as i32) as i32 {
    let is i32 as b = a.def_blk[v];
    if (a.inl[b] == cast(u8, 0)) { return v; }
    if (a.mat[v] >= 0) { return a.mat[v]; }
    let is *d.IRInst as it = _def(a, v);
    let is d.Operand as s1 with mut = it.src1;
    let is d.Operand as s2 with mut = it.src2;
    if (s1.op_type == d.OP_VREG) { s1 = d.op_vreg(_mat(func, a, l, s1.vreg)); }
    if (s2.op_type == d.OP_VREG) { s2 = d.op_vreg(_mat(func, a, l, s2.vreg)); }
    let is *d.IRInst as c = d.clone_inst(it);
    let is i32 as nvr = _newv(func);
    c.dest = d.op_vreg(nvr);
    c.src1 = s1;
    c.src2 = s2;
    _put(l, c);
    a.mat[v] = nvr;
    return nvr;
}

// w through the copies it is of.
fn _strip(a as *SrA, w as i32) as i32 {
    let is i32 as cur with mut = w;
    let is i32 as hops with mut = 0;
    while (hops < 4) {
        let is *d.IRInst as di = _def(a, cur);
        if (cast(i64, di) == 0 || di.op != d.IR_MOV || di.src1.op_type != d.OP_VREG) { return cur; }
        cur = di.src1.vreg;
        hops = hops + 1;
    }
    return cur;
}

// Which induction variable does w read? w is q exactly (P3: the shift that
// the step reads too), or, through copies, q, p (allow_p) or a cast of
// either (allow_cast); with either allowed, also one of those plus or minus a
// constant (an index read as i + 1 moves with i: nx, the stepped value, is
// one). -1: none.
fn _iv_of(a as *SrA, l as *SrL, w0 as i32, allow_p as i32, allow_cast as i32) as i32 {
    let is i32 as r = _iv_of1(a, l, w0, allow_p, allow_cast);
    if (r >= 0 || (allow_p == 0 && allow_cast == 0) || w0 < 0) { return r; }
    let is *d.IRInst as ad = _def(a, _strip(a, w0));
    if (cast(i64, ad) == 0 || (ad.op != d.IR_ADD && ad.op != d.IR_SUB) || _step_of(ad) == 0) { return 0 - 1; }
    if (_in_loop(a, ad.dest.vreg) == 0) { return 0 - 1; }
    return _iv_of1(a, l, ad.src1.vreg, 1, 1);
}

fn _iv_of1(a as *SrA, l as *SrL, w0 as i32, allow_p as i32, allow_cast as i32) as i32 {
    if (w0 < 0) { return 0 - 1; }
    let is i32 as w with mut = w0;
    let is i32 as strip = cast(i32, allow_p == 1 || allow_cast == 1);
    if (strip == 1) { w = _strip(a, w0); }
    let is i32 as k with mut = 0;
    while (k < l.niv) {
        if (w == l.iv_q[k]) { return k; }
        if ((allow_p == 1 || strip == 1) && l.iv_p[k] >= 0 && w == l.iv_p[k]) { return k; }
        k = k + 1;
    }
    if (allow_cast == 1) {
        let is *d.IRInst as c = _def(a, w);
        if (_cast_ok(c) == 1) {
            let is i32 as s with mut = c.src1.vreg;
            if (strip == 1) { s = _strip(a, s); }
            k = 0;
            while (k < l.niv) {
                if (s == l.iv_q[k] || (l.iv_p[k] >= 0 && s == l.iv_p[k])) { return k; }
                k = k + 1;
            }
        }
    }
    return 0 - 1;
}

// The ADD of the loop that reads x (read only there) next to an invariant
// base, which goes to *base_out; null when there is none.
fn _end_add(a as *SrA, x as i32, base_out as *i32) as *d.IRInst {
    if (x < 0 || x >= a.nv || a.uc[x] != 1) { return cast(*d.IRInst, 0); }
    let is *d.IRInst as e = cast(*d.IRInst, a.user[x]);
    if (cast(i64, e) == 0 || e.is_dead != 0 || e.op != d.IR_ADD) { return cast(*d.IRInst, 0); }
    if (e.src1.op_type != d.OP_VREG || e.src2.op_type != d.OP_VREG || e.dest.op_type != d.OP_VREG) { return cast(*d.IRInst, 0); }
    if (_in_loop(a, e.dest.vreg) == 0) { return cast(*d.IRInst, 0); }
    let is i32 as base with mut = 0 - 1;
    if (e.src1.vreg == x && e.src2.vreg != x) { base = e.src2.vreg; }
    else if (e.src2.vreg == x && e.src1.vreg != x) { base = e.src1.vreg; }
    if (base < 0 || _mat_ok(a, base, 0) == 0) { return cast(*d.IRInst, 0); }
    *base_out = base;
    return e;
}

fn _add_chain(l as *SrL, iv as i32, kind as i32, e as *d.IRInst, base as i32, other as i32, shift as i64,
              stride as i64, z as i32, w as i32, d1 as *d.IRInst, d2 as *d.IRInst, d3 as *d.IRInst) as void {
    let is i32 as c = l.nch;
    if (c >= SR_MAX_CHAINS) { return; }
    // one chain per address
    let is i32 as k with mut = 0;
    while (k < c) { if (l.ch_end[k] == cast(i64, e)) { return; } k = k + 1; }
    l.ch_iv[c] = iv;
    l.ch_kind[c] = kind;
    l.ch_end[c] = cast(i64, e);
    l.ch_base[c] = base;
    l.ch_other[c] = other;
    l.ch_shift[c] = shift;
    l.ch_stride[c] = stride;
    l.ch_z[c] = z;
    l.ch_w[c] = w;
    l.ch_dead1[c] = cast(i64, d1);
    l.ch_dead2[c] = cast(i64, d2);
    l.ch_dead3[c] = cast(i64, d3);
    l.ch_mulk[c] = 1;
    l.ch_add[c] = 0;
    l.ch_phic[c] = 0;
    l.nch = c + 1;
}

// Chains rooted at a SHL: P3, FULL.
fn _match_shl(a as *SrA, l as *SrL, s as *d.IRInst) as void {
    if (s.src1.op_type != d.OP_VREG || s.src2.op_type != d.OP_IMM || s.dest.op_type != d.OP_VREG) { return; }
    let is i64 as k = s.src2.imm;
    if (k < 0 || k > 63) { return; }
    let is i32 as src = s.src1.vreg;
    if (src < 0 || src >= a.nv) { return; }
    let is i32 as base with mut = 0 - 1;
    // P3: the operand of the step itself, shifted
    let is i32 as iv with mut = _iv_of(a, l, src, 0, 0);
    if (iv >= 0) {
        let is *d.IRInst as e = _end_add(a, s.dest.vreg, &base);
        if (cast(i64, e) != 0) {
            _add_chain(l, iv, K_P3, e, base, 0 - 1, k, cast(i64, 1) << k, 0 - 1, src,
                       s, cast(*d.IRInst, 0), cast(*d.IRInst, 0));
        }
        return;
    }
    // FULL: (other + iv) << k, the sum maybe cast. At -O2 the sum may be read
    // by others as well and reached through copies (a local index read several
    // times); what stays unread then goes in DCE.
    if (_in_loop(a, src) == 0) { return; }
    let is i32 as shared with mut = cast(i32, a.uc[src] != 1);
    if (shared == 1 && d.ir_opt_level < 2) { return; }
    let is i32 as sum with mut = src;
    let is *d.IRInst as cst with mut = cast(*d.IRInst, 0);
    let is *d.IRInst as sd = _def(a, src);
    if (cast(i64, sd) != 0 && sd.op == d.IR_CAST && sd.src1.op_type == d.OP_VREG) {
        if (_cast_ok(sd) == 0) { return; }
        cst = sd;
        sum = sd.src1.vreg;
    }
    let is i32 as top = sum;
    if (d.ir_opt_level >= 2) { sum = _strip(a, sum); }
    if (sum != top) { shared = 1; }
    let is *d.IRInst as ad with mut = _def(a, sum);
    // -O2: (other + iv) + C, C a constant, the sum maybe cast: the index of a
    // neighbour (j - 1, j + 1 next to j). Its chain is the sum's, displaced by
    // C << k, and shares a phi with the other chains of that sum (_twin).
    let is i64 as addc with mut = 0;
    let is *d.IRInst as dout with mut = cast(*d.IRInst, 0);
    if (d.ir_opt_level >= 2 && cast(i64, ad) != 0 && (ad.op == d.IR_ADD || ad.op == d.IR_SUB)
        && _step_of(ad) != 0 && _in_loop(a, sum) == 1) {
        let is i32 as inner with mut = _strip(a, ad.src1.vreg);
        let is *d.IRInst as ai with mut = _def(a, inner);
        if (_cast_ok(ai) == 1) {
            inner = _strip(a, ai.src1.vreg);
            ai = _def(a, inner);
        }
        if (cast(i64, ai) != 0 && ai.op == d.IR_ADD && ai.src1.op_type == d.OP_VREG
            && ai.src2.op_type == d.OP_VREG) {
            addc = _step_of(ad);
            dout = ad;
            sum = inner;
            ad = ai;
        }
    }
    if (cast(i64, ad) == 0 || ad.op != d.IR_ADD || ad.src1.op_type != d.OP_VREG || ad.src2.op_type != d.OP_VREG) { return; }
    if (_in_loop(a, sum) == 0) { return; }
    let is i32 as va = ad.src1.vreg;
    let is i32 as vb = ad.src2.vreg;
    let is i32 as other with mut = 0 - 1;
    let is i32 as w with mut = 0 - 1;
    let is i64 as mk with mut = 1;
    iv = _iv_of(a, l, vb, 0, 1);
    if (iv >= 0) { other = va; w = vb; }
    else {
        iv = _iv_of(a, l, va, 0, 1);
        if (iv >= 0) { other = vb; w = va; }
    }
    // (other + iv * K) << k
    if (iv < 0) {
        let is *d.IRInst as mm with mut = _scaled_iv(a, l, vb);
        if (cast(i64, mm) != 0) { other = va; }
        else {
            mm = _scaled_iv(a, l, va);
            if (cast(i64, mm) != 0) { other = vb; }
        }
        if (cast(i64, mm) != 0) {
            w = mm.src1.vreg;
            iv = _iv_of(a, l, _mul_opnd(a, w), 1, 0);
            mk = mm.src2.imm;
        }
    }
    if (iv < 0 || _mat_ok(a, other, 0) == 0) { return; }
    let is *d.IRInst as e = _end_add(a, s.dest.vreg, &base);
    if (cast(i64, e) == 0) { return; }
    // the sum dies with the chain only when the chain is its one reader
    // (with a constant added, the sum itself may have other readers: DCE
    // drops it when it has none)
    let is *d.IRInst as dsum with mut = ad;
    if (cast(i64, dout) != 0) { dsum = dout; }
    if (cast(i64, cst) != 0 && a.uc[top] != 1) { dsum = cast(*d.IRInst, 0); }
    if (shared == 1) { dsum = cast(*d.IRInst, 0); cst = cast(*d.IRInst, 0); }
    if (mk != 1 && (k > 6 || _fits32(mk << k) == 0)) { return; }
    if (cast(i64, dout) != 0 && (k > 6 || _fits32(addc << k) == 0)) { return; }
    _add_chain(l, iv, K_FULL, e, base, other, k, mk << k, 0 - 1, w, dsum, s, cst);
    if (l.nch > 0 && l.ch_end[l.nch - 1] == cast(i64, e)) {
        l.ch_mulk[l.nch - 1] = mk;
        l.ch_add[l.nch - 1] = addc;
    }
}

// x = iv * K, K a constant in [2, 2^31), read only by the sum: the MUL.
fn _scaled_iv(a as *SrA, l as *SrL, x as i32) as *d.IRInst {
    let is *d.IRInst as none = cast(*d.IRInst, 0);
    if (x < 0 || x >= a.nv || a.uc[x] != 1 || _in_loop(a, x) == 0) { return none; }
    let is *d.IRInst as m = _def(a, x);
    if (cast(i64, m) == 0 || m.op != d.IR_MUL || m.src1.op_type != d.OP_VREG || m.src2.op_type != d.OP_IMM) { return none; }
    if (m.src2.imm < 2 || m.src2.imm > 2147483647) { return none; }
    if (_iv_of(a, l, _mul_opnd(a, m.src1.vreg), 1, 0) < 0) { return none; }
    return m;
}

// The operand of a MUL, through one cast.
fn _mul_opnd(a as *SrA, v as i32) as i32 {
    let is *d.IRInst as c = _def(a, v);
    if (_cast_ok(c) == 1) { return c.src1.vreg; }
    return v;
}

// Chains rooted at a MUL: P4, P5.
fn _match_mul(a as *SrA, l as *SrL, m as *d.IRInst) as void {
    if (m.src1.op_type != d.OP_VREG || m.dest.op_type != d.OP_VREG) { return; }
    let is i32 as base with mut = 0 - 1;
    if (m.src2.op_type == d.OP_VREG) {
        // P4: iv * z
        let is i32 as ma = m.src1.vreg;
        let is i32 as mb = m.src2.vreg;
        let is i32 as iv with mut = 0 - 1;
        let is i32 as z with mut = 0 - 1;
        let is i32 as w with mut = 0 - 1;
        let is i32 as ka = _iv_of(a, l, _mul_opnd(a, ma), 1, 0);
        let is i32 as kb = _iv_of(a, l, _mul_opnd(a, mb), 1, 0);
        if (ka >= 0 && _in_loop(a, mb) == 0 && _mat_ok(a, mb, 0) == 1) { iv = ka; z = mb; w = ma; }
        else if (kb >= 0 && _in_loop(a, ma) == 0 && _mat_ok(a, ma, 0) == 1) { iv = kb; z = ma; w = mb; }
        if (iv < 0) { return; }
        let is *d.IRInst as e = _end_add(a, m.dest.vreg, &base);
        if (cast(i64, e) == 0) { return; }
        _add_chain(l, iv, K_P4, e, base, 0 - 1, 0, 0, z, w, m, cast(*d.IRInst, 0), cast(*d.IRInst, 0));
        return;
    }
    if (m.src2.op_type != d.OP_IMM) { return; }
    // P5: (iv * K) << sh
    let is i64 as kk = m.src2.imm;
    if (kk < 1 || kk > 2147483647) { return; }
    let is i32 as iv5 = _iv_of(a, l, _mul_opnd(a, m.src1.vreg), 1, 0);
    if (iv5 < 0) { return; }
    let is i32 as md = m.dest.vreg;
    if (md < 0 || md >= a.nv || a.uc[md] != 1) { return; }
    let is *d.IRInst as sh = cast(*d.IRInst, a.user[md]);
    if (cast(i64, sh) == 0 || sh.is_dead != 0 || sh.op != d.IR_SHL || sh.dest.op_type != d.OP_VREG) { return; }
    if (sh.src1.op_type != d.OP_VREG || sh.src1.vreg != md || sh.src2.op_type != d.OP_IMM) { return; }
    if (sh.src2.imm < 0 || sh.src2.imm > 3) { return; }
    if (_in_loop(a, sh.dest.vreg) == 0) { return; }
    let is *d.IRInst as e = _end_add(a, sh.dest.vreg, &base);
    if (cast(i64, e) == 0) { return; }
    _add_chain(l, iv5, K_P5, e, base, 0 - 1, sh.src2.imm, kk << sh.src2.imm, 0 - 1, m.src1.vreg,
               m, sh, cast(*d.IRInst, 0));
}

// The constant a vreg holds through copies, if any.
fn _const_of(a as *SrA, v0 as i32, out as *i64) as i32 {
    let is i32 as v with mut = v0;
    let is i32 as hops with mut = 0;
    while (hops < 4) {
        let is *d.IRInst as it = _def(a, v);
        if (cast(i64, it) == 0) { return 0; }
        if (it.op == d.IR_IMM && it.src1.op_type == d.OP_IMM) { *out = it.src1.imm; return 1; }
        if (it.op == d.IR_MOV && it.src1.op_type == d.OP_IMM) { *out = it.src1.imm; return 1; }
        if (it.op != d.IR_MOV || it.src1.op_type != d.OP_VREG) { return 0; }
        v = it.src1.vreg;
        hops = hops + 1;
    }
    return 0;
}

// w's value on the first iteration, in the preheader: a constant (returns 1,
// *c) or a register (returns 0, *v). w reads the induction variable's root (p,
// or the slot's load) through copies, casts and the step itself (nx): those
// are applied to the first value of the root.
fn _first(func as *d.IRFunction, a as *SrA, l as *SrL, iv as i32, w as i32, c as *i64, v as *i32) as i32 {
    let is i32 as root with mut = l.iv_p[iv];
    if (root < 0) { root = l.iv_q[iv]; }
    let is [16]i64 as path;
    let is i32 as np with mut = 0;
    let is i32 as ncast with mut = 0;
    let is i64 as adj with mut = 0;
    let is i32 as cur with mut = w;
    while (cur != root && np < 16) {
        let is *d.IRInst as di = _def(a, cur);
        path[np] = cast(i64, di);
        np = np + 1;
        if (di.op == d.IR_CAST) { ncast = ncast + 1; }
        if (di.op == d.IR_ADD || di.op == d.IR_SUB) { adj = adj + _step_of(di); }
        cur = di.src1.vreg;
    }
    let is i32 as x with mut = l.iv_x[iv];
    if (l.iv_p[iv] < 0) {
        // a stack slot: read it where the loop starts
        if (l.iv_x0[iv] < 0) {
            let is *d.IRInst as ld = cast(*d.IRInst, l.iv_ld[iv]);
            let is *d.IRInst as c0 = d.clone_inst(ld);
            let is i32 as nvr = _newv(func);
            c0.dest = d.op_vreg(nvr);
            _put(l, c0);
            l.iv_x0[iv] = nvr;
        }
        x = l.iv_x0[iv];
    } else {
        let is i64 as k with mut = 0;
        if (_const_of(a, x, &k) == 1) {
            // a constant in [0, 2^31) reads the same through any of the casts
            // (and stays one after the step, when w is nx)
            let is i64 as k2 = k + adj;
            if (k >= 0 && k <= 2147483647 && k2 >= 0 && k2 <= 2147483647) { *c = k2; return 1; }
            if (ncast == 0 && k >= 0 - 2147483648 && k < 0 && k2 >= 0 - 2147483648 && k2 <= 2147483647) { *c = k2; return 1; }
        }
    }
    let is i32 as val with mut = x;
    let is i32 as j with mut = np - 1;
    while (j >= 0) {
        let is *d.IRInst as di = cast(*d.IRInst, path[j]);
        if (di.op == d.IR_CAST || di.op == d.IR_ADD || di.op == d.IR_SUB) {
            let is *d.IRInst as cc = d.clone_inst(di);
            let is i32 as nc = _newv(func);
            cc.dest = d.op_vreg(nc);
            cc.src1 = d.op_vreg(val);
            _put(l, cc);
            val = nc;
        }
        j = j - 1;
    }
    *v = val;
    return 0;
}

// The step of `nx = q + step` (or `q - k`, a step of -k); 0: not one.
fn _step_of(ad as *d.IRInst) as i64 {
    if (cast(i64, ad) == 0 || ad.src1.op_type != d.OP_VREG || ad.src2.op_type != d.OP_IMM) { return 0; }
    let is i64 as k = ad.src2.imm;
    if (k < 0 - 2147483647 || k > 2147483647) { return 0; }
    if (ad.op == d.IR_ADD) { return k; }
    if (ad.op == d.IR_SUB) { return 0 - k; }
    return 0;
}

fn _try_phi_iv(a as *SrA, l as *SrL, p as *d.IRInst) as void {
    let is i32 as pv = p.dest.vreg;
    let is i32 as ai = phi.phi_find(p, l.ph_label);
    if (ai < 0) { return; }
    let is i32 as x = phi.phi_val(p, ai);
    if (x < 0 || x >= a.nv) { return; }
    let is i32 as nx with mut = 0 - 1;
    let is i32 as j with mut = 0;
    while (j < l.nlatch) {
        let is i32 as k = phi.phi_find(p, l.latch_label[j]);
        if (k < 0) { return; }
        let is i32 as v = phi.phi_val(p, k);
        if (v < 0 || (nx >= 0 && v != nx)) { return; }
        nx = v;
        j = j + 1;
    }
    let is *d.IRInst as ad = _def(a, nx);
    let is i64 as step = _step_of(ad);
    if (step == 0) { return; }
    // the step runs in this loop, not in one nested in it
    let is i32 as ab = a.def_blk[nx];
    if (ab < 0 || a.inl[ab] == cast(u8, 0) || a.depth[ab] != a.depth[l.h]) { return; }
    let is i32 as q = ad.src1.vreg;
    if (q != pv) {
        let is *d.IRInst as qd = _def(a, q);
        if (cast(i64, qd) == 0 || qd.src1.op_type != d.OP_VREG || qd.src1.vreg != pv) { return; }
        if (qd.op != d.IR_MOV && _cast_ok(qd) == 0) { return; }
    }
    let is i32 as n = l.niv;
    l.iv_p[n] = pv;
    l.iv_q[n] = q;
    l.iv_step[n] = step;
    l.iv_add[n] = cast(i64, ad);
    l.iv_x[n] = x;
    l.iv_slot[n] = 0;
    l.iv_ld[n] = 0;
    l.iv_x0[n] = 0 - 1;
    l.niv = n + 1;
}

// The header's phis: induction variables.
fn _find_phi_ivs(a as *SrA, l as *SrL) as void {
    let is *cfg.BasicBlock as hb = _bb(a, l.h);
    let is *d.IRInst as it with mut = hb.first;
    if (it.op != d.IR_LABEL || cast(i64, it) == cast(i64, hb.last)) { return; }
    it = it.next;
    let is i32 as done with mut = 0;
    while (done == 0 && l.niv < SR_MAX_IVS) {
        if (it.op != d.IR_PHI) { done = 1; }
        else {
            if (it.is_dead == 0) { _try_phi_iv(a, l, it); }
            if (cast(i64, it) == cast(i64, hb.last)) { done = 1; } else { it = it.next; }
        }
    }
}

// Is the store `st` in a block of the loop? (A store defines no vreg, so its
// block is found by walking the loop's blocks.)
fn _st_in_loop(a as *SrA, st as *d.IRInst) as i32 {
    let is i32 as b with mut = 0;
    while (b < a.nb) {
        if (a.inl[b] == cast(u8, 1)) {
            let is *cfg.BasicBlock as bb = _bb(a, b);
            let is *d.IRInst as it with mut = bb.first;
            let is i32 as done with mut = 0;
            while (done == 0) {
                if (cast(i64, it) == cast(i64, st)) { return 1; }
                if (cast(i64, it) == cast(i64, bb.last)) { done = 1; } else { it = it.next; }
            }
        }
        b = b + 1;
    }
    return 0;
}

fn _try_slot_iv(func as *d.IRFunction, a as *SrA, l as *SrL, st as *d.IRInst, sb as i32) as void {
    let is i64 as slot = st.dest.imm;
    let is i32 as nx = st.src1.vreg;
    let is *d.IRInst as ad = _def(a, nx);
    let is i64 as step = _step_of(ad);
    if (step == 0) { return; }
    let is i32 as q = ad.src1.vreg;
    let is *d.IRInst as ld = _def(a, q);
    if (cast(i64, ld) == 0 || ld.op != d.IR_LOAD || ld.src1.op_type != d.OP_IMM || ld.src1.imm != slot) { return; }
    let is i32 as lb = a.def_blk[q];
    let is i32 as ab = a.def_blk[nx];
    if (lb < 0 || ab < 0 || a.inl[lb] == cast(u8, 0) || a.inl[ab] == cast(u8, 0)) { return; }
    // the step and the store run on every iteration
    let is i32 as j with mut = 0;
    while (j < l.nlatch) {
        let is i32 as lt = a.l2b[l.latch_label[j]];
        if (lt < 0 || _dominates(a, sb, lt) == 0 || _dominates(a, ab, lt) == 0) { return; }
        j = j + 1;
    }
    // the slot's one store in the loop, and its address never taken
    let is *d.IRInst as it with mut = func.instructions;
    while (cast(i64, it) != 0) {
        if (it.is_dead == 0) {
            if (it.op == d.IR_ADDR && it.src1.op_type == d.OP_IMM && it.src1.imm == slot) { return; }
            if (it.op == d.IR_STORE && it.dest.op_type == d.OP_IMM && it.dest.imm == slot && cast(i64, it) != cast(i64, st)
                && _st_in_loop(a, it) == 1) { return; }
        }
        it = it.next;
    }
    let is i32 as k with mut = 0;
    while (k < l.niv) { if (l.iv_p[k] < 0 && l.iv_slot[k] == slot) { return; } k = k + 1; }
    let is i32 as n = l.niv;
    l.iv_p[n] = 0 - 1;
    l.iv_q[n] = q;
    l.iv_step[n] = step;
    l.iv_add[n] = cast(i64, ad);
    l.iv_x[n] = 0 - 1;
    l.iv_slot[n] = slot;
    l.iv_ld[n] = cast(i64, ld);
    l.iv_x0[n] = 0 - 1;
    l.niv = n + 1;
}

// Stack-slot induction variables: `[s] = load [s] + step` the loop's one
// store to s, on every iteration, s never addressed.
fn _find_slot_ivs(func as *d.IRFunction, a as *SrA, l as *SrL) as void {
    let is i32 as nb = a.nb;
    let is i32 as b with mut = 0;
    while (b < nb && l.niv < SR_MAX_IVS) {
        if (a.inl[b] == cast(u8, 1) && a.depth[b] == a.depth[l.h]) {
            let is *cfg.BasicBlock as bb = _bb(a, b);
            let is *d.IRInst as it with mut = bb.first;
            let is i32 as done with mut = 0;
            while (done == 0 && l.niv < SR_MAX_IVS) {
                if (it.is_dead == 0 && it.op == d.IR_STORE && it.dest.op_type == d.OP_IMM && it.src1.op_type == d.OP_VREG) {
                    _try_slot_iv(func, a, l, it, b);
                }
                if (cast(i64, it) == cast(i64, bb.last)) { done = 1; } else { it = it.next; }
            }
        }
        b = b + 1;
    }
}

fn _is_callish(op as i32) as i32 {
    if (op == d.IR_CALL || op == d.IR_CALL_INDIRECT || op == d.IR_FFI_CALL || op == d.IR_SYSCALL
        || op == d.IR_ATOMIC_LOAD || op == d.IR_ATOMIC_STORE || op == d.IR_ATOMIC_ADD || op == d.IR_ATOMIC_XCHG
        || op == d.IR_CAS_EXPECTED || op == d.IR_ATOMIC_CAS || op == d.IR_FENCE) { return 1; }
    return 0;
}

// The copies the chains' addresses became (dest, src pairs): their readers
// read the phi directly once all loops are done.
let is *i32 as sr_cp with mut;
let is i32 as sr_ncp with mut = 0;
let is i32 as sr_cpcap with mut = 0;

fn _note_copy(dv as i32, sv as i32) as void {
    if (sr_ncp + 2 > sr_cpcap) {
        let is i32 as nc with mut = sr_cpcap * 2;
        if (nc < 64) { nc = 64; }
        let is *i32 as nb = cast(*i32, d.opt_alloc(cast(i64, nc) * 4));
        let is i32 as i with mut = 0;
        while (i < sr_ncp) { nb[i] = sr_cp[i]; i = i + 1; }
        if (sr_cpcap > 0) { d.opt_free(cast(*u8, sr_cp)); }
        sr_cp = nb;
        sr_cpcap = nc;
    }
    sr_cp[sr_ncp] = dv;
    sr_cp[sr_ncp + 1] = sv;
    sr_ncp = sr_ncp + 2;
}

fn _rd(o as *d.Operand, map as *i32, n as i32) as void {
    if (o.op_type != d.OP_VREG || o.vreg < 0 || o.vreg >= n) { return; }
    let is i32 as hops with mut = 0;
    while (hops < 16 && map[o.vreg] >= 0) { o.vreg = map[o.vreg]; hops = hops + 1; }
}

// Every reader of a chain's copy inside the loop reads the phi it is a copy
// of: in the iteration that made the copy the phi has not moved yet. (After
// the loop it has: a reader there keeps the copy.) The load and the store of
// one array element then name the same register.
fn _resolve_copies(func as *d.IRFunction, a as *SrA) as void {
    if (sr_ncp == 0) { return; }
    let is i32 as n = func.vreg_count;
    let is *i32 as map = cast(*i32, d.opt_alloc(cast(i64, n + 1) * 4));
    let is i32 as i with mut = 0;
    while (i < n) { map[i] = 0 - 1; i = i + 1; }
    i = 0;
    while (i < sr_ncp) {
        if (sr_cp[i] >= 0 && sr_cp[i] < n) { map[sr_cp[i]] = sr_cp[i + 1]; }
        i = i + 2;
    }
    let is i32 as b with mut = 0;
    while (b < a.nb) {
        if (a.inl[b] == cast(u8, 1)) {
        let is *cfg.BasicBlock as bb = _bb(a, b);
        let is *d.IRInst as it with mut = bb.first;
        let is i32 as done with mut = 0;
        while (done == 0) {
        if (it.is_dead == 0) {
            if (it.op == d.IR_PHI) {
                let is i32 as k with mut = 0;
                while (k < phi.phi_nargs(it)) {
                    let is i32 as v with mut = phi.phi_val(it, k);
                    let is i32 as hops with mut = 0;
                    while (v >= 0 && v < n && hops < 16 && map[v] >= 0) { v = map[v]; hops = hops + 1; }
                    phi.phi_set_val(it, k, v);
                    k = k + 1;
                }
            } else {
                _rd(&it.src1, map, n);
                _rd(&it.src2, map, n);
                if (dest_reads(it) == 1) { _rd(&it.dest, map, n); }
            }
        }
        if (cast(i64, it) == cast(i64, bb.last)) { done = 1; } else { it = it.next; }
        }
        }
        b = b + 1;
    }
    d.opt_free(cast(*u8, map));
    sr_ncp = 0;
}

// The instruction reads its dest operand (an address it writes through).
fn dest_reads(it as *d.IRInst) as i32 {
    let is i32 as op = it.op;
    return cast(i32, op == d.IR_STORE || op == d.IR_COPY || op == d.IR_ATOMIC_STORE || op == d.IR_CMOV
        || op == d.IR_VSTOREQ || op == d.IR_VSTOREQ256);
}

fn _kill(p as i64) as void {
    if (p == 0) { return; }
    let is *d.IRInst as it = cast(*d.IRInst, p);
    it.is_dead = 1;
}

// Two operands that are the same value: equal through copies, or the same
// pure operation on operands that are (the form is SSA: one definition each).
fn _eqv(a as *SrA, x0 as i32, y0 as i32, depth as i32) as i32 {
    if (x0 < 0 || y0 < 0) { return cast(i32, x0 == y0); }
    let is i32 as x = _strip(a, x0);
    let is i32 as y = _strip(a, y0);
    if (x == y) { return 1; }
    if (depth > 4) { return 0; }
    let is *d.IRInst as dx = _def(a, x);
    let is *d.IRInst as dy = _def(a, y);
    if (cast(i64, dx) == 0 || cast(i64, dy) == 0 || dx.op != dy.op) { return 0; }
    let is i32 as op = dx.op;
    if (op != d.IR_ADD && op != d.IR_SUB && op != d.IR_MUL && op != d.IR_SHL && op != d.IR_CAST
        && op != d.IR_IMM && op != d.IR_AND && op != d.IR_OR && op != d.IR_XOR) { return 0; }
    if (cast(i64, dx.cast_to) != cast(i64, dy.cast_to) || cast(i64, dx.cast_from) != cast(i64, dy.cast_from)) { return 0; }
    if (_eqo(a, &dx.src1, &dy.src1, depth) == 0) { return 0; }
    return _eqo(a, &dx.src2, &dy.src2, depth);
}

fn _eqo(a as *SrA, p as *d.Operand, q as *d.Operand, depth as i32) as i32 {
    if (p.op_type != q.op_type) { return 0; }
    if (p.op_type == d.OP_NONE) { return 1; }
    if (p.op_type == d.OP_IMM) { return cast(i32, p.imm == q.imm); }
    if (p.op_type == d.OP_VREG) { return _eqv(a, p.vreg, q.vreg, depth + 1); }
    return 0;
}

fn _same_v(a as *SrA, x as i32, y as i32) as i32 { return _eqv(a, x, y, 0); }

// An earlier chain of the loop that computes the same address (the same
// array element written and read back), or one a constant away (a[x + j - 1]
// next to a[x + j]): its index, or -1.
fn _twin(a as *SrA, l as *SrL, ci as i32) as i32 {
    let is i32 as cj with mut = 0;
    while (cj < ci) {
        if (l.ch_iv[cj] == l.ch_iv[ci] && l.ch_kind[cj] == l.ch_kind[ci]
            && _fits32((l.ch_add[ci] - l.ch_phic[cj]) << l.ch_shift[ci]) == 1
            && l.ch_shift[cj] == l.ch_shift[ci] && l.ch_stride[cj] == l.ch_stride[ci]
            && l.ch_mulk[cj] == l.ch_mulk[ci]
            && _same_v(a, l.ch_base[cj], l.ch_base[ci]) == 1
            && _same_v(a, l.ch_other[cj], l.ch_other[ci]) == 1
            && _same_v(a, l.ch_z[cj], l.ch_z[ci]) == 1
            && _same_v(a, l.ch_w[cj], l.ch_w[ci]) == 1) {
            return cj;
        }
        cj = cj + 1;
    }
    return 0 - 1;
}

// Rewrite chain ci: its value on the first iteration in the preheader, a
// header phi stepping it, the address a copy of the phi. Returns 1 when a phi
// was put after phi_at, 0 when the chain reuses the phi of a twin.
fn _reduce(func as *d.IRFunction, a as *SrA, l as *SrL, ci as i32, phi_at as *d.IRInst) as i32 {
    let is i32 as iv = l.ch_iv[ci];
    let is i32 as kind = l.ch_kind[ci];
    let is *d.IRInst as e = cast(*d.IRInst, l.ch_end[ci]);
    let is i32 as tj = _twin(a, l, ci);
    if (tj >= 0) {
        let is i32 as tw = l.ch_accp[tj];
        let is i64 as dc = (l.ch_add[ci] - l.ch_phic[tj]) << l.ch_shift[ci];
        if (dc == 0) {
            e.op = d.IR_MOV;
            e.src1 = d.op_vreg(tw);
            e.src2 = d.op_none();
            if (e.dest.op_type == d.OP_VREG) { _note_copy(e.dest.vreg, tw); }
        } else {
            e.op = d.IR_ADD;
            e.src1 = d.op_vreg(tw);
            e.src2 = d.op_imm(dc);
        }
        _kill(l.ch_dead1[ci]);
        _kill(l.ch_dead2[ci]);
        _kill(l.ch_dead3[ci]);
        l.ch_accp[ci] = tw;
        l.ch_phic[ci] = l.ch_phic[tj];
        return 0;
    }
    let is i64 as step = l.iv_step[iv];
    let is i32 as bm = _mat(func, a, l, l.ch_base[ci]);
    let is i64 as c0 with mut = 0;
    let is i32 as v0 with mut = 0 - 1;
    let is i32 as isc = _first(func, a, l, iv, l.ch_w[ci], &c0, &v0);
    let is i32 as acc0 with mut = 0 - 1;
    // the increment: an immediate, or a register (inc_v)
    let is i64 as inc with mut = 0;
    let is i32 as inc_v with mut = 0 - 1;
    if (kind == K_P3 || kind == K_P5) {
        let is i64 as stride = l.ch_stride[ci];
        if (isc == 1) {
            let is i64 as off = c0 * stride;
            if (off == 0) { acc0 = _emit(func, l, d.IR_MOV, d.op_vreg(bm), d.op_none()); }
            else { acc0 = _emit_add_imm(func, l, bm, off); }
        } else if (kind == K_P3) {
            let is i32 as t = _emit(func, l, d.IR_SHL, d.op_vreg(v0), d.op_imm(l.ch_shift[ci]));
            acc0 = _emit(func, l, d.IR_ADD, d.op_vreg(bm), d.op_vreg(t));
        } else {
            let is i32 as t = _emit(func, l, d.IR_MUL, d.op_vreg(v0), d.op_imm(stride));
            acc0 = _emit(func, l, d.IR_ADD, d.op_vreg(bm), d.op_vreg(t));
        }
        inc = step * stride;
    } else if (kind == K_FULL) {
        let is i32 as om = _mat(func, a, l, l.ch_other[ci]);
        let is i64 as mk = l.ch_mulk[ci];
        let is i32 as t0 with mut = 0 - 1;
        if (isc == 1 && (mk == 1 || _fits32(c0 * mk) == 1)) { t0 = _emit_add_imm(func, l, om, c0 * mk + l.ch_add[ci]); }
        else {
            if (isc == 1) { v0 = _emit(func, l, d.IR_IMM, d.op_imm(c0), d.op_none()); }
            let is i32 as xv with mut = v0;
            if (mk != 1) { xv = _emit(func, l, d.IR_MUL, d.op_vreg(v0), d.op_imm(mk)); }
            t0 = _emit(func, l, d.IR_ADD, d.op_vreg(om), d.op_vreg(xv));
            if (l.ch_add[ci] != 0) { t0 = _emit_add_imm(func, l, t0, l.ch_add[ci]); }
        }
        let is i32 as t1 = _emit(func, l, d.IR_SHL, d.op_vreg(t0), d.op_imm(l.ch_shift[ci]));
        acc0 = _emit(func, l, d.IR_ADD, d.op_vreg(bm), d.op_vreg(t1));
        inc = step * l.ch_stride[ci];
    } else {
        // P4: base + iv * z
        let is i32 as zm = _mat(func, a, l, l.ch_z[ci]);
        if (isc == 1 && c0 == 0) { acc0 = _emit(func, l, d.IR_MOV, d.op_vreg(bm), d.op_none()); }
        else {
            let is i32 as t with mut = 0 - 1;
            if (isc == 1) {
                if (_fits32(c0) == 1) { t = _emit(func, l, d.IR_MUL, d.op_vreg(zm), d.op_imm(c0)); }
                else {
                    let is i32 as kc = _emit(func, l, d.IR_IMM, d.op_imm(c0), d.op_none());
                    t = _emit(func, l, d.IR_MUL, d.op_vreg(zm), d.op_vreg(kc));
                }
            } else {
                t = _emit(func, l, d.IR_MUL, d.op_vreg(v0), d.op_vreg(zm));
            }
            acc0 = _emit(func, l, d.IR_ADD, d.op_vreg(bm), d.op_vreg(t));
        }
        if (step == 1) { inc_v = zm; }
        else if (_fits32(step) == 1) { inc_v = _emit(func, l, d.IR_MUL, d.op_vreg(zm), d.op_imm(step)); }
        else {
            let is i32 as ks = _emit(func, l, d.IR_IMM, d.op_imm(step), d.op_none());
            inc_v = _emit(func, l, d.IR_MUL, d.op_vreg(zm), d.op_vreg(ks));
        }
    }
    if (inc_v < 0 && _fits32(inc) == 0) { inc_v = _emit(func, l, d.IR_IMM, d.op_imm(inc), d.op_none()); }

    // the header phi, and its step right after the induction variable's
    let is i32 as accp = _newv(func);
    let is i32 as accn = _newv(func);
    let is *d.IRInst as p = phi.phi_new(accp, l.nlatch + 1);
    phi.phi_add(p, l.ph_label, acc0);
    let is i32 as j with mut = 0;
    while (j < l.nlatch) { phi.phi_add(p, l.latch_label[j], accn); j = j + 1; }
    cfg.insert_after(phi_at, p);
    let is *d.IRInst as st = d.new_inst(d.IR_ADD);
    st.dest = d.op_vreg(accn);
    st.src1 = d.op_vreg(accp);
    if (inc_v >= 0) { st.src2 = d.op_vreg(inc_v); } else { st.src2 = d.op_imm(inc); }
    cfg.insert_after(cast(*d.IRInst, l.iv_add[iv]), st);

    // the address is the phi
    e.op = d.IR_MOV;
    e.src1 = d.op_vreg(accp);
    e.src2 = d.op_none();
    if (e.dest.op_type == d.OP_VREG) { _note_copy(e.dest.vreg, accp); }
    _kill(l.ch_dead1[ci]);
    _kill(l.ch_dead2[ci]);
    _kill(l.ch_dead3[ci]);
    l.ch_accp[ci] = accp;
    l.ch_phic[ci] = l.ch_add[ci];
    return 1;
}

// Reduce the chains of the loop headed by the block labelled hl. Returns 1
// when the IR changed (the analysis is stale), 2 when a preheader was made
// (analyse again and retry), 0 otherwise.
fn _do_loop(func as *d.IRFunction, a as *SrA, hl as i32) as i32 {
    if (hl < 0 || hl >= a.nlab) { return 0; }
    let is i32 as h = a.l2b[hl];
    if (h <= 0 || a.reach[h] == cast(u8, 0)) { return 0; }
    let is i32 as nl = _loop_body(a, h);
    if (nl == 0) { return 0; }
    // no calls in the loop
    let is i32 as b with mut = 0;
    while (b < a.nb) {
        if (a.inl[b] == cast(u8, 1)) {
            let is *cfg.BasicBlock as bb = _bb(a, b);
            let is *d.IRInst as it with mut = bb.first;
            let is i32 as done with mut = 0;
            while (done == 0) {
                if (it.is_dead == 0 && _is_callish(it.op) == 1) { return 0; }
                if (cast(i64, it) == cast(i64, bb.last)) { done = 1; } else { it = it.next; }
            }
        }
        b = b + 1;
    }
    // the preheader
    let is i32 as ph with mut = 0 - 1;
    let is i32 as k with mut = 0;
    while (k < a.pred_count[h]) {
        let is i32 as p = a.preds[a.pred_start[h] + k];
        if (a.inl[p] == cast(u8, 0)) {
            if (ph >= 0 && ph != p) { return 0; }
            ph = p;
        }
        k = k + 1;
    }
    if (ph < 0 || a.reach[ph] == cast(u8, 0)) { return 0; }
    let is *cfg.BasicBlock as pb = _bb(a, ph);
    let is i32 as hlabel = _blabel(a, h);
    let is i32 as plabel = _blabel(a, ph);
    if (hlabel < 0 || plabel < 0) { return 0; }
    let is *d.IRInst as pterm = pb.last;
    let is i32 as two = cast(i32, pterm.op == d.IR_JZ || pterm.op == d.IR_JNZ);
    if (two == 1 || pterm.op == d.IR_RET) {
        // A branch that falls into the header: a new block on that edge.
        if (two == 1 && pb.succ0 == h && pb.succ1 != h && pb.succ1 >= 0) {
            let is i32 as nlb = phi.new_label(func);
            let is *d.IRInst as li = phi.make_label(nlb);
            cfg.insert_after(pterm, li);
            let is *cfg.BasicBlock as hb = _bb(a, h);
            let is *d.IRInst as pp with mut = hb.first.next;
            let is i32 as pdone with mut = 0;
            if (cast(i64, hb.first) == cast(i64, hb.last)) { pdone = 1; }
            while (pdone == 0) {
                if (pp.op != d.IR_PHI) { pdone = 1; }
                else {
                    let is i32 as ai = phi.phi_find(pp, plabel);
                    if (ai >= 0) { phi.phi_set_label(pp, ai, nlb); }
                    if (cast(i64, pp) == cast(i64, hb.last)) { pdone = 1; } else { pp = pp.next; }
                }
            }
            return 2;
        }
        return 0;
    }
    if (pb.succ0 != h) { return 0; }

    let is SrL as L;
    let is *SrL as l = &L;
    l.h = h;
    l.ph = ph;
    l.ph_label = plabel;
    l.niv = 0;
    l.nch = 0;
    l.nlatch = 0;
    l.latch_label = cast(*i32, d.opt_alloc(cast(i64, nl + 1) * 4));
    k = 0;
    while (k < a.pred_count[h]) {
        let is i32 as p = a.preds[a.pred_start[h] + k];
        if (a.inl[p] == cast(u8, 1)) {
            let is i32 as lab = _blabel(a, p);
            if (lab < 0) { d.opt_free(cast(*u8, l.latch_label)); return 0; }
            let is i32 as dup with mut = 0;
            let is i32 as q with mut = 0;
            while (q < l.nlatch) { if (l.latch_label[q] == lab) { dup = 1; } q = q + 1; }
            if (dup == 0) { l.latch_label[l.nlatch] = lab; l.nlatch = l.nlatch + 1; }
        }
        k = k + 1;
    }

    _find_phi_ivs(a, l);
    _find_slot_ivs(func, a, l);
    if (l.niv == 0) { d.opt_free(cast(*u8, l.latch_label)); return 0; }

    // chains, in the order of the list
    b = 0;
    while (b < a.nb) {
        if (a.inl[b] == cast(u8, 1)) {
            let is *cfg.BasicBlock as bb = _bb(a, b);
            let is *d.IRInst as it with mut = bb.first;
            let is i32 as done with mut = 0;
            while (done == 0) {
                if (it.is_dead == 0) {
                    if (it.op == d.IR_SHL) { _match_shl(a, l, it); }
                    else if (it.op == d.IR_MUL) { _match_mul(a, l, it); }
                }
                if (cast(i64, it) == cast(i64, bb.last)) { done = 1; } else { it = it.next; }
            }
        }
        b = b + 1;
    }
    if (l.nch == 0) { d.opt_free(cast(*u8, l.latch_label)); return 0; }

    // The preheader's insertion point: before its jump, or after its last
    // instruction when it falls into the header.
    if (pterm.op == d.IR_JMP) {
        let is *d.IRInst as at with mut = pb.first;
        while (cast(i64, at.next) != cast(i64, pterm)) { at = at.next; }
        l.cur = at;
    } else {
        l.cur = pterm;
    }
    // where the header's phis end
    let is *cfg.BasicBlock as hb2 = _bb(a, h);
    let is *d.IRInst as phi_at with mut = hb2.first;
    while (cast(i64, phi_at) != cast(i64, hb2.last) && phi_at.next.op == d.IR_PHI) { phi_at = phi_at.next; }

    let is i32 as ci with mut = 0;
    while (ci < l.nch) {
        // the next phi goes after the one just made
        if (_reduce(func, a, l, ci, phi_at) == 1) { phi_at = phi_at.next; }
        ci = ci + 1;
    }
    _resolve_copies(func, a);
    d.opt_free(cast(*u8, l.latch_label));
    return 1;
}

fn pass_strength_reduction(func as *d.IRFunction) as void {
    // Any loop at all? A jump back to a label above it.
    let is i32 as nlab = func.label_count + 1;
    let is *u8 as seen = d.opt_alloc(cast(i64, nlab + 1));
    let is i32 as i with mut = 0;
    while (i < nlab) { seen[i] = cast(u8, 0); i = i + 1; }
    let is i32 as n with mut = 0;
    let is i32 as back with mut = 0;
    let is *d.IRInst as it with mut = func.instructions;
    while (cast(i64, it) != 0) {
        n = n + 1;
        if (it.is_dead == 0) {
            if (it.op == d.IR_LABEL && it.dest.label >= 0 && it.dest.label < nlab) { seen[it.dest.label] = cast(u8, 1); }
            if ((it.op == d.IR_JMP || it.op == d.IR_JZ || it.op == d.IR_JNZ) && it.dest.label >= 0 && it.dest.label < nlab
                && seen[it.dest.label] == cast(u8, 1)) { back = 1; }
        }
        it = it.next;
    }
    d.opt_free(seen);
    if (back == 0 || n < 6) { return; }

    // Phis name their predecessors by label.
    phi.ssa_ensure_labels(func);

    let is SrA as A;
    let is *SrA as a = &A;
    _a_build(a, func);
    // The loops, outermost first: by their last latch, bottom to top.
    let is i32 as nb = a.nb;
    let is *i32 as hlab = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is *i32 as key = cast(*i32, d.opt_alloc(cast(i64, nb + 1) * 4));
    let is i32 as nh with mut = 0;
    let is i32 as h with mut = 1;
    while (h < nb) {
        if (a.reach[h] == cast(u8, 1) && _loop_body(a, h) > 0) {
            let is i32 as last with mut = 0 - 1;
            let is i32 as k with mut = 0;
            while (k < a.pred_count[h]) {
                let is i32 as p = a.preds[a.pred_start[h] + k];
                if (a.inl[p] == cast(u8, 1) && p > last) { last = p; }
                k = k + 1;
            }
            let is i32 as lab = _blabel(a, h);
            if (lab >= 0) {
                let is i32 as j with mut = nh - 1;
                while (j >= 0 && key[j] < last) { key[j + 1] = key[j]; hlab[j + 1] = hlab[j]; j = j - 1; }
                key[j + 1] = last; hlab[j + 1] = lab;
                nh = nh + 1;
            }
        }
        h = h + 1;
    }
    let is i32 as li with mut = 0;
    while (li < nh) {
        let is i32 as r with mut = _do_loop(func, a, hlab[li]);
        if (r == 2) {
            _a_free(a);
            _a_build(a, func);
            r = _do_loop(func, a, hlab[li]);
            if (r == 2) { r = 1; }
        }
        if (r == 1) {
            _a_free(a);
            _a_build(a, func);
        }
        li = li + 1;
    }
    d.opt_free(cast(*u8, hlab));
    d.opt_free(cast(*u8, key));
    _a_free(a);
}
