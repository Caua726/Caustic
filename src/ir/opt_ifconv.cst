use "defs.cst" as d;

// === If-conversion: branchy value-select -> branchless cmov ===
//
// Runs LATE (in gen_func, just before register allocation, after every mid-end
// pass incl. DCE/inlining), so no other pass needs to know about IR_CMOV. It
// matches the exact post-optimization shape the compiler emits for
// `if (c) x = A; else x = B;` (a phi destroyed into two predecessor MOVs):
//
//       JZ   cond -> Lelse                 ; src1=cond, dest.label=Lelse
//       <pure MOV/IMM ...>                 ; then arm; last live inst: MOV dest = St
//       JMP  -> Ljoin
//     Lelse:
//       <pure MOV/IMM ...>                 ; else arm; last live inst: MOV dest = Sf
//     Ljoin:
//
// becomes (both arms' pure work now runs unconditionally — MOV/IMM never fault):
//
//       <then pure work>                   ; its phi-mov MOV dest=St is dropped
//     Lelse:
//       <else pure work>                   ; its phi-mov MOV dest=Sf is the false-preload
//       CMOV dest, cond, St                ; dest = cond ? St : Sf  (test cond; cmovne)
//     Ljoin:
//
// Conservative by construction: only fires when BOTH arms contain nothing but
// MOV/IMM (side-effect-free, non-faulting), both write the same dest, and the
// two labels are referenced by exactly this JZ/JMP (no shared merge points).
//
// At -O2, when that shape does not match, ic2_try (below) takes the wider one:
// arms of a few arithmetic instructions each, any number of phi values.

fn ic_next_live(inst as *d.IRInst) as *d.IRInst {
    let is *d.IRInst as p with mut = inst.next;
    while (cast(i64, p) != 0 && p.is_dead == 1) { p = p.next; }
    return p;
}

// How many live branches target label L (guards against shared merge points).
fn ic_count_label_refs(func as *d.IRFunction, L as i32) as i32 {
    let is i32 as cnt with mut = 0;
    let is *d.IRInst as p with mut = func.instructions;
    while (cast(i64, p) != 0) {
        if (p.is_dead == 0 && (p.op == d.IR_JMP || p.op == d.IR_JZ || p.op == d.IR_JNZ)
            && p.dest.op_type == d.OP_LABEL && p.dest.label == L) { cnt = cnt + 1; }
        p = p.next;
    }
    return cnt;
}

// The first live instruction from x on that is not a label nothing jumps to
// (an inlined function's exit, say, left right after the else label).
fn ic_skip_free_labels(func as *d.IRFunction, x as *d.IRInst) as *d.IRInst {
    let is *d.IRInst as p with mut = x;
    while (cast(i64, p) != 0 && p.op == d.IR_LABEL && ic_count_label_refs(func, p.dest.label) == 0) { p = ic_next_live(p); }
    return p;
}

// Drop the labels nothing jumps to in [a, b).
fn ic_kill_free_labels(func as *d.IRFunction, a as *d.IRInst, b as *d.IRInst) as void {
    let is *d.IRInst as p with mut = a;
    while (cast(i64, p) != 0 && cast(i64, p) != cast(i64, b)) {
        if (p.is_dead == 0 && p.op == d.IR_LABEL && ic_count_label_refs(func, p.dest.label) == 0) { p.is_dead = 1; }
        p = p.next;
    }
}

// Try to match + convert a diamond starting at `jz`. Returns 1 if converted.
fn ic_try(func as *d.IRFunction, jz as *d.IRInst) as i32 {
    let is i32 as cond = jz.src1.vreg;
    let is i32 as else_label = jz.dest.label;

    // --- then arm: pure MOV/IMM up to the JMP; last live inst is the phi-mov ---
    let is *d.IRInst as t with mut = ic_next_live(jz);
    let is *d.IRInst as then_phi with mut = cast(*d.IRInst, 0);
    let is i32 as ok with mut = 1;
    while (cast(i64, t) != 0 && t.op != d.IR_JMP && ok == 1) {
        if (t.op != d.IR_MOV && t.op != d.IR_IMM) { ok = 0; }
        else { then_phi = t; t = ic_next_live(t); }
    }
    if (ok == 0) { return 0; }
    if (cast(i64, t) == 0 || t.op != d.IR_JMP) { return 0; }
    let is *d.IRInst as jmp = t;
    let is i32 as join_label = jmp.dest.label;
    // -O2: an arm with nothing in it: the value is what the dest holds already.
    let is i32 as empty = cast(i32, cast(i64, then_phi) == 0 && d.ir_opt_level >= 2);
    if (empty == 0 && (cast(i64, then_phi) == 0 || then_phi.op != d.IR_MOV
        || then_phi.src1.op_type != d.OP_VREG || then_phi.dest.op_type != d.OP_VREG)) { return 0; }
    let is i32 as destT with mut = 0 - 1;
    let is i32 as srcT with mut = 0 - 1;
    if (empty == 0) { destT = then_phi.dest.vreg; srcT = then_phi.src1.vreg; }

    // --- else label must match the JZ target ---
    let is *d.IRInst as lel = ic_next_live(jmp);
    if (cast(i64, lel) == 0 || lel.op != d.IR_LABEL || lel.dest.label != else_label) { return 0; }

    // --- else arm: pure MOV/IMM up to the join label ---
    let is *d.IRInst as e with mut = ic_skip_free_labels(func, ic_next_live(lel));
    let is *d.IRInst as else_phi with mut = cast(*d.IRInst, 0);
    ok = 1;
    while (cast(i64, e) != 0 && e.op != d.IR_LABEL && ok == 1) {
        if (e.op != d.IR_MOV && e.op != d.IR_IMM) { ok = 0; }
        else { else_phi = e; e = ic_next_live(e); }
    }
    if (ok == 0) { return 0; }
    if (cast(i64, e) == 0 || e.op != d.IR_LABEL || e.dest.label != join_label) { return 0; }
    if (cast(i64, else_phi) == 0 || else_phi.op != d.IR_MOV
        || else_phi.src1.op_type != d.OP_VREG || else_phi.dest.op_type != d.OP_VREG) { return 0; }
    let is i32 as destE = else_phi.dest.vreg;

    // --- guards ---
    if (empty == 0 && destE != destT) { return 0; }
    if (srcT == destE) { return 0; }   // cmov dest,dest could never select St
    if (cond == destE) { return 0; }
    // -O2: other jumps may reach the else arm (the first test of an &&), when it
    // is one copy: this path gets a copy of it. They may reach the join too.
    let is i32 as refs_else = ic_count_label_refs(func, else_label);
    if (refs_else != 1 && (d.ir_opt_level < 2 || cast(i64, ic_next_live(else_phi)) != cast(i64, e)
        || cast(i64, ic_skip_free_labels(func, ic_next_live(lel))) != cast(i64, else_phi))) { return 0; }
    if (ic_count_label_refs(func, join_label) != 1 && d.ir_opt_level < 2) { return 0; }
    // Both arms run unconditionally afterwards, the then arm first: every value
    // either arm writes besides its phi move must be the arm's own — written
    // and read nowhere else — or running the other arm too would overwrite a
    // value live at the join (a second phi's move, say).
    let is *d.IRInst as t0 = ic_next_live(jz);
    let is *d.IRInst as w with mut = t0;
    while (cast(i64, w) != cast(i64, jmp)) {
        if (w.is_dead == 0 && cast(i64, w) != cast(i64, then_phi)
            && ic2_outside(func, w.dest.vreg, t0, jmp, 1) == 1) { return 0; }
        w = w.next;
    }
    let is *d.IRInst as e0 = ic_skip_free_labels(func, ic_next_live(lel));
    w = e0;
    while (cast(i64, w) != cast(i64, e)) {
        if (w.is_dead == 0 && cast(i64, w) != cast(i64, else_phi)
            && ic2_outside(func, w.dest.vreg, e0, e, 1) == 1) { return 0; }
        w = w.next;
    }

    // --- transform ---
    if (refs_else != 1 || empty == 1) {
        // The true value, a copy of the dest when the arm was empty.
        let is *d.IRInst as hd with mut = cast(*d.IRInst, 0);
        let is *d.IRInst as tl with mut = cast(*d.IRInst, 0);
        if (empty == 1) {
            srcT = func.vreg_count;
            func.vreg_count = func.vreg_count + 1;
            let is *d.IRInst as kp = d.new_inst(d.IR_MOV);
            kp.dest = d.op_vreg(srcT);
            kp.src1 = d.op_vreg(destE);
            kp.line = jz.line;
            hd = kp;
            tl = kp;
        }
        let is *d.IRInst as fv = d.new_inst(d.IR_MOV);
        fv.dest = else_phi.dest; fv.src1 = else_phi.src1; fv.cast_to = else_phi.cast_to; fv.line = else_phi.line;
        if (cast(i64, tl) != 0) { tl.next = fv; } else { hd = fv; }
        let is *d.IRInst as sel = d.new_inst(d.IR_CMOV);
        sel.dest.op_type = d.OP_VREG; sel.dest.vreg = destE;
        sel.src1.op_type = d.OP_VREG; sel.src1.vreg = cond;
        sel.src2.op_type = d.OP_VREG; sel.src2.vreg = srcT;
        sel.line = else_phi.line;
        fv.next = sel;
        // in place of the jz's branch, right before the jmp that stays
        let is *d.IRInst as pj with mut = jz;
        while (cast(i64, pj.next) != cast(i64, jmp)) { pj = pj.next; }
        sel.next = jmp;
        pj.next = hd;
        jz.is_dead = 1;
        if (empty == 0) { then_phi.is_dead = 1; }
        // the else arm stays for whoever else jumps there; alone, the jmp and it
        // can go
        if (ic_count_label_refs(func, else_label) == 0) {
            jmp.is_dead = 1;
            lel.is_dead = 1;
            else_phi.is_dead = 1;
            if (ic_count_label_refs(func, join_label) == 0) { e.is_dead = 1; }
        }
        return 1;
    }
    ic_kill_free_labels(func, lel.next, e0);
    jz.is_dead = 1;
    then_phi.is_dead = 1;       // then value St flows via the kept then-arm work
    jmp.is_dead = 1;
    // nothing jumps to the else label now: one straight run, compare to select
    if (ic_count_label_refs(func, else_label) == 0) { lel.is_dead = 1; }
    // else_phi (MOV destE = Sf) survives as the false-value preload into destE.
    let is *d.IRInst as cmov = d.new_inst(d.IR_CMOV);
    cmov.dest.op_type = d.OP_VREG; cmov.dest.vreg = destE;
    cmov.src1.op_type = d.OP_VREG; cmov.src1.vreg = cond;
    cmov.src2.op_type = d.OP_VREG; cmov.src2.vreg = srcT;
    cmov.line = else_phi.line;
    cmov.next = else_phi.next;
    else_phi.next = cmov;
    // the join is straight-line code now
    if (ic_count_label_refs(func, join_label) == 0) { e.is_dead = 1; }
    return 1;
}

// -O2: a branch to keep. In a loop, a test of a value read from memory chooses
// a value that the next load's address depends on (`if (a[j] < a[j + 1]) j = j + 1;
// x = a[j];` in a heap's sift-down). As a cmov, each load waits for the one
// before: the misses of a big array line up one behind the other. A branch lets
// the CPU go on and read ahead on its guess, right half the time at worst.
fn ic_chases_load(func as *d.IRFunction, jz as *d.IRInst) as i32 {
    // the values the arms write
    let is [8]i32 as s;
    let is i32 as ns with mut = 0;
    let is i32 as seen with mut = 0;
    let is i32 as labels with mut = 0;
    let is *d.IRInst as x with mut = ic_next_live(jz);
    while (cast(i64, x) != 0 && seen < 10 && labels < 1) {
        if (x.op == d.IR_LABEL) {
            if (x.dest.label == jz.dest.label || ic_count_label_refs(func, x.dest.label) != 0) { labels = labels + 1; }
        } else if (x.op == d.IR_JMP) {
            // a second arm, up to the join
            x = ic_next_live(x);
            if (cast(i64, x) == 0 || x.op != d.IR_LABEL || x.dest.label != jz.dest.label) { return 0; }
            let is *d.IRInst as e with mut = ic_next_live(x);
            while (cast(i64, e) != 0 && e.op != d.IR_LABEL && seen < 10) {
                if (ic2_pure(e) == 0) { return 0; }
                if (ns < 8) { s[ns] = e.dest.vreg; ns = ns + 1; }
                seen = seen + 1;
                e = ic_next_live(e);
            }
            x = e;
            labels = 1;
        } else {
            if (ic2_pure(x) == 0) { return 0; }
            if (ns < 8) { s[ns] = x.dest.vreg; ns = ns + 1; }
            seen = seen + 1;
        }
        if (labels < 1) { x = ic_next_live(x); }
    }
    if (labels != 1 || ns == 0 || cast(i64, x) == 0) { return 0; }
    // the straight code after the join: a load through one of them?
    let is i32 as hit with mut = 0;
    let is i32 as n with mut = 0;
    let is *d.IRInst as w with mut = ic_next_live(x);
    while (cast(i64, w) != 0 && n < 24 && hit == 0) {
        if (w.op == d.IR_JMP || w.op == d.IR_RET) { n = 24; }
        else if (w.op == d.IR_LOAD) {
            let is i32 as k with mut = 0;
            while (k < ns) {
                if (w.src1.op_type == d.OP_VREG && w.src1.vreg == s[k]) { hit = 1; }
                k = k + 1;
            }
        } else if (w.op == d.IR_MOV || w.op == d.IR_ADD || w.op == d.IR_SUB || w.op == d.IR_MUL || w.op == d.IR_SHL
                   || w.op == d.IR_CAST || w.op == d.IR_LEA2 || w.op == d.IR_LEA4 || w.op == d.IR_LEA8) {
            let is i32 as k with mut = 0;
            let is i32 as rd with mut = 0;
            while (k < ns) {
                if (ic2_reads(w, s[k]) == 1) { rd = 1; }
                k = k + 1;
            }
            if (rd == 1 && ns < 8 && w.dest.op_type == d.OP_VREG) { s[ns] = w.dest.vreg; ns = ns + 1; }
        }
        n = n + 1;
        w = ic_next_live(w);
    }
    if (hit == 0) { return 0; }
    // the test reads memory: its compare and the loads just before the branch
    let is [8]i64 as ring;
    let is i32 as nr with mut = 0;
    w = func.instructions;
    while (cast(i64, w) != 0 && cast(i64, w) != cast(i64, jz)) {
        if (w.is_dead == 0) { ring[nr % 8] = cast(i64, w); nr = nr + 1; }
        w = w.next;
    }
    let is i32 as lim with mut = 8;
    if (nr < 8) { lim = nr; }
    let is i32 as a with mut = 0;
    let is *d.IRInst as cmp with mut = cast(*d.IRInst, 0);
    while (a < lim) {
        let is *d.IRInst as c = cast(*d.IRInst, ring[(nr - 1 - a) % 8]);
        if (c.dest.op_type == d.OP_VREG && c.dest.vreg == jz.src1.vreg) { cmp = c; a = lim; }
        a = a + 1;
    }
    if (cast(i64, cmp) == 0) { return 0; }
    let is i32 as loaded with mut = 0;
    a = 0;
    while (a < lim) {
        let is *d.IRInst as c = cast(*d.IRInst, ring[(nr - 1 - a) % 8]);
        if (c.op == d.IR_LOAD && c.dest.op_type == d.OP_VREG && ic2_reads(cmp, c.dest.vreg) == 1) { loaded = 1; }
        a = a + 1;
    }
    if (loaded == 0) { return 0; }
    // and all this repeats: a branch further on goes back past it
    let is i32 as nl = func.label_count;
    if (nl <= 0) { return 0; }
    let is *u8 as before = d.opt_alloc(cast(i64, nl));
    let is i32 as q with mut = 0;
    while (q < nl) { before[q] = cast(u8, 0); q = q + 1; }
    w = func.instructions;
    while (cast(i64, w) != 0 && cast(i64, w) != cast(i64, jz)) {
        if (w.is_dead == 0 && w.op == d.IR_LABEL && w.dest.label >= 0 && w.dest.label < nl) { before[w.dest.label] = cast(u8, 1); }
        w = w.next;
    }
    let is i32 as inloop with mut = 0;
    while (cast(i64, w) != 0 && inloop == 0) {
        if (w.is_dead == 0 && (w.op == d.IR_JMP || w.op == d.IR_JZ || w.op == d.IR_JNZ) && w.dest.op_type == d.OP_LABEL
            && w.dest.label >= 0 && w.dest.label < nl && before[w.dest.label] == cast(u8, 1)) { inloop = 1; }
        w = w.next;
    }
    d.opt_free(before);
    return inloop;
}

fn pass_ifconv(func as *d.IRFunction) as void {
    let is *d.IRInst as inst with mut = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 0 && inst.op == d.IR_JZ && inst.src1.op_type == d.OP_VREG
            && inst.dest.op_type == d.OP_LABEL
            && (d.ir_opt_level < 2 || ic_chases_load(func, inst) == 0)) {
            if (ic_try(func, inst) == 0 && d.ir_opt_level >= 2) { ic2_try(func, inst); }
        }
        inst = inst.next;
    }
    if (d.ir_opt_level >= 2) { ic_bool_select(func); }
}

// A branch over a run that ends in a call that never returns (a RET marked by
// opt_inline's pass_noreturn_cut): the run moves to the end of the function
// and the hot path falls through.
fn pass_cold_sink(func as *d.IRFunction) as void {
    let is *d.IRInst as tail with mut = func.instructions;
    if (cast(i64, tail) == 0) { return; }
    let is *d.IRInst as last_live with mut = cast(*d.IRInst, 0);
    while (cast(i64, tail.next) != 0) {
        if (tail.is_dead == 0) { last_live = tail; }
        tail = tail.next;
    }
    if (tail.is_dead == 0) { last_live = tail; }
    if (cast(i64, last_live) == 0 || (last_live.op != d.IR_RET && last_live.op != d.IR_JMP)) { return; }
    let is *d.IRInst as end = tail;
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != cast(i64, end)) {
        if (w.is_dead == 0 && (w.op == d.IR_JZ || w.op == d.IR_JNZ) && w.dest.op_type == d.OP_LABEL) {
            let is *d.IRInst as x with mut = ic_next_live(w);
            let is i32 as ok with mut = 1;
            while (ok == 1 && cast(i64, x) != 0 && x.op != d.IR_RET) {
                if (x.op == d.IR_LABEL || x.op == d.IR_JMP || x.op == d.IR_JZ || x.op == d.IR_JNZ) { ok = 0; }
                else { x = ic_next_live(x); }
            }
            if (ok == 1 && cast(i64, x) != 0 && x.is_extern_call == 1) {
                let is *d.IRInst as a with mut = ic_next_live(x);
                let is i32 as hit with mut = 0;
                while (hit == 0 && cast(i64, a) != 0 && a.op == d.IR_LABEL) {
                    if (a.dest.label == w.dest.label) { hit = 1; } else { a = ic_next_live(a); }
                }
                if (hit == 1) {
                    let is i32 as lc = func.label_count;
                    func.label_count = lc + 1;
                    let is *d.IRInst as first = w.next;
                    w.next = x.next;
                    if (w.op == d.IR_JZ) { w.op = d.IR_JNZ; } else { w.op = d.IR_JZ; }
                    w.dest.label = lc;
                    let is *d.IRInst as lab = d.new_inst(d.IR_LABEL);
                    lab.dest.op_type = d.OP_LABEL;
                    lab.dest.label = lc;
                    lab.line = x.line;
                    tail.next = lab;
                    lab.next = first;
                    x.next = cast(*d.IRInst, 0);
                    tail = x;
                }
            }
        }
        w = w.next;
    }
}

// `c ? 1 : 0` of a compare is the compare's own 0 or 1.
let is i32 as ic_bool_hit with mut = 0;

fn _ib_last_def(ring as *i64, n as i32, v as i32) as i32 {
    let is i32 as k with mut = n - 1;
    while (k >= 0) {
        let is *d.IRInst as r = cast(*d.IRInst, ring[k]);
        if (r.dest.op_type == d.OP_VREG && r.dest.vreg == v) { return k; }
        k = k - 1;
    }
    return 0 - 1;
}

// The constant v holds at the end of the ring: an IMM, or a copy of one.
fn _ib_imm_of(ring as *i64, n as i32, v as i32, out as *i64) as i32 {
    let is i32 as k = _ib_last_def(ring, n, v);
    if (k < 0) { return 0; }
    let is *d.IRInst as de = cast(*d.IRInst, ring[k]);
    if (de.op == d.IR_IMM && de.src1.op_type == d.OP_IMM) { *out = de.src1.imm; return 1; }
    if (de.op == d.IR_MOV && de.src1.op_type == d.OP_VREG) {
        let is i32 as k2 = _ib_last_def(ring, k, de.src1.vreg);
        if (k2 < 0) { return 0; }
        let is *d.IRInst as d2 = cast(*d.IRInst, ring[k2]);
        if (d2.op == d.IR_IMM && d2.src1.op_type == d.OP_IMM) { *out = d2.src1.imm; return 1; }
    }
    return 0;
}

fn ic_bool_select(func as *d.IRFunction) as void {
    ic_bool_hit = 0;
    let is [8]i64 as ring;
    let is i32 as n with mut = 0;
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != 0) {
        if (w.is_dead == 0) {
            let is i32 as op = w.op;
            if (op == d.IR_LABEL || op == d.IR_JMP || op == d.IR_JZ || op == d.IR_JNZ || op == d.IR_RET) {
                n = 0;
            } else {
                if (op == d.IR_CMOV && n >= 1 && w.src1.op_type == d.OP_VREG && w.src2.op_type == d.OP_VREG) {
                    let is i32 as cdk = _ib_last_def(&ring[0], n, w.src1.vreg);
                    let is *d.IRInst as pre = cast(*d.IRInst, ring[n - 1]);
                    let is i64 as tv with mut = 0;
                    let is i64 as fv with mut = 0;
                    if (cdk >= 0 && cdk < n - 1 && ic2_is_cmp(cast(*d.IRInst, ring[cdk]).op) == 1
                        && pre.dest.op_type == d.OP_VREG && pre.dest.vreg == w.dest.vreg
                        && (pre.op == d.IR_IMM || pre.op == d.IR_MOV)
                        && _ib_imm_of(&ring[0], n, w.src2.vreg, &tv) == 1 && tv == 1
                        && _ib_imm_of(&ring[0], n, w.dest.vreg, &fv) == 1 && fv == 0) {
                        // the preload goes, and the select reads the compare
                        pre.is_dead = 1;
                        w.op = d.IR_MOV;
                        w.cast_to = pre.cast_to;
                        w.src2.op_type = d.OP_NONE;
                        ic_bool_hit = 1;
                    }
                }
                if (n == 8) {
                    let is i32 as k with mut = 1;
                    while (k < 8) { ring[k - 1] = ring[k]; k = k + 1; }
                    n = 7;
                }
                ring[n] = cast(i64, w);
                n = n + 1;
            }
        }
        w = w.next;
    }
}

// === -O2: if-conversion of small arithmetic diamonds ===
//
//       JZ   cond -> Lelse
//       T: pure arithmetic, ending in phi moves  MOV d_k = s_k
//       JMP  -> Ljoin
//     Lelse:
//       E: pure arithmetic, ending in phi moves  MOV d_k = r_k
//     Ljoin:
//
// becomes, with both arms' work run unconditionally:
//
//       T work ; E work
//       MOV d_k = r_k ; CMOV d_k, cond, s_k      (for each k)
//     Ljoin:
//
// A branch on data (collatz's `x & 1`) mispredicts often; the select does not.
// Only when it is safe and small:
//   - every instruction of both arms is one that cannot fault or write memory
//     (MOV, IMM, ADD, SUB, MUL, AND, OR, XOR, SHL/SHR by a constant, NEG, NOT,
//     LEA, integer CAST), at most IC2_MAX_WORK of them besides the phi moves;
//   - a phi dest d_k is written exactly once in each arm, by a MOV, is read in
//     neither arm, and the s_k / r_k / cond are none of the d_k;
//   - every other value an arm writes is that arm's own: written only there and
//     read only there (so running the other arm too changes nothing outside);
//   - cond is written by neither arm; Lelse and Ljoin are referenced only by
//     this JZ and JMP.

let is i32 as IC2_MAX_WORK with imut = 6;

fn ic2_pure(i as *d.IRInst) as i32 {
    let is i32 as op = i.op;
    if (op == d.IR_MOV || op == d.IR_IMM || op == d.IR_ADD || op == d.IR_SUB || op == d.IR_MUL
        || op == d.IR_AND || op == d.IR_OR || op == d.IR_XOR || op == d.IR_NEG || op == d.IR_NOT
        || op == d.IR_LEA2 || op == d.IR_LEA4 || op == d.IR_LEA8 || op == d.IR_CAST) {
        if (i.dest.op_type != d.OP_VREG) { return 0; }
        if (op == d.IR_CAST) {
            let is i32 as kf = ic2_kind(i.cast_from);
            let is i32 as kt = ic2_kind(i.cast_to);
            if (kf < 1 || kf > 8 || kt < 1 || kt > 8) { return 0; }
        }
        return 1;
    }
    if ((op == d.IR_SHL || op == d.IR_SHR) && i.src2.op_type == d.OP_IMM && i.dest.op_type == d.OP_VREG) { return 1; }
    return 0;
}

fn ic2_kind(tp as *u8) as i32 {
    if (cast(i64, tp) == 0) { return 4; }
    return *cast(*i32, tp);
}

fn ic2_reads(i as *d.IRInst, v as i32) as i32 {
    if (i.src1.op_type == d.OP_VREG && i.src1.vreg == v) { return 1; }
    if (i.src2.op_type == d.OP_VREG && i.src2.vreg == v) { return 1; }
    // ops whose dest operand is read, not written (a store's address, a cmov)
    if (i.dest.op_type == d.OP_VREG && i.dest.vreg == v
        && (i.op == d.IR_STORE || i.op == d.IR_ATOMIC_STORE || i.op == d.IR_VSTOREQ || i.op == d.IR_VSTOREQ256
            || i.op == d.IR_CMOV || i.op == d.IR_COPY)) { return 1; }
    return 0;
}

// v is read or written by a live instruction outside [a, b).
fn ic2_outside(func as *d.IRFunction, v as i32, a as *d.IRInst, b as *d.IRInst, writes as i32) as i32 {
    let is i32 as inside with mut = 0;
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != 0) {
        if (cast(i64, w) == cast(i64, a)) { inside = 1; }
        if (cast(i64, w) == cast(i64, b)) { inside = 0; }
        if (w.is_dead == 0 && inside == 0) {
            if (ic2_reads(w, v) == 1) { return 1; }
            if (writes == 1 && w.dest.op_type == d.OP_VREG && w.dest.vreg == v) { return 1; }
        }
        w = w.next;
    }
    return 0;
}

fn ic2_try(func as *d.IRFunction, jz as *d.IRInst) as i32 {
    let is i32 as cond = jz.src1.vreg;
    let is i32 as else_label = jz.dest.label;
    // then arm
    let is *d.IRInst as t0 = ic_next_live(jz);
    let is *d.IRInst as t with mut = t0;
    while (cast(i64, t) != 0 && t.op != d.IR_JMP) {
        if (ic2_pure(t) == 0) { return 0; }
        t = ic_next_live(t);
    }
    if (cast(i64, t) == 0) { return 0; }
    let is *d.IRInst as jmp = t;
    if (jmp.dest.op_type != d.OP_LABEL) { return 0; }
    let is i32 as join_label = jmp.dest.label;
    let is *d.IRInst as lel = ic_next_live(jmp);
    if (cast(i64, lel) == 0 || lel.op != d.IR_LABEL || lel.dest.label != else_label) { return 0; }
    let is *d.IRInst as e0 = ic_skip_free_labels(func, ic_next_live(lel));
    let is *d.IRInst as e with mut = e0;
    while (cast(i64, e) != 0 && e.op != d.IR_LABEL) {
        if (ic2_pure(e) == 0) { return 0; }
        e = ic_next_live(e);
    }
    if (cast(i64, e) == 0 || e.dest.label != join_label) { return 0; }
    let is *d.IRInst as ljoin = e;
    if (ic_count_label_refs(func, else_label) != 1) { return 0; }
    if (ic_count_label_refs(func, join_label) != 1) { return 0; }

    // classify the then arm's writes: phi dests (also written in the else arm)
    // and the arm's own values
    let is [8]i32 as pd;            // phi dests
    let is [8]i64 as pt;            // then-arm MOV
    let is [8]i64 as pe;            // else-arm MOV
    let is i32 as np with mut = 0;
    let is i32 as work with mut = 0;
    t = t0;
    while (cast(i64, t) != cast(i64, jmp)) {
        if (t.is_dead == 0) {
            let is i32 as v = t.dest.vreg;
            // written in the else arm too?
            let is *d.IRInst as em with mut = cast(*d.IRInst, 0);
            let is i32 as ecnt with mut = 0;
            let is *d.IRInst as w with mut = e0;
            while (cast(i64, w) != cast(i64, ljoin)) {
                if (w.is_dead == 0 && w.dest.vreg == v) { em = w; ecnt = ecnt + 1; }
                w = w.next;
            }
            if (ecnt > 0) {
                if (ecnt != 1 || t.op != d.IR_MOV || em.op != d.IR_MOV) { return 0; }
                if (t.src1.op_type != d.OP_VREG || em.src1.op_type != d.OP_VREG) { return 0; }
                if (np >= 8) { return 0; }
                pd[np] = v; pt[np] = cast(i64, t); pe[np] = cast(i64, em);
                np = np + 1;
            } else {
                work = work + 1;
                // the arm's own: no read or write outside the then arm
                if (ic2_outside(func, v, t0, jmp, 1) == 1) { return 0; }
            }
        }
        t = t.next;
    }
    if (np == 0) { return 0; }
    // the else arm: phi moves already matched, the rest its own
    e = e0;
    while (cast(i64, e) != cast(i64, ljoin)) {
        if (e.is_dead == 0) {
            let is i32 as v = e.dest.vreg;
            let is i32 as isphi with mut = 0;
            let is i32 as k with mut = 0;
            while (k < np) { if (pd[k] == v) { isphi = 1; } k = k + 1; }
            if (isphi == 0) {
                work = work + 1;
                if (ic2_outside(func, v, e0, ljoin, 1) == 1) { return 0; }
            }
        }
        e = e.next;
    }
    if (work > IC2_MAX_WORK) { return 0; }
    // the phi moves end each arm: nothing after one rewrites what it copies
    let is i32 as seenp with mut = 0;
    t = t0;
    while (cast(i64, t) != cast(i64, jmp)) {
        if (t.is_dead == 0) {
            let is i32 as isp with mut = 0;
            let is i32 as q with mut = 0;
            while (q < np) { if (pd[q] == t.dest.vreg) { isp = 1; } q = q + 1; }
            if (isp == 1) { seenp = 1; } else if (seenp == 1) { return 0; }
        }
        t = t.next;
    }
    seenp = 0;
    e = e0;
    while (cast(i64, e) != cast(i64, ljoin)) {
        if (e.is_dead == 0) {
            let is i32 as isp with mut = 0;
            let is i32 as q with mut = 0;
            while (q < np) { if (pd[q] == e.dest.vreg) { isp = 1; } q = q + 1; }
            if (isp == 1) { seenp = 1; } else if (seenp == 1) { return 0; }
        }
        e = e.next;
    }
    // phi dests: one write per arm (checked for else; then: count), not read in
    // the arms, not a phi source, not cond
    let is i32 as k2 with mut = 0;
    while (k2 < np) {
        let is i32 as v = pd[k2];
        if (v == cond) { return 0; }
        let is i32 as tw with mut = 0;
        t = t0;
        while (cast(i64, t) != cast(i64, jmp)) {
            if (t.is_dead == 0) {
                if (t.dest.vreg == v) { tw = tw + 1; }
                if (ic2_reads(t, v) == 1) { return 0; }
            }
            t = t.next;
        }
        if (tw != 1) { return 0; }
        e = e0;
        while (cast(i64, e) != cast(i64, ljoin)) {
            if (e.is_dead == 0 && ic2_reads(e, v) == 1) { return 0; }
            e = e.next;
        }
        let is i32 as k3 with mut = 0;
        while (k3 < np) {
            let is *d.IRInst as a = cast(*d.IRInst, pt[k3]);
            let is *d.IRInst as b = cast(*d.IRInst, pe[k3]);
            if (a.src1.vreg == v || b.src1.vreg == v) { return 0; }
            k3 = k3 + 1;
        }
        k2 = k2 + 1;
    }
    // cond is not written in either arm
    t = t0;
    while (cast(i64, t) != cast(i64, jmp)) { if (t.is_dead == 0 && t.dest.vreg == cond) { return 0; } t = t.next; }
    e = e0;
    while (cast(i64, e) != cast(i64, ljoin)) { if (e.is_dead == 0 && e.dest.vreg == cond) { return 0; } e = e.next; }

    // The compare that makes cond (and an AND feeding only it), right before
    // the JZ and read only by it, moves down to the selects: its flags are
    // then still there for them (emit_inst.cst, cmov_cond). Its operands are
    // none of the arms' own values (those are read only in their arm) and
    // none of the phi dests (checked), so it computes the same there.
    let is *d.IRInst as cmpi with mut = ic2_prev_live(func, jz);
    let is *d.IRInst as andi with mut = cast(*d.IRInst, 0);
    if (cast(i64, cmpi) != 0 && ic2_is_cmp(cmpi.op) == 1 && cmpi.dest.op_type == d.OP_VREG && cmpi.dest.vreg == cond
        && ic2_uses(func, cond) == 1 && ic2_src_ok(cmpi, &pd[0], np) == 1) {
        let is *d.IRInst as a = ic2_prev_live(func, cmpi);
        if (cast(i64, a) != 0 && a.op == d.IR_AND && a.dest.op_type == d.OP_VREG && cmpi.src1.op_type == d.OP_VREG
            && a.dest.vreg == cmpi.src1.vreg && ic2_uses(func, a.dest.vreg) == 1 && ic2_src_ok(a, &pd[0], np) == 1) {
            andi = a;
        }
    } else {
        cmpi = cast(*d.IRInst, 0);
    }

    // --- transform ---
    ic_kill_free_labels(func, lel.next, e0);
    jz.is_dead = 1;
    jmp.is_dead = 1;
    lel.is_dead = 1;
    let is i32 as k4 with mut = 0;
    let is *d.IRInst as tail with mut = ic_prev_of(func, ljoin);
    if (cast(i64, cmpi) != 0) {
        if (cast(i64, andi) != 0) {
            let is *d.IRInst as pa = ic_prev_of(func, andi);
            pa.next = andi.next;
            andi.next = tail.next; tail.next = andi; tail = andi;
        }
        let is *d.IRInst as pc = ic_prev_of(func, cmpi);
        pc.next = cmpi.next;
        cmpi.next = tail.next; tail.next = cmpi; tail = cmpi;
    }
    while (k4 < np) {
        let is *d.IRInst as a = cast(*d.IRInst, pt[k4]);
        let is *d.IRInst as b = cast(*d.IRInst, pe[k4]);
        a.is_dead = 1;
        b.is_dead = 1;
        let is *d.IRInst as mv = d.new_inst(d.IR_MOV);
        mv.dest = b.dest; mv.src1 = b.src1; mv.cast_to = b.cast_to; mv.line = b.line;
        let is *d.IRInst as cm = d.new_inst(d.IR_CMOV);
        cm.dest.op_type = d.OP_VREG; cm.dest.vreg = pd[k4];
        cm.src1.op_type = d.OP_VREG; cm.src1.vreg = cond;
        cm.src2.op_type = d.OP_VREG; cm.src2.vreg = a.src1.vreg;
        cm.line = b.line;
        mv.next = cm;
        cm.next = tail.next;
        tail.next = mv;
        tail = cm;
        k4 = k4 + 1;
    }
    // the join is straight-line code now
    if (ic_count_label_refs(func, join_label) == 0) { ljoin.is_dead = 1; }
    return 1;
}

fn ic_prev_of(func as *d.IRFunction, x as *d.IRInst) as *d.IRInst {
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != 0 && cast(i64, w.next) != cast(i64, x)) { w = w.next; }
    return w;
}

fn ic2_prev_live(func as *d.IRFunction, x as *d.IRInst) as *d.IRInst {
    let is *d.IRInst as r with mut = cast(*d.IRInst, 0);
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != 0 && cast(i64, w) != cast(i64, x)) {
        if (w.is_dead == 0) { r = w; }
        w = w.next;
    }
    return r;
}

fn ic2_is_cmp(op as i32) as i32 {
    if (op == d.IR_EQ || op == d.IR_NE || op == d.IR_LT || op == d.IR_LE || op == d.IR_GT || op == d.IR_GE) { return 1; }
    return 0;
}

fn ic2_uses(func as *d.IRFunction, v as i32) as i32 {
    let is i32 as n with mut = 0;
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != 0) {
        if (w.is_dead == 0 && ic2_reads(w, v) == 1) { n = n + 1; }
        w = w.next;
    }
    return n;
}

// No operand of i is a phi dest.
fn ic2_src_ok(i as *d.IRInst, pd as *i32, np as i32) as i32 {
    let is i32 as k with mut = 0;
    while (k < np) {
        if (i.src1.op_type == d.OP_VREG && i.src1.vreg == pd[k]) { return 0; }
        if (i.src2.op_type == d.OP_VREG && i.src2.vreg == pd[k]) { return 0; }
        k = k + 1;
    }
    return 1;
}
