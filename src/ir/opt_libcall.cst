use "defs.cst" as d;

// === Calls of std's allocator and string functions, read for what they mean ===
//
// -O2, once everything else is inlined into the caller and optimized: these
// calls stay calls until then (opt_inline.cst _is_late, late_inline_func).
//
//  - An object from bins_alloc that is only written through and freed: nothing
//    can tell it existed. The allocation, the stores into it and the free go.
//    As with malloc in C, the allocator's own state is not part of what a
//    program observes.
//  - strcpy(dst, "literal"): the copy of a known number of bytes.
//  - strlen("literal"): the number.

fn _ends(i as *d.IRInst, s as *u8, n as i32) as i32 {
    let is i32 as ln = cast(i32, i.call_name_len);
    if (ln < n) { return 0; }
    if (d.str_eq(i.call_name_ptr + cast(i64, ln - n), n, s, n) == 0) { return 0; }
    // the module prefix ends in '_' (or is empty)
    if (ln > n && i.call_name_ptr[ln - n - 1] != cast(u8, 95)) { return 0; }
    return 1;
}

fn _is_alloc(i as *d.IRInst) as i32 { return _ends(i, "std_mem_bins_cst_bins_alloc", 27); }
fn _is_free(i as *d.IRInst) as i32 { return _ends(i, "std_mem_bins_cst_bins_free", 26); }

// Every vreg's definition count.
fn _count_defs(func as *d.IRFunction, nd as *i32, vc as i32) as void {
    let is i32 as k with mut = 0;
    while (k < vc) { nd[k] = 0; k = k + 1; }
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != 0) {
        if (w.is_dead == 0 && w.dest.op_type == d.OP_VREG && w.op != d.IR_STORE && w.op != d.IR_COPY
            && w.op != d.IR_VSTOREQ && w.op != d.IR_VSTOREQ256 && w.dest.vreg >= 0 && w.dest.vreg < vc) {
            nd[w.dest.vreg] = nd[w.dest.vreg] + 1;
        }
        w = w.next;
    }
}

fn _has(al as *u8, o as *d.Operand, vc as i32) as i32 {
    if (o.op_type == d.OP_VREG && o.vreg >= 0 && o.vreg < vc && al[o.vreg] != cast(u8, 0)) { return 1; }
    return 0;
}

// a: the SET_ARG of index 1 of a bins_free call, which follows in its run
fn _is_free_ptr_arg(a as *d.IRInst) as i32 {
    if (a.dest.op_type != d.OP_IMM || a.dest.imm != 1) { return 0; }
    let is *d.IRInst as x with mut = a.next;
    while (cast(i64, x) != 0 && (x.is_dead == 1 || x.op == d.IR_SET_ARG)) { x = x.next; }
    if (cast(i64, x) == 0 || x.op != d.IR_CALL) { return 0; }
    return _is_free(x);
}

// The SET_ARGs right before `cs` and the call itself.
fn _kill_call(func as *d.IRFunction, cs as *d.IRInst) as void {
    let is *d.IRInst as run with mut = cast(*d.IRInst, 0);
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != cast(i64, cs)) {
        if (w.is_dead == 0) {
            if (w.op == d.IR_SET_ARG) { if (cast(i64, run) == 0) { run = w; } }
            else { run = cast(*d.IRInst, 0); }
        }
        w = w.next;
    }
    if (cast(i64, run) == 0) { run = cs; }
    while (cast(i64, run) != cast(i64, cs)) { run.is_dead = 1; run = run.next; }
    cs.is_dead = 1;
}

// The allocation `cs`: gone when its result is only written through and freed.
fn _elide(func as *d.IRFunction, cs as *d.IRInst, nd as *i32, al as *u8, vc as i32) as i32 {
    if (cs.dest.op_type != d.OP_VREG || nd[cs.dest.vreg] != 1) { return 0; }
    let is i32 as k with mut = 0;
    while (k < vc) { al[k] = cast(u8, 0); k = k + 1; }
    al[cs.dest.vreg] = cast(u8, 1);
    // what holds the pointer, or a pointer into the object
    let is i32 as changed with mut = 1;
    while (changed == 1) {
        changed = 0;
        let is *d.IRInst as w with mut = func.instructions;
        while (cast(i64, w) != 0) {
            if (w.is_dead == 0 && w.dest.op_type == d.OP_VREG && w.dest.vreg >= 0 && w.dest.vreg < vc
                && _has(al, &w.src1, vc) == 1 && al[w.dest.vreg] == cast(u8, 0)
                && (w.op == d.IR_MOV || w.op == d.IR_CAST || (w.op == d.IR_ADD && w.src2.op_type == d.OP_IMM))) {
                if (nd[w.dest.vreg] != 1) { return 0; }
                al[w.dest.vreg] = cast(u8, 1);
                changed = 1;
            }
            w = w.next;
        }
    }
    // every reader
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != 0) {
        if (w.is_dead == 0) {
            let is i32 as op = w.op;
            let is i32 as r1 = _has(al, &w.src1, vc);
            let is i32 as r2 = _has(al, &w.src2, vc);
            if (op == d.IR_MOV || op == d.IR_CAST || (op == d.IR_ADD && w.src2.op_type == d.OP_IMM)) {
                // (a CAST changing the width of a pointer stops here)
                if (r1 == 1 && op == d.IR_CAST) {
                    if (cast(i64, w.cast_to) == 0 || cast(i64, w.cast_from) == 0) { return 0; }
                    if (*(cast(*i32, cast(i64, w.cast_to) + 28)) != 8 || *(cast(*i32, cast(i64, w.cast_from) + 28)) != 8) { return 0; }
                }
            } else if (op == d.IR_STORE || op == d.IR_COPY) {
                // written through; the pointer itself must not be what is written
                if (r1 == 1 || r2 == 1) { return 0; }
            } else if (op == d.IR_SET_ARG) {
                if (r1 == 1 && _is_free_ptr_arg(w) == 0) { return 0; }
            } else {
                if (r1 == 1 || r2 == 1) { return 0; }
                if (op == d.IR_CMOV && _has(al, &w.dest, vc) == 1) { return 0; }
            }
        }
        w = w.next;
    }
    // Gone: the frees (their SET_ARGs first), the stores, the allocation.
    let is i32 as go with mut = 1;
    while (go == 1) {
        go = 0;
        w = func.instructions;
        while (cast(i64, w) != 0 && go == 0) {
            if (w.is_dead == 0 && w.op == d.IR_SET_ARG && _has(al, &w.src1, vc) == 1) {
                let is *d.IRInst as x with mut = w.next;
                while (x.is_dead == 1 || x.op == d.IR_SET_ARG) { x = x.next; }
                _kill_call(func, x);
                go = 1;
            }
            w = w.next;
        }
    }
    w = func.instructions;
    while (cast(i64, w) != 0) {
        if (w.is_dead == 0 && (w.op == d.IR_STORE || w.op == d.IR_COPY) && _has(al, &w.dest, vc) == 1) { w.is_dead = 1; }
        w = w.next;
    }
    _kill_call(func, cs);
    return 1;
}

// The literal v holds: its entry, or 0. Through copies, and only when it has
// no escapes (the bytes are then the text as written).
fn _literal_of(func as *d.IRFunction, v as i32, strings as *d.StringEntry) as *d.StringEntry {
    let is i32 as cur with mut = v;
    let is i32 as hops with mut = 0;
    while (hops < 4) {
        let is *d.IRInst as de with mut = cast(*d.IRInst, 0);
        let is i32 as nde with mut = 0;
        let is *d.IRInst as w with mut = func.instructions;
        while (cast(i64, w) != 0) {
            if (w.is_dead == 0 && w.dest.op_type == d.OP_VREG && w.dest.vreg == cur && w.op != d.IR_STORE && w.op != d.IR_COPY) {
                de = w;
                nde = nde + 1;
            }
            w = w.next;
        }
        if (nde != 1) { return cast(*d.StringEntry, 0); }
        if (de.op == d.IR_MOV && de.src1.op_type == d.OP_VREG) { cur = de.src1.vreg; hops = hops + 1; }
        else if (de.op == d.IR_ADDR_GLOBAL && de.global_name_len > 3 && de.global_name_ptr[0] == cast(u8, 46)
                 && de.global_name_ptr[1] == cast(u8, 76) && de.global_name_ptr[2] == cast(u8, 67)) {
            let is i32 as id with mut = 0;
            let is i32 as q with mut = 3;
            while (q < cast(i32, de.global_name_len)) {
                let is i32 as c = cast(i32, de.global_name_ptr[q]);
                if (c < 48 || c > 57) { return cast(*d.StringEntry, 0); }
                id = id * 10 + c - 48;
                q = q + 1;
            }
            let is *d.StringEntry as s with mut = strings;
            while (cast(i64, s) != 0 && s.id != id) { s = s.next; }
            if (cast(i64, s) == 0) { return s; }
            q = 0;
            while (q < s.len) {
                if (s.ptr[q] == cast(u8, 92) || s.ptr[q] == cast(u8, 0)) { return cast(*d.StringEntry, 0); }
                q = q + 1;
            }
            return s;
        }
        else { return cast(*d.StringEntry, 0); }
    }
    return cast(*d.StringEntry, 0);
}

// Argument `idx` of the call: its SET_ARG in the run right before it.
fn _arg_of(func as *d.IRFunction, cs as *d.IRInst, idx as i64) as *d.IRInst {
    let is *d.IRInst as found with mut = cast(*d.IRInst, 0);
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != cast(i64, cs)) {
        if (w.is_dead == 0) {
            if (w.op == d.IR_SET_ARG) { if (w.dest.op_type == d.OP_IMM && w.dest.imm == idx) { found = w; } }
            else { found = cast(*d.IRInst, 0); }
        }
        w = w.next;
    }
    return found;
}

fn pass_lib_calls(func as *d.IRFunction, strings as *d.StringEntry) as i32 {
    let is i32 as any with mut = 0;
    let is *d.IRInst as w with mut = func.instructions;
    while (cast(i64, w) != 0 && any == 0) {
        if (w.is_dead == 0 && w.op == d.IR_CALL && w.is_extern_call == 0
            && (_is_alloc(w) == 1 || _ends(w, "std_string_cst_strcpy", 21) == 1 || _ends(w, "std_string_cst_strlen", 21) == 1)) { any = 1; }
        w = w.next;
    }
    if (any == 0) { return 0; }
    let is i32 as vc = func.vreg_count;
    let is *i32 as nd = cast(*i32, d.opt_alloc(cast(i64, vc) * 4 + 8));
    let is *u8 as al = d.opt_alloc(cast(i64, vc) + 8);
    let is i32 as hit with mut = 0;
    _count_defs(func, nd, vc);
    w = func.instructions;
    while (cast(i64, w) != 0) {
        if (w.is_dead == 0 && w.op == d.IR_CALL && w.is_extern_call == 0) {
            if (_is_alloc(w) == 1) {
                if (_elide(func, w, nd, al, vc) == 1) { hit = 1; }
            } else if (_ends(w, "std_string_cst_strcpy", 21) == 1) {
                let is *d.IRInst as a0 = _arg_of(func, w, 0);
                let is *d.IRInst as a1 = _arg_of(func, w, 1);
                if (cast(i64, a0) != 0 && cast(i64, a1) != 0 && a0.src1.op_type == d.OP_VREG && a1.src1.op_type == d.OP_VREG) {
                    let is *d.StringEntry as s = _literal_of(func, a1.src1.vreg, strings);
                    if (cast(i64, s) != 0 && s.len < 64) {
                        let is i32 as dv = a0.src1.vreg;
                        let is i32 as sv = a1.src1.vreg;
                        a0.is_dead = 1;
                        a1.is_dead = 1;
                        let is *d.IRInst as cp = d.new_inst(d.IR_COPY);
                        cp.dest = d.op_vreg(dv);
                        cp.src1 = d.op_vreg(sv);
                        cp.src2 = d.op_imm(cast(i64, s.len) + 1);
                        cp.line = w.line;
                        // the call's value is dst
                        let is *d.IRInst as mv = d.new_inst(d.IR_MOV);
                        mv.dest = w.dest;
                        mv.src1 = d.op_vreg(dv);
                        mv.cast_to = w.cast_to;
                        mv.line = w.line;
                        mv.next = w.next;
                        cp.next = mv;
                        w.is_dead = 1;
                        w.next = cp;
                        hit = 1;
                    }
                }
            } else if (_ends(w, "std_string_cst_strlen", 21) == 1) {
                let is *d.IRInst as a0 = _arg_of(func, w, 0);
                if (cast(i64, a0) != 0 && a0.src1.op_type == d.OP_VREG) {
                    let is *d.StringEntry as s = _literal_of(func, a0.src1.vreg, strings);
                    if (cast(i64, s) != 0) {
                        a0.is_dead = 1;
                        w.op = d.IR_IMM;
                        w.src1 = d.op_imm(cast(i64, s.len));
                        w.src2.op_type = d.OP_NONE;
                        hit = 1;
                    }
                }
            }
        }
        w = w.next;
    }
    d.opt_free(cast(*u8, nd));
    d.opt_free(al);
    return hit;
}
