// Peephole optimizer: post-pass on generated .s assembly
// Eliminates redundant MOVs and folds sign-extension patterns.
//
// Patterns:
//   1. MOV + movsxd fusion: mov rA, rB + movsxd rA, rAd → movsxd rA, rBd
//   2. MOV chain bypass: mov rA, rB + mov rC, rA → keep first, rewrite second to mov rC, rB
//   3. Dead MOV elimination: mov rA, X; mov rA, Y → remove first
//      (only when Y does not reference rA in any way)
//   5. Load through a copied address: mov rA, rB + mov rA, [rA+…] → mov rA, [rB+…]
//   6. Reload of what was just stored: mov QWORD PTR [M], rA + mov rA, QWORD PTR [M]
//      (or the same with movsd and an xmm) → keep the store
//
// Inline asm (between the #APP / #NO_APP lines codegen brackets it with) is
// never touched: only pairs of generated lines are candidates.

use "target.cst" as tgt;
use "asm_print.cst" as aprint;
use "../../std/env.cst" as _pchk_env;
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;
use "../../caustic-assembler/parser/parsed_line.cst" as apl;
use "../../caustic-assembler/parser/parser.cst" as apar;
use "../../caustic-assembler/core/asm_defs.cst" as adef;

// ── Helpers ──────────────────────────────────────────────────────────

fn ph_strlen(s as *u8) as i32 {
    let is i32 as i with mut = 0;
    while (s[i] != 0) { i = i + 1; }
    return i;
}

fn ph_streq(a as *u8, alen as i32, b as *u8, blen as i32) as i32 {
    if (alen != blen) { return 0; }
    let is i32 as i with mut = 0;
    while (i < alen) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn ph_memcpy(dst as *u8, src as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { dst[i] = src[i]; i = i + 1; }
}

// Check if haystack contains needle as substring
fn str_contains(hay as *u8, hlen as i32, ndl as *u8, nlen as i32) as i32 {
    if (nlen > hlen) { return 0; }
    let is i32 as end = hlen - nlen;
    let is i32 as i with mut = 0;
    while (i <= end) {
        let is i32 as j with mut = 0;
        let is i32 as ok with mut = 1;
        while (j < nlen) {
            if (hay[i + j] != ndl[j]) { ok = 0; j = nlen; }
            j = j + 1;
        }
        if (ok == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// ── Line table ───────────────────────────────────────────────────────

let is *u8 as line_offs with mut;
let is *u8 as line_lens with mut;
let is *u8 as line_hand with mut;     // 1 = a line of inline asm (#APP .. #NO_APP)
let is i32 as line_count with mut = 0;

fn hand_written(i as i32) as i32 { return cast(i32, line_hand[i]); }

// The line at off, len is exactly `word` (after leading blanks).
fn _is_marker(buf as *u8, off as i64, len as i32, word as *u8) as i32 {
    let is i32 as ws = skip_ws(buf, off, len);
    let is i32 as wl = ph_strlen(word);
    if (len - ws != wl) { return 0; }
    let is i32 as k with mut = 0;
    while (k < wl) {
        if (buf[off + cast(i64, ws + k)] != word[k]) { return 0; }
        k = k + 1;
    }
    return 1;
}

// The line table holds absolute addresses (the pattern helpers are called with
// a null base), a flag byte per line (LF_REPL: rewritten, its text in repl_buf;
// LF_LAZY: a record hint with no text, printed from its record on first read)
// and lengths (-1: removed). alive() reads the length without printing.
let is *u8 as line_flag with mut;
let is i32 as LF_REPL with imut = 1;
let is i32 as LF_LAZY with imut = 2;
let is i32 as LF_RECMOD with imut = 4;     // rewritten in its record: nothing to re-parse
let is *u8 as ph_lines with mut;          // the ParsedLines, for LF_LAZY lines
let is *u8 as rend_buf with mut;
let is i64 as rend_len with mut = 0;
let is i64 as rend_cap with mut = 0;
let is i64 as stat_rendered with mut = 0;

fn is_repl(i as i32) as i32 { return cast(i32, (cast(i32, line_flag[i]) & LF_REPL) != 0); }
fn is_lazy(i as i32) as i32 { return cast(i32, (cast(i32, line_flag[i]) & LF_LAZY) != 0); }
fn set_repl(i as i32) as void { line_flag[i] = cast(u8, (cast(i32, line_flag[i]) | LF_REPL) & (255 - LF_LAZY)); }

fn _raw_len(i as i32) as i32 {
    let is *i32 as p = cast(*i32, cast(i64, line_lens) + cast(i64, i) * 4);
    return *p;
}

fn alive(i as i32) as i32 {
    let is *i32 as p = cast(*i32, cast(i64, line_lens) + cast(i64, i) * 4);
    return cast(i32, *p >= 0);
}

// Print a lazy line's record into rend_buf: what codegen would have written
// (CAUSTIC_PRINT_CHECK holds the printer to that text).
fn _render(i as i32) as void {
    if (is_lazy(i) == 0) { return; }
    line_flag[i] = cast(u8, cast(i32, line_flag[i]) & (255 - LF_LAZY));
    if (_raw_len(i) < 0) { return; }
    if (rend_len + 256 > rend_cap) {
        let is i64 as nc with mut = rend_cap * 2;
        if (nc < 1048576) { nc = 1048576; }
        rend_buf = mem.core.mmap_anon(nc);      // the old block stays: lines point into it
        rend_len = 0;
        rend_cap = nc;
    }
    let is *u8 as at = cast(*u8, cast(i64, rend_buf) + rend_len);
    let is i32 as n = aprint.print_line(apl.pl_get(cast(*apl.ParsedLines, ph_lines), i), at);
    if (n < 0) {
        io.write_str(io.STDERR, "internal error: peephole cannot print a hinted record\n");
        io.exit(1);
    }
    rend_len = rend_len + cast(i64, n) + 1;
    stat_rendered = stat_rendered + 1;
    let is *i64 as po = cast(*i64, cast(i64, line_offs) + cast(i64, i) * 8);
    *po = cast(i64, at);
    let is *i32 as pl = cast(*i32, cast(i64, line_lens) + cast(i64, i) * 4);
    *pl = n;
}

fn get_off(i as i32) as i64 {
    if ((cast(i32, line_flag[i]) & 2) != 0) { _render(i); }
    let is *i64 as p = cast(*i64, cast(i64, line_offs) + cast(i64, i) * 8);
    return *p;
}

fn set_off(i as i32, v as i64) as void {
    let is *i64 as p = cast(*i64, cast(i64, line_offs) + cast(i64, i) * 8);
    *p = v;
}

fn get_len(i as i32) as i32 {
    if ((cast(i32, line_flag[i]) & 2) != 0) { _render(i); }
    let is *i32 as p = cast(*i32, cast(i64, line_lens) + cast(i64, i) * 4);
    return *p;
}

fn set_len(i as i32, v as i32) as void {
    let is *i32 as p = cast(*i32, cast(i64, line_lens) + cast(i64, i) * 4);
    *p = v;
}

// ── Parsing helpers ──────────────────────────────────────────────────

fn skip_ws(buf as *u8, start as i64, len as i32) as i32 {
    let is i32 as i with mut = 0;
    let is *u8 as p = cast(*u8, cast(i64, buf) + start);
    while (i < len) {
        if (p[i] != 32 && p[i] != 9) { return i; }
        i = i + 1;
    }
    return len;
}

// Returns offset to first operand, or 99999 if no match
fn match_inst(buf as *u8, off as i64, len as i32, mnem as *u8, mlen as i32) as i32 {
    let is i32 as ws = skip_ws(buf, off, len);
    if (ws + mlen >= len) { return 99999; }
    let is *u8 as p = cast(*u8, cast(i64, buf) + off + cast(i64, ws));
    let is i32 as i with mut = 0;
    while (i < mlen) {
        if (p[i] != mnem[i]) { return 99999; }
        i = i + 1;
    }
    if (p[mlen] != 32) { return 99999; }
    return ws + mlen + 1;
}

fn get_operand(buf as *u8, off as i64, start as i32, len as i32, out_len as *i32) as *u8 {
    let is *u8 as p = cast(*u8, cast(i64, buf) + off + cast(i64, start));
    let is i32 as i with mut = 0;
    let is i32 as max = len - start;
    while (i < max) {
        if (p[i] == 44) { *out_len = i; return p; }
        i = i + 1;
    }
    *out_len = max;
    return p;
}

fn is_reg64(op as *u8, olen as i32) as i32 {
    if (olen < 2 || olen > 4) { return 0; }
    if (op[0] != 114) { return 0; }
    if (olen == 3) {
        if (op[1] == 98 && op[2] == 112) { return 0; }
        if (op[1] == 115 && op[2] == 112) { return 0; }
        if (op[1] == 105 && op[2] == 112) { return 0; }
    }
    return 1;
}

fn reg64_to_32(op as *u8, olen as i32) as *u8 {
    if (olen == 3 && op[0] == 114) {
        if (op[1] == 97 && op[2] == 120) { return "eax"; }
        if (op[1] == 99 && op[2] == 120) { return "ecx"; }
        if (op[1] == 100 && op[2] == 120) { return "edx"; }
        if (op[1] == 98 && op[2] == 120) { return "ebx"; }
        if (op[1] == 115 && op[2] == 105) { return "esi"; }
        if (op[1] == 100 && op[2] == 105) { return "edi"; }
    }
    if (olen == 2 && op[0] == 114) {
        if (op[1] == 56) { return "r8d"; }
        if (op[1] == 57) { return "r9d"; }
    }
    if (olen == 3 && op[0] == 114 && op[1] == 49) {
        if (op[2] == 48) { return "r10d"; }
        if (op[2] == 49) { return "r11d"; }
        if (op[2] == 50) { return "r12d"; }
        if (op[2] == 51) { return "r13d"; }
        if (op[2] == 52) { return "r14d"; }
        if (op[2] == 53) { return "r15d"; }
    }
    return cast(*u8, 0);
}

// ── Replacement buffer ───────────────────────────────────────────────

let is *u8 as repl_buf with mut;
let is i64 as repl_len with mut = 0;
let is i64 as repl_cap with mut = 0;

fn repl_line(s as *u8, slen as i32) as i64 {
    if (repl_len + cast(i64, slen) > repl_cap) { return cast(i64, 0 - 1); }
    let is i64 as off = repl_len;
    ph_memcpy(cast(*u8, cast(i64, repl_buf) + repl_len), s, cast(i64, slen));
    repl_len = repl_len + cast(i64, slen);
    return off;
}

let is i32 as stat_removed with mut = 0;
let is i32 as stat_fused with mut = 0;
let is [128]u8 as pat_tmp with mut;


// ── Pattern 1: MOV + movsxd fusion ──────────────────────────────────

fn try_pat1(buf as *u8, i as i32, p1 as i32) as i32 {
    let is i64 as off1 = get_off(i);
    let is i32 as len1 = get_len(i);
    let is i64 as off2 = get_off(i + 1);
    let is i32 as len2 = get_len(i + 1);

    let is i32 as a1l with mut = 0;
    let is *u8 as a1 = get_operand(buf, off1, p1, len1, &a1l);
    if (is_reg64(a1, a1l) == 0) { return 0; }
    let is i32 as p1b = p1 + a1l + 2;
    if (p1b >= len1) { return 0; }
    let is i32 as b1l with mut = 0;
    let is *u8 as b1 = get_operand(buf, off1, p1b, len1, &b1l);
    if (is_reg64(b1, b1l) == 0) { return 0; }

    let is i32 as p2 = match_inst(buf, off2, len2, "movsxd", 6);
    if (p2 == 99999) { return 0; }
    let is i32 as a2l with mut = 0;
    let is *u8 as a2 = get_operand(buf, off2, p2, len2, &a2l);
    if (ph_streq(a2, a2l, a1, a1l) == 0) { return 0; }
    let is i32 as p2b = p2 + a2l + 2;
    if (p2b >= len2) { return 0; }
    let is i32 as b2l with mut = 0;
    let is *u8 as b2 = get_operand(buf, off2, p2b, len2, &b2l);

    let is *u8 as e32 = reg64_to_32(a2, a2l);
    if (cast(i64, e32) == 0) { return 0; }
    let is i32 as e32l = ph_strlen(e32);
    if (ph_streq(b2, b2l, e32, e32l) == 0) { return 0; }

    let is *u8 as rBd = reg64_to_32(b1, b1l);
    if (cast(i64, rBd) == 0) { return 0; }
    let is i32 as rBdl = ph_strlen(rBd);

    let is i32 as tp with mut = 0;
    pat_tmp[0] = 32; pat_tmp[1] = 32; tp = 2;
    ph_memcpy(cast(*u8, cast(i64, &pat_tmp) + cast(i64, tp)), "movsxd ", 7); tp = tp + 7;
    ph_memcpy(cast(*u8, cast(i64, &pat_tmp) + cast(i64, tp)), a1, cast(i64, a1l)); tp = tp + a1l;
    pat_tmp[tp] = 44; tp = tp + 1;
    pat_tmp[tp] = 32; tp = tp + 1;
    ph_memcpy(cast(*u8, cast(i64, &pat_tmp) + cast(i64, tp)), rBd, cast(i64, rBdl)); tp = tp + rBdl;

    if (tp >= 128) { return 0; }
    let is i64 as roff = repl_line(cast(*u8, &pat_tmp), tp);
    if (roff < 0) { return 0; }
    set_len(i, cast(i32, 0 - 1));
    set_off(i + 1, cast(i64, repl_buf) + roff); set_repl(i + 1);
    set_len(i + 1, tp);
    stat_fused = stat_fused + 1;
    return 1;
}

// ── Pattern 2: MOV chain bypass ──────────────────────────────────────

fn try_pat2(buf as *u8, i as i32, p1 as i32) as i32 {
    let is i64 as off1 = get_off(i);
    let is i32 as len1 = get_len(i);
    let is i64 as off2 = get_off(i + 1);
    let is i32 as len2 = get_len(i + 1);

    // Line i: mov rA, rB (both reg64); p1 is its parsed operand start.

    let is i32 as a1l with mut = 0;
    let is *u8 as a1 = get_operand(buf, off1, p1, len1, &a1l);
    if (is_reg64(a1, a1l) == 0) { return 0; }
    let is i32 as s1s = p1 + a1l + 2;
    if (s1s >= len1) { return 0; }
    let is i32 as s1l with mut = 0;
    let is *u8 as s1 = get_operand(buf, off1, s1s, len1, &s1l);
    if (is_reg64(s1, s1l) == 0) { return 0; }

    // rA != rB (NOP otherwise, pattern 3 handles)
    if (ph_streq(a1, a1l, s1, s1l) == 1) { return 0; }

    // Line i+1: mov rC, rA
    let is i32 as p2 = match_inst(buf, off2, len2, "mov", 3);
    if (p2 == 99999) { return 0; }
    let is i32 as a2l with mut = 0;
    let is *u8 as a2 = get_operand(buf, off2, p2, len2, &a2l);
    if (is_reg64(a2, a2l) == 0) { return 0; }
    let is i32 as s2s = p2 + a2l + 2;
    if (s2s >= len2) { return 0; }
    let is i32 as s2l with mut = 0;
    let is *u8 as s2 = get_operand(buf, off2, s2s, len2, &s2l);

    // Source of i+1 must equal dest of i (rA)
    if (ph_streq(s2, s2l, a1, a1l) == 0) { return 0; }

    // rA != rC (NOP otherwise)
    if (ph_streq(a1, a1l, a2, a2l) == 1) { return 0; }

    // If rC == rB, the rewrite would be mov rC, rC (self-MOV) — delete i+1
    if (ph_streq(a2, a2l, s1, s1l) == 1) {
        set_len(i + 1, cast(i32, 0 - 1));
        stat_removed = stat_removed + 1;
        return 1;
    }

    // Rewrite i+1: mov rC, rB
    let is i32 as tp with mut = 0;
    pat_tmp[0] = 32; pat_tmp[1] = 32; tp = 2;
    ph_memcpy(cast(*u8, cast(i64, &pat_tmp) + cast(i64, tp)), "mov ", 4); tp = tp + 4;
    ph_memcpy(cast(*u8, cast(i64, &pat_tmp) + cast(i64, tp)), a2, cast(i64, a2l)); tp = tp + a2l;
    pat_tmp[tp] = 44; tp = tp + 1;
    pat_tmp[tp] = 32; tp = tp + 1;
    ph_memcpy(cast(*u8, cast(i64, &pat_tmp) + cast(i64, tp)), s1, cast(i64, s1l)); tp = tp + s1l;

    if (tp >= 128) { return 0; }
    let is i64 as roff = repl_line(cast(*u8, &pat_tmp), tp);
    if (roff < 0) { return 0; }
    set_off(i + 1, cast(i64, repl_buf) + roff); set_repl(i + 1);
    set_len(i + 1, tp);
    stat_fused = stat_fused + 1;
    return 1;
}

// ── Pattern 3: Dead MOV elimination ──────────────────────────────────

fn try_pat3(buf as *u8, i as i32, p1 as i32) as i32 {
    let is i64 as off1 = get_off(i);
    let is i32 as len1 = get_len(i);
    let is i64 as off2 = get_off(i + 1);
    let is i32 as len2 = get_len(i + 1);

    let is i32 as p2 = match_inst(buf, off2, len2, "mov", 3);
    if (p2 == 99999) { return 0; }

    let is i32 as d1l with mut = 0;
    let is *u8 as d1 = get_operand(buf, off1, p1, len1, &d1l);
    let is i32 as d2l with mut = 0;
    let is *u8 as d2 = get_operand(buf, off2, p2, len2, &d2l);

    if (is_reg64(d1, d1l) == 0) { return 0; }
    if (ph_streq(d1, d1l, d2, d2l) == 0) { return 0; }

    let is i32 as s2s = p2 + d2l + 2;
    if (s2s >= len2) { return 0; }
    let is i32 as s2l with mut = 0;
    let is *u8 as s2 = get_operand(buf, off2, s2s, len2, &s2l);
    if (str_contains(s2, s2l, d1, d1l) == 1) { return 0; }
    let is *u8 as d1_32 = reg64_to_32(d1, d1l);
    if (cast(i64, d1_32) != 0) {
        let is i32 as d1_32l = ph_strlen(d1_32);
        if (str_contains(s2, s2l, d1_32, d1_32l) == 1) { return 0; }
    }

    set_len(i, cast(i32, 0 - 1));
    stat_removed = stat_removed + 1;
    return 1;
}

// ── Pattern 5: load through a copied address ────────────────────────
// mov rA, rB ; mov/movzx/movsx/movsxd/lea rA, <mem using rA>
//   → mov/... rA, <mem using rB>   (and `mov rAd, <mem using rA>` the same way)
// The second line overwrites rA and reads it only in the address, so the copy
// is never seen: rA ends with the same value and rB is untouched.

fn _ph_alnum(c as u8) as i32 {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

// Offset of the first whole-token occurrence of reg in s, or -1.
fn _ph_find_reg(s as *u8, slen as i32, reg as *u8, rlen as i32, from as i32) as i32 {
    let is i32 as i with mut = from;
    while (i + rlen <= slen) {
        if (ph_streq(cast(*u8, cast(i64, s) + cast(i64, i)), rlen, reg, rlen) == 1) {
            let is i32 as before_ok = i == 0 || _ph_alnum(s[i - 1]) == 0;
            let is i32 as after_ok = i + rlen == slen || _ph_alnum(s[i + rlen]) == 0;
            if (before_ok == 1 && after_ok == 1) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn try_pat5(buf as *u8, i as i32, p1 as i32) as i32 {
    let is i64 as off1 = get_off(i);
    let is i32 as len1 = get_len(i);
    let is i64 as off2 = get_off(i + 1);
    let is i32 as len2 = get_len(i + 1);

    let is i32 as al with mut = 0;
    let is *u8 as a = get_operand(buf, off1, p1, len1, &al);
    if (is_reg64(a, al) == 0) { return 0; }
    let is i32 as bs = p1 + al + 2;
    if (bs >= len1) { return 0; }
    let is i32 as bl with mut = 0;
    let is *u8 as b = get_operand(buf, off1, bs, len1, &bl);
    if (bs + bl != len1) { return 0; }
    if (is_reg64(b, bl) == 0) { return 0; }
    if (ph_streq(a, al, b, bl) == 1) { return 0; }

    let is *u8 as mn with mut = "mov";
    let is i32 as p2 with mut = match_inst(buf, off2, len2, "mov", 3);
    if (p2 == 99999) { mn = "movzx"; p2 = match_inst(buf, off2, len2, "movzx", 5); }
    if (p2 == 99999) { mn = "movsx"; p2 = match_inst(buf, off2, len2, "movsx", 5); }
    if (p2 == 99999) { mn = "movsxd"; p2 = match_inst(buf, off2, len2, "movsxd", 6); }
    if (p2 == 99999) { mn = "lea"; p2 = match_inst(buf, off2, len2, "lea", 3); }
    if (p2 == 99999) { return 0; }
    let is i32 as dl with mut = 0;
    let is *u8 as dst = get_operand(buf, off2, p2, len2, &dl);
    if (ph_streq(dst, dl, a, al) == 0) {
        // `mov rAd, DWORD PTR [rA]` writes all of rA as well (zero-extends)
        let is *u8 as ad = reg64_to_32(a, al);
        if (p2 != match_inst(buf, off2, len2, "mov", 3) || cast(i64, ad) == 0
            || ph_streq(dst, dl, ad, ph_strlen(ad)) == 0) { return 0; }
    }
    let is i32 as rs = p2 + dl + 2;
    if (rs >= len2) { return 0; }
    let is *u8 as rest = cast(*u8, cast(i64, buf) + off2 + cast(i64, rs));
    let is i32 as rl = len2 - rs;
    // The source must be a memory operand that names rA (and nothing else
    // reads rA: its narrower names must not appear).
    if (str_contains(rest, rl, "[", 1) == 0) { return 0; }
    if (str_contains(rest, rl, ",", 1) == 1) { return 0; }
    let is *u8 as a32 = reg64_to_32(a, al);
    if (cast(i64, a32) == 0) { return 0; }
    if (str_contains(rest, rl, a32, ph_strlen(a32)) == 1) { return 0; }
    if (_ph_find_reg(rest, rl, a, al, 0) < 0) { return 0; }

    let is i32 as tp with mut = 0;
    pat_tmp[0] = 32; pat_tmp[1] = 32; tp = 2;
    let is i32 as mnl = ph_strlen(mn);
    ph_memcpy(cast(*u8, cast(i64, &pat_tmp) + cast(i64, tp)), mn, cast(i64, mnl)); tp = tp + mnl;
    pat_tmp[tp] = 32; tp = tp + 1;
    ph_memcpy(cast(*u8, cast(i64, &pat_tmp) + cast(i64, tp)), dst, cast(i64, dl)); tp = tp + dl;
    pat_tmp[tp] = 44; tp = tp + 1;
    pat_tmp[tp] = 32; tp = tp + 1;
    let is i32 as k with mut = 0;
    while (k < rl) {
        if (tp + bl + 2 >= 128) { return 0; }
        let is i32 as hit = _ph_find_reg(rest, rl, a, al, k);
        if (hit == k) {
            ph_memcpy(cast(*u8, cast(i64, &pat_tmp) + cast(i64, tp)), b, cast(i64, bl)); tp = tp + bl;
            k = k + al;
        } else {
            pat_tmp[tp] = rest[k]; tp = tp + 1;
            k = k + 1;
        }
    }

    let is i64 as roff = repl_line(cast(*u8, &pat_tmp), tp);
    if (roff < 0) { return 0; }
    set_len(i, cast(i32, 0 - 1));
    set_off(i + 1, cast(i64, repl_buf) + roff); set_repl(i + 1);
    set_len(i + 1, tp);
    stat_fused = stat_fused + 1;
    return 1;
}

// Pattern 4: redundant `jmp .Lx` immediately followed by `.Lx:` (a jump to the
// next instruction = a no-op fall-through). Removing the jmp preserves semantics
// exactly (the label stays, so other branches to .Lx still resolve). Only
// unconditional jmp; conditional jcc-to-next is left alone for safety.
fn try_jmp_next(buf as *u8, i as i32) as i32 {
    let is i64 as off = get_off(i);
    let is i32 as len = get_len(i);
    let is i32 as ostart = match_inst(buf, off, len, "jmp", 3);
    if (ostart == 99999) { return 0; }
    let is i32 as olen with mut = 0;
    let is *u8 as op = get_operand(buf, off, ostart, len, &olen);
    while (olen > 0 && (op[olen - 1] == 32 || op[olen - 1] == 9)) { olen = olen - 1; }
    if (olen <= 0) { return 0; }
    // The target "<label>:" must come next, past only other labels (an empty
    // else arm leaves `jmp .Lb` / `.La:` / `.Lb:`): nothing runs in between.
    let is i32 as j with mut = i + 1;
    while (j < line_count) {
        if (alive(j) == 1) {
            if (is_repl(j) == 1 || hand_written(j) == 1) { return 0; }
            let is i64 as noff = get_off(j);
            let is i32 as nlen = get_len(j);
            let is i32 as nws = skip_ws(buf, noff, nlen);
            let is *u8 as np = cast(*u8, cast(i64, buf) + noff + cast(i64, nws));
            let is i32 as navail = nlen - nws;
            if (navail < 2 || np[navail - 1] != 58) { return 0; }   // not a label
            let is i32 as q with mut = 0;
            while (q < navail - 1) {
                if (np[q] == 32 || np[q] == 9) { return 0; }
                q = q + 1;
            }
            if (navail == olen + 1) {
                let is i32 as k with mut = 0;
                let is i32 as same with mut = 1;
                while (k < olen) {
                    if (np[k] != op[k]) { same = 0; }
                    k = k + 1;
                }
                if (same == 1) {
                    set_len(i, cast(i32, 0 - 1));
                    stat_removed = stat_removed + 1;
                    return 1;
                }
            }
        }
        j = j + 1;
    }
    return 0;
}

// ── Pattern 6: reload of a value just stored ────────────────────────
// mov QWORD PTR [M], rA ; mov rA, QWORD PTR [M]  → the store alone
// movsd QWORD PTR [M], xmmN ; movsd xmmN, QWORD PTR [M]  → the store alone
// The register already holds what the load would read back. A load by movsd
// also clears the upper half of the xmm, so for it the line after must be one
// that reads only the low double (scalar arithmetic, compare, move, convert).

fn _ph_operands(buf as *u8, off as i64, p as i32, len as i32, a as **u8, al as *i32, b as **u8, bl as *i32) as i32 {
    *a = get_operand(buf, off, p, len, al);
    let is i32 as q = p + *al + 2;
    if (q >= len) { return 0; }
    *b = get_operand(buf, off, q, len, bl);
    return 1;
}

fn _ph_is_xmm(op as *u8, ol as i32) as i32 {
    if (ol < 4 || ol > 5) { return 0; }
    if (op[0] != 120 || op[1] != 109 || op[2] != 109) { return 0; }
    return 1;
}

fn _ph_low_only(buf as *u8, j as i32) as i32 {
    let is i64 as off = get_off(j);
    let is i32 as len = get_len(j);
    if (is_repl(j) == 1 || hand_written(j) == 1) { return 0; }
    if (match_inst(buf, off, len, "ucomisd", 7) != 99999) { return 1; }
    if (match_inst(buf, off, len, "comisd", 6) != 99999) { return 1; }
    if (match_inst(buf, off, len, "addsd", 5) != 99999) { return 1; }
    if (match_inst(buf, off, len, "subsd", 5) != 99999) { return 1; }
    if (match_inst(buf, off, len, "mulsd", 5) != 99999) { return 1; }
    if (match_inst(buf, off, len, "divsd", 5) != 99999) { return 1; }
    if (match_inst(buf, off, len, "sqrtsd", 6) != 99999) { return 1; }
    if (match_inst(buf, off, len, "movsd", 5) != 99999) { return 1; }
    if (match_inst(buf, off, len, "movq", 4) != 99999) { return 1; }
    if (match_inst(buf, off, len, "cvttsd2si", 9) != 99999) { return 1; }
    if (match_inst(buf, off, len, "cvtsd2ss", 8) != 99999) { return 1; }
    return 0;
}

// A line that only tells the debugger where it is.
fn _ph_is_loc(buf as *u8, j as i32) as i32 {
    if (alive(j) == 0 || is_repl(j) == 1) { return 0; }
    return cast(i32, match_inst(buf, get_off(j), get_len(j), ".loc", 4) != 99999);
}

fn try_pat6(buf as *u8, i as i32) as i32 {
    // the reload may come after .loc lines
    let is i32 as k with mut = i + 1;
    while (k < line_count && (alive(k) == 0 || _ph_is_loc(buf, k) == 1)) { k = k + 1; }
    if (k >= line_count || is_repl(k) == 1 || hand_written(k) == 1) { return 0; }
    let is i64 as off1 = get_off(i);
    let is i32 as len1 = get_len(i);
    let is i64 as off2 = get_off(k);
    let is i32 as len2 = get_len(k);
    let is i32 as xmm with mut = 0;
    let is i32 as p1 with mut = match_inst(buf, off1, len1, "mov", 3);
    let is i32 as p2 with mut = match_inst(buf, off2, len2, "mov", 3);
    if (p1 == 99999) {
        p1 = match_inst(buf, off1, len1, "movsd", 5);
        p2 = match_inst(buf, off2, len2, "movsd", 5);
        xmm = 1;
    }
    if (p1 == 99999 || p2 == 99999) { return 0; }
    let is *u8 as m1 with mut = cast(*u8, 0);
    let is *u8 as r1 with mut = cast(*u8, 0);
    let is *u8 as r2 with mut = cast(*u8, 0);
    let is *u8 as m2 with mut = cast(*u8, 0);
    let is i32 as m1l with mut = 0;
    let is i32 as r1l with mut = 0;
    let is i32 as r2l with mut = 0;
    let is i32 as m2l with mut = 0;
    if (_ph_operands(buf, off1, p1, len1, &m1, &m1l, &r1, &r1l) == 0) { return 0; }
    if (_ph_operands(buf, off2, p2, len2, &r2, &r2l, &m2, &m2l) == 0) { return 0; }
    if (m1l < 12 || ph_streq(m1, 11, "QWORD PTR [", 11) == 0 || m1[m1l - 1] != 93) { return 0; }
    if (ph_streq(m1, m1l, m2, m2l) == 0 || ph_streq(r1, r1l, r2, r2l) == 0) { return 0; }
    if (xmm == 0 && is_reg64(r1, r1l) == 0) { return 0; }
    if (xmm == 1) {
        if (_ph_is_xmm(r1, r1l) == 0) { return 0; }
        let is i32 as j with mut = k + 1;
        while (j < line_count && alive(j) == 0) { j = j + 1; }
        if (j >= line_count || _ph_low_only(buf, j) == 0) { return 0; }
    }
    // the address must not use the register itself
    if (str_contains(m1, m1l, r1, r1l) == 1) { return 0; }
    set_len(k, cast(i32, 0 - 1));
    stat_removed = stat_removed + 1;
    return 1;
}

// ── Main pass ────────────────────────────────────────────────────────

// File entry: read the .s, optimize it in memory, write back if it changed.
fn optimize_asm(path as *u8) as void {
    let is i64 as fd = io._open_read(path);
    if (fd < 0) { return; }
    let is i64 as size = io._lseek(fd, 0, io._SEEK_END);
    io._lseek(fd, 0, io._SEEK_SET);
    if (size <= 0) { io._close_fd(fd); return; }
    let is i64 as buf_size = size + 4096;
    let is *u8 as buf = mem.core.mmap_anon(buf_size);
    if (cast(i64, buf) <= 0) { io._close_fd(fd); return; }
    io._read_fd(fd, buf, size);
    buf[size] = cast(u8, 0);
    io._close_fd(fd);
    let is i64 as olen with mut = 0;
    let is *u8 as outp = optimize_asm_buf(buf, size, &olen);
    if (cast(i64, outp) != cast(i64, buf)) {
        let is i64 as wfd = io._open_write(path);
        if (wfd >= 0) { io._write_fd(wfd, outp, olen); io._close_fd(wfd); }
        mem.core.munmap(outp, olen + 4096);
    }
    mem.core.munmap(buf, buf_size);
}

// In-memory peephole. Returns `buf` unchanged (with *out_len = size) when nothing
// matched, else a freshly mmap'd buffer (the caller owns it; *out_len is its len).
// The in-process pipeline calls this on codegen's captured .s so the optimized
// assembly never round-trips through disk before the assembler reads it.
// The emission-time peephole used to drop a `mov`/`movsxd` line identical to
// the immediately preceding one. Same rule here, over the line table: compare
// against the last KEPT line, so a run of three identical lines keeps one.
fn _dup_dedupable(buf as *u8, i as i32) as i32 {
    if (is_lazy(i) == 1) {
        let is *apl.ParsedLine as r = apl.pl_get(cast(*apl.ParsedLines, ph_lines), i);
        return cast(i32, r.kind == apl.LINE_INST
            && (cast(i32, r.inst_id) == adef.INST_MOV || cast(i32, r.inst_id) == adef.INST_MOVSXD));
    }
    let is i32 as len = get_len(i);
    if (len < 6 || len >= 128) { return 0; }
    let is i64 as off = get_off(i);
    if (is_repl(i) == 1) { return 0; }
    if (buf[off] != 32 || buf[off + 1] != 32) { return 0; }
    if (buf[off + 2] != 109 || buf[off + 3] != 111 || buf[off + 4] != 118) { return 0; }
    if (buf[off + 5] == 32) { return 1; }
    if (len >= 10 && buf[off + 5] == 115 && buf[off + 6] == 120 && buf[off + 7] == 100
        && buf[off + 8] == 32) { return 1; }
    return 0;
}

// Any memory operand. A store is not idempotent for a device register (Caustic
// has no volatile; MMIO is plain loads and stores), and without .loc lines
// between statements two identical stores from different statements would
// meet here. A load: not idempotent when its
// destination is part of its address (`mov rbx, QWORD PTR [rbx]`), and the
// emission-time pass this replaces never saw loads at all: they end through
// out_str("]\n"), which reset it. Asked only of a line that already matched
// its predecessor, so ordinary lines are not scanned twice.
fn _dup_is_load(buf as *u8, i as i32) as i32 {
    if (is_lazy(i) == 1) {
        let is *apl.ParsedLine as r = apl.pl_get(cast(*apl.ParsedLines, ph_lines), i);
        return cast(i32, _is_memk(cast(i32, r.op1_kind)) == 1 || _is_memk(cast(i32, r.op2_kind)) == 1);
    }
    let is i32 as len = get_len(i);
    let is i64 as off = get_off(i);
    let is i32 as k with mut = 5;
    let is i32 as comma with mut = 0;
    while (k < len) {
        let is u8 as c = buf[off + cast(i64, k)];
        if (c == 44) { comma = 1; }
        else if (c == 91) { return 1; }
        k = k + 1;
    }
    return 0;
}

fn _dup_same(buf as *u8, a as i32, b as i32) as i32 {
    if (is_lazy(a) == 1 || is_lazy(b) == 1) {
        let is *apl.ParsedLines as ls = cast(*apl.ParsedLines, ph_lines);
        let is *apl.ParsedLine as ra = apl.pl_get(ls, a);
        let is *apl.ParsedLine as rb = apl.pl_get(ls, b);
        if (ra.kind != apl.LINE_INST || rb.kind != apl.LINE_INST || ra.inst_id != rb.inst_id) { return 0; }
        return cast(i32, _op_same(ra, 1, rb, 1) == 1 && _op_same(ra, 2, rb, 2) == 1);
    }
    let is i32 as la = get_len(a);
    if (la != get_len(b)) { return 0; }
    let is i64 as oa = get_off(a);
    let is i64 as ob = get_off(b);
    let is i32 as i with mut = 0;
    while (i < la) {
        if (buf[oa + cast(i64, i)] != buf[ob + cast(i64, i)]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn dedup_mov_lines(buf as *u8) as void {
    let is i32 as last with mut = 0 - 1;
    let is i32 as i with mut = 0;
    while (i < line_count) {
        let is *i32 as lenp = cast(*i32, cast(i64, line_lens) + cast(i64, i) * 4);
        if (*lenp >= 0) {
            if (line_hand[i] != cast(u8, 0) || _dup_dedupable(buf, i) == 0) {
                last = 0 - 1;
            } else if (last >= 0 && _dup_same(buf, last, i) == 1 && _dup_is_load(buf, i) == 0) {
                set_len(i, 0 - 1);
                stat_removed = stat_removed + 1;
            } else {
                // Includes an identical load: kept, and it is the line the
                // next one is compared with (a third copy is a load too).
                last = i;
            }
        }
        i = i + 1;
    }
}

fn optimize_asm_buf(buf as *u8, size as i64, out_len as *i64) as *u8 {
    *out_len = size;
    if (size <= 0) { return buf; }

    let is i64 as max_lines = size / 4 + 1024;
    let is i64 as tbl_size = max_lines * 14 + 131072;
    let is *u8 as tbl = mem.core.mmap_anon(tbl_size);
    if (cast(i64, tbl) <= 0) { return buf; }

    line_offs = tbl;
    line_lens = cast(*u8, cast(i64, tbl) + max_lines * 8);
    line_hand = cast(*u8, cast(i64, tbl) + max_lines * 12);
    line_flag = cast(*u8, cast(i64, tbl) + max_lines * 13);    // mmap: zeroed
    line_count = 0;
    repl_buf = cast(*u8, cast(i64, tbl) + max_lines * 14);
    repl_len = 0;
    repl_cap = 131072;
    stat_removed = 0;
    stat_fused = 0;

    let is i64 as pos with mut = 0;
    let is i32 as in_hand with mut = 0;
    while (pos < size) {
        if (cast(i64, line_count) >= max_lines) { mem.core.munmap(tbl, tbl_size); return buf; }
        let is i64 as start = pos;
        while (pos < size && buf[pos] != 10) { pos = pos + 1; }
        set_off(line_count, cast(i64, buf) + start);
        let is i32 as llen with mut = cast(i32, pos - start);
        if (llen > 0 && buf[start + cast(i64, llen) - 1] == 13) { llen = llen - 1; }
        set_len(line_count, llen);
        // Everything from #APP to #NO_APP is the author's, markers included.
        if (in_hand == 0 && _is_marker(buf, start, llen, "#APP") == 1) { in_hand = 1; }
        line_hand[line_count] = cast(u8, in_hand);
        if (in_hand == 1 && _is_marker(buf, start, llen, "#NO_APP") == 1) { in_hand = 0; }
        line_count = line_count + 1;
        if (pos < size) { pos = pos + 1; }
    }

    // From here on, line addresses are absolute: the helpers get a null base.
    let is *u8 as tb = cast(*u8, 0);
    dedup_mov_lines(tb);

    let is i32 as changed with mut = 1;
    let is i32 as pass with mut = 0;
    while (changed == 1 && pass < 2) {
        changed = 0;
        let is i32 as i with mut = 0;
        while (i < line_count - 1) {
            if (alive(i) == 1 && alive(i + 1) == 1 && is_repl(i) == 0 && is_repl(i + 1) == 0
                && hand_written(i) == 0 && hand_written(i + 1) == 0) {
                // 8.3: pre-filter — only mov/movsxd start with 'm' (109)
                let is i64 as pf_off = get_off(i);
                let is i32 as pf_len = get_len(i);
                let is i32 as pf_ws = skip_ws(tb, pf_off, pf_len);
                if (pf_ws < pf_len && tb[pf_off + cast(i64, pf_ws)] == 109) {
                    // Parse line i's mnemonic once and dispatch. Trying the
                    // five `mov` patterns on every `m*` line (movzx, movsx,
                    // movsxd, mul, ...) only ever failed their first check.
                    let is i32 as movp = match_inst(tb, pf_off, pf_len, "mov", 3);
                    if (movp != 99999) {
                        if (try_pat1(tb, i, movp) == 1) { changed = 1; }
                        if (alive(i) == 1 && try_pat2(tb, i, movp) == 1) { changed = 1; }
                        if (alive(i) == 1 && is_repl(i + 1) == 0 && try_pat3(tb, i, movp) == 1) { changed = 1; }
                        if (alive(i) == 1 && is_repl(i + 1) == 0 && try_pat5(tb, i, movp) == 1) { changed = 1; }
                        if (alive(i) == 1 && try_pat6(tb, i) == 1) { changed = 1; }
                    } else if (match_inst(tb, pf_off, pf_len, "movsd", 5) != 99999) {
                        // Only pattern 6 handles a `movsd` first line.
                        if (try_pat6(tb, i) == 1) { changed = 1; }
                    }
                } else if (pf_ws < pf_len && tb[pf_off + cast(i64, pf_ws)] == 106) {
                    // 'j' — unconditional jump-to-next removal
                    if (try_jmp_next(tb, i) == 1) { changed = 1; }
                }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }

    // 8.2: early exit — if no patterns matched, file is already correct
    if (stat_removed == 0 && stat_fused == 0) { mem.core.munmap(tbl, tbl_size); return buf; }

    // 8.1: buffered write — compute total, write once
    let is i64 as out_total with mut = 0;
    let is i32 as li with mut = 0;
    while (li < line_count) {
        let is i32 as llen = get_len(li);
        if (llen >= 0) { out_total = out_total + cast(i64, llen) + 1; }
        li = li + 1;
    }
    let is *u8 as out_buf = mem.core.mmap_anon(out_total + 4096);
    if (cast(i64, out_buf) <= 0) { mem.core.munmap(tbl, tbl_size); return buf; }
    let is i64 as out_pos with mut = 0;
    li = 0;
    while (li < line_count) {
        let is i32 as llen = get_len(li);
        if (llen >= 0) {
            let is i64 as loff = get_off(li);
            let is *u8 as lptr with mut = cast(*u8, 0);
            lptr = cast(*u8, loff);
            ph_memcpy(cast(*u8, cast(i64, out_buf) + out_pos), lptr, cast(i64, llen));
            out_pos = out_pos + cast(i64, llen);
            out_buf[out_pos] = 10;
            out_pos = out_pos + 1;
        }
        li = li + 1;
    }
    mem.core.munmap(tbl, tbl_size);
    *out_len = out_pos;
    return out_buf;
}

// ── The same peephole over the assembler's records ──────────────────
//
// The compiler's in-memory pipeline no longer rewrites the assembly text: the
// assembler parses codegen's buffer once, and this runs on the parsed records
// (assemble_buf's line_hook) before pass1. Decisions are still the text
// patterns above, applied to the original source lines (the records carry
// their spans), so what is removed or rewritten is exactly what the text pass
// does; the records only spare the work around them:
//   - the line table comes from the spans (no scan of the buffer),
//   - a pattern is tried only when the records show its shape (opcodes and
//     operand kinds every match requires),
//   - a removed line becomes LINE_EMPTY and a rewritten one is re-parsed from
//     the replacement text into its record, so no new buffer is written and
//     nothing is parsed twice.
// --emit-asm still runs optimize_asm_buf (the .s must be the optimized text),
// and CAUSTIC_TEXT_PEEPHOLE=1 forces it everywhere: the reference this path is
// compared against.

fn _rk(r as *apl.ParsedLine, which as i32) as i32 {
    if (which == 1) { return cast(i32, r.op1_kind); }
    return cast(i32, r.op2_kind);
}

fn _rr(r as *apl.ParsedLine, which as i32) as i32 {
    if (which == 1) { return cast(i32, r.op1_reg_id); }
    return cast(i32, r.op2_reg_id);
}

fn _is_memk(k as i32) as i32 { return cast(i32, k == adef.OP_MEM || k == adef.OP_RIP_LABEL); }

let is i32 as _pchk with mut = 0 - 1;

// ── Patterns 1-3 on the records ──
// The same decisions as try_pat1/2/3, from the registers' names (so the text
// predicates, quirks included, apply unchanged); a rewrite goes into the record
// and the line is marked rewritten (LF_REPL, so no later pattern takes it, as
// with a rewritten text) and LF_LAZY (any later read prints the new record).
// The replacement buffer is charged what the text rewrite would have used.

fn _rn(id as i32) as *u8 { return aprint.reg_name(id); }

fn _rn_len(id as i32) as i32 {
    let is *u8 as p = aprint.reg_name(id);
    if (cast(i64, p) == 0) { return 0; }
    return ph_strlen(p);
}

fn _charge(n as i64) as i32 {
    if (n >= 128 || repl_len + n > repl_cap) { return 0; }
    repl_len = repl_len + n;
    return 1;
}

fn _rec_rewritten(i as i32) as void {
    line_flag[i] = cast(u8, cast(i32, line_flag[i]) | LF_REPL | LF_LAZY | LF_RECMOD);
}

fn _r64(id as i32) as i32 {
    let is *u8 as nm = _rn(id);
    if (cast(i64, nm) == 0) { return 0; }
    return is_reg64(nm, ph_strlen(nm));
}

// The 32-bit id reg64_to_32 names, or -1.
fn _r32(id as i32) as i32 {
    let is *u8 as nm = _rn(id);
    if (cast(i64, nm) == 0) { return 0 - 1; }
    let is *u8 as e = reg64_to_32(nm, ph_strlen(nm));
    if (cast(i64, e) == 0) { return 0 - 1; }
    return id + 16;
}

// mov rA, rB ; movsxd rA, rAd  ->  movsxd rA, rBd
fn rec_pat1(lines as *apl.ParsedLines, i as i32) as i32 {
    let is *apl.ParsedLine as a = apl.pl_get(lines, i);
    let is *apl.ParsedLine as b = apl.pl_get(lines, i + 1);
    let is i32 as ra = cast(i32, a.op1_reg_id);
    let is i32 as rb = cast(i32, a.op2_reg_id);
    if (_r64(ra) == 0 || _r64(rb) == 0) { return 0; }
    if (cast(i32, b.op1_kind) != adef.OP_REG || cast(i32, b.op1_reg_id) != ra) { return 0; }
    let is i32 as e32 = _r32(ra);
    if (e32 < 0 || cast(i32, b.op2_kind) != adef.OP_REG || cast(i32, b.op2_reg_id) != e32) { return 0; }
    let is i32 as rbd = _r32(rb);
    if (rbd < 0) { return 0; }
    if (_charge(2 + 7 + _rn_len(ra) + 2 + _rn_len(rbd)) == 0) { return 0; }
    apl.set_op_reg(b, 2, rbd);
    set_len(i, cast(i32, 0 - 1));
    _rec_rewritten(i + 1);
    stat_fused = stat_fused + 1;
    return 1;
}

// mov rA, rB ; mov rC, rA  ->  mov rA, rB ; mov rC, rB  (or drop the second if rC is rB)
fn rec_pat2(lines as *apl.ParsedLines, i as i32) as i32 {
    let is *apl.ParsedLine as a = apl.pl_get(lines, i);
    let is *apl.ParsedLine as b = apl.pl_get(lines, i + 1);
    let is i32 as ra = cast(i32, a.op1_reg_id);
    let is i32 as rs = cast(i32, a.op2_reg_id);
    let is i32 as rc = cast(i32, b.op1_reg_id);
    if (_r64(ra) == 0 || _r64(rs) == 0 || ra == rs) { return 0; }
    if (_r64(rc) == 0 || cast(i32, b.op2_reg_id) != ra || ra == rc) { return 0; }
    if (rc == rs) {
        set_len(i + 1, cast(i32, 0 - 1));
        stat_removed = stat_removed + 1;
        return 1;
    }
    if (_charge(2 + 4 + _rn_len(rc) + 2 + _rn_len(rs)) == 0) { return 0; }
    apl.set_op_reg(b, 2, rs);
    _rec_rewritten(i + 1);
    stat_fused = stat_fused + 1;
    return 1;
}

let is [160]u8 as _p3buf with mut;

// mov rA, X ; mov rA, Y (Y does not name rA or rAd)  ->  mov rA, Y
fn rec_pat3(lines as *apl.ParsedLines, i as i32) as i32 {
    let is *apl.ParsedLine as a = apl.pl_get(lines, i);
    let is *apl.ParsedLine as b = apl.pl_get(lines, i + 1);
    let is i32 as rd = cast(i32, a.op1_reg_id);
    if (_r64(rd) == 0) { return 0; }
    let is i32 as n = aprint._operand(b, 2, cast(*u8, &_p3buf), 0, cast(i32, b.inst_id));
    if (n < 0) { return try_pat3(cast(*u8, 0), i, _movp(i)); }      // not printable: the text decides
    let is *u8 as d1 = _rn(rd);
    let is i32 as d1l = ph_strlen(d1);
    if (str_contains(cast(*u8, &_p3buf), n, d1, d1l) == 1) { return 0; }
    let is *u8 as d32 = reg64_to_32(d1, d1l);
    if (cast(i64, d32) != 0 && str_contains(cast(*u8, &_p3buf), n, d32, ph_strlen(d32)) == 1) { return 0; }
    set_len(i, cast(i32, 0 - 1));
    stat_removed = stat_removed + 1;
    return 1;
}

fn _movp(i as i32) as i32 { return match_inst(cast(*u8, 0), get_off(i), get_len(i), "mov", 3); }

// Operand `which` of r is memory with base or index `reg` (a 64-bit id).
fn _uses_reg(r as *apl.ParsedLine, which as i32, reg as i32) as i32 {
    if (which == 1) { return cast(i32, cast(i32, r.op1_mem_base) == reg || cast(i32, r.op1_mem_index) == reg); }
    return cast(i32, cast(i32, r.op2_mem_base) == reg || cast(i32, r.op2_mem_index) == reg);
}

fn _lbl_same(a as *u8, al as i32, b as *u8, bl as i32) as i32 {
    if (al != bl) { return 0; }
    let is i32 as k with mut = 0;
    while (k < al) { if (a[k] != b[k]) { return 0; } k = k + 1; }
    return 1;
}

// Operand x of a equals operand y of b, field by field (what printing them equal means).
fn _op_same(a as *apl.ParsedLine, x as i32, b as *apl.ParsedLine, y as i32) as i32 {
    let is i32 as ka with mut = cast(i32, a.op1_kind);
    let is i32 as kb with mut = cast(i32, b.op1_kind);
    if (x == 2) { ka = cast(i32, a.op2_kind); }
    if (y == 2) { kb = cast(i32, b.op2_kind); }
    if (ka != kb) { return 0; }
    if (ka == adef.OP_NONE) { return 1; }
    if (ka == adef.OP_REG) { return cast(i32, _rr(a, x) == _rr(b, y)); }
    if (ka == adef.OP_MEM) {
        if (x == 1 && y == 1) { return cast(i32, a.op1_mem_base == b.op1_mem_base && a.op1_mem_index == b.op1_mem_index && a.op1_mem_scale == b.op1_mem_scale && a.op1_mem_disp == b.op1_mem_disp && a.op1_mem_size == b.op1_mem_size && a.op1_mem_seg == b.op1_mem_seg && a.op1_label_len == 0 && b.op1_label_len == 0); }
        if (x == 1 && y == 2) { return cast(i32, a.op1_mem_base == b.op2_mem_base && a.op1_mem_index == b.op2_mem_index && a.op1_mem_scale == b.op2_mem_scale && a.op1_mem_disp == b.op2_mem_disp && a.op1_mem_size == b.op2_mem_size && a.op1_mem_seg == b.op2_mem_seg && a.op1_label_len == 0 && b.op2_label_len == 0); }
        if (x == 2 && y == 1) { return _op_same(b, 1, a, 2); }
        return cast(i32, a.op2_mem_base == b.op2_mem_base && a.op2_mem_index == b.op2_mem_index && a.op2_mem_scale == b.op2_mem_scale && a.op2_mem_disp == b.op2_mem_disp && a.op2_mem_size == b.op2_mem_size && a.op2_mem_seg == b.op2_mem_seg && a.op2_label_len == 0 && b.op2_label_len == 0);
    }
    if (ka == adef.OP_IMM) {
        let is i64 as va with mut = a.op1_imm;
        let is i64 as vb with mut = b.op1_imm;
        if (x == 2) { va = a.op2_imm; }
        if (y == 2) { vb = b.op2_imm; }
        return cast(i32, va == vb);
    }
    if (ka == adef.OP_LABEL) {
        let is *u8 as pa with mut = a.op1_label_ptr;
        let is *u8 as pb with mut = b.op1_label_ptr;
        let is i32 as na with mut = cast(i32, a.op1_label_len);
        let is i32 as nb with mut = cast(i32, b.op1_label_len);
        if (x == 2) { pa = a.op2_label_ptr; na = cast(i32, a.op2_label_len); }
        if (y == 2) { pb = b.op2_label_ptr; nb = cast(i32, b.op2_label_len); }
        if (na != nb) { return 0; }
        let is i32 as k with mut = 0;
        while (k < na) { if (pa[k] != pb[k]) { return 0; } k = k + 1; }
        return 1;
    }
    return 0;      // rip operands: never a hint's, so never equal to one
}

// Line i is `mov [M], rA`; the next live line (past .loc) is `mov rA, [M]`.
fn _reload_next(lines as *apl.ParsedLines, i as i32) as i32 {
    let is i32 as k with mut = i + 1;
    while (k < line_count) {
        let is *apl.ParsedLine as x = apl.pl_get(lines, k);
        let is i32 as is_loc = cast(i32, x.kind == apl.LINE_DIRECTIVE && cast(i32, x.dir_kind) == apl.DIR_LOC);
        if (alive(k) == 1 && is_loc == 0) {
            if (x.kind != apl.LINE_INST || cast(i32, x.inst_id) != adef.INST_MOV) { return 0; }
            let is *apl.ParsedLine as a = apl.pl_get(lines, i);
            if (_op_same(a, 2, x, 1) == 0) { return 0; }
            if (cast(i32, x.op2_kind) != adef.OP_MEM) { return 1; }   // labels: the text decides
            return _op_same(a, 1, x, 2);
        }
        k = k + 1;
    }
    return 0;
}

fn _is_row(x as *apl.ParsedLine) as i32 {
    return cast(i32, x.kind == apl.LINE_DIRECTIVE
        && (cast(i32, x.dir_kind) == apl.DIR_LOC || cast(i32, x.dir_kind) == apl.DIR_FILE));
}

fn optimize_records(lp as *u8, src as *u8) as void {
    let is *apl.ParsedLines as lines = cast(*apl.ParsedLines, lp);
    let is i32 as n with mut = lines.count;
    if (n <= 0) { return; }
    // Line rows (.loc, .file) step aside for the patterns, which match adjacent
    // lines, and come back ahead of the line they preceded: without -g, asking
    // for them does not change the code. (-g keeps its statements apart.)
    let is i32 as nrow with mut = 0;
    if (tgt.debug_get() == 0 && tgt.lines_wanted() == 1) {
        let is i32 as q with mut = 0;
        while (q < n) { nrow = nrow + _is_row(apl.pl_get(lines, q)); q = q + 1; }
    }
    let is i64 as rows_off = cast(i64, n) * 14 + 131072 + 4096;
    let is i64 as tbl_size = rows_off + cast(i64, nrow) * (sizeof(apl.ParsedLine) + 4);
    let is *u8 as tbl = mem.core.mmap_anon(tbl_size);
    if (cast(i64, tbl) <= 0) { return; }
    let is *apl.ParsedLine as rows = cast(*apl.ParsedLine, cast(i64, tbl) + rows_off);
    let is *i32 as row_at = cast(*i32, cast(i64, rows) + cast(i64, nrow) * sizeof(apl.ParsedLine));
    if (nrow > 0) {
        let is i32 as q with mut = 0;
        let is i32 as kept with mut = 0;
        let is i32 as taken with mut = 0;
        while (q < n) {
            let is *apl.ParsedLine as x = apl.pl_get(lines, q);
            if (_is_row(x) == 1) { rows[taken] = *x; row_at[taken] = kept; taken = taken + 1; }
            else {
                if (kept != q) {
                    *apl.pl_get(lines, kept) = *x;
                    apar.span_off[kept] = apar.span_off[q];
                    apar.span_len[kept] = apar.span_len[q];
                    apar.span_flag[kept] = apar.span_flag[q];
                }
                kept = kept + 1;
            }
            q = q + 1;
        }
        n = kept;
    }
    line_offs = tbl;
    line_lens = cast(*u8, cast(i64, tbl) + cast(i64, n) * 8);
    line_hand = cast(*u8, cast(i64, tbl) + cast(i64, n) * 12);
    line_flag = cast(*u8, cast(i64, tbl) + cast(i64, n) * 13);
    repl_buf = cast(*u8, cast(i64, tbl) + cast(i64, n) * 14);
    ph_lines = lp;
    rend_buf = cast(*u8, 0); rend_len = 0; rend_cap = 0; stat_rendered = 0;
    repl_len = 0;
    repl_cap = 131072;
    stat_removed = 0;
    stat_fused = 0;
    line_count = n;
    let is i32 as r with mut = 0;
    while (r < n) {
        let is i32 as sf = cast(i32, apar.span_flag[r]);
        set_off(r, cast(i64, src) + cast(i64, apar.span_off[r]));
        set_len(r, apar.span_len[r]);
        line_hand[r] = cast(u8, sf & apar.SPAN_HAND);
        line_flag[r] = cast(u8, 0);
        // a record hint written without its text: printed when a pattern reads it
        if ((sf & apar.SPAN_HINT) != 0 && apar.span_len[r] == 0) { line_flag[r] = cast(u8, LF_LAZY); }
        r = r + 1;
    }
    let is *u8 as tb = cast(*u8, 0);

    if (_pchk < 0) {
        _pchk = 0;
        let is *u8 as pv = _pchk_env.getenv("CAUSTIC_PRINT_CHECK");
        if (cast(i64, pv) != 0 && pv[0] == 49) { _pchk = 1; }
    }
    if (_pchk == 1) {
        r = 0;
        while (r < n) {
            if (is_lazy(r) == 0 && get_len(r) > 0 && hand_written(r) == 0) {
                let is *apl.ParsedLine as cur = apl.pl_get(lines, r);
                let is *apl.ParsedLine as nx with mut = cast(*apl.ParsedLine, 0);
                if (r + 1 < n && get_off(r + 1) == get_off(r)) { nx = apl.pl_get(lines, r + 1); }
                aprint.check_line(cur, nx, tb, get_off(r), get_len(r));
                if (cast(i64, nx) != 0 && aprint.is_prefix(cur) == 1) { r = r + 1; }
            }
            r = r + 1;
        }
        aprint.check_report();
    }

    dedup_mov_lines(tb);

    let is i32 as changed with mut = 1;
    let is i32 as pass with mut = 0;
    while (changed == 1 && pass < 2) {
        changed = 0;
        let is i32 as i with mut = 0;
        while (i < line_count - 1) {
            if (alive(i) == 1 && alive(i + 1) == 1 && is_repl(i) == 0 && is_repl(i + 1) == 0
                && hand_written(i) == 0 && hand_written(i + 1) == 0) {
                let is *apl.ParsedLine as a = apl.pl_get(lines, i);
                if (a.kind == apl.LINE_INST) {
                    let is i32 as id = cast(i32, a.inst_id);
                    if (id == adef.INST_MOV) {
                        // Shapes from the records first; a line's text (printed, for
                        // a hint without it) is read only when a pattern may apply.
                        let is *apl.ParsedLine as b = apl.pl_get(lines, i + 1);
                        let is i32 as binst with mut = 0 - 1;
                        if (b.kind == apl.LINE_INST) { binst = cast(i32, b.inst_id); }
                        let is i32 as rr = cast(i32, _rk(a, 1) == adef.OP_REG && _rk(a, 2) == adef.OP_REG);
                        if (rr == 1 && binst == adef.INST_MOVSXD && _rk(b, 1) == adef.OP_REG && _rr(b, 1) == _rr(a, 1)) {
                            if (rec_pat1(lines, i) == 1) { changed = 1; }
                        }
                        if (alive(i) == 1 && rr == 1 && binst == adef.INST_MOV && _rk(b, 1) == adef.OP_REG
                            && _rk(b, 2) == adef.OP_REG && _rr(b, 2) == _rr(a, 1)) {
                            if (rec_pat2(lines, i) == 1) { changed = 1; }
                        }
                        if (alive(i) == 1 && is_repl(i + 1) == 0 && _rk(a, 1) == adef.OP_REG
                            && binst == adef.INST_MOV && _rk(b, 1) == adef.OP_REG && _rr(b, 1) == _rr(a, 1)) {
                            if (rec_pat3(lines, i) == 1) { changed = 1; }
                        }
                        if (alive(i) == 1 && is_repl(i + 1) == 0 && rr == 1
                            && (binst == adef.INST_MOV || binst == adef.INST_MOVZX || binst == adef.INST_MOVSX
                                || binst == adef.INST_MOVSXD || binst == adef.INST_LEA)
                            && _is_memk(_rk(b, 2)) == 1 && _uses_reg(b, 2, _rr(a, 1)) == 1) {
                            if (try_pat5(tb, i, _movp(i)) == 1) { changed = 1; }
                        }
                        if (alive(i) == 1 && _is_memk(_rk(a, 1)) == 1 && a.op1_mem_size == 64 && _rk(a, 2) == adef.OP_REG
                            && _reload_next(lines, i) == 1) {
                            if (try_pat6(tb, i) == 1) { changed = 1; }
                        }
                    } else if (id == adef.INST_MOVSD) {
                        if (_is_memk(_rk(a, 1)) == 1 && a.op1_mem_size == 64 && _rk(a, 2) == adef.OP_REG) {
                            if (match_inst(tb, get_off(i), get_len(i), "movsd", 5) != 99999 && try_pat6(tb, i) == 1) { changed = 1; }
                        }
                    } else if (id == adef.INST_JMP) {
                        if (try_jmp_next(tb, i) == 1) { changed = 1; }
                    }
                }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }

    // Apply: removed lines leave, rewritten ones take their new text's parse.
    r = 0;
    while (r < n) {
        let is *apl.ParsedLine as x = apl.pl_get(lines, r);
        if (alive(r) == 0) { x.kind = apl.LINE_EMPTY; }
        else if (is_repl(r) == 1 && (cast(i32, line_flag[r]) & LF_RECMOD) == 0) {
            let is *u8 as t = cast(*u8, get_off(r));
            if (apar.reparse_into(lines, r, t, cast(i64, get_len(r))) == 0) {
                io.write_str(io.STDERR, "internal error: peephole rewrote a line the assembler cannot read back\n");
            }
        }
        r = r + 1;
    }
    // Compact: drop LINE_EMPTY (removed lines and the parser's placeholders).
    let is i32 as w with mut = 0;
    let is i32 as t with mut = 0;
    r = 0;
    while (r < n) {
        while (t < nrow && row_at[t] <= r) { row_at[t] = w; t = t + 1; }
        let is *apl.ParsedLine as y = apl.pl_get(lines, r);
        if (y.kind != apl.LINE_EMPTY) {
            if (w != r) { *apl.pl_get(lines, w) = *y; }
            w = w + 1;
        }
        r = r + 1;
    }
    while (t < nrow) { row_at[t] = w; t = t + 1; }
    lines.count = w + nrow;
    // Merge the rows back, from the end.
    while (t > 0) {
        while (w > row_at[t - 1]) { w = w - 1; *apl.pl_get(lines, w + t) = *apl.pl_get(lines, w); }
        t = t - 1;
        *apl.pl_get(lines, w + t) = rows[t];
    }
    mem.core.munmap(tbl, tbl_size);
}
