use "../../std/mem.cst" as mem;
use "../ir/defs.cst" as d;

// === Config ===
let is i32 as al_opt_level with mut = 0;

// === Register allocator structs ===

struct LiveInterval {
    vreg as i32;
    start as i32;
    end_pos as i32;
    reg as i32;
    spill_loc as i32;
    use_count as i32;
    spill_cost as i32;
    // 0 = VR_GPR (allocate to GPR pool 0-15)
    // 1 = VR_XMM (allocate to XMM pool, encoded as phys reg idx 16-31)
    reg_class as i32;
}

struct AllocCtx {
    intervals as *LiveInterval;
    count as i32;
    vreg_to_loc as *i32;
    stack_slots as i32;
    next_spill as i32;
    is_leaf as i32;
    arg_spill_base as i32;
    aligned_stack_size as i32;
    func as *u8;
    va_save_offset as i32;
    call_positions as *i32;
    call_count as i32;
    active_idx as *i32;
    used_callee_mask as i32;
    sw_frameless as i32;      // shrink-wrap: the current return has no frame
}

let is i32 as INT_MAX with imut = 2147483647;

fn memzero(p as *u8, n as i64) as void {
    let is i64 as words = n / 8;
    let is *i64 as wp = cast(*i64, p);
    let is i64 as i with mut = 0;
    while (i < words) {
        let is *i64 as dst = cast(*i64, cast(i64, wp) + i * 8);
        *dst = 0;
        i = i + 1;
    }
    i = words * 8;
    while (i < n) { p[i] = cast(u8, 0); i = i + 1; }
}

fn new_alloc_ctx() as *AllocCtx {
    let is *AllocCtx as c = cast(*AllocCtx, d.opt_alloc(sizeof(AllocCtx)));
    memzero(cast(*u8, c), sizeof(AllocCtx));
    return c;
}

// Release a function's register-allocation context. Everything it owns
// (intervals, the vreg->location map, call positions, the active set) is
// scratch that is dead once the function has been emitted. Freeing it per
// function keeps codegen from accumulating one ctx per function (a large RSS
// leak on big programs — ctx.intervals alone is vreg_count * sizeof(LiveInterval)).
fn free_alloc_ctx(ctx as *AllocCtx) as void {
    if (cast(i64, ctx) == 0) { return; }
    if (cast(i64, ctx.intervals) != 0)      { d.opt_free(cast(*u8, ctx.intervals)); }
    if (cast(i64, ctx.vreg_to_loc) != 0)    { d.opt_free(cast(*u8, ctx.vreg_to_loc)); }
    if (cast(i64, ctx.call_positions) != 0) { d.opt_free(cast(*u8, ctx.call_positions)); }
    if (cast(i64, ctx.active_idx) != 0)     { d.opt_free(cast(*u8, ctx.active_idx)); }
    d.opt_free(cast(*u8, ctx));
}

// === build_intervals ===

// IR_COPY of a known size up to 64 bytes is emitted as moves through rax and
// xmm0 (emit_inst.cst); anything else as `rep movsb`, a clobber point.
fn copy_is_rep(inst as *d.IRInst) as i32 {
    if (inst.src2.op_type == d.OP_IMM && inst.src2.imm > 0 && inst.src2.imm <= 64) { return 0; }
    return 1;
}

// a + b, saturating at the i32 maximum (loop-weighted costs grow fast).
fn _ls_cost_add(a as i32, b as i32) as i32 {
    let is i64 as t = cast(i64, a) + cast(i64, b);
    if (t > 2147483647) { return 2147483647; }
    return cast(i32, t);
}

fn build_intervals(func as *d.IRFunction, ctx as *AllocCtx) as void {
    let is i32 as vc = func.vreg_count;
    ctx.intervals = cast(*LiveInterval, d.opt_alloc(cast(i64, vc) * sizeof(LiveInterval)));
    ctx.count = vc;
    let is i32 as i with mut = 0;
    while (i < vc) {
        let is *LiveInterval as iv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, i) * sizeof(LiveInterval));
        iv.vreg = i;
        iv.start = INT_MAX;
        iv.end_pos = cast(i32, 0 - 1);
        iv.reg = cast(i32, 0 - 1);
        iv.spill_loc = cast(i32, 0 - 1);
        iv.use_count = 0;
        iv.spill_cost = 0;
        iv.reg_class = d.vreg_class_get(func, i);
        i = i + 1;
    }
    // Map labels to positions + collect call positions
    let is i32 as lc = func.label_count + 1;
    let is *i32 as label_pos = cast(*i32, d.opt_alloc(cast(i64, lc) * 4));
    memzero(cast(*u8, label_pos), cast(i64, lc) * 4);
    // First pass: count calls
    let is i32 as n_calls with mut = 0;
    let is i32 as pos with mut = 0;
    let is *d.IRInst as inst with mut = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.op == d.IR_LABEL) {
            let is *i32 as lp = cast(*i32, cast(i64, label_pos) + cast(i64, inst.dest.label) * 4);
            *lp = pos;
        }
        if (inst.op == d.IR_CALL || inst.op == d.IR_CALL_INDIRECT || inst.op == d.IR_FFI_CALL || inst.op == d.IR_SYSCALL) {
            n_calls = n_calls + 1;
        }
        // ALL SET_ARG clobbers arg regs (rdi,rsi,rdx,rcx,r8,r9)
        if (inst.op == d.IR_SET_ARG) {
            n_calls = n_calls + 1;
        }
        if (inst.op == d.IR_SET_SYS_ARG) {
            n_calls = n_calls + 1;
        }
        // SET_CTX clobbers r10 (hardcoded ctx reg in codegen) — treat as a
        // clobber point so a value live across it isn't left in caller-saved r10.
        if (inst.op == d.IR_SET_CTX) {
            n_calls = n_calls + 1;
        }
        // A large IR_COPY lowers to `rep movsb`, which clobbers rdi, rsi and
        // rcx (movsb also advances rdi/rsi). A value live across the copy left
        // in one of those regs would be corrupted — treat it as a clobber point.
        if (inst.op == d.IR_COPY && copy_is_rep(inst) == 1) {
            n_calls = n_calls + 1;
        }
        pos = pos + 1;
        inst = inst.next;
    }
    // Loop depth per position (-O1 and up): every backward jump encloses
    // [target, jump] in one more loop. A use counts 10^depth (depth capped at
    // 4) toward its interval's spill cost, as in graph colouring, so the
    // value evicted under pressure is not the one a hot loop reads. -O0 keeps
    // the unweighted cost.
    let is *i32 as ls_depth with mut = cast(*i32, 0);
    if (al_opt_level >= 1) {
        ls_depth = cast(*i32, d.opt_alloc(cast(i64, pos + 2) * 4));
        memzero(cast(*u8, ls_depth), cast(i64, pos + 2) * 4);
        let is i32 as dp with mut = 0;
        let is *d.IRInst as dj with mut = func.instructions;
        while (cast(i64, dj) != 0) {
            if (dj.is_dead == 0 && (dj.op == d.IR_JMP || dj.op == d.IR_JZ || dj.op == d.IR_JNZ)) {
                let is i32 as tp = label_pos[dj.dest.label];
                if (tp <= dp) { ls_depth[tp] = ls_depth[tp] + 1; ls_depth[dp + 1] = ls_depth[dp + 1] - 1; }
            }
            dp = dp + 1;
            dj = dj.next;
        }
        let is i32 as run with mut = 0;
        dp = 0;
        while (dp <= pos) { run = run + ls_depth[dp]; ls_depth[dp] = run; dp = dp + 1; }
    }
    // Allocate call_positions; collection + interval scan fused below.
    let is i32 as ci with mut = 0;
    if (n_calls > 0) {
        ctx.call_positions = cast(*i32, d.opt_alloc(cast(i64, n_calls) * 4));
        ctx.call_count = n_calls;
    } else {
        ctx.call_positions = cast(*i32, 0);
        ctx.call_count = 0;
    }
    if (al_opt_level >= 2) { let is i32 as zk with mut = 0; while (zk < 512) { setarg_bits[zk] = cast(u8, 0); zk = zk + 1; } }
    // Fused pass: collect call positions + scan instructions for intervals.
    pos = 0;
    inst = func.instructions;
    while (cast(i64, inst) != 0) {
        // Call-position collection (mirrors pass 1's gates exactly so ci
        // tracks n_calls 1:1). Done even for dead insts to preserve prior
        // semantics where dead calls remained in call_positions. -O2 leaves
        // them out: a dead call is never emitted and clobbers nothing.
        if (al_opt_level < 2 || inst.is_dead == 0) {
            if (inst.op == d.IR_CALL || inst.op == d.IR_CALL_INDIRECT || inst.op == d.IR_FFI_CALL || inst.op == d.IR_SYSCALL) {
                let is *i32 as cp = cast(*i32, cast(i64, ctx.call_positions) + cast(i64, ci) * 4);
                *cp = pos;
                ci = ci + 1;
            }
            if (inst.op == d.IR_SET_ARG) {
                let is *i32 as cp = cast(*i32, cast(i64, ctx.call_positions) + cast(i64, ci) * 4);
                *cp = pos;
                ci = ci + 1;
                if (al_opt_level >= 2 && ci <= 4096) { _setarg_mark(ctx, ci - 1); }
            }
            if (inst.op == d.IR_SET_SYS_ARG) {
                let is *i32 as cp = cast(*i32, cast(i64, ctx.call_positions) + cast(i64, ci) * 4);
                *cp = pos;
                ci = ci + 1;
            }
            if (inst.op == d.IR_SET_CTX) {
                let is *i32 as cp = cast(*i32, cast(i64, ctx.call_positions) + cast(i64, ci) * 4);
                *cp = pos;
                ci = ci + 1;
            }
            if (inst.op == d.IR_COPY && copy_is_rep(inst) == 1) {
                let is *i32 as cp = cast(*i32, cast(i64, ctx.call_positions) + cast(i64, ci) * 4);
                *cp = pos;
                ci = ci + 1;
            }
        }
        if (inst.is_dead == 1) { inst = inst.next; pos = pos + 1; }
        else {
        let is i32 as lw with mut = 1;
        if (cast(i64, ls_depth) != 0) {
            let is i32 as dd with mut = ls_depth[pos];
            if (dd > 4) { dd = 4; }
            while (dd > 0) { lw = lw * 10; dd = dd - 1; }
        }
        if (inst.src1.op_type == d.OP_VREG) {
            let is i32 as v = inst.src1.vreg;
            let is *LiveInterval as iv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, v) * sizeof(LiveInterval));
            if (iv.start > pos) { iv.start = pos; }
            iv.end_pos = pos;
            iv.use_count = iv.use_count + 1;
            iv.spill_cost = _ls_cost_add(iv.spill_cost, 10 * lw);
        }
        if (inst.src2.op_type == d.OP_VREG) {
            let is i32 as v = inst.src2.vreg;
            let is *LiveInterval as iv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, v) * sizeof(LiveInterval));
            if (iv.start > pos) { iv.start = pos; }
            iv.end_pos = pos;
            iv.use_count = iv.use_count + 1;
            iv.spill_cost = _ls_cost_add(iv.spill_cost, 10 * lw);
        }
        if (inst.dest.op_type == d.OP_VREG) {
            let is i32 as v = inst.dest.vreg;
            let is *LiveInterval as iv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, v) * sizeof(LiveInterval));
            if (iv.start > pos) { iv.start = pos; }
            iv.end_pos = pos;
            iv.spill_cost = _ls_cost_add(iv.spill_cost, lw);
        }
        // Extend intervals for backward jumps (loops)
        if (inst.op == d.IR_JMP || inst.op == d.IR_JZ || inst.op == d.IR_JNZ) {
            let is *i32 as lp = cast(*i32, cast(i64, label_pos) + cast(i64, inst.dest.label) * 4);
            let is i32 as target_pos = *lp;
            if (target_pos <= pos) {
                let is i32 as v with mut = 0;
                while (v < vc) {
                    let is *LiveInterval as iv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, v) * sizeof(LiveInterval));
                    // Only extend vregs defined at/before loop header — they persist across iterations.
                    // Vregs defined inside the loop are redefined each iteration and don't need extension.
                    if (iv.start != INT_MAX && iv.start <= target_pos && iv.end_pos >= target_pos) {
                        if (iv.end_pos < pos) { iv.end_pos = pos; }
                    }
                    v = v + 1;
                }
            }
        }
        pos = pos + 1;
        inst = inst.next;
        }
    }
    if (al_opt_level >= 2) { ctx.call_count = ci; }
    // Compute spill costs
    i = 0;
    while (i < vc) {
        let is *LiveInterval as iv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, i) * sizeof(LiveInterval));
        if (iv.use_count > 0) {
            let is i32 as span = iv.end_pos - iv.start + 1;
            if (span > 0) {
                let is i64 as sc with mut = cast(i64, iv.spill_cost) * 100 / cast(i64, span);
                if (sc > 2147483647) { sc = 2147483647; }
                iv.spill_cost = cast(i32, sc);
            }
        }
        i = i + 1;
    }
    // Merge sort by start position
    if (vc > 1) {
        let is *LiveInterval as tmp = cast(*LiveInterval, d.opt_alloc(cast(i64, vc) * sizeof(LiveInterval)));
        merge_sort(ctx.intervals, tmp, 0, vc - 1);
        d.opt_free(cast(*u8, tmp));
    }
    d.opt_free(cast(*u8, label_pos));   // local scratch — last used in the scan above
    if (cast(i64, ls_depth) != 0) { d.opt_free(cast(*u8, ls_depth)); }
}

// Bottom-up merge sort: same comparator and same stable merge as the old
// recursive split, without 2*log2(n) levels of calls and the temp->arr copy
// after every level. Passes alternate between arr and tmp, so only an odd
// number of passes needs the final copy.
fn merge_sort(arr as *LiveInterval, tmp as *LiveInterval, lo as i32, hi as i32) as void {
    let is i32 as n = hi - lo + 1;
    if (n <= 1) { return; }
    let is *LiveInterval as src with mut = arr;
    let is *LiveInterval as dst with mut = tmp;
    let is i32 as width with mut = 1;
    let is i32 as passes with mut = 0;
    while (width < n) {
        let is i32 as base with mut = 0;
        while (base < n) {
            let is i32 as mid with mut = base + width;
            if (mid > n) { mid = n; }
            let is i32 as end with mut = base + width * 2;
            if (end > n) { end = n; }
            let is i32 as i with mut = base;
            let is i32 as j with mut = mid;
            let is i32 as k with mut = base;
            while (i < mid && j < end) {
                let is *LiveInterval as a = cast(*LiveInterval, cast(i64, src) + cast(i64, lo + i) * sizeof(LiveInterval));
                let is *LiveInterval as b = cast(*LiveInterval, cast(i64, src) + cast(i64, lo + j) * sizeof(LiveInterval));
                let is *LiveInterval as out = cast(*LiveInterval, cast(i64, dst) + cast(i64, lo + k) * sizeof(LiveInterval));
                // Stable: on equal (start, end) the left run wins, as before.
                if (a.start < b.start || (a.start == b.start && a.end_pos <= b.end_pos)) {
                    *out = *a;
                    i = i + 1;
                } else {
                    *out = *b;
                    j = j + 1;
                }
                k = k + 1;
            }
            while (i < mid) {
                let is *LiveInterval as a = cast(*LiveInterval, cast(i64, src) + cast(i64, lo + i) * sizeof(LiveInterval));
                let is *LiveInterval as out = cast(*LiveInterval, cast(i64, dst) + cast(i64, lo + k) * sizeof(LiveInterval));
                *out = *a;
                i = i + 1;
                k = k + 1;
            }
            while (j < end) {
                let is *LiveInterval as b = cast(*LiveInterval, cast(i64, src) + cast(i64, lo + j) * sizeof(LiveInterval));
                let is *LiveInterval as out = cast(*LiveInterval, cast(i64, dst) + cast(i64, lo + k) * sizeof(LiveInterval));
                *out = *b;
                j = j + 1;
                k = k + 1;
            }
            base = end;
        }
        let is *LiveInterval as t = src;
        src = dst;
        dst = t;
        passes = passes + 1;
        width = width * 2;
    }
    if ((passes & 1) == 1) {
        let is i32 as i with mut = 0;
        while (i < n) {
            let is *LiveInterval as from = cast(*LiveInterval, cast(i64, src) + cast(i64, lo + i) * sizeof(LiveInterval));
            let is *LiveInterval as to = cast(*LiveInterval, cast(i64, arr) + cast(i64, lo + i) * sizeof(LiveInterval));
            *to = *from;
            i = i + 1;
        }
    }
}

// Map physical register to active_idx slot (0-9)
fn reg_to_slot(reg as i32) as i32 {
    if (reg == 3) { return 0; }
    if (reg == 10) { return 1; }
    if (reg == 11) { return 2; }
    if (reg == 12) { return 3; }
    if (reg == 6) { return 4; }
    if (reg == 7) { return 5; }
    if (reg == 8) { return 6; }
    if (reg == 4) { return 7; }
    if (reg == 5) { return 8; }
    if (reg == 15) { return 9; }
    return cast(i32, 0 - 1);
}

// -O2: which clobber points are SET_ARGs (bit per call_positions index, first
// 4096). A SET_ARG reads its value and only then writes the argument register,
// so a value whose last use is that SET_ARG does not live across it.
let is [512]u8 as setarg_bits with mut;

fn _setarg_mark(ctx as *AllocCtx, i as i32) as void {
    setarg_bits[i >> 3] = cast(u8, cast(i32, setarg_bits[i >> 3]) | (1 << (i & 7)));
}

fn _is_setarg(ctx as *AllocCtx, i as i32) as i32 {
    if (i >= 4096) { return 0; }
    return (cast(i32, setarg_bits[i >> 3]) >> (i & 7)) & 1;
}

// -O2: does a value live across a clobber point? Not when the point defines it
// (a call's result: start == cp), and not when its last use is the SET_ARG at
// the point. Everything else as spans_call.
fn spans_call_strict(start as i32, end_pos as i32, ctx as *AllocCtx) as i32 {
    if (ctx.call_count == 0) { return 0; }
    let is i32 as k with mut = 0;
    // first clobber point > start
    let is i32 as lo with mut = 0;
    let is i32 as hi with mut = ctx.call_count - 1;
    let is i32 as result with mut = ctx.call_count;
    while (lo <= hi) {
        let is i32 as mid = lo + (hi - lo) / 2;
        let is *i32 as cp = cast(*i32, cast(i64, ctx.call_positions) + cast(i64, mid) * 4);
        if (*cp > start) { result = mid; hi = mid - 1; } else { lo = mid + 1; }
    }
    k = result;
    while (k < ctx.call_count) {
        let is i32 as p = *(cast(*i32, cast(i64, ctx.call_positions) + cast(i64, k) * 4));
        if (p > end_pos) { return 0; }
        if (p < end_pos) { return 1; }
        // p == end_pos
        if (_is_setarg(ctx, k) == 0) { return 1; }
        k = k + 1;
    }
    return 0;
}

// Check if interval [start, end] spans any call position (binary search)
fn spans_call(start as i32, end_pos as i32, ctx as *AllocCtx) as i32 {
    if (ctx.call_count == 0) { return 0; }
    let is i32 as lo with mut = 0;
    let is i32 as hi with mut = ctx.call_count - 1;
    let is i32 as result with mut = ctx.call_count;
    while (lo <= hi) {
        let is i32 as mid = lo + (hi - lo) / 2;
        let is *i32 as cp = cast(*i32, cast(i64, ctx.call_positions) + cast(i64, mid) * 4);
        if (*cp >= start) {
            result = mid;
            hi = mid - 1;
        } else {
            lo = mid + 1;
        }
    }
    if (result < ctx.call_count) {
        let is *i32 as cp = cast(*i32, cast(i64, ctx.call_positions) + cast(i64, result) * 4);
        if (*cp <= end_pos) { return 1; }
    }
    return 0;
}

// Is register a caller-saved? rsi(4), rdi(5), r8(6), r9(7), r10(8); all xmm.
fn is_caller_saved(reg as i32) as i32 {
    if (reg == 4 || reg == 5 || reg == 6 || reg == 7 || reg == 8) { return 1; }
    // xmm0..xmm15 are encoded as 16..31; SysV makes all of them caller-saved.
    if (reg >= 16 && reg <= 31) { return 1; }
    return 0;
}

// Map xmm physical reg idx (16-31) → slot in the xmm pool (0-15).
fn xmm_reg_to_slot(reg as i32) as i32 {
    if (reg >= 16 && reg <= 31) { return reg - 16; }
    return cast(i32, 0 - 1);
}

// Is this an XMM physical reg?
fn is_xmm_reg(reg as i32) as i32 {
    if (reg >= 16 && reg <= 31) { return 1; }
    return 0;
}

// === linear_scan_alloc ===
// Callee-saved regs for allocation: rbx(3), r12(10), r13(11), r14(12), r15(15)
// Caller-saved regs (only between calls): rsi(4), rdi(5), r8(6), r9(7), r10(8)

// -O0: ls_argpos[r] is the position of the GET_ARG that reads argument
// register r (-1 when none). An interval starting before it may not take r:
// a parameter's vreg written there would overwrite an argument still unread
// (with float arguments in xmm, an integer parameter's register is no longer
// the next one in line).
let is [16]i32 as ls_argpos with mut;

fn _ls_arg_blocked(reg as i32, pos as i32) as i32 {
    if (reg < 0 || reg >= 16) { return 0; }
    if (ls_argpos[reg] > pos) { return 1; }
    return 0;
}

fn _ls_init_argpos(func as *d.IRFunction) as void {
    let is i32 as i with mut = 0;
    while (i < 16) { ls_argpos[i] = cast(i32, 0 - 1); i = i + 1; }
    let is i32 as pos with mut = 0;
    let is *d.IRInst as inst with mut = func.instructions;
    while (cast(i64, inst) != 0) {
        if (inst.is_dead == 0 && inst.op == d.IR_GET_ARG) {
            let is i64 as code with mut = inst.src1.imm;
            if (inst.src2.op_type == d.OP_IMM) { code = inst.src2.imm; }
            let is i32 as r with mut = cast(i32, 0 - 1);
            if (code == 0) { r = 5; }
            if (code == 1) { r = 4; }
            if (code == 2) { r = 2; }
            if (code == 3) { r = 1; }
            if (code == 4) { r = 6; }
            if (code == 5) { r = 7; }
            if (r >= 0) { ls_argpos[r] = pos; }
        }
        pos = pos + 1;
        inst = inst.next;
    }
}

fn find_free_reg(ctx as *AllocCtx, pos as i32, iv_end as i32, hint as i32) as i32 {
    // Try hint register first (for coalescing MOVs)
    if (hint >= 0 && _ls_arg_blocked(hint, pos) == 0) {
        let is i32 as hs = reg_to_slot(hint);
        if (hs >= 0) {
            let is i32 as crosses_call = spans_call(pos, iv_end, ctx);
            if (crosses_call == 0 || is_caller_saved(hint) == 0) {
                let is *i32 as ap = cast(*i32, cast(i64, ctx.active_idx) + cast(i64, hs) * 4);
                let is i32 as ai = *ap;
                if (ai < 0) { return hint; }
                let is *LiveInterval as aiv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, ai) * sizeof(LiveInterval));
                if (aiv.end_pos < pos) {
                    *ap = cast(i32, 0 - 1);
                    return hint;
                }
            }
        }
    }
    let is [10]i32 as allowed;
    allowed[0] = 3;
    allowed[1] = 10;
    allowed[2] = 11;
    allowed[3] = 12;
    allowed[4] = 6;
    allowed[5] = 7;
    allowed[6] = 8;
    allowed[7] = 4;
    allowed[8] = 5;
    allowed[9] = 15;
    let is i32 as crosses_call = spans_call(pos, iv_end, ctx);
    let is i32 as ki with mut = 0;
    while (ki < 10) {
        let is i32 as ri = allowed[ki];
        if ((crosses_call == 1 && is_caller_saved(ri) == 1) || _ls_arg_blocked(ri, pos) == 1) {
            ki = ki + 1;
        } else {
            let is *i32 as ap = cast(*i32, cast(i64, ctx.active_idx) + cast(i64, ki) * 4);
            let is i32 as ai = *ap;
            if (ai < 0) { return ri; }
            let is *LiveInterval as aiv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, ai) * sizeof(LiveInterval));
            if (aiv.end_pos < pos) {
                *ap = cast(i32, 0 - 1);
                return ri;
            }
            ki = ki + 1;
        }
    }
    return cast(i32, 0 - 1);
}

fn spill_register(ctx as *AllocCtx, pos as i32, crosses_call as i32) as i32 {
    let is [10]i32 as allowed;
    allowed[0] = 3;
    allowed[1] = 10;
    allowed[2] = 11;
    allowed[3] = 12;
    allowed[4] = 6;
    allowed[5] = 7;
    allowed[6] = 8;
    allowed[7] = 4;
    allowed[8] = 5;
    allowed[9] = 15;
    let is i32 as victim_slot with mut = cast(i32, 0 - 1);
    let is i32 as min_cost with mut = INT_MAX;
    let is i32 as max_end with mut = cast(i32, 0 - 1);
    let is i32 as ki with mut = 0;
    while (ki < 10) {
        let is *i32 as ap = cast(*i32, cast(i64, ctx.active_idx) + cast(i64, ki) * 4);
        let is i32 as ai = *ap;
        if (ai >= 0) {
            if ((crosses_call == 1 && is_caller_saved(allowed[ki]) == 1) || _ls_arg_blocked(allowed[ki], pos) == 1) {
                ki = ki + 1;
            } else {
                let is *LiveInterval as aiv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, ai) * sizeof(LiveInterval));
                if (aiv.end_pos >= pos) {
                    if (aiv.spill_cost < min_cost || (aiv.spill_cost == min_cost && aiv.end_pos > max_end)) {
                        min_cost = aiv.spill_cost;
                        max_end = aiv.end_pos;
                        victim_slot = ki;
                    }
                }
                ki = ki + 1;
            }
        } else {
            ki = ki + 1;
        }
    }
    if (victim_slot >= 0) {
        let is *i32 as ap = cast(*i32, cast(i64, ctx.active_idx) + cast(i64, victim_slot) * 4);
        let is i32 as ai = *ap;
        let is *LiveInterval as viv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, ai) * sizeof(LiveInterval));
        let is i32 as v = viv.vreg;
        let is i32 as spill = ctx.next_spill;
        ctx.next_spill = ctx.next_spill + 1;
        let is *i32 as vp = cast(*i32, cast(i64, ctx.vreg_to_loc) + cast(i64, v) * 4);
        *vp = 0 - spill;
        viv.reg = cast(i32, 0 - 1);
        *ap = cast(i32, 0 - 1);
        return allowed[victim_slot];
    }
    return cast(i32, 0 - 1);
}

// An xmm (0..15) for a float interval, or -1 to spill it: the move partner's
// xmm when free, else the first free one of xmm2..xmm15. Every xmm is
// caller-saved, so a value live across a call goes to the stack. With none
// free, the active interval that is cheapest to spill (ties: the one ending
// last) gives up its xmm when it is cheaper than this one — the general-
// register rule of spill_register.
fn _ls_xmm_pick(ctx as *AllocCtx, iv as *LiveInterval, xact as *i32, gx as *i32, mov_partner as *i32) as i32 {
    if (spans_call(iv.start, iv.end_pos, ctx) == 1) { return cast(i32, 0 - 1); }
    let is [16]i32 as busy;
    let is i32 as k with mut = 0;
    while (k < 16) {
        busy[k] = 0;
        if (xact[k] >= 0) {
            let is *LiveInterval as a = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, xact[k]) * sizeof(LiveInterval));
            if (a.end_pos >= iv.start) { busy[k] = 1; } else { xact[k] = cast(i32, 0 - 1); }
        }
        k = k + 1;
    }
    busy[0] = 1;
    busy[1] = 1;
    let is i32 as own = gx[iv.vreg];
    if (own >= 0) {
        k = 2;
        while (k < 8) { if (k != own) { busy[k] = 1; } k = k + 1; }
    }
    let is i32 as partner = mov_partner[iv.vreg];
    if (partner >= 0) {
        let is i32 as pl = ctx.vreg_to_loc[partner];
        if (pl >= 18 && pl <= 31 && busy[pl - 16] == 0) { return pl - 16; }
    }
    k = 2;
    while (k < 16) {
        if (busy[k] == 0) { return k; }
        k = k + 1;
    }
    let is i32 as victim with mut = cast(i32, 0 - 1);
    let is i32 as vcost with mut = 2147483647;
    let is i32 as vend with mut = cast(i32, 0 - 1);
    k = 2;
    while (k < 16) {
        if (xact[k] >= 0 && (own < 0 || k >= 8 || k == own)) {
            let is *LiveInterval as a = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, xact[k]) * sizeof(LiveInterval));
            if (a.spill_cost < vcost || (a.spill_cost == vcost && a.end_pos > vend)) {
                vcost = a.spill_cost;
                vend = a.end_pos;
                victim = k;
            }
        }
        k = k + 1;
    }
    if (victim < 0 || vcost >= iv.spill_cost) { return cast(i32, 0 - 1); }
    let is *LiveInterval as vi = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, xact[victim]) * sizeof(LiveInterval));
    let is i32 as slot = ctx.next_spill;
    ctx.next_spill = ctx.next_spill + 1;
    ctx.vreg_to_loc[vi.vreg] = 0 - slot;
    vi.spill_loc = slot;
    vi.reg = cast(i32, 0 - 1);
    xact[victim] = cast(i32, 0 - 1);
    return victim;
}

fn linear_scan_alloc(func as *d.IRFunction, ctx as *AllocCtx) as void {
    let is i32 as vc = func.vreg_count;
    ctx.vreg_to_loc = cast(*i32, d.opt_alloc(cast(i64, vc) * 4));
    let is i32 as i with mut = 0;
    while (i < vc) {
        let is *i32 as vp = cast(*i32, cast(i64, ctx.vreg_to_loc) + cast(i64, i) * 4);
        *vp = cast(i32, 0 - 1000);
        i = i + 1;
    }
    // Build coalesce hints from IR_MOV: mov_partner[vreg] = partner vreg
    let is *i32 as mov_partner = cast(*i32, d.opt_alloc(cast(i64, vc) * 4));
    i = 0;
    while (i < vc) {
        let is *i32 as mp = cast(*i32, cast(i64, mov_partner) + cast(i64, i) * 4);
        *mp = cast(i32, 0 - 1);
        i = i + 1;
    }
    let is *d.IRInst as minst with mut = func.instructions;
    while (cast(i64, minst) != 0) {
        if (minst.is_dead == 0 && minst.op == d.IR_MOV && minst.src1.op_type == d.OP_VREG && minst.dest.op_type == d.OP_VREG) {
            let is i32 as vd = minst.dest.vreg;
            let is i32 as vs = minst.src1.vreg;
            if (vd < vc && vs < vc) {
                let is *i32 as pd = cast(*i32, cast(i64, mov_partner) + cast(i64, vd) * 4);
                if (*pd < 0) { *pd = vs; }
                let is *i32 as ps = cast(*i32, cast(i64, mov_partner) + cast(i64, vs) * 4);
                if (*ps < 0) { *ps = vd; }
            }
        }
        minst = minst.next;
    }
    _ls_init_argpos(func);
    // Init active set
    ctx.used_callee_mask = 0;
    ctx.active_idx = cast(*i32, d.opt_alloc(10 * 4));
    let is i32 as ai with mut = 0;
    while (ai < 10) {
        let is *i32 as ap = cast(*i32, cast(i64, ctx.active_idx) + cast(i64, ai) * 4);
        *ap = cast(i32, 0 - 1);
        ai = ai + 1;
    }
    // Float values (class XMM, which only -O1 and up assign: at -O0 every
    // vreg is general) get xmm2..xmm15 — xmm0/xmm1 are the codegen's scratch.
    // A parameter arriving in xmm k keeps out of the other argument xmms
    // until they are read, as in graph colouring.
    let is [16]i32 as xact;
    let is i32 as xk with mut = 0;
    while (xk < 16) { xact[xk] = cast(i32, 0 - 1); xk = xk + 1; }
    let is *i32 as ls_gx = cast(*i32, d.opt_alloc(cast(i64, vc) * 4 + 4));
    i = 0;
    while (i < vc) { ls_gx[i] = cast(i32, 0 - 1); i = i + 1; }
    let is *d.IRInst as gxs with mut = func.instructions;
    while (cast(i64, gxs) != 0) {
        if (gxs.is_dead == 0 && gxs.op == d.IR_GET_ARG && gxs.src2.op_type == d.OP_IMM
            && gxs.src2.imm >= 100 && gxs.dest.vreg >= 0 && gxs.dest.vreg < vc) {
            ls_gx[gxs.dest.vreg] = cast(i32, gxs.src2.imm - 100);
        }
        gxs = gxs.next;
    }
    i = 0;
    while (i < ctx.count) {
        let is *LiveInterval as iv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, i) * sizeof(LiveInterval));
        if (iv.start == INT_MAX) { i = i + 1; }
        else if (iv.reg_class == d.VR_XMM) {
            let is i32 as xr = _ls_xmm_pick(ctx, iv, xact, ls_gx, mov_partner);
            let is *i32 as xvp = cast(*i32, cast(i64, ctx.vreg_to_loc) + cast(i64, iv.vreg) * 4);
            if (xr >= 0) {
                iv.reg = 16 + xr;
                *xvp = 16 + xr;
                xact[xr] = i;
            } else {
                let is i32 as xsp = ctx.next_spill;
                ctx.next_spill = ctx.next_spill + 1;
                *xvp = 0 - xsp;
                iv.spill_loc = xsp;
            }
            i = i + 1;
        }
        else {
            // Expire active intervals that ended before current start
            let is i32 as ei with mut = 0;
            while (ei < 10) {
                let is *i32 as ep = cast(*i32, cast(i64, ctx.active_idx) + cast(i64, ei) * 4);
                if (*ep >= 0) {
                    let is *LiveInterval as eiv = cast(*LiveInterval, cast(i64, ctx.intervals) + cast(i64, *ep) * sizeof(LiveInterval));
                    if (eiv.end_pos < iv.start) {
                        *ep = cast(i32, 0 - 1);
                    }
                }
                ei = ei + 1;
            }
            // Compute coalesce hint
            let is i32 as hint with mut = cast(i32, 0 - 1);
            let is *i32 as mp = cast(*i32, cast(i64, mov_partner) + cast(i64, iv.vreg) * 4);
            let is i32 as partner = *mp;
            if (partner >= 0) {
                let is *i32 as ploc = cast(*i32, cast(i64, ctx.vreg_to_loc) + cast(i64, partner) * 4);
                if (*ploc >= 0) { hint = *ploc; }
            }
            let is i32 as reg with mut = find_free_reg(ctx, iv.start, iv.end_pos, hint);
            if (reg == cast(i32, 0 - 1)) {
                let is i32 as sc = spans_call(iv.start, iv.end_pos, ctx);
                reg = spill_register(ctx, iv.start, sc);
            }
            if (reg != cast(i32, 0 - 1)) {
                iv.reg = reg;
                let is *i32 as vp = cast(*i32, cast(i64, ctx.vreg_to_loc) + cast(i64, iv.vreg) * 4);
                *vp = reg;
                // Track callee-saved usage
                if (reg == 3) { ctx.used_callee_mask = ctx.used_callee_mask | 1; }
                if (reg == 10) { ctx.used_callee_mask = ctx.used_callee_mask | 2; }
                if (reg == 11) { ctx.used_callee_mask = ctx.used_callee_mask | 4; }
                if (reg == 12) { ctx.used_callee_mask = ctx.used_callee_mask | 8; }
                if (reg == 15) { ctx.used_callee_mask = ctx.used_callee_mask | 16; }
                // Update active set
                let is i32 as slot = reg_to_slot(reg);
                if (slot >= 0) {
                    let is *i32 as sp = cast(*i32, cast(i64, ctx.active_idx) + cast(i64, slot) * 4);
                    *sp = i;
                }
            } else {
                let is i32 as spill = ctx.next_spill;
                ctx.next_spill = ctx.next_spill + 1;
                let is *i32 as vp = cast(*i32, cast(i64, ctx.vreg_to_loc) + cast(i64, iv.vreg) * 4);
                *vp = 0 - spill;
                iv.spill_loc = spill;
            }
            i = i + 1;
        }
    }
    ctx.stack_slots = ctx.next_spill - 1;
    d.opt_free(cast(*u8, mov_partner));
    d.opt_free(cast(*u8, ls_gx));
    let is i32 as ci with mut = 0;
    while (ci < 16) { ls_argpos[ci] = cast(i32, 0 - 1); ci = ci + 1; }
}

// === get_operand_loc ===
// Returns: >= 0 = register index, < 0 = memory (offset = -loc * 8)

fn get_loc(vreg as i32, ctx as *AllocCtx) as i32 {
    let is *i32 as vp = cast(*i32, cast(i64, ctx.vreg_to_loc) + cast(i64, vreg) * 4);
    return *vp;
}

fn is_mem(vreg as i32, ctx as *AllocCtx) as i32 {
    if (get_loc(vreg, ctx) < 0) { return 1; }
    return 0;
}
