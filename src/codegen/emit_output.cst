use "../../caustic-assembler/parser/parsed_line.cst" as apl;
use "../../std/mem.cst" as mem;
use "../../caustic-assembler/parser/parsed_line.cst" as _pl;
use "../../caustic-assembler/parser/fastline.cst" as _fl;
use "../../caustic-assembler/lexer/lexer.cst" as _lex;
use "../../caustic-assembler/core/asm_defs.cst" as _ad;
use "asm_print.cst" as _aprint;
use "../../std/io.cst" as io;
use "../../std/time.cst" as time;
use "../parser/ast.cst" as ast;
use "alloc_gc.cst" as gc;

// === Quiet flag ===
let is i32 as cg_quiet with mut = 0;

// === Work counters (--stats) ===
// What a build did, as counts a test can compare: a time limit fails on a busy machine
// and passes on a fast one, a count of how often a list was walked does neither. The
// counters live on a page shared across the emission fork, set up by main, so the
// workers' work reaches the parent.
let is i64 as STAT_RODATA_VISITS with imut = 0;
let is i64 as STAT_OUTSIDE_CALLS with imut = 8;
let is i64 as STAT_MODULES with imut = 16;
let is i64 as STAT_TOKENS_LIVE with imut = 24;
let is i64 as STAT_LARGE_MAPS with imut = 32;
let is i64 as STAT_FUNCS_EMITTED with imut = 40;
let is i64 as STAT_OBJS_REUSED with imut = 48;
let is i64 as STAT_OBJS_EMITTED with imut = 56;
let is i64 as stats_page with mut = 0;

fn stats_add(slot as i64, n as i64) as void {
    if (stats_page != 0) { atomic_add(cast(*i64, stats_page + slot), n); }
}

// === Output buffer ===
let is *u8 as out_buf with mut;
let is i64 as out_len with mut;
let is i64 as out_cap with mut;
let is i32 as out_fd with mut;
// Sticky: set when a flush could not write the whole buffer (out_flush below).
// The assembly is also captured in memory, so the assembler still gets the real
// text — but the .s on disk is truncated, and main checks this flag before
// reporting the compile as successful.
let is i32 as out_failed with mut = 0;

// === In-memory .s capture ===
// When enabled, every flushed chunk is ALSO appended to a growing buffer so the
// in-process assembler can tokenize the assembly straight from memory instead of
// reading the .s file back from disk (the file is still written, as a cache).
// The buffer is mmap'd directly (not the opt_bins arena) so it survives the AST
// arena destroy that runs between codegen and assembly.
let is *u8 as _cap_buf with mut;
let is i64 as _cap_len with mut;
let is i64 as _cap_cap with mut;
let is i32 as _cap_on  with mut = 0;

fn capture_begin() as void { apl.side_reset(); _cap_on = 1; _cap_len = 0; }
fn capture_end()   as void { _cap_on = 0; }
fn capture_ptr()   as *u8  { return _cap_buf; }
fn capture_len()   as i64  { return _cap_len; }
fn capture_free()  as void {
    if (cast(i64, _cap_buf) != 0) { mem.core.munmap(_cap_buf, _cap_cap); }
    _cap_buf = cast(*u8, 0); _cap_len = 0; _cap_cap = 0; _cap_on = 0;
}
fn _cap_append(p as *u8, n as i64) as void {
    if (_cap_len + n > _cap_cap) {
        let is i64 as nc with mut = _cap_cap * 2;
        if (nc < _cap_len + n) { nc = _cap_len + n; }
        if (nc < 1048576) { nc = 1048576; }
        let is *u8 as nb = mem.core.mmap_anon(nc);
        if (cast(i64, nb) == 0 || cast(i64, nb) == 0 - 1) { mem.core.oom("the generated assembly", nc); }
        if (_cap_len > 0) { mem.memcpy(nb, _cap_buf, _cap_len); }
        if (cast(i64, _cap_buf) != 0) { mem.core.munmap(_cap_buf, _cap_cap); }
        _cap_buf = nb; _cap_cap = nc;
    }
    mem.memcpy(cast(*u8, cast(i64, _cap_buf) + _cap_len), p, n);
    _cap_len = _cap_len + n;
}

// === Per-module string-literal filtering (--module-only / batch codegen) ===
// A module's object should carry ONLY the string literals its own functions
// reference, not the whole-program table. `str_mark` is called when a string
// ref (`lea reg,[rip+.LC<sid>]`) is emitted; emit_rodata consults `str_is_used`.
// On overflow (sid beyond the bitmap) filtering disables → emit all (safe).
let is i32 as STR_USED_CAP with imut = 65536;
let is [65536]u8 as _str_used with mut;
let is i32 as _str_filter with mut = 0;
let is i32 as _str_overflow with mut = 0;

// In the order this module first used them: the strings of an object must not depend on
// what other modules registered before it, or an unchanged module's object would change.
let is [65536]i32 as _str_order with mut;
let is i32 as _str_order_n with mut = 0;
fn str_order_count() as i32 { return _str_order_n; }
fn str_order_at(i as i32) as i32 { return _str_order[i]; }

fn str_filter_reset(active as i32) as void {
    _str_order_n = 0;
    _str_filter = active;
    _str_overflow = 0;
    if (active == 1) { mem.memset(cast(*u8, &_str_used), 0, cast(i64, STR_USED_CAP)); }
}
fn str_mark(sid as i32) as void {
    if (sid < 0 || sid >= STR_USED_CAP) { _str_overflow = 1; return; }
    if (_str_used[sid] == cast(u8, 0)) {
        _str_order[_str_order_n] = sid;
        _str_order_n = _str_order_n + 1;
    }
    _str_used[sid] = cast(u8, 1);
}
fn str_filter_active() as i32 {
    if (_str_filter == 1 && _str_overflow == 0) { return 1; }
    return 0;
}
fn str_is_used(sid as i32) as i32 {
    if (sid < 0 || sid >= STR_USED_CAP) { return 1; }
    return cast(i32, _str_used[sid]);
}

// === Debug info ===
// === Constant pool: f64 constants read as [rip+.LCF<k>] (x86) ===
// One pool per codegen() call (a whole program, or one module), emitted after
// the functions. fc_hash holds index + 1 per slot, 0 = empty.
let is i32 as FC_CAP with imut = 4096;
let is [4096]i64 as fc_bits with mut;
let is [8192]i32 as fc_hash with mut;
let is i32 as fc_n with mut = 0;

fn fc_reset() as void {
    fc_n = 0;
    let is i32 as i with mut = 0;
    while (i < 8192) { fc_hash[i] = 0; i = i + 1; }
}

// The pool index of `bits`, added if new; -1 when the pool is full.
fn fc_index(bits as i64) as i32 {
    let is i64 as h with mut = (bits ^ (bits >> 29)) * 7046029254386353131;
    let is i32 as slot with mut = cast(i32, (h >> 40) & 8191);
    while (fc_hash[slot] != 0) {
        let is i32 as k = fc_hash[slot] - 1;
        if (fc_bits[k] == bits) { return k; }
        slot = (slot + 1) & 8191;
    }
    if (fc_n >= FC_CAP) { return 0 - 1; }
    fc_bits[fc_n] = bits;
    fc_hash[slot] = fc_n + 1;
    fc_n = fc_n + 1;
    return fc_n - 1;
}

// "QWORD PTR [rip+.LCF<k>]"
fn fc_out_ref(k as i64) as void {
    out_str("QWORD PTR [rip+.LCF", 19);
    out_int(k);
    out_str("]", 1);
}

fn fc_emit_pool() as void {
    if (fc_n == 0) { return; }
    out_str(".section .rodata\n.p2align 3\n", 28);
    let is i32 as k with mut = 0;
    while (k < fc_n) {
        out_str(".LCF", 4); out_int(cast(i64, k)); out_str(":\n  .quad ", 10);
        out_int(fc_bits[k]); out_char(10);
        k = k + 1;
    }
}

let is *u8 as cg_filename with mut;
let is i32 as cg_filename_len with mut;

// === Simple peephole for -O0: skip redundant reload after store ===
let is i32 as ph_vreg with mut = 99999;
let is i32 as ph_ridx with mut = 99999;

// === Register cache: track which phys reg holds which spilled vreg ===
// rc_vreg[reg_idx] = vreg currently cached in that register (99999 = empty)
// Only tracks SPILLED vregs (register-allocated vregs don't need caching).
let is [16]i32 as rc_vreg with mut;

fn rc_init() as void {
    let is i32 as i with mut = 0;
    while (i < 16) { rc_vreg[i] = 99999; i = i + 1; }
    sxd_init();
}

// === Sign-extended-ness tracking (E) ===
// One bit per physical reg: 1 = currently holds a 32-bit-sign-extended i64.
// `emit_narrow_truncate(reg, i32-signed)` checks this and skips the redundant
// `movsxd r, rd` when the bit is already set. Reset at labels/calls because
// control-flow merges can lose the property.
let is [16]i32 as sxd_state with mut;

fn sxd_init() as void {
    let is i32 as i with mut = 0;
    while (i < 16) { sxd_state[i] = 0; i = i + 1; }
}
fn sxd_clear_all() as void {
    let is i32 as i with mut = 0;
    while (i < 16) { sxd_state[i] = 0; i = i + 1; }
}
fn sxd_set(idx as i32) as void { if (idx >= 0 && idx < 16) { sxd_state[idx] = 1; } }
fn sxd_clear(idx as i32) as void { if (idx >= 0 && idx < 16) { sxd_state[idx] = 0; } }
fn sxd_is(idx as i32) as i32 { if (idx >= 0 && idx < 16) { return sxd_state[idx]; } return 0; }
// `mov dst, src`: dst inherits src's sxd state.
fn sxd_copy(dst as i32, src as i32) as void {
    if (dst >= 0 && dst < 16 && src >= 0 && src < 16) {
        sxd_state[dst] = sxd_state[src];
    }
}

fn ph_invalidate() as void {
    let is i32 as i with mut = 0;
    while (i < 16) { rc_vreg[i] = 99999; sxd_state[i] = 0; i = i + 1; }
}

// Invalidate a specific register (e.g., when it's overwritten)
fn rc_invalidate_reg(idx as i32) as void {
    if (idx >= 0 && idx < 16) { rc_vreg[idx] = 99999; sxd_state[idx] = 0; }
}

// Record that phys reg idx now holds spilled vreg
fn rc_set(idx as i32, vreg as i32) as void {
    if (idx >= 0 && idx < 16) { rc_vreg[idx] = vreg; }
}

// Find which register holds a given vreg. Returns reg idx or -1.
fn rc_find(vreg as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < 16) {
        if (rc_vreg[i] == vreg) { return i; }
        i = i + 1;
    }
    return cast(i32, 0 - 1);
}

// Invalidate all entries for a vreg (when it's redefined)
fn rc_invalidate_vreg(vreg as i32) as void {
    let is i32 as i with mut = 0;
    while (i < 16) {
        if (rc_vreg[i] == vreg) { rc_vreg[i] = 99999; }
        i = i + 1;
    }
}

fn reg_name_to_idx(name as *u8) as i32 {
    if (name[0] == 114) {
        // r...
        if (name[1] == 97) { return 0; } // rax
        if (name[1] == 99) { return 1; } // rcx
        if (name[1] == 100 && name[2] == 105) { return 5; } // rdi (check before rdx!)
        if (name[1] == 100) { return 2; } // rdx
        if (name[1] == 98) { return 3; } // rbx
        if (name[1] == 115) { return 4; } // rsi
        if (name[1] == 49 && name[2] == 53) { return 15; } // r15
        if (name[1] == 49 && name[2] == 52) { return 12; } // r14 → idx 12
        if (name[1] == 49 && name[2] == 51) { return 11; } // r13 → idx 11
        if (name[1] == 49 && name[2] == 50) { return 10; } // r12 → idx 10
        if (name[1] == 49 && name[2] == 49) { return 9; } // r11 → idx 9
        if (name[1] == 49 && name[2] == 48) { return 8; } // r10 → idx 8
        if (name[1] == 56) { return 6; }  // r8 → idx 6
        if (name[1] == 57) { return 7; }  // r9 → idx 7
    }
    return 99999;
}

// === Per-function profiling ===
// Each entry: name_ptr(8) + name_len(4) + vregs(4) + time_us(8) = 24 bytes
let is i64 as cg_prof_buf with mut = 0;   // ptr to buffer
let is i32 as cg_prof_count with mut = 0;
let is i32 as cg_prof_max with mut = 0;
let is i32 as cg_prof_enabled with mut = 0;

fn cg_prof_init(max_entries as i32) as void {
    cg_prof_buf = cast(i64, ast.ast_alloc(cast(i64, max_entries) * 24));
    cg_prof_count = 0;
    cg_prof_max = max_entries;
    cg_prof_enabled = 1;
}

fn cg_prof_get_time_us() as i64 {
    return time.now_us();
}

fn cg_prof_record(name_ptr as *u8, name_len as i32, vregs as i32, time_us as i64) as void {
    if (cg_prof_count >= cg_prof_max) { return; }
    let is i64 as off = cast(i64, cg_prof_count) * 24;
    let is *i64 as p0 = cast(*i64, cg_prof_buf + off);
    *p0 = cast(i64, name_ptr);
    let is *i32 as p1 = cast(*i32, cg_prof_buf + off + 8);
    *p1 = name_len;
    let is *i32 as p2 = cast(*i32, cg_prof_buf + off + 12);
    *p2 = vregs;
    let is *i64 as p3 = cast(*i64, cg_prof_buf + off + 16);
    *p3 = time_us;
    cg_prof_count = cg_prof_count + 1;
}

fn out_init(fd as i32) as void {
    out_cap = 262144; // 256KB — write buffer; out_ensure flushes when full,
                      // so this caps RAM, not output size. Was 4MB (wasted ~3.8MB peak).
    // Once per process: this runs for every module of a per-module build, and a new
    // buffer each time was 256 KB a module that nothing ever gave back.
    if (cast(i64, out_buf) == 0) { out_buf = ast.ast_alloc(out_cap); }
    out_len = 0;
    out_fd = fd;
}

fn out_flush() as void {
    if (out_len > 0) {
        if (out_fd >= 0) {
            if (io.write_all_fd(cast(i64, out_fd), out_buf, out_len) != out_len) { out_failed = 1; }
        }
        if (_cap_on == 1) { _cap_append(out_buf, out_len); }
        out_len = 0;
    }
}

fn out_ensure(n as i64) as void {
    if (out_len + n >= out_cap) {
        out_flush();
    }
}

fn out_char(c as u8) as void {
    out_ensure(1);
    out_buf[out_len] = c;
    out_len = out_len + 1;
}

fn out_str(s as *u8, n as i32) as void {
    out_ensure(cast(i64, n));
    // Fragments are almost always a mnemonic or a short suffix; a call to
    // memcpy for a handful of bytes costs more than the copy.
    if (n <= 32) {
        let is i32 as k with mut = 0;
        let is *u8 as dst = cast(*u8, cast(i64, out_buf) + out_len);
        while (k < n) { dst[k] = s[k]; k = k + 1; }
    } else {
        mem.memcpy(cast(*u8, cast(i64, out_buf) + out_len), s, cast(i64, n));
    }
    out_len = out_len + cast(i64, n);
}

fn out_cstr(s as *u8) as void {
    let is i32 as i with mut = 0;
    while (s[i] != 0) { i = i + 1; }
    out_str(s, i);
}

// The frame base. With a frame pointer, the frame is addressed [rbp-N]: the
// callee-saved pushes at rbp-8.., then locals, spills, allocas. A function
// emitted without one (-O2, emit_driver.cst) keeps the same layout measured
// from the address rbp would have held: fp_bias is the distance from rsp (as
// the body sees it, after the prologue) to that address, so rbp-N becomes
// rsp+(fp_bias-N). The return address sits at that address itself, one slot
// lower than under push rbp, which out_fp_pos accounts for.
let is i32 as fp_omit with mut = 0;
let is i64 as fp_bias with mut = 0;

// Writes the address text `rbp-N` / `rsp+M` (no brackets).
fn out_fp(n as i64) as void {
    if (fp_omit == 1) { _out_base_disp("rsp", fp_bias - n); return; }
    _out_base_disp("rbp", 0 - n);
}

// `rbp-8`, `rsp+16`, or the register alone for no displacement: the one
// spelling of a frame address (asm_print.cst prints records back this way).
fn _out_base_disp(reg as *u8, d as i64) as void {
    out_str(reg, 3);
    if (d > 0) { out_char(43); out_int(d); }
    if (d < 0) { out_char(45); out_int(0 - d); }
}

// Above the frame: `rbp+N` (N >= 16: stack arguments, variadic overflow).
fn out_fp_pos(n as i64) as void {
    if (fp_omit == 1) { _out_base_disp("rsp", fp_bias + n - 8); return; }
    _out_base_disp("rbp", n);
}

// ── Record hints (caustic-assembler parser/fastline.cst hint_line) ──
// Before the text of its most frequent lines, codegen writes the record the
// text parses to, so the assembler need not parse it. Only when the buffer
// goes straight to the in-memory assembler: never for --emit-asm or the text
// peephole, which read the text (main.cst sets hints_on).
let is i32 as hints_on with mut = 0;

// The assembler's id of a 64-bit general register name, or -1.
fn hint_id(nm as *u8) as i32 {
    if (nm[0] != 114) { return 0 - 1; }
    let is u8 as c1 = nm[1];
    let is u8 as c2 = nm[2];
    if (c1 == 56 || c1 == 57) {                       // r8, r9
        if (c2 != 0) { return 0 - 1; }
        return cast(i32, c1) - 48;
    }
    if (nm[3] != 0) { return 0 - 1; }
    if (c1 == 49) {                                   // r10..r15
        if (c2 >= 48 && c2 <= 53) { return 10 + cast(i32, c2) - 48; }
        return 0 - 1;
    }
    if (c1 == 97 && c2 == 120) { return 0; }          // rax
    if (c1 == 99 && c2 == 120) { return 1; }          // rcx
    if (c1 == 100 && c2 == 120) { return 2; }         // rdx
    if (c1 == 98 && c2 == 120) { return 3; }          // rbx
    if (c1 == 115 && c2 == 112) { return 4; }         // rsp
    if (c1 == 98 && c2 == 112) { return 5; }          // rbp
    if (c1 == 115 && c2 == 105) { return 6; }         // rsi
    if (c1 == 100 && c2 == 105) { return 7; }         // rdi
    return 0 - 1;
}

// `mov dst, src`, both 64-bit registers by name.
// Set per codegen run (main._textless_ok): a hint ends its line, and the caller
// writes no text for it (the out_hint_* return 1).
let is i32 as hint_textless with mut = 0;
fn out_hint_rr(dst as *u8, src as *u8) as i32 {
    let is i32 as a = hint_id(dst);
    let is i32 as b = hint_id(src);
    if (a < 0 || b < 0) { return 0; }
    out_char(1); out_char(65); out_char(cast(u8, a + 32)); out_char(cast(u8, b + 32));
    if (hint_textless == 1) { out_char(10); return 1; }
    return 0;
}

// `mov reg, QWORD PTR [frame n]` (shape 66) or `mov QWORD PTR [frame n], reg`
// (67), the frame address as out_fp writes it.
fn out_hint_fp(shape as i32, reg as *u8, n as i64) as i32 {
    let is i32 as a = hint_id(reg);
    if (a < 0) { return 0; }
    let is i32 as base with mut = 5;
    let is i64 as disp with mut = 0 - n;
    if (fp_omit == 1) { base = 4; disp = fp_bias - n; }
    let is i64 as v with mut = disp + 34359738368;
    if (v < 0 || v >= 68719476736) { return 0; }
    out_char(1); out_char(cast(u8, shape)); out_char(cast(u8, a + 32)); out_char(cast(u8, base + 32));
    let is i32 as k with mut = 0;
    while (k < 6) { out_char(cast(u8, 48 + cast(i32, v & 63))); v = v >> 6; k = k + 1; }
    if (hint_textless == 1) { out_char(10); return 1; }
    return 0;
}

fn out_int(n as i64) as void {
    if (n == 0) { out_char(48); return; }
    // INT64_MIN: 0 - val overflows, handle specially
    if (n == (0 - 9223372036854775807 - 1)) {
        out_str("-9223372036854775808", 20);
        return;
    }
    let is i64 as val with mut = n;
    let is i32 as neg with mut = 0;
    if (val < 0) { neg = 1; val = 0 - val; }
    let is [24]u8 as buf;
    let is i32 as pos with mut = 23;
    while (val > 0) {
        buf[pos] = cast(u8, (val % 10) + 48);
        val = val / 10;
        pos = pos - 1;
    }
    if (neg == 1) { buf[pos] = 45; pos = pos - 1; }
    out_str(cast(*u8, cast(i64, &buf) + cast(i64, pos) + 1), 23 - pos);
}

fn out_line(s as *u8) as void {
    if (hints_on == 1 && lit_line(s) == 1 && hint_textless == 1) { return; }
    out_str("  ", 2);
    out_cstr(s);
    out_char(10);
}

// `  <mn>.L<num>` as a general hint: instruction id, the label, no second
// operand. mn is the text form, mnemonic and blank ("  jne "); the text
// follows unless the hint ends the line.
fn _hz_var(v as i64) as void {
    let is i64 as x with mut = (v << 1) ^ (0 - ((v >> 63) & 1));
    let is *u8 as o = out_buf;
    let is i64 as k with mut = out_len;
    while (x > 31 || x < 0) {
        o[k] = cast(u8, 80 + cast(i32, x & 31));
        x = (x >> 5) & 576460752303423487;
        k = k + 1;
    }
    o[k] = cast(u8, 48 + cast(i32, x));
    out_len = k + 1;
}

// Room for a whole hint without a label (two operands, 13 bytes a number);
// _hz_var and _hz_c write without checking.
fn _hz_c(c as i32) as void { out_buf[out_len] = cast(u8, c); out_len = out_len + 1; }

fn _hz_bytes(id as i32) as void { out_ensure(256); _hz_c(1); _hz_c(90); _hz_var(cast(i64, id)); }
fn _hz_begin_a(id as i32) as void { if (ha_rlen > 0) { _hz_bytes(id); return; } _hz_begin(id); }
fn _hz_begin(id as i32) as void {
    if (hint_textless == 0) { _hz_bytes(id); return; }
    out_ensure(8); _hz_c(1); _hz_c(81);
    _sl = apl.side_add(id); _sw = 1; _side = 1;
}

// A register's id from its 64- or 32-bit name, or -1 (other widths, a
// `rip+symbol` address, xmm): the caller writes the text.
fn hint_reg(nm as *u8) as i32 {
    let is u8 as c = nm[0];
    if (c == 114) {                                         // r..: the 64-bit names first
        if (nm[1] >= 97) { return hint_id(nm); }
        let is i32 as n with mut = cast(i32, nm[1]) - 48;
        let is u8 as suf with mut = nm[2];
        if (n == 1) {
            if (suf < 48 || suf > 53) { return 0 - 1; }
            n = 10 + cast(i32, suf) - 48;
            suf = nm[3];
        } else if (n != 8 && n != 9) { return 0 - 1; }
        if (suf == 0) { return n; }
        let is i32 as end with mut = 3;
        if (n >= 10) { end = 4; }
        if (nm[end] != 0) { return 0 - 1; }
        if (suf == 100) { return n + 16; }                  // r8d
        if (suf == 98) { return n + 48; }                   // r8b
        return 0 - 1;
    }
    if (c == 101) {                                         // e..
        if (nm[1] == 97) { return 16; } if (nm[1] == 99) { return 17; }
        if (nm[1] == 100 && nm[2] == 120) { return 18; } if (nm[1] == 98 && nm[2] == 120) { return 19; }
        if (nm[1] == 115 && nm[2] == 105) { return 22; } if (nm[1] == 100 && nm[2] == 105) { return 23; }
        return 0 - 1;
    }
    if (nm[1] == 108 && nm[2] == 0) {                       // al cl dl bl
        if (c == 97) { return 48; } if (c == 99) { return 49; }
        if (c == 100) { return 50; } if (c == 98) { return 51; }
        return 0 - 1;
    }
    if (nm[1] == 120 && nm[2] == 0) {                       // ax cx dx bx
        if (c == 97) { return 32; } if (c == 99) { return 33; }
        if (c == 100) { return 34; } if (c == 98) { return 35; }
        return 0 - 1;
    }
    if (c == 120) {                                         // xmm0..xmm15
        if (nm[1] != 109 || nm[2] != 109) { return 0 - 1; }
        if (nm[3] == 49 && nm[4] >= 48 && nm[4] <= 53 && nm[5] == 0) { return _ad.REG_XMM0 + 10 + cast(i32, nm[4]) - 48; }
        if (nm[3] >= 48 && nm[3] <= 57 && nm[4] == 0) { return _ad.REG_XMM0 + cast(i32, nm[3]) - 48; }
        return 0 - 1;
    }
    if (nm[1] == 105 && nm[2] == 108 && nm[3] == 0) {       // sil dil
        if (c == 115) { return 54; }
        if (c == 100) { return 55; }
    }
    return 0 - 1;
}

// An instruction of registers, immediates and addresses goes to the assembler as
// the record itself (parsed_line.cst, side_add); the stream only marks its place
// (`Q`). Names travel in the stream, as do all of them when something reads the
// text of a hint (hint_textless 0). _side: a record is open, _sl, at operand _sw.
let is i32 as _side with mut = 0;
let is *apl.ParsedLine as _sl with mut = cast(*apl.ParsedLine, 0);
let is i32 as _sw with mut = 1;

fn _hz_reg(r as i32) as void {
    if (_side == 1) { apl.set_op_reg(_sl, _sw, r); _sw = 2; return; }
    _hz_c(49); _hz_var(cast(i64, r));
}
fn _hz_imm(v as i64) as void {
    if (_side == 1) { apl.set_op_imm(_sl, _sw, v); _sw = 2; return; }
    _hz_c(50); _hz_var(v);
}
fn _hz_sib(b as i32, x as i32, sc as i64, disp as i64, bits as i32) as void {
    if (_side == 1) { apl.set_op_mem_sib(_sl, _sw, b, x, cast(i32, sc), disp, bits); _sw = 2; return; }
    _hz_c(51); _hz_var(cast(i64, b)); _hz_var(cast(i64, x)); _hz_var(sc); _hz_var(disp); _hz_var(cast(i64, bits)); _hz_c(48);
}
fn _hz_mem(base as i32, disp as i64, sz as i32) as void { _hz_sib(base, _ad.REG_NONE, 0, disp, sz * 8); }

fn _hz_frame(n as i64, sz as i32) as void {
    if (fp_omit == 1) { _hz_mem(4, fp_bias - n, sz); } else { _hz_mem(5, 0 - n, sz); }
}

// The line is written by its hint alone: end it.
fn _hz_done() as i32 {
    _side = 0;
    if (hint_textless == 1) { _hz_c(10); return 1; }
    return 0;
}

// Each writes one instruction line. mn is the text up to the first operand
// ("  add "); id its instruction. They are one line of text otherwise.

// mn a, b
fn i_rr(id as i32, mn as *u8, a as *u8, b as *u8) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        let is i32 as y = hint_reg(b);
        if (x >= 0 && y >= 0) {
            if (id == _ad.INST_MOV && x < 16 && y < 16) {
                out_ensure(8); _hz_c(1); _hz_c(65); _hz_c(x + 32); _hz_c(y + 32);
            } else { _hz_begin(id); _hz_reg(x); _hz_reg(y); }
            if (_hz_done() == 1) { return; }
        }
    }
    out_cstr(mn); out_cstr(a); out_str(", ", 2); out_cstr(b); out_char(10);
}

// `.long v`: a record alone, or the text.
fn out_long(v as i64) as void {
    if (hints_on == 1 && hint_textless == 1) { out_ensure(32); _hz_c(1); _hz_c(78); _hz_var(v); _hz_c(10); return; }
    out_str("  .long ", 8); out_int(v); out_char(10);
}

// A directive with a register and a number as a record: 1 when written.
fn out_dir(kind as i32, reg as i32, num as i64) as i32 {
    if (hints_on == 0 || hint_textless == 0) { return 0; }
    out_ensure(64); _hz_c(1); _hz_c(68);
    _hz_var(cast(i64, kind)); _hz_var(cast(i64, reg)); _hz_var(num); _hz_c(10);
    return 1;
}

fn cfa_offset(n as i64) as void {
    if (out_dir(apl.DIR_CFI_DEF_CFA_OFFSET, 0, n) == 1) { return; }
    out_str("  .cfi_def_cfa_offset ", 22); out_int(n); out_char(10);
}

fn cfa_register(reg as *u8) as void {
    if (out_dir(apl.DIR_CFI_DEF_CFA_REGISTER, hint_id(reg), 0) == 1) { return; }
    out_str("  .cfi_def_cfa_register ", 24); out_cstr(reg); out_char(10);
}

fn cfi_offset(reg as *u8, n as i64) as void {
    if (out_dir(apl.DIR_CFI_OFFSET, hint_id(reg), 0 - n) == 1) { return; }
    out_str("  .cfi_offset ", 14); out_cstr(reg); out_str(", -", 3); out_int(n); out_char(10);
}

// .globl sym / .cfi_startproc sym, and .cfi_endproc
fn out_symdir(kind as i32, mn as *u8, p as *u8, n as i32) as void {
    if (hints_on == 1 && hint_textless == 1) {
        out_ensure(cast(i64, n) + 64); _hz_c(1); _hz_c(83);
        _hz_var(cast(i64, kind)); _hz_var(cast(i64, n)); out_str(p, n); _hz_c(10);
        return;
    }
    out_cstr(mn); out_str(p, n); out_char(10);
}

// `.ascii` of a plain name (nothing to escape); the record's argument keeps the
// quotes, as a string token does.
fn out_ascii(p as *u8, n as i32) as void {
    if (hints_on == 1 && hint_textless == 1) {
        out_ensure(cast(i64, n) + 64); _hz_c(1); _hz_c(83);
        _hz_var(cast(i64, apl.DIR_ASCII)); _hz_var(cast(i64, n) + 2);
        _hz_c(34); out_str(p, n); _hz_c(34); _hz_c(10);
        return;
    }
    out_str("  .ascii \"", 10); out_str(p, n); out_str("\"\n", 2);
}

fn cfi_endproc() as void {
    if (out_dir(apl.DIR_CFI_ENDPROC, 0, 0) == 1) { return; }
    out_str("  .cfi_endproc\n", 15);
}

// `.p2align power` / `.p2align power,,max`
fn out_p2align(power as i32, max as i32) as void {
    if (hints_on == 1 && hint_textless == 1) {
        out_ensure(16); _hz_c(1); _hz_c(80); _hz_c(48 + power); _hz_c(48 + max); _hz_c(10);
        return;
    }
    out_str(".p2align ", 9); out_int(cast(i64, power));
    if (max > 0) { out_str(",,", 2); out_int(cast(i64, max)); }
    out_char(10);
}

fn out_loc(line as i64) as void {
    if (out_dir(apl.DIR_LOC, 0, line) == 1) { return; }
    out_str(".loc 1 ", 7); out_int(line); out_str(" 0\n", 3);
}

// mn a
fn i_r(id as i32, mn as *u8, a as *u8) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        if (x >= 0) {
            _hz_begin(id); _hz_reg(x); if (_side == 0) { _hz_c(48); }
            if (_hz_done() == 1) { return; }
        }
    }
    out_cstr(mn); out_cstr(a); out_char(10);
}

// mn a, imm
fn i_ri(id as i32, mn as *u8, a as *u8, v as i64) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        if (x >= 0) {
            _hz_begin(id); _hz_reg(x); _hz_imm(v);
            if (_hz_done() == 1) { return; }
        }
    }
    out_cstr(mn); out_cstr(a); out_str(", ", 2); out_int(v); out_char(10);
}

fn _ptr(sz as i32) as void {
    if (sz == 8) { out_str("QWORD PTR [", 11); }
    else if (sz == 0) { out_char(91); }                     // lea: no size
    else if (sz == 4) { out_str("DWORD PTR [", 11); }
    else if (sz == 2) { out_str("WORD PTR [", 10); }
    else { out_str("BYTE PTR [", 10); }
}

// The address b as emit.addr_reg spells it: `reg`, `reg + N`, `reg - N`,
// `reg + reg * S`, `reg + reg * S + N`. Anything else is -1 (the text).
let is i32 as ha_base with mut = 0;
let is i32 as ha_index with mut = 0;
let is i64 as ha_scale with mut = 0;
let is i64 as ha_disp with mut = 0;

fn _ha_word(b as *u8, at as i32) as i32 {
    let is [8]u8 as w with mut;
    let is i32 as n with mut = 0;
    while (n < 6 && b[at + n] != 0 && b[at + n] != 32) { w[n] = b[at + n]; n = n + 1; }
    if (b[at + n] != 0 && b[at + n] != 32) { return 0 - 1; }
    w[n] = cast(u8, 0); w[n + 1] = cast(u8, 0);
    return hint_id(&w[0]);
}

let is i64 as _ha_num with mut = 0;
fn _ha_int(b as *u8, at as i32) as i32 {       // digits; the position after them, or -1
    let is i32 as k with mut = at;
    let is i64 as v with mut = 0;
    while (b[k] >= 48 && b[k] <= 57 && k - at < 11) { v = v * 10 + cast(i64, b[k]) - 48; k = k + 1; }
    if (k == at || v == 0) { return 0 - 1; }
    _ha_num = v;
    return k;
}

// `rip+symbol`: the symbol's length, or 0 (a plain address, or a name the
// parser might read as something else: the text).
let is *u8 as ha_rip with mut = cast(*u8, 0);
fn _ha_sym(p as *u8, n as i32) as i32 {
    if (n < 2 || n > 4000 || (p[0] != 95 && (p[0] != 46 || p[1] != 76))) { return 0; }
    return n;
}

fn _hz_rip(p as *u8, n as i32, sz as i32) as void {
    out_ensure(cast(i64, n) + 64);
    _hz_c(48 + _ad.OP_RIP_LABEL); _hz_var(cast(i64, sz * 8)); _hz_var(cast(i64, n));
    out_str(p, n);
}

// mn a, [rip+sym]  (lea)  or  mn a, SIZE PTR [rip+sym]
fn i_rsym(id as i32, mn as *u8, a as *u8, sz as i32, p as *u8, n as i32) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        if (x >= 0 && _ha_sym(p, n) > 0) {
            _hz_bytes(id); _hz_reg(x); _hz_rip(p, n, sz);
            if (_hz_done() == 1) { return; }
        }
    }
    out_cstr(mn); out_cstr(a); out_str(", ", 2); _ptr(sz); out_str("rip+", 4); out_str(p, n); out_str("]\n", 2);
}

let is i32 as ha_rlen with mut = 0;
fn hint_addr(b as *u8) as i32 {
    ha_rlen = 0;
    if (b[0] == 114 && b[1] == 105 && b[2] == 112 && b[3] == 43) {
        ha_rip = cast(*u8, cast(i64, b) + 4);
        let is i32 as rn with mut = 0;
        while (ha_rip[rn] != 0) { rn = rn + 1; }
        ha_rlen = _ha_sym(ha_rip, rn);
        if (ha_rlen == 0) { return 0 - 1; }
        return 0;
    }
    ha_index = _ad.REG_NONE; ha_scale = 0; ha_disp = 0;
    ha_base = _ha_word(b, 0);
    if (ha_base < 0) { return 0 - 1; }
    let is i32 as k with mut = 2;
    if (b[k] != 0 && b[k] != 32) { k = 3; }
    if (b[k] == 0) { return ha_base; }
    if (b[k] != 32 || b[k + 1] == 0 || b[k + 2] != 32) { return 0 - 1; }
    if (b[k + 1] == 43 && b[k + 3] == 114) {              // + r..
        ha_index = _ha_word(b, k + 3);
        if (ha_index < 0) { return 0 - 1; }
        k = k + 5;                                        // past a two-letter name
        if (b[k] != 0 && b[k] != 32) { k = k + 1; }
        ha_scale = 1;
        if (b[k] == 32 && b[k + 1] == 42 && b[k + 2] == 32) {
            k = _ha_int(b, k + 3);
            if (k < 0) { return 0 - 1; }
            ha_scale = _ha_num;
        }
        if (b[k] == 0) { return ha_base; }
        if (b[k] != 32 || b[k + 1] == 0 || b[k + 2] != 32) { return 0 - 1; }
    }
    let is u8 as sg = b[k + 1];
    if (sg != 43 && sg != 45) { return 0 - 1; }
    k = _ha_int(b, k + 3);
    if (k < 0 || b[k] != 0) { return 0 - 1; }
    ha_disp = _ha_num;
    if (sg == 45) { ha_disp = 0 - _ha_num; }
    return ha_base;
}

fn _hz_addr(sz as i32) as void {
    if (ha_rlen > 0) { _hz_rip(ha_rip, ha_rlen, sz); return; }
    _hz_sib(ha_base, ha_index, ha_scale, ha_disp, sz * 8);
}

// mn a, SIZE PTR [b]      (b a register, or a rip+symbol text)
fn i_rm(id as i32, mn as *u8, a as *u8, sz as i32, b as *u8) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        let is i32 as y = hint_addr(b);
        if (x >= 0 && y >= 0) {
            _hz_begin_a(id); _hz_reg(x); _hz_addr(sz);
            if (_hz_done() == 1) { return; }
        }
    }
    out_cstr(mn); out_cstr(a); out_str(", ", 2); _ptr(sz); out_cstr(b); out_str("]\n", 2);
}

// mn a, SIZE PTR [b + x * scale], then ` + d` / ` - d`
fn i_rx(id as i32, mn as *u8, a as *u8, sz as i32, b as *u8, x as *u8, scale as i64, disp as i64) as void {
    if (hints_on == 1) {
        let is i32 as ar = hint_reg(a);
        let is i32 as br = hint_id(b);
        let is i32 as xr = hint_id(x);
        if (ar >= 0 && br >= 0 && xr >= 0) {
            _hz_begin(id); _hz_reg(ar); _hz_sib(br, xr, scale, disp, sz * 8);
            if (_hz_done() == 1) { return; }
        }
    }
    out_cstr(mn); out_cstr(a); out_str(", ", 2); _ptr(sz);
    out_cstr(b); out_str(" + ", 3); out_cstr(x); out_str(" * ", 3); out_int(scale);
    if (disp > 0) { out_str(" + ", 3); out_int(disp); }
    else if (disp < 0) { out_str(" - ", 3); out_int(0 - disp); }
    out_str("]\n", 2);
}

// mn SIZE PTR [b], a
fn i_mr(id as i32, mn as *u8, sz as i32, b as *u8, a as *u8) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        let is i32 as y = hint_addr(b);
        if (x >= 0 && y >= 0) {
            _hz_begin_a(id); _hz_addr(sz); _hz_reg(x);
            if (_hz_done() == 1) { return; }
        }
    }
    out_cstr(mn); _ptr(sz); out_cstr(b); out_str("], ", 3); out_cstr(a); out_char(10);
}

fn _out_off(b as *u8, off as i64) as void {
    out_cstr(b);
    if (off > 0) { out_str(" + ", 3); out_int(off); }
}

// mn a, SIZE PTR [b + off]   (b a register, off >= 0)
fn i_ro(id as i32, mn as *u8, a as *u8, sz as i32, b as *u8, off as i64) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        let is i32 as y = hint_id(b);
        if (x >= 0 && y >= 0) {
            _hz_begin(id); _hz_reg(x); _hz_mem(y, off, sz);
            if (_hz_done() == 1) { return; }
        }
    }
    out_cstr(mn); out_cstr(a); out_str(", ", 2); _ptr(sz); _out_off(b, off); out_str("]\n", 2);
}

// mn SIZE PTR [b + off], a
fn i_or(id as i32, mn as *u8, sz as i32, b as *u8, off as i64, a as *u8) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        let is i32 as y = hint_id(b);
        if (x >= 0 && y >= 0) {
            _hz_begin(id); _hz_mem(y, off, sz); _hz_reg(x);
            if (_hz_done() == 1) { return; }
        }
    }
    out_cstr(mn); _ptr(sz); _out_off(b, off); out_str("], ", 3); out_cstr(a); out_char(10);
}

// mn SIZE PTR [b], imm
fn i_mi(id as i32, mn as *u8, sz as i32, b as *u8, v as i64) as void {
    if (hints_on == 1 && hint_addr(b) >= 0) {
        _hz_begin_a(id); _hz_addr(sz); _hz_imm(v);
        if (_hz_done() == 1) { return; }
    }
    out_cstr(mn); _ptr(sz); out_cstr(b); out_str("], ", 3); out_int(v); out_char(10);
}

// lea a, [b + x] (x a register, or null) / [b + d] / [b - d]
fn i_lea(a as *u8, b as *u8, x as *u8, d as i64) as void {
    if (hints_on == 1) {
        let is i32 as ar = hint_reg(a);
        let is i32 as br = hint_id(b);
        let is i32 as xr with mut = _ad.REG_NONE;
        if (cast(i64, x) != 0) { xr = hint_id(x); }
        if (ar >= 0 && br >= 0 && xr >= 0) {
            _hz_begin(_ad.INST_LEA); _hz_reg(ar);
            if (cast(i64, x) != 0) { _hz_sib(br, xr, 1, d, 0); } else { _hz_sib(br, xr, 0, d, 0); }
            if (_hz_done() == 1) { return; }
        }
    }
    out_str("  lea ", 6); out_cstr(a); out_str(", [", 3); out_cstr(b);
    if (cast(i64, x) != 0) { out_str(" + ", 3); out_cstr(x); }
    else if (d >= 0) { out_str(" + ", 3); out_int(d); }
    else { out_str(" - ", 3); out_int(0 - d); }
    out_str("]\n", 2);
}

// mn a, SIZE PTR [frame n]
fn i_rf(id as i32, mn as *u8, a as *u8, sz as i32, n as i64) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        if (x >= 0) {
            if (id == _ad.INST_MOV && x < 16 && sz == 8) {
                if (out_hint_fp(66, a, n) == 1) { return; }
            } else {
                _hz_begin(id); _hz_reg(x); _hz_frame(n, sz);
                if (_hz_done() == 1) { return; }
            }
        }
    }
    out_cstr(mn); out_cstr(a); out_str(", ", 2); _ptr(sz); out_fp(n); out_str("]\n", 2);
}

// mov a, QWORD PTR [incoming stack argument at n]
fn i_rp(a as *u8, n as i64) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        if (x >= 0) {
            _hz_begin(_ad.INST_MOV); _hz_reg(x);
            if (fp_omit == 1) { _hz_mem(4, fp_bias + n - 8, 8); } else { _hz_mem(5, n, 8); }
            if (_hz_done() == 1) { return; }
        }
    }
    out_str("  mov ", 6); out_cstr(a); out_str(", QWORD PTR [", 13); out_fp_pos(n); out_str("]\n", 2);
}

// mn SIZE PTR [frame n], a
fn i_fr(id as i32, mn as *u8, sz as i32, n as i64, a as *u8) as void {
    if (hints_on == 1) {
        let is i32 as x = hint_reg(a);
        if (x >= 0) {
            if (id == _ad.INST_MOV && x < 16 && sz == 8) {
                if (out_hint_fp(67, a, n) == 1) { return; }
            } else {
                _hz_begin(id); _hz_frame(n, sz); _hz_reg(x);
                if (_hz_done() == 1) { return; }
            }
        }
    }
    out_cstr(mn); _ptr(sz); out_fp(n); out_str("], ", 3); out_cstr(a); out_char(10);
}

// mn SIZE PTR [frame n], imm
fn i_fi(id as i32, mn as *u8, sz as i32, n as i64, v as i64) as void {
    if (hints_on == 1) {
        _hz_begin(id); _hz_frame(n, sz); _hz_imm(v);
        if (_hz_done() == 1) { return; }
    }
    out_cstr(mn); _ptr(sz); out_fp(n); out_str("], ", 3); out_int(v); out_char(10);
}

fn out_jump(id as i32, mn as *u8, num as i64) as void {
    if (hints_on == 1 && num >= 0) {
        _hz_bytes(id);
        out_char(cast(u8, 48 + _ad.OP_LABEL));
        let is i64 as len with mut = 3;
        let is i64 as t with mut = num;
        while (t > 9) { len = len + 1; t = t / 10; }
        _hz_var(len);
        out_str(".L", 2); out_int(num);
        out_char(48);
        if (hint_textless == 1) { out_char(10); return; }
    }
    out_cstr(mn); out_str(".L", 2); out_int(num); out_char(10);
}

// `  call <name>`, a plain symbol.
fn out_call(name as *u8, len as i32) as void {
    let is i32 as plain with mut = cast(i32, hints_on == 1 && len > 2);
    // Names the tokenizer reads as something else (a register, a mnemonic)
    // are left to the parser.
    if (plain == 1 && name[0] != 95) { plain = 0; }
    if (plain == 1) {
        _hz_bytes(_ad.INST_CALL);
        out_char(cast(u8, 48 + _ad.OP_LABEL));
        _hz_var(cast(i64, len));
        out_str(name, len);
        out_char(48);
        if (hint_textless == 1) { out_char(10); return; }
    }
    out_str("  call ", 7); out_str(name, len); out_char(10);
}

fn out_line2(a as *u8, b as *u8) as void {
    out_str("  ", 2);
    out_cstr(a);
    out_cstr(b);
    out_char(10);
}

fn out_line3(a as *u8, b as *u8, c as *u8) as void {
    out_str("  ", 2);
    out_cstr(a);
    out_cstr(b);
    out_cstr(c);
    out_char(10);
}

// === Whole constant lines as record hints ===
//
// out_line writes "  <s>" for a literal s. The first time a literal is seen it
// is parsed by the assembler's own fast parser; when the record prints back to
// exactly that text, the general hint (fastline.hint_z) for it is kept, and
// every later out_line of that literal copies the hint. Entries are keyed by
// address and checked against the bytes they were built from.

let is i32 as LIT_MAX with imut = 2048;        // power of two
let is *i64 as lit_key with mut = cast(*i64, 0);     // literal address, 0 = empty
let is *i32 as lit_txt with mut;               // offset of its text in lit_buf
let is *i32 as lit_tlen with mut;
let is *i32 as lit_hoff with mut;              // offset of its hint; -1 = no hint
let is *i32 as lit_hlen with mut;
let is i32 as lit_count with mut = 0;
let is *u8 as lit_buf with mut;
let is i32 as lit_blen with mut = 0;
let is i32 as LIT_BUF with imut = 524288;

fn _lit_init() as void {
    lit_key = cast(*i64, mem.core.mmap_anon(cast(i64, LIT_MAX) * 8));
    lit_txt = cast(*i32, mem.core.mmap_anon(cast(i64, LIT_MAX) * 4));
    lit_tlen = cast(*i32, mem.core.mmap_anon(cast(i64, LIT_MAX) * 4));
    lit_hoff = cast(*i32, mem.core.mmap_anon(cast(i64, LIT_MAX) * 4));
    lit_hlen = cast(*i32, mem.core.mmap_anon(cast(i64, LIT_MAX) * 4));
    lit_buf = mem.core.mmap_anon(cast(i64, LIT_BUF));
}

let is _pl.ParsedLines as _lit_pl with mut;
let is [1024]u8 as _lit_recs with mut;       // two ParsedLines
let is [512]u8 as _lz with mut;
let is i32 as _lzn with mut = 0;

fn _lz_var(v as i64) as i32 {
    let is i64 as x with mut = (v << 1) ^ (v >> 63);
    let is i32 as more with mut = 1;
    while (more == 1) {
        if (_lzn >= 500) { return 0; }
        let is i32 as c with mut = cast(i32, x & 31);
        x = (x >> 5) & 576460752303423487;
        if (x != 0) { c = c + 32; } else { more = 0; }
        _lz[_lzn] = cast(u8, c + 48);
        _lzn = _lzn + 1;
    }
    return 1;
}

fn _lz_op(r as *_pl.ParsedLine, which as i32) as i32 {
    let is i32 as k with mut = cast(i32, r.op1_kind);
    if (which == 2) { k = cast(i32, r.op2_kind); }
    if (k < 0 || k > 20 || _lzn >= 500) { return 0; }
    _lz[_lzn] = cast(u8, k + 48);
    _lzn = _lzn + 1;
    if (k == _ad.OP_NONE) { return 1; }
    if (k == _ad.OP_REG) {
        if (which == 1) { return _lz_var(cast(i64, r.op1_reg_id)); }
        return _lz_var(cast(i64, r.op2_reg_id));
    }
    if (k == _ad.OP_IMM) {
        if (which == 1) { return _lz_var(r.op1_imm); }
        return _lz_var(r.op2_imm);
    }
    if (k == _ad.OP_MEM) {
        if (which == 1) {
            if (r.op1_label_len != 0) { return 0; }
            return cast(i32, _lz_var(cast(i64, r.op1_mem_base)) == 1 && _lz_var(cast(i64, r.op1_mem_index)) == 1
                && _lz_var(cast(i64, r.op1_mem_scale)) == 1 && _lz_var(r.op1_mem_disp) == 1
                && _lz_var(cast(i64, r.op1_mem_size)) == 1 && _lz_var(cast(i64, r.op1_mem_seg)) == 1);
        }
        if (r.op2_label_len != 0) { return 0; }
        return cast(i32, _lz_var(cast(i64, r.op2_mem_base)) == 1 && _lz_var(cast(i64, r.op2_mem_index)) == 1
            && _lz_var(cast(i64, r.op2_mem_scale)) == 1 && _lz_var(r.op2_mem_disp) == 1
            && _lz_var(cast(i64, r.op2_mem_size)) == 1 && _lz_var(cast(i64, r.op2_mem_seg)) == 1);
    }
    if (k == _ad.OP_LABEL) {
        let is *u8 as lp with mut = r.op1_label_ptr;
        let is i32 as ll with mut = cast(i32, r.op1_label_len);
        if (which == 2) { lp = r.op2_label_ptr; ll = cast(i32, r.op2_label_len); }
        if (_lz_var(cast(i64, ll)) == 0 || _lzn + ll >= 500) { return 0; }
        let is i32 as q with mut = 0;
        while (q < ll) { _lz[_lzn] = lp[q]; _lzn = _lzn + 1; q = q + 1; }
        return 1;
    }
    return 0;
}

// Build the hint of the literal text t[0..n) (whole line, "  " included) into _lz.
fn _lit_encode(t as *u8, n as i32) as i32 {
    if (n < 3 || n >= 200) { return 0; }
    if (t[n - 1] == 58 || t[2] == 46) { return 0; }      // a label or directive: a side table, not a record
    let is [256]u8 as tb with mut;
    let is i32 as i with mut = 0;
    while (i < n) { tb[i] = t[i]; i = i + 1; }
    tb[n] = cast(u8, 0);
    // Its own storage: the shared heap is torn down before the assembler runs,
    // and pl_init would reset the assembler's side table.
    _lit_pl.data = cast(*u8, &_lit_recs);
    _lit_pl.cap = 2;
    let is *_pl.ParsedLines as tmpp = &_lit_pl;
    tmpp.count = 0;
    _lex.lex_init();
    _fl.lookup_begin(cast(i64, &tb) + cast(i64, n));
    let is i64 as eol = _fl.fast_line(cast(*u8, &tb), 0, cast(i64, n), tmpp, 0, 1);
    let is i32 as ok with mut = 0;
    if (eol == cast(i64, n) && tmpp.count == 1) {
        let is *_pl.ParsedLine as r = _pl.pl_get(tmpp, 0);
        if (r.kind == _pl.LINE_INST && r.aux == 0) {
            let is [300]u8 as pb with mut;
            let is i32 as pn = _aprint.print_line(r, cast(*u8, &pb));
            if (pn == n) {
                let is i32 as same with mut = 1;
                i = 0;
                while (i < n) { if (pb[i] != tb[i]) { same = 0; } i = i + 1; }
                if (same == 1) {
                    _lzn = 0;
                    _lz[0] = cast(u8, 1); _lz[1] = cast(u8, 90); _lzn = 2;
                    ok = cast(i32, _lz_var(cast(i64, r.inst_id)) == 1 && _lz_op(r, 1) == 1 && _lz_op(r, 2) == 1);
                }
            }
        }
    }
    return ok;
}

// Emit the hint of out_line(s)'s line, if it has one: 1 = the line is written
// (a newline ends it when the caller writes no text).
fn lit_line(s as *u8) as i32 {
    if (lit_count < 0) { return 0; }
    if (cast(i64, lit_key) == 0) { _lit_init(); }
    let is i64 as key = cast(i64, s);
    let is i32 as h with mut = cast(i32, (key >> 3) & cast(i64, LIT_MAX - 1));
    let is i32 as slot with mut = 0 - 1;
    while (slot < 0) {
        if (lit_key[h] == key) { slot = h; }
        else if (lit_key[h] == 0) { slot = h; }
        else { h = (h + 1) & (LIT_MAX - 1); }
    }
    // built from these bytes? (one pass; a shorter or different s stops it)
    if (lit_key[slot] == key) {
        let is i32 as tn = lit_tlen[slot] - 2;
        let is *u8 as bp = cast(*u8, cast(i64, lit_buf) + cast(i64, lit_txt[slot]) + 2);
        let is i32 as i with mut = 0;
        while (i < tn && bp[i] == s[i]) { i = i + 1; }
        if (i == tn && s[i] == 0) {
            if (lit_hoff[slot] < 0) { return 0; }
            return _lit_emit(slot);
        }
    }
    let is i32 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    if (lit_count >= LIT_MAX - 64) { return 0; }
    // (re)build
    let is [300]u8 as line with mut;
    if (n + 2 >= 250) { return 0; }
    line[0] = cast(u8, 32); line[1] = cast(u8, 32);
    let is i32 as k with mut = 0;
    while (k < n) { line[k + 2] = s[k]; k = k + 1; }
    let is i32 as total = n + 2;
    if (lit_blen + total + 600 > LIT_BUF) { return 0; }
    if (lit_key[slot] != key) { lit_key[slot] = key; lit_count = lit_count + 1; }
    lit_txt[slot] = lit_blen;
    lit_tlen[slot] = total;
    mem.memcpy(cast(*u8, cast(i64, lit_buf) + cast(i64, lit_blen)), cast(*u8, &line), cast(i64, total));
    lit_blen = lit_blen + total;
    if (_lit_encode(cast(*u8, &line), total) == 0) {
        lit_hoff[slot] = 0 - 1;
        lit_hlen[slot] = 0;
        return 0;
    }
    lit_hoff[slot] = lit_blen;
    lit_hlen[slot] = _lzn;
    mem.memcpy(cast(*u8, cast(i64, lit_buf) + cast(i64, lit_blen)), cast(*u8, &_lz), cast(i64, _lzn));
    lit_blen = lit_blen + _lzn;
    return _lit_emit(slot);
}

fn _lit_emit(slot as i32) as i32 {
    let is i64 as hb = cast(i64, lit_buf) + cast(i64, lit_hoff[slot]);
    out_str(cast(*u8, hb), lit_hlen[slot]);
    if (hint_textless == 1) { out_char(10); }
    return 1;
}

// === Register name tables ===
// regs[0..11] = rax,rcx,rdx,rbx,rsi,rdi,r8,r9,r10,r11,r12,r13

// Phys reg idx → xmm name. Caller is responsible for passing an XMM-range idx.
fn reg_xmm(idx as i32) as *u8 {
    if (idx == 16) { return "xmm0"; }
    if (idx == 17) { return "xmm1"; }
    if (idx == 18) { return "xmm2"; }
    if (idx == 19) { return "xmm3"; }
    if (idx == 20) { return "xmm4"; }
    if (idx == 21) { return "xmm5"; }
    if (idx == 22) { return "xmm6"; }
    if (idx == 23) { return "xmm7"; }
    if (idx == 24) { return "xmm8"; }
    if (idx == 25) { return "xmm9"; }
    if (idx == 26) { return "xmm10"; }
    if (idx == 27) { return "xmm11"; }
    if (idx == 28) { return "xmm12"; }
    if (idx == 29) { return "xmm13"; }
    if (idx == 30) { return "xmm14"; }
    if (idx == 31) { return "xmm15"; }
    return "xmm0";
}

// Two register names, by what they say. Not by address: inlining reg64 into another
// module gives its literals addresses of their own there.
fn reg_same(a as *u8, b as *u8) as i32 {
    if (cast(i64, a) == cast(i64, b)) { return 1; }
    let is i64 as i with mut = 0;
    while (a[i] == b[i]) {
        if (a[i] == cast(u8, 0)) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn reg64(idx as i32) as *u8 {
    if (idx == 0) { return "rax"; }
    if (idx == 1) { return "rcx"; }
    if (idx == 2) { return "rdx"; }
    if (idx == 3) { return "rbx"; }
    if (idx == 4) { return "rsi"; }
    if (idx == 5) { return "rdi"; }
    if (idx == 6) { return "r8"; }
    if (idx == 7) { return "r9"; }
    if (idx == 8) { return "r10"; }
    if (idx == 9) { return "r11"; }
    if (idx == 10) { return "r12"; }
    if (idx == 11) { return "r13"; }
    if (idx == 12) { return "r14"; }
    if (idx == 15) { return "r15"; }
    return "rax";
}

fn reg32(idx as i32) as *u8 {
    if (idx == 0) { return "eax"; }
    if (idx == 1) { return "ecx"; }
    if (idx == 2) { return "edx"; }
    if (idx == 3) { return "ebx"; }
    if (idx == 4) { return "esi"; }
    if (idx == 5) { return "edi"; }
    if (idx == 6) { return "r8d"; }
    if (idx == 7) { return "r9d"; }
    if (idx == 8) { return "r10d"; }
    if (idx == 9) { return "r11d"; }
    if (idx == 10) { return "r12d"; }
    if (idx == 11) { return "r13d"; }
    if (idx == 12) { return "r14d"; }
    if (idx == 15) { return "r15d"; }
    return "eax";
}

fn reg16(idx as i32) as *u8 {
    if (idx == 0) { return "ax"; }
    if (idx == 1) { return "cx"; }
    if (idx == 2) { return "dx"; }
    if (idx == 3) { return "bx"; }
    if (idx == 4) { return "si"; }
    if (idx == 5) { return "di"; }
    if (idx == 6) { return "r8w"; }
    if (idx == 7) { return "r9w"; }
    if (idx == 8) { return "r10w"; }
    if (idx == 9) { return "r11w"; }
    if (idx == 10) { return "r12w"; }
    if (idx == 11) { return "r13w"; }
    if (idx == 12) { return "r14w"; }
    if (idx == 15) { return "r15w"; }
    return "ax";
}

fn reg8(idx as i32) as *u8 {
    if (idx == 0) { return "al"; }
    if (idx == 1) { return "cl"; }
    if (idx == 2) { return "dl"; }
    if (idx == 3) { return "bl"; }
    if (idx == 4) { return "sil"; }
    if (idx == 5) { return "dil"; }
    if (idx == 6) { return "r8b"; }
    if (idx == 7) { return "r9b"; }
    if (idx == 8) { return "r10b"; }
    if (idx == 9) { return "r11b"; }
    if (idx == 10) { return "r12b"; }
    if (idx == 11) { return "r13b"; }
    if (idx == 12) { return "r14b"; }
    if (idx == 15) { return "r15b"; }
    return "al";
}

fn arg_reg64(idx as i32) as *u8 {
    if (idx == 0) { return "rdi"; }
    if (idx == 1) { return "rsi"; }
    if (idx == 2) { return "rdx"; }
    if (idx == 3) { return "rcx"; }
    if (idx == 4) { return "r8"; }
    if (idx == 5) { return "r9"; }
    return "rax";
}

fn syscall_reg(idx as i32) as *u8 {
    if (idx == 0) { return "rax"; }
    if (idx == 1) { return "rdi"; }
    if (idx == 2) { return "rsi"; }
    if (idx == 3) { return "rdx"; }
    if (idx == 4) { return "r10"; }
    if (idx == 5) { return "r8"; }
    if (idx == 6) { return "r9"; }
    return "rax";
}

struct AddrMode {
    base_vreg as i32;
    index_vreg as i32;
    scale as i32;
    matched as i32;
}
