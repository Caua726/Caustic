// =======================================================
// std/math.cst
// Funções matemáticas para inteiros
// =======================================================

// --- Absolute Value ---
// Nota: abs(INT64_MIN) retorna INT64_MAX (off-by-one, mas seguro)

fn abs_i64(n as i64) as i64 {
    if (n == (0 - 9223372036854775807 - 1)) { return 9223372036854775807; }
    if (n < 0) { return 0 - n; }
    return n;
}

fn abs_i32(n as i32) as i32 {
    if (n < 0) { return cast(i32, 0) - n; }
    return n;
}

// --- Min / Max ---

fn min_i64(a as i64, b as i64) as i64 {
    if (a < b) { return a; }
    return b;
}

fn max_i64(a as i64, b as i64) as i64 {
    if (a > b) { return a; }
    return b;
}

fn min_i32(a as i32, b as i32) as i32 {
    if (a < b) { return a; }
    return b;
}

fn max_i32(a as i32, b as i32) as i32 {
    if (a > b) { return a; }
    return b;
}

// --- Clamp ---

fn clamp_i64(val as i64, lo as i64, hi as i64) as i64 {
    if (val < lo) { return lo; }
    if (val > hi) { return hi; }
    return val;
}

fn clamp_i32(val as i32, lo as i32, hi as i32) as i32 {
    if (val < lo) { return lo; }
    if (val > hi) { return hi; }
    return val;
}

// --- Power ---

fn pow_i64(base as i64, exp as i64) as i64 {
    if (exp < 0) { return 0; }
    if (exp == 0) { return 1; }
    let is i64 as result with mut = 1;
    let is i64 as b with mut = base;
    let is i64 as e with mut = exp;
    while (e > 0) {
        if ((e & 1) == 1) {
            result = result * b;
        }
        b = b * b;
        e = e >> 1;
    }
    return result;
}

// Integer square root: largest r with r*r <= n. Returns 0 for n <= 0.
// Newton's method on integers — converges in a handful of iterations.
fn isqrt(n as i64) as i64 {
    if (n <= 0) { return 0; }
    if (n < 4) { return 1; }
    let is i64 as x with mut = n;
    let is i64 as y with mut = (x + 1) / 2;
    while (y < x) {
        x = y;
        y = (x + n / x) / 2;
    }
    return x;
}

// --- GCD / LCM ---

fn gcd(a as i64, b as i64) as i64 {
    let is i64 as x with mut = abs_i64(a);
    let is i64 as y with mut = abs_i64(b);
    while (y != 0) {
        let is i64 as t = y;
        y = x % y;
        x = t;
    }
    return x;
}

fn lcm(a as i64, b as i64) as i64 {
    if (a == 0 || b == 0) { return 0; }
    let is i64 as g = gcd(a, b);
    let is i64 as aa = abs_i64(a);
    let is i64 as bb = abs_i64(b);
    return (aa / g) * bb;
}

// --- Sign ---

fn sign_i64(n as i64) as i64 {
    if (n > 0) { return 1; }
    if (n < 0) { return 0 - 1; }
    return 0;
}

fn sign_i32(n as i32) as i32 {
    if (n > 0) { return cast(i32, 1); }
    if (n < 0) { return cast(i32, 0 - 1); }
    return cast(i32, 0);
}

// --- Division ---

fn div_ceil(a as i64, b as i64) as i64 {
    if (b == 0) { return 0; }
    let is i64 as d = a / b;
    let is i64 as r = a % b;
    if (r != 0 && ((a > 0 && b > 0) || (a < 0 && b < 0))) {
        return d + 1;
    }
    return d;
}

fn is_power_of_two(n as i64) as i64 {
    if (n <= 0) { return 0; }
    if ((n & (n - 1)) == 0) { return 1; }
    return 0;
}

// align_up/align_down: align DEVE ser potência de 2
fn align_up(val as i64, align as i64) as i64 {
    let is i64 as mask = align - 1;
    return (val + mask) & (0 - align);
}

fn align_down(val as i64, align as i64) as i64 {
    return val & (0 - align);
}

// Hardware sqrt — lowers to `sqrtsd xmm0, xmm0` at codegen. ~3-5 cycles
// instead of ~150 cycles for a Newton-Raphson loop. No libm dependency.
fn sqrt(x as f64) as f64 {
    return __builtin_sqrt(x);
}

// Single-precision hardware sqrt; the typed intrinsic rounds in binary32.
fn sqrtf(x as f32) as f32 {
    return __builtin_sqrt(x);
}

// =======================================================
// Floating point
//
// Everything below is computed here, in Caustic: there is no libm to call
// and sqrt is the only float operation the hardware gives us outright. The
// transcendentals reduce the argument to a small interval, evaluate a short
// polynomial on it and undo the reduction. The polynomial coefficients are
// minimax fits made for this file (Remez exchange in high precision), not
// Taylor coefficients, and the reductions carry the parts that a double would
// round away as a second double ("hi + lo"), so that the only rounding that
// matters is the last addition. The error bounds quoted below are measured
// against a high-precision reference; "ulp" is a unit in the last place of the
// exact result.
//
// Three tools recur:
//   - Splitting: a double is split into two halves of 26 bits
//     (s = a * (2^27 + 1); hi = s - (s - a); lo = a - hi), whose products
//     with another 26-bit half are exact. That gives the exact product of
//     two doubles as p + e (p = a*b, e the rounding error), without an FMA.
//   - Exact sums: s = a + b; e = (a - s) + b recovers the rounding error of
//     the sum when |a| >= |b|. Without that guarantee the longer form
//     bb = s - a; e = (a - (s - bb)) + (b - bb) does the same.
//   - Tables: the per-interval constants live in string literals of
//     little-endian doubles, indexed by the bits of the argument.
//
// The hot paths are written out in full instead of calling small helpers:
// calls into another module are not inlined by the compiler today, and a
// call per polynomial cost more than the polynomial.
//
// Float comparisons see NaN: `x != x` is true only for NaN and every ordered
// comparison with a NaN is false, so `if (x < LIMIT)` style range tests also
// send NaN down the slow path. The code relies on that.
// =======================================================

// --- Constants ---

let is f64 as PI      = 3.141592653589793;
let is f64 as TAU     = 6.283185307179586;
let is f64 as PI_2    = 1.5707963267948966;
let is f64 as PI_4    = 0.7853981633974483;
let is f64 as E       = 2.718281828459045;
let is f64 as LN2     = 0.6931471805599453;
let is f64 as LN10    = 2.302585092994046;
let is f64 as LOG2E   = 1.4426950408889634;
let is f64 as SQRT2   = 1.4142135623730951;
let is f64 as DEG2RAD = 0.017453292519943295;
let is f64 as RAD2DEG = 57.29577951308232;

// pi/2 as a sum of two doubles, and as pieces with trailing zeros (kept for
// code that used them; the reductions below use their own splits).
let is f64 as PI_2_HI = 1.5707963267948966;
let is f64 as PI_2_LO = 0.00000000000000006123233995736766;
let is f64 as PIO2_1  = 1.570796251296997;
let is f64 as PIO2_2  = 0.00000007549789415861596;
let is f64 as PIO2_3  = 0.000000000000005390302529957765;
let is f64 as PIO2_4  = 0.00000000000000000000032820035428735005;
let is f64 as LN2_HI  = 0.6931471803691238;
let is f64 as LN2_LO  = 0.0000000001908214929270588;

// --- Bit-level access ---
//
// cast() between f64 and i64 converts the value (cvttsd2si); reinterpreting
// the bits needs a pointer round-trip.

fn f64_bits(x as f64) as i64 {
    return *cast(*i64, &x);
}

fn bits_f64(b as i64) as f64 {
    return *cast(*f64, &b);
}

fn inf() as f64 {
    return bits_f64(9218868437227405312);   // 0x7FF0000000000000
}

fn neg_inf() as f64 {
    return bits_f64(0 - 4503599627370496);  // 0xFFF0000000000000
}

fn nan() as f64 {
    return bits_f64(9221120237041090560);   // 0x7FF8000000000000
}

// exponent all ones and a non-zero mantissa.
fn is_nan(x as f64) as i32 {
    let is i64 as b = f64_bits(x);
    let is i64 as exp = (b >> 52) & 2047;
    let is i64 as frac = b & 4503599627370495;
    if (exp == 2047 && frac != 0) { return 1; }
    return 0;
}

fn is_inf(x as f64) as i32 {
    let is i64 as b = f64_bits(x);
    let is i64 as exp = (b >> 52) & 2047;
    let is i64 as frac = b & 4503599627370495;
    if (exp == 2047 && frac == 0) { return 1; }
    return 0;
}

fn is_finite(x as f64) as i32 {
    let is i64 as exp = (f64_bits(x) >> 52) & 2047;
    if (exp == 2047) { return 0; }
    return 1;
}

// --- Basic ---

fn abs_f64(x as f64) as f64 {
    if (x < 0.0) { return 0.0 - x; }
    return x;
}

fn min_f64(a as f64, b as f64) as f64 {
    if (a < b) { return a; }
    return b;
}

fn max_f64(a as f64, b as f64) as f64 {
    if (a > b) { return a; }
    return b;
}

fn clamp_f64(v as f64, lo as f64, hi as f64) as f64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

fn sign_f64(x as f64) as f64 {
    if (x > 0.0) { return 1.0; }
    if (x < 0.0) { return 0.0 - 1.0; }
    return 0.0;
}

fn lerp(a as f64, b as f64, t as f64) as f64 {
    return a + (b - a) * t;
}

// 2^n as a power of two built straight from the exponent field.
fn exp2i(n as i64) as f64 {
    if (n > 1023) { return inf(); }
    if (n < 0 - 1022) { return 0.0; }
    return bits_f64((n + 1023) << 52);
}

// --- Rounding ---
//
// Below 2^52 in magnitude the conversion to i64 and back truncates exactly;
// at or above it every double is already an integer and is returned as is,
// and so is NaN, which fails the range test. A zero result takes the sign of
// x (x * 0.0), as C's functions do: trunc(-0.5) is -0.0.

fn trunc(x as f64) as f64 {
    if (x > -4503599627370496.0 && x < 4503599627370496.0) {
        let is f64 as t = cast(f64, cast(i64, x));
        if (t == 0.0) { return x * 0.0; }
        return t;
    }
    return x;
}

fn floor(x as f64) as f64 {
    if (x > -4503599627370496.0 && x < 4503599627370496.0) {
        let is f64 as t = cast(f64, cast(i64, x));
        if (t > x) { return t - 1.0; }
        if (t == 0.0) { return x * 0.0; }
        return t;
    }
    return x;
}

fn ceil(x as f64) as f64 {
    if (x > -4503599627370496.0 && x < 4503599627370496.0) {
        let is f64 as t = cast(f64, cast(i64, x));
        if (t < x) { return t + 1.0; }
        if (t == 0.0) { return x * 0.0; }
        return t;
    }
    return x;
}

// Half away from zero, matching C's round() rather than banker's rounding.
// x - trunc(x) is exact, so 0.49999999999999994 stays at 0.
fn round(x as f64) as f64 {
    if (x > -4503599627370496.0 && x < 4503599627370496.0) {
        let is f64 as t = cast(f64, cast(i64, x));
        let is f64 as d = x - t;
        if (d >= 0.5) { return t + 1.0; }
        if (d <= -0.5) { return t - 1.0; }
        if (t == 0.0) { return x * 0.0; }
        return t;
    }
    return x;
}

// Remainder with the sign of x, exact. The quotient is taken from x / y and
// the product q*y is formed exactly as two doubles, so x - q*y needs no
// rounding; a quotient one off (x / y rounded across an integer) shows as a
// remainder outside [0, |y|) and is corrected. Quotients past 2^52, and
// operands so small or large that the exact product would underflow or
// overflow, go through integer long division of the mantissas instead.
fn fmod(x as f64, y as f64) as f64 {
    let is i64 as ix = *cast(*i64, &x);
    let is i64 as iy = *cast(*i64, &y);
    let is i64 as ax = ix & 9223372036854775807;
    let is i64 as ay = iy & 9223372036854775807;
    // NaN operands, an infinite x or a zero y have no remainder.
    if (ax >= 9218868437227405312 || ay > 9218868437227405312 || ay == 0) { return (x * y) / (x * y); }
    if (ax < ay) { return x; }
    if (ax == ay) { return x * 0.0; }
    let is f64 as fx = *cast(*f64, &ax);
    let is f64 as fy = *cast(*f64, &ay);
    // 2^-900 < |y|, |x| < 2^900 and |x| / |y| < 2^52
    if (ay > 553942754166571008 && ax < 8660422083433463808 && ax - ay < 234187180623265792) {
        let is f64 as qf = cast(f64, cast(i64, fx / fy));
        let is f64 as sq = qf * 134217729.0;
        let is f64 as q1 = sq - (sq - qf);
        let is f64 as q2 = qf - q1;
        let is f64 as sy = fy * 134217729.0;
        let is f64 as y1 = sy - (sy - fy);
        let is f64 as y2 = fy - y1;
        let is f64 as p = qf * fy;
        let is f64 as r = (fx - p) - (((q1 * y1 - p) + q1 * y2 + q2 * y1) + q2 * y2);
        if (r >= 0.0 && r < fy) {
            if (ix < 0) { return -r; }
            return r;
        }
        let is f64 as r2 = _fmod_rem(fx, fy, qf - 1.0);
        if (r < 0.0) {
            if (ix < 0) { return -r2; }
            return r2;
        }
        let is f64 as r3 = _fmod_rem(fx, fy, qf + 1.0);
        if (ix < 0) { return -r3; }
        return r3;
    }
    let is f64 as res = _fmod_int(ax, ay);
    if (ix < 0) { return -res; }
    return res;
}

// fx - q*fy, with q*fy formed exactly; exact whenever the true value is a
// double, which it is for the right q.
fn _fmod_rem(fx as f64, fy as f64, q as f64) as f64 {
    let is f64 as sq = q * 134217729.0;
    let is f64 as q1 = sq - (sq - q);
    let is f64 as q2 = q - q1;
    let is f64 as sy = fy * 134217729.0;
    let is f64 as y1 = sy - (sy - fy);
    let is f64 as y2 = fy - y1;
    let is f64 as p = q * fy;
    let is f64 as pe = ((q1 * y1 - p) + q1 * y2 + q2 * y1) + q2 * y2;
    return (fx - p) - pe;
}

// |x| mod |y| by long division on the integer mantissas, ten bits at a time.
fn _fmod_int(ax as i64, ay as i64) as f64 {
    let is i64 as ex with mut = ax >> 52;
    let is i64 as ey with mut = ay >> 52;
    let is i64 as mx with mut = ax & 4503599627370495;
    let is i64 as my with mut = ay & 4503599627370495;
    if (ex == 0) { ex = 1; } else { mx = mx | 4503599627370496; }
    if (ey == 0) { ey = 1; } else { my = my | 4503599627370496; }
    // |x| = mx * 2^(ex - 1075); r = mx * 2^(ex - ey) mod my, with r < 2^53
    // so that r << 10 stays inside an i64.
    let is i64 as r with mut = mx % my;
    let is i64 as d with mut = ex - ey;
    while (d > 10) {
        r = (r << 10) % my;
        d = d - 10;
    }
    r = (r << d) % my;
    // r * 2^(ey - 1075) is a double; when that power is below the normal
    // range, go through 2^(ey - 475) and 2^-600 so both factors are normal
    // and only the exact final product is formed.
    if (ey >= 53) {
        let is i64 as sb = (ey - 52) << 52;
        return cast(f64, r) * (*cast(*f64, &sb));
    }
    let is i64 as sb2 = (ey + 548) << 52;
    return (cast(f64, r) * (*cast(*f64, &sb2))) * 2.409919865102884e-181;
}

// --- Exponential ---
//
// exp(x) = 2^k * 2^(j/128) * exp(r): x = (128k + j) * ln2/128 + r with
// |r| <= ln2/256. 2^(j/128) comes from a table as hi + lo; exp(r) - 1 is
// r + r^2/2 + a degree-5 fit (relative error 2^-63.9). The reduction rounds
// x * 128/ln2 to an integer by adding and subtracting 1.5 * 2^52, and
// ln2/128 is split so that n * hi part is exact for every n reached.
// Max error 0.51 ulp (0.74 when the result is subnormal and is rounded a
// second time); exp(0) is exactly 1.

