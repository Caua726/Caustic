// exp(x + xl) where the result may overflow, underflow or be subnormal, or
// x is NaN or infinite. The scale 2^k is applied in two steps so that each
// factor is a normal double and at most one rounding happens.
fn _exp_tail(x as f64, xl as f64) as f64 {
    if (x != x) { return x + x; }
    if (x > 709.8) { return 1.0e308 * 10.0; }
    if (x < -745.2) { return 0.0; }
    let is f64 as kd = x * 184.6649652337873 + 6755399441055744.0;
    let is f64 as nf = kd - 6755399441055744.0;
    let is f64 as r = ((x - nf * 0.005415212348452769) + nf * 3.2819649005320973e-13) + xl;
