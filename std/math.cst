                        + r2 * ((0.20000000023116724 + rh * -0.16666512276027132) + r2 * 0.14282413444730427)) - 0.5 * r2;
        let is f64 as lo = ((ef * 5.497923018708371e-14 + *cast(*f64, tp + 16)) + (((t - hi) + rh) + rl)) + q;
