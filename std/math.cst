// Everything log-like that is not a positive normal number: NaN, negative,
// zero, infinity, and subnormals (scaled by 2^54 first). which: 0 = log,
// 1 = log2, 2 = log10.
fn _log_special(x as f64, which as i32) as f64 {
    if (x != x) { return x + x; }
    if (x < 0.0) { return nan(); }
    if (x == 0.0) { return neg_inf(); }
