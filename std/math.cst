    let is f64 as p = r + r2 * ((0.5 + r * 0.16666666666670482) + r2 * (0.041666675772402524 + r * 0.008333328506356978));
    let is f64 as y = th + (th * p + *cast(*f64, tp + 8));
    let is i64 as k = n >> 7;
