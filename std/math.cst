    let is *u8 as tp = _LOG_T + ((tmp >> 45) & 127) * 24;
    let is i64 as mb = ix - (e << 52);
    let is f64 as m = *cast(*f64, &mb);
    let is f64 as invc = *cast(*f64, tp);
    let is f64 as sp = m * 134217729.0;
    let is f64 as mh = sp - (sp - m);
    let is f64 as a = mh * invc - 1.0;
    let is f64 as b = (m - mh) * invc;
    let is f64 as rh = a + b;
    let is f64 as bb = rh - a;
    let is f64 as rl = (a - (rh - bb)) + (b - bb);
    let is f64 as ef = cast(f64, e - eadj);
    let is f64 as t = ef * 0.6931471805598903 + *cast(*f64, tp + 8);
