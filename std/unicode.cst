// =======================================================
// std/unicode.cst
// Unicode text measurement — how wide a string is on a terminal, and where its
// grapheme cluster boundaries are.
//
//   use "std/unicode.cst" as unicode;
//   unicode.string_width(msg, len);              // columns, always >= 0
//   let is i64 as cols with mut = 0;
//   let is i64 as k = unicode.cluster_next(p, n, &cols);   // one cluster, no alloc
//   unicode.utf8.decode1(p, n, i, &cp);
//   unicode.grapheme.grapheme_count(cps, ncp);
//
// Top level rather than a subdirectory of a facade, because it is pure: no
// syscall, no descriptor, no allocator, no per-OS backend, nothing to dispatch
// on os.current(). It belongs beside string.cst, math.cst and sort.cst. It goes
// further than any of them, in fact — after the port dropped the heap code-point
// buffer that string_width used to allocate, this module imports nothing outside
// its own directory at all.
//
// SIZE, in the unit that matters. About 1,100 lines of code and 2.0 MB on disk.
// The line count is true and on its own misleading: the six generated tables in
// unicode/tables/ are single-line \xNN literals — gc 434 KB, gcb 339 KB, incb
// 329 KB, eaw 316 KB, extpict 294 KB, emojipres 294 KB — and they are most of
// std/ by bytes. They cost nothing at run time (.rodata, read through a
// two-level trie, no decode, no init beyond filling a pointer array once) and
// they cost real time in a grep.
//
// PROVENANCE. Ported from caustic-unicode
// (https://github.com/Caua726/caustic-unicode), which keeps tools/gen.cst and
// the UCD text files it parses. The tables here are byte-for-byte copies of what
// that generator emits, so a diff against that tree stays meaningful and a
// Unicode revision is a regenerate-and-copy rather than a rewrite. Their header
// line names that repository's regeneration command, not one that exists here.
// A generated table with no generator in reach is a table nobody ever updates.
//
// A resolution trap worth knowing if you extend this. A file inside this
// repository's std/ that says `use "std/mem.cst"` resolves to the INSTALLED
// ~/.local/lib/caustic/std/mem.cst, not this one — resolution is source-relative
// first and the stdlib search path last. Anything added under unicode/ uses the
// relative form ("../mem.cst"), the way every other std subdirectory module
// already does.
// =======================================================

use "unicode/width.cst"    as width;
use "unicode/grapheme.cst" as grapheme;
use "unicode/utf8.cst"     as utf8;
use "unicode/props.cst"    as props;
use "unicode/errno.cst"    as errno;

// --- the four calls a renderer actually makes ---

// Columns occupied by one code point: 0, 1, or 2.
fn cp_width(cp as i32) as i64 { return width.cp_width(cp); }

// cp_width with East-Asian Ambiguous counted as 2 in a CJK legacy locale.
fn cp_width_amb(cp as i32, ambiguous_wide as i64) as i64 { return width.cp_width_amb(cp, ambiguous_wide); }

// Advance over one grapheme cluster starting at a cluster boundary; writes its
// column count to *cols. Returns bytes consumed > 0; 0 when the buffer is
// finished and the caller must NOT advance; -1 when the bytes are not UTF-8, in
// which case *cols is 1 and the caller advances ONE byte. Allocates nothing, and
// is not resumable from an arbitrary offset — see unicode/width.cst.
fn cluster_next(src as *u8, n as i64, cols as *i64) as i64 { return width.cluster_next(src, n, cols); }

// Display width of a UTF-8 string in terminal columns. Always >= 0: a byte that
// is not UTF-8 counts as one column of U+FFFD rather than poisoning the total.
fn string_width(src as *u8, n as i64) as i64 { return width.string_width(src, n); }

// Display width of an array of code points, grapheme-cluster aware.
fn cp_run_width(cps as *i32, n as i64) as i64 { return width.cp_run_width(cps, n); }
