// =======================================================
// std/errors.cst — error helpers: runtime panic + assert
//
// Runtime errors only: panic/assert print to stderr and exit. Portable — they
// route through io, so they work on every target (serial on CausticOS).
//
// This module used to also carry compile-time stubs (unsupported, no_vfs,
// no_heap, no_network, no_processes, not_implemented, todo), each a thin
// wrapper over __compile_error. They could not work, and nothing called them:
//
//   * An unguarded __compile_error fires as soon as its enclosing function is
//     EMITTED — not when it is called. Function DCE does not remove an
//     uncalled function, so importing this module at all aborted the build
//     with "operation not supported on the target OS". The helpers were only
//     usable under --allow-unsupported, which is not what a helper is for.
//   * The check has to sit where the target is known, because that is what
//     makes the branch dead and lets it be eliminated. That is how it is done
//     at the real sites: `if (__target_is_causticos == 0) { __compile_error(
//     "..."); }` in std/causticos/*, and __compile_error inline in io.cst.
//
// So write __compile_error at the call site, inside the target guard. See
// ROADMAP.md.
//
// NOTE: io.cst does NOT import this module (it would create a cycle, since we
// import io for panic). io.cst uses __compile_error inline; everything else
// can use these helpers.
// =======================================================

use "io.cst" as io;

// === Runtime errors ===

// panic: print "panic: <msg>" to stderr and terminate the process (exit 1).
// Never returns. Portable across all targets via the io facade.
fn panic(msg as *u8) as void {
    io.write_str(io.STDERR, "panic: ");
    io.write_str(io.STDERR, msg);
    io.write_str(io.STDERR, "\n");
    io.exit(1);
}

// panic_code: like panic but with an explicit exit code.
fn panic_code(msg as *u8, code as i32) as void {
    io.write_str(io.STDERR, "panic: ");
    io.write_str(io.STDERR, msg);
    io.write_str(io.STDERR, "\n");
    io.exit(code);
}

// assert: if cond is false (0), panic with msg.
fn assert(cond as i32, msg as *u8) as void {
    if (cond == 0) { panic(msg); }
}
