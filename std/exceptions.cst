// =======================================================
// std/exceptions.cst — try / catch / throw, entirely in the stdlib.
//
// There is no `_Unwind_*` runtime to link (the binaries are static and carry
// no libc/libgcc), so this does its own non-local exit: a stack of handler
// frames, and a save/restore of the machine state written in inline asm. It
// is the classic setjmp/longjmp pair, expressed in Caustic.
//
// Usage — `begin` captures, `enter` registers, and the `if` is the catch:
//
//     use "std/exceptions.cst" as ex;
//
//     fn risky(n as i64) as i64 {
//         if (n < 0) { ex.throw(1); }
//         return n * 2;
//     }
//
//     fn main() as i32 {
//         let is ex.Frame as f;
//         let is i64 as code = ex.begin(&f);
//         if (code != 0) {
//             io.printf("caught %d\n", code);      // the catch block
//             return 1;
//         }
//         ex.enter(&f);
//         defer ex.leave(&f);                      // runs on every normal return
//         let is i64 as v = risky(-5);             // may throw
//         return cast(i32, v);
//     }
//
// `begin` must be a naked function: the context it saves is the CALLER's, so
// a throw resumes at the instruction after `begin`'s call, in the caller's
// frame, with the thrown value as `begin`'s result.
//
// Cleanup — a `defer` runs on a normal return, not on a throw. To release
// something on both paths, register a guard; `throw` runs every guard it
// unwinds past:
//
//     let is ex.Frame as g;
//     ex.guard(&g, fn_ptr(free_it), cast(i64, p));
//     defer ex.release(&g);                        // normal path: pop, do not run
//
// Limitations, deliberate:
//   * The handler stack is a plain global, not per-thread: the stdlib has no
//     TLS to hang it off (nothing initialises a thread pointer — `clone` is
//     handed &Thread, and the main thread has none at all, so reading fs:
//     would fault before it could tell). A throw that crosses threads is
//     therefore DETECTED rather than supported: the handler frame must be an
//     ancestor on this stack, and one that is not is diagnosed.
//   * The head belongs to this runtime image. Independently embedded copies
//     in an executable and a .so do not share handlers. On Linux x86_64, link
//     every participant with -lcaustic and import "std/exceptions.cst" so
//     begin/enter/throw all use the same libcaustic.so instance.
//   * No target without inline asm (wasm) can use this: the asm arm calls
//     __compile_error, so a wasm build that uses it fails at compile time.
//   * The try site is explicit. Without macros the catch is an `if` on
//     `begin`'s result; `enter` must precede anything that can throw, and a
//     throw with nothing entered is an uncaught panic.
// =======================================================

use "io.cst" as io;

// Machine state saved by `begin` and restored by a throw.
//
// The asm reads this layout by fixed byte offset, so the field order is part
// of the interface: `ctx` MUST stay first, and the offsets are
//   0   ctx    16 i64  —  x86_64: rbx rbp r12 r13 r14 r15 rsp rip
//                         aarch64: x19..x28 x29 x30 sp
//   128 prev   *Frame  — the frame below this one on the handler stack
//   136 cleanup *u8    — the cleanup to run (guard frames)
//   144 arg    i64     — its argument
//   152 kind   i32     — 0 = catch, 1 = guard
//   156 state  i32     — 0 = idle, 1 = registered, 2 = unwound past
//   160 class  i64     — FRAME_CLASS, so a stale or foreign frame is caught
struct Frame {
    ctx as [16]i64;
    prev as *Frame;
    cleanup as *u8;
    arg as i64;
    kind as i32;
    state as i32;
    class as i64;
}

let is i32 as KIND_CATCH with imut = 0;
let is i32 as KIND_GUARD with imut = 1;

let is i32 as STATE_IDLE with imut = 0;
let is i32 as STATE_LIVE with imut = 1;
let is i32 as STATE_UNWOUND with imut = 2;

// Stamped by `enter`/`guard` and checked on every pop. A frame that is not
// ours — or one that was never initialised — is a bug, not something to
// unwind through.
let is i64 as FRAME_CLASS with imut = 7595458606938820947;

// Top of the handler stack; the innermost frame is the head.
let is *Frame as _head with mut = cast(*Frame, 0);

// Save the CALLER's machine state into f.ctx and return 0. The caller's
// context is what a throw restores, so this must be naked: with a prologue it
// would save its own frame, which is gone by the time the throw happens.
fn begin(f as *Frame) as i64 with naked {
    if (__target_is_aarch64 == 1) {
        asm("str x19, [x0]\nstr x20, [x0, 8]\nstr x21, [x0, 16]\nstr x22, [x0, 24]\nstr x23, [x0, 32]\nstr x24, [x0, 40]\nstr x25, [x0, 48]\nstr x26, [x0, 56]\nstr x27, [x0, 64]\nstr x28, [x0, 72]\nstr x29, [x0, 80]\nstr x30, [x0, 88]\nmov x1, sp\nstr x1, [x0, 96]\nmov x0, 0\nret\n");
    } else {
        // [rsp] is the return address, [rsp+8] the caller's rsp once this
        // returns; rbp is already the caller's, a naked function not having
        // touched it.
        asm("mov [rdi], rbx\nmov [rdi+8], rbp\nmov [rdi+16], r12\nmov [rdi+24], r13\nmov [rdi+32], r14\nmov [rdi+40], r15\nlea rax, [rsp+8]\nmov [rdi+48], rax\nmov rax, [rsp]\nmov [rdi+56], rax\nxor eax, eax\nret\n");
    }
    return 0;
}

// Restore f.ctx and jump to it, resuming f's frame with v as the result of
// its `begin` call. Never returns. Args are in rdi/rsi (x0/x1): Caustic's own
// calling convention keeps the System V registers on every x86_64 target, so
// one arm covers Linux and Windows.
fn _jump(f as *Frame, v as i64) as void with naked {
    if (__target_is_aarch64 == 1) {
        asm("ldr x19, [x0]\nldr x20, [x0, 8]\nldr x21, [x0, 16]\nldr x22, [x0, 24]\nldr x23, [x0, 32]\nldr x24, [x0, 40]\nldr x25, [x0, 48]\nldr x26, [x0, 56]\nldr x27, [x0, 64]\nldr x28, [x0, 72]\nldr x29, [x0, 80]\nldr x30, [x0, 88]\nldr x9, [x0, 96]\nmov sp, x9\nmov x0, x1\nret\n");
    } else {
        asm("mov r11, [rdi+56]\nmov rax, rsi\nmov rbx, [rdi]\nmov rbp, [rdi+8]\nmov r12, [rdi+16]\nmov r13, [rdi+24]\nmov r14, [rdi+32]\nmov r15, [rdi+40]\nmov rsp, [rdi+48]\njmp r11\n");
    }
}

// Register f as a catch handler. Call it after `begin` returned 0 and before
// anything that can throw.
fn enter(f as *Frame) as void {
    f.kind = KIND_CATCH;
    f.state = STATE_LIVE;
    f.class = FRAME_CLASS;
    f.prev = _head;
    _head = f;
}

// Unregister f on the normal path.
//
// A `defer leave(&f)` also fires on the catch path, where a throw has already
// popped f — that is why STATE_UNWOUND is not an error. Anything else (f is
// neither the head nor already unwound) means the caller's begin/enter/leave
// pairing is wrong, and silently ignoring it would corrupt the stack.
fn leave(f as *Frame) as void {
    if (f.class != FRAME_CLASS) { _bad_frame(); }
    if (f.state == STATE_UNWOUND) { return; }
    if (_head != f) { _misuse("leave() on a frame that is not the head"); }
    f.state = STATE_UNWOUND;
    _head = f.prev;
}

// Register a cleanup to run if a throw unwinds past this point. Pair it with
// `defer release(&g)` so the normal path pops it without running it.
fn guard(g as *Frame, cleanup as *u8, arg as i64) as void {
    g.kind = KIND_GUARD;
    g.state = STATE_LIVE;
    g.class = FRAME_CLASS;
    g.cleanup = cleanup;
    g.arg = arg;
    g.prev = _head;
    _head = g;
}

fn release(g as *Frame) as void {
    if (g.class != FRAME_CLASS) { _bad_frame(); }
    if (g.state == STATE_UNWOUND) { return; }
    if (_head != g) { _misuse("release() on a frame that is not the head"); }
    g.state = STATE_UNWOUND;
    _head = g.prev;
}

// Read the caller's frame pointer. Naked: with a prologue this would return
// its own rbp, and the whole chain hangs off the caller's.
fn _fp() as i64 with naked {
    if (__target_is_aarch64 == 1) { asm("mov x0, x29\nret\n"); }
    else { asm("mov rax, rbp\nret\n"); }
    return 0;
}

fn _hex(fd as i64, v as i64) as void {
    if (v == 0) { io.write_str(fd, "0"); return; }
    let is [16]u8 as buf;
    let is i32 as i with mut = 16;
    let is i64 as x with mut = v;
    while (x != 0 && i > 0) {
        i = i - 1;
        let is i32 as d = cast(i32, x & 15);
        let is i32 as ch with mut = 48 + d;
        if (d > 9) { ch = 87 + d; }              // 'a' - 10
        buf[i] = cast(u8, ch);
        x = x >> 4;
    }
    io._write_fd(fd, cast(*u8, cast(i64, &buf) + cast(i64, i)), cast(i64, 16 - i));
}

// === Unwinding through .eh_frame ===
//
// At -O2 a function may run without a frame pointer (the compiler drops rbp
// where the image carries unwind tables: __unwind_tables). Its frame is then
// described only by the CFI the compiler emits, which caustic-ld turns into
// .eh_frame plus the sorted lookup table .eh_frame_hdr, and defines
// `__eh_frame_hdr` at its address (0 when the image has none).
//
// The walk below reads exactly what Caustic's assembler emits: per function a
// CIE (CFA = rsp+8, return address at CFA-8) and an FDE whose instructions are
// advance_loc*, def_cfa, def_cfa_offset, def_cfa_register and offset. For one
// frame it runs those up to the pc, then: CFA = rsp or rbp + offset, the
// return address is at CFA-8, rbp is restored if the frame saved it, and the
// caller's rsp is the CFA. Anything else in the stream stops the walk.
//
// A pc with no FDE (the entry stub, hand-written naked asm) takes one step
// along the frame-pointer chain instead, as the old walk did.

fn _eh_hdr() as i64 with naked {
    if (__unwind_tables == 1) { asm(".globl __eh_frame_hdr\nlea rax, [rip+__eh_frame_hdr]\nret\n"); }
    else { asm("xor eax, eax\nret\n"); }
    return 0;
}

// Caller's rsp (past the return address), its pc (the return address) and rbp.
fn _regs(out as *i64) as void with naked {
    asm("lea rax, [rsp+8]\nmov [rdi], rax\nmov rax, [rsp]\nmov [rdi+8], rax\nmov [rdi+16], rbp\nret\n");
}

fn _rd8(a as i64) as i64 { let is *u8 as p = cast(*u8, a); return cast(i64, p[0]); }
fn _rd32(a as i64) as i64 { let is *i32 as p = cast(*i32, a); return cast(i64, p[0]); }
fn _rdu32(a as i64) as i64 { return _rd32(a) & 4294967295; }
fn _rd64(a as i64) as i64 { let is *i64 as p = cast(*i64, a); return p[0]; }

// LEB128 at *pos; advances *pos.
fn _uleb(pos as *i64) as i64 {
    let is i64 as r with mut = 0;
    let is i64 as sh with mut = 0;
    while (sh < 64) {
        let is i64 as b = _rd8(*pos);
        *pos = *pos + 1;
        r = r | ((b & 127) << sh);
        sh = sh + 7;
        if ((b & 128) == 0) { return r; }
    }
    return r;
}

fn _sleb(pos as *i64) as i64 {
    let is i64 as r with mut = 0;
    let is i64 as sh with mut = 0;
    let is i64 as b with mut = 128;
    while ((b & 128) != 0 && sh < 64) {
        b = _rd8(*pos);
        *pos = *pos + 1;
        r = r | ((b & 127) << sh);
        sh = sh + 7;
    }
    if (sh < 64 && (b & 64) != 0) { r = r | ((0 - 1) << sh); }
    return r;
}

// The FDE covering pc, or 0. The table is (initial_location, fde) pairs as
// sdata4 offsets from the header, sorted by location.
fn _eh_find(hdr as i64, pc as i64) as i64 {
    if (_rd8(hdr) != 1 || _rd8(hdr + 2) != 3 || _rd8(hdr + 3) != 59) { return 0; }
    let is i64 as n = _rdu32(hdr + 8);
    let is i64 as tab = hdr + 12;
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = n;
    while (lo + 1 < hi) {
        let is i64 as mid = (lo + hi) / 2;
        if (hdr + _rd32(tab + mid * 8) <= pc) { lo = mid; } else { hi = mid; }
    }
    if (n == 0 || hdr + _rd32(tab + lo * 8) > pc) { return 0; }
    return hdr + _rd32(tab + lo * 8 + 4);
}

// CFA rule and saved-rbp rule after running a CFI stream up to `upto`.
struct _CfiState {
    loc as i64;
    reg as i64;     // DWARF register of the CFA base: 7 = rsp, 6 = rbp
    off as i64;
    rbp_off as i64; // where rbp was saved, relative to the CFA; 0 = not saved
    bad as i64;
}

fn _cfi_run(st as *_CfiState, start as i64, end as i64, upto as i64, caf as i64, daf as i64) as void {
    let is i64 as p with mut = start;
    while (p < end && st.bad == 0) {
        let is i64 as op = _rd8(p);
        p = p + 1;
        let is i64 as hi2 = op & 192;
        let is i64 as delta with mut = 0 - 1;
        if (hi2 == 64) { delta = (op & 63) * caf; }
        else if (op == 2) { delta = _rd8(p) * caf; p = p + 1; }
        else if (op == 3) { delta = (_rd8(p) | (_rd8(p + 1) << 8)) * caf; p = p + 2; }
        else if (op == 4) { delta = _rdu32(p) * caf; p = p + 4; }
        if (delta >= 0) {
            if (st.loc + delta > upto) { return; }
            st.loc = st.loc + delta;
        } else if (hi2 == 128) {
            let is i64 as o = _uleb(&p) * daf;
            if ((op & 63) == 6) { st.rbp_off = o; }
        } else if (op == 12) {
            st.reg = _uleb(&p);
            st.off = _uleb(&p);
        } else if (op == 13) {
            st.reg = _uleb(&p);
        } else if (op == 14) {
            st.off = _uleb(&p);
        } else if (op != 0) {
            st.bad = 1;
        }
    }
}

// One frame up from (sp, pc, bp) through its FDE. Returns 1 and updates the
// three, or 0 when the frame cannot be described.
fn _eh_step(fde as i64, r as *i64) as i32 {
    let is i64 as pc = r[1] - 1;          // inside the call, not past it
    let is i64 as fend = fde + 4 + _rdu32(fde);
    let is i64 as cie = fde + 4 - _rdu32(fde + 4);
    let is i64 as cend = cie + 4 + _rdu32(cie);
    // CIE: version, "zR", code/data alignment, return register, aug data.
    let is i64 as q with mut = cie + 9;
    if (_rd8(cie + 9) != 122 || _rd8(cie + 10) != 82 || _rd8(cie + 11) != 0) { return 0; }
    q = cie + 12;
    let is i64 as caf = _uleb(&q);
    let is i64 as daf = _sleb(&q);
    q = q + 1;                            // return address register
    _uleb(&q);                            // augmentation length
    let is i64 as enc = _rd8(q);
    q = q + 1;
    // FDE: pc_begin, pc_range in the CIE's encoding, then augmentation data.
    let is i64 as f with mut = fde + 8;
    let is i64 as begin with mut = 0;
    let is i64 as range with mut = 0;
    if (enc == 0) { begin = _rd64(f); range = _rd64(f + 8); f = f + 16; }
    else if (enc == 27) { begin = f + _rd32(f); range = _rd32(f + 4); f = f + 8; }
    else { return 0; }
    if (pc < begin || pc >= begin + range) { return 0; }
    let is i64 as alen = _uleb(&f);
    f = f + alen;

    let is _CfiState as st;
    st.loc = begin; st.reg = 7; st.off = 8; st.rbp_off = 0; st.bad = 0;
    _cfi_run(&st, q, cend, pc, caf, daf);
    _cfi_run(&st, f, fend, pc, caf, daf);
    if (st.bad != 0) { return 0; }
    let is i64 as base with mut = 0;
    if (st.reg == 7) { base = r[0]; }
    else if (st.reg == 6) { base = r[2]; }
    else { return 0; }
    let is i64 as cfa = base + st.off;
    if (cfa <= r[0]) { return 0; }
    if (st.rbp_off != 0) { r[2] = _rd64(cfa + st.rbp_off); }
    r[1] = _rd64(cfa - 8);
    r[0] = cfa;
    return 1;
}

// Print the return addresses up the stack.
//
// With unwind tables (see above) every frame is stepped through its FDE;
// without them, and for a pc no FDE covers, along the frame-pointer chain:
// [fp] is the caller's frame pointer and [fp+8] its return address. A function
// that runs without a frame pointer leaves rbp untouched, so the chain stays
// valid and just skips such frames — that is all a build without unwind
// tables can show.
//
// Addresses only. `.symtab` and `.debug_*` are in the file, not in the loaded
// image, so naming them means emitting a loadable name table — a separate
// job. Until then `llvm-symbolizer`/`addr2line` over the addresses is the way.
//
// The walk is bounded and must climb: the stack grows down, so every caller's
// frame is strictly above the callee's. A walk that stops climbing is corrupt
// and stops rather than looping.
fn backtrace(fd as i64, skip as i32) as void {
    let is [3]i64 as r;                   // rsp, pc, rbp of the frame being stepped
    let is i64 as hdr with mut = 0;
    if (__target_is_aarch64 == 0) {
        _regs(cast(*i64, &r));
        hdr = _eh_hdr();
    } else {
        // aarch64: the chain only, starting from this function's caller.
        r[2] = _fp();
    }
    let is i32 as n with mut = 0;
    while (n < 32) {
        let is i32 as ok with mut = 0;
        if (hdr != 0) {
            let is i64 as fde = _eh_find(hdr, r[1] - 1);
            if (fde != 0) { ok = _eh_step(fde, cast(*i64, &r)); }
        }
        if (ok == 0) {
            // frame-pointer chain: [rbp] = caller's rbp, [rbp+8] = return address
            let is i64 as fp = r[2];
            if (fp == 0 || (hdr != 0 && fp < r[0])) { return; }
            let is *i64 as p = cast(*i64, fp);
            let is i64 as next = p[0];
            r[1] = p[1];
            r[0] = fp + 16;
            r[2] = next;
            if (next != 0 && next <= fp) { n = 32; }
        }
        if (r[1] == 0) { return; }
        if (n >= skip) {
            io.write_str(fd, "  #");
            io.write_int(fd, cast(i64, n - skip));
            io.write_str(fd, "  0x");
            _hex(fd, r[1]);
            io.write_str(fd, "\n");
        }
        n = n + 1;
    }
}

// A throw that finds no handler is a bug in the program, not a value. This
// does not go through std/errors.cst: importing that module at all compiles
// its __compile_error stubs, which abort the build (it is only usable under
// --allow-unsupported).
fn _uncaught(v as i64) as void {
    io.write_str(io.STDERR, "panic: uncaught exception ");
    io.write_int(io.STDERR, v);
    io.write_str(io.STDERR, "\n");
    backtrace(io.STDERR, 0);
    io.exit(1);
}

fn _misuse(msg as *u8) as void {
    io.write_str(io.STDERR, "panic: exceptions misused: ");
    io.write_str(io.STDERR, msg);
    io.write_str(io.STDERR, "\n");
    io.exit(2);
}

fn _bad_frame() as void {
    io.write_str(io.STDERR, "panic: exceptions: handler stack corrupted\n");
    io.exit(3);
}

// The stack pointer a handler frame was entered on. Slot 6 holds rsp on
// x86_64, slot 12 holds sp on aarch64 — see the Frame layout comment.
fn _frame_sp(f as *Frame) as i64 {
    if (__target_is_aarch64 == 1) { return f.ctx[12]; }
    return f.ctx[6];
}

// A registered handler must be an ANCESTOR frame on this thread's stack, so
// the stack pointer it saved is above anything this throw can address. A
// frame that fails this is stale (its stack region is gone) or belongs to
// another thread — the one case the process-global head cannot handle. Better
// to say so than to jump into a dead frame.
fn _check_ancestor(f as *Frame, here as i64) as void {
    if (_frame_sp(f) <= here) {
        io.write_str(io.STDERR, "panic: exceptions: handler frame is not an ancestor on this stack\n");
        io.exit(4);
    }
}

// Unwind to the innermost catch handler.
//
// Two phases, like a real unwinder, and for a real reason: phase 1 only LOOKS
// for the handler. If there is none the program aborts having run nothing —
// tearing state down and then dying is strictly worse than dying.
fn throw(v as i64) as void {
    let is i64 as anchor with mut = 0;
    let is i64 as here = cast(i64, &anchor);

    // Phase 1: search. Nothing is popped, no cleanup runs.
    let is *Frame as f with mut = _head;
    let is i32 as found with mut = 0;
    while (cast(i64, f) != 0) {
        if (f.class != FRAME_CLASS) { _bad_frame(); }
        if (f.kind == KIND_CATCH && f.state == STATE_LIVE) {
            _check_ancestor(f, here);
            found = 1;
            break;
        }
        f = f.prev;
    }
    if (found == 0) { _uncaught(v); }

    // Phase 2: cleanups between the head and the handler, innermost first,
    // then hand control to it. A cleanup that throws continues from wherever
    // the walk got to, which is defined: the frames below are still intact.
    while (_head != f) {
        let is *Frame as g = _head;
        if (g.class != FRAME_CLASS) { _bad_frame(); }
        let is *u8 as cb = g.cleanup;
        let is i64 as a = g.arg;
        g.state = STATE_UNWOUND;
        _head = g.prev;
        call(cb, a);
    }
    f.state = STATE_UNWOUND;
    _head = f.prev;
    _jump(f, v);
}
