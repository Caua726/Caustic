// =======================================================
// std/mem/x86rep.cst — rep movsb / rep stosb, for the sizes where the string
// instructions beat a loop (see memcpy/memset in core.cst for when). Imported
// by core.cst only on x86_64 targets; every Caustic call on x86_64 (Windows
// included) passes dst in rdi, the source or byte in rsi, n in rdx, and the
// direction flag is clear at every call.
// =======================================================

// Copy n bytes from src to dst (no overlap).
fn rep_movsb(dst as *u8, src as *u8, n as i64) as void with naked {
    asm("mov rcx, rdx\nrep movsb\nret\n");
}

// Fill n bytes at dst with the low byte of c. The assembler has no stosb
// mnemonic: F3 AA is rep stosb.
fn rep_stosb(dst as *u8, c as i32, n as i64) as void with naked {
    asm("mov eax, esi\nmov rcx, rdx\n.byte 0xf3, 0xaa\nret\n");
}
