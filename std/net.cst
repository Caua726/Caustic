// =======================================================
// std/net.cst
// Networking primitives (IPv4 TCP/UDP)
// =======================================================

use "os.cst" as os;
if (__target_is_linux + __compat_mode)   use "os/linux.cst"   as linux;
if (__target_is_windows + __compat_mode) use "os/windows.cst" as win;
use "mem.cst" only bins, core as mem;
use "io.cst" as io;
use "compatcffi.cst" as cffi;
use "string.cst" as str;

// === Cross-target socket dispatchers ===
// Each helper picks the right backend at parse-time via const-prop. The
// inactive branch is dead-stripped before codegen so neither Linux nor
// Windows pays for the other's path.

// Windows requires WSAStartup before any winsock call. Auto-init on first
// use of any dispatcher — cheaper than asking the user to call net.init().
let is i32 as _wsa_inited with mut = 0;
let is [408]u8 as _wsa_data;

fn _ensure_wsa() as void {
    if (os.current() == os.OS_WINDOWS) {
        if (_wsa_inited == 0) {
            win.WSAStartup(514, &_wsa_data);          // MAKEWORD(2, 2) = 0x0202
            _wsa_inited = 1;
        }
    }
}

fn init() as i32 {
    _ensure_wsa();
    return 0;
}

fn cleanup() as i32 {
    if (os.current() == os.OS_WINDOWS) {
        if (_wsa_inited == 1) {
            win.WSACleanup();
            _wsa_inited = 0;
        }
    }
    return 0;
}

fn _sock_create(af as i32, sock_type as i32, proto as i32) as i64 {
    _ensure_wsa();
    if (os.current() == os.OS_LINUX) {
        return linux.socket(cast(i64, af), cast(i64, sock_type), cast(i64, proto));
    }
    if (os.current() == os.OS_WINDOWS) {
        return win.WSASocketA(af, sock_type, proto, cast(*u8, 0), 0, 0);
    }
    return 0 - 1;
}

fn _sock_close(s as i64) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.close(s); }
    if (os.current() == os.OS_WINDOWS) { return cast(i64, win.closesocket(s)); }
    return 0 - 1;
}

fn _sock_bind(s as i64, addr as *u8, addrlen as i64) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.bind(s, addr, addrlen); }
    if (os.current() == os.OS_WINDOWS) { return cast(i64, win.bind(s, addr, cast(i32, addrlen))); }
    return 0 - 1;
}

fn _sock_listen(s as i64, backlog as i64) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.listen(s, backlog); }
    if (os.current() == os.OS_WINDOWS) { return cast(i64, win.listen(s, cast(i32, backlog))); }
    return 0 - 1;
}

fn _sock_accept(s as i64, addr as *u8, addrlen as *u32) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.accept(s, addr, addrlen); }
    if (os.current() == os.OS_WINDOWS) {
        let is i32 as alen with mut = 0;
        if (cast(i64, addrlen) != 0) { alen = cast(i32, *addrlen); }
        let is i64 as r = win.accept(s, addr, &alen);
        if (cast(i64, addrlen) != 0) { *addrlen = cast(u32, alen); }
        return r;
    }
    return 0 - 1;
}

fn _sock_connect(s as i64, addr as *u8, addrlen as i64) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.connect(s, addr, addrlen); }
    if (os.current() == os.OS_WINDOWS) { return cast(i64, win.connect(s, addr, cast(i32, addrlen))); }
    return 0 - 1;
}

fn _sock_setopt(s as i64, level as i64, opt as i64, val as *u8, vlen as i64) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.setsockopt(s, level, opt, val, vlen); }
    if (os.current() == os.OS_WINDOWS) { return cast(i64, win.setsockopt(s, cast(i32, level), cast(i32, opt), val, cast(i32, vlen))); }
    return 0 - 1;
}

fn _sock_send(s as i64, buf as *u8, len as i64, flags as i64) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.sendto(s, buf, len, flags, cast(*u8, 0), 0); }
    if (os.current() == os.OS_WINDOWS) { return cast(i64, win.send(s, buf, cast(i32, len), cast(i32, flags))); }
    return 0 - 1;
}

fn _sock_recv(s as i64, buf as *u8, len as i64, flags as i64) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.recvfrom(s, buf, len, flags, cast(*u8, 0), cast(*u32, 0)); }
    if (os.current() == os.OS_WINDOWS) { return cast(i64, win.recv(s, buf, cast(i32, len), cast(i32, flags))); }
    return 0 - 1;
}

fn _sock_sendto(s as i64, buf as *u8, len as i64, flags as i64, to as *u8, tolen as i64) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.sendto(s, buf, len, flags, to, tolen); }
    if (os.current() == os.OS_WINDOWS) {
        return cast(i64, win.sendto(s, buf, cast(i32, len), cast(i32, flags),
                                    to, cast(i32, tolen)));
    }
    return 0 - 1;
}

fn _sock_recvfrom(s as i64, buf as *u8, len as i64, flags as i64, from as *u8, fromlen as *u32) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.recvfrom(s, buf, len, flags, from, fromlen); }
    if (os.current() == os.OS_WINDOWS) {
        return cast(i64, win.recvfrom(s, buf, cast(i32, len), cast(i32, flags),
                                      from, cast(*i32, fromlen)));
    }
    return 0 - 1;
}

fn _sock_set_nonblock(s as i64) as i64 {
    if (os.current() == os.OS_LINUX) {
        let is i64 as flags = linux.fcntl(s, linux.F_GETFL, 0);
        if (flags < 0) { return flags; }
        return linux.fcntl(s, linux.F_SETFL, flags | linux.O_NONBLOCK);
    }
    if (os.current() == os.OS_WINDOWS) {
        let is u32 as on with mut = 1;
        return cast(i64, win.ioctlsocket(s, win.W_FIONBIO, &on));
    }
    return 0 - 1;
}

fn _sock_poll(fds as *u8, n as i64, timeout_ms as i64) as i64 {
    if (os.current() == os.OS_LINUX)   { return linux.poll(fds, n, timeout_ms); }
    if (os.current() == os.OS_WINDOWS) { return cast(i64, win.WSAPoll(fds, cast(u32, n), cast(i32, timeout_ms))); }
    return 0 - 1;
}

let is mem.Bins as _bins with mut;
let is i32 as _ready with mut = 0;

fn _alloc(size as i64) as *u8 {
    if (_ready == 0) { _bins = mem.bins.bins_new(16384); _ready = 1; }
    return mem.bins.bins_alloc(&_bins, size);
}

fn _free(ptr as *u8) as void {
    if (_ready == 1) { mem.bins.bins_free(&_bins, ptr); }
}

// --- Section 1: Constants ---

// sockaddr_in layout: sin_family(2) + sin_port(2) + sin_addr(4) + padding(8) = 16 bytes
let is i64 as SOCKADDR_IN_SIZE with imut = 16;

// Cross-target socket constants. Linux and Windows agree on most TCP/UDP
// numerics (AF_INET=2, SOCK_STREAM=1, IPPROTO_TCP=6, TCP_NODELAY=1, POLLIN=1,
// POLLOUT=4) but disagree on SOL_SOCKET (1 vs 65535) and the SO_* family.
// We pick per-target literals via the same __target_is_X * value trick used
// by os.current(), then const-prop folds each at use sites.
let is i64 as SOL_SOCKET    with imut = (__target_is_linux * 1) + (__target_is_windows * 65535);
let is i64 as SO_REUSEADDR  with imut = (__target_is_linux * 2) + (__target_is_windows * 4);
let is i64 as SO_REUSEPORT  with imut = (__target_is_linux * 15) + (__target_is_windows * 4); // Win lacks SO_REUSEPORT; fall back to SO_REUSEADDR
let is i64 as SO_KEEPALIVE  with imut = (__target_is_linux * 9) + (__target_is_windows * 8);
let is i64 as SO_RCVTIMEO   with imut = (__target_is_linux * 20) + (__target_is_windows * 4102);
let is i64 as SO_SNDTIMEO   with imut = (__target_is_linux * 21) + (__target_is_windows * 4101);
let is i64 as POLLIN_FLAG   with imut = 1;
let is i64 as POLLOUT_FLAG  with imut = 4;

// TCP level options — same numeric on both targets.
let is i64 as IPPROTO_TCP_LVL with imut = 6;
let is i64 as TCP_NODELAY     with imut = 1;

// Special addresses
let is i64 as INADDR_ANY       with imut = 0;
let is i64 as INADDR_LOOPBACK  with imut = 2130706433;

// MSG flags
let is i64 as MSG_DONTWAIT with imut = 64;

// A signal arrived before ANY data moved, so the call transferred nothing and
// is meant to be retried — it is not a transfer error. Linux syscalls report it
// as the negated errno, which is what the loops below compare against. The
// Windows path returns SOCKET_ERROR (-1) with the code behind WSAGetLastError,
// so this value never matches there; WSAEINTR only arises from the legacy
// WSACancelBlockingCall, which this stdlib never issues.
let is i64 as EINTR with imut = 4;

// Backlog
let is i64 as DEFAULT_BACKLOG with imut = 128;

// --- Section 2: Addr struct and functions ---

struct Addr {
    data as *u8;
}

// Build an IPv4 address from 4 octets: ip4(192, 168, 1, 1) -> host byte order u32
fn ip4(a as i64, b as i64, c as i64, d as i64) as i64 {
    return (a << 24) + (b << 16) + (c << 8) + d;
}

// Create an Addr from ip (host byte order) and port
// Usage: let is [16]u8 as buf; let is Addr as a = addr_init(&buf, ip4(127,0,0,1), 8080);
fn addr_init(buf as *u8, ip as i64, port as i64) as Addr {
    mem.core.memset(buf, cast(i32, 0), 16);
    // sin_family = AF_INET (2) at offset 0, little-endian u16
    buf[0] = 2;
    buf[1] = 0;
    // sin_port at offset 2, network byte order (big-endian u16)
    buf[2] = cast(u8, (port >> 8) & 255);
    buf[3] = cast(u8, port & 255);
    // sin_addr at offset 4, network byte order (big-endian u32)
    buf[4] = cast(u8, (ip >> 24) & 255);
    buf[5] = cast(u8, (ip >> 16) & 255);
    buf[6] = cast(u8, (ip >> 8) & 255);
    buf[7] = cast(u8, ip & 255);
    let is Addr as a;
    a.data = buf;
    return a;
}

fn addr_any(buf as *u8, port as i64) as Addr {
    return addr_init(buf, INADDR_ANY, port);
}

fn addr_loopback(buf as *u8, port as i64) as Addr {
    return addr_init(buf, INADDR_LOOPBACK, port);
}

// Extract port from addr (host byte order)
fn addr_port(a as Addr) as i64 {
    // Bytes are already in network order (big-endian), extract directly
    return cast(i64, a.data[2]) * 256 + cast(i64, a.data[3]);
}

// Extract IP from addr as host byte order i64
fn addr_ip(a as Addr) as i64 {
    // Bytes are in network order (big-endian), extract directly
    return (cast(i64, a.data[4]) << 24) + (cast(i64, a.data[5]) << 16) + (cast(i64, a.data[6]) << 8) + cast(i64, a.data[7]);
}

// Internal: write decimal number to buf at offset, return chars written
fn _write_octet(buf as *u8, offset as i64, val as i64) as i64 {
    if (val >= 100) {
        buf[offset] = cast(u8, val / 100 + 48);
        buf[offset + 1] = cast(u8, (val / 10) % 10 + 48);
        buf[offset + 2] = cast(u8, val % 10 + 48);
        return 3;
    }
    if (val >= 10) {
        buf[offset] = cast(u8, val / 10 + 48);
        buf[offset + 1] = cast(u8, val % 10 + 48);
        return 2;
    }
    buf[offset] = cast(u8, val + 48);
    return 1;
}

// Format IP as "a.b.c.d" into a buffer, returns length written
fn ip4_format(ip as i64, buf as *u8) as i64 {
    let is i64 as a = (ip >> 24) & 255;
    let is i64 as b = (ip >> 16) & 255;
    let is i64 as c = (ip >> 8) & 255;
    let is i64 as d = ip & 255;
    let is i64 as pos with mut = 0;
    pos = pos + _write_octet(buf, pos, a);
    buf[pos] = 46;
    pos = pos + 1;
    pos = pos + _write_octet(buf, pos, b);
    buf[pos] = 46;
    pos = pos + 1;
    pos = pos + _write_octet(buf, pos, c);
    buf[pos] = 46;
    pos = pos + 1;
    pos = pos + _write_octet(buf, pos, d);
    buf[pos] = 0;
    return pos;
}

// Parse "a.b.c.d" to host byte order i64. Returns 0 on parse error.
fn ip4_parse(s as *u8) as i64 {
    let is i64 as octets with mut = 0;
    let is i64 as result with mut = 0;
    let is i64 as current with mut = 0;
    let is i64 as i with mut = 0;

    while (s[i] != 0) {
        if (s[i] == 46) {
            if (current > 255) { return 0 - 1; }
            result = (result << 8) + current;
            current = 0;
            octets = octets + 1;
        } else if (s[i] >= 48) {
            if (s[i] <= 57) {
                current = current * 10 + cast(i64, s[i]) - 48;
            } else {
                return 0 - 1;
            }
        } else {
            return 0 - 1;
        }
        i = i + 1;
    }
    if (current > 255) { return 0 - 1; }
    result = (result << 8) + current;
    octets = octets + 1;

    if (octets != 4) { return 0 - 1; }
    return result;
}

// --- Section 2b: IPv6 ---
//
// A parallel type rather than a wider Addr. sockaddr_in6 is 28 bytes and
// carries a scope id that has no analogue in sockaddr_in, so folding both into
// one struct would either grow every IPv4 buffer in existing code or hide a
// family tag behind accessors that currently just read fixed offsets. Addr
// stays exactly what it was; code that wants v6 asks for v6.
//
// The cost is a doubled entry-point set (tcp_connect6, tcp_listen6, ...) and an
// `if` in callers that must handle both families. That is the deliberate trade:
// nothing existing changes behaviour.

// AF_INET6 is one of the few socket constants the two targets disagree on.
let is i64 as AF_INET6 with imut = (__target_is_linux * 10) + (__target_is_windows * 23);

// sockaddr_in6: sin6_family(2) + sin6_port(2) + sin6_flowinfo(4)
//             + sin6_addr(16) + sin6_scope_id(4) = 28 bytes
let is i64 as SOCKADDR_IN6_SIZE with imut = 28;

struct Addr6 {
    data as *u8;
}

// Build an Addr6 over a 28-byte buffer. `ip` is 16 raw bytes in network order —
// use ip6_parse to get them from text, or ip6_any / ip6_loopback.
// Usage: let is [28]u8 as buf; let is Addr6 as a = addr6_init(&buf[0], ip, 8443);
fn addr6_init(buf as *u8, ip as *u8, port as i64) as Addr6 {
    mem.core.memset(buf, cast(i32, 0), 28);
    buf[0] = cast(u8, AF_INET6 & 255);
    buf[1] = cast(u8, (AF_INET6 >> 8) & 255);
    // sin6_port at offset 2, network byte order
    buf[2] = cast(u8, (port >> 8) & 255);
    buf[3] = cast(u8, port & 255);
    // sin6_flowinfo (offset 4) stays zero; sin6_addr at offset 8
    if (cast(i64, ip) != 0) {
        mem.core.memcpy(cast(*u8, cast(i64, buf) + 8), ip, 16);
    }
    let is Addr6 as a;
    a.data = buf;
    return a;
}

// The unspecified address, "::" — bind to every v6 interface.
fn addr6_any(buf as *u8, port as i64) as Addr6 {
    return addr6_init(buf, cast(*u8, 0), port);
}

// "::1"
fn addr6_loopback(buf as *u8, port as i64) as Addr6 {
    let is [16]u8 as ip;
    mem.core.memset(&ip[0], cast(i32, 0), 16);
    ip[15] = 1;
    return addr6_init(buf, &ip[0], port);
}

fn addr6_port(a as Addr6) as i64 {
    return cast(i64, a.data[2]) * 256 + cast(i64, a.data[3]);
}

// Pointer to the 16 raw address bytes inside the sockaddr — not a copy.
fn addr6_ip(a as Addr6) as *u8 {
    return cast(*u8, cast(i64, a.data) + 8);
}

// sin6_scope_id: the interface index a link-local address ("fe80::1%eth0") is
// scoped to. Zero for global addresses; a link-local one will not connect
// without it, which is the part that has no IPv4 analogue.
fn addr6_scope(a as Addr6) as i64 {
    let is *u8 as p = cast(*u8, cast(i64, a.data) + 24);
    return cast(i64, p[0]) + cast(i64, p[1]) * 256 + cast(i64, p[2]) * 65536 + cast(i64, p[3]) * 16777216;
}

fn addr6_set_scope(a as Addr6, scope_id as i64) as void {
    let is *u8 as p = cast(*u8, cast(i64, a.data) + 24);
    p[0] = cast(u8, scope_id & 255);
    p[1] = cast(u8, (scope_id >> 8) & 255);
    p[2] = cast(u8, (scope_id >> 16) & 255);
    p[3] = cast(u8, (scope_id >> 24) & 255);
}

fn _hexval(c as u8) as i64 {
    if (c >= 48 && c <= 57)  { return cast(i64, c) - 48; }
    if (c >= 97 && c <= 102) { return cast(i64, c) - 87; }
    if (c >= 65 && c <= 70)  { return cast(i64, c) - 55; }
    return 0 - 1;
}

// Parse the textual form into 16 network-order bytes at `out`. Handles all
// three RFC 4291 shapes: eight groups, "::" zero compression, and a trailing
// dotted-quad ("::ffff:1.2.3.4"). Returns 0, or -1 when the text is not an
// address. `out` is untouched on failure.
fn ip6_parse(s as *u8, out as *u8) as i64 {
    let is [8]i64 as g;
    let is i64 as z with mut = 0;
    while (z < 8) { g[z] = 0; z = z + 1; }

    let is i64 as gi with mut = 0;
    let is i64 as dcolon with mut = 0 - 1;  // group index the "::" stood at
    let is i64 as i with mut = 0;

    if (s[0] == 58) {                      // leading ':'
        if (s[1] != 58) { return 0 - 1; }  // a lone leading ':' is invalid
        dcolon = 0;
        i = 2;
    }

    while (s[i] != 0) {
        if (gi >= 8) { return 0 - 1; }
        // A '.' before the next ':' means the tail is a dotted quad, which
        // occupies the final two groups.
        let is i64 as j with mut = i;
        let is i32 as is_v4 with mut = 0;
        while (s[j] != 0 && s[j] != 58) {
            if (s[j] == 46) { is_v4 = 1; }
            j = j + 1;
        }
        if (is_v4 == 1) {
            let is i64 as v4 = ip_parse(cast(*u8, cast(i64, s) + i));
            if (v4 < 0) { return 0 - 1; }
            if (gi + 2 > 8) { return 0 - 1; }
            g[gi] = (v4 >> 16) & 65535;
            g[gi + 1] = v4 & 65535;
            gi = gi + 2;
            i = j;
        } else {
            let is i64 as val with mut = 0;
            let is i64 as digits with mut = 0;
            while (s[i] != 0 && s[i] != 58) {
                let is i64 as h = _hexval(s[i]);
                if (h < 0) { return 0 - 1; }
                val = val * 16 + h;
                digits = digits + 1;
                if (digits > 4) { return 0 - 1; }
                i = i + 1;
            }
            if (digits == 0) { return 0 - 1; }
            g[gi] = val;
            gi = gi + 1;
        }
        if (s[i] == 58) {
            if (s[i + 1] == 58) {
                if (dcolon >= 0) { return 0 - 1; }  // only one "::" allowed
                dcolon = gi;
                i = i + 2;
            } else {
                if (s[i + 1] == 0) { return 0 - 1; }  // trailing single ':'
                i = i + 1;
            }
        }
    }

    if (dcolon < 0) {
        if (gi != 8) { return 0 - 1; }
    } else {
        if (gi >= 8) { return 0 - 1; }  // "::" has to stand for at least one group
        // Slide the groups written after the "::" down to the end.
        let is i64 as move_count = gi - dcolon;
        let is i64 as k with mut = 0;
        while (k < move_count) {
            g[7 - k] = g[gi - 1 - k];
            k = k + 1;
        }
        k = dcolon;
        while (k < 8 - move_count) { g[k] = 0; k = k + 1; }
    }

    let is i64 as w with mut = 0;
    while (w < 8) {
        out[w * 2]     = cast(u8, (g[w] >> 8) & 255);
        out[w * 2 + 1] = cast(u8, g[w] & 255);
        w = w + 1;
    }
    return 0;
}

fn _write_hex_group(buf as *u8, offset as i64, val as i64) as i64 {
    let is [4]u8 as digs;
    let is i64 as n with mut = 0;
    let is i64 as v with mut = val;
    if (v == 0) { buf[offset] = 48; return 1; }
    while (v > 0) {
        let is i64 as d = v & 15;
        if (d < 10) { digs[n] = cast(u8, d + 48); } else { digs[n] = cast(u8, d + 87); }
        v = v >> 4;
        n = n + 1;
    }
    let is i64 as k with mut = 0;
    while (k < n) { buf[offset + k] = digs[n - 1 - k]; k = k + 1; }
    return n;
}

// Format 16 network-order bytes into `out` (needs 46 bytes) as the RFC 5952
// canonical form: lowercase, no leading zeros, and the LONGEST run of zero
// groups collapsed to "::" (leftmost wins on a tie, and a run of one is never
// collapsed). Writes a null terminator. Returns the length.
fn ip6_format(ip as *u8, out as *u8) as i64 {
    let is [8]i64 as g;
    let is i64 as i with mut = 0;
    while (i < 8) {
        g[i] = cast(i64, ip[i * 2]) * 256 + cast(i64, ip[i * 2 + 1]);
        i = i + 1;
    }

    let is i64 as best_start with mut = 0 - 1;
    let is i64 as best_len with mut = 0;
    let is i64 as cur_start with mut = 0 - 1;
    let is i64 as cur_len with mut = 0;
    i = 0;
    while (i < 8) {
        if (g[i] == 0) {
            if (cur_start < 0) { cur_start = i; cur_len = 0; }
            cur_len = cur_len + 1;
            if (cur_len > best_len) { best_len = cur_len; best_start = cur_start; }
        } else {
            cur_start = 0 - 1;
            cur_len = 0;
        }
        i = i + 1;
    }
    if (best_len < 2) { best_start = 0 - 1; }

    let is i64 as n with mut = 0;
    i = 0;
    while (i < 8) {
        if (best_start >= 0 && i == best_start) {
            // Both colons, always: the run standing at the start or reaching
            // the end still needs exactly "::", and the separator rule below
            // then suppresses the one it would otherwise add.
            out[n] = 58; n = n + 1;
            out[n] = 58; n = n + 1;
            i = best_start + best_len;
        } else {
            if (n > 0 && out[n - 1] != 58) { out[n] = 58; n = n + 1; }
            n = n + _write_hex_group(out, n, g[i]);
            i = i + 1;
        }
    }
    out[n] = cast(u8, 0);
    return n;
}

// --- Section 3: Socket creation and options ---

// Create a TCP socket, returns fd or negative error
fn tcp_socket() as i64 {
    return _sock_create(2, 1, 0);
}

// Create a UDP socket, returns fd or negative error
fn udp_socket() as i64 {
    return _sock_create(2, 2, 0);
}

// IPv6 counterparts. Same socket types, AF_INET6 domain.
fn tcp_socket6() as i64 {
    return _sock_create(AF_INET6, 1, 0);
}

fn udp_socket6() as i64 {
    return _sock_create(AF_INET6, 2, 0);
}

// Close socket
fn close(fd as i64) as void {
    _sock_close(fd);
}

// Set SO_REUSEADDR
fn set_reuseaddr(fd as i64) as i64 {
    let is [4]u8 as val;
    let is *i32 as p = cast(*i32, &val);
    *p = cast(i32, 1);
    return _sock_setopt(fd, SOL_SOCKET, SO_REUSEADDR, &val, 4);
}

// Set SO_REUSEPORT
fn set_reuseport(fd as i64) as i64 {
    let is [4]u8 as val;
    let is *i32 as p = cast(*i32, &val);
    *p = cast(i32, 1);
    return _sock_setopt(fd, SOL_SOCKET, SO_REUSEPORT, &val, 4);
}

// Set TCP_NODELAY (disable Nagle)
fn set_nodelay(fd as i64) as i64 {
    let is [4]u8 as val;
    let is *i32 as p = cast(*i32, &val);
    *p = cast(i32, 1);
    return _sock_setopt(fd, IPPROTO_TCP_LVL, TCP_NODELAY, &val, 4);
}

// Set SO_KEEPALIVE
fn set_keepalive(fd as i64) as i64 {
    let is [4]u8 as val;
    let is *i32 as p = cast(*i32, &val);
    *p = cast(i32, 1);
    return _sock_setopt(fd, SOL_SOCKET, SO_KEEPALIVE, &val, 4);
}

// Set recv timeout in seconds
fn set_recv_timeout(fd as i64, secs as i64) as i64 {
    // struct timeval: tv_sec(8 bytes) + tv_usec(8 bytes) = 16 bytes
    let is [16]u8 as tv;
    mem.core.memset(&tv, cast(i32, 0), 16);
    let is *i64 as p = cast(*i64, &tv);
    *p = secs;
    return _sock_setopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, 16);
}

// Set send timeout in seconds
fn set_send_timeout(fd as i64, secs as i64) as i64 {
    let is [16]u8 as tv;
    mem.core.memset(&tv, cast(i32, 0), 16);
    let is *i64 as p = cast(*i64, &tv);
    *p = secs;
    return _sock_setopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, 16);
}

// Set non-blocking mode
fn set_nonblock(fd as i64) as i64 {
    return _sock_set_nonblock(fd);
}

// --- Section 4: TCP operations ---

// Bind + listen on addr. Returns server fd or negative error.
fn tcp_listen(a as Addr) as i64 {
    let is i64 as fd = tcp_socket();
    if (fd < 0) { return fd; }

    set_reuseaddr(fd);

    let is i64 as r with mut = _sock_bind(fd, a.data, SOCKADDR_IN_SIZE);
    if (r < 0) { _sock_close(fd); return r; }

    r = _sock_listen(fd, DEFAULT_BACKLOG);
    if (r < 0) { _sock_close(fd); return r; }

    return fd;
}

// Accept a connection. Fills client_buf (16 bytes sockaddr_in) if not null.
// Returns client fd or negative error.
fn tcp_accept(server_fd as i64, client_buf as *u8) as i64 {
    let is u32 as addrlen with mut = cast(u32, SOCKADDR_IN_SIZE);
    let is i64 as fd with mut = 0;
    if (cast(i64, client_buf) != 0) {
        fd = _sock_accept(server_fd, client_buf, &addrlen);
    } else {
        fd = _sock_accept(server_fd, cast(*u8, 0), cast(*u32, 0));
    }
    return fd;
}

// Connect to addr. Returns fd or negative error.
fn tcp_connect(a as Addr) as i64 {
    let is i64 as fd = tcp_socket();
    if (fd < 0) { return fd; }

    let is i64 as r = _sock_connect(fd, a.data, SOCKADDR_IN_SIZE);
    if (r < 0) { _sock_close(fd); return r; }

    return fd;
}

// --- IPv6 entry points ---
//
// Same shapes as the IPv4 ones above, over AF_INET6 and a 28-byte sockaddr.
// Everything after the handshake — send/recv/send_all/recv_all/poller — is
// family-agnostic and works on these fds unchanged.

fn tcp_listen6(a as Addr6) as i64 {
    let is i64 as fd = tcp_socket6();
    if (fd < 0) { return fd; }

    set_reuseaddr(fd);

    let is i64 as r with mut = _sock_bind(fd, a.data, SOCKADDR_IN6_SIZE);
    if (r < 0) { _sock_close(fd); return r; }

    r = _sock_listen(fd, DEFAULT_BACKLOG);
    if (r < 0) { _sock_close(fd); return r; }

    return fd;
}

// Fills client_buf (28 bytes sockaddr_in6) if not null.
fn tcp_accept6(server_fd as i64, client_buf as *u8) as i64 {
    let is u32 as addrlen with mut = cast(u32, SOCKADDR_IN6_SIZE);
    if (cast(i64, client_buf) != 0) {
        return _sock_accept(server_fd, client_buf, &addrlen);
    }
    return _sock_accept(server_fd, cast(*u8, 0), cast(*u32, 0));
}

fn tcp_connect6(a as Addr6) as i64 {
    let is i64 as fd = tcp_socket6();
    if (fd < 0) { return fd; }

    let is i64 as r = _sock_connect(fd, a.data, SOCKADDR_IN6_SIZE);
    if (r < 0) { _sock_close(fd); return r; }

    return fd;
}

fn udp_bind6(a as Addr6) as i64 {
    let is i64 as fd = udp_socket6();
    if (fd < 0) { return fd; }

    let is i64 as r = _sock_bind(fd, a.data, SOCKADDR_IN6_SIZE);
    if (r < 0) { _sock_close(fd); return r; }

    return fd;
}

fn udp_send6(fd as i64, buf as *u8, len as i64, a as Addr6) as i64 {
    return _sock_sendto(fd, buf, len, 0, a.data, SOCKADDR_IN6_SIZE);
}

// Fills sender_buf (28 bytes sockaddr_in6) if not null.
fn udp_recv6(fd as i64, buf as *u8, len as i64, sender_buf as *u8) as i64 {
    let is u32 as addrlen with mut = cast(u32, SOCKADDR_IN6_SIZE);
    if (cast(i64, sender_buf) != 0) {
        return _sock_recvfrom(fd, buf, len, 0, sender_buf, &addrlen);
    }
    return _sock_recv(fd, buf, len, 0);
}

// Send data. Returns bytes sent or negative error. This is one call, not a
// loop: -EINTR reaches the caller and means "retry", nothing was sent. Use
// send_all when you want that handled for you.
fn send(fd as i64, buf as *u8, len as i64) as i64 {
    return _sock_send(fd, buf, len, 0);
}

// Receive data. Returns bytes received, 0 for EOF, or negative error. Like
// send, this is one call: -EINTR means retry, not failure. recv_all handles it.
fn recv(fd as i64, buf as *u8, len as i64) as i64 {
    return _sock_recv(fd, buf, len, 0);
}

// Send all data (loop until all bytes sent). Returns total sent or negative on
// first error. A signal that interrupts the call before anything moved is
// retried, not reported: these `_all` functions exist to own the loop, so
// surfacing -EINTR here would push the retry back onto every caller and let a
// single stray signal abort a whole transfer.
fn send_all(fd as i64, buf as *u8, len as i64) as i64 {
    let is i64 as sent with mut = 0;
    while (sent < len) {
        let is i64 as n = send(fd, cast(*u8, cast(i64, buf) + sent), len - sent);
        if (n == 0 - EINTR) { continue; }
        if (n < 0) { return n; }
        if (n == 0) {
            if (sent > 0) { return sent; }
            return cast(i64, 0 - 1);
        }
        sent = sent + n;
    }
    return sent;
}

// Receive exactly len bytes (loop). Returns total received or negative on
// error. Retries on -EINTR for the same reason as send_all.
fn recv_all(fd as i64, buf as *u8, len as i64) as i64 {
    let is i64 as received with mut = 0;
    while (received < len) {
        let is i64 as n = recv(fd, cast(*u8, cast(i64, buf) + received), len - received);
        if (n == 0 - EINTR) { continue; }
        if (n < 0) { return n; }
        if (n == 0) { return cast(i64, 0 - 1); }
        received = received + n;
    }
    return received;
}

// Send a null-terminated string
fn send_str(fd as i64, s as *u8) as i64 {
    let is i64 as len = str.strlen(s);
    return send_all(fd, s, len);
}

// Send a Caustic String
fn send_string(fd as i64, s as str.String) as i64 {
    return send_all(fd, s.ptr, cast(i64, s.len));
}

// Receive into a new String (reads up to max_len bytes)
fn recv_string(fd as i64, max_len as i64) as str.String {
    let is *u8 as buf = _alloc(max_len + 1);
    let is i64 as n = recv(fd, buf, max_len);
    let is str.String as s;
    if (n <= 0) {
        _free(buf);
        s.ptr = cast(*u8, 0);
        s.len = 0;
        s.cap = 0;
        return s;
    }
    buf[n] = 0;
    s.ptr = buf;
    s.len = cast(i32, n);
    s.cap = cast(i32, max_len);
    return s;
}

// --- Section 5: UDP operations ---

// Bind UDP socket to addr. Returns fd or negative error.
fn udp_bind(a as Addr) as i64 {
    let is i64 as fd = udp_socket();
    if (fd < 0) { return fd; }

    let is i64 as r = _sock_bind(fd, a.data, SOCKADDR_IN_SIZE);
    if (r < 0) { _sock_close(fd); return r; }

    return fd;
}

// Send UDP datagram to addr. Returns bytes sent or negative error.
fn udp_send(fd as i64, buf as *u8, len as i64, a as Addr) as i64 {
    return _sock_sendto(fd, buf, len, 0, a.data, SOCKADDR_IN_SIZE);
}

// Receive UDP datagram. Fills sender_buf (16 bytes sockaddr_in) if not null.
// Returns bytes received or negative error.
fn udp_recv(fd as i64, buf as *u8, len as i64, sender_buf as *u8) as i64 {
    let is u32 as addrlen with mut = cast(u32, SOCKADDR_IN_SIZE);
    if (cast(i64, sender_buf) != 0) {
        return _sock_recvfrom(fd, buf, len, 0, sender_buf, &addrlen);
    }
    return _sock_recv(fd, buf, len, 0);
}

// Send null-terminated string via UDP
fn udp_send_str(fd as i64, s as *u8, a as Addr) as i64 {
    return udp_send(fd, s, str.strlen(s), a);
}

// --- Section 6: Poll wrapper ---

// struct pollfd: fd(4) + events(2) + revents(2) = 8 bytes
struct PollFd {
    fd as i32;
    events as i16;
    revents as i16;
}

// Initialize a PollFd
fn pollfd_init(pfd as *PollFd, fd as i64, events as i64) as void {
    pfd.fd = cast(i32, fd);
    pfd.events = cast(i16, events);
    pfd.revents = 0;
}

// Check if an event occurred
fn pollfd_ready(pfd as *PollFd, event as i64) as i64 {
    if ((cast(i64, pfd.revents) & event) != 0) { return 1; }
    return 0;
}

// Poll on an array of PollFd. timeout_ms = -1 for infinite, 0 for non-blocking.
// Returns number of ready fds, 0 for timeout, negative for error.
fn net_poll(fds as *PollFd, count as i64, timeout_ms as i64) as i64 {
    return _sock_poll(cast(*u8, fds), count, timeout_ms);
}

// Convenience: wait for a single fd to be readable. Returns 1 if ready, 0 if timeout, -1 on error.
fn wait_readable(fd as i64, timeout_ms as i64) as i64 {
    let is PollFd as pfd;
    pollfd_init(&pfd, fd, POLLIN_FLAG);
    let is i64 as r = _sock_poll(cast(*u8, &pfd), 1, timeout_ms);
    if (r > 0) {
        if (pollfd_ready(&pfd, POLLIN_FLAG) == 1) { return 1; }
    }
    if (r == 0) { return 0; }
    return 0 - 1;
}

// Convenience: wait for a single fd to be writable. Returns 1 if ready, 0 if timeout, -1 on error.
fn wait_writable(fd as i64, timeout_ms as i64) as i64 {
    let is PollFd as pfd;
    pollfd_init(&pfd, fd, POLLOUT_FLAG);
    let is i64 as r = _sock_poll(cast(*u8, &pfd), 1, timeout_ms);
    if (r > 0) {
        if (pollfd_ready(&pfd, POLLOUT_FLAG) == 1) { return 1; }
    }
    if (r == 0) { return 0; }
    return 0 - 1;
}

// --- Section 7b: Poller (readiness set) ---
//
// net_poll hands the kernel the entire descriptor set on every call and the
// kernel walks all of it, so a server holding N connections pays O(N) per
// iteration no matter how few are active. A Poller registers the set once and
// asks only for what fired.
//
// Portable by dispatch, not by pretending: on Linux this is epoll and the cost
// is O(ready); on Windows and wasm it falls back to the same poll(2)/WSAPoll
// this module already used, so the cost is unchanged there but the code that
// uses it does not have to change. The event flags are POLLIN_FLAG/POLLOUT_FLAG
// on both paths — EPOLLIN/EPOLLOUT share those bit values on Linux, so no
// translation is needed.
//
// Callers wanting raw epoll (edge-triggered, EPOLLONESHOT, foreign fds) go
// straight to std/os/linux.cst and accept being Linux-only.
struct Poller {
    epfd as i64;         // Linux: the epoll fd. Elsewhere: -1
    fds as *u8;          // PollFd[cap] — the registered set (fallback path)
    count as i64;
    cap as i64;
    evbuf as *u8;        // epoll_event[max_events] (Linux)
    ready_fd as *i64;    // fd of each ready slot, both paths
    ready_ev as *i64;    // event mask of each ready slot, both paths
    max_events as i64;
    nready as i64;
}

fn _poller_grow(p as *Poller, want as i64) as i64 {
    if (want <= p.cap) { return 0; }
    let is i64 as ncap with mut = p.cap * 2;
    if (ncap < want) { ncap = want; }
    if (ncap < 8) { ncap = 8; }
    let is *u8 as nfds = _alloc(ncap * 8);
    if (cast(i64, nfds) == 0) { return 0 - 1; }
    if (cast(i64, p.fds) != 0) {
        mem.memcpy(nfds, p.fds, p.count * 8);
        _free(p.fds);
    }
    p.fds = nfds;
    p.cap = ncap;
    return 0;
}

// max_events caps how many ready descriptors one wait can report. Extra ready
// descriptors are not lost — they surface on the next wait.
fn poller_new(max_events as i64) as Poller {
    let is Poller as p with mut;
    let is i64 as me with mut = max_events;
    if (me < 1) { me = 64; }
    p.epfd = 0 - 1;
    p.fds = cast(*u8, 0);
    p.count = 0;
    p.cap = 0;
    p.evbuf = cast(*u8, 0);
    p.max_events = me;
    p.nready = 0;
    p.ready_fd = cast(*i64, _alloc(me * 8));
    p.ready_ev = cast(*i64, _alloc(me * 8));
    if (os.current() == os.OS_LINUX) {
        p.epfd = linux.epoll_create1(0);
        p.evbuf = _alloc(me * linux.EPOLL_EVENT_SIZE);
    }
    return p;
}

// Register fd for `events` (POLLIN_FLAG / POLLOUT_FLAG, OR-ed).
fn poller_add(p as *Poller, fd as i64, events as i64) as i64 {
    if (os.current() == os.OS_LINUX) {
        let is [2]i64 as ev;
        linux.epoll_event_set(cast(*u8, &ev[0]), events, fd);
        return linux.epoll_ctl(p.epfd, linux.EPOLL_CTL_ADD, fd, cast(*u8, &ev[0]));
    }
    if (_poller_grow(p, p.count + 1) < 0) { return 0 - 1; }
    let is *PollFd as slot = cast(*PollFd, cast(i64, p.fds) + p.count * 8);
    pollfd_init(slot, fd, events);
    p.count = p.count + 1;
    return 0;
}

// Change what fd is watched for.
fn poller_mod(p as *Poller, fd as i64, events as i64) as i64 {
    if (os.current() == os.OS_LINUX) {
        let is [2]i64 as ev;
        linux.epoll_event_set(cast(*u8, &ev[0]), events, fd);
        return linux.epoll_ctl(p.epfd, linux.EPOLL_CTL_MOD, fd, cast(*u8, &ev[0]));
    }
    let is i64 as i with mut = 0;
    while (i < p.count) {
        let is *PollFd as slot = cast(*PollFd, cast(i64, p.fds) + i * 8);
        if (cast(i64, slot.fd) == fd) { pollfd_init(slot, fd, events); return 0; }
        i = i + 1;
    }
    return 0 - 1;
}

fn poller_del(p as *Poller, fd as i64) as i64 {
    if (os.current() == os.OS_LINUX) {
        let is [2]i64 as ev;
        linux.epoll_event_set(cast(*u8, &ev[0]), 0, fd);
        return linux.epoll_ctl(p.epfd, linux.EPOLL_CTL_DEL, fd, cast(*u8, &ev[0]));
    }
    let is i64 as i with mut = 0;
    while (i < p.count) {
        let is *PollFd as slot = cast(*PollFd, cast(i64, p.fds) + i * 8);
        if (cast(i64, slot.fd) == fd) {
            // Compact: move the last entry into this hole.
            let is *PollFd as last = cast(*PollFd, cast(i64, p.fds) + (p.count - 1) * 8);
            slot.fd = last.fd;
            slot.events = last.events;
            slot.revents = last.revents;
            p.count = p.count - 1;
            return 0;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Wait for readiness. timeout_ms = -1 blocks, 0 polls. Returns the number of
// ready descriptors (0 on timeout, negative on error); read them back with
// poller_fd / poller_events. Retries on -EINTR for the same reason send_all
// does: this call owns the wait, so a stray signal is not the caller's problem.
fn poller_wait(p as *Poller, timeout_ms as i64) as i64 {
    p.nready = 0;
    if (os.current() == os.OS_LINUX) {
        let is i64 as n with mut = 0 - EINTR;
        while (n == 0 - EINTR) {
            n = linux.epoll_wait(p.epfd, p.evbuf, p.max_events, timeout_ms);
        }
        if (n <= 0) { return n; }
        let is i64 as i with mut = 0;
        while (i < n) {
            p.ready_fd[i] = linux.epoll_event_data(p.evbuf, i);
            p.ready_ev[i] = linux.epoll_event_events(p.evbuf, i);
            i = i + 1;
        }
        p.nready = n;
        return n;
    }
    let is i64 as r with mut = 0 - EINTR;
    while (r == 0 - EINTR) {
        r = _sock_poll(p.fds, p.count, timeout_ms);
    }
    if (r <= 0) { return r; }
    // poll marks revents in place; compact the ready ones so the accessors
    // below read the same way they do on the epoll path.
    let is i64 as i with mut = 0;
    let is i64 as k with mut = 0;
    while (i < p.count && k < p.max_events) {
        let is *PollFd as slot = cast(*PollFd, cast(i64, p.fds) + i * 8);
        if (slot.revents != 0) {
            p.ready_fd[k] = cast(i64, slot.fd);
            p.ready_ev[k] = cast(i64, slot.revents);
            k = k + 1;
        }
        i = i + 1;
    }
    p.nready = k;
    return k;
}

fn poller_fd(p as *Poller, idx as i64) as i64 {
    if (idx < 0 || idx >= p.nready) { return 0 - 1; }
    return p.ready_fd[idx];
}

fn poller_events(p as *Poller, idx as i64) as i64 {
    if (idx < 0 || idx >= p.nready) { return 0; }
    return p.ready_ev[idx];
}

// Did slot `idx` fire for `event` (POLLIN_FLAG / POLLOUT_FLAG)?
fn poller_ready(p as *Poller, idx as i64, event as i64) as i64 {
    if ((poller_events(p, idx) & event) != 0) { return 1; }
    return 0;
}

fn poller_close(p as *Poller) as void {
    if (os.current() == os.OS_LINUX) {
        if (p.epfd >= 0) { _sock_close(p.epfd); p.epfd = 0 - 1; }
        if (cast(i64, p.evbuf) != 0) { _free(p.evbuf); p.evbuf = cast(*u8, 0); }
    }
    if (cast(i64, p.fds) != 0) { _free(p.fds); p.fds = cast(*u8, 0); }
    if (cast(i64, p.ready_fd) != 0) { _free(cast(*u8, p.ready_fd)); p.ready_fd = cast(*i64, 0); }
    if (cast(i64, p.ready_ev) != 0) { _free(cast(*u8, p.ready_ev)); p.ready_ev = cast(*i64, 0); }
    p.count = 0;
    p.cap = 0;
    p.nready = 0;
}

// --- Section 8: Convenience helpers ---

// Host to network short (byte swap u16)
fn htons(val as i32) as i32 {
    return ((val & 255) << 8) + ((val >> 8) & 255);
}

// Parse "a.b.c.d" string to host-byte-order IP value
fn ip_parse(s as *u8) as i64 {
    let is i64 as result with mut = 0;
    let is i64 as octet with mut = 0;
    let is i64 as i with mut = 0;
    let is i32 as parts with mut = 0;
    while (s[i] != 0) {
        if (s[i] == 46) { // '.'
            result = (result << 8) + octet;
            octet = 0;
            parts = parts + 1;
        } else if (s[i] >= 48 && s[i] <= 57) {
            octet = octet * 10 + cast(i64, s[i]) - 48;
        }
        i = i + 1;
    }
    result = (result << 8) + octet;
    return result;
}

// Connect to ip:port by string. Returns fd or negative error.
// Usage: let is i64 as fd = net.dial("127.0.0.1", 8080);
fn dial(ip_str as *u8, port as i64) as i64 {
    let is i64 as ip = ip_parse(ip_str);
    let is [16]u8 as buf;
    let is Addr as a = addr_init(&buf, ip, port);
    return tcp_connect(a);
}
