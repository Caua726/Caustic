fn incb_get(cp as i32) as i32 {
  if (incb_ready == 0) { incb_init(); }
  return trie.lookup2(cast(**u8, &incb_index_chunks), cast(**u8, &incb_data_chunks), cp, incb_maxcp, incb_default);
