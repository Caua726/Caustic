// =======================================================
// std/unicode/errno.cst
// Error codes for the unicode module. Operations return a count/index >= 0 on
// success, or 0 - UERR_* (negative) on failure — the same negative-return
// convention as std/net.cst. UERR_END is a non-error sentinel returned by
// iterators, negated like the rest so one `< 0` test covers both.
//
// This is caustic-unicode's core/errno.cst with the codes no path here can
// return removed: UNMAPPED belongs to the legacy encodings, DISALLOWED and BIDI
// and PUNYCODE to IDNA, and none of those modules came across. A name that
// nothing can produce is a name a reader has to rule out by hand.
//
// std/errors.cst was the obvious alternative and is the wrong one: it does
// `use "io.cst"`, which would put a buffered descriptor reader inside a module
// whose whole claim is that it touches no OS at all.
// =======================================================

let is i64 as UERR_INVALID  with imut = 1;   // malformed input (bad UTF-8)
let is i64 as UERR_NOSPACE  with imut = 2;   // caller dst buffer too small
let is i64 as UERR_TRUNC    with imut = 3;   // input ended mid-sequence
let is i64 as UERR_RANGE    with imut = 4;   // code point > 0x10FFFF / surrogate
let is i64 as UERR_OVERLONG with imut = 5;   // overlong UTF-8 encoding
let is i64 as UERR_END      with imut = 10;  // iterator exhausted (sentinel, not a fault)

// True when a return value signals an error (negative). UERR_END counts here
// only when returned negated, which is how iterators return it.
fn is_err(ret as i64) as i64 {
    if (ret < 0) { return 1; }
    return 0;
}

// Human-readable name for a negative 0 - UERR_* return (best effort).
fn err_name(ret as i64) as *u8 {
    let is i64 as e with mut = ret;
    if (e < 0) { e = 0 - e; }
    if (e == UERR_INVALID)  { return "UERR_INVALID"; }
    if (e == UERR_NOSPACE)  { return "UERR_NOSPACE"; }
    if (e == UERR_TRUNC)    { return "UERR_TRUNC"; }
    if (e == UERR_RANGE)    { return "UERR_RANGE"; }
    if (e == UERR_OVERLONG) { return "UERR_OVERLONG"; }
    if (e == UERR_END)      { return "UERR_END"; }
    return "UERR_UNKNOWN";
}
