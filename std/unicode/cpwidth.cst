fn _u32(off as i64) as i64 {
    let is *u8 as t = RANGES;
    return cast(i64, t[off]) | (cast(i64, t[off + 1]) << 8)
         | (cast(i64, t[off + 2]) << 16) | (cast(i64, t[off + 3]) << 24);
}

// Columns cp takes: 0 (a combining mark, a control, a format character),
// 2 (East Asian Wide/Fullwidth, an emoji drawn as one), or 1.
fn cp_width(cp as i32) as i64 {
    let is i64 as c = cast(i64, cp);
    let is i64 as lo with mut = 0;
    let is i64 as hi with mut = N_RANGES - 1;
    while (lo <= hi) {
        let is i64 as mid = (lo + hi) / 2;
        let is i64 as s = _u32(mid * 8);
        let is i64 as ew = _u32(mid * 8 + 4);
        if (c < s) { hi = mid - 1; }
        else if (c > (ew & 16777215)) { lo = mid + 1; }
        else { return ew >> 24; }
    }
    return 1;
}
