// =======================================================
// std/unicode/trie.cst
// Runtime reader for the two-level code-point tries in tables/. Ported from
// caustic-unicode, where tools/gen.cst emits them; the generator stays there,
// with the UCD text files it parses, and the tables are copied here
// byte-for-byte so a diff against that tree stays meaningful.
//
// Tables are chunked *u8 string blobs (bytes via \xNN, little-endian) — there
// is no array literal in Caustic, so a generated init() fills [K]*u8
// chunk-pointer arrays at first use and the lookups read through them.
//
// Layout (SHIFT = 5, BLOCK = 32 code points):
//   index[cp >> 5]                -> block id   (u16)
//   data[(block_id << 5)|(cp&31)] -> property   (u16)
// CHUNK = 4096 decoded bytes/blob, keeping \xNN source literals well
// under the assembler's ~32 KB per-directive limit.
// =======================================================

// Chunk size (decoded bytes) of each table blob. Tables live directly in
// .rodata as string-init *u8 globals (bytes written as \xNN); the chunk
// pointer array just points at them — no runtime decode.
let is i32 as CHUNK_BYTES with imut = 4096;

// Read little-endian u16 element `i` from a chunked byte blob.
// u16 elements never straddle a 4096-byte (even) chunk boundary.
fn blob_u16(chunks as **u8, i as i32) as i32 {
    let is i32 as bo = i << 1;               // byte offset (2 bytes/elem)
    let is *u8 as base = chunks[bo >> 12];   // / 4096
    let is i32 as ic = bo & 4095;            // % 4096
    return cast(i32, base[ic]) | (cast(i32, base[ic + 1]) << 8);
}

// Read little-endian u32 element `i` from a chunked byte blob (4 bytes/elem,
// 4096-byte chunks → never straddles a chunk boundary).
fn blob_u32(chunks as **u8, i as i32) as i32 {
    let is i32 as bo = i << 2;
    let is *u8 as base = chunks[bo >> 12];
    let is i32 as ic = bo & 4095;
    return cast(i32, base[ic]) | (cast(i32, base[ic + 1]) << 8)
         | (cast(i32, base[ic + 2]) << 16) | (cast(i32, base[ic + 3]) << 24);
}

// Two-level trie lookup. Returns `def` for out-of-range code points.
fn lookup2(index_chunks as **u8, data_chunks as **u8, cp as i32, maxcp as i32, def as i32) as i32 {
    if (cp < 0 || cp > maxcp) { return def; }
    let is i32 as blk = blob_u16(index_chunks, cp >> 5);
    return blob_u16(data_chunks, (blk << 5) | (cp & 31));
}
