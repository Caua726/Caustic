// =======================================================
// std/unicode/grapheme.cst
// Extended grapheme cluster boundaries (UAX #29, rules GB1-GB999), including
// emoji ZWJ sequences (GB11), Indic conjuncts (GB9c) and regional-indicator
// pairs (GB12/GB13). Operates on a code-point run, allocates nothing.
//
// Ported unchanged from caustic-unicode's segment/grapheme.cst, which passes the
// full GraphemeBreakTest.txt from the UCD there. Changing a rule here without
// running that file against it is how a break table silently drifts, so rule
// changes belong upstream and come back as a copy.
//
// Three of these rules read BACKWARDS from the candidate boundary — GB11 walks
// down over Extend to find the pictograph, GB9c walks down to the consonant,
// GB12/13 count regional indicators behind the cursor — which is why every API
// here takes the whole run and an index into it, and why nothing here can be
// answered from a lone code point.
// =======================================================

use "errno.cst"           as errno;
use "tables/gcb.cst"      as gcb;
use "tables/extpict.cst"  as ep;
use "tables/incb.cst"     as incb;

// Indic_Conjunct_Break values (must match tools/gen.cst:gen_incb).
let is i64 as INCB_CONSONANT with imut = 1;
let is i64 as INCB_LINKER    with imut = 3;

struct GraphemeIter { cps as *i32; n as i64; pos as i64; }

fn grapheme_iter(cps as *i32, n as i64) as GraphemeIter {
    let is GraphemeIter as it;
    it.cps = cps; it.n = n; it.pos = 0;
    return it;
}

// 1 if there is a cluster boundary between cps[i-1] and cps[i] (i in 1..n-1).
fn _boundary(cps as *i32, n as i64, i as i64) as i64 {
    let is i64 as prev = cast(i64, gcb.gcb_get(cps[i - 1]));
    let is i64 as cur  = cast(i64, gcb.gcb_get(cps[i]));

    if (prev == gcb.GCB_CR && cur == gcb.GCB_LF) { return 0; }                          // GB3
    if (prev == gcb.GCB_Control || prev == gcb.GCB_CR || prev == gcb.GCB_LF) { return 1; }   // GB4
    if (cur == gcb.GCB_Control || cur == gcb.GCB_CR || cur == gcb.GCB_LF) { return 1; }      // GB5
    if (prev == gcb.GCB_L && (cur == gcb.GCB_L || cur == gcb.GCB_V || cur == gcb.GCB_LV || cur == gcb.GCB_LVT)) { return 0; }  // GB6
    if ((prev == gcb.GCB_LV || prev == gcb.GCB_V) && (cur == gcb.GCB_V || cur == gcb.GCB_T)) { return 0; }   // GB7
    if ((prev == gcb.GCB_LVT || prev == gcb.GCB_T) && cur == gcb.GCB_T) { return 0; }   // GB8
    if (cur == gcb.GCB_Extend || cur == gcb.GCB_ZWJ) { return 0; }                      // GB9
    if (cur == gcb.GCB_SpacingMark) { return 0; }                                       // GB9a
    if (prev == gcb.GCB_Prepend) { return 0; }                                          // GB9b

    // GB11: Extended_Pictographic Extend* ZWJ x Extended_Pictographic
    if (prev == gcb.GCB_ZWJ && ep.extpict_get(cps[i]) == 1) {
        let is i64 as j with mut = i - 2;
        while (j >= 0 && cast(i64, gcb.gcb_get(cps[j])) == gcb.GCB_Extend) { j = j - 1; }
        if (j >= 0 && ep.extpict_get(cps[j]) == 1) { return 0; }
    }

    // GB9c: InCB=Consonant [InCB=Extend InCB=Linker]* InCB=Linker [...]* x InCB=Consonant
    if (cast(i64, incb.incb_get(cps[i])) == INCB_CONSONANT) {
        let is i64 as saw_linker with mut = 0;
        let is i64 as j with mut = i - 1;
        let is i64 as v with mut = cast(i64, incb.incb_get(cps[j]));
        while (j >= 0 && (v == INCB_LINKER || v == 2)) {       // 2 = InCB Extend
            if (v == INCB_LINKER) { saw_linker = 1; }
            j = j - 1;
            if (j >= 0) { v = cast(i64, incb.incb_get(cps[j])); }
        }
        if (saw_linker == 1 && j >= 0 && cast(i64, incb.incb_get(cps[j])) == INCB_CONSONANT) { return 0; }
    }

    // GB12/GB13: do not break within an even run of regional indicators.
    if (prev == gcb.GCB_Regional_Indicator && cur == gcb.GCB_Regional_Indicator) {
        let is i64 as cnt with mut = 0;
        let is i64 as j with mut = i - 1;
        while (j >= 0 && cast(i64, gcb.gcb_get(cps[j])) == gcb.GCB_Regional_Indicator) {
            cnt = cnt + 1;
            j = j - 1;
        }
        if ((cnt & 1) == 1) { return 0; }
    }

    return 1;                                                                           // GB999
}

// End index (exclusive) of the next cluster, or 0 - errno.UERR_END at the end.
fn grapheme_next(it as *GraphemeIter) as i64 {
    if (it.pos >= it.n) { return 0 - errno.UERR_END; }
    let is i64 as p with mut = it.pos + 1;
    while (p < it.n && _boundary(it.cps, it.n, p) == 0) { p = p + 1; }
    it.pos = p;
    return p;
}

// 1 if there is a cluster boundary at index i (start/end count as boundaries).
fn grapheme_is_boundary(cps as *i32, n as i64, i as i64) as i64 {
    if (i <= 0 || i >= n) { return 1; }
    return _boundary(cps, n, i);
}

fn grapheme_count(cps as *i32, n as i64) as i64 {
    let is GraphemeIter as it = grapheme_iter(cps, n);
    let is i64 as c with mut = 0;
    while (grapheme_next(&it) >= 0) { c = c + 1; }
    return c;
}

// Fill `out` with the exclusive end index of each cluster. Returns the count,
// or 0 - errno.UERR_NOSPACE if it exceeds cap.
fn grapheme_boundaries(cps as *i32, n as i64, out as *i64, cap as i64) as i64 {
    let is GraphemeIter as it = grapheme_iter(cps, n);
    let is i64 as c with mut = 0;
    let is i64 as e with mut = grapheme_next(&it);
    while (e >= 0) {
        if (c >= cap) { return 0 - errno.UERR_NOSPACE; }
        out[c] = e;
        c = c + 1;
        e = grapheme_next(&it);
    }
    return c;
}
