// string.strlen and io.strlen against a byte loop: every start offset 0..40
// and every length 0..400 (the 32-byte block path starts past 128 bytes),
// and strings whose terminator is the last byte of a mapped page with the
// next page unmapped, so a read past the page would fault.
// Exit code = number of failures (0 means pass).
use "../std/string.cst" as str;
use "../std/io.cst" as io;
use "../std/mem.cst" as mem;

let is i32 as bad with mut = 0;

fn ref_len(p as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (p[i] != 0) { i = i + 1; }
    return i;
}

fn check(p as *u8, want as i64) as void {
    if (str.strlen(p) != want || io.strlen(p) != want || ref_len(p) != want) {
        if (bad < 10) {
            io.write_str(io.STDERR, "strlen mismatch at length ");
            io.write_int(io.STDERR, want);
            io.write_str(io.STDERR, "\n");
        }
        bad = bad + 1;
    }
}

fn main() as i32 {
    let is *u8 as buf = mem.core.mmap_anon(4096);
    let is i64 as off with mut = 0;
    while (off <= 40) {
        let is i64 as n with mut = 0;
        while (n <= 400) {
            let is i64 as k with mut = 0;
            while (k < 512) { buf[k] = cast(u8, 1 + ((k * 7) % 250)); k = k + 1; }
            buf[off + n] = 0;
            check(cast(*u8, cast(i64, buf) + off), n);
            n = n + 1;
        }
        off = off + 1;
    }

    // Terminator on the last byte of a page whose successor is unmapped.
    let is *u8 as two = mem.core.mmap_anon(8192);
    mem.core.munmap(cast(*u8, cast(i64, two) + 4096), 4096);
    let is i64 as j with mut = 0;
    while (j < 4095) { two[j] = cast(u8, 65 + (j % 26)); j = j + 1; }
    two[4095] = 0;
    let is i64 as start with mut = 3600;
    while (start <= 4095) {
        check(cast(*u8, cast(i64, two) + start), 4095 - start);
        start = start + 1;
    }
    check(two, 4095);
    return bad;
}
