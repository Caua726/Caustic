// tests/vec_byte_count_test.cst
//
// At -O2 `if (p[i] == k) { c = c + 1; }` over bytes compares 32 bytes at a
// time with AVX2, else 16 (pcmpeqb), adds the matches with psadbw into 64-bit
// lanes, and the scalar loop does the rest (src/ir/vec, detect_count /
// vectorize_count). Every length around the vector widths, a start that is not
// aligned, a start index other than 0, a counter that does not start at 0,
// `!=` as well as `==`, i8 as well as u8, constants a sign or zero extension
// would tell apart, more than 255 and 65535 matches, an i64 counter, and an
// i32 counter that wraps. Loops that must stay scalar give the same answers.
//
// Exit code 0 on success, else the number of the failing check.

fn count_eq(p as *u8, n as i32, k as u8) as i32 {
    let is i32 as c with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) { if (p[i] == k) { c = c + 1; } i = i + 1; }
    return c;
}

fn count_one(p as *u8, n as i32) as i32 {
    let is i32 as c with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) { if (p[i] == cast(u8, 1)) { c = c + 1; } i = i + 1; }
    return c;
}

fn count_ne(p as *u8, s as i32, n as i32) as i64 {
    let is i64 as c with mut = 7;
    let is i32 as i with mut = s;
    while (i < n) { if (p[i] != cast(u8, 255)) { c = c + 1; } i = i + 1; }
    return c;
}

fn count_i8(p as *i8, n as i32) as i32 {
    let is i32 as c with mut = 100;
    let is i32 as i with mut = 0;
    while (i < n) { if (p[i] == cast(i8, 0 - 128)) { c = c + 1; } i = i + 1; }
    return c;
}

fn count_wrap(p as *u8, n as i32, start as i32) as i32 {
    let is i32 as c with mut = start;
    let is i32 as i with mut = 0;
    while (i < n) { if (p[i] == cast(u8, 0)) { c = c + 1; } i = i + 1; }
    return c;
}

// The counter is also read inside: stays scalar.
fn count_twice(p as *u8, n as i32) as i32 {
    let is i32 as c with mut = 0;
    let is i32 as s with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) { if (p[i] == cast(u8, 1)) { c = c + 1; } s = s + c; i = i + 1; }
    return s;
}

// Reference counts, one byte at a time through an opaque index.
fn ref_count(p as *u8, s as i32, n as i32, k as u8) as i32 {
    let is i32 as c with mut = 0;
    let is i32 as i with mut = s;
    while (i < n) {
        let is u8 as x = p[i];
        if (x == k) { c = c + 1; }
        i = i + 2;
    }
    i = s + 1;
    while (i < n) {
        let is u8 as x = p[i];
        if (x == k) { c = c + 1; }
        i = i + 2;
    }
    return c;
}

fn main() as i32 {
    let is [70100]u8 as arr;
    let is *u8 as buf = cast(*u8, &arr);
    let is i32 as size = 70100;
    let is i32 as i with mut = 0;
    while (i < size) { buf[i] = cast(u8, (i * 7) % 5); i = i + 1; }
    buf[10] = cast(u8, 255); buf[11] = cast(u8, 128); buf[40] = cast(u8, 255);

    let is [10]i32 as lens;
    lens[0] = 0; lens[1] = 1; lens[2] = 15; lens[3] = 16; lens[4] = 17;
    lens[5] = 31; lens[6] = 32; lens[7] = 33; lens[8] = 1000; lens[9] = 70000;
    let is i32 as t with mut = 0;
    while (t < 10) {
        let is i32 as n = lens[t];
        let is *u8 as q = cast(*u8, cast(i64, buf) + 3);
        if (count_one(q, n) != ref_count(q, 0, n, cast(u8, 1))) { return 1 + t; }
        if (count_eq(q, n, cast(u8, 4)) != ref_count(q, 0, n, cast(u8, 4))) { return 20 + t; }
        if (count_eq(buf, n, cast(u8, 255)) != ref_count(buf, 0, n, cast(u8, 255))) { return 40 + t; }
        let is i64 as want = cast(i64, 7 + n - ref_count(buf, 5, n + 5, cast(u8, 255)));
        if (count_ne(buf, 5, n + 5) != want) { return 60 + t; }
        if (count_i8(cast(*i8, buf), n) != 100 + ref_count(buf, 0, n, cast(u8, 128))) { return 80 + t; }
        t = t + 1;
    }
    // start past the end
    if (count_ne(buf, 50, 10) != 7) { return 100; }
    // every byte matches: more than 65535
    i = 0;
    while (i < size) { buf[i] = cast(u8, 0); i = i + 1; }
    if (count_eq(buf, size, cast(u8, 0)) != size) { return 101; }
    if (count_wrap(buf, 70000, 2147483647 - 100) != (0 - 2147483647) - 1 + 69899) { return 102; }
    buf[3] = cast(u8, 1); buf[9] = cast(u8, 1);
    // c: 0,0,0,1,1,1,1,1,1,2 → s = 0+0+0+1*6+2 = 8
    if (count_twice(buf, 10) != 8) { return 103; }
    return 0;
}
