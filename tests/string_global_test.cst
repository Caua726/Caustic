// A mutable string-initialized global owns a pointer, not the literal bytes.
use "../std/io.cst" as io;
use "modules/string_global_values.cst" as values;
let is *u8 as local_global with mut = "original";
let is *u8 as section_global with mut with section(".pointers") = "original";
fn same(a as *u8, b as *u8) as i32 {
    let is i64 as n with mut = 0;
    while (a[n] == b[n]) { if (a[n] == 0) { return 1; } n = n + 1; }
    return 0;
}
fn main() as i32 {
    if (same(local_global, "original") == 0 || same(values.read_current(), "original") == 0
        || values.empty[0] != 0 || same(values.shared, "original") == 0
        || same(section_global, "original") == 0
        || same(values.section_current, "module original") == 0
        || values.section_empty[0] != 0) { return 1; }
    let is **u8 as slot = values.current_address();
    if (*slot != values.read_current() || cast(i64, slot) == cast(i64, values.original())) { return 3; }
    let is **u8 as section_slot = &section_global;
    *section_slot = "section replacement";
    if (same(section_global, "section replacement") == 0
        || same(values.original(), "original") == 0) { return 8; }
    let is **u8 as module_section_slot = &values.section_current;
    let is **u8 as alternate_section_slot = &values.section_empty;
    *module_section_slot = "module replacement";
    *alternate_section_slot = "alternate replacement";
    if (same(values.section_current, "module replacement") == 0
        || same(values.section_empty, "alternate replacement") == 0
        || same(section_global, "section replacement") == 0) { return 9; }
    values.change("replacement");
    if (same(values.read_current(), "replacement") == 0 || same(*slot, "replacement") == 0) { return 4; }
    if (same(values.original(), "original") == 0 || same(values.shared, "original") == 0
        || same(local_global, "original") == 0) { return 5; }
    *slot = values.blank();
    if (values.read_current()[0] != 0 || values.empty[0] != 0) { return 6; }
    local_global = "changed independently";
    if (same(local_global, "changed independently") == 0 || same(values.shared, "original") == 0
        || same(values.original(), "original") == 0) { return 7; }
    io.write_str(io.STDOUT, "mutable string globals passed\n");
    return 0;
}
