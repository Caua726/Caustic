// std strcmp, a word at a time, against a byte-by-byte reference: random
// strings at every alignment, b running up to the end of a page, differing or
// ending anywhere, both ways round.
use "../std/string.cst" as string;
let is [16384]u8 as ga with mut;
let is [16384]u8 as gb with mut;

fn ref(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (1 == 1) {
        let is u8 as ca = a[i];
        let is u8 as cb = b[i];
        if (ca != cb || ca == 0) { return cast(i32, ca) - cast(i32, cb); }
        i = i + 1;
    }
    return 0;
}

let is u64 as seed with mut = 88172645463325252;
fn rnd() as u64 {
    seed = seed ^ (seed << 13);
    seed = seed ^ (seed >> 7);
    seed = seed ^ (seed << 17);
    return seed;
}

fn main() as i32 {
    // the buffers end exactly where a page may: b near a page boundary too
    let is *u8 as pa = cast(*u8, &ga);
    let is *u8 as pb = cast(*u8, &gb);
    let is i64 as round with mut = 0;
    while (round < 100000) {
        let is i64 as oa = cast(i64, rnd() % 4000) + 4096;
        let is i64 as ob with mut = cast(i64, rnd() % 40);
        if (rnd() % 2 == 0) { ob = 8192 - (cast(i64, pb) & 4095) - cast(i64, rnd() % 40); }
        else { ob = ob + 4096; }
        let is i64 as n = cast(i64, rnd() % 60);
        let is *u8 as a = pa + oa;
        let is *u8 as b = pb + ob;
        let is i64 as k with mut = 0;
        while (k < n) {
            let is u8 as c = cast(u8, 1 + rnd() % 255);
            a[k] = c; b[k] = c;
            k = k + 1;
        }
        a[n] = 0; b[n] = 0;
        let is u64 as mode = rnd() % 4;
        if (mode == 1 && n > 0) { b[cast(i64, rnd() % cast(u64, n))] = cast(u8, 1 + rnd() % 255); }
        if (mode == 2 && n > 0) { a[cast(i64, rnd() % cast(u64, n))] = 0; }
        if (mode == 3 && n > 0) { b[cast(i64, rnd() % cast(u64, n))] = 0; }
        if (string.strcmp(a, b) != ref(a, b)) { return 1; }
        if (string.strcmp(b, a) != ref(b, a)) { return 2; }
        round = round + 1;
    }
    return 0;
}
