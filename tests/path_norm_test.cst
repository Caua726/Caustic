// tests/path_norm_test.cst — normalize_path and the ".." it used to eat.
//
// A ".." with nothing left to remove was dropped instead of kept, so
// "coreutils/../../../X" normalized to "X" rather than "../../X" and the
// module it named stopped existing. It only bit relative source paths: an
// absolute one carries enough components for the extra pops to consume, which
// is why `caustic $PWD/foo.cst` worked while `caustic foo.cst` did not, from
// the same directory.
//
// The absolute case is genuinely different and stays as it was — POSIX says
// ".." above "/" is "/" — so the two must be told apart rather than unified.
//
// Exit code is the number of failures.
use "../std/io.cst" as io;
use "../src/semantic/scope.cst" as sc;

let is i32 as fails with mut = 0;

fn slen(s as *u8) as i32 {
    let is i32 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn chk(inp as *u8, want as *u8) as void {
    let is i32 as got_len with mut = 0;
    let is *u8 as got = sc.normalize_path(inp, slen(inp), &got_len);
    let is i32 as want_len = slen(want);
    let is i32 as ok with mut = 1;
    if (got_len != want_len) { ok = 0; }
    else {
        let is i32 as i with mut = 0;
        while (i < want_len) { if (got[i] != want[i]) { ok = 0; } i = i + 1; }
    }
    if (ok == 0) {
        fails = fails + 1;
        io.printf("  FAIL '%s' -> '%s' (want '%s')\n", inp, got, want);
    }
}

fn main() as i32 {
    // The case from the report: three levels up out of a one-level base.
    chk("coreutils/../../../X", "../../X");

    // Ordinary collapsing still works.
    chk("a/b/../c", "a/c");
    chk("a/./b",    "a/b");
    chk("a/../b",   "b");
    chk("./a",      "a");
    chk("a/b/c",    "a/b/c");

    // A leading ".." has nothing above it to remove and must survive — and a
    // second one must not eat the first.
    chk("..",        "..");
    chk("../../x",   "../../x");
    chk("../a/../b", "../b");

    // Absolute: ".." above the root is the root, so the extra one is dropped
    // and the leading separator is never consumed.
    chk("/a/../../b", "/b");
    chk("/a/b/../c",  "/a/c");
    chk("/../x",      "/x");

    // An absolute import names a file outright, so joining it to the importing
    // file's directory produced "/tmp//home/user/lib.cst" and resolved nowhere.
    let is i32 as rl with mut = 0;
    let is *u8 as abs_joined = sc.resolve_path("/tmp", 4, "/home/user/lib.cst", 18, &rl);
    let is i32 as abs_ok with mut = 1;
    if (rl != 18) { abs_ok = 0; }
    else {
        let is i32 as k with mut = 0;
        while (k < 18) { if (abs_joined[k] != "/home/user/lib.cst"[k]) { abs_ok = 0; } k = k + 1; }
    }
    if (abs_ok == 0) {
        fails = fails + 1;
        io.printf("  FAIL absolute import joined to source dir -> '%s'\n", abs_joined);
    }

    if (fails != 0) { io.printf("  path_norm_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
