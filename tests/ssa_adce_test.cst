// tests/ssa_adce_test.cst
//
// Dead code elimination on the SSA form (src/ir/opt_adce.cst). A loop whose
// work nobody reads goes when it provably ends: a counter stepped by one
// toward a bound that does not change. Such loops run here 10^11 times
// (minutes if they stay), so the test checks they took under a second: it
// runs at -O2 only (and at -O1, which has the pass too). A loop that might
// not end must stay even when its result is unused — Caustic promises no
// forward progress: an endless loop and a Collatz walk from 0 (which never
// reaches 1) each run in a child process that must still be running a moment
// later.
//
// Exit code 0 on success, else the number of the failing check.

use "../std/time.cst" as time;

fn dead_count(n as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { s = s + i * 3; i = i + 1; }
    return 7;
}

fn dead_nested(n as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as j with mut = 0;
        while (j < n) { s = s ^ (i + j); j = j + 1; }
        i = i + 1;
    }
    return 8;
}

fn dead_down(n as i32) as i32 {
    let is i32 as s with mut = 0;
    let is i32 as i with mut = n;
    while (i > 0) { s = s + i; i = i - 1; }
    return 9;
}

// The loop's result is used: it stays.
fn live_count(n as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { s = s + i; i = i + 1; }
    return s;
}

// Values computed in an if/else nobody reads, next to one that is read.
fn dead_diamond(x as i64) as i64 {
    let is i64 as a with mut = 0;
    let is i64 as b with mut = 0;
    if (x > 10) { a = x * 7; b = x - 1; } else { a = x / 3; b = x + 1; }
    return b;
}

fn forever(x0 as i64) as i64 {
    let is i64 as x with mut = x0;
    while (x != 0) { x = x + 2; }
    return x;
}

fn collatz(x0 as i64) as i64 {
    let is i64 as x with mut = x0;
    let is i64 as steps with mut = 0;
    while (x != 1) {
        if (x % 2 == 0) { x = x / 2; } else { x = 3 * x + 1; }
        steps = steps + 1;
    }
    return steps;
}

fn sleep_ms(ms as i64) as void {
    let is [2]i64 as ts;
    ts[0] = 0;
    ts[1] = ms * 1000000;
    syscall(35, &ts, 0);
}

// Run f(arg) in a child (its result unused); 1 if the child is still running
// after 200 ms, 0 if it has already exited.
fn still_running(which as i32, arg as i64) as i32 {
    let is i64 as pid = syscall(57);
    if (pid == 0) {
        if (which == 0) { forever(arg); } else { collatz(arg); }
        syscall(60, 0);
    }
    if (pid < 0) { return 0; }
    sleep_ms(200);
    let is i32 as st with mut = 0;
    let is i64 as r = syscall(61, pid, &st, 1, 0);
    if (r == pid) { return 0; }
    syscall(62, pid, 9);
    syscall(61, pid, &st, 0, 0);
    return 1;
}

fn main() as i32 {
    let is i64 as t0 = time.now_us();
    if (dead_count(100000000000) != 7) { return 1; }
    if (dead_nested(400000) != 8) { return 2; }
    if (dead_down(2000000000) != 9) { return 3; }
    let is i64 as t1 = time.now_us();
    if (t1 - t0 > 1000000) { return 4; }
    if (live_count(1000) != 499500) { return 5; }
    if (dead_diamond(20) != 19) { return 6; }
    if (dead_diamond(2) != 3) { return 7; }
    if (still_running(0, 1) != 1) { return 8; }
    if (still_running(1, 0) != 1) { return 9; }
    if (collatz(27) != 111) { return 10; }
    return 0;
}
