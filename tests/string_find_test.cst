// string.find / string.find_from edge cases.
// Exit code = number of failures (0 means pass).
use "../std/string.cst" as string;
use "../std/io.cst" as io;

let is i32 as bad with mut = 0;

fn mk(p as *u8) as string.String {
    let is string.String as s;
    s.ptr = p;
    s.len = cast(i32, string.strlen(p));
    s.cap = s.len;
    return s;
}

fn mkn(p as *u8, n as i32) as string.String {
    let is string.String as s;
    s.ptr = p;
    s.len = n;
    s.cap = n;
    return s;
}

fn chk(name as *u8, got as i32, want as i32) as void {
    if (got != want) {
        io.printf("FAIL %s got=%ld want=%ld\n", name, cast(i64, got), cast(i64, want));
        bad = bad + 1;
    }
}

fn f(h as *u8, n as *u8) as i32 {
    let is string.String as hs = mk(h);
    let is string.String as ns = mk(n);
    return string.find(hs, ns);
}

fn ff(h as *u8, n as *u8, start as i32) as i32 {
    let is string.String as hs = mk(h);
    let is string.String as ns = mk(n);
    return string.find_from(hs, ns, start);
}

fn basic() as void {
    chk("empty in empty", f("", ""), 0);
    chk("empty in text", f("abc", ""), 0);
    chk("text in empty", f("", "a"), 0 - 1);
    chk("needle longer", f("abc", "abcd"), 0 - 1);
    chk("same length no", f("abd", "abc"), 0 - 1);
    chk("same length yes", f("abc", "abc"), 0);
    chk("whole", f("hello", "hello"), 0);
    chk("prefix", f("hello", "hell"), 0);
    chk("middle", f("hello", "ell"), 1);
    chk("suffix", f("hello", "llo"), 2);
    chk("last char", f("hello", "o"), 4);
    chk("one byte hit", f("x", "x"), 0);
    chk("one byte tail", f("xy", "y"), 1);
    chk("absent", f("hello", "x"), 0 - 1);
    chk("absent longer", f("hello", "hellox"), 0 - 1);
    chk("overlap prefix", f("aaa", "aa"), 0);
    chk("overlap later", f("aaaaab", "aaab"), 2);
    chk("repeated anchor", f("abababc", "ababc"), 2);
    chk("mississippi", f("mississippi", "issip"), 4);
    chk("long run", f("aaaaaaaa", "aa"), 0);
    chk("all same needle", f("aaaaa", "aaaaa"), 0);
    chk("all same short", f("aaaaa", "aaa"), 0);
    chk("all same absent", f("aaaaa", "aaaab"), 0 - 1);
}

fn embedded() as void {
    let is [8]u8 as h;
    h[0] = 97; h[1] = 98; h[2] = 0; h[3] = 99; h[4] = 0; h[5] = 100; h[6] = 0; h[7] = 0;
    let is [4]u8 as n1;
    n1[0] = 0; n1[1] = 99; n1[2] = 0; n1[3] = 0;
    let is [4]u8 as n2;
    n2[0] = 98; n2[1] = 0; n2[2] = 0; n2[3] = 0;
    let is [4]u8 as n3;
    n3[0] = 99; n3[1] = 0; n3[2] = 0; n3[3] = 0;
    let is [4]u8 as hh;
    hh[0] = 97; hh[1] = 255; hh[2] = 98; hh[3] = 0;
    let is [4]u8 as nn;
    nn[0] = 255; nn[1] = 98; nn[2] = 0; nn[3] = 0;

    let is string.String as hs = mkn(cast(*u8, &h), 6);
    let is string.String as ns1 = mkn(cast(*u8, &n1), 2);
    let is string.String as ns2 = mkn(cast(*u8, &n2), 2);
    let is string.String as ns3 = mkn(cast(*u8, &n3), 2);
    chk("embedded nul at 2", string.find(hs, ns1), 2);
    chk("embedded nul at 1", string.find(hs, ns2), 1);
    chk("embedded nul tail", string.find(hs, ns3), 3);

    let is string.String as h2 = mkn(cast(*u8, &hh), 3);
    let is string.String as n2b = mkn(cast(*u8, &nn), 2);
    chk("high bytes", string.find(h2, n2b), 1);
}

fn starts() as void {
    chk("from 0", ff("abcabc", "abc", 0), 0);
    chk("from 1", ff("abcabc", "abc", 1), 3);
    chk("from 2", ff("abcabc", "abc", 2), 3);
    chk("from 3", ff("abcabc", "abc", 3), 3);
    chk("from 4", ff("abcabc", "abc", 4), 0 - 1);
    chk("from len", ff("abcabc", "abc", 6), 0 - 1);
    chk("from past len", ff("abcabc", "abc", 7), 0 - 1);
    chk("from overlap", ff("aaa", "aa", 1), 1);
    chk("from exact start", ff("xxab", "ab", 2), 2);
    chk("empty needle at 2", ff("abc", "", 2), 2);
    chk("empty needle at end", ff("abc", "", 3), 3);
    chk("empty needle past end", ff("abc", "", 10), 10);
    // A negative start is before the string: search from 0.
    chk("negative start", ff("xxab", "ab", 0 - 3), 2);
    chk("negative start empty", ff("abc", "", 0 - 3), 0);
}

fn long_input() as void {
    let is [1200]u8 as big;
    let is i32 as i with mut = 0;
    while (i < 1200) { big[i] = 122; i = i + 1; }
    big[0] = 113;
    big[1000] = 97;
    big[1001] = 98;
    big[1002] = 99;
    big[1003] = 100;
    big[1004] = 101;
    big[1005] = 102;
    big[1006] = 103;
    big[1007] = 104;
    let is string.String as hs = mkn(cast(*u8, &big), 1200);
    let is string.String as ns = mk("abcdefgh");
    chk("long hit", string.find(hs, ns), 1000);
    let is string.String as ns2 = mk("abcdefgi");
    chk("long miss", string.find(hs, ns2), 0 - 1);
    let is string.String as ns3 = mk("q");
    chk("long first", string.find(hs, ns3), 0);

    // The Horspool path must use the rightmost occurrence of a needle byte
    // in the skip table: a first-occurrence table shifts past the match at 1.
    let is [300]u8 as mix;
    mix[0] = 97; mix[1] = 97; mix[2] = 98; mix[3] = 97; mix[4] = 98;
    i = 5;
    while (i < 300) { mix[i] = 122; i = i + 1; }
    let is string.String as hm = mkn(cast(*u8, &mix), 300);
    let is string.String as nm = mk("abab");
    chk("horspool skip table", string.find(hm, nm), 1);

    let is [300]u8 as all_a;
    i = 0;
    while (i < 300) { all_a[i] = 97; i = i + 1; }
    let is string.String as ha = mkn(cast(*u8, &all_a), 300);
    let is string.String as na = mk("aaaa");
    chk("horspool repeated needle", string.find(ha, na), 0);
}

fn main() as i32 {
    basic();
    embedded();
    starts();
    long_input();
    io.printf("string_find failures=%ld\n", cast(i64, bad));
    return bad;
}
