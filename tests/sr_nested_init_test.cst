// tests/sr_nested_init_test.cst
//
// Strength reduction processes a loop nest from the outermost loop in. Each
// loop's pointer accumulators get their first value just before the loop's
// header. That header used to be found by walking as many nodes from the
// start of the list as its original position, which an outer loop's own
// inserted initial values had shifted: the inner loop's starting pointers
// landed before the outer loop and were computed once, from the outer IV's
// first value, so the k loop below read row 0 for every j. At -O1 and -O2
// the triangular update then walked off the array (a Cholesky step faulted
// on the page after it).
//
// Exit code 0 on success, else the number of the failing check.

let is i32 as N with imut = 6;
let is [36]i64 as A with mut;
let is [36]i64 as B with mut;

fn tri(a as *i64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < i) {
            let is i32 as k with mut = 0;
            while (k < j) { a[i * N + j] = a[i * N + j] + a[i * N + k] * 3 + a[j * N + k]; k = k + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
}

// The same update with the inner loop starting at 1 and an outer loop that
// starts at 2: every IV starts somewhere other than zero.
fn tri_from(a as *i64) as void {
    let is i32 as i with mut = 2;
    while (i < N) {
        let is i32 as j with mut = 1;
        while (j < i) {
            let is i32 as k with mut = 1;
            while (k < j) { a[i * N + j] = a[i * N + j] - a[j * N + k] + a[k * N + i]; k = k + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn hash(a as *i64) as i64 {
    let is i64 as h with mut = 7;
    let is i32 as t with mut = 0;
    while (t < 36) { h = (h * 31 + a[t]) % 1000003; t = t + 1; }
    return h;
}

fn main() as i32 {
    let is i32 as t with mut = 0;
    while (t < 36) { A[t] = cast(i64, t % 7 + 1); B[t] = cast(i64, t % 5 + 2); t = t + 1; }
    tri(cast(*i64, &A));
    if (hash(cast(*i64, &A)) != 666015) { return 1; }
    tri_from(cast(*i64, &B));
    // Reference: the -O0 result.
    let is [36]i64 as c;
    t = 0;
    while (t < 36) { c[t] = cast(i64, t % 5 + 2); t = t + 1; }
    let is i32 as i with mut = 2;
    while (i < N) {
        let is i32 as j with mut = 1;
        while (j < i) {
            let is i32 as k with mut = 1;
            while (k < j) {
                // Index arithmetic through a call, so it is not strength reduced.
                c[idx(i, j)] = c[idx(i, j)] - c[idx(j, k)] + c[idx(k, i)];
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if (hash(cast(*i64, &B)) != 416623) { return 2; }
    if (hash(cast(*i64, &c)) != 416623) { return 3; }
    return 0;
}

fn idx(r as i32, col as i32) as i32 {
    let is [1]i32 as box;
    box[0] = r * N + col;
    return box[0];
}
