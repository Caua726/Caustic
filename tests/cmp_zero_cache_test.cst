// tests/cmp_zero_cache_test.cst
//
// A compare whose result is a value (not fused into a branch) clears eax for
// its setcc first. At -O2 a 32-bit compare then reads its operand through the
// register cache, which could still claim that rax held a spilled operand:
// `nq == 0` below compared the freshly zeroed rax instead of nq, so nq became
// 1 and the loop ran once. The cache now forgets rax when it is cleared.
//
// Exit code 0 on success, else the number of the failing check.

use "../std/io.cst" as io;

let is i32 as cnt with mut = 0;
let is [64]u8 as buf with mut;

fn sink(a as i32) as void { cnt = cnt + a; }

fn qwords(ls as i32, lanes as i32) as i32 {
    let is i32 as nq with mut = (ls * lanes) / 8; if (nq == 0) { nq = 1; }
    let is i32 as runs with mut = 0;
    let is i32 as q with mut = 0;
    while (q < nq) {
        let is i64 as v with mut = 0;
        let is i32 as k with mut = 0;
        while (k < lanes) {
            let is i32 as bytepos = k * ls;
            if (bytepos / 8 == q) { v = v | (cast(i64, k) << cast(i64, (bytepos % 8) * 8)); }
            k = k + 1;
        }
        io.sprintf(cast(*u8, &buf), 64, "q=%d v=%ld\n", q, v);
        runs = runs + 1;
        q = q + 1;
    }
    if (nq == 4) { sink(1); }
    return runs;
}

fn main() as i32 {
    if (qwords(4, 8) != 4) { return 1; }
    if (qwords(4, 4) != 2) { return 2; }
    if (qwords(1, 4) != 1) { return 3; }
    if (cnt != 1) { return 4; }
    return 0;
}
