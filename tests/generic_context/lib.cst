// A generic module that leans on its own context: an import alias, a mutable
// global, an imut constant and a plain helper — none of them visible from the
// program that instantiates it.
use "../../std/mem.cst" as mem;

let is i64 as SEED with imut = 5;
let is i64 as calls with mut = 0;

fn _bump() as i64 { calls = calls + 1; return calls; }

struct Box gen T { item as T; n as i64; }

fn box_of gen T (v as T) as Box gen T {
    let is Box gen T as b;
    b.item = v;
    b.n = SEED + _bump();
    let is [8]u8 as scratch;
    mem.memset(&scratch[0], 0, 8);
    return b;
}

impl Box gen T {
    fn get(self as *Box gen T) as T { _bump(); return self.item; }
}

fn count() as i64 { return calls; }
