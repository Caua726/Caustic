// tests/div_rdx_test.cst
//
// A division clobbers rdx, the third integer argument register, and -O2 does
// not save it when nothing can be live there. The third parameter read after
// a division, arguments that are divisions, a syscall whose length is one,
// quotients and remainders signed and unsigned, by constants and by variables,
// the high half of a product, and inline asm that keeps a value in rdx across
// a division.
//
// Exit code 0 on success, else the number of the failing check.

fn third(a as i64, b as i64, c as i64) as i64 {
    let is i64 as q = a / 7;
    let is i64 as r = b % 11;
    return q * 1000 + r * 10 + c;
}

fn third_var(a as i64, b as i64, c as i64, d as i64) as i64 {
    let is i64 as q = a / d;
    return q + b + c;
}

fn third_u(a as u64, b as u64, c as u64) as u64 {
    return a / 13 + b % 13 + c;
}

fn three(a as i64, b as i64, c as i64, d as i64) as i64 {
    return a * 1000000 + b * 10000 + c * 100 + d;
}

fn args(x as i64) as i64 {
    return three(x / 3, x / 5, x / 7, x % 9);
}

fn nested(x as i64) as i64 {
    return three(x / 3, three(x / 5, 1, x / 7, 2), x % 9, third(x, x, x));
}

fn in_loop(n as i64, k as i64, c as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 1;
    while (i <= n) {
        s = s + i / 3 + i % 7 + k / i + c;
        i = i + 1;
    }
    return s;
}

// Inline asm: what it left in rdx is still there after the division (exit 9
// from the asm when it is not).
fn keeps(a as i64) as i64 {
    asm("mov rdx, 77\n");
    let is i64 as r = a / 3;
    asm("cmp rdx, 77\nje .Lkeeps_ok\nmov eax, 60\nmov edi, 9\nsyscall\n.Lkeeps_ok:\n");
    return r;
}

fn main() as i32 {
    if (third(700, 25, 5) != 100000 + 30 + 5) { return 1; }
    if (third_var(100, 3, 4, 7) != 14 + 3 + 4) { return 2; }
    if (third_u(cast(u64, 130), cast(u64, 27), cast(u64, 9)) != cast(u64, 10 + 1 + 9)) { return 3; }
    if (args(315) != 105 * 1000000 + 63 * 10000 + 45 * 100 + 0) { return 4; }
    if (nested(21) != 7 * 1000000 + three(4, 1, 3, 2) * 10000 + 3 * 100 + third(21, 21, 21)) { return 5; }

    let is i64 as t with mut = 0;
    let is i64 as i with mut = 1;
    while (i <= 40) { t = t + i / 3 + i % 7 + 1000 / i + 5; i = i + 1; }
    if (in_loop(40, 1000, 5) != t) { return 7; }

    // negative dividends, and a divisor of a power of two next to a magic one
    let is i64 as m with mut = 0 - 100;
    if (m / 7 != 0 - 14 || m % 7 != 0 - 2 || m / 8 != 0 - 12 || m % 8 != 0 - 4) { return 8; }

    if (keeps(9) != 3) { return 10; }

    // write(1, "", 0), the length a division
    if (syscall(1, 1, "", t / (t + 1)) != 0) { return 11; }
    return 0;
}
