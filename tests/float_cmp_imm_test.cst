// tests/float_cmp_imm_test.cst — a float compared against a folded constant
// must be compared against that constant.
//
// pass_fold_immediates turns `vreg defined by IMM` into an OP_IMM operand for
// LT/LE/GT/GE whenever the IMM's bits fit in 32 bits. For a float that is
// exactly the literal 0.0, whose IEEE bits are zero. The x86_64 float compare
// then loaded src2 by vreg number regardless — a stale number once the
// operand had been folded — so `x > 0.0` compared x against whatever register
// that number had last been given. At -O0 nothing folds and every answer was
// right; at -O1 and -O2 a compare after some integer work answered wrongly,
// and loops whose condition read such a compare stopped early.
//
// Each check runs both shapes the code generator has: a compare fused into
// the branch that follows it, and one whose 0/1 is kept as a value.
//
// Exit code is the number of failures.
use "../std/io.cst" as io;

let is i32 as fails with mut = 0;

fn chk(name as *u8, got as i32, want as i32) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, cast(i64, got), cast(i64, want));
    }
}

// Integer work first, so registers hold something other than the operands.
fn gt_branch(s as f64, k as i64) as i32 {
    let is i64 as j = k * 3;
    let is i32 as r with mut = 0;
    if (s > 0.0) { r = 1; }
    if (j > 100) { r = r + 10; }
    return r;
}

fn lt_branch(s as f64, k as i64) as i32 {
    let is i64 as j = k * 5;
    let is i32 as r with mut = 0;
    if (s < 0.0) { r = 1; }
    if (j > 1000) { r = r + 10; }
    return r;
}

fn ge_branch(s as f64, k as i64) as i32 {
    let is i64 as j = k + 9;
    let is i32 as r with mut = 0;
    if (s >= 0.0) { r = 1; }
    if (j > 1000) { r = r + 10; }
    return r;
}

fn le_branch(s as f64, k as i64) as i32 {
    let is i64 as j = k - 4;
    let is i32 as r with mut = 0;
    if (s <= 0.0) { r = 1; }
    if (j > 1000) { r = r + 10; }
    return r;
}

// The 0/1 kept as a value rather than branched on.
fn gt_value(s as f64, k as i64) as i32 {
    let is i64 as j = k * 7;
    let is i32 as v = cast(i32, s > 0.0);
    if (j > 1000) { return v + 10; }
    return v;
}

// The loop that first showed it: a condition reading an int and a float,
// with the int re-set inside from a float compare against 0.0.
fn rounds(spare0 as f64) as i32 {
    let is f64 as spare with mut = spare0;
    let is i32 as again with mut = 1;
    let is i32 as n with mut = 0;
    while (again == 1 && spare > 0.0000001) {
        again = 0;
        n = n + 1;
        spare = spare - 50.0;
        if (spare > 0.0) { again = 1; }
    }
    return n;
}

fn main() as i32 {
    chk("5.0 > 0.0", gt_branch(5.0, 7), 1);
    chk("-5.0 > 0.0", gt_branch(0.0 - 5.0, 7), 0);
    chk("0.0 > 0.0", gt_branch(0.0, 7), 0);
    chk("-5.0 < 0.0", lt_branch(0.0 - 5.0, 7), 1);
    chk("5.0 < 0.0", lt_branch(5.0, 7), 0);
    chk("0.0 >= 0.0", ge_branch(0.0, 7), 1);
    chk("-1.0 >= 0.0", ge_branch(0.0 - 1.0, 7), 0);
    chk("0.0 <= 0.0", le_branch(0.0, 7), 1);
    chk("1.0 <= 0.0", le_branch(1.0, 7), 0);
    chk("value 5.0 > 0.0", gt_value(5.0, 7), 1);
    chk("value -5.0 > 0.0", gt_value(0.0 - 5.0, 7), 0);
    chk("loop rounds", rounds(126.0), 3);
    if (fails != 0) {
        io.printf("float_cmp_imm_test: %d failures\n", cast(i64, fails));
    }
    return fails;
}
