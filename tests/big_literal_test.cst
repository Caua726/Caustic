// tests/big_literal_test.cst — a long string literal survives, and the
// allocator serves a request past its largest size class.
//
// TWO CEILINGS, both silent, found together while generating a table into a
// .cst file.
//
// caustic-assembler's ParsedLine held `dir_arg_len`, `decoded_len` and `size`
// as i16 — narrowed on purpose, because the whole .s is one array of them and
// every byte counts. A directive argument is not low-cardinality, though: a
// `.string` carrying a 32768-character literal wrapped to negative, the data
// landed truncated, and every offset after it was computed off the wrong size.
// 32767 worked. The only symptom was a program reading nonsense out of its own
// constant.
//
// Behind that, `bins_alloc` returned NULL for anything over its largest size
// class — 64 KiB — and the compiler's str_dup carried the NULL. A literal of
// 65536 characters made the build stop after "semantic: ok" with no output and
// no error at all. It now serves such a request straight from mmap.
//
// The literal below is 40000 bytes, past the first ceiling; the allocation is
// 200000, past the second. Checked byte by byte, because "it compiled" was
// exactly what both bugs let you believe.
//
// Exit 0 = all pass. Non-zero = the numbered check that failed.
use "../std/io.cst" as io;
use "../std/mem.cst" only bins as mem;

let is i64 as N with imut = 40000;
let is i64 as BIG with imut = 200000;

let is *u8 as LIT with imut =
    "";

let is mem.Bins as _heap with mut;

fn main() as i32 {
    // Every byte, not just the ends: a truncation shows up at the tail and a
    // wrapped length shows up in the middle.
    let is i64 as i with mut = 0;
    while (i < N) {
        if (cast(i64, LIT[i]) != 65 + ((i * 7) % 26)) { return 1; }
        i = i + 1;
    }
    // ...and the byte after it is the NUL the assembler's .string adds.
    if (cast(i64, LIT[N]) != 0) { return 2; }

    // Past the largest size class. This returned NULL until the allocator
    // learned to fall through to mmap.
    let is *u8 as p = mem.bins.bins_alloc(&_heap, BIG);
    if (cast(i64, p) == 0) { return 3; }
    i = 0;
    while (i < BIG) { p[i] = cast(u8, (i * 3 + 1) % 256); i = i + 1; }
    i = 0;
    while (i < BIG) {
        if (cast(i64, p[i]) != (i * 3 + 1) % 256) { return 4; }
        i = i + 1;
    }
    // Freeing it must reach munmap rather than being read as an out-of-range
    // bin index and dropped, which would leak exactly the big allocations.
    mem.bins.bins_free(&_heap, p);

    // A second one of the same size, to show the first was really released
    // and the header round-tripped.
    let is *u8 as q = mem.bins.bins_alloc(&_heap, BIG);
    if (cast(i64, q) == 0) { return 5; }
    q[0] = cast(u8, 1);
    q[BIG - 1] = cast(u8, 2);
    if (cast(i64, q[0]) != 1) { return 6; }
    if (cast(i64, q[BIG - 1]) != 2) { return 7; }
    mem.bins.bins_free(&_heap, q);

    // Ordinary small allocations still work through the same heap.
    let is *u8 as s = mem.bins.bins_alloc(&_heap, 64);
    if (cast(i64, s) == 0) { return 8; }
    s[63] = cast(u8, 5);
    if (cast(i64, s[63]) != 5) { return 9; }
    mem.bins.bins_free(&_heap, s);

    io.write_str(1, "big literal and big allocation both survive\n");
    return 0;
}
