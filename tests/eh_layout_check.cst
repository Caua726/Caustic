// Imported by the programs tests/run_tests.cst generates for its eh_frame
// layout sweep (build/ct_ehsweep.cst, with N filler functions each).
//
// A static executable's .eh_frame and .eh_frame_hdr close its R+X segment.
// The linker once placed the R+W segment on the page where .eh_frame_hdr
// ended, so mapping R+W replaced the table's tail with .rodata and the
// unwinder read garbage (backtrace and an uncaught throw crashed). Which
// programs hit it depended only on sizes, so the runner varies N until the
// table crosses a page boundary at least once.
//
// check() reads the program's own program headers from the loaded image
// (the first PT_LOAD maps the ELF header at the base address), then walks
// the stack through .eh_frame_hdr. Exit code: 0 = fine and the table stays
// inside one page, 3 = fine and the table crosses a page boundary,
// 1 = segments overlap or the table is outside its segment; a broken table
// crashes in the backtrace.
use "../std/exceptions.cst" as ex;

let is i64 as BASE with imut = 4194304;          // 0x400000

fn _u16(a as i64) as i64 { let is *u16 as p = cast(*u16, a); return cast(i64, p[0]); }
fn _u32(a as i64) as i64 { let is *u32 as p = cast(*u32, a); return cast(i64, p[0]); }
fn _u64(a as i64) as i64 { let is *i64 as p = cast(*i64, a); return p[0]; }

fn check() as i32 {
    let is i64 as phoff = _u64(BASE + 32);
    let is i64 as phent = _u16(BASE + 54);
    let is i64 as phnum = _u16(BASE + 56);
    let is i64 as rx_end with mut = 0;
    let is i64 as rw_start with mut = 0;
    let is i64 as eh_start with mut = 0;
    let is i64 as eh_end with mut = 0;
    let is i64 as loads with mut = 0;
    let is i64 as i with mut = 0;
    while (i < phnum) {
        let is i64 as ph = BASE + phoff + i * phent;
        let is i64 as kind = _u32(ph);
        let is i64 as va = _u64(ph + 16);
        let is i64 as msz = _u64(ph + 40);
        if (kind == 1) {
            if (loads == 0) { rx_end = va + msz; }
            else if (loads == 1) { rw_start = va; }
            loads = loads + 1;
        } else if (kind == 1685382480) {          // PT_GNU_EH_FRAME
            eh_start = va;
            eh_end = va + msz;
        }
        i = i + 1;
    }
    if (eh_start == 0) { return 1; }               // the sweep needs a table
    if (eh_end > rx_end) { return 1; }
    if (loads > 1 && (rw_start & (0 - 4096)) < ((rx_end + 4095) & (0 - 4096))) { return 1; }
    ex.backtrace(0 - 1, 0);                        // reads every FDE it steps through
    if ((eh_start >> 12) != ((eh_end - 1) >> 12)) { return 3; }
    return 0;
}
