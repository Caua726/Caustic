// tests/sr_full_chain_test.cst
//
// Strength reduction turns a[other + i] (an i32 index, so add, widen, shift,
// add the base) into a pointer that steps each iteration. Its first value is
// base + ((other + i0) << shift); it used to be base + (other << shift), which
// is right only when the loop starts at i = 0. A row of a 1-based matrix,
// a[row * W + i] for i = 1..N, read one element to the left at -O1 and -O2.
//
// Exit code 0 on success, else the number of the failing check.

let is i32 as W with imut = 5;
let is [25]i32 as grid with mut;

fn row_sum_from_1(a as *i32, row as i32) as i32 {
    let is i32 as s with mut = 0;
    let is i32 as i with mut = 1;
    while (i <= 4) { s = s + a[row * W + i]; i = i + 1; }
    return s;
}

fn row_sum_from(a as *i32, row as i32, k as i32) as i32 {
    let is i32 as s with mut = 0;
    let is i32 as i with mut = k;
    while (i < W) { s = s + a[row * W + i]; i = i + 1; }
    return s;
}

fn row_dot_col(a as *i32, b as *i32, row as i32, col as i32) as i32 {
    let is i32 as s with mut = 0;
    let is i32 as i with mut = 1;
    while (i <= 4) { s = s + a[row * W + i] * b[i * W + col]; i = i + 1; }
    return s;
}

fn row_sum_from_0(a as *i32, row as i32) as i32 {
    let is i32 as s with mut = 0;
    let is i32 as i with mut = 0;
    while (i < W) { s = s + a[row * W + i]; i = i + 1; }
    return s;
}

fn main() as i32 {
    let is i32 as i with mut = 0;
    while (i < 25) { grid[i] = i; i = i + 1; }
    let is *i32 as g = cast(*i32, &grid);
    if (row_sum_from_1(g, 1) != 30) { return 1; }           // 6+7+8+9
    if (row_sum_from_1(g, 3) != 70) { return 2; }           // 16+17+18+19
    if (row_sum_from(g, 2, 3) != 27) { return 3; }          // 13+14
    if (row_sum_from(g, 0, 0) != 10) { return 4; }
    if (row_dot_col(g, g, 1, 1) != 6*6 + 7*11 + 8*16 + 9*21) { return 5; }
    if (row_sum_from_0(g, 4) != 110) { return 6; }          // 20..24
    return 0;
}
