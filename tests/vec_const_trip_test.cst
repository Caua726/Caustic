// tests/vec_const_trip_test.cst
//
// A loop with a small constant trip count is both vectorized and fully
// unrolled at -O2. The vectorizer resumes the scalar loop at its header with
// the index past the start, and once the unroller turned that loop into
// straight copies counted from the start, the resumed copies wrote past the
// array (`g[z] = 0` over [8]i64 smashed the stack). The unroller now leaves a
// loop alone when its header is also reached by a jump. Constant trip counts
// below, at and above each vector width, with guard words around each array,
// through the loop widener and through the map vectorizer.
//
// Exit code 0 on success, else the number of the failing check.

struct G8 { lo as i64; g as [8]i64; hi as i64; }
struct G5 { lo as i64; g as [5]i32; pad as i32; hi as i64; }
struct G17 { lo as i64; g as [17]u16; pad as u16; hi as i64; }
struct M8 { lo as i64; c as [8]i64; hi as i64; }

// two arrays added into a third: the map vectorizer's shape
fn add8(m as *M8, a as *i64, b as *i64) as void {
    let is i64 as z with mut = 0;
    while (z < 8) { m.c[z] = a[z] + b[z]; z = z + 1; }
}

fn zero8(p as *G8) as void {
    let is i64 as z with mut = 0;
    while (z < 8) { p.g[z] = 0; z = z + 1; }
}

fn fill5(p as *G5) as void {
    let is i64 as z with mut = 0;
    while (z < 5) { p.g[z] = cast(i32, z) * 3 - 1; z = z + 1; }
}

fn fill17(p as *G17) as void {
    let is i64 as z with mut = 0;
    while (z < 17) { p.g[z] = cast(u16, z + 40000); z = z + 1; }
}

fn sum8(p as *G8) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as z with mut = 0;
    while (z < 8) { s = s ^ p.g[z]; z = z + 1; }
    return s;
}

fn main() as i32 {
    let is G8 as a;
    a.lo = 111; a.hi = 222;
    let is i64 as k with mut = 0;
    while (k < 8) { a.g[k] = k + 5; k = k + 1; }
    if (sum8(&a) != (5 ^ 6 ^ 7 ^ 8 ^ 9 ^ 10 ^ 11 ^ 12)) { return 1; }
    zero8(&a);
    if (a.lo != 111 || a.hi != 222) { return 2; }
    k = 0;
    while (k < 8) { if (a.g[k] != 0) { return 3; } k = k + 1; }
    let is G5 as b;
    b.lo = 333; b.pad = 444; b.hi = 555;
    fill5(&b);
    if (b.lo != 333 || b.pad != 444 || b.hi != 555) { return 4; }
    k = 0;
    while (k < 5) { if (b.g[k] != cast(i32, k) * 3 - 1) { return 5; } k = k + 1; }
    let is G17 as c;
    c.lo = 666; c.pad = cast(u16, 777); c.hi = 888;
    fill17(&c);
    if (c.lo != 666 || c.pad != cast(u16, 777) || c.hi != 888) { return 6; }
    k = 0;
    while (k < 17) { if (c.g[k] != cast(u16, k + 40000)) { return 7; } k = k + 1; }
    let is M8 as m;
    let is [8]i64 as x;
    let is [8]i64 as y;
    m.lo = 1; m.hi = 2;
    k = 0;
    while (k < 8) { x[k] = k; y[k] = 10 * k; k = k + 1; }
    add8(&m, cast(*i64, &x), cast(*i64, &y));
    if (m.lo != 1 || m.hi != 2) { return 8; }
    k = 0;
    while (k < 8) { if (m.c[k] != 11 * k) { return 9; } k = k + 1; }
    return 0;
}
