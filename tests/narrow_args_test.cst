// tests/narrow_args_test.cst
//
// A narrow integer argument reaches a function that is only ever called directly
// in its canonical 64-bit form, whatever produced it: arithmetic that wraps, a
// narrowing cast, a load, a loop variable written in a loop, a compare, another
// parameter passed on. The callee reads it whole (widening, comparing, indexing)
// without extending it again, so the caller's value must already be right.
//
// Exit code 0 on success, else the number of the failing check.

let is [8]i64 as table with mut;
let is i8 as gi8 with mut = 0 - 5;
let is u8 as gu8 with mut = 250;
let is i16 as gi16 with mut = 0 - 300;
let is u16 as gu16 with mut = 65000;
let is i32 as gi32 with mut = 0 - 70000;
let is u32 as gu32 with mut = 4000000000;

fn w8(x as i8) as i64 { return cast(i64, x); }
fn wu8(x as u8) as i64 { return cast(i64, x); }
fn w16(x as i16) as i64 { return cast(i64, x); }
fn wu16(x as u16) as i64 { return cast(i64, x); }
fn w32(x as i32) as i64 { return cast(i64, x); }
fn wu32(x as u32) as i64 { return cast(i64, x); }
fn neg(x as i32) as i32 { if (x < 0) { return 1; } return 0; }
fn low(a as i32, b as i32) as i32 { if (a < b) { return a; } return b; }
fn pass_on(x as i32) as i64 { return w32(x); }
fn at(i as i32) as i64 { return table[i]; }
fn is_true(b as bool) as i64 { return cast(i64, b); }

fn loop_sum(n as i32) as i64 {
    let is i32 as i with mut = 0;
    let is i64 as s with mut = 0;
    while (i < n) {
        s = s + w32(i - 3);
        i = i + 1;
    }
    return s;
}

fn wrap32(a as i32, b as i32) as i64 {
    return w32(a + b);
}

fn wrap8(a as i8) as i64 {
    return w8(a + 1);
}

fn wrapu8(a as u8) as i64 {
    return wu8(a + 1);
}

fn main() as i32 {
    if (w8(gi8) != 0 - 5) { return 1; }
    if (wu8(gu8) != 250) { return 2; }
    if (w16(gi16) != 0 - 300) { return 3; }
    if (wu16(gu16) != 65000) { return 4; }
    if (w32(gi32) != 0 - 70000) { return 5; }
    if (wu32(gu32) != 4000000000) { return 6; }
    if (wrap32(2147483647, 1) != 0 - 2147483648) { return 7; }
    if (wrap8(127) != 0 - 128) { return 8; }
    if (wrapu8(255) != 0) { return 9; }
    let is i64 as big with mut = 4294967296 + 7;
    if (w32(cast(i32, big)) != 7) { return 10; }
    big = 4294967295;
    if (w32(cast(i32, big)) != 0 - 1) { return 11; }
    if (wu32(cast(u32, big)) != 4294967295) { return 12; }
    if (neg(cast(i32, big)) != 1) { return 13; }
    if (low(cast(i32, big), 3) != 0 - 1) { return 14; }
    if (pass_on(gi32) != 0 - 70000) { return 15; }
    table[3] = 42;
    let is i64 as idx with mut = 4294967296 + 3;
    if (at(cast(i32, idx)) != 42) { return 16; }
    if (loop_sum(6) != 0 - 3) { return 17; }
    if (is_true(gi32 < 0) != 1 || is_true(gi32 > 0) != 0) { return 18; }
    return 0;
}
