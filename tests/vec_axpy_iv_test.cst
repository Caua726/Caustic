// tests/vec_axpy_iv_test.cst
//
// The multiply-add loop of a matrix product, c[j] = c[j] + k * b[j], which the
// vectorizer's multiply-add path takes once strength reduction has turned
// both addresses into pointers stepping by 8. Leaving SSA can write such a
// pointer, and an i64 counter, as `t = v + 8; v = t`: the pointer is then a
// pointer induction like `v = v + 8`, and the counter, the same shape, must
// not be advanced a second time as one. Products with i64 and i32 counters,
// sizes around every vector width, and one called with a constant size so it
// is inlined; each checksum is the one -O0 gives.
//
// Exit code 0 on success, else the number of the failing check.

let is i64 as opaque with mut = 0;
let is i64 as H64 with imut = 8138598131317765047;
let is i64 as H32 with imut = 8138598131317765047;
let is i64 as H16 with imut = 200729861090802808;

fn mm64(a as *i64, b as *i64, c as *i64, n as i64) as void {
    let is i64 as z with mut = 0;
    while (z < n * n) { c[z] = 0; z = z + 1; }
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as k with mut = 0;
        while (k < n) {
            let is i64 as aik = a[i * n + k];
            let is i64 as j with mut = 0;
            while (j < n) {
                let is *i64 as pb = cast(*i64, cast(i64, b) + (k * n + j) * 8);
                let is *i64 as pc = cast(*i64, cast(i64, c) + (i * n + j) * 8);
                *pc = *pc + aik * *pb;
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

fn mm32(a as *i64, b as *i64, c as *i64, n as i32) as void {
    let is i32 as z with mut = 0;
    while (z < n * n) {
        let is *i64 as pz = cast(*i64, cast(i64, c) + cast(i64, z) * 8);
        *pz = 0;
        z = z + 1;
    }
    let is i32 as i with mut = 0;
    while (i < n) {
        let is i32 as k with mut = 0;
        while (k < n) {
            let is *i64 as pa = cast(*i64, cast(i64, a) + cast(i64, i * n + k) * 8);
            let is i64 as aik = *pa;
            let is i32 as j with mut = 0;
            while (j < n) {
                let is *i64 as pb = cast(*i64, cast(i64, b) + cast(i64, k * n + j) * 8);
                let is *i64 as pc = cast(*i64, cast(i64, c) + cast(i64, i * n + j) * 8);
                *pc = *pc + aik * *pb;
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

fn sum(c as *i64, n as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as t with mut = 0;
    while (t < n * n) { s = s * 31 + c[t]; t = t + 1; }
    return s;
}

fn main() as i32 {
    let is [1600]i64 as a; let is [1600]i64 as b; let is [1600]i64 as c;
    let is i64 as t with mut = 0;
    while (t < 1600) { a[t] = t % 7 - 3; b[t] = (t * 13) % 11; c[t] = 99; t = t + 1; }
    let is [10]i64 as ns;
    ns[0] = 1; ns[1] = 2; ns[2] = 3; ns[3] = 4; ns[4] = 5; ns[5] = 7; ns[6] = 8; ns[7] = 9; ns[8] = 17; ns[9] = 37;
    let is i64 as h64 with mut = 0;
    let is i64 as h32 with mut = 0;
    let is i64 as q with mut = 0;
    while (q < 10) {
        let is i64 as n = ns[q] + opaque;
        mm64(&a[0], &b[0], &c[0], n);
        h64 = h64 * 1000003 + sum(&c[0], n);
        mm32(&a[0], &b[0], &c[0], cast(i32, n));
        h32 = h32 * 1000003 + sum(&c[0], n);
        q = q + 1;
    }
    if (h64 != H64) { return 1; }
    if (h32 != H32) { return 2; }
    mm32(&a[0], &b[0], &c[0], 16);
    if (sum(&c[0], 16) != H16) { return 3; }
    return 0;
}
