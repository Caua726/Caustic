// tests/source_hash_test.cst
//
// The source hash decides whether a cached token stream or syntax tree is the file
// on disk. djb2 could not tell "0b" from "1A": 33*48 + 98 == 33*49 + 65, so an edit
// between them kept the old program, with no error. Pairs here are ones a linear
// hash folds together. Exit 0 = all pass.

use "../src/lexer/cache.cst" as tc;

fn differ(a as *u8, b as *u8, n as i64) as i32 {
    if (tc.source_hash(a, n) != tc.source_hash(b, n)) { return 1; }
    return 0;
}

fn main() as i32 {
    if (differ("0b", "1A", 2) != 1) { return 1; }
    if (differ("x = \"0b\";", "x = \"1A\";", 9) != 1) { return 2; }
    if (differ("aB", "b!", 2) != 1) { return 3; }
    // Stable, and it reads every byte of what it is given.
    if (tc.source_hash("abc", 3) != tc.source_hash("abc", 3)) { return 4; }
    if (differ("abc", "abd", 3) != 1) { return 5; }
    if (tc.source_hash("abc", 2) == tc.source_hash("abc", 3)) { return 6; }
    return 0;
}
