// A sift-down whose test reads the array and whose choice picks the next index
// read from it: -O2 keeps this one a branch instead of a cmov (the misses of a
// big array would line up one behind the other). The answers must not depend
// on which it is. Also the same select where the chosen value is never an
// address, which stays a cmov.
//
// Exit code 0 on success, else the number of the failing check.

let is [65]i64 as heap with mut;
let is u64 as seed with mut = 88172645463325252;

fn rnd() as i64 {
    seed = seed ^ (seed << 13);
    seed = seed ^ (seed >> 7);
    seed = seed ^ (seed << 17);
    return cast(i64, seed % 1000);
}

fn sift(ra as *i64, start as i64, last as i64) as void {
    let is i64 as v = ra[start];
    let is i64 as i with mut = start;
    let is i64 as j with mut = start * 2;
    while (j <= last) {
        if (j < last && ra[j] < ra[j + 1]) { j = j + 1; }
        if (v < ra[j]) {
            ra[i] = ra[j];
            i = j;
            j = j + j;
        } else {
            j = last + 1;
        }
    }
    ra[i] = v;
}

fn sort(ra as *i64, n as i64) as void {
    let is i64 as k with mut = n / 2;
    while (k >= 1) { sift(ra, k, n); k = k - 1; }
    let is i64 as last with mut = n;
    while (last > 1) {
        let is i64 as t = ra[1];
        ra[1] = ra[last];
        ra[last] = t;
        last = last - 1;
        sift(ra, 1, last);
    }
}

fn largest(ra as *i64, n as i64) as i64 {
    let is i64 as best with mut = ra[1];
    let is i64 as i with mut = 2;
    while (i <= n) {
        if (best < ra[i]) { best = ra[i]; }
        i = i + 1;
    }
    return best;
}

fn main() as i32 {
    let is *i64 as ra = cast(*i64, &heap);
    let is i64 as n with mut = 1;
    while (n <= 64) {
        let is i64 as round with mut = 0;
        while (round < 50) {
            let is i64 as sum with mut = 0;
            let is i64 as most with mut = 0 - 1;
            let is i64 as i with mut = 1;
            while (i <= n) {
                let is i64 as v = rnd();
                ra[i] = v;
                sum = sum + v;
                if (v > most) { most = v; }
                i = i + 1;
            }
            if (largest(ra, n) != most) { return 1; }
            sort(ra, n);
            let is i64 as after with mut = 0;
            i = 1;
            while (i <= n) {
                after = after + ra[i];
                if (i > 1 && ra[i - 1] > ra[i]) { return 2; }
                i = i + 1;
            }
            if (after != sum) { return 3; }
            round = round + 1;
        }
        n = n + 1;
    }
    return 0;
}
