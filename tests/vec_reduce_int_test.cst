// tests/vec_reduce_int_test.cst
//
// At -O2 the loop widener (src/ir/vec/vec_widen.cst) keeps an integer
// reduction in vector lanes — a variable read before it is written in the
// iteration and combined only by + - ^ | & — and adds the lanes up after the
// loop. Every kind at every integer width, signed and unsigned, with values
// that wrap; chains of two operations (`r = r ^ (i + 1) ^ a[i]`); the
// induction variable as a value; a reduction under a condition; two
// reductions in one loop; trip counts around every vector width; a start
// that is not aligned and an index that does not start at 0. Each answer is
// checked against the same sum taken one element at a time through an
// index the vectorizer cannot follow.
//
// Exit code 0 on success, else the number of the failing check.

let is i64 as opaque with mut = 0;

fn xor_chain(a as *i32, n as i32) as i32 {
    let is i32 as r with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) { r = r ^ (i + 1) ^ a[i]; i = i + 1; }
    return r;
}
fn ref_xor_chain(a as *i32, n as i32) as i32 {
    let is i32 as r with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) { r = r ^ (i + 1) ^ a[i]; i = i + 1 + cast(i32, opaque); }
    return r;
}

fn sum8(a as *i8, n as i64) as i8 {
    let is i8 as s with mut = 5;
    let is i64 as i with mut = 0;
    while (i < n) { s = s + a[i]; i = i + 1; }
    return s;
}
fn ref_sum8(a as *i8, n as i64) as i8 {
    let is i8 as s with mut = 5;
    let is i64 as i with mut = 0;
    while (i < n) { s = s + a[i]; i = i + 1 + opaque; }
    return s;
}

fn sub16(a as *u16, n as i64) as u16 {
    let is u16 as s with mut = 7;
    let is i64 as i with mut = 0;
    while (i < n) { s = s - a[i]; i = i + 1; }
    return s;
}
fn ref_sub16(a as *u16, n as i64) as u16 {
    let is u16 as s with mut = 7;
    let is i64 as i with mut = 0;
    while (i < n) { s = s - a[i]; i = i + 1 + opaque; }
    return s;
}

fn or32(a as *u32, n as i64) as u32 {
    let is u32 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { s = s | a[i]; i = i + 1; }
    return s;
}
fn ref_or32(a as *u32, n as i64) as u32 {
    let is u32 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { s = s | a[i]; i = i + 1 + opaque; }
    return s;
}

fn and64(a as *i64, n as i64) as i64 {
    let is i64 as s with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < n) { s = s & a[i]; i = i + 1; }
    return s;
}
fn ref_and64(a as *i64, n as i64) as i64 {
    let is i64 as s with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < n) { s = s & a[i]; i = i + 1 + opaque; }
    return s;
}

fn xor8(a as *u8, n as i64) as u8 {
    let is u8 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { s = s ^ a[i]; i = i + 1; }
    return s;
}
fn ref_xor8(a as *u8, n as i64) as u8 {
    let is u8 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { s = s ^ a[i]; i = i + 1 + opaque; }
    return s;
}

// a sum of i32 that wraps, starting from an index other than 0
fn sum32_from(a as *i32, s0 as i32, n as i32) as i32 {
    let is i32 as s with mut = 2147483000;
    let is i32 as i with mut = s0;
    while (i < n) { s = s + a[i]; i = i + 1; }
    return s;
}
fn ref_sum32_from(a as *i32, s0 as i32, n as i32) as i32 {
    let is i32 as s with mut = 2147483000;
    let is i32 as i with mut = s0;
    while (i < n) { s = s + a[i]; i = i + 1 + cast(i32, opaque); }
    return s;
}

// only the positive elements: the lanes add 0 where the condition fails
fn sum_pos(a as *i32, n as i64) as i32 {
    let is i32 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (a[i] > 0) { s = s + a[i]; }
        i = i + 1;
    }
    return s;
}
fn ref_sum_pos(a as *i32, n as i64) as i32 {
    let is i32 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (a[i] > 0) { s = s + a[i]; }
        i = i + 1 + opaque;
    }
    return s;
}

// two reductions and the index as a value
fn two(a as *i64, n as i64, out as *i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as x with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { s = s + a[i] * 3 - i; x = x ^ a[i]; i = i + 1; }
    *out = x;
    return s;
}
fn ref_two(a as *i64, n as i64, out as *i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as x with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { s = s + a[i] * 3 - i; x = x ^ a[i]; i = i + 1 + opaque; }
    *out = x;
    return s;
}

fn main() as i32 {
    let is [80]i32 as a32;
    let is [80]i8 as a8;
    let is [80]u16 as a16;
    let is [80]u32 as u32s;
    let is [80]i64 as a64;
    let is [80]u8 as u8s;
    let is i64 as k with mut = 0;
    let is u64 as seed with mut = 88172645463325252;
    while (k < 80) {
        seed = seed ^ (seed << 13); seed = seed ^ (seed >> 7); seed = seed ^ (seed << 17);
        a32[k] = cast(i32, cast(i64, seed & 2147483647) - 1073741824);
        a8[k] = cast(i8, cast(i64, seed >> 20) & 255);
        a16[k] = cast(u16, (seed >> 30) & 65535);
        u32s[k] = cast(u32, (seed >> 7) & 4294967295) & cast(u32, 1 << cast(u64, k % 32));
        a64[k] = cast(i64, seed) | 1152921504606846976;
        if (k % 11 == 3) { a64[k] = cast(i64, seed) & (0 - 9); }
        u8s[k] = cast(u8, seed & 255);
        k = k + 1;
    }
    let is [12]i64 as ns;
    ns[0] = 0; ns[1] = 1; ns[2] = 3; ns[3] = 7; ns[4] = 8; ns[5] = 9; ns[6] = 15;
    ns[7] = 16; ns[8] = 17; ns[9] = 31; ns[10] = 33; ns[11] = 71;
    let is i64 as t with mut = 0;
    while (t < 12) {
        let is i64 as n = ns[t] + opaque;
        let is i64 as off with mut = 0;
        while (off < 3) {
            let is *i32 as p32 = cast(*i32, cast(i64, &a32) + off * 4);
            let is *i8 as p8 = cast(*i8, cast(i64, &a8) + off);
            let is *u16 as p16 = cast(*u16, cast(i64, &a16) + off * 2);
            let is *u32 as pu32 = cast(*u32, cast(i64, &u32s) + off * 4);
            let is *i64 as p64 = cast(*i64, cast(i64, &a64) + off * 8);
            let is *u8 as pu8 = cast(*u8, cast(i64, &u8s) + off);
            let is i32 as fail = cast(i32, t * 10);
            if (xor_chain(p32, cast(i32, n)) != ref_xor_chain(p32, cast(i32, n))) { return fail + 1; }
            if (sum8(p8, n) != ref_sum8(p8, n)) { return fail + 2; }
            if (sub16(p16, n) != ref_sub16(p16, n)) { return fail + 3; }
            if (or32(pu32, n) != ref_or32(pu32, n)) { return fail + 4; }
            if (and64(p64, n) != ref_and64(p64, n)) { return fail + 5; }
            if (xor8(pu8, n) != ref_xor8(pu8, n)) { return fail + 6; }
            if (sum32_from(p32, 2, cast(i32, n)) != ref_sum32_from(p32, 2, cast(i32, n))) { return fail + 7; }
            if (sum_pos(p32, n) != ref_sum_pos(p32, n)) { return fail + 8; }
            let is i64 as x1 with mut = 0;
            let is i64 as x2 with mut = 0;
            if (two(p64, n, &x1) != ref_two(p64, n, &x2) || x1 != x2) { return fail + 9; }
            off = off + 1;
        }
        t = t + 1;
    }
    return 0;
}
