// tests/f32_spill_cache_test.cst
//
// At -O1 and up, codegen remembers which scratch register last held a
// spilled vreg so a second read can skip the reload. A load straight into an
// XMM-allocated vreg goes through scratch (an f32 is loaded, widened and moved
// over with movq) and did not forget what scratch held: the next read of the
// spilled vreg came from a register that now held the float. Column pivoting
// in an LU factorization hit it: a spilled column pointer, reread after an
// f32 compare and swap, pointed at the float's bits and the store segfaulted.
//
// Exit code 0 on success, else the number of the failing check.

let is i32 as info with mut = 0;

fn at(p as *f32, off as i32) as *f32 { return cast(*f32, cast(i64, p) + cast(i64, off) * 4); }

fn absf(v as f32) as f32 {
    if (v < 0.0) { return 0.0 - v; }
    return v;
}

fn amax(n as i32, dx as *f32) as i32 {
    if (n < 1) { return 0 - 1; }
    if (n == 1) { return 0; }
    let is i32 as best with mut = 0;
    let is f32 as big with mut = absf(dx[0]);
    let is i32 as i with mut = 1;
    while (i < n) {
        let is f32 as v = absf(dx[i]);
        if (v > big) { best = i; big = v; }
        i = i + 1;
    }
    return best;
}

fn axpy(n as i32, da as f32, dx as *f32, dy as *f32) as void {
    if (n <= 0) { return; }
    if (da == 0.0) { return; }
    let is i32 as i with mut = 0;
    while (i < n) { dy[i] = dy[i] + da * dx[i]; i = i + 1; }
}

fn scale(n as i32, da as f32, dx as *f32) as void {
    let is i32 as i with mut = 0;
    while (i < n) { dx[i] = da * dx[i]; i = i + 1; }
}

// Gaussian elimination with partial pivoting, column-major with leading
// dimension lda.
fn factor(m as *f32, lda as i32, n as i32, piv as *i32) as void {
    info = 0;
    let is i32 as nm1 = n - 1;
    let is i32 as k with mut = 0;
    while (k < nm1) {
        let is *f32 as col_k = at(m, lda * k);
        let is i32 as l = amax(n - k, at(col_k, k)) + k;
        piv[k] = l;
        if (col_k[l] != 0.0) {
            if (l != k) {
                let is f32 as t = col_k[l];
                col_k[l] = col_k[k];
                col_k[k] = t;
            }
            let is f32 as t = cast(f32, (0.0 - 1.0) / cast(f64, col_k[k]));
            scale(n - (k + 1), t, at(col_k, k + 1));
            let is i32 as j with mut = k + 1;
            while (j < n) {
                let is *f32 as col_j = at(m, lda * j);
                let is f32 as tj = col_j[l];
                if (l != k) {
                    col_j[l] = col_j[k];
                    col_j[k] = tj;
                }
                axpy(n - (k + 1), tj, at(col_k, k + 1), at(col_j, k + 1));
                j = j + 1;
            }
        } else {
            info = k;
        }
        k = k + 1;
    }
    piv[n - 1] = n - 1;
}

fn main() as i32 {
    // Columns of [[1 2 0] [4 1 1] [2 0 3]]: pivoting swaps rows 0 and 1.
    let is [9]f32 as m;
    m[0] = 1.0; m[1] = 4.0; m[2] = 2.0;
    m[3] = 2.0; m[4] = 1.0; m[5] = 0.0;
    m[6] = 0.0; m[7] = 1.0; m[8] = 3.0;
    let is [3]i32 as piv;
    factor(cast(*f32, &m), 3, 3, cast(*i32, &piv));
    if (piv[0] != 1) { return 1; }
    if (m[0] != 4.0 || m[3] != 1.0 || m[6] != 1.0) { return 2; }    // pivot row on top
    if (m[1] != 0.0 - 0.25 || m[2] != 0.0 - 0.5) { return 3; }      // multipliers
    if (info != 0) { return 4; }
    return 0;
}
