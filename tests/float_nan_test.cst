// IEEE unordered comparisons, both branch directions and materialized values.
use "../std/io.cst" as io;
let is i32 as fails with mut = 0;
fn raw64(bits as i64) as f64 { return *cast(*f64, &bits); }
fn raw32(bits as i64) as f32 { return *cast(*f32, &bits); }
fn check(name as *u8, got as i32, want as i32) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("FAIL %s: got=%d want=%d\n", name, cast(i64, got), cast(i64, want));
    }
}

fn materialized64(a as f64, b as f64) as i32 {
    return (cast(i32, a == b) * 1) | (cast(i32, a != b) * 2) | (cast(i32, a < b) * 4) | (cast(i32, a <= b) * 8) | (cast(i32, a > b) * 16) | (cast(i32, a >= b) * 32);
}
fn false_branch64(a as f64, b as f64) as i32 {
    let is i32 as mask with mut = 0;
    if (a == b) { mask = mask | 1; }
    if (a != b) { mask = mask | 2; }
    if (a < b) { mask = mask | 4; }
    if (a <= b) { mask = mask | 8; }
    if (a > b) { mask = mask | 16; }
    if (a >= b) { mask = mask | 32; }
    return mask;
}
fn true_branch64(a as f64, b as f64, fallback as i32) as i32 {
    return (cast(i32, (a == b) || fallback != 0) * 1) | (cast(i32, (a != b) || fallback != 0) * 2) | (cast(i32, (a < b) || fallback != 0) * 4) | (cast(i32, (a <= b) || fallback != 0) * 8) | (cast(i32, (a > b) || fallback != 0) * 16) | (cast(i32, (a >= b) || fallback != 0) * 32);
}
fn check64(name as *u8, a as f64, b as f64, want as i32) as void {
    check(name, materialized64(a, b), want);
    check(name, false_branch64(a, b), want);
    check(name, true_branch64(a, b, 0), want);
}

fn materialized32(a as f32, b as f32) as i32 {
    return (cast(i32, a == b) * 1) | (cast(i32, a != b) * 2) | (cast(i32, a < b) * 4) | (cast(i32, a <= b) * 8) | (cast(i32, a > b) * 16) | (cast(i32, a >= b) * 32);
}
fn false_branch32(a as f32, b as f32) as i32 {
    let is i32 as mask with mut = 0;
    if (a == b) { mask = mask | 1; }
    if (a != b) { mask = mask | 2; }
    if (a < b) { mask = mask | 4; }
    if (a <= b) { mask = mask | 8; }
    if (a > b) { mask = mask | 16; }
    if (a >= b) { mask = mask | 32; }
    return mask;
}
fn true_branch32(a as f32, b as f32, fallback as i32) as i32 {
    return (cast(i32, (a == b) || fallback != 0) * 1) | (cast(i32, (a != b) || fallback != 0) * 2) | (cast(i32, (a < b) || fallback != 0) * 4) | (cast(i32, (a <= b) || fallback != 0) * 8) | (cast(i32, (a > b) || fallback != 0) * 16) | (cast(i32, (a >= b) || fallback != 0) * 32);
}
fn check32(name as *u8, a as f32, b as f32, want as i32) as void {
    check(name, materialized32(a, b), want);
    check(name, false_branch32(a, b), want);
    check(name, true_branch32(a, b, 0), want);
}

fn main() as i32 {
    let is f64 as nan64 = raw64(0x7ff8000000000001);
    let is f64 as inf64 = raw64(0x7ff0000000000000);
    let is f64 as nz64 = raw64(cast(i64, 1) << 63);
    check64("f64 NaN left", nan64, cast(f64, 1.0), 2);
    check64("f64 NaN right", cast(f64, 1.0), nan64, 2);
    check64("f64 NaN both", nan64, nan64, 2);
    check64("f64 signed zero", nz64, cast(f64, 0.0), 41);
    check64("f64 positive infinity", inf64, cast(f64, 1.0), 50);
    check64("f64 negative infinity", -inf64, cast(f64, 1.0), 14);
    check64("f64 equal infinity", inf64, inf64, 41);
    check64("f64 finite less", cast(f64, 1.0), cast(f64, 2.0), 14);
    check64("f64 finite greater", cast(f64, 2.0), cast(f64, 1.0), 50);
    let is f32 as nan32 = raw32(0x7fc00001);
    let is f32 as inf32 = raw32(0x7f800000);
    let is f32 as nz32 = raw32(cast(i64, 1) << 31);
    check32("f32 NaN left", nan32, cast(f32, 1.0), 2);
    check32("f32 NaN right", cast(f32, 1.0), nan32, 2);
    check32("f32 NaN both", nan32, nan32, 2);
    check32("f32 signed zero", nz32, cast(f32, 0.0), 41);
    check32("f32 positive infinity", inf32, cast(f32, 1.0), 50);
    check32("f32 negative infinity", -inf32, cast(f32, 1.0), 14);
    check32("f32 equal infinity", inf32, inf32, 41);
    check32("f32 finite less", cast(f32, 1.0), cast(f32, 2.0), 14);
    check32("f32 finite greater", cast(f32, 2.0), cast(f32, 1.0), 50);
    if (fails == 0) { io.write_str(io.STDOUT, "IEEE comparison matrix passed\n"); }
    return fails;
}
