// A Windows program importing Unix-only modules — a versioned and an
// unversioned shared object — behind os.current(), plus the Windows module.
use "../../std/os.cst" as os;
use "../modules/foreign_linux.cst" as lin;
use "../modules/foreign_unix.cst" as unix;
use "../modules/foreign_windows.cst" as win;

let is i32 as runtime with mut = 3;

fn main() as i32 {
    if (os.current() == os.OS_LINUX && runtime == 3) {
        return cast(i32, lin.pid() + unix.value());
    }
    if (os.current() == os.OS_WINDOWS && runtime == 3) {
        if (win.desktop() == 0 || win.shell() == 0 - 1) { return 1; }
        return 0;
    }
    return 3;
}
