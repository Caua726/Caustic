// Target guards must fold before foreign-call reachability/import emission.
use "../../std/os.cst" as os;

extern "libc.so.6" fn getpid() as i32;
extern "user32.dll" fn GetDesktopWindow() as *u8;

fn callback(value as i32) as i32 { return value + 19; }

fn main() as i32 {
    let is fn(i32) as i32 as cb = fn_ptr(callback);
    if (call(cb, 23) != 42) { return 1; }
    if (!(os.current() != os.OS_LINUX || os.current() == os.OS_WINDOWS)) {
        if (getpid() <= 0) { return 2; }
        if (os.linux.getpid() <= 0) { return 3; }
        return 0;
    } else if (os.current() == os.OS_WINDOWS && os.current() != os.OS_LINUX) {
        if (GetDesktopWindow() == cast(*u8, 0)) { return 4; }
        if (os.windows.GetCurrentProcessId() == 0) { return 5; }
        return 0;
    }
    return 6;
}
