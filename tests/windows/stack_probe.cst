// An 8192-byte local must probe every intervening Windows guard page.
// Recursive calls keep the array live across calls and grow beyond the initial
// committed stack; checking it afterwards also catches clobbered probe registers.
fn probe(depth as i32, seed as i32) as i32 {
    let is [8192]u8 as bytes;
    let is i32 as i with mut = 0;
    while (i < 8192) {
        bytes[i] = cast(u8, (i + seed) % 251);
        i = i + 1;
    }
    if (depth > 0) {
        if (probe(depth - 1, seed + 7) != 0) { return 1; }
    }
    i = 0;
    while (i < 8192) {
        if (bytes[i] != cast(u8, (i + seed) % 251)) { return 2; }
        i = i + 1;
    }
    return 0;
}

fn main() as i32 { return probe(24, 13); }
