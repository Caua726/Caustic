// tests/shift_fold_test.cst
//
// Constant folding of shifts follows the instructions: a right shift of an
// unsigned type shifts zeros in (it used to be folded arithmetically, so
// u64 0xFFFFFFFFFFFFFFF0 >> 60 became all ones instead of 15 at -O1/-O2),
// a signed one copies the sign, and counts are taken mod 64.
//
// Exit code 0 on success, else the number of the failing check.

let is u64 as G = 18446744073709551600;
fn main() as i32 {
    let is u64 as a = 18446744073709551600;
    let is u64 as b = a >> 60;
    let is i64 as c = cast(i64, 0) - 32;
    let is i64 as d = c >> 2;
    let is u32 as e = 4294967295;
    let is u32 as f = e >> 28;
    if (b != 15) { return 1; }
    if (d != 0 - 8) { return 2; }
    if (f != 15) { return 3; }
    let is u64 as g = cast(u64, 18446744073709551600) >> 60;
    if (g != 15) { return 4; }
    if ((G >> 60) != 15) { return 5; }
    let is u8 as h = 200;
    let is u8 as hh = h >> 3;
    if (hh != 25) { return 6; }
    let is i8 as n = 0 - 100;
    let is i8 as nn = n >> 2;
    if (nn != 0 - 25) { return 7; }
    let is i64 as one = 1;
    let is i64 as wrap = one << 66;
    if (wrap != 4) { return 8; }
    return 0;
}
