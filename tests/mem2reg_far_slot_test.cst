// tests/mem2reg_far_slot_test.cst
//
// mem2reg promotes a scalar local whatever its frame offset. Scalars declared
// after a large local array sit more than 8 KB into the frame; they used to be
// left in memory, while phi placement still counted them. These functions put
// loop counters, accumulators and values merged across branches past that
// point and check the results, in one block and across many.
//
// Exit code 0 on success, else the number of the failing check.

fn sum_after_array(n as i32) as i64 {
    let is [4096]i32 as big;
    let is i32 as i with mut = 0;
    while (i < 4096) { big[i] = i; i = i + 1; }
    let is i64 as acc with mut = 0;
    let is i32 as j with mut = 0;
    while (j < n) {
        if (j % 3 == 0) { acc = acc + cast(i64, big[j]); }
        else { acc = acc - 1; }
        j = j + 1;
    }
    return acc;
}

fn straight_line(x as i64) as i64 {
    let is [3000]i64 as pad;
    pad[0] = x;
    let is i64 as a = pad[0] + 1;
    let is i64 as b with mut = a * 2;
    b = b + a;
    return b;
}

fn two_arrays(n as i32) as i32 {
    let is [2048]f32 as xs;
    let is [2048]f32 as ys;
    let is f32 as a with mut = 0.0;
    let is f32 as b with mut = 1.0;
    let is i32 as round with mut = 0;
    let is i32 as hits with mut = 0;
    while (round < n) {
        if (round % 2 == 0) { a = a + 1.0; } else { b = b + 2.0; }
        let is i32 as k with mut = 0;
        while (k < 2048) { xs[k] = a; ys[k] = b; k = k + 1; }
        if (xs[2047] < ys[0]) { hits = hits + 1; }
        round = round + 1;
    }
    return hits;
}

fn main() as i32 {
    // j = 0..99: 34 multiples of 3 summing to 3*(0+..+33) = 1683, minus 66.
    if (sum_after_array(100) != 1683 - 66) { return 1; }
    if (straight_line(4) != 15) { return 2; }
    // After round r, a counts the even rounds so far and b = 1 + 2 * the odd
    // ones; a < b in every round but the first (a = b = 1).
    if (two_arrays(10) != 9) { return 3; }
    return 0;
}
