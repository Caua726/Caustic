// tests/inline_args_test.cst
//
// Calls with more than six arguments, inlined at -O2. Arguments past the
// sixth travel on the machine stack: the call site pushes them between a
// `sub rsp, 8` (when their count is odd) and an `add rsp, N` after the call.
// An inlined copy drops the pushes, both adjustments and the call, and reads
// every argument from the value the caller computed. Also covered: a callee
// that itself makes such a call (its stack adjustments come along with the
// copy), floats among the extra arguments, a struct result through the hidden
// first argument together with seven more, and constants among the arguments.
//
// Exit code 0 on success, else the number of the failing check.

struct Wide { a as i64; b as i64; c as i64; }

fn seven(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64, g as i64) as i64 {
    return a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g;
}

fn eight(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64, g as i64, h as i64) as i64 {
    return (a - b) * (c - d) + (e - f) * (g - h);
}

fn nine_mixed(a as i32, x as f64, b as i32, y as f64, c as i32, z as f64, d as i32, w as f64, e as i32) as f64 {
    return cast(f64, a + b + c + d + e) + x * y + z * w;
}

// Makes a seven-argument call of its own.
fn relay(k as i64) as i64 {
    return seven(k, k + 1, k + 2, k + 3, k + 4, k + 5, k + 6) - 1;
}

fn wide7(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64, g as i64) as Wide {
    let is Wide as r;
    r.a = a + b; r.b = c + d + e; r.c = f * g;
    return r;
}

fn main() as i32 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < 10) {
        s = s + seven(i, i, i, i, i, i, i);
        i = i + 1;
    }
    // sum over i of 28 i
    if (s != 28 * 45) { return 1; }

    let is i64 as t with mut = 0;
    i = 0;
    while (i < 10) {
        t = t + eight(i, 1, 5, i, 2, i, 7, 3);
        i = i + 1;
    }
    // (i - 1)(5 - i) + (2 - i) * 4, summed over 0..9
    let is i64 as tw with mut = 0;
    let is i64 as j with mut = 0;
    while (j < 10) { tw = tw + (j - 1) * (5 - j) + (2 - j) * 4; j = j + 1; }
    if (t != tw) { return 2; }

    let is f64 as m with mut = 0.0;
    let is i32 as k with mut = 0;
    while (k < 4) {
        m = m + nine_mixed(k, 1.5, 1, 2.0, 2, 0.5, 3, 4.0, 4);
        k = k + 1;
    }
    // per k: (k + 10) + 3.0 + 2.0; k = 0..3 -> 46 + 20
    if (m != 66.0) { return 3; }

    let is i64 as r with mut = 0;
    i = 0;
    while (i < 5) { r = r + relay(i); i = i + 1; }
    // seven(k..k+6) = 28k + (2 + 6 + 12 + 20 + 30 + 42) = 28k + 112
    if (r != 28 * 10 + 5 * 111) { return 4; }

    let is i64 as wsum with mut = 0;
    i = 0;
    while (i < 3) {
        let is Wide as w = wide7(i, 1, 2, 3, 4, i, 5);
        wsum = wsum + w.a + w.b + w.c;
        i = i + 1;
    }
    // per i: (i + 1) + 9 + 5i
    if (wsum != 3 + 27 + 5 * 3 + 3) { return 5; }
    return 0;
}
