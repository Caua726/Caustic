// tests/unicode_width_test.cst — std/unicode.cst's column measurement, and the
// defects it was written to remove.
//
// Why this file exists at all, given that caustic-unicode ships width tests: its
// cases were chosen so that grapheme clustering and a plain per-code-point sum
// agree, which was proven by mutation rather than assumed — replacing the
// clustering with a sum left that suite passing with exit 0. Everything below
// distinguishes the two, or distinguishes the three states of cluster_next, or
// feeds in bytes nobody in this tree wrote.
//
// The three emoji rows are the reason the Emoji_Presentation table was
// generated. All three measured 1 before it existed, against terminals that draw
// all three two columns wide.
//
// Exit 0 = all passed; the exit code is the number of failures.
use "../std/io.cst" as io;
use "../std/unicode.cst" as unicode;

let is i32 as fails with mut = 0;

fn chk(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, got, want);
    }
}

// === One code point ===

fn t_cp() as void {
    chk("cp 'A'", unicode.cp_width(65), 1);
    chk("cp U+4E00 wide", unicode.cp_width(19968), 2);
    chk("cp U+0301 combining", unicode.cp_width(769), 0);
    chk("cp tab is Cc", unicode.cp_width(9), 0);
    chk("cp U+1F600", unicode.cp_width(128512), 2);
    chk("cp U+FF21 fullwidth", unicode.cp_width(65313), 2);
    chk("cp ZWJ is Cf", unicode.cp_width(0x200D), 0);
    chk("cp VS16 alone is Cf", unicode.cp_width(0xFE0F), 0);

    // The property gap that started this. Regional indicators are
    // East_Asian_Width Neutral, so anything deciding width from EAW alone says 1.
    chk("cp U+1F1E7 regional indicator", unicode.cp_width(0x1F1E7), 2);

    // Extended_Pictographic is NOT the width property, which is why a second
    // table had to exist: U+00A9 is Extended_Pictographic and one column.
    chk("cp U+00A9 copyright", unicode.cp_width(0x00A9), 1);

    // East-Asian Ambiguous: 1 normally, 2 in a CJK legacy locale.
    chk("cp U+00A1 ambiguous", unicode.cp_width_amb(161, 0), 1);
    chk("cp U+00A1 ambiguous CJK", unicode.cp_width_amb(161, 1), 2);
}

// === The three rows from the spec's table ===

fn t_emoji() as void {
    // U+1F1E7 U+1F1F7 — Brazilian flag. One cluster by GB12/13, two columns.
    chk("flag", unicode.string_width("\xF0\x9F\x87\xA7\xF0\x9F\x87\xB7", 8), 2);

    // U+2764 U+FE0F — red heart. The base has no Emoji_Presentation, correctly;
    // VS16 is what asks for the emoji glyph and the emoji glyph is square.
    chk("heart+VS16", unicode.string_width("\xE2\x9D\xA4\xEF\xB8\x8F", 6), 2);

    // '1' U+FE0F U+20E3 — keycap. Base is an ASCII digit; U+20E3 identifies it.
    chk("keycap", unicode.string_width("\x31\xEF\xB8\x8F\xE2\x83\xA3", 7), 2);

    // A heart with no VS16 stays a narrow dingbat, and a variation selector on a
    // Latin letter selects nothing. Both would break if the VS16 rule were
    // "anything next to U+FE0F is wide".
    chk("heart alone", unicode.string_width("\xE2\x9D\xA4", 3), 1);
    chk("'A' + VS16", unicode.string_width("\x41\xEF\xB8\x8F", 4), 1);

    // U+1F468 ZWJ U+1F469 ZWJ U+1F467 — one cluster by GB11. A per-code-point
    // sum gives 6; the terminal draws 2.
    chk("ZWJ family", unicode.string_width("\xF0\x9F\x91\xA8\xE2\x80\x8D\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA7", 18), 2);

    // 'e' plus eight U+0301 — one cluster, one column. A sum gives 1 as well
    // (marks are 0), but the cluster COUNT differs, checked below.
    chk("e + 8 marks", unicode.string_width("\x65\xCC\x81\xCC\x81\xCC\x81\xCC\x81\xCC\x81\xCC\x81\xCC\x81\xCC\x81", 17), 1);
}

// === cluster_next, walked across one buffer until it says stop ===
//
// A stub that measures only the first cluster and then reports the end fails
// here on the count, on the totals, and on every per-call byte figure.

fn t_walk() as void {
    // 'A' 中 flag family heart — 36 bytes, five clusters, nine columns.
    let is *u8 as s = "\x41\xE4\xB8\xAD\xF0\x9F\x87\xA7\xF0\x9F\x87\xB7\xF0\x9F\x91\xA8\xE2\x80\x8D\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA7\xE2\x9D\xA4\xEF\xB8\x8F";
    let is [5]i64 as want_bytes;
    want_bytes[0] = 1; want_bytes[1] = 3; want_bytes[2] = 8; want_bytes[3] = 18; want_bytes[4] = 6;
    let is [5]i64 as want_cols;
    want_cols[0] = 1; want_cols[1] = 2; want_cols[2] = 2; want_cols[3] = 2; want_cols[4] = 2;

    let is i64 as i with mut = 0;
    let is i64 as seen with mut = 0;
    let is i64 as total with mut = 0;
    let is i64 as cols with mut = 0;
    // Bounded so a broken cluster_next fails the count instead of hanging here.
    while (i < 36 && seen < 16) {
        let is i64 as k = unicode.cluster_next(cast(*u8, cast(i64, s) + i), 36 - i, &cols);
        if (k <= 0) { chk("walk unexpected non-advance", k, 1); i = 36; }
        else {
            if (seen < 5) {
                chk("walk bytes", k, want_bytes[seen]);
                chk("walk cols", cols, want_cols[seen]);
            }
            total = total + cols;
            i = i + k;
            seen = seen + 1;
        }
    }
    chk("walk clusters", seen, 5);
    chk("walk columns", total, 9);
    chk("walk consumed all", i, 36);

    // And the same buffer through string_width, which must agree.
    chk("walk vs string_width", unicode.string_width(s, 36), 9);

    // The 0 state: the buffer is finished, *cols is 0, and the caller must not
    // advance. Both at a zero length and after everything has been consumed.
    cols = 7;
    chk("end at n=0", unicode.cluster_next(s, 0, &cols), 0);
    chk("end at n=0 cols", cols, 0);
    cols = 7;
    chk("end past last cluster", unicode.cluster_next(cast(*u8, cast(i64, s) + 36), 0, &cols), 0);
    chk("end past last cluster cols", cols, 0);

    // Eight marks on one base: one cluster, and the cluster is the whole 17
    // bytes. Measuring per code point would report nine clusters here.
    let is *u8 as marks = "\x65\xCC\x81\xCC\x81\xCC\x81\xCC\x81\xCC\x81\xCC\x81\xCC\x81\xCC\x81";
    cols = 7;
    chk("marks bytes", unicode.cluster_next(marks, 17, &cols), 17);
    chk("marks cols", cols, 1);
}

// === Not resumable from an arbitrary offset ===
//
// The measurement quoted in width.cst's header. Cluster boundaries are defined
// looking backwards, so a caller that starts mid-cluster cannot see what makes
// the cluster one cluster: the ZWJ family is 2 columns walked from its boundary
// and 6 when cut into 7/7/4-byte pieces. This is not a bug being tolerated — it
// is the reason the header forbids the second pattern.

fn t_not_resumable() as void {
    let is *u8 as fam = "\xF0\x9F\x91\xA8\xE2\x80\x8D\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA7";
    let is i64 as cols with mut = 0;

    chk("family whole bytes", unicode.cluster_next(fam, 18, &cols), 18);
    chk("family whole cols", cols, 2);

    let is i64 as cut with mut = 0;
    unicode.cluster_next(fam, 7, &cols);                                   cut = cols;
    unicode.cluster_next(cast(*u8, cast(i64, fam) + 7), 7, &cols);         cut = cut + cols;
    unicode.cluster_next(cast(*u8, cast(i64, fam) + 14), 4, &cols);        cut = cut + cols;
    chk("family cut into pieces", cut, 6);
}

// === A cluster longer than CLUSTER_CP_MAX ===
//
// width.cst cuts a cluster at 32 code points, and what that costs is asserted
// here rather than argued. It used to be argued, and wrongly: "the tail of an
// over-long cluster is combining marks, every one of them zero columns, so a base
// plus ten thousand marks still measures 1". True of marks, and a ZWJ chain's
// tail is not marks — it is more emoji, and each piece the cut leaves behind is
// charged its own two columns. Measured below: 4 where the terminal draws 2.
//
// The direction is the property worth having and it is the one that holds. Each
// piece is measured at its widest code point, and a sum of maxima is never less
// than the maximum over the whole, so an over-long cluster is charged too MANY
// columns and never too few. A layout that reserves too much leaves a gap; one
// that reserves too few draws over the glyph beside it.

let is [4096]u8 as _seq with mut;
let is i64 as _n with mut = 0;

// UTF-8, encoded here rather than written out, because the cases below are
// 137 and 173 bytes long and a wall of escapes is not readable. Checked against
// a literal before it is trusted — see t_encoder.
fn _put(cp as i64) as void {
    if (cp < 128) { _seq[_n] = cast(u8, cp); _n = _n + 1; return; }
    if (cp < 2048) {
        _seq[_n] = cast(u8, 192 + (cp / 64));
        _seq[_n + 1] = cast(u8, 128 + (cp % 64));
        _n = _n + 2;
        return;
    }
    if (cp < 65536) {
        _seq[_n] = cast(u8, 224 + (cp / 4096));
        _seq[_n + 1] = cast(u8, 128 + ((cp / 64) % 64));
        _seq[_n + 2] = cast(u8, 128 + (cp % 64));
        _n = _n + 3;
        return;
    }
    _seq[_n] = cast(u8, 240 + (cp / 262144));
    _seq[_n + 1] = cast(u8, 128 + ((cp / 4096) % 64));
    _seq[_n + 2] = cast(u8, 128 + ((cp / 64) % 64));
    _seq[_n + 3] = cast(u8, 128 + (cp % 64));
    _n = _n + 4;
}

// The encoder itself, against the literal the file already uses for the ZWJ
// family: same bytes, same measurement. A test whose fixture is generated is
// only worth its fixture.
fn t_encoder() as void {
    _n = 0;
    _put(0x1F468); _put(0x200D); _put(0x1F469); _put(0x200D); _put(0x1F467);
    chk("encoder bytes", _n, 18);
    let is *u8 as lit = "\xF0\x9F\x91\xA8\xE2\x80\x8D\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA7";
    let is i64 as i with mut = 0;
    let is i64 as same with mut = 1;
    while (i < 18) { if (_seq[i] != lit[i]) { same = 0; } i = i + 1; }
    chk("encoder matches literal", same, 1);
    chk("encoder family width", unicode.string_width(cast(*u8, &_seq), _n), 2);
}

fn t_over_long_cluster() as void {
    // A ZWJ chain of 39 code points — U+1F468 and nineteen more joined to it,
    // 137 bytes. One cluster by GB11, and one cluster is 2 columns: the widest
    // member, because that is what a terminal draws.
    _n = 0;
    _put(0x1F468);
    let is i64 as i with mut = 0;
    while (i < 19) { _put(0x200D); _put(0x1F468); i = i + 1; }
    chk("zwj39 bytes", _n, 137);
    // 4, not 2, and the two pieces say why: the first stops after the 32nd code
    // point, which is the SIXTEENTH ZWJ — 112 bytes, two columns — and the
    // second starts on the U+1F468 behind that ZWJ and is charged two more.
    // Nothing in that tail is a combining mark.
    let is i64 as cols with mut = 0;
    chk("zwj39 first piece bytes", unicode.cluster_next(cast(*u8, &_seq), _n, &cols), 112);
    chk("zwj39 first piece cols", cols, 2);
    chk("zwj39 rest bytes",
        unicode.cluster_next(cast(*u8, cast(i64, &_seq) + 112), _n - 112, &cols), 25);
    chk("zwj39 rest cols", cols, 2);
    let is i64 as w39 = unicode.string_width(cast(*u8, &_seq), _n);
    chk("zwj39 width", w39, 4);
    // The cluster itself is 2 columns. The cut may only ever charge MORE than
    // that, which is the claim the module now makes and this is the assertion it
    // rests on.
    let is i64 as over39 with mut = 0;
    if (w39 >= 2) { over39 = 1; }
    chk("zwj39 never under", over39, 1);
    // One code point short of the cut: 31 code points, still one cluster, still
    // the 2 the terminal draws. The over-count starts past the ceiling and not
    // before it.
    _n = 0;
    _put(0x1F468);
    i = 0;
    while (i < 15) { _put(0x200D); _put(0x1F468); i = i + 1; }
    chk("zwj31 bytes", _n, 109);
    chk("zwj31 width", unicode.string_width(cast(*u8, &_seq), _n), 2);

    // The same shape with skin tones, which is what a real client sends:
    // U+1F468 U+1F3FF and fifteen ZWJ-joined U+1F469 U+1F3FF, 47 code points in
    // 173 bytes.
    _n = 0;
    _put(0x1F468); _put(0x1F3FF);
    i = 0;
    while (i < 15) { _put(0x200D); _put(0x1F469); _put(0x1F3FF); i = i + 1; }
    chk("zwj tones bytes", _n, 173);
    let is i64 as wt = unicode.string_width(cast(*u8, &_seq), _n);
    chk("zwj tones width", wt, 4);
    let is i64 as overt with mut = 0;
    if (wt >= 2) { overt = 1; }
    chk("zwj tones never under", overt, 1);

    // A base and a thousand combining marks: the shape the old claim was written
    // from, and there it is exactly right. Every code point past the base is zero
    // columns, so cutting the cluster anywhere costs nothing at all.
    _n = 0;
    _put(65);
    i = 0;
    while (i < 1000) { _put(0x0301); i = i + 1; }
    chk("marks1000 bytes", _n, 2001);
    chk("marks1000 width", unicode.string_width(cast(*u8, &_seq), _n), 1);

    // Forty regional indicators: twenty flags by GB12/13, two columns each, and
    // no cluster longer than two code points anywhere in it.
    _n = 0;
    i = 0;
    while (i < 40) { _put(0x1F1E6 + (i % 26)); i = i + 1; }
    chk("ri40 bytes", _n, 160);
    chk("ri40 width", unicode.string_width(cast(*u8, &_seq), _n), 40);
}

// === Bytes that are not UTF-8 ===
//
// Every malformed shape returns -1 with *cols 1, the caller advances one byte,
// and string_width stays positive. Upstream returns -1 for the whole string on
// one bad byte, and a negative column count reaching layout arithmetic is the
// concrete hostile path: a wrap routine clamping with `if (take > w) { take = w; }`
// accepts it, and one crooked byte in a stranger's message would zero the
// measurement of the entire line.

fn bad(name as *u8, s as *u8, n as i64) as void {
    let is i64 as cols with mut = 7;
    chk(name, unicode.cluster_next(s, n, &cols), 0 - 1);
    chk(name, cols, 1);
    // One column per byte, and never negative.
    let is i64 as w = unicode.string_width(s, n);
    chk(name, w, n);
}

fn t_malformed() as void {
    bad("lone continuation 0x80", "\x80", 1);
    bad("continuation run", "\x80\x80\x80", 3);
    bad("overlong C0 AF", "\xC0\xAF", 2);
    bad("surrogate ED A0 80", "\xED\xA0\x80", 3);
    bad("0xFF", "\xFF", 1);
    bad("0xFE", "\xFE", 1);

    // Truncated at the end of the buffer. This is the case the old contract got
    // wrong: folding "the end" and "not UTF-8" into one 0 meaning "advance a
    // byte" walks the caller past src+n here.
    bad("truncated 4-byte lead", "\xF0\x9F\x87", 3);
    bad("truncated 2-byte lead", "\xC3", 1);

    // A valid prefix truncated mid-sequence: the flag's first half whole, its
    // second half cut after two bytes. 2 for the first cluster, then 1 per
    // orphaned byte.
    chk("half flag + truncated", unicode.string_width("\xF0\x9F\x87\xA7\xF0\x9F", 6), 4);

    // Bad bytes between good text keep the good text intact.
    chk("A bad B", unicode.string_width("\x41\xFF\x42", 3), 3);
    chk("wide bad wide", unicode.string_width("\xE4\xB8\xAD\x80\xE4\xB8\xAD", 7), 5);

    // Well-formed control bytes are a width question and answered as one: ESC is
    // Cc and therefore 0, so `ESC [ 2 J` measures 3. Drawn, it clears the
    // terminal. Refusing to draw it belongs to the renderer, not here — this
    // asserts the split rather than a safety property.
    chk("ESC [ 2 J", unicode.string_width("\x1B\x5B\x32\x4A", 4), 3);
}

fn main() as i32 {
    t_cp();
    t_emoji();
    t_walk();
    t_not_resumable();
    t_encoder();
    t_over_long_cluster();
    t_malformed();
    if (fails == 0) { io.write_str(1, "unicode_width: ok\n"); }
    return fails;
}
