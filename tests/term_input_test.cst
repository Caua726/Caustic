// tests/term_input_test.cst — std/term.cst's event reader, and the defect it
// was written to remove.
//
// The defect: the old read_key() decided what it had from the third byte and,
// on a sequence it did not recognise, returned KEY_ESC with three bytes already
// consumed. The tail of the sequence stayed in the stream and came back as
// keystrokes — an SGR mouse report typed `0;40;12M` into whatever had focus.
// `defect_gone_*` below is that exact case: a report followed by one real key,
// and the only thing that may come out is the key.
//
// Everything here runs with no terminal anywhere. The parser half is a pure
// function over a byte range, so it is called directly. The reader half is
// driven through a PIPE: the reader takes its descriptor from the Input struct,
// so pointing it at the read end of a pipe exercises the whole path —
// fill, compaction, prefix resolution, paste assembly — with a test writing the
// bytes a terminal would have sent. What a pipe cannot reproduce is raw mode's
// VTIME timeout, so wherever a prefix has to resolve, the write end is closed
// first: EOF is the pipe's version of "nothing more is coming".
//
// Exit 0 = all passed; the exit code is the number of failures.
use "../std/io.cst" as io;
use "../std/os.cst" as os;
use "../std/term.cst" as term;

let is i32 as fails with mut = 0;

// std/term.cst says an Input must start zeroed. A global would be; these are
// stack locals, so the test does what the contract asks instead of trusting the
// frame to be clean.
fn zero(p as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { p[i] = cast(u8, 0); i = i + 1; }
}

fn chk(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, got, want);
    }
}

// === The parser, on its own ===

fn t_bytes() as void {
    let is term.Event as ev;
    // A plain byte is its own event, and the value passes through untouched.
    chk("byte used", term._scan("a", 1, 0, &ev), 1);
    chk("byte kind", ev.kind, term.EV_KEY);
    chk("byte key", cast(i64, ev.key), 97);
    // 128..255 must arrive one at a time and unchanged: a caller assembling
    // UTF-8 sees the continuation bytes of a character as separate keys, and
    // that is what the interface on top of this depends on.
    let is [4]u8 as u;
    u[0] = cast(u8, 0xC3); u[1] = cast(u8, 0xA9);        // "é"
    chk("utf8 lead used", term._scan(cast(*u8, &u), 2, 0, &ev), 1);
    chk("utf8 lead key", cast(i64, ev.key), 195);
    chk("utf8 cont used", term._scan(cast(*u8, cast(i64, &u) + 1), 1, 0, &ev), 1);
    chk("utf8 cont key", cast(i64, ev.key), 169);
}

fn t_esc() as void {
    let is term.Event as ev;
    // ESC with nothing behind it yet: the parser asks for more rather than
    // guessing. Only `last` turns it into the Escape key.
    chk("esc pending", term._scan("\x1b", 1, 0, &ev), 0);
    chk("esc pending kind", ev.kind, term.EV_NONE);
    chk("esc resolved", term._scan("\x1b", 1, 1, &ev), 1);
    chk("esc resolved key", cast(i64, ev.key), cast(i64, term.KEY_ESC));
    // `ESC [` and nothing more is what the old reader answered KEY_ESC for.
    chk("csi bare used", term._scan("\x1b[", 2, 1, &ev), 2);
    chk("csi bare key", cast(i64, ev.key), cast(i64, term.KEY_ESC));
    // ESC followed by a byte that starts no sequence: Escape, both bytes gone.
    // Alt is not modelled; the header says why.
    chk("esc+byte used", term._scan("\x1ba", 2, 0, &ev), 2);
    chk("esc+byte key", cast(i64, ev.key), cast(i64, term.KEY_ESC));
    // ESC then ESC is the exception: one byte only, because the second ESC may
    // be the beginning of a sequence. A pty driven with Escape followed by a
    // bracketed paste is how this was found — the paste's own ESC was eaten and
    // `[200~` was typed into the input.
    chk("esc+esc used", term._scan("\x1b\x1b[A", 4, 0, &ev), 1);
    chk("esc+esc key", cast(i64, ev.key), cast(i64, term.KEY_ESC));
    chk("esc+esc tail used", term._scan("\x1b[A", 3, 0, &ev), 3);
    chk("esc+esc tail key", cast(i64, ev.key), cast(i64, term.KEY_UP));
}

fn t_keys() as void {
    let is term.Event as ev;
    chk("up used", term._scan("\x1b[A", 3, 0, &ev), 3);
    chk("up key", cast(i64, ev.key), cast(i64, term.KEY_UP));
    chk("up mods", ev.mods, 0);
    chk("down used", term._scan("\x1b[B", 3, 0, &ev), 3);
    chk("down key", cast(i64, ev.key), cast(i64, term.KEY_DOWN));
    term._scan("\x1b[C", 3, 0, &ev); chk("right key", cast(i64, ev.key), cast(i64, term.KEY_RIGHT));
    term._scan("\x1b[D", 3, 0, &ev); chk("left key", cast(i64, ev.key), cast(i64, term.KEY_LEFT));
    term._scan("\x1b[H", 3, 0, &ev); chk("home key", cast(i64, ev.key), cast(i64, term.KEY_HOME));
    term._scan("\x1b[F", 3, 0, &ev); chk("end key", cast(i64, ev.key), cast(i64, term.KEY_END));
    // The tilde family.
    chk("del used", term._scan("\x1b[3~", 4, 0, &ev), 4);
    chk("del key", cast(i64, ev.key), cast(i64, term.KEY_DEL));
    term._scan("\x1b[5~", 4, 0, &ev); chk("pgup key", cast(i64, ev.key), cast(i64, term.KEY_PGUP));
    term._scan("\x1b[6~", 4, 0, &ev); chk("pgdn key", cast(i64, ev.key), cast(i64, term.KEY_PGDN));
    term._scan("\x1b[1~", 4, 0, &ev); chk("home~ key", cast(i64, ev.key), cast(i64, term.KEY_HOME));
    term._scan("\x1b[4~", 4, 0, &ev); chk("end~ key", cast(i64, ev.key), cast(i64, term.KEY_END));
    // A modifier parameter must not stop the key from being recognised — the
    // old reader read byte three, saw '1', and fell through.
    chk("ctrl-up used", term._scan("\x1b[1;5A", 6, 0, &ev), 6);
    chk("ctrl-up key", cast(i64, ev.key), cast(i64, term.KEY_UP));
    chk("ctrl-up mods", ev.mods, term.MOD_CTRL);
    term._scan("\x1b[1;2D", 6, 0, &ev);
    chk("shift-left mods", ev.mods, term.MOD_SHIFT);
    // SS3: what a terminal in application-cursor mode sends for the arrows.
    // The old reader ate the 'O' and typed the 'A'.
    chk("ss3 used", term._scan("\x1bOA", 3, 0, &ev), 3);
    chk("ss3 key", cast(i64, ev.key), cast(i64, term.KEY_UP));
    chk("ss3 pending", term._scan("\x1bO", 2, 0, &ev), 0);
    // Insert and the function keys have no constant here: consumed, reported
    // as nothing, nothing left behind.
    chk("ins used", term._scan("\x1b[2~", 4, 0, &ev), 4);
    chk("ins kind", ev.kind, term.EV_NONE);
}

fn t_mouse() as void {
    let is term.Event as ev;
    chk("press used", term._scan("\x1b[<0;40;12M", 11, 0, &ev), 11);
    chk("press kind", ev.kind, term.EV_MOUSE);
    chk("press button", ev.button, term.MB_LEFT);
    chk("press down", cast(i64, ev.down), cast(i64, term.EV_PRESS));
    chk("press col", ev.col, 40);
    chk("press row", ev.row, 12);
    chk("press mods", ev.mods, 0);
    term._scan("\x1b[<0;40;12m", 11, 0, &ev);
    chk("release down", cast(i64, ev.down), cast(i64, term.EV_RELEASE));
    term._scan("\x1b[<2;1;1M", 9, 0, &ev);
    chk("right button", ev.button, term.MB_RIGHT);
    term._scan("\x1b[<1;1;1M", 9, 0, &ev);
    chk("middle button", ev.button, term.MB_MIDDLE);
    term._scan("\x1b[<64;5;6M", 10, 0, &ev);
    chk("wheel up button", ev.button, term.MB_WHEEL_UP);
    chk("wheel up down", cast(i64, ev.down), cast(i64, term.EV_PRESS));
    term._scan("\x1b[<65;5;6M", 10, 0, &ev);
    chk("wheel down button", ev.button, term.MB_WHEEL_DOWN);
    // Drag: motion with the left button held. This is bit 5 of the button byte
    // plus the button itself, and both have to survive.
    term._scan("\x1b[<32;7;9M", 10, 0, &ev);
    chk("drag button", ev.button, term.MB_LEFT);
    chk("drag down", cast(i64, ev.down), cast(i64, term.EV_MOTION));
    chk("drag col", ev.col, 7);
    chk("drag row", ev.row, 9);
    term._scan("\x1b[<35;7;9M", 10, 0, &ev);
    chk("hover button", ev.button, term.MB_NONE);
    chk("hover down", cast(i64, ev.down), cast(i64, term.EV_MOTION));
    // Modifiers ride in bits 2..4 of the same byte.
    term._scan("\x1b[<16;3;4M", 10, 0, &ev);
    chk("ctrl-click mods", ev.mods, term.MOD_CTRL);
    chk("ctrl-click button", ev.button, term.MB_LEFT);
    term._scan("\x1b[<4;3;4M", 9, 0, &ev);
    chk("shift-click mods", ev.mods, term.MOD_SHIFT);
    // Four-digit coordinates: the reason SGR 1006 exists at all.
    term._scan("\x1b[<0;1234;567M", 14, 0, &ev);
    chk("wide col", ev.col, 1234);
    chk("wide row", ev.row, 567);
}

// Half a report, and a report that is complete but does not add up. Neither may
// hang, and neither may produce a coordinate — a coordinate is something a
// caller clicks on.
fn t_mouse_broken() as void {
    let is term.Event as ev;
    chk("half pending", term._scan("\x1b[<0;10", 7, 0, &ev), 0);
    chk("half kind", ev.kind, term.EV_NONE);
    chk("half row", ev.row, 0);
    chk("half col", ev.col, 0);
    // The same bytes with nothing more coming: consumed whole, still nothing.
    chk("half resolved used", term._scan("\x1b[<0;10", 7, 1, &ev), 7);
    chk("half resolved kind", ev.kind, term.EV_NONE);
    chk("half resolved row", ev.row, 0);
    chk("half resolved col", ev.col, 0);
    // Two parameters where three are required. The final byte is there, so the
    // sequence is complete — it is the report that is short.
    chk("short used", term._scan("\x1b[<0;40M", 8, 0, &ev), 8);
    chk("short kind", ev.kind, term.EV_NONE);
    chk("short col", ev.col, 0);
    // One byte of the introducer.
    chk("intro pending", term._scan("\x1b[<", 3, 0, &ev), 0);
    chk("intro resolved", term._scan("\x1b[<", 3, 1, &ev), 3);
    chk("intro resolved kind", ev.kind, term.EV_NONE);
    // A control byte inside a sequence: consume the broken part, hand back the
    // byte itself, because it is most likely a real keystroke.
    chk("broken used", term._scan("\x1b[1\r", 4, 0, &ev), 3);
    chk("broken kind", ev.kind, term.EV_NONE);
    chk("broken tail used", term._scan("\r", 1, 0, &ev), 1);
    chk("broken tail key", cast(i64, ev.key), cast(i64, term.KEY_ENTER));
}

fn t_other_seqs() as void {
    let is term.Event as ev;
    // A reply nobody asked for: consumed to its final byte and reported as
    // nothing. The old reader answered KEY_ESC and left "?25h" behind.
    chk("unknown used", term._scan("\x1b[?25h", 6, 0, &ev), 6);
    chk("unknown kind", ev.kind, term.EV_NONE);
    chk("unknown pending", term._scan("\x1b[?2", 4, 0, &ev), 0);
    // Focus in / focus out.
    chk("focus in used", term._scan("\x1b[I", 3, 0, &ev), 3);
    chk("focus in kind", ev.kind, term.EV_FOCUS);
    chk("focus in down", cast(i64, ev.down), 1);
    term._scan("\x1b[O", 3, 0, &ev);
    chk("focus out kind", ev.kind, term.EV_FOCUS);
    chk("focus out down", cast(i64, ev.down), 0);
    // The paste brackets are sequences, not events; they never leave the
    // reader, but the parser has to name them.
    chk("paste on used", term._scan("\x1b[200~", 6, 0, &ev), 6);
    chk("paste on kind", ev.kind, term._EV_PASTE_ON);
    chk("paste off used", term._scan("\x1b[201~", 6, 0, &ev), 6);
    chk("paste off kind", ev.kind, term._EV_PASTE_OFF);
}

// === The reader, over a pipe ===

let is [2]i32 as _pfd with mut;

fn pipe_open() as i64 {
    if (os.linux.pipe(cast(*i32, &_pfd)) < 0) { return 0 - 1; }
    return 0;
}
fn pipe_rd() as i64 { return cast(i64, _pfd[0]); }
fn pipe_wr() as i64 { return cast(i64, _pfd[1]); }
fn pipe_send(s as *u8, n as i64) as void { os.linux.write(pipe_wr(), s, n); }
fn pipe_seal() as void { os.linux.close(pipe_wr()); }
fn pipe_done() as void { os.linux.close(pipe_rd()); }

// A mouse report, then one real keystroke. Nothing but the keystroke may come
// out, and the reader must be empty afterwards. This is the defect.
fn t_defect_events() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_fd(&in);
    in.fd = pipe_rd();
    pipe_send("\x1b[<0;40;12Mx", 12);
    pipe_seal();
    let is term.Event as ev;
    let is i64 as keys with mut = 0;
    let is i64 as last with mut = 0;
    let is i64 as events with mut = 0;
    while (term.input_next(&in, &ev) == 1) {
        events = events + 1;
        if (ev.kind == term.EV_KEY) { keys = keys + 1; last = cast(i64, ev.key); }
        if (events > 20) { break; }
    }
    chk("defect events", events, 1);
    chk("defect keys", keys, 1);
    chk("defect key", last, 120);
    pipe_done();
}

// The same through read_key(), which is the API every existing consumer calls.
// _shell is the reader read_key falls back to when the program never opened
// one; pointing its descriptor at the pipe is the only way to drive read_key
// without a terminal, and it is what the module's own fallback path uses.
fn t_defect_read_key() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    term._shell.fd = pipe_rd();
    term._shell.ready = 1;
    pipe_send("\x1b[<0;40;12Mx", 12);
    pipe_seal();
    // The whole report comes out as ONE KEY_NONE — it is consumed, it is not a
    // key, and it is not Escape either. The keystroke behind it follows on the
    // next call, exactly as a second byte in the kernel queue always has.
    // The old reader answered KEY_ESC here and then '0' ';' '4' '0' ';' '1'
    // '2' 'M' as eight more keystrokes.
    chk("read_key defect", cast(i64, term.read_key()), cast(i64, term.KEY_NONE));
    chk("read_key defect key", cast(i64, term.read_key()), 120);
    chk("read_key drained", cast(i64, term.read_key()), cast(i64, term.KEY_NONE));
    pipe_done();
    term._shell.ready = 0;
}

// A bare Escape still resolves to KEY_ESC, through read_key, when nothing is
// behind it. On a pipe "nothing behind it" is EOF; in raw mode it is VTIME.
fn t_read_key_esc() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    term._shell.fd = pipe_rd();
    term._shell.ready = 1;
    pipe_send("\x1b", 1);
    pipe_seal();
    chk("read_key esc", cast(i64, term.read_key()), cast(i64, term.KEY_ESC));
    pipe_done();
    term._shell.ready = 0;
}

// Escape and an arrow key in ONE write. Both come out, in order — the case the
// pty found: with the old rule the arrow's introducer was eaten and its final
// bytes were typed as text.
fn t_esc_then_arrow() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_fd(&in);
    in.fd = pipe_rd();
    pipe_send("\x1b\x1b[A", 4);
    pipe_seal();
    let is term.Event as ev;
    let is [8]i64 as got;
    let is i64 as n with mut = 0;
    while (term.input_next(&in, &ev) == 1) {
        if (ev.kind == term.EV_KEY && n < 8) { got[n] = cast(i64, ev.key); n = n + 1; }
    }
    chk("esc+arrow count", n, 2);
    chk("esc+arrow first", got[0], cast(i64, term.KEY_ESC));
    chk("esc+arrow second", got[1], cast(i64, term.KEY_UP));
    pipe_done();
}

// An arrow key arrives as three bytes in one write and leaves as one key.
fn t_read_key_arrow() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    term._shell.fd = pipe_rd();
    term._shell.ready = 1;
    pipe_send("\x1b[Aq", 4);
    pipe_seal();
    chk("read_key arrow", cast(i64, term.read_key()), cast(i64, term.KEY_UP));
    chk("read_key after arrow", cast(i64, term.read_key()), 113);
    pipe_done();
    term._shell.ready = 0;
}

// A burst: five bytes in one write, five keys, in order.
fn t_burst() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_fd(&in);
    in.fd = pipe_rd();
    pipe_send("hello", 5);
    pipe_seal();
    let is term.Event as ev;
    let is [8]u8 as got;
    let is i64 as n with mut = 0;
    while (term.input_next(&in, &ev) == 1) {
        if (ev.kind == term.EV_KEY && n < 8) { got[n] = cast(u8, ev.key); n = n + 1; }
    }
    chk("burst count", n, 5);
    chk("burst 0", cast(i64, got[0]), 104);
    chk("burst 1", cast(i64, got[1]), 101);
    chk("burst 2", cast(i64, got[2]), 108);
    chk("burst 3", cast(i64, got[3]), 108);
    chk("burst 4", cast(i64, got[4]), 111);
    pipe_done();
}

// Two hundred characters between the brackets: ONE event, not two hundred.
fn t_paste() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_fd(&in);
    in.fd = pipe_rd();
    in.m_paste = 1;
    let is [256]u8 as body;
    let is i64 as i with mut = 0;
    while (i < 200) { body[i] = cast(u8, 97 + (i % 26)); i = i + 1; }
    pipe_send("\x1b[200~", 6);
    pipe_send(cast(*u8, &body), 200);
    pipe_send("\x1b[201~", 6);
    pipe_send("!", 1);
    pipe_seal();
    let is term.Event as ev;
    let is i64 as pastes with mut = 0;
    let is i64 as plen with mut = 0;
    let is i64 as first with mut = 0;
    let is i64 as lastb with mut = 0;
    let is i64 as keys with mut = 0;
    while (term.input_next(&in, &ev) == 1) {
        if (ev.kind == term.EV_PASTE) {
            pastes = pastes + 1;
            plen = ev.len;
            first = cast(i64, ev.text[0]);
            lastb = cast(i64, ev.text[ev.len - 1]);
        }
        if (ev.kind == term.EV_KEY) { keys = keys + 1; }
    }
    chk("paste events", pastes, 1);
    chk("paste len", plen, 200);
    chk("paste first", first, 97);
    chk("paste last", lastb, cast(i64, body[199]));
    chk("paste trailing key", keys, 1);
    pipe_done();
}

// The closing bracket split across two reads. The reader holds back the bytes
// that could be its beginning instead of copying them into the paste.
fn t_paste_split() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_fd(&in);
    in.fd = pipe_rd();
    in.m_paste = 1;
    pipe_send("\x1b[200~ab\x1b[2", 11);
    pipe_send("01~", 3);
    pipe_seal();
    let is term.Event as ev;
    let is i64 as pastes with mut = 0;
    let is i64 as plen with mut = 0;
    while (term.input_next(&in, &ev) == 1) {
        if (ev.kind == term.EV_PASTE) { pastes = pastes + 1; plen = ev.len; }
    }
    chk("split paste events", pastes, 1);
    chk("split paste len", plen, 2);
    pipe_done();
}

let is [9000]u8 as _big with mut;

// A paste of exactly the cap, and one past it. The cap is a real limit, so it
// has a boundary, and the boundary is where an off-by-one shows up as either a
// spurious empty event or a lost byte. Both sizes also exceed IN_BUF, so this
// is the only case that exercises the buffer sliding forward under a paste.
fn t_paste_cap() as void {
    let is i64 as cap = term.IN_PASTE;
    let is i64 as i with mut = 0;
    while (i < cap + 8) { _big[i] = cast(u8, 97 + (i % 26)); i = i + 1; }

    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_fd(&in);
    in.fd = pipe_rd();
    in.m_paste = 1;
    pipe_send("\x1b[200~", 6);
    pipe_send(cast(*u8, &_big), cap);
    pipe_send("\x1b[201~", 6);
    pipe_seal();
    let is term.Event as ev;
    let is i64 as events with mut = 0;
    let is i64 as total with mut = 0;
    while (term.input_next(&in, &ev) == 1) {
        if (ev.kind == term.EV_PASTE) { events = events + 1; total = total + ev.len; }
    }
    chk("cap paste events", events, 1);
    chk("cap paste bytes", total, cap);
    pipe_done();

    // One byte past the cap: two events, and every byte accounted for.
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in2 with mut;
    zero(cast(*u8, &in2), sizeof(term.Input));
    term.input_fd(&in2);
    in2.fd = pipe_rd();
    in2.m_paste = 1;
    pipe_send("\x1b[200~", 6);
    pipe_send(cast(*u8, &_big), cap + 8);
    pipe_send("\x1b[201~", 6);
    pipe_seal();
    let is i64 as ev2 with mut = 0;
    let is i64 as tot2 with mut = 0;
    while (term.input_next(&in2, &ev) == 1) {
        if (ev.kind == term.EV_PASTE) { ev2 = ev2 + 1; tot2 = tot2 + ev.len; }
    }
    chk("over-cap paste events", ev2, 2);
    chk("over-cap paste bytes", tot2, cap + 8);
    pipe_done();
}

// A paste with no closing bracket: the bytes are real even when the bracket
// never comes, and the reader must not sit on them or hang.
fn t_paste_unterminated() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_fd(&in);
    in.fd = pipe_rd();
    in.m_paste = 1;
    pipe_send("\x1b[200~abc", 9);
    pipe_seal();
    let is term.Event as ev;
    let is i64 as pastes with mut = 0;
    let is i64 as plen with mut = 0;
    while (term.input_next(&in, &ev) == 1) {
        if (ev.kind == term.EV_PASTE) { pastes = pastes + 1; plen = ev.len; }
    }
    chk("unterminated paste events", pastes, 1);
    chk("unterminated paste len", plen, 3);
    pipe_done();
}

// Half a mouse report and then EOF: drained, no event, no coordinate, no hang.
fn t_truncated_reader() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_fd(&in);
    in.fd = pipe_rd();
    in.m_mouse = 1;
    pipe_send("\x1b[<0;10", 7);
    pipe_seal();
    let is term.Event as ev;
    chk("truncated next", cast(i64, term.input_next(&in, &ev)), 0);
    chk("truncated kind", ev.kind, term.EV_NONE);
    chk("truncated row", ev.row, 0);
    chk("truncated col", ev.col, 0);
    pipe_done();
}

// A mode this reader never turned on is chatter. With mouse on, the same bytes
// are an event.
fn t_gating() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_fd(&in);
    in.fd = pipe_rd();
    in.m_mouse = 1;
    pipe_send("\x1b[I\x1b[<2;8;9M", 13);
    pipe_seal();
    let is term.Event as ev;
    let is i64 as mice with mut = 0;
    let is i64 as focus with mut = 0;
    let is i64 as col with mut = 0;
    while (term.input_next(&in, &ev) == 1) {
        if (ev.kind == term.EV_MOUSE) { mice = mice + 1; col = ev.col; }
        if (ev.kind == term.EV_FOCUS) { focus = focus + 1; }
    }
    chk("gated focus dropped", focus, 0);
    chk("mouse delivered", mice, 1);
    chk("mouse col", col, 8);
    pipe_done();

    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in2 with mut;
    zero(cast(*u8, &in2), sizeof(term.Input));
    term.input_fd(&in2);
    in2.fd = pipe_rd();
    in2.m_focus = 1;
    pipe_send("\x1b[I", 3);
    pipe_seal();
    let is i64 as f2 with mut = 0;
    while (term.input_next(&in2, &ev) == 1) {
        if (ev.kind == term.EV_FOCUS) { f2 = f2 + 1; }
    }
    chk("focus delivered", f2, 1);
    pipe_done();
}

// An empty descriptor must answer "drained" and not wait for a terminal that
// is not there. The write end stays OPEN here: nothing is pending, and nothing
// ever will be, and input_next has to come back anyway.
fn t_no_block() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_fd(&in);
    in.fd = pipe_rd();
    let is term.Event as ev;
    chk("idle next", cast(i64, term.input_next(&in, &ev)), 0);
    chk("idle kind", ev.kind, term.EV_NONE);
    pipe_seal();
    pipe_done();
}

// input_close puts back every mode input_open turned on, and nothing else.
//
// Checked by the bytes: stdout is pointed at a pipe for the duration, and what
// comes out has to be five `h` sets followed by five `l` resets in reverse
// order. A program that dies with mouse reporting left on leaves the shell it
// came from printing a report at every click, so this is a requirement and not
// a finishing touch.
fn t_modes() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    // F_DUPFD = 0: a copy of stdout at some fd >= 10, to restore it from.
    let is i64 as saved = os.linux.fcntl(1, 0, 10);
    os.linux.dup2(pipe_wr(), 1);
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_open(&in, 1);
    term.input_close(&in);
    os.linux.dup2(saved, 1);
    os.linux.close(saved);
    pipe_seal();
    let is [256]u8 as got;
    let is i64 as n = os.linux.read(pipe_rd(), cast(*u8, &got), 256);
    pipe_done();
    chk("modes byte count", n,
        cast(i64, 24 + 8 + 8 + 8 + 8 + 24));
    let is i64 as i with mut = 0;
    let is i64 as sets with mut = 0;
    let is i64 as resets with mut = 0;
    while (i < n) {
        if (got[i] == cast(u8, 104)) { sets = sets + 1; }        // 'h'
        if (got[i] == cast(u8, 108)) { resets = resets + 1; }    // 'l'
        i = i + 1;
    }
    chk("modes set", sets, 5);
    chk("modes reset", resets, 5);
    // Order: everything set before anything is reset, and the resets mirror the
    // sets so the terminal unwinds in the order it was wound.
    let is *u8 as want = "\x1b[?1000h\x1b[?1002h\x1b[?1006h\x1b[?2004h\x1b[?1004h\x1b[?1004l\x1b[?2004l\x1b[?1006l\x1b[?1002l\x1b[?1000l";
    let is i64 as diff with mut = 0;
    i = 0;
    while (i < n) {
        if (got[i] != want[i]) { diff = diff + 1; }
        i = i + 1;
    }
    chk("modes exact bytes", diff, 0);
    // Every mode flag is clear afterwards, so a second input_close writes
    // nothing at all.
    chk("modes flags cleared", cast(i64, in.m_mouse) + cast(i64, in.m_paste)
                               + cast(i64, in.m_focus), 0);
}

// With no mouse asked for, no mouse mode is set — and so none is reset.
fn t_modes_no_mouse() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is i64 as saved = os.linux.fcntl(1, 0, 10);
    os.linux.dup2(pipe_wr(), 1);
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_open(&in, 0);
    term.input_close(&in);
    os.linux.dup2(saved, 1);
    os.linux.close(saved);
    pipe_seal();
    let is [256]u8 as got;
    let is i64 as n = os.linux.read(pipe_rd(), cast(*u8, &got), 256);
    pipe_done();
    chk("no-mouse byte count", n, 32);
    let is *u8 as want = "\x1b[?2004h\x1b[?1004h\x1b[?1004l\x1b[?2004l";
    let is i64 as i with mut = 0;
    let is i64 as diff with mut = 0;
    while (i < n) {
        if (got[i] != want[i]) { diff = diff + 1; }
        i = i + 1;
    }
    chk("no-mouse exact bytes", diff, 0);
}

// input_open hands read_key the reader it opened, so a program that adopts
// events does not end up with two buffered readers splitting one byte stream.
fn t_shared_reader() as void {
    if (pipe_open() < 0) { fails = fails + 1; return; }
    let is i64 as saved = os.linux.fcntl(1, 0, 10);
    let is [2]i32 as sink with mut;
    os.linux.pipe(cast(*i32, &sink));
    // Everything input_open and input_close write goes to the sink, including
    // the resets: they belong to a terminal this test does not own.
    os.linux.dup2(cast(i64, sink[1]), 1);
    let is term.Input as in with mut;
    zero(cast(*u8, &in), sizeof(term.Input));
    term.input_open(&in, 0);
    in.fd = pipe_rd();
    pipe_send("z", 1);
    pipe_seal();
    let is i64 as key = cast(i64, term.read_key());
    let is i64 as fd = term.input_fd(&in);
    term.input_close(&in);
    let is i64 as cur = term._cur;
    os.linux.dup2(saved, 1);
    os.linux.close(saved);
    chk("shared reader key", key, 122);
    chk("shared reader fd", fd, pipe_rd());
    chk("shared reader released", cur, 0);
    pipe_done();
    os.linux.close(cast(i64, sink[0]));
    os.linux.close(cast(i64, sink[1]));
}

fn main() as i32 {
    // The parser is a pure function and runs on every target.
    t_bytes();
    t_esc();
    t_keys();
    t_mouse();
    t_mouse_broken();
    t_other_seqs();

    // The reader needs a pipe to be driven from, which is POSIX.
    if (os.current() == os.OS_LINUX) {
        t_defect_events();
        t_defect_read_key();
        t_read_key_esc();
        t_read_key_arrow();
        t_esc_then_arrow();
        t_burst();
        t_paste();
        t_paste_split();
        t_paste_cap();
        t_paste_unterminated();
        t_truncated_reader();
        t_gating();
        t_no_block();
        t_modes();
        t_modes_no_mouse();
        t_shared_reader();
    }

    if (fails == 0) { io.write_str(1, "term_input: ok\n"); }
    return fails;
}
