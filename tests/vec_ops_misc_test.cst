// tests/vec_ops_misc_test.cst
//
// More of the loop widener's lane operations (src/ir/vec/vec_widen.cst,
// lowered in src/codegen/emit_vec.cst), each against an element-by-element
// reference: 16- and 32-bit multiplies (pmullw, pmulld, and the SSE2 form
// through pmuludq), arithmetic shifts, sign extension from bytes and from
// i32, 64-bit compares (pcmpgtq / pcmpeqq: AVX2 only, the SSE2 path stays
// scalar), f32 subtract, divide and square root, and the index widened from
// i32 to i64 lanes. Trip counts around every vector width, unaligned starts.
//
// Exit code 0 on success, else the number of the failing check.

let is i64 as opaque with mut = 0;

fn bits32(x as f32) as i32 { let is f32 as v = x; return *cast(*i32, &v); }

fn mul16(d as *i16, a as *i16, b as *i16, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = a[i] * b[i] + (a[i] >> 3); i = i + 1; }
}
fn ref_mul16(d as *i16, a as *i16, b as *i16, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = a[i] * b[i] + (a[i] >> 3); i = i + 1 + opaque; }
}

fn mul32(d as *i32, a as *i32, n as i64, k as i32) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = a[i] * k - (a[i] >> 5); i = i + 1; }
}
fn ref_mul32(d as *i32, a as *i32, n as i64, k as i32) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = a[i] * k - (a[i] >> 5); i = i + 1 + opaque; }
}

// bytes and i32 sign-extended into i64 lanes, the index too
fn sext(d as *i64, a as *i8, b as *i32, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = cast(i64, a[i]) * 3 + cast(i64, b[i]) - i; i = i + 1; }
}
fn ref_sext(d as *i64, a as *i8, b as *i32, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = cast(i64, a[i]) * 3 + cast(i64, b[i]) - i; i = i + 1 + opaque; }
}

// 64-bit compares: max and equality count
fn max64(d as *i64, a as *i64, b as *i64, n as i64) as i64 {
    let is i64 as eq with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as x with mut = a[i];
        if (b[i] > x) { x = b[i]; }
        if (a[i] == b[i]) { eq = eq + 1; }
        d[i] = x;
        i = i + 1;
    }
    return eq;
}
fn ref_max64(d as *i64, a as *i64, b as *i64, n as i64) as i64 {
    let is i64 as eq with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as x with mut = a[i];
        if (b[i] > x) { x = b[i]; }
        if (a[i] == b[i]) { eq = eq + 1; }
        d[i] = x;
        i = i + 1 + opaque;
    }
    return eq;
}

fn fops(d as *f32, a as *f32, b as *f32, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = __builtin_sqrt(a[i] - b[i]) / (b[i] + 1.5); i = i + 1; }
}
fn ref_fops(d as *f32, a as *f32, b as *f32, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = __builtin_sqrt(a[i] - b[i]) / (b[i] + 1.5); i = i + 1 + opaque; }
}

fn main() as i32 {
    let is [80]i16 as h1; let is [80]i16 as h2; let is [80]i16 as ho; let is [80]i16 as hr;
    let is [80]i32 as w1; let is [80]i32 as wo; let is [80]i32 as wr;
    let is [80]i8 as c1;
    let is [80]i64 as q1; let is [80]i64 as q2; let is [80]i64 as qo; let is [80]i64 as qr;
    let is [80]f32 as f1; let is [80]f32 as f2; let is [80]f32 as fo; let is [80]f32 as fr;
    let is u64 as seed with mut = 977;
    let is i64 as k with mut = 0;
    while (k < 80) {
        seed = seed ^ (seed << 13); seed = seed ^ (seed >> 7); seed = seed ^ (seed << 17);
        h1[k] = cast(i16, cast(i64, seed & 65535) - 32768);
        h2[k] = cast(i16, cast(i64, (seed >> 16) & 511) - 256);
        w1[k] = cast(i32, cast(i64, (seed >> 3) & 4294967295) - 2147483648);
        c1[k] = cast(i8, cast(i64, (seed >> 9) & 255) - 128);
        q1[k] = cast(i64, seed) >> 1;
        q2[k] = cast(i64, seed << 3);
        if (k % 5 == 1) { q2[k] = q1[k]; }
        if (k % 7 == 3) { q2[k] = 0 - q1[k]; }
        f1[k] = cast(f32, cast(i64, seed & 1048575)) * 0.01;
        f2[k] = cast(f32, cast(i64, (seed >> 20) & 1023)) * 0.5;
        k = k + 1;
    }
    let is [11]i64 as ns;
    ns[0] = 0; ns[1] = 1; ns[2] = 3; ns[3] = 4; ns[4] = 7; ns[5] = 8; ns[6] = 9;
    ns[7] = 16; ns[8] = 17; ns[9] = 33; ns[10] = 77;
    let is i64 as t with mut = 0;
    while (t < 11) {
        let is i64 as n = ns[t] + opaque;
        let is i32 as fail = cast(i32, t * 10);
        let is i64 as off with mut = 0;
        while (off < 3) {
            mul16(cast(*i16, &ho), cast(*i16, cast(i64, &h1) + off * 2), cast(*i16, &h2), n);
            ref_mul16(cast(*i16, &hr), cast(*i16, cast(i64, &h1) + off * 2), cast(*i16, &h2), n);
            let is i64 as j with mut = 0;
            while (j < n) { if (ho[j] != hr[j]) { return fail + 1; } j = j + 1 + opaque; }
            mul32(cast(*i32, &wo), cast(*i32, cast(i64, &w1) + off * 4), n, 0 - 77777);
            ref_mul32(cast(*i32, &wr), cast(*i32, cast(i64, &w1) + off * 4), n, 0 - 77777);
            j = 0;
            while (j < n) { if (wo[j] != wr[j]) { return fail + 2; } j = j + 1 + opaque; }
            sext(cast(*i64, &qo), cast(*i8, cast(i64, &c1) + off), cast(*i32, &w1), n);
            ref_sext(cast(*i64, &qr), cast(*i8, cast(i64, &c1) + off), cast(*i32, &w1), n);
            j = 0;
            while (j < n) { if (qo[j] != qr[j]) { return fail + 3; } j = j + 1 + opaque; }
            let is *i64 as pa = cast(*i64, cast(i64, &q1) + off * 8);
            if (max64(cast(*i64, &qo), pa, cast(*i64, &q2), n) != ref_max64(cast(*i64, &qr), pa, cast(*i64, &q2), n)) { return fail + 4; }
            j = 0;
            while (j < n) { if (qo[j] != qr[j]) { return fail + 5; } j = j + 1 + opaque; }
            fops(cast(*f32, &fo), cast(*f32, cast(i64, &f1) + off * 4), cast(*f32, &f2), n);
            ref_fops(cast(*f32, &fr), cast(*f32, cast(i64, &f1) + off * 4), cast(*f32, &f2), n);
            j = 0;
            while (j < n) { if (bits32(fo[j]) != bits32(fr[j])) { return fail + 6; } j = j + 1 + opaque; }
            off = off + 1;
        }
        t = t + 1;
    }
    return 0;
}
