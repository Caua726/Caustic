// tests/noreturn_cold_test.cst
//
// A function on whose path lies a call that never returns: it is copied into
// its callers at -O2, the path out of line. Values read after the `if` must
// survive on the path that does not take it, the checks must still run, and
// the functions must work when one of them is called through a pointer.
//
// Exit code 0 on success, else the number of the failing check.
// tests/noreturn_exit_test.cst takes the path.
use "../std/io.cst" as io;

let is [4]i64 as stack with mut;
let is i32 as top with mut = 0;

fn die(msg as *u8) as void {
    io.write_bytes(io.STDERR, msg, io.strlen(msg));
    io.exit(9);
}

fn push(v as i64) as void {
    if (top >= 4) { die("full\n"); }
    stack[cast(i64, top)] = v;
    top = top + 1;
}

fn pop() as i64 {
    if (top == 0 || top > 4) { die("empty\n"); }
    top = top - 1;
    return stack[cast(i64, top)];
}

// The condition's operands and a value live across the check.
fn checked_div(a as i64, b as i64, c as i64) as i64 {
    let is i64 as k = a * c;
    if (b == 0) { die("zero\n"); }
    return k / b + c;
}

fn f_checked(a as f64, b as f64) as f64 {
    let is f64 as s = a + b;
    if (b == 0.0) { die("zero\n"); }
    return s / b;
}

fn loop_with_check(n as i32) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) {
        if (i > 1000) { die("too many\n"); }
        s = s + cast(i64, i) * 3;
        i = i + 1;
    }
    return s;
}

type Pop = fn() as i64;

fn main() as i32 {
    push(1); push(2); push(3);
    if (pop() != 3) { return 1; }
    push(40);
    if (pop() + pop() != 42) { return 2; }
    if (pop() != 1 || top != 0) { return 3; }
    if (checked_div(20, 4, 3) != 18) { return 4; }
    if (f_checked(6.0, 2.0) != 4.0) { return 5; }
    if (loop_with_check(10) != 135) { return 6; }
    let is Pop as p = fn_ptr(pop);
    push(7);
    if (call(p) != 7) { return 7; }
    return 0;
}
