// std/mem/grow.cst: pushes never move the array, so a pointer taken at the
// first push still reads and writes element 0 after a million more.
use "../std/mem/grow.cst" as grow;

fn main() as i32 {
    // Pointer stability across many commit steps (24 MB of i64 > 64 KiB chunks).
    let is grow.Grow gen i64 as xs with mut = grow.grow_new gen i64 (0);
    let is *i64 as first = xs.push(7);
    let is i64 as i with mut = 1;
    while (i < 3000000) { xs.push(i * 3); i = i + 1; }
    if (xs.len != 3000000) { return 1; }
    if (*first != 7) { return 2; }
    *first = 99;
    if (xs.get(0) != 99) { return 3; }
    if (xs.get(2999999) != 2999999 * 3) { return 4; }
    if (cast(i64, xs.at(0)) != cast(i64, first)) { return 5; }

    // pop / truncate / clear keep the pages and reuse them.
    if (xs.pop() != 2999999 * 3) { return 6; }
    xs.truncate(10);
    if (xs.len != 10 || xs.get(9) != 27) { return 7; }
    xs.clear();
    xs.push(5);
    if (xs.get(0) != 5 || cast(i64, xs.at(0)) != cast(i64, first)) { return 8; }
    xs.free();
    if (xs.len != 0) { return 9; }

    // u8 elements: 300 KB crosses several 64 KiB commit steps at byte stride.
    let is grow.Grow gen u8 as bs with mut = grow.grow_new gen u8 (1048576);
    let is *u8 as b0 = bs.push(cast(u8, 42));
    let is i64 as j with mut = 1;
    while (j < 300000) { bs.push(cast(u8, j % 251)); j = j + 1; }
    if (*b0 != cast(u8, 42) || bs.get(299999) != cast(u8, 299999 % 251)) { return 10; }
    bs.free();
    // A struct element (T from the calling module) is not tested here: generic
    // stdlib types cannot instantiate with a caller's struct yet (Slice neither).
    return 0;
}
