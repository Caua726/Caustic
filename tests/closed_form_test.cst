// tests/closed_form_test.cst
//
// Constant-trip loops that only add constants, whose values -O2 computes at
// once, and the same shapes when something keeps them from going that way:
// wrapping sums of every width, nested loops, a sum read after the loop along
// with the counter, a second variable, a temporary read after the loop, and a
// global written in the body.
//
// Exit code 0 on success, else the number of the failing check.

let is i64 as sink with mut = 0;

fn nest6() as i32 {
    let is i32 as n = 14;
    let is i32 as x with mut = 0;
    let is i32 as a with mut = 0;
    while (a < n) {
        let is i32 as b with mut = 0;
        while (b < n) {
            let is i32 as c with mut = 0;
            while (c < n) {
                let is i32 as d with mut = 0;
                while (d < n) {
                    let is i32 as e with mut = 0;
                    while (e < n) {
                        let is i32 as f with mut = 0;
                        while (f < n) { x = x + 1000; f = f + 1; }
                        e = e + 1;
                    }
                    d = d + 1;
                }
                c = c + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return x;
}

fn sum64(start as i64) as i64 {
    let is i64 as x with mut = start;
    let is i64 as i with mut = 0;
    while (i < 100000) { x = x + 3000000; i = i + 1; }
    return x;
}

fn sum_u8(start as u8) as u8 {
    let is u8 as x with mut = start;
    let is i32 as i with mut = 0;
    while (i < 1000) { x = cast(u8, x + 7); i = i + 1; }
    return x;
}

fn down_up(start as i32) as i32 {
    let is i32 as x with mut = start;
    let is i32 as y with mut = 100;
    let is i32 as i with mut = 5;
    while (i < 1005) { x = x - 3; y = y + 2; i = i + 1; }
    return x * 1000 + y + i;
}

// the temporary read after the loop is the value of the last iteration
fn last_temp() as i32 {
    let is i32 as x with mut = 0;
    let is i32 as t with mut = 0;
    let is i32 as i with mut = 0;
    while (i < 50) { t = x + 5; x = t + 1; i = i + 1; }
    return t * 1000 + x;
}

// a value copied from another variable each time round
fn follow() as i32 {
    let is i32 as a with mut = 0;
    let is i32 as b with mut = 0;
    let is i32 as i with mut = 0;
    while (i < 30) { b = a; a = a + 2; i = i + 1; }
    return b * 100 + a;
}

fn with_store() as i64 {
    let is i64 as i with mut = 0;
    while (i < 40) { sink = sink + 2; i = i + 1; }
    return sink + i;
}

fn main() as i32 {
    // 46^6 = 9474296896, reduced to 32 bits and read as signed
    if (cast(i64, nest6()) != 0 - 1060398592) { return 1; }
    if (sum64(5) != 300000000005) { return 2; }
    if (sum_u8(cast(u8, 3)) != cast(u8, (3 + 7000) % 256)) { return 3; }
    if (down_up(10) != (10 - 3000) * 1000 + 2100 + 1005) { return 4; }
    if (last_temp() != (49 * 6 + 5) * 1000 + 300) { return 5; }
    if (follow() != 58 * 100 + 60) { return 6; }
    if (with_store() != 120) { return 7; }
    return 0;
}
