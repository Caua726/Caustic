use "../../std/io.cst" as io;
use "collision_module.cst" as imported;

// All three modules use Node, with different fields and sizes. A debug or
// separate compile must not let this root definition capture an imported one.
struct Node { root_value as i64; }
type Ref = i64;
enum Kind { ROOT_ONLY; }

fn main() as i32 {
    let is Node as root;
    root.root_value = 17;
    let is imported.Node as middle = imported.make(31);
    let is imported.leaf.Node as leaf = imported.leaf.make(43);
    let is imported.Box as box = imported.boxed(59);
    if (sizeof(Node) != 8 || sizeof(imported.Node) != 16
        || sizeof(imported.leaf.Node) != 24 || sizeof(imported.Box) != 32) { return 1; }
    if (root.root_value != 17 || middle.module_value != 31 || middle.module_tail != 38) { return 2; }
    if (leaf.leaf_value != 43 || leaf.leaf_tail != 54 || leaf.leaf_guard != 66) { return 3; }
    if (imported.sum(&middle) != 69 || imported.leaf.sum(&leaf) != 163) { return 4; }
    if (box.child.leaf_value != 59 || box.child.leaf_tail != 70
        || box.child.leaf_guard != 82 || box.marker != 97) { return 5; }
    if (imported.nested_sum(&box) != 308) { return 6; }
    let is imported.Ref as aliased = imported.make_ref(71);
    if (sizeof(Ref) != 8 || sizeof(imported.Ref) != 24
        || aliased.leaf_value != 71 || aliased.leaf_guard != 94) { return 7; }
    let is Kind as root_kind = Kind.ROOT_ONLY;
    let is imported.Kind as module_kind = imported.kind();
    if (cast(i32, root_kind) != 0 || cast(i32, module_kind) != 1) { return 8; }
    io.printf("module types: root=%d module=%d,%d leaf=%d,%d,%d boxed=%d\n",
              root.root_value, middle.module_value, middle.module_tail,
              leaf.leaf_value, leaf.leaf_tail, leaf.leaf_guard, imported.nested_sum(&box));
    return 0;
}
