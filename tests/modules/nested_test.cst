// tests/modules/nested_test.cst — module access is not capped at two levels.
//
// A hub may nest sub-hubs, and every construct a leaf module exports stays
// reachable through the whole alias chain: here `hub.a.b.leaf.X`, four hops.
// Exit code is the number of failures, so the runner's exit-0 check applies.
use "../../std/io.cst" as io;
use "hub.cst" as hub;

let is i32 as fails with mut = 0;

// A struct whose first field is a type ALIASED from another module. If the
// alias carries a zero size, `tag` lands on top of `v` instead of after it —
// which is why this checks the offset, not just the total size.
struct Wrap { v as hub.a.b.Vec2; tag as i32; }

fn chk(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, got, want);
    }
}

fn main() as i32 {
    // plain function call
    chk("fn", hub.a.b.leaf.leaf_add(1, 2), 3);
    // imut global (const-folded through the chain)
    chk("imut global", hub.a.b.leaf.LEAF_CONST, 100);
    // mut global (real load through the chain)
    chk("mut global", hub.a.b.leaf.leaf_counter, 5);
    // struct type named through the chain, returned by value
    let is hub.a.b.leaf.Vec2 as v = hub.a.b.leaf.leaf_make(4, 6);
    chk("struct type", v.x + v.y, 10);
    // method on a type owned by the leaf module
    chk("method", v.sum(), 10);
    // type alias
    let is hub.a.b.leaf.Handle as h = 7;
    chk("type alias", h, 7);
    // generic function
    chk("generic fn", hub.a.b.leaf.leaf_max gen i64 (3, 9), 9);
    // fn_ptr + indirect call
    let is *u8 as fp = fn_ptr(hub.a.b.leaf.leaf_add);
    chk("fn_ptr", call(fp, 10, 10), 20);

    // --- An alias of a type from another module carries that type's SIZE ---
    // Every context below consults the size, and each one used to read zero.
    let is i64 as vec2_size = cast(i64, sizeof(hub.a.b.leaf.Vec2));
    chk("sizeof direto", vec2_size, 16);
    // `b.Vec2` aliases `leaf.Vec2`
    chk("sizeof alias", cast(i64, sizeof(hub.a.b.Vec2)), vec2_size);
    // `a.Vec2` aliases `b.Vec2`, which aliases `leaf.Vec2`
    chk("sizeof alias encadeado", cast(i64, sizeof(hub.a.Vec2)), vec2_size);

    // As a field: the aliased field must advance the offset of the next one.
    let is Wrap as w with mut;
    chk("sizeof struct envolvente", cast(i64, sizeof(Wrap)), vec2_size + 4);
    chk("offset do campo seguinte",
        cast(i64, &w.tag) - cast(i64, &w.v), vec2_size);

    // As an array element: the stride must be the element's real size.
    let is [4]hub.a.b.Vec2 as arr;
    chk("sizeof array de alias", cast(i64, sizeof([4]hub.a.b.Vec2)), vec2_size * 4);
    chk("stride do array", cast(i64, &arr[1]) - cast(i64, &arr[0]), vec2_size);

    // An alias whose right-hand side is itself an array type.
    chk("sizeof alias de array", cast(i64, sizeof(hub.a.b.Vec2x4)), vec2_size * 4);

    return fails;
}
