// Imported SECOND, and needs `leafb` — the submodule narrow.cst excluded.
// This is the file that used to break, despite being untouched by the clause.
use "shared.cst" only leafa, leafb as shared;

fn wide_sum() as i64 {
    let is shared.leafb.TypeB as t with mut;
    t.v = shared.leafb.b_val();
    return shared.leafa.a_val() + t.v;
}
