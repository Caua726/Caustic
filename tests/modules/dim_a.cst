// One of two modules that both declare MAX_NAME, with different values, and
// both size a struct field with it. See tests/modules/dim_test.cst.
let is i64 as MAX_NAME with imut = 255;
let is i64 as SLACK    with imut = 8;

struct A {
    name as [MAX_NAME]u8;
    pad  as [SLACK]u8;
    n    as i64;
}

fn a_size() as i64 { return sizeof(A); }

// Write to the last byte of each field and read it back: sizeof being right is
// necessary and not sufficient — what matters is that the field really has
// that many bytes and the next one starts after them.
fn a_canary() as i64 {
    let is A as v;
    v.n = 0;
    v.name[254] = cast(u8, 1);
    v.pad[7] = cast(u8, 2);
    if (v.n != 0) { return 0 - 1; }
    return cast(i64, v.name[254]) * 10 + cast(i64, v.pad[7]);
}
