// Leaf of a 4-deep hub chain: reached as `hub.a.b.leaf.*` from the entry file.
let is i64 as LEAF_CONST with imut = 100;
let is i64 as leaf_counter with mut = 5;

struct Vec2 { x as i64; y as i64; }

type Handle = i64;

fn Vec2_sum(self as *Vec2) as i64 { return self.x + self.y; }

fn leaf_add(a as i64, b as i64) as i64 { return a + b; }

fn leaf_make(x as i64, y as i64) as Vec2 {
    let is Vec2 as v with mut;
    v.x = x; v.y = y;
    return v;
}

fn leaf_max gen T (a as T, b as T) as T {
    if (a > b) { return a; }
    return b;
}
