// tests/modules/dim_test.cst — a struct field sized by a named constant works
// in an IMPORTED module, and two modules that pick the same name do not see
// each other's.
//
// The field case was folded only in the ROOT file: prefold_consts ran once, on
// the entry module's top level, and every imported module reached struct layout
// with the importer's registry and nothing of its own in it. Four lines
// reproduced it — a module declaring a constant and a struct that uses it
// compiled standalone and failed the moment anything imported it — which meant
// the feature worked exactly where a single-file test would look for it.
//
// The registry is a stack now, pushed per module, and searched from the top.
// dim_a and dim_b both declare MAX_NAME, 255 and 128, and each must get its
// own: a flat table would hand both whichever module the compiler reached
// first, and size a buffer to a number nobody wrote.
//
// Exit 0 = all pass. Non-zero = the numbered check that failed.
use "../../std/io.cst" as io;
use "dim_a.cst" as a;
use "dim_b.cst" as b;

// And the same name again HERE, in the root, with a third value — the root's
// own frame sits at the bottom of the stack and must not shadow either module.
let is i64 as MAX_NAME with imut = 64;

struct R { name as [MAX_NAME]u8; n as i64; }

fn main() as i32 {
    if (a.a_size() != 255 + 8 + 8) { return 1; }
    if (b.b_size() != 128 + 8) { return 2; }
    if (sizeof(R) != 64 + 8) { return 3; }

    if (a.a_canary() != 12) { return 4; }
    if (b.b_canary() != 3) { return 5; }

    let is R as r;
    r.n = 0;
    r.name[63] = cast(u8, 9);
    if (r.n != 0) { return 6; }
    if (cast(i64, r.name[63]) != 9) { return 7; }

    io.write_str(1, "array dims: per-module, and the names do not collide\n");
    return 0;
}
