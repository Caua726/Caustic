use "collision_leaf.cst" as leaf;

struct Node { module_value as i64; module_tail as i64; }
struct Box { child as leaf.Node; marker as i64; }
type Ref = leaf.Node;
enum Kind { MODULE_ZERO; MODULE_ONE; }

impl Node {
    fn new(value as i64) as Node {
        let is Node as n;
        n.module_value = value;
        n.module_tail = value + 7;
        return n;
    }
}

fn make(value as i64) as Node { return Node.new(value); }
fn sum(n as *Node) as i64 { return n.module_value + n.module_tail; }
fn boxed(value as i64) as Box {
    let is Box as b;
    b.child = leaf.make(value);
    b.marker = 97;
    return b;
}
fn nested_sum(b as *Box) as i64 { return leaf.sum(&b.child) + b.marker; }
fn make_ref(value as i64) as Ref {
    let is Ref as n = leaf.make(value);
    return n;
}
fn kind() as Kind { return Kind.MODULE_ONE; }
