struct Node { leaf_value as i64; leaf_tail as i64; leaf_guard as i64; }

impl Node {
    fn new(value as i64) as Node {
        let is Node as n;
        n.leaf_value = value;
        n.leaf_tail = value + 11;
        n.leaf_guard = value + 23;
        return n;
    }
}

fn make(value as i64) as Node { return Node.new(value); }
fn sum(n as *Node) as i64 { return n.leaf_value + n.leaf_tail + n.leaf_guard; }
