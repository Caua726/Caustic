// Literal consumers must not alias writable global pointer storage.
let is *u8 as shared with imut = "original";
let is *u8 as current with mut = "original";
let is *u8 as empty with mut = "";
let is *u8 as section_current with mut with section(".pointers") = "module original";
let is *u8 as section_empty with mut with section(".ptralt") = "";
fn original() as *u8 { return "original"; }
fn blank() as *u8 { return ""; }
fn read_current() as *u8 { return current; }
fn current_address() as **u8 { return &current; }
fn change(value as *u8) as void { current = value; }
