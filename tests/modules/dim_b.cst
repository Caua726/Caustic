// The other one. Same constant name, different value.
let is i64 as MAX_NAME with imut = 128;

struct B {
    name as [MAX_NAME]u8;
    n    as i64;
}

fn b_size() as i64 { return sizeof(B); }

fn b_canary() as i64 {
    let is B as v;
    v.n = 0;
    v.name[127] = cast(u8, 3);
    if (v.n != 0) { return 0 - 1; }
    return cast(i64, v.name[127]);
}
