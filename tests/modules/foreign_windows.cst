// A module only Windows can use: every function calls into user32.dll, once
// under the name's usual case and once as Windows also accepts it.
extern "user32.dll" fn GetDesktopWindow() as *u8;
extern "USER32.DLL" fn GetShellWindow() as *u8;

fn desktop() as i64 { return cast(i64, GetDesktopWindow()); }
fn shell() as i64 { return cast(i64, GetShellWindow()); }
