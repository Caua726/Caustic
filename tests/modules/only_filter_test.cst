// tests/modules/only_filter_test.cst — one importer's `only` must not narrow
// the module for everybody else.
//
// Both importers bind the hub under the SAME alias (`shared`) with DIFFERENT
// `only` lists. The per-site record used to be looked up by alias name alone,
// so the most recently created one answered for every site: wide.cst is
// reached first and needs `leafb`, narrow.cst is reached last and excludes it,
// and wide.cst then lost access to a submodule it had asked for.
// Import order is the whole point of this test — do not reorder these lines.
use "../../std/io.cst" as io;
use "onlyfilter/wide.cst" as wide;
use "onlyfilter/narrow.cst" as narrow;
use "onlyfilter/hubm.cst" as hubm;

let is i32 as fails with mut = 0;

fn chk(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, got, want);
    }
}

fn main() as i32 {
    chk("importador amplo", wide.wide_sum(), 33);
    chk("importador estreito", narrow.narrow_sum(), 11);

    // A method on a type reached only through a re-exporting hub. `leafa` is
    // deliberately NOT imported here — that is the arrangement a hub exists for,
    // and the type's source spelling names nothing resolvable in this scope.
    let is hubm.TypeA as t with mut;
    t.v = 21;
    chk("metodo via hub reexportador", t.doubled(), 42);
    return fails;
}
