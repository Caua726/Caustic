// tests/i32_wrap_test.cst
//
// At -O2 an i32 sum whose readers only look at its low 32 bits is left
// without its sign extension (emit.cst, lz_init): compares then use the 32-bit
// registers and a widening cast extends it. Every way such a value leaves that
// world must still see the wrapped i32: widened to i64 and f64, used as an
// index, compared after wrapping past INT_MAX, returned, passed, stored,
// divided, and counted down through zero.
//
// Exit code 0 on success, else the number of the failing check.

fn pass(x as i64) as i64 { return x; }

fn wrap_sum(n as i32, k as i32) as i64 {
    let is i32 as a with mut = n;
    let is i64 as acc with mut = 0;
    let is i32 as i with mut = 0;
    while (i < k) {
        a = a + 1000000000;
        acc = acc + cast(i64, a);
        i = i + 1;
    }
    return acc;
}

fn wrap_cmp(n as i32) as i32 {
    let is i32 as a with mut = n;
    let is i32 as hits with mut = 0;
    let is i32 as i with mut = 0;
    while (i < 6) {
        a = a + 1500000000;
        if (a < 0) { hits = hits + 1; }
        if (a == 0 - 1294967296) { hits = hits + 100; }
        i = i + 1;
    }
    return hits;
}

fn idx(p as *i64, n as i32) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as i with mut = n - 1;
    while (i >= 0) {
        s = s + p[i];
        i = i - 1;
    }
    return s;
}

fn ret_wrap(a as i32) as i32 {
    let is i32 as b = a + 2147483647;
    return b;
}

fn to_f(a as i32) as f64 {
    let is i32 as b = a + 2147483647;
    return cast(f64, b);
}

fn div_wrap(a as i32) as i32 {
    let is i32 as b = a + 2147483647;
    return b / 3;
}

fn main() as i32 {
    if (wrap_sum(0, 5) != 2115098112) { return 1; }
    if (wrap_cmp(0) != 102) { return 2; }
    let is [8]i64 as arr;
    let is i32 as j with mut = 0;
    while (j < 8) { arr[j] = cast(i64, j) * 3; j = j + 1; }
    if (idx(cast(*i64, &arr), 8) != 84) { return 3; }
    if (cast(i64, ret_wrap(5)) != 0 - 2147483644) { return 4; }
    if (pass(cast(i64, ret_wrap(2))) != 0 - 2147483647) { return 5; }
    if (to_f(3) != 0.0 - 2147483646.0) { return 6; }
    if (div_wrap(4) != (0 - 2147483645) / 3) { return 7; }
    let is i32 as cell with mut = 0;
    let is i32 as t with mut = 2147483600;
    let is i32 as q with mut = 0;
    while (q < 100) { t = t + 1; q = q + 1; }
    cell = t;
    if (cast(i64, cell) != 0 - 2147483596) { return 8; }
    return 0;
}
