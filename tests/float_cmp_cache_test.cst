// tests/float_cmp_cache_test.cst
//
// A float compare whose result is a value goes through cl for its parity flag.
// At -O2 the register cache could still claim that rcx held a spilled pointer:
// the stores below went through it with its low byte replaced by the flag, to
// the wrong address, and the fields kept what they had. The cache now forgets
// rcx when cl is written.
//
// Exit code 0 on success, else the number of the failing check.

struct Seen {
    at as i64;
    ne as i32;
    eq as i32;
    lt as i32;
    le as i32;
    guard as i64;
}

let is [8]i64 as words with mut;

// Enough live values through the loop that s is spilled.
fn work(s as *Seen, u as *i64, dx as f64, dy as f64, n as i64) as i64 {
    let is i64 as a with mut = u[0];
    let is i64 as b with mut = u[1];
    let is i64 as c with mut = u[2];
    let is i64 as d with mut = u[3];
    let is i64 as e with mut = u[4];
    let is i64 as f with mut = u[5];
    let is i64 as g with mut = u[6];
    let is i64 as h with mut = u[7];
    let is i64 as i with mut = 0;
    while (i < n) {
        a = a + b * i; b = b ^ c; c = c + d; d = d - e; e = e + f * 3; f = f ^ g; g = g + h; h = h - a;
        u[i & 7] = a + h;
        i = i + 1;
    }
    s.at = a;
    s.ne = cast(i32, dy != 0.0);
    s.eq = cast(i32, dx == 0.0);
    s.lt = cast(i32, dx < dy);
    s.le = cast(i32, dx <= dy);
    return a + b + c + d + e + f + g + h + i;
}

fn main() as i32 {
    let is Seen as s with mut;
    s.at = 0;
    s.ne = 7;
    s.eq = 7;
    s.lt = 7;
    s.le = 7;
    s.guard = 12345;
    work(&s, cast(*i64, &words), 0.0, 1.0, 5);
    if (s.ne != 1) { return 1; }
    if (s.eq != 1) { return 2; }
    if (s.lt != 1) { return 3; }
    if (s.le != 1) { return 4; }
    if (s.guard != 12345) { return 5; }
    work(&s, cast(*i64, &words), 2.0, 0.0, 5);
    if (s.ne != 0) { return 6; }
    if (s.eq != 0) { return 7; }
    if (s.lt != 0) { return 8; }
    if (s.le != 0) { return 9; }
    if (s.guard != 12345) { return 10; }
    return 0;
}
