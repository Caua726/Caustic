// More argv entries than the wasm _start argv region can hold.
//
// _start reserved MAX_ARGS (256) pointer slots followed by the string area and
// then iterated argc times over whatever the host reported, so a run with more
// than 256 arguments had args_get write the 257th pointer over env_ptrs and
// then over the strings themselves. The module now refuses such a run with
// proc_exit(1) instead of corrupting its own argv. Run it both ways: with a few
// arguments it prints the count and exits 0.
use "std/io.cst" as io;

fn main(argc as i64, argv as *u8) as i32 {
    if (argc < 1) { return 1; }
    let is *i64 as av = cast(*i64, argv);
    if (av[0] == 0) { return 2; }
    io.printf("argc=%ld\n", argc);
    return 0;
}
