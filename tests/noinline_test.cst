// `with noinline`: the function still does its work when called, directly or
// through a pointer, and takes part in recursion like any other.
fn add_one(x as i32) as i32 with noinline {
    return x + 1;
}

fn count_down(n as i32) as i32 with noinline {
    if (n <= 0) { return 0; }
    return add_one(count_down(n - 1));
}

fn main() as i32 {
    if (add_one(41) != 42) { return 1; }
    if (count_down(10) != 10) { return 2; }
    let is *u8 as p = fn_ptr(add_one);
    let is i64 as r = call(p, 1);
    if (r != 2) { return 3; }
    return 0;
}
