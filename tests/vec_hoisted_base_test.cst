// tests/vec_hoisted_base_test.cst
//
// An inner loop that walks a window `&a[off]` of an array, off stepping in
// an outer loop. LICM computes the window's start (base + off*elem) once,
// before the inner loop; the vectorizer's affine analysis read that address
// as base + 0, dropping the off*elem part, so every window was read from the
// array's start. It now keeps an index with a variable part whole: computed
// before the loop it is the base itself. Reductions and maps over windows of
// i64, i32, u8 and f64 elements, every window, trip counts around every
// vector width, checked against element-by-element references.
//
// Exit code 0 on success, else the number of the failing check.

let is i64 as opaque with mut = 0;

fn main() as i32 {
    let is [80]i64 as q; let is [80]i32 as w; let is [80]u8 as b; let is [80]f64 as f;
    let is [80]i64 as dq;
    let is u64 as seed with mut = 4242;
    let is i64 as k with mut = 0;
    while (k < 80) {
        seed = seed ^ (seed << 13); seed = seed ^ (seed >> 7); seed = seed ^ (seed << 17);
        q[k] = cast(i64, seed) | 1;
        w[k] = cast(i32, cast(i64, seed & 65535) - 30000);
        b[k] = cast(u8, seed & 255);
        f[k] = cast(f64, cast(i64, seed & 1023)) * 0.25;
        k = k + 1;
    }
    let is [8]i64 as ns;
    ns[0] = 0; ns[1] = 1; ns[2] = 3; ns[3] = 8; ns[4] = 9; ns[5] = 17; ns[6] = 33; ns[7] = 60;
    let is i64 as t with mut = 0;
    while (t < 8) {
        let is i64 as n = ns[t] + opaque;
        let is i64 as off with mut = 0;
        while (off < 5) {
            let is *i64 as pq = &q[off];
            let is *i32 as pw = &w[off];
            let is *u8 as pb = &b[off];
            let is *f64 as pf = &f[off];
            // vectorized
            let is i64 as s1 with mut = 0 - 1;
            let is i32 as s2 with mut = 0;
            let is u8 as s3 with mut = 0;
            let is f64 as s4 with mut = 0.0;
            let is i64 as i with mut = 0;
            while (i < n) { s1 = s1 & pq[i]; i = i + 1; }
            i = 0;
            while (i < n) { s2 = s2 + pw[i]; i = i + 1; }
            i = 0;
            while (i < n) { s3 = s3 ^ pb[i]; i = i + 1; }
            i = 0;
            while (i < n) { s4 = s4 + pf[i]; i = i + 1; }
            i = 0;
            while (i < n) { dq[i] = pq[i] + i; i = i + 1; }
            // references
            let is i64 as r1 with mut = 0 - 1;
            let is i32 as r2 with mut = 0;
            let is u8 as r3 with mut = 0;
            let is f64 as r4 with mut = 0.0;
            let is i64 as j with mut = 0;
            while (j < n) {
                r1 = r1 & q[off + j]; r2 = r2 + w[off + j]; r3 = r3 ^ b[off + j]; r4 = r4 + f[off + j];
                if (dq[j] != q[off + j] + j) { return cast(i32, 5 + t * 10); }
                j = j + 1 + opaque;
            }
            if (s1 != r1) { return cast(i32, 1 + t * 10); }
            if (s2 != r2) { return cast(i32, 2 + t * 10); }
            if (s3 != r3) { return cast(i32, 3 + t * 10); }
            if (s4 != r4) { return cast(i32, 4 + t * 10); }
            off = off + 1;
        }
        t = t + 1;
    }
    return 0;
}
