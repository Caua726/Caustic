// A static AArch64 Linux program importing a Windows-only module: the module's
// user32.dll call is behind os.current() and must neither link nor run.
use "../../std/os.cst" as os;
use "../modules/foreign_windows.cst" as win;

let is i32 as runtime with mut = 3;

fn main() as i32 {
    if (os.current() == os.OS_WINDOWS && runtime == 3) {
        if (win.desktop() == 0) { return 1; }
        return 0;
    }
    return 42;
}
