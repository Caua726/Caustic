// tests/xmm_read_spill_cache_test.cst
//
// At -O1 and up, codegen remembers which scratch register last held a
// spilled vreg so a second read can skip the reload. Reading an
// XMM-allocated double into a general register (movq rax, xmm2, as a compare
// against 0.0 does) overwrote scratch without telling that cache: the pivot
// index of an LU factorization, spilled and last seen in rax, was then read
// back as the double's bits and used as an array index.
//
// Exit code 0 on success, else the number of the failing check.

fn absd(v as f64) as f64 {
    if (v < 0.0) { return 0.0 - v; }
    return v;
}

fn amax(n as i32, dx as *f64, off as i32) as i32 {
    if (n < 1) { return 0 - 1; }
    if (n == 1) { return 0; }
    let is i32 as best with mut = 0;
    let is f64 as big with mut = absd(dx[off]);
    let is i32 as i with mut = 1;
    while (i < n) {
        let is f64 as v = absd(dx[i + off]);
        if (v > big) { best = i; big = v; }
        i = i + 1;
    }
    return best;
}

fn scale(n as i32, da as f64, dx as *f64, off as i32) as void {
    let is i32 as i with mut = 0;
    while (i < n) { dx[i + off] = dx[i + off] * da; i = i + 1; }
}

fn axpy(n as i32, da as f64, dx as *f64, xo as i32, dy as *f64, yo as i32) as void {
    if (n <= 0 || da == 0.0) { return; }
    let is i32 as i with mut = 0;
    while (i < n) { dy[i + yo] = dy[i + yo] + da * dx[i + xo]; i = i + 1; }
}

// Gaussian elimination with partial pivoting on n columns a[0..n).
fn factor(a as **f64, n as i32, piv as *i32) as void {
    let is i32 as k with mut = 0;
    while (k < n - 1) {
        let is *f64 as col_k = a[k];
        let is i32 as kp1 = k + 1;
        let is i32 as l = amax(n - k, col_k, k) + k;
        piv[k] = l;
        if (col_k[l] != 0.0) {
            if (l != k) {
                let is f64 as t = col_k[l];
                col_k[l] = col_k[k];
                col_k[k] = t;
            }
            scale(n - kp1, (0.0 - 1.0) / col_k[k], col_k, kp1);
            let is i32 as j with mut = kp1;
            while (j < n) {
                let is *f64 as col_j = a[j];
                let is f64 as t = col_j[l];
                if (l != k) {
                    col_j[l] = col_j[k];
                    col_j[k] = t;
                }
                axpy(n - kp1, t, col_k, kp1, col_j, kp1);
                j = j + 1;
            }
        }
        k = k + 1;
    }
    piv[n - 1] = n - 1;
}

fn main() as i32 {
    // Columns of [[1 2 0] [4 1 1] [2 0 3]]: pivoting swaps rows 0 and 1.
    let is [3]f64 as c0;
    let is [3]f64 as c1;
    let is [3]f64 as c2;
    c0[0] = 1.0; c0[1] = 4.0; c0[2] = 2.0;
    c1[0] = 2.0; c1[1] = 1.0; c1[2] = 0.0;
    c2[0] = 0.0; c2[1] = 1.0; c2[2] = 3.0;
    let is [3]*f64 as cols;
    cols[0] = cast(*f64, &c0);
    cols[1] = cast(*f64, &c1);
    cols[2] = cast(*f64, &c2);
    let is [3]i32 as piv;
    factor(cast(**f64, &cols), 3, cast(*i32, &piv));
    if (piv[0] != 1) { return 1; }
    if (c0[0] != 4.0 || c1[0] != 1.0 || c2[0] != 1.0) { return 2; }      // pivot row on top
    if (c0[1] != 0.0 - 0.25 || c0[2] != 0.0 - 0.5) { return 3; }         // multipliers
    return 0;
}
