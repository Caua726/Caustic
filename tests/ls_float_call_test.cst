// tests/ls_float_call_test.cst — -O1 linear scan on a function with float
// values (more than 256 vregs, so -O1 allocates it by linear scan). Every a<k>
// stays live across the later calls to bump(), and every xmm is caller-saved:
// a float interval that crosses a call must live on the stack. Allocating it
// an xmm across the call (what linear scan once did) loses the values, and
// the sum differs from the loop below that computes the same thing.
// Exit 0 = both agree.
use "../std/io.cst" as io;

let is i64 as calls with mut = 0;

fn bump(x as i64) as f64 with noinline {
    calls = calls + 1;
    let is f64 as junk with mut = 3.5;
    let is i64 as k with mut = 0;
    while (k < 4) { junk = junk * 1.25 + 0.5; k = k + 1; }   // dirties xmm registers
    return cast(f64, x % 7) + junk * 0.0;
}

fn unrolled() as f64 with noinline {
    let is f64 as a0 = 1.0 + bump(0);
    let is f64 as a1 = a0 * 1.0009765625 + bump(1) * 0.5;
    let is f64 as a2 = a1 * 1.0009765625 + bump(2) * 0.5;
    let is f64 as a3 = a2 * 1.0009765625 + bump(3) * 0.5;
    let is f64 as a4 = a3 * 1.0009765625 + bump(4) * 0.5;
    let is f64 as a5 = a4 * 1.0009765625 + bump(5) * 0.5;
    let is f64 as a6 = a5 * 1.0009765625 + bump(6) * 0.5;
    let is f64 as a7 = a6 * 1.0009765625 + bump(7) * 0.5;
    let is f64 as a8 = a7 * 1.0009765625 + bump(8) * 0.5;
    let is f64 as a9 = a8 * 1.0009765625 + bump(9) * 0.5;
    let is f64 as a10 = a9 * 1.0009765625 + bump(10) * 0.5;
    let is f64 as a11 = a10 * 1.0009765625 + bump(11) * 0.5;
    let is f64 as a12 = a11 * 1.0009765625 + bump(12) * 0.5;
    let is f64 as a13 = a12 * 1.0009765625 + bump(13) * 0.5;
    let is f64 as a14 = a13 * 1.0009765625 + bump(14) * 0.5;
    let is f64 as a15 = a14 * 1.0009765625 + bump(15) * 0.5;
    let is f64 as a16 = a15 * 1.0009765625 + bump(16) * 0.5;
    let is f64 as a17 = a16 * 1.0009765625 + bump(17) * 0.5;
    let is f64 as a18 = a17 * 1.0009765625 + bump(18) * 0.5;
    let is f64 as a19 = a18 * 1.0009765625 + bump(19) * 0.5;
    let is f64 as a20 = a19 * 1.0009765625 + bump(20) * 0.5;
    let is f64 as a21 = a20 * 1.0009765625 + bump(21) * 0.5;
    let is f64 as a22 = a21 * 1.0009765625 + bump(22) * 0.5;
    let is f64 as a23 = a22 * 1.0009765625 + bump(23) * 0.5;
    let is f64 as a24 = a23 * 1.0009765625 + bump(24) * 0.5;
    let is f64 as a25 = a24 * 1.0009765625 + bump(25) * 0.5;
    let is f64 as a26 = a25 * 1.0009765625 + bump(26) * 0.5;
    let is f64 as a27 = a26 * 1.0009765625 + bump(27) * 0.5;
    let is f64 as a28 = a27 * 1.0009765625 + bump(28) * 0.5;
    let is f64 as a29 = a28 * 1.0009765625 + bump(29) * 0.5;
    let is f64 as a30 = a29 * 1.0009765625 + bump(30) * 0.5;
    let is f64 as a31 = a30 * 1.0009765625 + bump(31) * 0.5;
    let is f64 as a32 = a31 * 1.0009765625 + bump(32) * 0.5;
    let is f64 as a33 = a32 * 1.0009765625 + bump(33) * 0.5;
    let is f64 as a34 = a33 * 1.0009765625 + bump(34) * 0.5;
    let is f64 as a35 = a34 * 1.0009765625 + bump(35) * 0.5;
    let is f64 as a36 = a35 * 1.0009765625 + bump(36) * 0.5;
    let is f64 as a37 = a36 * 1.0009765625 + bump(37) * 0.5;
    let is f64 as a38 = a37 * 1.0009765625 + bump(38) * 0.5;
    let is f64 as a39 = a38 * 1.0009765625 + bump(39) * 0.5;
    let is f64 as a40 = a39 * 1.0009765625 + bump(40) * 0.5;
    let is f64 as a41 = a40 * 1.0009765625 + bump(41) * 0.5;
    let is f64 as a42 = a41 * 1.0009765625 + bump(42) * 0.5;
    let is f64 as a43 = a42 * 1.0009765625 + bump(43) * 0.5;
    let is f64 as a44 = a43 * 1.0009765625 + bump(44) * 0.5;
    let is f64 as a45 = a44 * 1.0009765625 + bump(45) * 0.5;
    let is f64 as a46 = a45 * 1.0009765625 + bump(46) * 0.5;
    let is f64 as a47 = a46 * 1.0009765625 + bump(47) * 0.5;
    let is f64 as a48 = a47 * 1.0009765625 + bump(48) * 0.5;
    let is f64 as a49 = a48 * 1.0009765625 + bump(49) * 0.5;
    let is f64 as a50 = a49 * 1.0009765625 + bump(50) * 0.5;
    let is f64 as a51 = a50 * 1.0009765625 + bump(51) * 0.5;
    let is f64 as a52 = a51 * 1.0009765625 + bump(52) * 0.5;
    let is f64 as a53 = a52 * 1.0009765625 + bump(53) * 0.5;
    let is f64 as a54 = a53 * 1.0009765625 + bump(54) * 0.5;
    let is f64 as a55 = a54 * 1.0009765625 + bump(55) * 0.5;
    let is f64 as a56 = a55 * 1.0009765625 + bump(56) * 0.5;
    let is f64 as a57 = a56 * 1.0009765625 + bump(57) * 0.5;
    let is f64 as a58 = a57 * 1.0009765625 + bump(58) * 0.5;
    let is f64 as a59 = a58 * 1.0009765625 + bump(59) * 0.5;
    let is f64 as a60 = a59 * 1.0009765625 + bump(60) * 0.5;
    let is f64 as a61 = a60 * 1.0009765625 + bump(61) * 0.5;
    let is f64 as a62 = a61 * 1.0009765625 + bump(62) * 0.5;
    let is f64 as a63 = a62 * 1.0009765625 + bump(63) * 0.5;
    let is f64 as a64 = a63 * 1.0009765625 + bump(64) * 0.5;
    let is f64 as a65 = a64 * 1.0009765625 + bump(65) * 0.5;
    let is f64 as a66 = a65 * 1.0009765625 + bump(66) * 0.5;
    let is f64 as a67 = a66 * 1.0009765625 + bump(67) * 0.5;
    let is f64 as a68 = a67 * 1.0009765625 + bump(68) * 0.5;
    let is f64 as a69 = a68 * 1.0009765625 + bump(69) * 0.5;
    return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23 + a24 + a25 + a26 + a27 + a28 + a29 + a30 + a31 + a32 + a33 + a34 + a35 + a36 + a37 + a38 + a39 + a40 + a41 + a42 + a43 + a44 + a45 + a46 + a47 + a48 + a49 + a50 + a51 + a52 + a53 + a54 + a55 + a56 + a57 + a58 + a59 + a60 + a61 + a62 + a63 + a64 + a65 + a66 + a67 + a68 + a69;
}

fn looped() as f64 with noinline {
    let is [70]f64 as a;
    a[0] = 1.0 + cast(f64, 0 % 7);
    let is i64 as k with mut = 1;
    while (k < 70) { a[k] = a[k - 1] * 1.0009765625 + cast(f64, k % 7) * 0.5; k = k + 1; }
    let is f64 as s with mut = 0.0;
    k = 0;
    while (k < 70) { s = s + a[k]; k = k + 1; }
    return s;
}

fn main() as i32 {
    let is f64 as u = unrolled();
    let is f64 as l = looped();
    if (u != l) { io.printf("FAIL unrolled %f looped %f\n", u, l); return 1; }
    return 0;
}
