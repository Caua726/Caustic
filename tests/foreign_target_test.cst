// Modules for one system imported by a portable program. A function of the
// other system's module is called only behind os.current(), and separate
// compilation still emits it: its call must not make this binary depend on a
// library the target cannot load (an ELF needing user32.dll, a PE needing
// libc.so.6) — such a binary would not even start.
use "../std/os.cst" as os;
use "modules/foreign_windows.cst" as win;
use "modules/foreign_linux.cst" as lin;

let is i32 as runtime with mut = 3;

fn main() as i32 {
    if (os.current() == os.OS_WINDOWS && runtime == 3) {
        if (win.desktop() == 0) { return 1; }
        return 0;
    }
    if (os.current() == os.OS_LINUX && runtime == 3) {
        if (lin.pid() <= 0) { return 2; }
        return 0;
    }
    return 3;
}
