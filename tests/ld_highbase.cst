// tests/ld_highbase.cst — linked freestanding at a high-half --base (how
// CausticOS links its kernel: 0xFFFFFFFF80000000), with initialised and
// zeroed data so the image has an R+W segment. run_tests.cst links it and
// reads the program headers: every PT_LOAD must sit at or above the base and
// R+W must start past the end of R+X. Never run.
let is i64 as counter with mut = 5;
let is [4096]u8 as big with mut;

fn _kernel_start() as void {
    counter = counter + 1;
    big[7] = cast(u8, counter);
    while (1 == 1) { }
}
