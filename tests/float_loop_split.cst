// tests/float_loop_split.cst
//
// A float that lives across a call has a register of its own inside a loop
// with no call: it comes back to where the rest of the function reads it. A
// loop that runs and one that never runs, a value only read there, a loop that
// ends through a break or a return, nested loops with the call in the outer
// one, f32, more values than registers, and a vectorized sum after the call.
//
// Exit code 0 on success, else the number of the failing check.

fn id(x as f64) as f64 { return x; }
fn idf(x as f32) as f32 { return x; }

fn summed(n as i32) as f64 {
    let is f64 as x = id(0.5);
    let is f64 as s with mut = 1.0;
    let is i32 as i with mut = 0;
    while (i < n) { s = s + x * cast(f64, i); i = i + 1; }
    let is f64 as t = id(2.0);
    return s * t + x;
}

fn only_read(n as i32) as f64 {
    let is f64 as a = id(3.0);
    let is f64 as b = id(4.0);
    let is i64 as c with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) { c = c + cast(i64, a * b); i = i + 1; }
    let is f64 as t = id(1.0);
    return cast(f64, c) + a + b + t;
}

fn with_break(n as i32) as f64 {
    let is f64 as x = id(1.5);
    let is f64 as s with mut = 0.0;
    let is i32 as i with mut = 0;
    while (i < n) {
        s = s + x;
        if (s > 6.0) { break; }
        i = i + 1;
    }
    let is f64 as t = id(10.0);
    return s * t + x;
}

fn with_return(n as i32) as f64 {
    let is f64 as x = id(2.0);
    let is f64 as s with mut = 0.0;
    let is i32 as i with mut = 0;
    while (i < n) {
        s = s + x;
        if (s > 5.0) { return s + x; }
        i = i + 1;
    }
    let is f64 as t = id(3.0);
    return s * t;
}

fn nested(n as i32) as f64 {
    let is f64 as k = id(0.25);
    let is f64 as s with mut = 0.0;
    let is i32 as i with mut = 0;
    while (i < n) {
        let is f64 as a = id(cast(f64, i));
        let is i32 as j with mut = 0;
        while (j < n) { s = s + a * k; j = j + 1; }
        i = i + 1;
    }
    let is f64 as t = id(2.0);
    return s * t + k;
}

fn nested_free(n as i32) as f64 {
    let is f64 as k = id(0.5);
    let is f64 as s with mut = 0.0;
    let is i32 as i with mut = 0;
    while (i < n) {
        let is i32 as j with mut = 0;
        while (j < n) { s = s + k; j = j + 1; }
        s = s * 2.0;
        i = i + 1;
    }
    let is f64 as t = id(3.0);
    return s + t + k;
}

fn single(n as i32) as f32 {
    let is f32 as x = idf(0.5);
    let is f32 as s with mut = 1.0;
    let is i32 as i with mut = 0;
    while (i < n) { s = s + x; i = i + 1; }
    let is f32 as t = idf(2.0);
    return s * t + x;
}

fn crowded(n as i32) as f64 {
    let is f64 as a0 with mut = id(1.0);
    let is f64 as a1 with mut = id(2.0);
    let is f64 as a2 with mut = id(3.0);
    let is f64 as a3 with mut = id(4.0);
    let is f64 as a4 with mut = id(5.0);
    let is f64 as a5 with mut = id(6.0);
    let is f64 as a6 with mut = id(7.0);
    let is f64 as a7 with mut = id(8.0);
    let is f64 as a8 with mut = id(9.0);
    let is f64 as a9 with mut = id(10.0);
    let is f64 as b0 with mut = id(11.0);
    let is f64 as b1 with mut = id(12.0);
    let is f64 as b2 with mut = id(13.0);
    let is f64 as b3 with mut = id(14.0);
    let is f64 as b4 with mut = id(15.0);
    let is f64 as b5 with mut = id(16.0);
    let is f64 as b6 with mut = id(17.0);
    let is f64 as b7 with mut = id(18.0);
    let is i32 as i with mut = 0;
    while (i < n) {
        a0 = a0 + a1; a1 = a1 + a2; a2 = a2 + a3; a3 = a3 + a4; a4 = a4 + a5;
        a5 = a5 + a6; a6 = a6 + a7; a7 = a7 + a8; a8 = a8 + a9; a9 = a9 + b0;
        b0 = b0 + b1; b1 = b1 + b2; b2 = b2 + b3; b3 = b3 + b4; b4 = b4 + b5;
        b5 = b5 + b6; b6 = b6 + b7; b7 = b7 + a0;
        i = i + 1;
    }
    let is f64 as t = id(0.0);
    return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9
         + b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7 + t;
}

fn vectorized(p as *f64, n as i32) as f64 {
    let is f64 as x = id(2.0);
    let is f64 as s with mut = 0.0;
    let is i32 as i with mut = 0;
    while (i < n) { s = s + p[i]; i = i + 1; }
    let is f64 as t = id(1.0);
    return s * x + t;
}

fn main() as i32 {
    if (summed(4) != 8.5) { return 1; }
    if (summed(0) != 2.5) { return 2; }
    if (only_read(3) != 44.0) { return 3; }
    if (only_read(0) != 8.0) { return 4; }
    if (with_break(100) != 76.5) { return 5; }
    if (with_break(2) != 31.5) { return 6; }
    if (with_break(0) != 1.5) { return 7; }
    if (with_return(100) != 8.0) { return 8; }
    if (with_return(2) != 12.0) { return 9; }
    if (nested(3) != 4.75) { return 10; }
    if (nested(0) != 0.25) { return 11; }
    if (nested_free(2) != 9.5) { return 12; }
    if (single(3) != 5.5) { return 13; }
    if (single(0) != 2.5) { return 14; }
    if (crowded(0) != 171.0) { return 15; }
    if (crowded(1) != 344.0) { return 16; }
    let is [64]f64 as v;
    let is i32 as i with mut = 0;
    while (i < 64) { v[i] = cast(f64, i); i = i + 1; }
    if (vectorized(cast(*f64, &v), 64) != 4033.0) { return 17; }
    if (vectorized(cast(*f64, &v), 0) != 1.0) { return 18; }
    return 0;
}
