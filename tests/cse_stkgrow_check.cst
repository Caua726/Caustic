// Image check: every stack probe of a dynamic-stack CSE program
// (lea rax,[rsp-N] ; cmp rax, fs:[0] ; jae +5 ; call helper) calls the same
// address, and the helper starts there (push rdi; push rsi; push rdx; push rcx).
// The helper was a local label: its calls had no relocation, and the linker's
// dead-strip moved the code under them (the first growth jumped into .rodata).
// Exit 0 = fine, 1 = a wrong target, 2 = no probes found, 3 = cannot read.
// Usage: cse_stkgrow_check <image>
use "../std/io.cst" as io;
use "../std/mem/core.cst" as core;
use "../std/env.cst" as env;

fn main(argc as i32, argv as *u8) as i32 {
    let is *i64 as av = cast(*i64, argv);
    if (argc < 2) { return 3; }
    let is i64 as fd = io._open_read(cast(*u8, av[1]));
    if (fd < 0) { return 3; }
    let is *u8 as b = core.mmap_anon(4194304);
    let is i64 as n with mut = 0;
    let is i64 as r with mut = 1;
    while (r > 0 && n < 4194304) {
        r = io._read_fd(fd, cast(*u8, cast(i64, b) + n), 4194304 - n);
        if (r > 0) { n = n + r; }
    }
    let is i64 as i with mut = 0;
    let is i64 as probes with mut = 0;
    let is i64 as helper with mut = 0 - 1;
    while (i + 16 <= n) {
        if (b[i] == 100 && b[i + 1] == 72 && b[i + 2] == 59 && b[i + 3] == 4 && b[i + 4] == 37
            && b[i + 9] == 115 && b[i + 10] == 5 && b[i + 11] == 232) {
            let is *i32 as dp = cast(*i32, cast(i64, b) + i + 12);
            let is i64 as t = i + 16 + cast(i64, dp[0]);
            if (t < 0 || t + 4 > n) { return 1; }
            if (b[t] != 87 || b[t + 1] != 86 || b[t + 2] != 82 || b[t + 3] != 81) { return 1; }
            if (helper >= 0 && t != helper) { return 1; }
            helper = t;
            probes = probes + 1;
        }
        i = i + 1;
    }
    if (probes == 0) { return 2; }
    return 0;
}
