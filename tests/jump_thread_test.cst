// tests/jump_thread_test.cst
//
// A jump whose path fixes the value the next block tests goes to where the test
// leads, and && and || as values branch directly instead of building booleans.
// What must hold: the tested value still reads right where the test is not the
// only reader, a block that changes the value before the test decides it, a
// loop flag keeps its loop, unsigned and float tests read as they should, and
// short-circuit order and side effects do not move.
//
// Exit code 0 on success, else the number of the failing check.

let is i64 as side with mut = 0;

fn cmp3(a as i64, b as i64) as i32 {
    if (a == b) { return 0; }
    if (a < b) { return 0 - 1; }
    return 1;
}

fn cmp_f(a as f64, b as f64) as i32 {
    if (a == b) { return 0; }
    if (a < b) { return 0 - 1; }
    if (a > b) { return 1; }
    return 2;
}

fn classify(a as i64, b as i64) as i64 {
    let is i32 as r = cmp3(a, b);
    if (r < 0) { return 10; }
    if (r > 0) { return 20; }
    return 30;
}

// the result is read past the tests
fn keeps(a as i64, b as i64) as i64 {
    let is i32 as r = cmp3(a, b);
    let is i64 as out with mut = 0;
    if (r < 0) { out = 100; } else if (r > 0) { out = 200; } else { out = 300; }
    return out + cast(i64, r);
}

// the block between changes what the test sees
fn changed(c as i64) as i64 {
    let is i64 as x with mut = 1;
    if (c > 5) { x = 2; }
    if (c > 10) { x = 3; }
    if (x == 1) { return 11; }
    if (x == 2) { return 22; }
    return 33;
}

// a flag that ends its loop
fn flagged(n as i64) as i64 {
    let is i64 as done with mut = 0;
    let is i64 as i with mut = 0;
    let is i64 as sum with mut = 0;
    while (done == 0) {
        sum = sum + i;
        i = i + 1;
        if (i >= n) { done = 1; } else { done = 0; }
    }
    return sum;
}

fn big_u(c as i64) as u64 {
    if (c == 0) { return cast(u64, 0 - 1); }
    return 1;
}

fn is_big(c as i64) as i64 {
    let is u64 as u = big_u(c);
    if (u > 5) { return 1; }
    return 0;
}

fn bump(k as i64) as i64 {
    side = side * 10 + k;
    return k;
}

fn and_value(a as i64, b as i64, c as i64) as bool {
    return bump(a) != 0 && (bump(b) != 0 || bump(c) != 0);
}

fn or_value(a as i64, b as i64, c as i64) as bool {
    return (bump(a) != 0 && bump(b) != 0) || bump(c) != 0;
}

fn in_range(x as i64) as bool {
    let is bool as r = x >= 3 && x <= 9;
    return r;
}

fn main() as i32 {
    if (classify(1, 2) != 10) { return 1; }
    if (classify(2, 1) != 20) { return 2; }
    if (classify(2, 2) != 30) { return 3; }
    if (keeps(1, 2) != 99) { return 4; }
    if (keeps(2, 1) != 201) { return 5; }
    if (keeps(2, 2) != 300) { return 6; }
    if (changed(1) != 11) { return 7; }
    if (changed(7) != 22) { return 8; }
    if (changed(11) != 33) { return 9; }
    if (flagged(5) != 10) { return 10; }
    if (flagged(1) != 0) { return 11; }
    if (is_big(0) != 1) { return 12; }
    if (is_big(1) != 0) { return 13; }
    let is f64 as zero with mut = 0.0;
    let is f64 as nan = zero / zero;
    if (cmp_f(1.0, 2.0) != 0 - 1) { return 14; }
    if (cmp_f(2.0, 1.0) != 1) { return 15; }
    if (cmp_f(1.0, 1.0) != 0) { return 16; }
    if (cmp_f(nan, 1.0) != 2) { return 17; }
    side = 0;
    if (and_value(1, 0, 3) == false || side != 103) { return 18; }
    side = 0;
    if (and_value(0, 2, 3) == true || side != 0) { return 19; }
    side = 0;
    if (and_value(1, 2, 3) == false || side != 12) { return 20; }
    side = 0;
    if (or_value(1, 2, 3) == false || side != 12) { return 21; }
    side = 0;
    if (or_value(0, 2, 3) == false || side != 3) { return 22; }
    side = 0;
    if (or_value(1, 0, 0) == true || side != 100) { return 23; }
    if (in_range(2) == true || in_range(10) == true) { return 24; }
    if (in_range(3) == false || in_range(9) == false) { return 25; }
    return 0;
}
