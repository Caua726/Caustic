let is i32 as calls with mut = 0;
let is i32 as runtime_true with mut = 7;
let is i32 as runtime_false with mut = 0;
let is i32 as ALWAYS with imut = 9;
let is i32 as NEVER with imut = 0;

fn touch() as i32 { calls = calls + 1; return 3; }

fn main() as i32 {
    if (NEVER && touch()) { return 1; }
    if (!(ALWAYS || touch())) { return 2; }
    if (calls != 0) { return 3; }
    if (!(ALWAYS && touch())) { return 4; }
    if (!(NEVER || touch())) { return 5; }
    if (calls != 2) { return 6; }
    if (runtime_false && touch()) { return 7; }
    if (!(runtime_true || touch())) { return 8; }
    if (calls != 2) { return 9; }
    if (!(runtime_true && touch())) { return 10; }
    if (!(runtime_false || touch())) { return 11; }
    if (calls != 4) { return 12; }
    if (!7 || !!0 || !(2 && 5) || !(0 || 4)) { return 13; }
    return 0;
}
