// tests/noreturn_exit_test.cst
//
// The path to a call that never returns, taken after some work, with the
// function holding it copied into a loop: the process ends with that code.
// Exit code 10 (1 + 2 + 3 + 4, when add(100) gives up). Anything else is a failure.
use "../std/io.cst" as io;

let is i64 as sum with mut = 0;

fn fail(code as i32) as void {
    io.exit(code);
}

fn add(v as i64) as void {
    if (v > 5) { fail(cast(i32, sum)); }
    sum = sum + v;
}

fn main() as i32 {
    let is i64 as i with mut = 1;
    while (i < 10) {
        add(i);
        if (sum >= 7) { add(100); }
        i = i + 1;
    }
    return 1;
}
