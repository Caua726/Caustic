// tests/bins_topbin_test.cst — the declared bin table is the table you get.
//
// A slot is its size class plus an 8-byte header, so the top classes did not
// fit a page-sized slab and could never carve a slot. Requests from 32769 up
// to 65536 landed in a bin that always failed, and returned null with no
// message; only requests ABOVE 65536 printed anything, and what it printed
// named the wrong limit. Doubling a buffer 32768 -> 65536 is the shape that
// hits this, so the sizes below walk the boundary on purpose.
use "../std/io.cst" as io;
use "../std/mem.cst" as mem;

let is i32 as fails with mut = 0;

fn chk_alloc(b as *mem.bins.Bins, size as i64) as void {
    let is *u8 as p = mem.bins.bins_alloc(b, size);
    if (cast(i64, p) == 0) {
        fails = fails + 1;
        io.printf("  FAIL alloc de %d devolveu nulo\n", size);
        return;
    }
    // Escreve as duas pontas: um slot curto demais corrompe o vizinho.
    p[0] = cast(u8, 65);
    p[size - 1] = cast(u8, 90);
    if (p[0] != 65 || p[size - 1] != 90) {
        fails = fails + 1;
        io.printf("  FAIL slot de %d nao guarda as duas pontas\n", size);
    }
    mem.bins.bins_free(b, p);
}

fn main() as i32 {
    let is mem.bins.Bins as b = mem.bins.bins_new(65536);

    // Abaixo do teto antigo: sempre funcionou, aqui como controle.
    chk_alloc(&b, 4096);
    chk_alloc(&b, 32768);
    // A faixa que falhava em silencio.
    chk_alloc(&b, 32769);
    chk_alloc(&b, 40000);
    // A potencia de dois do topo — o pedido que uma dobra de buffer faz.
    chk_alloc(&b, 65536);

    // Acima do topo declarado continua sendo falha, e sem escrever em stderr.
    let is *u8 as over = mem.bins.bins_alloc(&b, 65537);
    if (cast(i64, over) != 0) {
        fails = fails + 1;
        io.printf("  FAIL alloc acima do topo devolveu ponteiro\n");
    }

    mem.bins.bins_destroy(&b);
    return fails;
}
