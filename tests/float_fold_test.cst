// tests/float_fold_test.cst — constant folding must not touch float literals
// through the integer field.
//
// An NK_NUM built from a float literal carries its value in fval and leaves
// val at zero. The IR-gen folds for ADD/SUB/MUL and for comparisons used to
// read val unconditionally, so every arithmetic expression between two float
// literals collapsed to 0 and every ordering between them answered as 0 vs 0.
// Both were silent: the folded node stayed well typed, so nothing downstream
// could tell the value had been lost. Division escaped only because its
// divide-by-zero guard saw the unset field and declined to fold.
//
// Exit code is the number of failures.
use "../std/io.cst" as io;

let is i32 as fails with mut = 0;

// Scaled to an integer so the check does not itself depend on float
// formatting. 1e6 keeps every constant below exact-integer range.
fn chk(name as *u8, got as f64, want as i64) as void {
    let is i64 as g = cast(i64, got * 1000000.0);
    if (g != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d (scaled 1e6)\n", name, g, want);
    }
}

fn chk_b(name as *u8, got as i32, want as i32) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, cast(i64, got), cast(i64, want));
    }
}

fn ident(v as f64) as f64 { return v; }

fn main() as i32 {
    // Arithmetic between two float literals — the folded path.
    chk("3.0 + 2.5", 3.0 + 2.5,  5500000);
    chk("3.0 - 2.5", 3.0 - 2.5,   500000);
    chk("3.0 * 2.5", 3.0 * 2.5,  7500000);
    chk("3.0 / 2.5", 3.0 / 2.5,  1200000);
    chk("0.0 - 2.5", 0.0 - 2.5, -2500000);
    chk("1.0 - 2.5", 1.0 - 2.5, -1500000);
    chk("-2.5 + 1.0", -2.5 + 1.0, -1500000);

    // The same expressions with one side opaque to the folder must agree.
    chk("rt(3.0) + 2.5", ident(3.0) + 2.5, 5500000);
    chk("rt(3.0) - 2.5", ident(3.0) - 2.5,  500000);
    chk("rt(3.0) * 2.5", ident(3.0) * 2.5, 7500000);

    // Comparisons between two float literals — the other folded path.
    chk_b("2.5 <  3.0", cast(i32, 2.5 <  3.0), 1);
    chk_b("3.0 >  2.5", cast(i32, 3.0 >  2.5), 1);
    chk_b("2.5 != 3.0", cast(i32, 2.5 != 3.0), 1);
    chk_b("2.5 == 2.5", cast(i32, 2.5 == 2.5), 1);
    chk_b("3.0 <  2.5", cast(i32, 3.0 <  2.5), 0);
    chk_b("2.5 >= 2.5", cast(i32, 2.5 >= 2.5), 1);

    // Integer folding must keep working.
    if (3 + 2 != 5)  { fails = fails + 1; io.printf("  FAIL 3+2\n"); }
    if (3 - 2 != 1)  { fails = fails + 1; io.printf("  FAIL 3-2\n"); }
    if (3 * 2 != 6)  { fails = fails + 1; io.printf("  FAIL 3*2\n"); }
    if (7 / 2 != 3)  { fails = fails + 1; io.printf("  FAIL 7/2\n"); }
    if (7 % 2 != 1)  { fails = fails + 1; io.printf("  FAIL 7%%2\n"); }

    if (fails != 0) { io.printf("  float_fold_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
