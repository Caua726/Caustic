// tests/float_cmov_test.cst — an if-converted select of floats selects the float.
//
// pass_ifconv turns `if (c) { x = y; }` into IR_CMOV, and at -O1 and above the
// allocator may keep x and y in XMM registers (locations 16-31). gen_inst_cmov
// took any location >= 0 as a general register and named it with reg64(), which
// answers "rax" for every XMM location — so the cmovne read rax, which the
// float compare that produced the condition had just overwritten with its 0/1.
// `if (b < hi) { hi = b; }` set hi to the bits of 1, about 5e-324.
//
// Exit code is the number of failures.
use "../std/io.cst" as io;

let is i32 as fails with mut = 0;

fn chk(name as *u8, got as f64, want as f64) as void {
    let is i64 as g = cast(i64, got * 1000.0);
    let is i64 as w = cast(i64, want * 1000.0);
    if (g != w) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d (scaled 1e3)\n", name, g, w);
    }
}

// A running minimum and maximum: the shape if-conversion turns into a cmov.
fn min_of(a as f64, b as f64, c as f64) as f64 {
    let is f64 as lo with mut = a;
    if (b < lo) { lo = b; }
    if (c < lo) { lo = c; }
    return lo;
}

fn max_of(a as f64, b as f64, c as f64) as f64 {
    let is f64 as hi with mut = a;
    if (b > hi) { hi = b; }
    if (c > hi) { hi = c; }
    return hi;
}

// The reduced case: a minimum carried around a loop, fed by a float computed
// in the same iteration from a value chosen by another select.
fn loop_min(a1 as f64, a2 as f64, a5 as f64, x1 as i64) as f64 {
    let is f64 as hi with mut = cast(f64, x1);
    let is i32 as e with mut = 0;
    while (e < 3) {
        let is f64 as by with mut = a5;
        if (e == 1) { by = a1; }
        let is f64 as k = 0.0 - (by - a2);
        if (k < 0.0) {
            let is f64 as b1 = (0.0 - 1.0) / k * 4.5;
            if (b1 < hi) { hi = b1; }
        }
        e = e + 1;
    }
    return hi;
}

fn main() as i32 {
    chk("min first", min_of(1.5, 2.5, 3.5), 1.5);
    chk("min middle", min_of(2.5, 1.5, 3.5), 1.5);
    chk("min last", min_of(2.5, 3.5, 1.5), 1.5);
    chk("max first", max_of(3.5, 2.5, 1.5), 3.5);
    chk("max last", max_of(1.5, 2.5, 3.5), 3.5);
    chk("min negative", min_of(0.0 - 1.0, 0.0 - 4.0, 2.0), 0.0 - 4.0);
    chk("loop min", loop_min(0.0, 0.0, 16.0, 16), 0.28125);
    if (fails != 0) {
        io.printf("float_cmov_test: %d failures\n", cast(i64, fails));
    }
    return fails;
}
