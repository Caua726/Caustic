// Built for CausticOS at -O1, never run: cse_stkgrow_check.cst reads the image.
// The inlined functions below leave bodies the linker strips between the probed
// ones and the stack-growth helper. Recursion is what makes the stack dynamic.
fn inl_a(x as i64) as i64 { let is [64]i64 as t with mut; t[x & 63] = x; return t[x & 63] + 1; }
fn inl_b(x as i64) as i64 { return inl_a(x) * 3; }
fn far(x as i64) as i64 with noinline { let is [128]i64 as t with mut; t[x & 127] = inl_b(x); return t[x & 127]; }
fn unused_one(x as i64) as i64 { let is [32]i64 as t with mut; t[x & 31] = x * 7; return t[x & 31]; }
fn near(x as i64) as i64 with noinline { let is [256]i64 as t with mut; t[x & 255] = far(x) + inl_a(x); return t[x & 255]; }
fn deep(n as i64) as i64 { let is [64]i64 as t with mut; t[n & 63] = n; if (n == 0) { return 0; } return deep(n - 1) + t[n & 63]; }
fn main(argc as i64) as i32 { return cast(i32, near(argc) + deep(argc) + far(argc) + inl_b(argc)); }
