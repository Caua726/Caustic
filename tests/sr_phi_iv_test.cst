// tests/sr_phi_iv_test.cst
//
// Strength reduction on the SSA form: an induction variable is a header phi,
// its first value the phi's argument from the preheader. Each function below
// is one shape of loop the pass rewrites (or must leave correct): the address
// it turns into a stepping pointer has to read the same elements as the
// indexed one, at -O0, -O1, -O2, and with -g (where locals stay in memory and
// the induction variable is a stack slot).
//
// Exit code 0 on success, else the number of the failing check.

let is i32 as W with imut = 8;
let is [64]i64 as m with mut;
let is [64]i32 as m32 with mut;

struct Pt { x as i64; y as i64; z as i64; }
let is [16]Pt as pts with mut;

// Nested loops: the inner IV restarts at 0 on every outer pass.
fn nested_sum(a as *i64) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as r with mut = 0;
    while (r < W) {
        let is i32 as c with mut = 0;
        while (c < W) { s = s + a[r * W + c] * cast(i64, c + 1); c = c + 1; }
        r = r + 1;
    }
    return s;
}

// The inner IV restarts at a value the outer one decides: a triangle.
fn triangle_sum(a as *i64) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as r with mut = 0;
    while (r < W) {
        let is i32 as c with mut = r + 1;
        while (c < W) { s = s + a[r * W + c]; c = c + 1; }
        r = r + 1;
    }
    return s;
}

// Non-zero and variable first values.
fn from_k(a as *i64, row as i32, k as i32) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as c with mut = k;
    while (c < W) { s = s + a[row * W + c]; c = c + 1; }
    return s;
}

fn from_3(a as *i32, row as i32) as i32 {
    let is i32 as s with mut = 0;
    let is i32 as c with mut = 3;
    while (c < W) { s = s + a[row * W + c]; c = c + 1; }
    return s;
}

// Negative steps, down to 0 and down to a variable bound.
fn backwards(a as *i64, row as i32) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as c with mut = W - 1;
    while (c >= 0) { s = s * 3 + a[row * W + c]; c = c - 1; }
    return s;
}

fn backwards_by_2(a as *i32, row as i32, lo as i32) as i32 {
    let is i32 as s with mut = 0;
    let is i32 as c with mut = W - 1;
    while (c >= lo) { s = s * 5 + a[row * W + c]; c = c - 2; }
    return s;
}

// Two IVs in one loop, stepping differently.
fn two_ivs(a as *i64, b as *i32) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as i with mut = 0;
    let is i32 as j with mut = 1;
    while (i < W) {
        s = s + a[2 * W + i] * 10 + cast(i64, b[3 * W + j]);
        i = i + 1;
        j = j + 2;
        if (j >= W) { j = j - W; }
    }
    return s;
}

fn two_ivs_both_linear(a as *i64) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as i with mut = 0;
    let is i32 as j with mut = 2;
    while (i < 6) {
        s = s * 7 + a[W + i] - a[4 * W + j];
        i = i + 1;
        j = j + 1;
    }
    return s;
}

// The IV is read after the loop.
fn first_over(a as *i64, row as i32, limit as i64) as i32 {
    let is i32 as c with mut = 0;
    let is i64 as s with mut = 0;
    while (c < W && s <= limit) { s = s + a[row * W + c]; c = c + 1; }
    return c * 100 + cast(i32, s);
}

// The IV is stored to memory every iteration, next to the address it makes.
let is i32 as last_c with mut = 0;
fn stored_iv(a as *i64, out as *i32, row as i32) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as c with mut = 1;
    while (c < W) {
        out[c] = c;
        last_c = c;
        s = s + a[row * W + c];
        c = c + 1;
    }
    return s + cast(i64, last_c) * 1000;
}

// Array of structs: (iv * K) << sh, from a non-zero start and stepping back.
fn struct_walk(p as *Pt, lo as i32, hi as i32) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as i with mut = lo;
    while (i < hi) { s = s + p[i].y; i = i + 1; }
    let is i32 as k with mut = hi - 1;
    while (k >= lo) { s = s * 2 + p[k].z; k = k - 1; }
    return s;
}

// base + iv * stride with the stride in a register, the IV from 2.
fn column(a as *i64, stride as i64, col as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as r with mut = 2;
    while (r < 8) {
        let is *i64 as q = cast(*i64, cast(i64, a) + (r * stride + col) * 8);
        s = s + *q;
        r = r + 1;
    }
    return s;
}

fn column_reg(a as *u8, stride as i64, n as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as r with mut = 1;
    while (r < n) {
        let is *i64 as q = cast(*i64, cast(i64, a) + r * stride);
        s = s + *q;
        r = r + 1;
    }
    return s;
}

// A column of a matrix stored by columns: ldm * c + i, c from a variable
// start (base + iv * z, z in a register).
fn col_from(mm as *i32, ldm as i32, lo as i32, hi as i32, i as i32) as i32 {
    let is i32 as s with mut = 0;
    let is i32 as c with mut = lo;
    while (c <= hi) { s = s + mm[ldm * c + i]; c = c + 1; }
    return s;
}

// A constant stride that is not a power of two: p[i * 9], i from 1.
fn stride9(p as *i64, n as i32) as i64 {
    let is i64 as s with mut = 0;
    let is i32 as i with mut = 1;
    while (i < n) { s = s * 3 + p[i * 9]; i = i + 1; }
    return s;
}

fn main() as i32 {
    let is i32 as i with mut = 0;
    while (i < 64) { m[i] = cast(i64, i * 3 + 1); m32[i] = i * 5 - 7; i = i + 1; }
    i = 0;
    while (i < 16) { pts[i].x = cast(i64, i); pts[i].y = cast(i64, i * i); pts[i].z = cast(i64, 100 - i); i = i + 1; }
    let is *i64 as a = cast(*i64, &m);
    let is *i32 as b = cast(*i32, &m32);

    // reference values, computed the slow way
    let is i64 as want with mut = 0;
    let is i32 as r with mut = 0;
    let is i32 as c with mut = 0;
    while (r < 8) { c = 0; while (c < 8) { want = want + m[r * 8 + c] * cast(i64, c + 1); c = c + 1; } r = r + 1; }
    if (nested_sum(a) != want) { return 1; }

    want = 0; r = 0;
    while (r < 8) { c = r + 1; while (c < 8) { want = want + m[r * 8 + c]; c = c + 1; } r = r + 1; }
    if (triangle_sum(a) != want) { return 2; }

    if (from_k(a, 2, 5) != m[21] + m[22] + m[23]) { return 3; }
    if (from_k(a, 0, 0) != 1 + 4 + 7 + 10 + 13 + 16 + 19 + 22) { return 4; }
    if (from_3(b, 5) != m32[43] + m32[44] + m32[45] + m32[46] + m32[47]) { return 5; }

    want = 0; c = 7;
    while (c >= 0) { want = want * 3 + m[24 + c]; c = c - 1; }
    if (backwards(a, 3) != want) { return 6; }
    let is i32 as w32 with mut = 0;
    c = 7;
    while (c >= 2) { w32 = w32 * 5 + m32[48 + c]; c = c - 2; }
    if (backwards_by_2(b, 6, 2) != w32) { return 7; }

    want = 0;
    let is i32 as j with mut = 1;
    c = 0;
    while (c < 8) {
        want = want + m[16 + c] * 10 + cast(i64, m32[24 + j]);
        j = j + 2;
        if (j >= 8) { j = j - 8; }
        c = c + 1;
    }
    if (two_ivs(a, b) != want) { return 8; }

    want = 0; c = 0;
    while (c < 6) { want = want * 7 + m[8 + c] - m[32 + c + 2]; c = c + 1; }
    if (two_ivs_both_linear(a) != want) { return 9; }

    // row 1 is 25, 28, 31, ...: 25 + 28 + 31 = 84 > 60 after three
    if (first_over(a, 1, 60) != 3 * 100 + 84) { return 10; }
    if (first_over(a, 1, 100000) != 8 * 100 + 25 + 28 + 31 + 34 + 37 + 40 + 43 + 46) { return 11; }

    let is [8]i32 as outv;
    i = 0;
    while (i < 8) { outv[i] = 0 - 1; i = i + 1; }
    want = 0; c = 1;
    while (c < 8) { want = want + m[40 + c]; c = c + 1; }
    if (stored_iv(a, cast(*i32, &outv), 5) != want + 7000) { return 12; }
    i = 1;
    while (i < 8) { if (outv[i] != i) { return 13; } i = i + 1; }
    if (outv[0] != 0 - 1) { return 14; }

    want = 0; c = 3;
    while (c < 11) { want = want + pts[c].y; c = c + 1; }
    c = 10;
    while (c >= 3) { want = want * 2 + pts[c].z; c = c - 1; }
    if (struct_walk(cast(*Pt, &pts), 3, 11) != want) { return 15; }

    want = 0; c = 2;
    while (c < 8) { want = want + m[c * 8 + 3]; c = c + 1; }
    if (column(a, 8, 3) != want) { return 16; }
    want = 0; c = 1;
    while (c < 5) { want = want + m[c * 3]; c = c + 1; }
    if (column_reg(cast(*u8, a), 24, 5) != want) { return 17; }

    w32 = 0; c = 2;
    while (c <= 6) { w32 = w32 + m32[8 * c + 5]; c = c + 1; }
    if (col_from(b, 8, 2, 6, 5) != w32) { return 18; }
    want = 0; c = 1;
    while (c < 7) { want = want * 3 + m[c * 9]; c = c + 1; }
    if (stride9(a, 7) != want) { return 19; }
    return 0;
}
