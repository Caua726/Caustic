// tests/vec_convert_test.cst
//
// At -O2 the loop widener (src/ir/vec/vec_widen.cst) converts in vector
// lanes: integer to float (the index too), f32 to f64 and back, integers
// widened as they are loaded and narrowed as they are stored, f32 lanes
// throughout. A float sum or product keeps the scalar loop's order exactly:
// the lanes are folded into the accumulator one after another, so the
// results below — chosen so that any other order rounds differently — must
// match the element-by-element reference bit for bit. Trip counts around
// every vector width, unaligned starts, an output that overlaps an input.
//
// Exit code 0 on success, else the number of the failing check.

let is i64 as opaque with mut = 0;

fn bits64(x as f64) as i64 { let is f64 as v = x; return *cast(*i64, &v); }
fn bits32(x as f32) as i32 { let is f32 as v = x; return *cast(*i32, &v); }

fn fill_f32(x as *f32, n as i32, a as f32) as void {
    let is i32 as j with mut = 0;
    while (j < n) { x[j] = a + cast(f32, j); j = j + 1; }
}
fn ref_fill_f32(x as *f32, n as i32, a as f32) as void {
    let is i32 as j with mut = 0;
    while (j < n) { x[j] = a + cast(f32, j); j = j + 1 + cast(i32, opaque); }
}

fn dot_wide(x as *f32, y as *f32, n as i64) as f64 {
    let is f64 as acc with mut = 0.0;
    let is i64 as i with mut = 0;
    while (i < n) { acc = acc + cast(f64, x[i]) * cast(f64, y[i]); i = i + 1; }
    return acc;
}
fn ref_dot_wide(x as *f32, y as *f32, n as i64) as f64 {
    let is f64 as acc with mut = 0.0;
    let is i64 as i with mut = 0;
    while (i < n) { acc = acc + cast(f64, x[i]) * cast(f64, y[i]); i = i + 1 + opaque; }
    return acc;
}

fn sum_f32(x as *f32, n as i64) as f32 {
    let is f32 as s with mut = 0.5;
    let is i64 as i with mut = 0;
    while (i < n) { s = s + x[i]; i = i + 1; }
    return s;
}
fn ref_sum_f32(x as *f32, n as i64) as f32 {
    let is f32 as s with mut = 0.5;
    let is i64 as i with mut = 0;
    while (i < n) { s = s + x[i]; i = i + 1 + opaque; }
    return s;
}

fn prod_f64(x as *f64, n as i64) as f64 {
    let is f64 as s with mut = 1.0;
    let is i64 as i with mut = 0;
    while (i < n) { s = s * x[i]; i = i + 1; }
    return s;
}
fn ref_prod_f64(x as *f64, n as i64) as f64 {
    let is f64 as s with mut = 1.0;
    let is i64 as i with mut = 0;
    while (i < n) { s = s * x[i]; i = i + 1 + opaque; }
    return s;
}

// f64 -> f32 narrowing and back, an f32 map
fn narrow(d as *f32, s as *f64, n as i64, k as f32) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = cast(f32, s[i]) * k; i = i + 1; }
}
fn ref_narrow(d as *f32, s as *f64, n as i64, k as f32) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = cast(f32, s[i]) * k; i = i + 1 + opaque; }
}

// bytes widened to i32, scaled, into f64
fn widen(d as *f64, s as *u8, t as *i16, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = cast(f64, cast(i32, s[i]) - cast(i32, t[i])) / 4.0; i = i + 1; }
}
fn ref_widen(d as *f64, s as *u8, t as *i16, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = cast(f64, cast(i32, s[i]) - cast(i32, t[i])) / 4.0; i = i + 1 + opaque; }
}

// integers narrowed as they are stored
fn trunc(d8 as *u8, d16 as *i16, d32 as *i32, s as *i64, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        d8[i] = cast(u8, s[i]);
        d16[i] = cast(i16, s[i] - 3);
        d32[i] = cast(i32, s[i] + i);
        i = i + 1;
    }
}
fn ref_trunc(d8 as *u8, d16 as *i16, d32 as *i32, s as *i64, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        d8[i] = cast(u8, s[i]);
        d16[i] = cast(i16, s[i] - 3);
        d32[i] = cast(i32, s[i] + i);
        i = i + 1 + opaque;
    }
}

fn main() as i32 {
    let is [96]f32 as fx; let is [96]f32 as fy; let is [96]f32 as gx;
    let is [96]f64 as dx; let is [96]f64 as dy;
    let is [96]u8 as bx; let is [96]i16 as hx; let is [96]i64 as qx;
    let is [96]u8 as b1; let is [96]u8 as b2;
    let is [96]i16 as h1; let is [96]i16 as h2;
    let is [96]i32 as w1; let is [96]i32 as w2;
    let is u64 as seed with mut = 2463534242;
    let is i64 as k with mut = 0;
    while (k < 96) {
        seed = seed ^ (seed << 13); seed = seed ^ (seed >> 7); seed = seed ^ (seed << 17);
        fx[k] = cast(f32, cast(i64, seed & 1048575)) * 0.0009765625 + 1.0e7;
        fy[k] = cast(f32, cast(i64, (seed >> 20) & 65535)) * 0.125 - 3000.0;
        dx[k] = cast(f64, cast(i64, seed & 16777215)) * 1.0e-7 + 0.9;
        bx[k] = cast(u8, seed & 255);
        hx[k] = cast(i16, cast(i64, (seed >> 8) & 65535) - 32768);
        qx[k] = cast(i64, seed);
        k = k + 1;
    }
    let is [12]i64 as ns;
    ns[0] = 0; ns[1] = 1; ns[2] = 3; ns[3] = 7; ns[4] = 8; ns[5] = 9; ns[6] = 15;
    ns[7] = 16; ns[8] = 17; ns[9] = 31; ns[10] = 33; ns[11] = 90;
    let is i64 as t with mut = 0;
    while (t < 12) {
        let is i64 as n = ns[t] + opaque;
        let is i32 as fail = cast(i32, t * 10);
        let is i64 as off with mut = 0;
        while (off < 3) {
            let is *f32 as px = cast(*f32, cast(i64, &fx) + off * 4);
            let is *f32 as py = cast(*f32, cast(i64, &fy) + off * 4);
            let is *f64 as pd = cast(*f64, cast(i64, &dx) + off * 8);
            // fill: compare against a reference fill of a second array
            fill_f32(cast(*f32, &gx), cast(i32, n), 0.1);
            let is [96]f32 as rx;
            ref_fill_f32(cast(*f32, &rx), cast(i32, n), 0.1);
            let is i64 as j with mut = 0;
            while (j < n) { if (bits32(gx[j]) != bits32(rx[j])) { return fail + 1; } j = j + 1 + opaque; }
            if (bits64(dot_wide(px, py, n)) != bits64(ref_dot_wide(px, py, n))) { return fail + 2; }
            if (bits32(sum_f32(px, n)) != bits32(ref_sum_f32(px, n))) { return fail + 3; }
            if (bits64(prod_f64(pd, n)) != bits64(ref_prod_f64(pd, n))) { return fail + 4; }
            narrow(cast(*f32, &gx), pd, n, 3.0);
            ref_narrow(cast(*f32, &rx), pd, n, 3.0);
            j = 0;
            while (j < n) { if (bits32(gx[j]) != bits32(rx[j])) { return fail + 5; } j = j + 1 + opaque; }
            widen(cast(*f64, &dy), cast(*u8, cast(i64, &bx) + off), cast(*i16, cast(i64, &hx) + off * 2), n);
            let is [96]f64 as ry;
            ref_widen(cast(*f64, &ry), cast(*u8, cast(i64, &bx) + off), cast(*i16, cast(i64, &hx) + off * 2), n);
            j = 0;
            while (j < n) { if (bits64(dy[j]) != bits64(ry[j])) { return fail + 6; } j = j + 1 + opaque; }
            trunc(cast(*u8, &b1), cast(*i16, &h1), cast(*i32, &w1), cast(*i64, cast(i64, &qx) + off * 8), n);
            ref_trunc(cast(*u8, &b2), cast(*i16, &h2), cast(*i32, &w2), cast(*i64, cast(i64, &qx) + off * 8), n);
            j = 0;
            while (j < n) { if (b1[j] != b2[j] || h1[j] != h2[j] || w1[j] != w2[j]) { return fail + 7; } j = j + 1 + opaque; }
            // in place, and shifted by one: the overlap test keeps it scalar
            let is *f32 as q = cast(*f32, &gx);
            let is *f32 as r = cast(*f32, &rx);
            j = 0;
            while (j < 96) { q[j] = cast(f32, j); r[j] = cast(f32, j); j = j + 1 + opaque; }
            narrow(cast(*f32, cast(i64, q) + 4), cast(*f64, q), n / 2, 2.0);
            ref_narrow(cast(*f32, cast(i64, r) + 4), cast(*f64, r), n / 2, 2.0);
            j = 0;
            while (j < 96) { if (bits32(q[j]) != bits32(r[j])) { return fail + 8; } j = j + 1 + opaque; }
            off = off + 1;
        }
        t = t + 1;
    }
    return 0;
}
