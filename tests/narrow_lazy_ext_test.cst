// tests/narrow_lazy_ext_test.cst
//
// At -O2 an 8-, 16- or 32-bit ADD/SUB/MUL/NEG/AND/OR/XOR/SHL whose readers
// look only at its low bits is left unextended in its 64-bit register
// (emit.cst, lz_init). These functions mix such chains with every kind of
// reader — narrow compares (signed and unsigned, against registers and
// constants near the type's limits), narrow stores, widening and narrowing
// casts, divisions and right shifts that need the whole value — and check the
// results against values worked out by hand.
//
// Exit code 0 on success, else the number of the failing check.

// u16 OR-accumulate and a select, stored back as u16 (the lowercase loop).
fn lower16(src as *u16, n as i64, dst as *u16) as i32 {
    let is u16 as seen with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u16 as c = src[i];
        seen = seen | c;
        let is u16 as up with mut = 0;
        if (c >= 65 && c <= 90) { up = 32; }
        dst[i] = c | up;
        i = i + 1;
    }
    if ((seen & 0xFF80) == 0) { return 1; }
    return 0;
}

// i32 XOR reduction (find the duplicate).
fn xor_dup(a as *i32, n as i32) as i32 {
    let is i32 as r with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) { r = r ^ (i + 1) ^ a[i]; i = i + 1; }
    return r ^ n;
}

// u8 wrap-around: the sum overflows 8 bits many times; compared unsigned.
fn u8_wrap(k as i32) as i32 {
    let is u8 as x with mut = 7;
    let is i32 as hits with mut = 0;
    let is i32 as i with mut = 0;
    while (i < k) {
        x = x * 3 + 11;
        if (x > 200) { hits = hits + 1; }
        if (x == 255) { hits = hits + 100; }
        i = i + 1;
    }
    return hits * 1000 + cast(i32, x);
}

// i8 signed compares near the limits, then a widening cast.
fn i8_signed(k as i32) as i64 {
    let is i8 as v with mut = 100;
    let is i64 as acc with mut = 0;
    let is i32 as i with mut = 0;
    while (i < k) {
        v = v + 9;
        if (v < 0 - 100) { acc = acc + 1; }
        if (v >= 120) { acc = acc + 1000; }
        acc = acc + cast(i64, v);
        i = i + 1;
    }
    return acc;
}

// i16 product, shifted left, then divided and shifted right (whole value needed).
fn i16_mix(k as i32) as i32 {
    let is i16 as a with mut = 1234;
    let is i32 as out with mut = 0;
    let is i32 as i with mut = 0;
    while (i < k) {
        a = a * 7 - 301;
        a = a << 1;
        out = out + cast(i32, a / 3) + cast(i32, a >> 2);
        i = i + 1;
    }
    return out;
}

// u32 arithmetic past 2^31, compared and narrowed.
fn u32_big(k as i32) as i64 {
    let is u32 as h with mut = 2166136261;
    let is i64 as below with mut = 0;
    let is i32 as i with mut = 0;
    while (i < k) {
        h = (h ^ cast(u32, i)) * 16777619;
        if (h < 2147483648) { below = below + 1; }
        i = i + 1;
    }
    let is u8 as low = cast(u8, h);
    return below * 1000000 + cast(i64, h % 1000) * 1000 + cast(i64, low);
}

fn main() as i32 {
    let is [12]u16 as s;
    let is [12]u16 as t;
    let is *u8 as text = "Hello, WORLD";
    let is i32 as k with mut = 0;
    while (k < 12) { s[k] = cast(u16, text[k]); k = k + 1; }
    if (lower16(cast(*u16, &s), 12, cast(*u16, &t)) != 1) { return 1; }
    if (t[0] != 104 || t[7] != 119 || t[11] != 100 || t[6] != 32) { return 2; }
    s[3] = 300;
    if (lower16(cast(*u16, &s), 12, cast(*u16, &t)) != 0) { return 3; }

    let is [9]i32 as a;
    k = 0;
    while (k < 8) { a[k] = k + 1; k = k + 1; }
    a[8] = 5;
    if (xor_dup(cast(*i32, &a), 9) != 5 ^ 9 ^ 9) { return 4; }

    // Reference values computed at -O0.
    if (u8_wrap(1000) != 907023) { return 5; }
    if (i8_signed(500) != 15194) { return 6; }
    if (i16_mix(300) != 2548475) { return 7; }
    if (u32_big(5000) != 2520101157) { return 8; }
    return 0;
}
