// tests/vec_select_test.cst
//
// At -O2 the loop widener (src/ir/vec/vec_widen.cst) runs a body with
// branches in vector lanes: each block runs under a predicate, a truth table
// over the compares its branches test, and a value assigned under a
// predicate is blended with the one it replaces. `&&` and `||`, nested ifs,
// if/else assigning different values, unsigned compares at 8, 16, 32 bits
// (the sign bit flipped on both sides), signed ones with negative values,
// float compares with NaN, a reduction under a condition (the identity where
// it does not run), and an output that is also the input or overlaps it.
// Every answer is checked against an element-by-element reference.
//
// Exit code 0 on success, else the number of the failing check.

let is i64 as opaque with mut = 0;

fn lower(src as *u16, n as i64, dst as *u16) as i32 {
    let is u16 as seen with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u16 as c = src[i];
        seen = seen | c;
        let is u16 as upper with mut = 0;
        if (c >= 65 && c <= 90) { upper = 32; }
        dst[i] = c | upper;
        i = i + 1;
    }
    if ((seen & 0xFF80) == 0) { return 1; }
    return 0;
}
fn ref_lower(src as *u16, n as i64, dst as *u16) as i32 {
    let is u16 as seen with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u16 as c = src[i];
        seen = seen | c;
        let is u16 as upper with mut = 0;
        if (c >= 65 && c <= 90) { upper = 32; }
        dst[i] = c | upper;
        i = i + 1 + opaque;
    }
    if ((seen & 0xFF80) == 0) { return 1; }
    return 0;
}

// clamp: two ifs that overwrite the same value
fn clamp(d as *i32, s as *i32, n as i64, lo as i32, hi as i32) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as x with mut = s[i];
        if (x < lo) { x = lo; }
        if (x > hi) { x = hi; }
        d[i] = x;
        i = i + 1;
    }
}
fn ref_clamp(d as *i32, s as *i32, n as i64, lo as i32, hi as i32) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i32 as x with mut = s[i];
        if (x < lo) { x = lo; }
        if (x > hi) { x = hi; }
        d[i] = x;
        i = i + 1 + opaque;
    }
}

// if/else, ||, nested if, unsigned bytes above 127
fn classify(d as *u8, s as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u8 as c = s[i];
        let is u8 as r with mut = 0;
        if (c < 32 || c == 127) { r = 1; }
        else {
            if (c >= 200) { r = 2; } else { r = c ^ 85; }
        }
        d[i] = r;
        i = i + 1;
    }
}
fn ref_classify(d as *u8, s as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u8 as c = s[i];
        let is u8 as r with mut = 0;
        if (c < 32 || c == 127) { r = 1; }
        else {
            if (c >= 200) { r = 2; } else { r = c ^ 85; }
        }
        d[i] = r;
        i = i + 1 + opaque;
    }
}

// unsigned 32-bit compare across the sign bit, conditional count
fn count_big(s as *u32, n as i64, k as u32) as i32 {
    let is i32 as c with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (s[i] > k) { c = c + 1; }
        i = i + 1;
    }
    return c;
}
fn ref_count_big(s as *u32, n as i64, k as u32) as i32 {
    let is i32 as c with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (s[i] > k) { c = c + 1; }
        i = i + 1 + opaque;
    }
    return c;
}

// float select with NaN: a NaN fails every ordered compare
fn fsel(d as *f64, a as *f64, b as *f64, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is f64 as x with mut = a[i];
        if (b[i] < x) { x = b[i]; }
        if (x != x) { x = 0.0 - 1.0; }
        d[i] = x;
        i = i + 1;
    }
}
fn ref_fsel(d as *f64, a as *f64, b as *f64, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is f64 as x with mut = a[i];
        if (b[i] < x) { x = b[i]; }
        if (x != x) { x = 0.0 - 1.0; }
        d[i] = x;
        i = i + 1 + opaque;
    }
}

// a float sum under a condition, kept in order
fn fsum_pos(a as *f32, n as i64) as f32 {
    let is f32 as s with mut = 0.0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is f32 as x = a[i];
        if (x > 0.0) { s = s + x; }
        i = i + 1;
    }
    return s;
}
fn ref_fsum_pos(a as *f32, n as i64) as f32 {
    let is f32 as s with mut = 0.0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is f32 as x = a[i];
        if (x > 0.0) { s = s + x; }
        i = i + 1 + opaque;
    }
    return s;
}

// signed 16-bit max reduction through a select (not a +-^|& chain: scalar)
// and an abs map with negative values
fn abs16(d as *i16, s as *i16, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i16 as x with mut = s[i];
        if (x < 0) { x = 0 - x; }
        d[i] = x;
        i = i + 1;
    }
}
fn ref_abs16(d as *i16, s as *i16, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i16 as x with mut = s[i];
        if (x < 0) { x = 0 - x; }
        d[i] = x;
        i = i + 1 + opaque;
    }
}

fn bits64(x as f64) as i64 { let is f64 as v = x; return *cast(*i64, &v); }
fn bits32(x as f32) as i32 { let is f32 as v = x; return *cast(*i32, &v); }

fn main() as i32 {
    let is [100]u16 as t16; let is [100]u16 as o16; let is [100]u16 as r16;
    let is [100]i32 as t32; let is [100]i32 as o32; let is [100]i32 as r32;
    let is [100]u8 as t8; let is [100]u8 as o8; let is [100]u8 as r8;
    let is [100]u32 as tu; let is [100]f64 as fa; let is [100]f64 as fb;
    let is [100]f64 as fo; let is [100]f64 as fr; let is [100]f32 as ff;
    let is [100]i16 as h; let is [100]i16 as ho; let is [100]i16 as hr;
    let is u64 as seed with mut = 1234567;
    let is i64 as k with mut = 0;
    while (k < 100) {
        seed = seed ^ (seed << 13); seed = seed ^ (seed >> 7); seed = seed ^ (seed << 17);
        t16[k] = cast(u16, 40 + (seed % 80));
        if (k % 13 == 5) { t16[k] = cast(u16, 400 + (seed & 1023)); }
        t32[k] = cast(i32, cast(i64, seed & 4095) - 2048);
        t8[k] = cast(u8, seed & 255);
        tu[k] = cast(u32, seed >> 11);
        fa[k] = cast(f64, cast(i64, seed & 1023)) - 500.0;
        fb[k] = cast(f64, cast(i64, (seed >> 10) & 1023)) - 500.0;
        if (k % 7 == 2) { fa[k] = 0.0 / 0.0; }
        if (k % 9 == 4) { fb[k] = 0.0 / 0.0; }
        ff[k] = cast(f32, cast(i64, (seed >> 3) & 65535) - 32768) * 0.001;
        h[k] = cast(i16, cast(i64, (seed >> 5) & 65535) - 32768);
        k = k + 1;
    }
    h[3] = cast(i16, 0 - 32768);
    let is [12]i64 as ns;
    ns[0] = 0; ns[1] = 1; ns[2] = 3; ns[3] = 7; ns[4] = 8; ns[5] = 9; ns[6] = 15;
    ns[7] = 16; ns[8] = 17; ns[9] = 31; ns[10] = 33; ns[11] = 97;
    let is i64 as t with mut = 0;
    while (t < 12) {
        let is i64 as n = ns[t] + opaque;
        let is i32 as fail = cast(i32, t * 10);
        let is i64 as off with mut = 0;
        while (off < 3) {
            let is *u16 as s16 = cast(*u16, cast(i64, &t16) + off * 2);
            if (lower(s16, n, cast(*u16, &o16)) != ref_lower(s16, n, cast(*u16, &r16))) { return fail + 1; }
            let is i64 as j with mut = 0;
            while (j < n) { if (o16[j] != r16[j]) { return fail + 1; } j = j + 1 + opaque; }
            let is *i32 as s32 = cast(*i32, cast(i64, &t32) + off * 4);
            clamp(cast(*i32, &o32), s32, n, 0 - 1000, 1500);
            ref_clamp(cast(*i32, &r32), s32, n, 0 - 1000, 1500);
            j = 0;
            while (j < n) { if (o32[j] != r32[j]) { return fail + 2; } j = j + 1 + opaque; }
            let is *u8 as s8 = cast(*u8, cast(i64, &t8) + off);
            classify(cast(*u8, &o8), s8, n);
            ref_classify(cast(*u8, &r8), s8, n);
            j = 0;
            while (j < n) { if (o8[j] != r8[j]) { return fail + 3; } j = j + 1 + opaque; }
            let is *u32 as su = cast(*u32, cast(i64, &tu) + off * 4);
            if (count_big(su, n, cast(u32, 2147483000)) != ref_count_big(su, n, cast(u32, 2147483000))) { return fail + 4; }
            let is *f64 as pa = cast(*f64, cast(i64, &fa) + off * 8);
            fsel(cast(*f64, &fo), pa, cast(*f64, &fb), n);
            ref_fsel(cast(*f64, &fr), pa, cast(*f64, &fb), n);
            j = 0;
            while (j < n) { if (bits64(fo[j]) != bits64(fr[j])) { return fail + 5; } j = j + 1 + opaque; }
            let is *f32 as pf = cast(*f32, cast(i64, &ff) + off * 4);
            if (bits32(fsum_pos(pf, n)) != bits32(ref_fsum_pos(pf, n))) { return fail + 6; }
            let is *i16 as sh = cast(*i16, cast(i64, &h) + off * 2);
            abs16(cast(*i16, &ho), sh, n);
            ref_abs16(cast(*i16, &hr), sh, n);
            j = 0;
            while (j < n) { if (ho[j] != hr[j]) { return fail + 7; } j = j + 1 + opaque; }
            // in place: the output is the input
            j = 0;
            while (j < 100) { o16[j] = t16[j]; r16[j] = t16[j]; j = j + 1 + opaque; }
            lower(cast(*u16, &o16), n, cast(*u16, &o16));
            ref_lower(cast(*u16, &r16), n, cast(*u16, &r16));
            j = 0;
            while (j < 100) { if (o16[j] != r16[j]) { return fail + 8; } j = j + 1 + opaque; }
            // shifted by one element: each output feeds the next input
            j = 0;
            while (j < 100) { o32[j] = t32[j]; r32[j] = t32[j]; j = j + 1 + opaque; }
            clamp(cast(*i32, cast(i64, &o32) + 4), cast(*i32, &o32), n, 0 - 3, 7);
            ref_clamp(cast(*i32, cast(i64, &r32) + 4), cast(*i32, &r32), n, 0 - 3, 7);
            j = 0;
            while (j < 100) { if (o32[j] != r32[j]) { return fail + 9; } j = j + 1 + opaque; }
            off = off + 1;
        }
        t = t + 1;
    }
    return 0;
}
