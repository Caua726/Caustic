// tests/run_tests.cst — Caustic's test runner, written in Caustic.
//
// Replaces the old run_tests.sh: spawns the local toolchain (./caustic,
// ./caustic-as, ./caustic-ld) with std/process, checks exit codes, and verifies
// the bootstrap fixpoint (gen2 == gen3, byte-for-byte). Run from the repo root;
// invoked by `caustic-mk test`. Exit 0 = all passed, 1 = something failed.
use "../std/process.cst" as proc;
use "../std/io.cst" as io;
use "../std/env.cst" as env;

let is i32 as _pass with mut = 0;
let is i32 as _fail with mut = 0;

fn _slen(s as *u8) as i64 { let is i64 as n with mut = 0; while (s[n] != 0) { n = n + 1; } return n; }
fn _p(s as *u8) as void { io._write_fd(io.STDOUT, s, _slen(s)); }

fn _same(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (a[i] == b[i]) {
        if (a[i] == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Spawn `path` with a NUL-terminated argv array; return its exit code.
fn _run(path as *u8, argv as *u8) as i32 {
    // The self-host gate must exercise its freshly built tools, not the seed.
    // Ordinary runs keep the checked-out binaries as their default.
    let is *u8 as executable with mut = path;
    let is *u8 as override with mut = cast(*u8, 0);
    if (_same(path, "./caustic") == 1) { override = env.getenv("CAUSTIC_TEST_COMPILER"); }
    else if (_same(path, "./caustic-as") == 1) { override = env.getenv("CAUSTIC_TEST_ASSEMBLER"); }
    else if (_same(path, "./caustic-ld") == 1) { override = env.getenv("CAUSTIC_TEST_LINKER"); }
    if (cast(i64, override) != 0 && override[0] != 0) { executable = override; }
    let is i64 as pid = proc.spawn(executable, argv);
    if (pid < 0) { return cast(i32, 0 - 1); }
    return proc.wait_pid(pid);
}

fn _check(name as *u8, ok as i32) as void {
    if (ok == 1) { _p("  PASS  "); _pass = _pass + 1; }
    else { _p("  FAIL  "); _fail = _fail + 1; }
    _p(name); _p("\n");
}

// Byte-for-byte file comparison (bootstrap fixpoint check). Chunked through
// stack buffers — no heap allocator needed.
fn _files_equal(pa as *u8, pb as *u8) as i32 {
    let is i64 as sa = io.file_size(pa);
    let is i64 as sb = io.file_size(pb);
    if (sa <= 0 || sa != sb) { return 0; }
    let is i64 as fa = io._open_read(pa);
    let is i64 as fb = io._open_read(pb);
    if (fa < 0 || fb < 0) { return 0; }
    let is [4096]u8 as bufa;
    let is [4096]u8 as bufb;
    let is i32 as eq with mut = 1;
    let is i64 as ra with mut = io._read_fd(fa, cast(*u8, &bufa), 4096);
    while (ra > 0 && eq == 1) {
        let is i64 as rb = io._read_fd(fb, cast(*u8, &bufb), ra);
        if (rb != ra) { eq = 0; }
        let is i64 as i with mut = 0;
        while (i < ra) { if (bufa[i] != bufb[i]) { eq = 0; i = ra; } i = i + 1; }
        ra = io._read_fd(fa, cast(*u8, &bufa), 4096);
    }
    io._close_fd(fa); io._close_fd(fb);
    return eq;
}

// compile (in-process, full pipeline) + run a single-file test.
fn _unit(name as *u8, src as *u8) as void {
    let is [6]i64 as c;
    c[0] = cast(i64, "./caustic"); c[1] = cast(i64, "-q"); c[2] = cast(i64, src); c[3] = cast(i64, "-o"); c[4] = cast(i64, "build/ct_unit"); c[5] = 0;
    if (_run("./caustic", cast(*u8, &c)) != 0) { _check(name, 0); return; }
    let is [2]i64 as r; r[0] = cast(i64, "build/ct_unit"); r[1] = 0;
    _check(name, cast(i32, _run("build/ct_unit", cast(*u8, &r)) == 0));
}

// The same, at a named optimization level.
//
// Everything in the Unit group runs at the default level, and the bootstrap was
// once the only thing in this file that ever passed -O1 — which is how a
// miscompile that hit every threaded program lived here undetected: the inliner
// is an -O1-only pass and it duplicated `naked` asm bodies, and std/thread's
// clone trampoline is one. A pass that runs at one level needs a suite that
// runs at every level the compiler offers.
//
// -O2 is offered, so -O2 is checked. It has never been run over these tests
// before, and "the flag exists" is not the same claim as "the flag works".
fn _unit_at(name as *u8, src as *u8, flag as *u8) as void {
    let is [7]i64 as c;
    c[0] = cast(i64, "./caustic"); c[1] = cast(i64, "-q"); c[2] = cast(i64, flag); c[3] = cast(i64, src); c[4] = cast(i64, "-o"); c[5] = cast(i64, "build/ct_unit_opt"); c[6] = 0;
    if (_run("./caustic", cast(*u8, &c)) != 0) { _check(name, 0); return; }
    let is [2]i64 as r; r[0] = cast(i64, "build/ct_unit_opt"); r[1] = 0;
    _check(name, cast(i32, _run("build/ct_unit_opt", cast(*u8, &r)) == 0));
}

fn _unit_opt(name as *u8, src as *u8) as void { _unit_at(name, src, "-O1"); }
fn _unit_o2(name as *u8, src as *u8) as void { _unit_at(name, src, "-O2"); }

// A consumer compiled to an object must retain its type/layout semantics when
// the independent linker creates the executable.
fn _unit_object(name as *u8, src as *u8) as void {
    let is [7]i64 as c;
    c[0] = cast(i64, "./caustic"); c[1] = cast(i64, "-q"); c[2] = cast(i64, "-c"); c[3] = cast(i64, src);
    c[4] = cast(i64, "-o"); c[5] = cast(i64, "build/ct_object.o"); c[6] = 0;
    if (_run("./caustic", cast(*u8, &c)) != 0) { _check(name, 0); return; }
    let is [5]i64 as l;
    l[0] = cast(i64, "./caustic-ld"); l[1] = cast(i64, "build/ct_object.o"); l[2] = cast(i64, "-o");
    l[3] = cast(i64, "build/ct_object"); l[4] = 0;
    if (_run("./caustic-ld", cast(*u8, &l)) != 0) { _check(name, 0); return; }
    let is [2]i64 as r; r[0] = cast(i64, "build/ct_object"); r[1] = 0;
    _check(name, cast(i32, _run("build/ct_object", cast(*u8, &r)) == 0));
}

// Compile `src`, run it, and require the EXACT program exit code `want`.
//
// Some behaviour cannot be observed from inside the program under test — an
// uncaught throw ends the process, and whether it ran the cleanups on the way
// out is exactly the question. The fixture encodes its answer in the exit
// code (the cleanup would exit 9, the correct uncaught path exits 1) and this
// reads it back. Each fixture is paired with its opposite, so a fixture broken
// for an unrelated reason fails both instead of passing as the expected one.
fn _unit_exit(name as *u8, src as *u8, want as i32) as void {
    let is [6]i64 as c;
    c[0] = cast(i64, "./caustic"); c[1] = cast(i64, "-q"); c[2] = cast(i64, src); c[3] = cast(i64, "-o"); c[4] = cast(i64, "build/ct_exit"); c[5] = 0;
    if (_run("./caustic", cast(*u8, &c)) != 0) { _check(name, 0); return; }
    let is [2]i64 as r; r[0] = cast(i64, "build/ct_exit"); r[1] = 0;
    _check(name, cast(i32, _run("build/ct_exit", cast(*u8, &r)) == want));
}

// A source that MUST NOT compile. Passes when ./caustic exits non-zero.
//
// "It failed" is weak evidence on its own — a fixture broken for an unrelated
// reason looks identical. Every rejection here is paired with a twin under
// tests/reject/ that is the same file minus the thing being rejected and MUST
// compile and run, so a broken fixture takes both checks down instead of
// quietly passing as a rejection.
fn _reject(name as *u8, src as *u8) as void {
    let is [6]i64 as c;
    c[0] = cast(i64, "./caustic"); c[1] = cast(i64, "-q"); c[2] = cast(i64, src); c[3] = cast(i64, "-o"); c[4] = cast(i64, "build/ct_reject"); c[5] = 0;
    _check(name, cast(i32, _run("./caustic", cast(*u8, &c)) != 0));
}

// Compile `src` and require the EXACT exit code `want`.
//
// _reject above only knows "non-zero", which cannot tell a clean diagnostic
// from a crash: the compiler spends a long time inside recursive descent, and
// the failure mode being checked here is that a deeply nested input killed the
// process — exit code 139 (128 + SIGSEGV) — instead of being refused. A test
// that accepts any non-zero would pass on the crash it is meant to catch.
fn _compiler_exit(name as *u8, src as *u8, want as i32) as void {
    let is [6]i64 as c;
    c[0] = cast(i64, "./caustic"); c[1] = cast(i64, "-q"); c[2] = cast(i64, src); c[3] = cast(i64, "-o"); c[4] = cast(i64, "build/ct_nest"); c[5] = 0;
    _check(name, cast(i32, _run("./caustic", cast(*u8, &c)) == want));
}

// Compile `src` for `target` and require the EXACT compiler exit code `want`.
fn _compiler_exit_target(name as *u8, target as *u8, src as *u8, want as i32) as void {
    let is [7]i64 as c;
    c[0] = cast(i64, "./caustic"); c[1] = cast(i64, "-q"); c[2] = cast(i64, target); c[3] = cast(i64, src); c[4] = cast(i64, "-o"); c[5] = cast(i64, "build/ct_target"); c[6] = 0;
    _check(name, cast(i32, _run("./caustic", cast(*u8, &c)) == want));
}

// Write build/nest_deep.cst: a main that returns `n` nested parens around 0.
// The depth decides the verdict, so the file is generated here rather than
// kept in the tree twice. One paren per line: the diagnostic quotes the line it
// stopped on, and a single line of 12000 parens makes that quote unreadable.
fn _write_nest_src(n as i32) as void {
    let is i64 as fd = io._open_write("build/nest_deep.cst");
    if (fd < 0) { return; }
    let is *u8 as head = "fn main() as i32 { return ";
    io._write_fd(fd, head, _slen(head));
    let is i32 as i with mut = 0;
    while (i < n) { io._write_fd(fd, "(\n", 2); i = i + 1; }
    io._write_fd(fd, "0", 1);
    i = 0;
    while (i < n) { io._write_fd(fd, ")\n", 2); i = i + 1; }
    let is *u8 as tail = "; }\n";
    io._write_fd(fd, tail, _slen(tail));
    io._close_fd(fd);
}

fn main(argc as i64, argv as i64) as i32 {
    env.init(argc, cast(*u8, argv));
    _p("=== Caustic test suite (run_tests.cst) ===\n");

    // --- Unit tests ---
    _p("\n--- Unit ---\n");
    _unit("section_test", "tests/section_test.cst");
    _unit("section_fn_test", "tests/section_fn_test.cst");
    _unit("csif_codec_test", "tests/csif_codec_test.cst");
    _unit("csif_container_test", "tests/csif_container_test.cst");
    _unit("float_fold_test", "tests/float_fold_test.cst");
    _unit("float_cmp_imm_test", "tests/float_cmp_imm_test.cst");
    _unit("float_literal_test", "tests/float_literal_test.cst");
    _unit("many_sections", "tests/many_sections_test.cst");
    _unit("float_cmov_test", "tests/float_cmov_test.cst");
    _unit("math_test", "tests/math_test.cst");
    _unit("call_addr_test", "tests/call_addr_test.cst");
    _unit("logical short-circuit folding", "tests/logical_fold_test.cst");
    _unit("target-guarded imports and callback", "tests/windows/target_imports.cst");
    _unit("path_norm_test", "tests/path_norm_test.cst");
    _unit("nested_modules", "tests/modules/nested_test.cst");
    _unit("only_filter", "tests/modules/only_filter_test.cst");
    _unit("module_array_dim", "tests/modules/dim_test.cst");
    _unit("module-context homonymous types", "tests/modules/collision_test.cst");
    _unit_at("debug module-context homonymous types", "tests/modules/collision_test.cst", "-g");
    _unit_object("separate module-context homonymous types", "tests/modules/collision_test.cst");
    _unit("bins_topbin", "tests/bins_topbin_test.cst");
    _unit("poller", "tests/poller_test.cst");
    _unit("ipv6", "tests/ipv6_test.cst");
    _unit("array_dim", "tests/array_dim_test.cst");
    _unit("cache_guard", "tests/cache_guard_test.cst");
    _unit("inline_asm", "tests/inline_asm_test.cst");
    _unit("segment", "tests/segment_test.cst");
    _unit("bins_lock", "tests/bins_lock_test.cst");
    _unit("big_literal", "tests/big_literal_test.cst");
    _unit("term_input", "tests/term_input_test.cst");
    _unit("unicode_width", "tests/unicode_width_test.cst");
    _unit("unicode_compose", "tests/unicode_compose_test.cst");
    _unit("causticos_term", "tests/causticos_term_test.cst");
    _unit("causticos_font", "tests/causticos_font_test.cst");
    _unit("exceptions", "tests/exceptions_test.cst");
    // Runtime behaviour that cannot be observed from inside the program under
    // test: the exit code is the answer, and each fixture is paired with its
    // opposite so a broken fixture fails both.
    _unit_exit("uncaught throw runs no cleanup", "tests/exceptions/uncaught.cst", 1);
    _unit_exit("caught throw runs the cleanup", "tests/exceptions/caught_cleanup.cst", 9);
    _unit_exit("leave on a non-head is diagnosed", "tests/exceptions/misuse.cst", 2);
    _unit_exit("leave in order is fine", "tests/exceptions/leave_ok.cst", 0);
    _unit_exit("backtrace walks the whole chain", "tests/exceptions/backtrace.cst", 0);

    // --- Sources that must be REFUSED (each with its accepted twin) ---
    _p("\n--- Rejected ---\n");
    _unit("dup_global twin accepted", "tests/reject/ok_global.cst");
    _reject("dup_global refused", "tests/reject/dup_global.cst");
    _unit("fnsig twin accepted", "tests/reject/ok_fnsig.cst");
    _reject("fn of another signature stored", "tests/reject/fnsig_assign.cst");
    _reject("fn of another signature passed", "tests/reject/fnsig_param.cst");
    _reject("call() with f64 for i64", "tests/reject/fnsig_call.cst");
    _reject("call() with integer for *u8", "tests/reject/fnsig_ptrarg.cst");
    _unit("convert twin accepted", "tests/reject/ok_convert.cst");
    _reject("i64 stored into i32 without a cast", "tests/reject/convert_narrow.cst");
    _reject("f64 variable passed for i64", "tests/reject/convert_float.cst");
    _reject("pointer passed for i64", "tests/reject/convert_ptrint.cst");
    _unit("95 custom sections accepted", "tests/reject/ok_sections.cst");
    _reject("96 custom sections refused", "tests/reject/sections_over.cst");


    // CausticOS program I/O must fail at compile time on other targets.
    _p("\n--- CausticOS target API ---\n");
    _compiler_exit_target("prog I/O rejected on Linux", "--target=linux-x86_64", "tests/causticos_syscall_target_test.cst", 1);
    _compiler_exit_target("prog I/O accepted on CausticOS", "--target=caustic-x86_64", "tests/causticos_syscall_target_test.cst", 0);
    _compiler_exit_target("Windows 8192-byte stack probe links", "--target=windows-x86_64", "tests/windows/stack_probe.cst", 0);
    _compiler_exit_target("Windows target guards discard syscalls", "--target=windows-x86_64", "tests/windows/target_imports.cst", 0);
    _compiler_exit_target("Windows missing symbol is rejected", "--target=windows-x86_64", "tests/windows/missing_symbol.cst", 1);
    _compiler_exit_target("Windows bogus IAT slot is rejected", "--target=windows-x86_64", "tests/windows/missing_import_slot.cst", 1);
    // --- Threads (atomics, spawn/join, sync primitives) ---
    _p("\n--- Threads ---\n");
    _unit("t_atomic", "tests/threads/t_atomic.cst");
    _unit("t_spawn_join", "tests/threads/t_spawn_join.cst");
    _unit("t_atomic_counter", "tests/threads/t_atomic_counter.cst");
    _unit("t_mutex_counter", "tests/threads/t_mutex_counter.cst");
    _unit("t_thread_churn", "tests/threads/t_thread_churn.cst");
    _unit("t_sync_full", "tests/threads/t_sync_full.cst");
    _unit("t_alloc_mt", "tests/threads/t_alloc_mt.cst");

    // --- The same, through the optimizing backend ---
    //
    // Every thread test passed at the default level while segfaulting at -O1,
    // because nothing here built them with -O1. The inliner is an -O1-only pass
    // and it was duplicating std/thread's naked clone trampoline; a second code
    // generator needs a second run of the suite, not a second reading of the
    // same one. Anything whose failure could differ between backends belongs
    // here, not only the threads.
    _p("\n--- Optimizing backend (-O1) ---\n");
    _unit_opt("inline_asm -O1", "tests/inline_asm_test.cst");
    _unit_opt("segment -O1", "tests/segment_test.cst");
    _unit_opt("bins_lock -O1", "tests/bins_lock_test.cst");
    _unit_opt("big_literal -O1", "tests/big_literal_test.cst");
    _unit_opt("float_cmp_imm -O1", "tests/float_cmp_imm_test.cst");
    _unit_opt("float_literal -O1", "tests/float_literal_test.cst");
    _unit_opt("float_cmov -O1", "tests/float_cmov_test.cst");
    _unit_opt("term_input -O1", "tests/term_input_test.cst");
    _unit_opt("unicode_width -O1", "tests/unicode_width_test.cst");
    _unit_opt("unicode_compose -O1", "tests/unicode_compose_test.cst");
    _unit_opt("causticos_term -O1", "tests/causticos_term_test.cst");
    _unit_opt("causticos_font -O1", "tests/causticos_font_test.cst");
    _unit_opt("module_array_dim -O1", "tests/modules/dim_test.cst");
    _unit_opt("module-context homonymous types -O1", "tests/modules/collision_test.cst");
    _unit_opt("logical short-circuit folding -O1", "tests/logical_fold_test.cst");
    _unit_opt("target-guarded imports and callback -O1", "tests/windows/target_imports.cst");
    _unit_opt("t_atomic -O1", "tests/threads/t_atomic.cst");
    _unit_opt("t_spawn_join -O1", "tests/threads/t_spawn_join.cst");
    _unit_opt("t_atomic_counter -O1", "tests/threads/t_atomic_counter.cst");
    _unit_opt("t_mutex_counter -O1", "tests/threads/t_mutex_counter.cst");
    _unit_opt("t_thread_churn -O1", "tests/threads/t_thread_churn.cst");
    _unit_opt("t_sync_full -O1", "tests/threads/t_sync_full.cst");
    _unit_opt("t_alloc_mt -O1", "tests/threads/t_alloc_mt.cst");

    // --- And again at -O2 ---
    //
    // The pre-commit gate self-hosts at -O2 and diffs the examples across all
    // three levels, so the backend itself is covered there. These are the cases
    // that exist because something specific broke at ONE level, which is
    // exactly the shape that a level nobody runs would hide again.
    _p("\n--- Optimizing backend (-O2) ---\n");
    _unit_o2("inline_asm -O2", "tests/inline_asm_test.cst");
    _unit_o2("segment -O2", "tests/segment_test.cst");
    _unit_o2("bins_lock -O2", "tests/bins_lock_test.cst");
    _unit_o2("big_literal -O2", "tests/big_literal_test.cst");
    _unit_o2("float_cmp_imm -O2", "tests/float_cmp_imm_test.cst");
    _unit_o2("float_literal -O2", "tests/float_literal_test.cst");
    _unit_o2("many_sections -O2", "tests/many_sections_test.cst");
    _unit_o2("float_cmov -O2", "tests/float_cmov_test.cst");
    _unit_o2("term_input -O2", "tests/term_input_test.cst");
    _unit_o2("unicode_width -O2", "tests/unicode_width_test.cst");
    _unit_o2("unicode_compose -O2", "tests/unicode_compose_test.cst");
    _unit_o2("causticos_term -O2", "tests/causticos_term_test.cst");
    _unit_o2("causticos_font -O2", "tests/causticos_font_test.cst");
    _unit_o2("module_array_dim -O2", "tests/modules/dim_test.cst");
    _unit_o2("module-context homonymous types -O2", "tests/modules/collision_test.cst");
    _unit_o2("logical short-circuit folding -O2", "tests/logical_fold_test.cst");
    _unit_o2("target-guarded imports and callback -O2", "tests/windows/target_imports.cst");
    _unit_o2("t_atomic -O2", "tests/threads/t_atomic.cst");
    _unit_o2("t_spawn_join -O2", "tests/threads/t_spawn_join.cst");
    _unit_o2("t_atomic_counter -O2", "tests/threads/t_atomic_counter.cst");
    _unit_o2("t_mutex_counter -O2", "tests/threads/t_mutex_counter.cst");
    _unit_o2("t_thread_churn -O2", "tests/threads/t_thread_churn.cst");
    _unit_o2("t_sync_full -O2", "tests/threads/t_sync_full.cst");
    _unit_o2("t_alloc_mt -O2", "tests/threads/t_alloc_mt.cst");

    // --- Fixed-capacity scratch state, and the nesting budget ---
    //
    // Every entry here is a cap that used to be silent: scratch state with a
    // fixed capacity that truncated its contents (or a recursion with no depth
    // budget that ended in SIGSEGV) instead of growing or refusing. Each
    // fixture returns 0 only when the answer is the right one, and each was
    // confirmed to FAIL against the pre-fix compiler: params and args died with
    // 139, defer counted one short, loops broke out one level too high, and the
    // CFG fixture crashed at -O1/-O2.
    _p("\n--- Silent caps ---\n");
    _unit("caps_params", "tests/caps_params_test.cst");
    _unit_opt("caps_params -O1", "tests/caps_params_test.cst");
    _unit_o2("caps_params -O2", "tests/caps_params_test.cst");
    _unit("caps_args", "tests/caps_args_test.cst");
    _unit_opt("caps_args -O1", "tests/caps_args_test.cst");
    _unit_o2("caps_args -O2", "tests/caps_args_test.cst");
    _unit("caps_defer", "tests/caps_defer_test.cst");
    _unit_opt("caps_defer -O1", "tests/caps_defer_test.cst");
    _unit_o2("caps_defer -O2", "tests/caps_defer_test.cst");
    _unit("caps_loops", "tests/caps_loops_test.cst");
    _unit_opt("caps_loops -O1", "tests/caps_loops_test.cst");
    _unit_o2("caps_loops -O2", "tests/caps_loops_test.cst");
    // The block-count fixture only means something where the CFG is built, so
    // it is registered at -O1/-O2 and not at the default -O0.
    _unit_opt("caps_cfg -O1", "tests/caps_cfg_test.cst");
    _unit_o2("caps_cfg -O2", "tests/caps_cfg_test.cst");

    // A deeply nested input is a diagnostic (exit 1), not a crash (139 = SIGSEGV,
    // which _compiler_exit would refuse to accept). The positive twin is the same
    // generator at a depth that always worked: the guard must not refuse what it
    // never refused before.
    _write_nest_src(12000);
    _compiler_exit("deep parens rejected", "build/nest_deep.cst", 1);
    _write_nest_src(200);
    _compiler_exit("200 nested parens compile", "build/nest_deep.cst", 0);
    let is [2]i64 as nestrun; nestrun[0] = cast(i64, "build/ct_nest"); nestrun[1] = 0;
    _check("200 nested parens run", cast(i32, _run("build/ct_nest", cast(*u8, &nestrun)) == 0));

    // --- Bootstrap + fixpoint (gen1 -> gen2 -> gen3, gen2 == gen3) ---
    _p("\n--- Bootstrap ---\n");
    let is [7]i64 as g1; g1[0]=cast(i64,"./caustic"); g1[1]=cast(i64,"-q"); g1[2]=cast(i64,"-O1"); g1[3]=cast(i64,"src/main.cst"); g1[4]=cast(i64,"-o"); g1[5]=cast(i64,"build/ct_gen1"); g1[6]=0;
    let is [7]i64 as g2; g2[0]=cast(i64,"build/ct_gen1"); g2[1]=cast(i64,"-q"); g2[2]=cast(i64,"-O1"); g2[3]=cast(i64,"src/main.cst"); g2[4]=cast(i64,"-o"); g2[5]=cast(i64,"build/ct_gen2"); g2[6]=0;
    let is [7]i64 as g3; g3[0]=cast(i64,"build/ct_gen2"); g3[1]=cast(i64,"-q"); g3[2]=cast(i64,"-O1"); g3[3]=cast(i64,"src/main.cst"); g3[4]=cast(i64,"-o"); g3[5]=cast(i64,"build/ct_gen3"); g3[6]=0;
    let is i32 as boot with mut = 1;
    if (_run("./caustic", cast(*u8,&g1)) != 0) { boot = 0; }
    if (boot == 1 && _run("build/ct_gen1", cast(*u8,&g2)) != 0) { boot = 0; }
    if (boot == 1 && _run("build/ct_gen2", cast(*u8,&g3)) != 0) { boot = 0; }
    _check("gen1->gen2->gen3 build", boot);
    if (boot == 1) { _check("fixpoint (gen2 == gen3)", _files_equal("build/ct_gen2", "build/ct_gen3")); }

    // --- Toolchain: separate assembler + linker (manual pipeline) ---
    _p("\n--- Toolchain (as + ld) ---\n");
    let is [5]i64 as cc; cc[0]=cast(i64,"./caustic"); cc[1]=cast(i64,"-q"); cc[2]=cast(i64,"-c"); cc[3]=cast(i64,"tests/section_test.cst"); cc[4]=0;
    let is [3]i64 as aa; aa[0]=cast(i64,"./caustic-as"); aa[1]=cast(i64,"tests/section_test.cst.s"); aa[2]=0;
    let is [5]i64 as ld; ld[0]=cast(i64,"./caustic-ld"); ld[1]=cast(i64,"tests/section_test.cst.s.o"); ld[2]=cast(i64,"-o"); ld[3]=cast(i64,"build/ct_tc"); ld[4]=0;
    let is i32 as tc with mut = 1;
    if (_run("./caustic", cast(*u8,&cc)) != 0) { tc = 0; }
    if (tc == 1 && _run("./caustic-as", cast(*u8,&aa)) != 0) { tc = 0; }
    if (tc == 1 && _run("./caustic-ld", cast(*u8,&ld)) != 0) { tc = 0; }
    let is [2]i64 as rt; rt[0]=cast(i64,"build/ct_tc"); rt[1]=0;
    if (tc == 1 && _run("build/ct_tc", cast(*u8,&rt)) != 0) { tc = 0; }
    _check("caustic -c | caustic-as | caustic-ld", tc);

    // --- Summary ---
    _p("\n=== ");
    if (_fail == 0) { _p("ALL PASSED"); } else { _p("FAILED"); }
    _p(" === pass="); io.write_int(io.STDOUT, cast(i64, _pass));
    _p(" fail="); io.write_int(io.STDOUT, cast(i64, _fail)); _p("\n");
    if (_fail == 0) { return 0; }
    return 1;
}
