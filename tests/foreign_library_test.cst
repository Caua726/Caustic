// tests/foreign_library_test.cst - which foreign libraries a target's loader
// can open, as codegen asks before emitting an import.
//
// An ELF cannot load a DLL (any case: Windows names are case-insensitive) and
// a PE cannot load a shared object, versioned or not. A name is read only
// within its length: the compiler hands over slices of the source, so the
// bytes after a name are not a terminator. CSE carries both systems in one
// image and loads either.
//
// Exit code is the number of failures.
use "../std/io.cst" as io;
use "../src/codegen/target.cst" as tgt;

let is i32 as fails with mut = 0;

fn slen(s as *u8) as i32 {
    let is i32 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

// The first n bytes of s.
fn chk_n(target as *u8, s as *u8, n as i32, want as i32) as void {
    if (tgt.load_target(target, slen(target)) != 1) {
        fails = fails + 1;
        io.printf("  FAIL unknown target %s\n", target);
        return;
    }
    let is i32 as got = tgt.foreign_library_loadable(s, n);
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: '%s' (%d bytes) loadable=%d, want %d\n", target, s, cast(i64, n), cast(i64, got), cast(i64, want));
    }
}

fn chk(target as *u8, s as *u8, want as i32) as void { chk_n(target, s, slen(s), want); }

fn main() as i32 {
    // An ELF refuses a DLL, whatever its case, and nothing else.
    chk("linux-x86_64", "user32.dll", 0);
    chk("linux-x86_64", "USER32.DLL", 0);
    chk("linux-aarch64", "Kernel32.Dll", 0);
    chk("linux-x86_64", ".dll", 0);
    chk("linux-x86_64", "libc.so.6", 1);
    chk("linux-x86_64", "user32.dxl", 1);
    chk("linux-x86_64", "plugin.alx", 1);
    chk("linux-x86_64", "dll", 1);
    chk_n("linux-x86_64", "user32.dllX", 10, 0);
    chk_n("linux-x86_64", "user32.dllX", 9, 1);
    // A PE refuses a shared object: ".so" at the end or before a version,
    // wherever in the name that falls.
    chk("windows-x86_64", "libc.so.6", 0);
    chk("windows-x86_64", "libdl.so.2", 0);
    chk("windows-x86_64", "libdemo.so", 0);
    chk("windows-x86_64", "LIBDEMO.SO", 0);
    chk("windows-x86_64", "libX11.so.6.4", 0);
    chk("windows-x86_64", "user32.dll", 1);
    chk("windows-x86_64", "so", 1);
    chk("windows-x86_64", "libsodium.dll", 1);
    chk_n("windows-x86_64", "user32.dll.so.6", 10, 1);
    chk_n("windows-x86_64", "libdemo.sox", 10, 0);
    // One image for both systems loads either.
    chk("caustic-x86_64", "user32.dll", 1);
    chk("caustic-x86_64", "libc.so.6", 1);
    if (fails == 0) { io.printf("foreign libraries: all checks passed\n"); return 0; }
    io.printf("foreign libraries: %d failures\n", cast(i64, fails));
    return fails;
}
