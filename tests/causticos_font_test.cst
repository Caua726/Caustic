// tests/causticos_font_test.cst — std/causticos/font.cst, the console font.
//
// The map is binary-searched, so an unsorted or duplicated entry makes
// characters silently draw as U+FFFD; the glyph table is indexed by it, so an
// entry past the end reads someone else's memory. And the characters people
// type must have glyphs of their own — every Latin-1 letter and sign, which is
// what the keyboard layouts in CausticOS type, including the two the PSF
// lacks and gen-font.py draws (¬ ¦).
//
// Exit 0 = all passed; the exit code is the number of failures.
use "../std/io.cst" as io;
use "../std/causticos/font.cst" as font;

let is i32 as fails with mut = 0;

fn fail(name as *u8, v as i64) as void {
    fails = fails + 1;
    io.printf("  FAIL %s: %x\n", name, v);
}

fn main() as i32 {
    let is *u8 as m = font.MAP;
    let is i64 as prev with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < font.N_MAP) {
        let is i64 as cp = cast(i64, m[i * 4]) | (cast(i64, m[i * 4 + 1]) << 8);
        let is i64 as g = cast(i64, m[i * 4 + 2]) | (cast(i64, m[i * 4 + 3]) << 8);
        if (cp <= prev) { fail("map not strictly sorted at", cp); }
        if (g >= font.N_GLYPHS) { fail("glyph index past the table for", cp); }
        prev = cp;
        i = i + 1;
    }
    if (font.REPLACEMENT < 0 || font.REPLACEMENT >= font.N_GLYPHS) { fail("replacement glyph", font.REPLACEMENT); }

    let is i64 as c with mut = 0x20;
    while (c <= 0x7E) {
        if (font.has_glyph(c) == 0) { fail("no glyph for ASCII", c); }
        c = c + 1;
    }
    c = 0xA0;
    while (c <= 0xFF) {
        // U+00AD, the soft hyphen, marks where a word may break: it is never
        // drawn, so it needs no glyph.
        if (c != 0xAD && font.has_glyph(c) == 0) { fail("no glyph for Latin-1", c); }
        c = c + 1;
    }
    if (font.has_glyph(0x20A2) == 0) { fail("no glyph for the cruzeiro sign", 0x20A2); }
    if (font.has_glyph(0x20AC) == 0) { fail("no glyph for the euro sign", 0x20AC); }
    if (font.has_glyph(0x2500) == 0) { fail("no glyph for box drawing", 0x2500); }

    // What the font lacks draws the replacement, and nothing else does.
    if (cast(i64, font.glyph(0x4E00)) != cast(i64, font.glyph(0xFFFD))) { fail("a missing character", 0x4E00); }
    if (cast(i64, font.glyph(0xAC)) == cast(i64, font.glyph(0xFFFD))) { fail("not-sign draws the replacement", 0xAC); }
    if (cast(i64, font.glyph(0xA6)) == cast(i64, font.glyph(0xFFFD))) { fail("broken bar draws the replacement", 0xA6); }
    if (cast(i64, font.glyph(0xAC)) == cast(i64, font.glyph(0x2D))) { fail("not-sign is the hyphen", 0xAC); }

    if (fails == 0) { io.write_str(1, "causticos_font: ok\n"); }
    return fails;
}
