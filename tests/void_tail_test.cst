// tests/void_tail_test.cst
//
// A void function's call to itself, last on its path but with the return behind a
// join or a jump, runs as a loop at -O2. Each result must be the plain recursive
// one, and the parameters must read their new values on the next round.
//
// Exit code 0 on success, else the number of the failing check.

let is i64 as moves with mut = 0;
let is i64 as sum with mut = 0;
let is [8]i64 as seen with mut;

fn hanoi(a as i32, b as i32, k as i32) as void {
    if (k == 1) {
        seen[a] = seen[a] + 1;
        moves = moves + 1;
    } else {
        let is i32 as other = 6 - a - b;
        hanoi(a, other, k - 1);
        seen[b] = seen[b] + 1;
        moves = moves + 1;
        hanoi(other, b, k - 1);
    }
}

fn count_down(n as i64) as void {
    if (n > 0) {
        sum = sum + n;
        count_down(n - 1);
    }
}

fn swap_args(a as i64, b as i64, n as i64) as void {
    if (n == 0) {
        sum = a * 1000 + b;
    } else {
        swap_args(b, a, n - 1);
    }
}

fn two_ends(n as i64) as void {
    if (n % 2 == 0) {
        if (n > 0) { two_ends(n - 1); }
    } else {
        sum = sum + 1;
        two_ends(n - 1);
    }
}

fn main() as i32 {
    hanoi(1, 2, 10);
    if (moves != 1023) { return 1; }
    if (seen[1] + seen[2] + seen[3] != 1023) { return 2; }
    sum = 0;
    count_down(20000);
    if (sum != 200010000) { return 3; }
    swap_args(1, 2, 7);
    if (sum != 2001) { return 4; }
    swap_args(1, 2, 8);
    if (sum != 1002) { return 5; }
    sum = 0;
    two_ends(9);
    if (sum != 5) { return 6; }
    return 0;
}
