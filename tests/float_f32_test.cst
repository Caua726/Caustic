// IEEE binary32 operations must round before widening or the next operation.
use "../std/io.cst" as io;
let is i32 as fails with mut = 0;
let is f32 as global_third = cast(f32, 1.0) / cast(f32, 3.0);
let is f32 as global_up = 1.0000000894069671630859375;
let is f32 as global_tie_even = 1.000000059604644775390625;
let is f32 as global_tie_odd = 1.000000178813934326171875;
let is f32 as global_subnormal = 1.4012984643248170709e-45;
let is f32 as global_integer = cast(f32, 18014399583223809);
let is f32 as global_unsigned = cast(f32, cast(u64, 1) << 63);
let is f32 as global_cancel = (cast(f32, 16777216.0) + cast(f32, 1.0)) - cast(f32, 16777216.0);
fn raw32(bits as i64) as f32 { return *cast(*f32, &bits); }
fn bits32(value as f32) as i64 { return cast(i64, *cast(*u32, &value)); }
fn bits64(value as f64) as i64 { return *cast(*i64, &value); }
fn check(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("FAIL %s: got=%x want=%x\n", name, got, want);
    }
}
fn add_cancel(a as f32, b as f32) as f32 { return (a + b) - a; }
fn multiply_cancel(a as f32, b as f32) as f32 { return a * b - cast(f32, 1.0); }
fn divide_widen(a as f32, b as f32) as f64 { return cast(f64, a / b); }
fn multiply_widen(a as f32, b as f32) as f64 { return cast(f64, a * b); }
fn subtract_widen(a as f32, b as f32) as f64 { return cast(f64, a - b); }
fn integer_widen(a as i64) as f64 { return cast(f64, cast(f32, a)); }
fn unsigned_widen(a as u64) as f64 { return cast(f64, cast(f32, a)); }
fn sqrt_widen(a as f32) as f64 { return cast(f64, __builtin_sqrt(a)); }
fn mixed(a as f32, b as f64) as f64 { return a + b; }
fn double_third(a as f64, b as f64) as f64 { return a / b; }
fn pass32(a as f32) as f32 { return a; }
fn const_return() as f32 { return 1.0 / 3.0; }
fn widen_argument(value as f32) as f64 { return cast(f64, value); }
fn pressure(p as *f32) as f64 {
    let is f32 as a0 = p[0] / cast(f32, 3.0);
    let is f32 as a1 = p[1] / cast(f32, 3.0);
    let is f32 as a2 = p[2] / cast(f32, 3.0);
    let is f32 as a3 = p[3] / cast(f32, 3.0);
    let is f32 as a4 = p[4] / cast(f32, 3.0);
    let is f32 as a5 = p[5] / cast(f32, 3.0);
    let is f32 as a6 = p[6] / cast(f32, 3.0);
    let is f32 as a7 = p[7] / cast(f32, 3.0);
    let is f32 as a8 = p[8] / cast(f32, 3.0);
    let is f32 as a9 = p[9] / cast(f32, 3.0);
    let is f32 as a10 = p[10] / cast(f32, 3.0);
    let is f32 as a11 = p[11] / cast(f32, 3.0);
    let is f32 as a12 = p[12] / cast(f32, 3.0);
    let is f32 as a13 = p[13] / cast(f32, 3.0);
    let is f32 as a14 = p[14] / cast(f32, 3.0);
    let is f32 as a15 = p[15] / cast(f32, 3.0);
    let is f32 as a16 = p[16] / cast(f32, 3.0);
    let is f32 as a17 = p[17] / cast(f32, 3.0);
    let is f32 as a18 = p[18] / cast(f32, 3.0);
    let is f32 as a19 = p[19] / cast(f32, 3.0);
    return cast(f64, a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19);
}
fn main() as i32 {
    check("addition rounds before cancellation", bits32(add_cancel(raw32(0x4b800000), raw32(0x3f800000))), 0);
    check("multiplication rounds before cancellation", bits32(multiply_cancel(raw32(0x3f800003), raw32(0x3f800003))), 0x35400000);
    check("division is rounded before widening", bits64(divide_widen(raw32(0x3f800000), raw32(0x40400000))), 0x3fd5555560000000);
    check("underflow halfway rounds to even zero", bits64(divide_widen(raw32(1), raw32(0x40000000))), 0);
    check("subnormal halfway rounds to even significand", bits64(divide_widen(raw32(3), raw32(0x40000000))), bits64(cast(f64, raw32(2))));
    check("overflow is infinity before widening", bits64(multiply_widen(raw32(0x7f7fffff), raw32(0x40000000))), 0x7ff0000000000000);
    check("subtraction preserves negative zero", bits64(subtract_widen(raw32(0x80000000), raw32(0))), cast(i64, 1) << 63);
    check("integer conversion avoids double rounding", bits64(integer_widen(18014399583223809)), bits64(cast(f64, raw32(0x5a800001))));
    check("unsigned conversion covers the high bit", bits64(unsigned_widen(cast(u64, 1) << 63)), bits64(cast(f64, raw32(0x5f000000))));
    check("unsigned halfway keeps its sticky bit", bits64(unsigned_widen((cast(u64, 1) << 63) + (cast(u64, 1) << 39) + cast(u64, 1))), bits64(cast(f64, raw32(0x5f000001))));
    check("negative integer conversion avoids double rounding", bits64(integer_widen(0 - 18014399583223809)), bits64(cast(f64, raw32(0xda800001))));
    check("sqrt uses the operand precision", bits64(sqrt_widen(raw32(0x40000000))), bits64(cast(f64, raw32(0x3fb504f3))));
    check("mixed arithmetic widens rather than converting bits as an integer", bits64(mixed(raw32(0x3fc00000), 0.25)), bits64(1.75));
    check("f64 division retains its precision", bits64(double_third(1.0, 3.0)), 0x3fd5555555555555);
    check("global arithmetic uses floating values", bits32(global_third), 0x3eaaaaab);
    check("global literal rounds upward", bits32(global_up), 0x3f800001);
    check("global halfway rounds down to even", bits32(global_tie_even), 0x3f800000);
    check("global halfway rounds up to even", bits32(global_tie_odd), 0x3f800002);
    check("global literal preserves subnormals", bits32(global_subnormal), 1);
    check("global integer conversion avoids double rounding", bits32(global_integer), 0x5a800001);
    check("global unsigned conversion preserves the high bit", bits32(global_unsigned), 0x5f000000);
    check("constant arithmetic rounds at each f32 boundary", bits32(global_cancel), 0);
    check("implicit constant return rounds to its declared type", bits64(cast(f64, const_return())), 0x3fd5555560000000);
    check("implicit constant argument rounds before the call", bits64(widen_argument(1.0 / 3.0)), 0x3fd5555560000000);
    let is [20]f32 as live_values;
    let is i32 as index with mut = 0;
    while (index < 20) { live_values[index] = cast(f32, 1.0); index = index + 1; }
    check("twenty live rounded values survive spill and reload", bits64(pressure(&live_values[0])), 0x401aaaaae0000000);
    let is [3]f32 as memory;
    memory[0] = pass32(raw32(0x3eaaaaab));
    memory[1] = pass32(raw32(1));
    memory[2] = pass32(raw32(0x80000000));
    check("call return and reload preserve rounded quotient", bits32(memory[0]), 0x3eaaaaab);
    check("call return and reload preserve subnormal", bits32(memory[1]), 1);
    check("call return and reload preserve negative zero", bits32(memory[2]), 0x80000000);
    if (fails == 0) { io.write_str(io.STDOUT, "IEEE f32 precision matrix passed\n"); }
    return fails;
}
