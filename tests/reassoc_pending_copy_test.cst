// tests/reassoc_pending_copy_test.cst — a value whose reader is a pending copy.
//
// `in.buf[0] = 27` computes &in + 64, then + 0. Identity folding kills the
// `+ 0` and leaves the store reading it through copy_of until the copies are
// resolved. `in.buf[1]` reuses &in + 64 (+ 1). If reassociation counts uses
// before the copies are resolved, &in + 64 looks used once (by the + 1), gets
// folded into it and dies, and the store writes through an undefined register
// (it crashed). Exit 0 = the stores land and the reads see them.
struct S { a as [28]u8; head as i64; tail as i64; pad as [12]u8; skip as i32; z as i32; buf as [64]u8; }
fn chk(name as *u8, got as i64, want as i64) as i64 { if (got != want) { return 1; } return 0; }
fn poke(s as *S) as void { s.head = s.head + 0; }
fn main() as i32 {
    let is S as in with mut;
    in.head = 0;
    in.buf[0] = cast(u8, 27);
    in.head = 0;
    in.tail = 1;
    in.skip = 0;
    poke(&in);
    let is i64 as bad with mut = 0;
    bad = bad + chk("a", cast(i64, in.skip), 0);
    bad = bad + chk("b", in.head, 0);
    in.buf[0] = cast(u8, 27);
    in.buf[1] = cast(u8, 91);
    in.head = 0;
    in.tail = 2;
    in.skip = 0;
    poke(&in);
    bad = bad + chk("c", cast(i64, in.skip), 0);
    bad = bad + chk("d", cast(i64, in.buf[0]), 27);
    bad = bad + chk("e", cast(i64, in.buf[1]), 91);
    return cast(i32, bad);
}
