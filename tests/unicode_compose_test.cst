// tests/unicode_compose_test.cst — std/unicode/compose.cst, the pair step of NFC.
//
// The cases a terminal folding combining marks and a keyboard's dead keys
// depend on, the two shapes the table cannot hold (Hangul is arithmetic), and
// the one that a table built from decompositions alone gets wrong: a
// composition exclusion, which decomposes to a pair but must never be composed
// back. Exit 0 = all passed; the exit code is the number of failures.
use "../std/io.cst" as io;
use "../std/unicode/compose.cst" as c;

let is i32 as fails with mut = 0;

fn chk(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%x want=%x\n", name, got, want);
    }
}

fn main() as i32 {
    chk("e + acute", c.compose(0x65, 0x301), 0xE9);
    chk("a + tilde", c.compose(0x61, 0x303), 0xE3);
    chk("O + tilde", c.compose(0x4F, 0x303), 0xD5);
    chk("C + cedilla", c.compose(0x43, 0x327), 0xC7);
    chk("u + diaeresis", c.compose(0x75, 0x308), 0xFC);
    chk("A + ring", c.compose(0x41, 0x30A), 0xC5);
    // A composite composes further: e-circumflex + acute.
    chk("e-circumflex + acute", c.compose(0xEA, 0x301), 0x1EBF);
    chk("Greek alpha + tonos", c.compose(0x3B1, 0x301), 0x3AC);
    chk("Cyrillic ie + grave", c.compose(0x435, 0x300), 0x450);
    chk("no pair: e + e", c.compose(0x65, 0x65), 0);
    chk("no pair: q + acute", c.compose(0x71, 0x301), 0);
    chk("no pair: mark first", c.compose(0x301, 0x65), 0);
    // U+0958 decomposes to U+0915 U+093C and is excluded from composition.
    chk("exclusion: ka + nukta", c.compose(0x915, 0x93C), 0);
    chk("Hangul L + V", c.compose(0x1100, 0x1161), 0xAC00);
    chk("Hangul LV + T", c.compose(0xAC00, 0x11A8), 0xAC01);
    chk("Hangul LVT + T", c.compose(0xAC01, 0x11A8), 0);
    chk("non-BMP: musical half note", c.compose(0x1D157, 0x1D165), 0);
    chk("non-BMP: Kaithi", c.compose(0x11099, 0x110BA), 0x1109A);
    if (fails == 0) { io.write_str(1, "unicode_compose: ok\n"); }
    return fails;
}
