// tests/param_upper_half_test.cst
//
// An i32 parameter arrives in a 64-bit register whose upper half a C caller
// may leave undefined (System V). The callee must read it by its low 32 bits:
// a compare, an index or a copy that reads the register whole has to go
// through the cast that extends it. Each function is called through a
// pointer with i64 arguments whose upper halves are set.
//
// Exit code 0 on success, else the number of the failing check.

fn count_up(a as i32, b as i32) as i32 {
    let is i32 as i with mut = a;
    let is i32 as n with mut = 0;
    while (i < b) { i = i + 1; n = n + 1; }
    return n;
}

fn pick(p as *i32, lo as i32, hi as i32) as i32 {
    let is i32 as i with mut = lo;
    let is i32 as s with mut = 0;
    while (i <= hi) { s = s + p[i]; i = i + 1; }
    return s;
}

fn less(a as i32, b as i32) as i32 {
    if (a < b) { return 1; }
    return 0;
}

fn main() as i32 {
    let is [16]i32 as v;
    let is i32 as k with mut = 0;
    while (k < 16) { v[k] = k * k; k = k + 1; }
    let is i64 as hi7 = 30064771072;   // 7 << 32
    let is i64 as hi9 = 0 - 4294967296; // all upper bits set, low half 0

    let is *u8 as f1 = fn_ptr(count_up);
    let is i64 as r1 = call(f1, hi7 + 3, 10);
    if (r1 != 7) { return 1; }
    let is i64 as r2 = call(f1, 3, hi9 + 10);
    if (r2 != 7) { return 2; }

    let is *u8 as f2 = fn_ptr(pick);
    let is i64 as r3 = call(f2, &v[0], hi7 + 2, hi9 + 5);
    if (r3 != 4 + 9 + 16 + 25) { return 3; }

    let is *u8 as f3 = fn_ptr(less);
    let is i64 as r4 = call(f3, hi7 + 1, 2);
    if (r4 != 1) { return 4; }
    let is i64 as r5 = call(f3, hi9 + 5, hi7 + 2);
    if (r5 != 0) { return 5; }
    return 0;
}
