// tests/and_test_branch_test.cst
//
// At -O2 `if ((x & k) == 0)` and `!= 0` branch on one `test x, k`
// (emit_inst.cst, try_and_test), and a compare against a literal 0 folds the
// 0 into the instruction. Masks of every width the encoding takes: one bit,
// a high bit, a negative mask (sign-extended to 64 bits), the largest positive
// imm32, and an AND whose value is also used, which must not fuse. Then f64
// compares against 0.0, which now fold the same way.
//
// Exit code 0 on success, else the number of the failing check.

fn bits(x as i64) as i64 {
    let is i64 as r with mut = 0;
    if ((x & 1) == 0) { r = r + 1; }
    if ((x & 1024) != 0) { r = r + 10; }
    if ((x & (0 - 16)) == 0) { r = r + 100; }
    if ((x & 2147483647) != 0) { r = r + 1000; }
    let is i64 as m = x & 6;
    if (m == 0) { r = r + 10000; }
    return r + m * 100000;
}

fn fz(a as f64) as i64 {
    let is i64 as r with mut = 0;
    if (a == 0.0) { r = r + 1; }
    if (a != 0.0) { r = r + 2; }
    return r;
}

fn main() as i32 {
    if (bits(0) != 10101) { return 1; }
    if (bits(1) != 11100) { return 2; }
    if (bits(1024) != 11011) { return 3; }
    if (bits(0 - 1) != 601010) { return 4; }
    if (bits(4294967296) != 10001) { return 5; }
    if (bits(6) != 601101) { return 6; }
    if (bits(15) != 601100) { return 7; }
    if (fz(0.0) != 1) { return 8; }
    if (fz(0.0 - 0.0) != 1) { return 9; }
    if (fz(2.5) != 2) { return 10; }
    return 0;
}
