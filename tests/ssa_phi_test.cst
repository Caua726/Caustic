// tests/ssa_phi_test.cst
//
// Values that meet at joins, as the optimizer keeps them in SSA form: phis
// across loops and nested loops, phis that read each other (the swap and the
// rotation, where the copies at a predecessor form a cycle), a value that
// leaves a loop from the middle while its next value is already computed (the
// copy on the edge must not clobber it), several phis in one if/else, edges
// from a block with two successors into a join, and a function whose body is
// optimized again after a call in it is inlined.
//
// Exit code 0 on success, else the number of the failing check.

fn swap_loop(n as i64) as i64 {
    let is i64 as a with mut = 1;
    let is i64 as b with mut = 2;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as t = a;
        a = b;
        b = t;
        i = i + 1;
    }
    return a * 10 + b;
}

fn rotate3(n as i64) as i64 {
    let is i64 as a with mut = 1;
    let is i64 as b with mut = 2;
    let is i64 as c with mut = 3;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as t = a;
        a = b;
        b = c;
        c = t;
        i = i + 1;
    }
    return a * 100 + b * 10 + c;
}

fn fib(n as i64) as i64 {
    let is i64 as a with mut = 0;
    let is i64 as b with mut = 1;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return a;
}

// The value of x before the increment is still needed after the loop: the
// exit is taken after x already holds its next value.
fn exit_mid(n as i64) as i64 {
    let is i64 as x with mut = 0;
    let is i64 as y with mut = 0;
    while (1 == 1) {
        y = x;
        x = x + 1;
        if (x > n) { break; }
    }
    return y * 100 + x;
}

// A break from inside the body: the exit block joins the loop test's edge and
// the break's edge, and the first comes from a block with two successors.
fn break_join(n as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        s = s + i;
        if (s > 50) { s = 0 - s; break; }
        i = i + 1;
    }
    return s * 1000 + i;
}

fn nested(n as i64) as i64 {
    let is i64 as total with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as row with mut = i;
        let is i64 as j with mut = 0;
        while (j < i) {
            row = row * 3 + j;
            if (row > 100000) { row = row % 997; }
            j = j + 1;
        }
        total = total + row;
        i = i + 1;
    }
    return total;
}

// Two values set together in one arm, left alone in the other.
fn two_phis(sz as i32) as i32 {
    let is i32 as w with mut = 0;
    let is i32 as need with mut = 0;
    if (sz == 64) { w = 1; need = 1; }
    return w * 10 + need;
}

fn three_phis(k as i32) as i32 {
    let is i32 as a with mut = 1;
    let is i32 as b with mut = 2;
    let is i32 as c with mut = 3;
    if (k > 0) { a = 4; b = 5; c = 6; } else { c = 7; a = 8; }
    return a * 100 + b * 10 + c;
}

// A do-while whose test reads the value from before the update.
fn old_value_test(n as i64) as i64 {
    let is i64 as x with mut = n;
    let is i64 as steps with mut = 0;
    let is i64 as old with mut = 0;
    while (1 == 1) {
        old = x;
        x = x - 1;
        steps = steps + 1;
        if (old == 0) { break; }
    }
    return steps * 1000 + x + 500;
}

fn add3(a as i64, b as i64, c as i64) as i64 { return a + b * 2 + c * 3; }

// The calls get inlined at -O1/-O2 and the loop is optimized again with the
// copies of the first round still in it.
fn after_inline(n as i64) as i64 {
    let is i64 as acc with mut = 0;
    let is i64 as p with mut = 1;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as q = p;
        p = add3(acc, p, i);
        acc = q;
        i = i + 1;
    }
    return acc + p;
}

// --- constants through phis and branches (SCCP) ---

// k is 5 on every path that reaches the test, so the else arm is dead, but
// only once the loop's phi for k is known to merge 5 with 5.
fn const_through_loop(n as i64) as i64 {
    let is i64 as k with mut = 5;
    let is i64 as r with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (k > 3) { r = r + k; } else { r = r - 1000; k = 9; }
        k = 5;
        i = i + 1;
    }
    return r;
}

// The phi at the join of a dead arm and a live one: its argument from the
// dead arm must go with the arm.
fn dead_arm_phi(x as i64) as i64 {
    let is i64 as m with mut = 2;
    let is i64 as v with mut = x;
    if (m * 3 == 7) { v = 999; m = 0; } else { v = v + m; }
    return v * 10 + m;
}

// Unsigned shift and compare of constants: the logical shift and the
// unsigned order, not the signed ones.
fn unsigned_fold() as i64 {
    let is u64 as big = cast(u64, 0) - cast(u64, 16);
    let is u64 as sh = big >> cast(u64, 60);
    let is i64 as r with mut = cast(i64, sh);
    if (big > cast(u64, 5)) { r = r + 100; }
    let is u8 as b = cast(u8, 250);
    let is u8 as b2 = b + cast(u8, 10);
    r = r + cast(i64, b2) * 1000;
    let is i32 as w = 2147483647;
    let is i32 as w2 = w + 1;
    if (w2 < 0) { r = r + 1000000; }
    return r;
}

// Code after a loop that never exits, and a block nothing jumps to.
fn unreachable_tail(x as i64) as i64 {
    let is i64 as y with mut = x;
    if (0 == 1) {
        y = 7;
        while (y > 0) { y = y - 1; }
    }
    return y + 1;
}

fn main() as i32 {
    if (swap_loop(0) != 12) { return 1; }
    if (swap_loop(3) != 21) { return 2; }
    if (swap_loop(4) != 12) { return 3; }
    if (rotate3(1) != 231) { return 4; }
    if (rotate3(2) != 312) { return 5; }
    if (rotate3(3) != 123) { return 6; }
    if (fib(10) != 55) { return 7; }
    if (fib(50) != 12586269025) { return 8; }
    if (exit_mid(5) != 506) { return 9; }
    if (exit_mid(0) != 1) { return 10; }
    if (break_join(5) != 10005) { return 11; }
    if (break_join(20) != 0 - 54990) { return 12; }
    if (nested(6) != 1723) { return 13; }
    if (two_phis(64) != 11) { return 14; }
    if (two_phis(32) != 0) { return 15; }
    if (three_phis(1) != 456) { return 16; }
    if (three_phis(0) != 827) { return 17; }
    if (old_value_test(3) != 4499) { return 18; }
    if (after_inline(6) != 578) { return 19; }
    if (const_through_loop(4) != 20) { return 20; }
    if (dead_arm_phi(3) != 52) { return 21; }
    if (unsigned_fold() != 1004115) { return 22; }
    if (unreachable_tail(41) != 42) { return 23; }
    return 0;
}
