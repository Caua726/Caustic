// tests/cond_branch_test.cst
//
// Conditions with && and || branch without first becoming a 0 or 1: every
// statement that takes a condition, the order and short-circuit of what the
// operands do, nesting both ways, a condition's value kept in a variable, and
// the range test the front end folds into one compare.
//
// Exit code 0 on success, else the number of the failing check.

let is i32 as log with mut = 0;

// Records that it ran, in order, and returns v.
fn t(id as i32, v as i32) as i32 {
    log = log * 10 + id;
    return v;
}

fn check_if(a as i32, b as i32, c as i32) as i32 {
    if ((t(1, a) != 0 && t(2, b) != 0) || t(3, c) != 0) { return 1; }
    return 0;
}

fn check_if2(a as i32, b as i32, c as i32) as i32 {
    if ((t(1, a) != 0 || t(2, b) != 0) && t(3, c) != 0) { return 1; } else { return 0; }
}

fn range(x as i32) as i32 {
    if (x >= 10 && x <= 20) { return 1; }
    return 0;
}

fn range_or(x as i32, y as i32) as i32 {
    if ((x >= 10 && x <= 20) || y == 5) { return 1; }
    return 0;
}

fn count_while(n as i32, stop as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < n && i != stop) { i = i + 1; }
    return i;
}

fn count_or(n as i32, m as i32) as i32 {
    let is i32 as i with mut = 0;
    while (i < n || i < m) { i = i + 1; }
    return i;
}

fn count_do(n as i32, m as i32) as i32 {
    let is i32 as i with mut = 0;
    do { i = i + 1; } while (i < n && i < m);
    return i;
}

fn count_do_or(n as i32, m as i32) as i32 {
    let is i32 as i with mut = 0;
    do { i = i + 1; } while (i < n || i < m);
    return i;
}

fn count_for(n as i32, stop as i32) as i32 {
    let is i32 as s with mut = 0;
    let is i32 as i with mut = 0;
    for (i = 0; i < n && s != stop; i = i + 1) { s = s + 2; }
    return s;
}

// The value of a condition, read as a number and as a condition.
fn kept(a as i32, b as i32) as i32 {
    let is bool as v = a != 0 && b != 0;
    let is bool as w = a != 0 || b != 0;
    let is i32 as r with mut = 0;
    if (v) { r = r + 1; }
    if (w) { r = r + 2; }
    return r;
}

// A store on one side of the condition, and a pointer tested before its use.
fn deref(p as *i32) as i32 {
    if (cast(i64, p) != 0 && p[0] > 3) { return p[0]; }
    return 0 - 1;
}

fn floats(x as f64, y as f64) as i32 {
    if (x < y && y < 10.0) { return 1; }
    if (x > y || x != x) { return 2; }
    return 3;
}

fn main() as i32 {
    log = 0; if (check_if(1, 1, 0) != 1 || log != 12) { return 1; }
    log = 0; if (check_if(1, 0, 1) != 1 || log != 123) { return 2; }
    log = 0; if (check_if(0, 1, 0) != 0 || log != 13) { return 3; }
    log = 0; if (check_if(0, 0, 1) != 1 || log != 13) { return 4; }
    log = 0; if (check_if2(1, 0, 1) != 1 || log != 13) { return 5; }
    log = 0; if (check_if2(0, 1, 0) != 0 || log != 123) { return 6; }
    log = 0; if (check_if2(0, 0, 1) != 0 || log != 12) { return 7; }
    if (range(9) != 0 || range(10) != 1 || range(20) != 1 || range(21) != 0) { return 8; }
    if (range_or(15, 0) != 1 || range_or(9, 5) != 1 || range_or(9, 4) != 0) { return 9; }
    if (count_while(10, 100) != 10 || count_while(10, 4) != 4 || count_while(0, 4) != 0) { return 10; }
    if (count_or(3, 7) != 7 || count_or(7, 3) != 7 || count_or(0, 0) != 0) { return 11; }
    if (count_do(5, 3) != 3 || count_do(0, 0) != 1) { return 12; }
    if (count_do_or(5, 3) != 5 || count_do_or(0, 0) != 1) { return 13; }
    if (count_for(10, 100) != 20 || count_for(10, 6) != 6) { return 14; }
    if (kept(1, 1) != 3 || kept(1, 0) != 2 || kept(0, 1) != 2 || kept(0, 0) != 0) { return 15; }
    let is i32 as four = 4;
    let is i32 as two = 2;
    if (deref(cast(*i32, 0)) != 0 - 1 || deref(&four) != 4 || deref(&two) != 0 - 1) { return 16; }
    let is f64 as nan = 0.0 / 0.0;
    if (floats(1.0, 2.0) != 1 || floats(3.0, 2.0) != 2 || floats(1.0, 20.0) != 3) { return 17; }
    if (floats(nan, 2.0) != 2 || floats(2.0, nan) != 3) { return 18; }
    return 0;
}
