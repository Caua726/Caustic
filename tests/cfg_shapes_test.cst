// tests/cfg_shapes_test.cst — control-flow shapes the one-pass CFG builder
// and the optimizer passes must treat identically: nested loops, break,
// continue, early return, dead code after return, if/else chains, match, and
// a loop whose body is a single continue. Two independent formulations of the
// same computation must agree, so a block-boundary or successor mistake shows
// up as a wrong number rather than as a silent same-mode agreement.
// Exit code = number of failures (0 means pass).
use "../std/io.cst" as io;

let is i32 as fails with mut = 0;

fn cases_while(n as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        if ((i % 7) == 0) { i = i + 1; continue; }
        let is i64 as j with mut = 0;
        while (j < 5) {
            if (j == 3) { break; }
            if (j == 1) { j = j + 1; continue; }
            s = s + i * j;
            j = j + 1;
        }
        if ((i % 11) == 0) { s = s - 1; }
        else if ((i % 13) == 0) { s = s + 2; }
        else { s = s + 1; }
        i = i + 1;
    }
    return s;
}

// Same result, different control flow: the inner loop expressed with a
// condition-only while and no continue, the parity tests as nested ifs.
fn cases_alt(n as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        if ((i % 7) != 0) {
            let is i64 as j with mut = 0;
            while (j < 3) {
                if (j != 1) { s = s + i * j; }
                j = j + 1;
            }
            let is i64 as m11 = i % 11;
            let is i64 as m13 = i % 13;
            if (m11 == 0) { s = s - 1; }
            else if (m13 == 0) { s = s + 2; }
            else { s = s + 1; }
        }
        i = i + 1;
    }
    return s;
}

enum Kind { A; B; C; D; E; }

fn match_shape(k as Kind) as i64 {
    let is i64 as r with mut = 0;
    match Kind (k) {
        case A { r = 10; }
        case B { r = 20; }
        case C { r = 30; }
        case D { r = 40; }
        case E { r = 50; }
        else { r = 0; }
    }
    return r;
}

fn early(x as i64) as i64 {
    if (x < 0) { return 0 - 1; }
    if (x == 0) { return 0; }
    return x * 2;
}

fn after_return(x as i64) as i64 {
    if (x > 0) {
        return 7;
        // Unreachable tail: the block after the return must not be taken.
        let is i64 as dead = 99;
        return dead;
    }
    return 8;
}

fn empty_loop_continue(n as i64) as i64 {
    let is i64 as i with mut = 0;
    let is i64 as hits with mut = 0;
    while (i < n) {
        i = i + 1;
        continue;
    }
    hits = i;
    return hits;
}

fn main() as i32 {
    let is i64 as a = cases_while(2000);
    let is i64 as b = cases_alt(2000);
    if (a != b) { fails = fails + 1; io.printf("FAIL cases %d != %d\n", a, b); }

    let is i64 as m = match_shape(Kind.A) + match_shape(Kind.B) + match_shape(Kind.C)
                    + match_shape(Kind.D) + match_shape(Kind.E);
    if (m != 150) { fails = fails + 1; io.printf("FAIL match %d\n", m); }

    if (early(0 - 5) != 0 - 1) { fails = fails + 1; io.printf("FAIL early neg\n"); }
    if (early(0) != 0) { fails = fails + 1; io.printf("FAIL early zero\n"); }
    if (early(7) != 14) { fails = fails + 1; io.printf("FAIL early pos\n"); }
    if (after_return(1) != 7) { fails = fails + 1; io.printf("FAIL after_return pos\n"); }
    if (after_return(0 - 1) != 8) { fails = fails + 1; io.printf("FAIL after_return neg\n"); }
    if (empty_loop_continue(1234) != 1234) { fails = fails + 1; io.printf("FAIL empty loop\n"); }

    io.printf("cfg shapes failures=%d\n", fails);
    return fails;
}
