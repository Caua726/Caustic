use "../std/io.cst" as io;
let is i64 as value with imut = 7;

fn scoped_sum(value as i64) as i64 {
    let is i64 as sum with mut = value;
    {
        let is i64 as value = 31;
        sum = sum + value;
        {
            let is i64 as value = 47;
            sum = sum + value;
        }
        if (value != 31) { return -1; }
    }
    {
        let is i64 as value = 53;
        sum = sum + value;
    }
    if (value != 11) { return -2; }
    return sum;
}

fn main() as i32 {
    if (value != 7 || scoped_sum(11) != 142) { return 1; }
    io.printf("scope shadowing: sum=%d global=%d\n", scoped_sum(11), value);
    return 0;
}
