// A function with more basic blocks than the CFG array had slots.
//
// build_cfg bounded only the *initialisation* of its block array (a fixed
// MAX_BLOCKS = 4096) while nblocks came out as cur_block + 1, so the
// successor pass indexed past the end — for the old compiler this function
// dies of SIGSEGV at -O1/-O2, where the CFG passes run. Each `if` below is
// its own branch (JZ, body, label): 2500 of them are ~7500 blocks, well
// past 4096. The condition reads a mutable global rather than a literal so
// the branches survive const-folding and actually exist by the time the
// CFG is built; z stays 0, so x must stay 0.
let is i32 as z with mut = 0;

