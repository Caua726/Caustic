// tests/causticos_term_golden_test.cst — std/causticos/term.cst's output, pinned.
//
// The same pseudo-random bytes (ASCII, tabs, wrapping lines, colours, wide
// CJK, combining marks, box drawing, an emoji past the BMP, erases, cursor
// moves, the alternate screen, scrollback and resizes, chunks split mid-UTF-8)
// go into a pixel Term (init_buffer) and a TEXT Term (init_text), each with a
// grid and wrap flags. One FNV-1a hash covers every dirty rect taken, the final
// pixels, both grids, the wrap flags, cursors and counters.
//
// GOLDEN is what term.cst produced before its fast paths (TEXT mode skipping
// pixel work, row-wise glyph writes, ring indexing without division, the ASCII
// width and glyph lookups, the four-word scroll copy): they must change
// nothing a holder can see. A deliberate change to rendering updates GOLDEN.
// Exit 0 = same output.
use "../std/causticos/term.cst" as term;
use "../std/io.cst" as io;
use "../std/mem.cst" as mem;

let is i64 as GOLDEN with imut = 0xfa5a8d2ec4212c01;

let is i64 as H with mut = 0;
fn hv(v as i64) as void {
    let is i64 as i with mut = 0;
    while (i < 8) { H = (H ^ ((v >> (i * 8)) & 255)) * 1099511628211; i = i + 1; }
}

let is i64 as S with mut = 88172645463325252;
fn rnd() as i64 { S = S ^ (S << 13); S = S ^ ((S >> 7) & 144115188075855871); S = S ^ (S << 17); return S & 9223372036854775807; }

let is [8192]u8 as buf with mut;
let is i64 as bl with mut = 0;
fn put(s as *u8) as void { let is i64 as i with mut = 0; while (s[i] != 0) { buf[bl] = s[i]; bl = bl + 1; i = i + 1; } }
fn putb(b as i64) as void { buf[bl] = cast(u8, b); bl = bl + 1; }

// One chunk of mixed content.
fn chunk() as void {
    bl = 0;
    while (bl < 7000) {
        let is i64 as k = rnd() % 40;
        if (k < 22) {
            let is i64 as n = rnd() % 70;
            let is i64 as i with mut = 0;
            while (i < n) { putb(32 + rnd() % 95); i = i + 1; }
        } else if (k < 26) { put("\n"); }
        else if (k < 27) { put("\t"); }
        else if (k < 29) { put("\x1b[3"); putb(48 + rnd() % 8); put("m"); }
        else if (k < 30) { put("\x1b[0m"); }
        else if (k < 31) { put("\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e"); }        // 日本語 (wide)
        else if (k < 32) { put("e\xcc\x81a\xcc\x80"); }                         // e + U+0301, a + U+0300
        else if (k < 33) { put("\xce\xb1\xce\xb2\xd0\x96\xe2\x94\x80\xe2\x94\x82"); } // αβЖ─│
        else if (k < 34) { put("\x1b[K"); }
        else if (k < 35) { put("\x1b["); putb(49 + rnd() % 9); put(";"); putb(49 + rnd() % 9); put("H"); }
        else if (k < 36) { put("\r"); }
        else if (k < 37) { put("\x1b[1J"); }
        else if (k < 38) { put("\xf0\x9f\x98\x80"); }                            // emoji, outside the BMP
        else { put("\x08"); }
    }
}

let is [4096]i64 as cells_a with mut;
let is [4096]i64 as cells_b with mut;
let is [64]u8 as wr_a with mut;
let is [64]u8 as wr_b with mut;

fn take(t as *term.Term) as void {
    let is [4]i64 as d;
    if (term.take_dirty(t, cast(*i64, &d)) == 1) { hv(d[0]); hv(d[1]); hv(d[2]); hv(d[3]); } else { hv(0 - 1); }
}

// One round of the workload on t (sized w x h in pixels).
fn step(t as *term.Term, r as i64, cut as i64, w as i64, h as i64) as void {
    term.puts(t, cast(*u8, &buf[0]), cut);
    term.puts(t, cast(*u8, cast(i64, &buf[0]) + cut), bl - cut);
    if (r % 7 == 3) { term.scroll_view(t, 5); }
    if (r % 7 == 4) { term.scroll_view(t, 0 - 2); }
    if (r % 11 == 5) { term.alt_enter(t); term.puts(t, "alt\n", 4); term.alt_leave(t); }
    if (r % 13 == 6) { term.resize(t, w - 80, h - 64); term.puts(t, "small\n", 6); term.resize(t, w, h); }
    term.flush(t);
    take(t);
}

fn main(argc as i32, argv as *u8) as i32 {
    let is i64 as rounds with mut = 60;
    if (argc > 1) { rounds = 600; }
    let is i64 as da with mut = 1;
    let is i64 as db with mut = 1;
    if (argc == 4) { da = 0; }
    if (argc == 5) { db = 0; }
    let is i64 as w = 2 * 12 + 79 * 8;
    let is i64 as h = 2 * 12 + 30 * 16;
    let is *u8 as px = mem.core.mmap_anon(w * h * 4);
    let is term.Term as a = term.init_buffer(px, w, h, w * 4, 4);
    term.attach_grid(&a, cast(*i64, &cells_a[0]), 80, 50);
    term.attach_wraps(&a, cast(*u8, &wr_a[0]), 50);
    let is term.Term as b = term.init_text(79 * 8, 30 * 16);
    term.attach_grid(&b, cast(*i64, &cells_b[0]), 80, 50);
    term.attach_wraps(&b, cast(*u8, &wr_b[0]), 50);
    take(&a); take(&b);
    let is i64 as r with mut = 0;
    while (r < rounds) {
        chunk();
        let is i64 as cut = 1 + rnd() % (bl - 1);
        if (da == 1) { step(&a, r, cut, w, h); }
        if (db == 1) { step(&b, r, cut, 79 * 8, 30 * 16); }
        r = r + 1;
    }
    let is *u32 as p = cast(*u32, px);
    let is i64 as i with mut = 0;
    while (i < w * h) { hv(cast(i64, p[i])); i = i + 1; }
    i = 0;
    while (i < 4000) { hv(cells_a[i]); hv(cells_b[i]); i = i + 1; }
    i = 0;
    while (i < 50) { hv(cast(i64, wr_a[i])); hv(cast(i64, wr_b[i])); i = i + 1; }
    hv(a.cx); hv(a.cy); hv(a.scrolled); hv(b.cx); hv(b.cy); hv(b.scrolled); hv(a.live_top); hv(b.live_top);
    if (rounds == 60 && H != GOLDEN) {
        io.printf("causticos_term_golden: hash %x, want %x\n", H, GOLDEN);
        return 1;
    }
    if (argc > 1) { io.printf("%x\n", H); }
    return 0;
}
