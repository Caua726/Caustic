// tests/vec_early_exit_test.cst
//
// A loop the vectorizer recognizes, with a way out besides its test: the vector
// path runs whole strides, so it must leave such a loop alone. The byte count
// did not: `if (p == i) { return k; }` ahead of `if (s[k] == 10) { p = p + 1; }`
// was counted to the end, and the return never seen. n is past every stride.
//
// Exit code 0 on success, else the number of the failing check.

let is [256]u8 as text with mut;
let is [256]i64 as words with mut;
let is [256]i64 as out with mut;
let is [256]u8 as bytes with mut;

// The offset the line starts at: the shape that went wrong.
fn line_start(s as *u8, n as i64, i as i64) as i64 with noinline {
    let is i64 as p with mut = 0;
    let is i64 as k with mut = 0;
    while (k < n) {
        if (p == i) { return k; }
        if (cast(i64, s[k]) == 10) { p = p + 1; }
        k = k + 1;
    }
    return n;
}

// The same, leaving by break.
fn line_break(s as *u8, n as i64, i as i64) as i64 with noinline {
    let is i64 as p with mut = 0;
    let is i64 as k with mut = 0;
    while (k < n) {
        if (p == i) { break; }
        if (cast(i64, s[k]) == 10) { p = p + 1; }
        k = k + 1;
    }
    return k;
}

// Out on the index, the count not read: what it had counted by then.
fn count_to(s as *u8, n as i64, stop as i64) as i64 with noinline {
    let is i64 as p with mut = 0;
    let is i64 as k with mut = 0;
    while (k < n) {
        if (k == stop) { return p; }
        if (cast(i64, s[k]) == 10) { p = p + 1; }
        k = k + 1;
    }
    return 0 - 1;
}

// A sum, out when it passes a limit.
fn sum_until(a as *i64, n as i64, limit as i64) as i64 with noinline {
    let is i64 as t with mut = 0;
    let is i64 as k with mut = 0;
    while (k < n) {
        if (t > limit) { return k; }
        t = t + a[k];
        k = k + 1;
    }
    return n;
}

// A sum, out on the index.
fn sum_to(a as *i64, n as i64, stop as i64) as i64 with noinline {
    let is i64 as t with mut = 0;
    let is i64 as k with mut = 0;
    while (k < n) {
        if (k == stop) { return t; }
        t = t + a[k];
        k = k + 1;
    }
    return 0 - 1;
}

// A fill, out on the index: nothing past it written.
fn fill_to(p as *u8, n as i64, stop as i64) as void with noinline {
    let is i64 as k with mut = 0;
    while (k < n) {
        if (k == stop) { return; }
        p[k] = cast(u8, 7);
        k = k + 1;
    }
}

// A map, out on the index: nothing past it written.
fn map_to(d as *i64, a as *i64, n as i64, stop as i64) as void with noinline {
    let is i64 as k with mut = 0;
    while (k < n) {
        if (k == stop) { return; }
        d[k] = a[k] * 3 + 1;
        k = k + 1;
    }
}

fn main() as i32 {
    let is i64 as j with mut = 0;
    while (j < 256) {
        text[j] = cast(u8, 97);
        if (j % 8 == 7) { text[j] = cast(u8, 10); }
        words[j] = 2;
        out[j] = 0 - 1;
        bytes[j] = cast(u8, 1);
        j = j + 1;
    }
    let is *u8 as s = cast(*u8, &text);
    if (line_start(s, 256, 2) != 16) { return 1; }
    if (line_start(s, 256, 9) != 72) { return 2; }
    if (line_start(s, 256, 500) != 256) { return 3; }
    if (line_break(s, 256, 2) != 16) { return 4; }
    if (line_break(s, 256, 500) != 256) { return 5; }
    if (count_to(s, 256, 100) != 12) { return 6; }
    if (count_to(s, 256, 500) != 0 - 1) { return 7; }
    if (sum_until(cast(*i64, &words), 256, 100) != 51) { return 8; }
    if (sum_to(cast(*i64, &words), 256, 100) != 200) { return 9; }
    fill_to(cast(*u8, &bytes), 256, 100);
    if (cast(i64, bytes[99]) != 7 || cast(i64, bytes[100]) != 1) { return 10; }
    map_to(cast(*i64, &out), cast(*i64, &words), 256, 100);
    if (out[99] != 7 || out[100] != 0 - 1) { return 11; }
    return 0;
}
