// A generic body is checked in the module that wrote it, while its type
// argument comes from the caller (here a struct the library never saw).
use "generic_context/lib.cst" as lib;

struct Point { x as i32; y as i64; }

fn main() as i32 {
    let is Point as p with mut;
    p.x = 3; p.y = 40;
    let is lib.Box gen Point as b with mut = lib.box_of gen Point (p);
    if (b.n != 6) { return 1; }
    let is Point as q = b.get();
    if (q.x != 3 || q.y != 40) { return 2; }
    let is lib.Box gen i64 as c with mut = lib.box_of gen i64 (9);
    if (c.n != 8 || c.get() != 9) { return 3; }
    if (lib.count() != 4) { return 4; }
    return 0;
}
