// printf formatting against glibc: floats are the exact binary value rounded
// to nearest/even, ints and strings take C flags, width and precision. The
// expected strings were produced by glibc printf. Exit 0 = all pass, else the
// number of failing checks (capped at 255); each failure is named on stderr.
use "../std/io.cst" as io;

let is i64 as fail with mut = 0;

fn fb(bits as i64) as f64 { return *cast(*f64, &bits); }

fn ck(id as i64, n as i64, got as *u8, want as *u8) as void {
    let is i64 as k with mut = 0;
    while (want[k] != 0 && got[k] == want[k]) { k = k + 1; }
    if (want[k] == 0 && got[k] == 0 && n == k) { return; }
    fail = fail + 1;
    io.fdprintf(io.STDERR, "FAIL %ld: got [%s] want [%s]\n", id, got, want);
}

fn group1(b as *u8) as void {
    ck(1, io.sprintf(b, 2048, "%f", fb(0x0000000000000000)), b, "0.000000");
    ck(2, io.sprintf(b, 2048, "%f", fb(0x8000000000000000)), b, "-0.000000");
    ck(3, io.sprintf(b, 2048, "%f", fb(0x3ff0000000000000)), b, "1.000000");
