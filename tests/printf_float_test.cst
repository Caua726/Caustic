}

fn main() as i32 {
    let is [2048]u8 as buf;
    let is *u8 as b = cast(*u8, &buf);
    group1(b);
    group2(b);
    group3(b);
    group4(b);
    group5(b);
    group6(b);
    group7(b);
    group8(b);
    group9(b);
    group10(b);
    group_round(b);
    if (fail > 255) { fail = 255; }
    if (fail != 0) { return cast(i32, fail); }
    return 0;
}
