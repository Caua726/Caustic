// tests/many_sections_test.cst — forty globals, each in its own custom section.
//
// Thirty-two was a ceiling everywhere a custom section passed through, and
// past it nothing failed: caustic-as filed the 33rd section's bytes under
// .data, its output writers indexed [32] stack arrays past their end, and
// caustic-ld handed the 33rd distinct name back index 0 — appending its bytes
// to the first custom section. Each global must still read back its own value.
let is i64 as v1 with mut with section(".cs1") = 1;
let is i64 as v2 with mut with section(".cs2") = 2;
let is i64 as v3 with mut with section(".cs3") = 3;
let is i64 as v4 with mut with section(".cs4") = 4;
let is i64 as v5 with mut with section(".cs5") = 5;
let is i64 as v6 with mut with section(".cs6") = 6;
let is i64 as v7 with mut with section(".cs7") = 7;
let is i64 as v8 with mut with section(".cs8") = 8;
let is i64 as v9 with mut with section(".cs9") = 9;
let is i64 as v10 with mut with section(".cs10") = 10;
let is i64 as v11 with mut with section(".cs11") = 11;
let is i64 as v12 with mut with section(".cs12") = 12;
let is i64 as v13 with mut with section(".cs13") = 13;
let is i64 as v14 with mut with section(".cs14") = 14;
let is i64 as v15 with mut with section(".cs15") = 15;
let is i64 as v16 with mut with section(".cs16") = 16;
let is i64 as v17 with mut with section(".cs17") = 17;
let is i64 as v18 with mut with section(".cs18") = 18;
let is i64 as v19 with mut with section(".cs19") = 19;
let is i64 as v20 with mut with section(".cs20") = 20;
let is i64 as v21 with mut with section(".cs21") = 21;
let is i64 as v22 with mut with section(".cs22") = 22;
let is i64 as v23 with mut with section(".cs23") = 23;
let is i64 as v24 with mut with section(".cs24") = 24;
let is i64 as v25 with mut with section(".cs25") = 25;
let is i64 as v26 with mut with section(".cs26") = 26;
let is i64 as v27 with mut with section(".cs27") = 27;
let is i64 as v28 with mut with section(".cs28") = 28;
let is i64 as v29 with mut with section(".cs29") = 29;
let is i64 as v30 with mut with section(".cs30") = 30;
let is i64 as v31 with mut with section(".cs31") = 31;
let is i64 as v32 with mut with section(".cs32") = 32;
let is i64 as v33 with mut with section(".cs33") = 33;
let is i64 as v34 with mut with section(".cs34") = 34;
let is i64 as v35 with mut with section(".cs35") = 35;
let is i64 as v36 with mut with section(".cs36") = 36;
let is i64 as v37 with mut with section(".cs37") = 37;
let is i64 as v38 with mut with section(".cs38") = 38;
let is i64 as v39 with mut with section(".cs39") = 39;
let is i64 as v40 with mut with section(".cs40") = 40;
fn main() as i32 {
    let is i64 as s with mut = 0;
    s = s + v1;
    s = s + v2;
    s = s + v3;
    s = s + v4;
    s = s + v5;
    s = s + v6;
    s = s + v7;
    s = s + v8;
    s = s + v9;
    s = s + v10;
    s = s + v11;
    s = s + v12;
    s = s + v13;
    s = s + v14;
    s = s + v15;
    s = s + v16;
    s = s + v17;
    s = s + v18;
    s = s + v19;
    s = s + v20;
    s = s + v21;
    s = s + v22;
    s = s + v23;
    s = s + v24;
    s = s + v25;
    s = s + v26;
    s = s + v27;
    s = s + v28;
    s = s + v29;
    s = s + v30;
    s = s + v31;
    s = s + v32;
    s = s + v33;
    s = s + v34;
    s = s + v35;
    s = s + v36;
    s = s + v37;
    s = s + v38;
    s = s + v39;
    s = s + v40;
    if (s != 820) { return 1; }
    return 0;
}
