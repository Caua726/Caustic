// tests/stack_args_opt.cst
//
// A call with stack arguments adjusts the stack through an IR_ASM of its own,
// which is no inline asm: the rest of the function is still optimized. Locals
// reached through inlined pointer helpers, struct fields, a pair of f64 stores
// and a local whose address does escape, all around calls of 7 and 8 arguments.
//
// Exit code 0 on success, else the number of the failing check.

struct Pair { a as i64; b as i64; }

fn add_to(sum as *i64, v as *i64) as void { *sum = *sum + *v; }
fn add_f(sum as *f32, v as *f32) as void { *sum = *sum + *v; }
fn seven(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64, g as i64) as i64 {
    return a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g;
}
fn eight(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64, g as i64, h as i64) as i64 {
    return seven(a, b, c, d, e, f, g) + 8 * h;
}
fn poke(p as *i64) as void { *p = *p + 100; }

fn through_pointers(n as i64) as i64 {
    let is i64 as total with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is i64 as x with mut = i * 2;
        add_to(&total, &x);
        if (x > 6) { total = total + 1; }
        i = i + 1;
    }
    return seven(total, 1, 2, 3, 4, 5, 6);
}

fn single(n as i32) as f32 {
    let is f32 as t with mut = 0.5;
    let is i32 as i with mut = 0;
    while (i < n) {
        let is f32 as z with mut = cast(f32, i) * 0.5;
        add_f(&t, &z);
        i = i + 1;
    }
    return t + cast(f32, seven(1, 1, 1, 1, 1, 1, 1));
}

fn fields(k as i64) as i64 {
    let is Pair as p;
    p.a = k;
    p.b = k + 1;
    let is i64 as r = eight(p.a, p.b, 0, 0, 0, 0, 0, 1);
    p.a = p.a + r;
    return p.a * 2 + p.b;
}

fn pair_stores(x as f64, y as f64) as f64 {
    let is [2]f64 as v;
    v[0] = x * 2.0;
    v[1] = y * 2.0;
    let is i64 as r = seven(0, 0, 0, 0, 0, 0, 1);
    return v[0] + v[1] + cast(f64, r);
}

fn escapes(k as i64) as i64 {
    let is i64 as x with mut = k;
    poke(&x);
    let is i64 as r = seven(x, 0, 0, 0, 0, 0, 0);
    poke(&x);
    return x + r;
}

fn main() as i32 {
    if (through_pointers(5) != 133) { return 1; }
    if (through_pointers(0) != 112) { return 2; }
    if (single(4) != 31.5) { return 3; }
    if (fields(3) != 48) { return 4; }
    if (pair_stores(1.5, 2.5) != 15.0) { return 5; }
    if (escapes(1) != 302) { return 6; }
    return 0;
}
