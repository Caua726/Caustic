// tests/outer_vector_test.cst
//
// An outer loop whose inner loop sums floats runs as vectors when its columns sit
// side by side (-O2). Every result must equal the plain scalar computation, bit
// for bit: f32 and f64, a count of columns that leaves a remainder, an accumulator
// that does not start at zero, a shared factor, subtraction, work after the inner
// loop, and columns that are not adjacent (which stay scalar).
//
// Exit code 0 on success, else the number of the failing check.

let is i32 as N with imut = 23;
let is i32 as W with imut = 24;

let is [576]f32 as fa with mut;
let is [576]f32 as fb with mut;
let is [576]f32 as fr with mut;
let is [576]f64 as da with mut;
let is [576]f64 as db with mut;
let is [576]f64 as dr with mut;

fn fill() as void {
    let is i32 as s with mut = 74755;
    let is i32 as i with mut = 0;
    while (i < 576) {
        s = (s * 1309 + 13849) & 65535;
        fa[i] = cast(f32, s % 200 - 100) / 7.0;
        da[i] = cast(f64, s % 200 - 100) / 7.0;
        s = (s * 1309 + 13849) & 65535;
        fb[i] = cast(f32, s % 200 - 100) / 3.0;
        db[i] = cast(f64, s % 200 - 100) / 3.0;
        fr[i] = 0.0;
        dr[i] = 0.0;
        i = i + 1;
    }
}

// the reference: one column at a time (the checks below branch on every result,
// which keeps their loops apart from the vector form)
fn sum_f(row as i32, col as i32, start as f32, k as f32) as f32 {
    let is f32 as s with mut = start;
    let is i32 as i with mut = 0;
    while (i < N) {
        s = s + fa[row * W + i] * k * fb[i * W + col];
        i = i + 1;
    }
    return s;
}

fn sum_d(row as i32, col as i32, start as f64, k as f64) as f64 {
    let is f64 as s with mut = start;
    let is i32 as i with mut = 0;
    while (i < N) {
        s = s + da[row * W + i] * k * db[i * W + col];
        i = i + 1;
    }
    return s;
}

fn product_f(k as f32, start as f32) as void {
    let is i32 as row with mut = 0;
    while (row < N) {
        let is i32 as col with mut = 0;
        while (col < N) {
            let is f32 as s with mut = start;
            let is i32 as i with mut = 0;
            while (i < N) {
                s = s + fa[row * W + i] * k * fb[i * W + col];
                i = i + 1;
            }
            fr[row * W + col] = s;
            col = col + 1;
        }
        row = row + 1;
    }
}

fn product_d(k as f64, start as f64) as void {
    let is i32 as row with mut = 0;
    while (row < N) {
        let is i32 as col with mut = 0;
        while (col < N) {
            let is f64 as s with mut = start;
            let is i32 as i with mut = 0;
            while (i < N) {
                s = s + da[row * W + i] * k * db[i * W + col];
                i = i + 1;
            }
            dr[row * W + col] = s;
            col = col + 1;
        }
        row = row + 1;
    }
}

fn check_f(k as f32, start as f32) as i32 {
    let is i32 as row with mut = 0;
    while (row < N) {
        let is i32 as col with mut = 0;
        while (col < N) {
            let is f32 as x = sum_f(row, col, start, k);
            if (*cast(*i32, &fr[row * W + col]) != *cast(*i32, &x)) { return 1; }
            col = col + 1;
        }
        row = row + 1;
    }
    return 0;
}

fn check_d(k as f64, start as f64) as i32 {
    let is i32 as row with mut = 0;
    while (row < N) {
        let is i32 as col with mut = 0;
        while (col < N) {
            let is f64 as x = sum_d(row, col, start, k);
            if (*cast(*i64, &dr[row * W + col]) != *cast(*i64, &x)) { return 1; }
            col = col + 1;
        }
        row = row + 1;
    }
    return 0;
}

// subtraction, and work after the inner loop
fn diff_scaled_d(row as i32) as void {
    let is i32 as col with mut = 0;
    while (col < N) {
        let is f64 as s with mut = 0.0;
        let is i32 as i with mut = 0;
        while (i < N) {
            s = s - da[row * W + i] * db[i * W + col];
            i = i + 1;
        }
        dr[col] = s * 0.5;
        col = col + 1;
    }
}

// columns two apart do not form a vector
fn every_other_f(row as i32) as void {
    let is i32 as col with mut = 0;
    while (col < N) {
        let is f32 as s with mut = 0.0;
        let is i32 as i with mut = 0;
        while (i < N) {
            s = s + fa[row * W + i] * fb[i * W + col];
            i = i + 1;
        }
        fr[col] = s;
        col = col + 2;
    }
}

fn main() as i32 {
    fill();
    product_f(1.0, 0.0);
    if (check_f(1.0, 0.0) != 0) { return 1; }
    product_f(0.75, 1.5);
    if (check_f(0.75, 1.5) != 0) { return 2; }
    product_d(1.0, 0.0);
    if (check_d(1.0, 0.0) != 0) { return 3; }
    product_d(0.75, 1.5);
    if (check_d(0.75, 1.5) != 0) { return 4; }
    diff_scaled_d(3);
    let is i32 as col with mut = 0;
    while (col < N) {
        let is f64 as x with mut = 0.0;
        let is i32 as i with mut = 0;
        while (i < N) { x = x - da[3 * W + i] * db[i * W + col]; i = i + 1; }
        x = x * 0.5;
        if (*cast(*i64, &dr[col]) != *cast(*i64, &x)) { return 5; }
        col = col + 1;
    }
    let is i32 as z with mut = 0;
    while (z < 576) { fr[z] = 0.0; z = z + 1; }
    every_other_f(2);
    col = 0;
    while (col < N) {
        let is f32 as x with mut = 0.0;
        if (col % 2 == 0) {
            let is i32 as i with mut = 0;
            while (i < N) { x = x + fa[2 * W + i] * fb[i * W + col]; i = i + 1; }
        }
        if (*cast(*i32, &fr[col]) != *cast(*i32, &x)) { return 6; }
        col = col + 1;
    }
    return 0;
}
