// tests/store_forward_test.cst
//
// A load right after a store to the same address reads what was stored, without
// going to memory at -O2. What must hold: a narrow store truncates and the load
// extends, an f32 store rounds, a store through another pointer or to another
// element in between decides the value, a call in between may change it, and
// signed and unsigned reads differ.
//
// Exit code 0 on success, else the number of the failing check.

let is i32 as gi with mut = 0;
let is i8 as gc with mut = 0;
let is u8 as gu with mut = 0;
let is i16 as gs with mut = 0;
let is u16 as gw with mut = 0;
let is u32 as gd with mut = 0;
let is i64 as gl with mut = 0;
let is f64 as gf with mut = 0.0;
let is f32 as gg with mut = 0.0;
let is *i32 as gp with mut;
let is [4]i32 as arr with mut;

fn keep(v as i64) as i64 { return v; }

fn narrow_i32(v as i64) as i64 {
    gi = cast(i32, v);
    return cast(i64, gi);
}
fn narrow_i8(v as i32) as i32 {
    gc = cast(i8, v);
    return cast(i32, gc);
}
fn narrow_u8(v as i32) as i32 {
    gu = cast(u8, v);
    return cast(i32, gu);
}
fn narrow_i16(v as i32) as i32 {
    gs = cast(i16, v);
    return cast(i32, gs);
}
fn narrow_u16(v as i32) as i32 {
    gw = cast(u16, v);
    return cast(i32, gw);
}
fn narrow_u32(v as i64) as i64 {
    gd = cast(u32, v);
    return cast(i64, gd);
}
fn wrap_add(a as i32, b as i32) as i64 {
    gi = a + b;
    return cast(i64, gi);
}
fn rounded(x as f64) as f64 {
    gg = cast(f32, x);
    return cast(f64, gg);
}
fn whole(x as f64) as f64 {
    gf = x * 2.0;
    return gf + gf;
}
fn other_elem(i as i64, j as i64) as i32 {
    arr[i] = 1;
    arr[j] = 2;
    return arr[i];
}
fn through_ptr(p as *i32) as i32 {
    gi = 5;
    p[0] = 6;
    return gi;
}
fn set_gl() as void { gl = 9; }
fn across_call() as i64 {
    gl = 1;
    set_gl();
    return gl;
}
fn chain(a as i32) as i32 {
    gi = a;
    gi = gi + 1;
    gi = gi * 2;
    return gi - 1;
}
fn in_branch(c as i32) as i32 {
    gi = 1;
    if (c != 0) { gi = 2; }
    return gi;
}

// The same base at other offsets.
fn field_apart(p as *i32, v as i32) as i32 {
    p[0] = v;
    p[1] = 7;
    p[2] = 8;
    return p[0];
}
fn field_overlap(p as *u8, v as i32) as i64 {
    *cast(*i32, p) = v;
    p[1] = 0xFF;
    p[2] = 0x99;
    return cast(i64, *cast(*i32, p));
}
fn other_base(p as *i32, q as *i32) as i32 {
    p[0] = 1;
    q[1] = 2;
    return p[0];
}
fn moved_base(p0 as *i32) as i32 {
    let is *i32 as p with mut = p0;
    p[0] = 5;
    p = p + 1;
    p[0] = 6;
    p = p - 1;
    return p[0];
}
fn wide_over(p as *i32) as i32 {
    p[1] = 3;
    *cast(*i64, p) = 9;
    return p[0];
}

fn main() as i32 {
    if (narrow_i32(4294967297) != 1) { return 1; }
    if (narrow_i32(2147483648) != 0 - 2147483648) { return 2; }
    if (narrow_i8(200) != 0 - 56) { return 3; }
    if (narrow_u8(300) != 44) { return 4; }
    if (narrow_i16(40000) != 0 - 25536) { return 5; }
    if (narrow_u16(70000) != 4464) { return 6; }
    if (narrow_u32(0 - 1) != 4294967295) { return 7; }
    if (wrap_add(2147483647, 1) != 0 - 2147483648) { return 8; }
    let is f64 as tenth = 0.1;
    if (rounded(tenth) == tenth) { return 9; }
    if (whole(1.5) != 6.0) { return 10; }
    if (other_elem(1, 1) != 2 || other_elem(1, 2) != 1) { return 11; }
    if (through_ptr(&gi) != 6) { return 12; }
    let is i32 as loc with mut = 0;
    if (through_ptr(&loc) != 5 || loc != 6) { return 13; }
    if (across_call() != 9) { return 14; }
    if (chain(3) != 7) { return 15; }
    if (in_branch(0) != 1 || in_branch(1) != 2) { return 16; }
    // the same base, other bytes: a store to one field leaves the others;
    // bytes that meet, or a base that is only maybe the same, decide the value
    let is [8]i32 as fa;
    let is *i32 as fp = cast(*i32, &fa);
    if (field_apart(fp, 11) != 11) { return 17; }
    if (fa[0] != 11 || fa[1] != 7 || fa[2] != 8) { return 18; }
    if (field_overlap(cast(*u8, fp), 0x01020304) != 0x0199FF04) { return 19; }
    if (other_base(fp + 1, fp) != 2) { return 20; }
    if (other_base(fp + 2, fp) != 1) { return 21; }
    if (moved_base(fp) != 5) { return 22; }
    if (wide_over(fp) != 9) { return 23; }
    return 0;
}
