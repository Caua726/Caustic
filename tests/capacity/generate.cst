// Runtime-generated boundary consumers; no checked-in hundreds of source files.
use "../../std/io.cst" as io;
use "../../std/env.cst" as env;

let is i32 as MODULE_COUNT with imut = 300;
let is i32 as FOREIGN_COUNT with imut = 300;
let is i32 as SECOND_FOREIGN_COUNT with imut = 7;

fn _append(dst as *u8, at as i32, text as *u8) as i32 {
    let is i64 as len = io.strlen(text);
    if (at < 0 || cast(i64, at) + len >= 1024) { return cast(i32, 0 - 1); }
    let is i32 as i with mut = 0;
    while (cast(i64, i) < len) { dst[at + i] = text[i]; i = i + 1; }
    return at + cast(i32, len);
}

fn _path(dst as *u8, directory as *u8, stem as *u8, number as i32, suffix as *u8) as i32 {
    let is i32 as at with mut = _append(dst, 0, directory);
    at = _append(dst, at, "/");
    at = _append(dst, at, stem);
    if (at < 0 || at > 1013) { return 1; }
    if (number >= 0) {
        let is [12]u8 as digits;
        let is i32 as n with mut = number;
        let is i32 as count with mut = 0;
        if (n == 0) { digits[count] = cast(u8, 48); count = count + 1; }
        while (n > 0) { digits[count] = cast(u8, 48 + n % 10); count = count + 1; n = n / 10; }
        while (count > 0) { count = count - 1; dst[at] = digits[count]; at = at + 1; }
    }
    at = _append(dst, at, suffix);
    if (at < 0) { return 1; }
    dst[at] = cast(u8, 0);
    return 0;
}

fn _open(directory as *u8, name as *u8) as i64 {
    let is [1024]u8 as path;
    if (_path(cast(*u8, &path), directory, name, cast(i32, 0 - 1), "") != 0) { return 0 - 1; }
    return io._open_write(cast(*u8, &path));
}

fn write_modules(directory as *u8) as i32 {
    io.mkdir(directory);
    let is i64 as root = _open(directory, "modules.cst");
    if (root < 0) { return 1; }
    let is [1024]u8 as path;
    let is i32 as i with mut = 0;
    while (i < MODULE_COUNT) {
        if (_path(cast(*u8, &path), directory, "module_", i, ".cst") != 0) { io._close_fd(root); return 1; }
        let is i64 as module = io._open_write(cast(*u8, &path));
        if (module < 0) { io._close_fd(root); return 1; }
        io.write_str(module, "let is i64 as value with mut = "); io.write_int(module, 1000 + cast(i64, i));
        io.write_str(module, ";\nfn evaluate(x as i64) as i64 { return value + x; }\n");
        io._close_fd(module);
        io.write_str(root, "use \"module_"); io.write_int(root, cast(i64, i));
        io.write_str(root, ".cst\" as m"); io.write_int(root, cast(i64, i)); io.write_str(root, ";\n");
        i = i + 1;
    }
    io.write_str(root, "fn main() as i32 {\n");
    i = 0;
    while (i < MODULE_COUNT) {
        io.write_str(root, "  if (m"); io.write_int(root, cast(i64, i));
        io.write_str(root, ".evaluate(17) != "); io.write_int(root, 1017 + cast(i64, i));
        io.write_str(root, ") { return 1; }\n  m"); io.write_int(root, cast(i64, i));
        io.write_str(root, ".value = "); io.write_int(root, 3000 + cast(i64, i)); io.write_str(root, ";\n");
        i = i + 1;
    }
    i = 0;
    while (i < MODULE_COUNT) {
        io.write_str(root, "  if (m"); io.write_int(root, cast(i64, i));
        io.write_str(root, ".evaluate(23) != "); io.write_int(root, 3023 + cast(i64, i));
        io.write_str(root, ") { return 1; }\n");
        i = i + 1;
    }
    io.write_str(root, "  return 0;\n}\n"); io._close_fd(root);
    return 0;
}

fn _write_library(directory as *u8, name as *u8, prefix as *u8, count as i32, base as i64) as i32 {
    let is i64 as fd = _open(directory, name);
    if (fd < 0) { return 1; }
    io.write_str(fd, "#include <stdint.h>\n#ifdef _WIN32\n#define EXPORT __declspec(dllexport)\n#else\n#define EXPORT\n#endif\n");
    let is i32 as i with mut = 0;
    while (i < count) {
        io.write_str(fd, "EXPORT int64_t "); io.write_str(fd, prefix); io.write_int(fd, cast(i64, i));
        io.write_str(fd, "(int64_t x) { return x + "); io.write_int(fd, base + 31 * cast(i64, i));
        io.write_str(fd, "; }\n"); i = i + 1;
    }
    io._close_fd(fd);
    return 0;
}

fn _declaration(fd as i64, library as *u8, prefix as *u8, index as i32) as void {
    io.write_str(fd, "extern \""); io.write_str(fd, library); io.write_str(fd, "\" fn ");
    io.write_str(fd, prefix); io.write_int(fd, cast(i64, index)); io.write_str(fd, "(x as i64) as i64;\n");
}

fn _foreign(directory as *u8, name as *u8, first as *u8, second as *u8) as i32 {
    let is i64 as fd = _open(directory, name);
    if (fd < 0) { return 1; }
    let is i32 as i with mut = 0;
    while (i < FOREIGN_COUNT) {
        _declaration(fd, first, "cap_a", i);
        if (i % 43 == 0) { _declaration(fd, second, "cap_b", i / 43); }
        i = i + 1;
    }
    io.write_str(fd, "fn main() as i32 {\n");
    i = 0;
    while (i < FOREIGN_COUNT) {
        io.write_str(fd, "  if (cap_a"); io.write_int(fd, cast(i64, i));
        io.write_str(fd, "(29) != "); io.write_int(fd, 10029 + 31 * cast(i64, i));
        io.write_str(fd, ") { return 1; }\n");
        if (i % 43 == 0) {
            io.write_str(fd, "  if (cap_b"); io.write_int(fd, cast(i64, i / 43));
            io.write_str(fd, "(37) != "); io.write_int(fd, 20037 + 31 * cast(i64, i / 43));
            io.write_str(fd, ") { return 1; }\n");
        }
        i = i + 1;
    }
    io.write_str(fd, "  return 0;\n}\n"); io._close_fd(fd);
    return 0;
}

fn generate(directory as *u8) as i32 {
    if (write_modules(directory) != 0) { return 1; }
    if (_write_library(directory, "library_a.c", "cap_a", FOREIGN_COUNT, 10000) != 0) { return 1; }
    if (_write_library(directory, "library_b.c", "cap_b", SECOND_FOREIGN_COUNT, 20000) != 0) { return 1; }
    if (_foreign(directory, "foreign_elf.cst", "libcapacity_a.so", "libcapacity_b.so") != 0) { return 1; }
    if (_foreign(directory, "foreign_pe.cst", "capacity_a.dll", "capacity_b.dll") != 0) { return 1; }
    return 0;
}

fn main(argc as i64, argv as i64) as i32 {
    env.init(argc, cast(*u8, argv));
    if (argc != 2) { return 2; }
    return generate(env.argv(1));
}
