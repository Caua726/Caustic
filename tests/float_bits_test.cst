// tests/float_bits_test.cst
//
// A pointer cast to read a float's bits as an integer, or an integer's as a float:
// the value crosses between the register classes, and must arrive as the same bits.
// Compared, returned, stored and used in arithmetic, at f64 and f32.
//
// Exit code 0 on success, else the number of the failing check.

let is [4]i64 as g with mut;
let is f64 as one with mut = 1.5;
let is f32 as one32 with mut = 1.5;

fn cmp_mem(a as f64, k as i32) as i32 {
    let is f64 as x = a * 2.0;
    g[0] = 4613937818241073152;
    if (*cast(*i64, &g[k]) != *cast(*i64, &x)) { return 1; }
    return 0;
}

fn bits_of(a as f64) as i64 {
    let is f64 as x = a * 2.0;
    return *cast(*i64, &x);
}

fn bits_plus(a as f64) as i64 {
    let is f64 as x = a + 1.0;
    return *cast(*i64, &x) + 1;
}

fn float_of(b as i64) as f64 {
    return *cast(*f64, &b);
}

fn float_sum(b as i64, c as f64) as f64 {
    let is i64 as t = b + 0;
    return *cast(*f64, &t) + c;
}

fn bits32(a as f32) as i32 {
    let is f32 as x = a * 2.0;
    return *cast(*i32, &x);
}

fn float32(b as i32) as f32 {
    return *cast(*f32, &b);
}

// the local changes between the reads, and its address also goes elsewhere
fn changing(a as f64) as i64 {
    let is f64 as x with mut = a;
    let is i64 as first = *cast(*i64, &x);
    x = x + 1.0;
    let is i64 as second = *cast(*i64, &x);
    let is *f64 as p = &x;
    *p = 8.0;
    return first + second + *cast(*i64, &x);
}

// constants, a loop, a call in between, and writing through the cast pointer
fn in_loop(n as i64) as i64 {
    let is i64 as acc with mut = 0;
    let is f64 as x with mut = 1.0;
    let is i64 as i with mut = 0;
    while (i < n) {
        x = x * 2.0;
        acc = acc ^ *cast(*i64, &x);
        i = i + 1;
    }
    return acc;
}

fn poke(a as i64) as f64 {
    let is i64 as n with mut = a;
    *cast(*f64, &n) = 1.5;
    return *cast(*f64, &n);
}

fn main() as i32 {
    if (changing(1.5) != 4609434218613702656 + 4612811918334230528 + 4620693217682128896) { return 8; }
    if (in_loop(3) != (4611686018427387904 ^ 4616189618054758400 ^ 4620693217682128896)) { return 9; }
    if (poke(7) != 1.5) { return 10; }
    let is f64 as c = 2.5;
    if (*cast(*i64, &c) != 4612811918334230528) { return 11; }
    if (cmp_mem(one, 0) != 0) { return 1; }
    if (bits_of(one) != 4613937818241073152) { return 2; }
    if (bits_plus(one) != 4612811918334230529) { return 3; }
    if (float_of(4613937818241073152) != 3.0) { return 4; }
    if (float_sum(4613937818241073152, one) != 4.5) { return 5; }
    if (bits32(one32) != 1077936128) { return 6; }
    if (float32(1077936128) != 3.0) { return 7; }
    return 0;
}
