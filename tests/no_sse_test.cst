// Integer code whose normal build uses xmm registers at some level: copies of
// 16 to 64 bytes, loops the vectorizer takes, two stores side by side, the mem
// routines. Built with --no-sse it must give the same answers.
use "../std/mem.cst" as mem;

struct S16 { a as i64; b as i64; }
struct S24 { a as i64; b as i64; c as i64; }
struct S40 { a as i64; b as i64; c as i64; d as i64; e as i64; }
struct S64 { v as [8]i64; }
struct S63 { v as [7]i64; w as i32; x as i16; y as u8; }
struct Big { v as [40]i64; }

fn copy16(d as *S16, s as *S16) as void with noinline { *d = *s; }
fn copy24(d as *S24, s as *S24) as void with noinline { *d = *s; }
fn copy40(d as *S40, s as *S40) as void with noinline { *d = *s; }
fn copy64(d as *S64, s as *S64) as void with noinline { *d = *s; }
fn copy63(d as *S63, s as *S63) as void with noinline { *d = *s; }
fn copybig(d as *Big, s as *Big) as void with noinline { *d = *s; }
fn make40(x as i64) as S40 with noinline { let is S40 as r; r.a = x; r.b = x + 1; r.c = x + 2; r.d = x + 3; r.e = x + 4; return r; }
fn by_value(s as S40, k as i64) as i64 with noinline { return s.a + s.b * 2 + s.c * 3 + s.d * 5 + s.e * 7 + k; }

fn sum(p as *i64, n as i64) as i64 with noinline {
    let is i64 as s with mut = 0; let is i64 as i with mut = 0;
    while (i < n) { s = s + p[i]; i = i + 1; }
    return s;
}
fn sum32(p as *i32, n as i64) as i64 with noinline {
    let is i32 as s with mut = 0; let is i64 as i with mut = 0;
    while (i < n) { s = s + p[i]; i = i + 1; }
    return cast(i64, s);
}
fn add(d as *i64, a as *i64, b as *i64, n as i64) as void with noinline {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = a[i] + b[i]; i = i + 1; }
}
fn fill(d as *u8, c as u8, n as i64) as void with noinline {
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = c; i = i + 1; }
}
fn count(p as *u8, c as u8, n as i64) as i64 with noinline {
    let is i64 as k with mut = 0; let is i64 as i with mut = 0;
    while (i < n) { if (p[i] == c) { k = k + 1; } i = i + 1; }
    return k;
}
fn pair(p as *i64, a as i64, b as i64) as void with noinline { p[0] = a + 1; p[1] = b + 1; p[2] = a ^ b; p[3] = a & b; }
fn many(a as i64, b as i64, c as i64, d as i64, e as i64, f as i64, g as i64, h as i64) as i64 with noinline {
    return a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g + 8 * h;
}
fn twice(x as i64) as i64 with noinline { return x * 2; }
fn pressure(a as i64, b as i64) as i64 with noinline {
    let is i64 as c = a + b; let is i64 as d = a * b; let is i64 as e = a ^ b; let is i64 as f = a - b;
    let is i64 as g = c * d; let is i64 as h = e + f; let is i64 as i = g - h; let is i64 as j = twice(i);
    let is i64 as k = twice(c + e); let is i64 as l = twice(d + f);
    return a + b + c + d + e + f + g + h + i + j + k + l;
}

fn main() as i32 {
    let is S16 as x1; let is S16 as y1; x1.a = 1; x1.b = 2; copy16(&y1, &x1);
    if (y1.a + y1.b * 10 != 21) { return 1; }
    let is S24 as x2; let is S24 as y2; x2.a = 1; x2.b = 2; x2.c = 3; copy24(&y2, &x2);
    if (y2.a + y2.b * 10 + y2.c * 100 != 321) { return 2; }
    let is S40 as x3 = make40(10); let is S40 as y3; copy40(&y3, &x3);
    if (by_value(y3, 1) != 10 + 22 + 36 + 65 + 98 + 1) { return 3; }
    let is S64 as x4; let is S64 as y4; let is i64 as i with mut = 0;
    while (i < 8) { x4.v[i] = i * i + 1; y4.v[i] = 0; i = i + 1; }
    copy64(&y4, &x4);
    if (sum(&y4.v[0], 8) != 148) { return 4; }
    let is S63 as x5; let is S63 as y5; x5.v[0] = 5; x5.v[6] = 6; x5.w = 7; x5.x = 8; x5.y = cast(u8, 9); copy63(&y5, &x5);
    if (y5.v[0] != 5 || y5.v[6] != 6 || y5.w != 7 || y5.x != 8 || y5.y != 9) { return 5; }
    let is Big as x6; let is Big as y6; i = 0;
    while (i < 40) { x6.v[i] = i; i = i + 1; }
    copybig(&y6, &x6);
    if (sum(&y6.v[0], 40) != 780) { return 6; }
    let is Big as z6; add(&z6.v[0], &x6.v[0], &y6.v[0], 39);
    if (sum(&z6.v[0], 39) != 1482) { return 7; }
    let is [100]i32 as w; i = 0;
    while (i < 100) { w[i] = cast(i32, i - 50); i = i + 1; }
    if (sum32(&w[0], 100) != 0 - 50) { return 8; }
    let is [257]u8 as b; fill(&b[0], cast(u8, 7), 257); b[3] = cast(u8, 1);
    if (count(&b[0], cast(u8, 7), 257) != 256) { return 9; }
    let is [257]u8 as b2; mem.memset(&b2[0], 3, 257); mem.memcpy(&b2[1], &b[0], 200); mem.memzero(&b[0], 64);
    if (count(&b2[0], cast(u8, 7), 257) != 199 || count(&b[0], cast(u8, 0), 257) != 64) { return 10; }
    let is [4]i64 as q; pair(&q[0], 12, 10);
    if (q[0] != 13 || q[1] != 11 || q[2] != 6 || q[3] != 8) { return 11; }
    if (many(1, 2, 3, 4, 5, 6, 7, 8) != 204) { return 12; }
    if (pressure(7, 3) != 7 + 3 + 10 + 21 + 4 + 4 + 210 + 8 + 202 + 404 + 28 + 50) { return 13; }
    let is u64 as u = 0xFFFFFFFFFFFFFFFB;
    if (u % 7 != 4 || u / 3 != 6148914691236517203) { return 14; }
    return 0;
}
