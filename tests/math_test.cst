// tests/math_test.cst — accuracy of the std/math float functions.
//
// Reference values are the correctly rounded f64 results. The tolerance is
// relative (1e-10), loose enough not to depend on the last bit of a series
// truncation and tight enough that a wrong reduction or a dropped term fails.
// Exit code is the number of failures, so the runner's exit-0 check applies.
use "../std/io.cst" as io;
use "../std/math.cst" as m;

let is i32 as fails with mut = 0;

fn chk(name as *u8, got as f64, want as f64) as void {
    let is f64 as d = m.abs_f64(got - want);
    let is f64 as tol = 0.0000000001 + m.abs_f64(want) * 0.0000000001;
    if (d > tol) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d (scaled 1e9)\n",
                  name, cast(i64, got * 1000000000.0), cast(i64, want * 1000000000.0));
    }
}

fn chk_i(name as *u8, got as i32, want as i32) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, cast(i64, got), cast(i64, want));
    }
}

fn main() as i32 {
    // Trigonometry. sin(1000) exercises the Cody-Waite range reduction: a
    // single-constant subtraction loses the low bits of n*(pi/2) by then.
    chk("sin(0)",       m.sin(0.0),                 0.0);
    chk("sin(pi/6)",    m.sin(0.5235987755982988),  0.5);
    chk("sin(1)",       m.sin(1.0),                 0.8414709848078965);
    chk("sin(-1)",      m.sin(-1.0),               -0.8414709848078965);
    chk("sin(10)",      m.sin(10.0),               -0.5440211108893698);
    chk("sin(1000)",    m.sin(1000.0),              0.8268795405320025);
    chk("cos(0)",       m.cos(0.0),                 1.0);
    chk("cos(1)",       m.cos(1.0),                 0.5403023058681398);
    chk("cos(10)",      m.cos(10.0),               -0.8390715290764524);
    chk("tan(1)",       m.tan(1.0),                 1.5574077246549023);

    // Exponential and logarithm, including a subnormal-free small argument
    // and a value large enough to exercise the 2^n reconstruction.
    chk("exp(0)",       m.exp(0.0),                 1.0);
    chk("exp(1)",       m.exp(1.0),                 2.718281828459045);
    chk("exp(-3.5)",    m.exp(-3.5),                0.03019738342231849);
    chk("exp(20)",      m.exp(20.0),                485165195.40979028);
    chk("log(1)",       m.log(1.0),                 0.0);
    chk("log(2)",       m.log(2.0),                 0.6931471805599453);
    chk("log(1000)",    m.log(1000.0),              6.907755278982137);
    chk("log(0.001)",   m.log(0.001),              -6.907755278982137);
    chk("log2(1024)",   m.log2(1024.0),             10.0);
    chk("log10(1e6)",   m.log10(1000000.0),         6.0);

    // pow: integer exponents take the squaring path (the only one that can
    // reach a negative base), fractional ones go through exp(e*log(b)).
    chk("pow(2,10)",    m.pow(2.0, 10.0),           1024.0);
    chk("pow(2,-3)",    m.pow(2.0, -3.0),           0.125);
    chk("pow(9,0.5)",   m.pow(9.0, 0.5),            3.0);
    chk("pow(-2,3)",    m.pow(-2.0, 3.0),          -8.0);

    // Inverse trigonometry, with atan2 covering the quadrant fixups.
    chk("atan(1)",      m.atan(1.0),                0.7853981633974483);
    chk("atan(-5)",     m.atan(-5.0),              -1.373400766945016);
    chk("atan2(1,1)",   m.atan2(1.0, 1.0),          0.7853981633974483);
    chk("atan2(1,-1)",  m.atan2(1.0, -1.0),         2.356194490192345);
    chk("asin(0.5)",    m.asin(0.5),                0.5235987755982989);
    chk("acos(0.5)",    m.acos(0.5),                1.0471975511965979);

    // Rounding — the negative cases are where truncate-toward-zero and floor
    // disagree, and where fmod has to keep the sign of the dividend.
    chk("floor(-2.5)",  m.floor(-2.5),             -3.0);
    chk("ceil(-2.5)",   m.ceil(-2.5),              -2.0);
    chk("round(-2.5)",  m.round(-2.5),             -3.0);
    chk("round(2.4)",   m.round(2.4),               2.0);
    chk("trunc(-2.9)",  m.trunc(-2.9),             -2.0);
    chk("fmod(7.5,2)",  m.fmod(7.5, 2.0),           1.5);
    chk("fmod(-7.5,2)", m.fmod(-7.5, 2.0),         -1.5);
    chk("hypot(3,4)",   m.hypot(3.0, 4.0),          5.0);
    chk("sqrt(2)",      m.sqrt(2.0),                1.4142135623730951);

    // Classification reads the bit pattern rather than comparing, because
    // float comparison cannot see a NaN (see the note in std/math.cst).
    chk_i("is_nan(nan)",    m.is_nan(m.nan()),      1);
    chk_i("is_nan(1.0)",    m.is_nan(1.0),          0);
    chk_i("is_inf(inf)",    m.is_inf(m.inf()),      1);
    chk_i("is_inf(1.0)",    m.is_inf(1.0),          0);
    chk_i("is_finite(1.0)", m.is_finite(1.0),       1);
    chk_i("is_finite(inf)", m.is_finite(m.inf()),   0);

    if (fails != 0) { io.printf("  math_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
