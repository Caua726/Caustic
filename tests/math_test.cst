// tests/math_test.cst — accuracy of the std/math float functions.
//
// Reference values are the correctly rounded f64 results. chk compares with
// a relative tolerance of 1e-10, enough to catch a wrong reduction or a
// dropped term; chk_ulp allows one unit in the last place, and chk_bits
// demands the exact bit pattern (exact results, infinities, signed zeros).
// Exit code is the number of failures, so the runner's exit-0 check applies.
use "../std/io.cst" as io;
use "../std/math.cst" as m;

let is i32 as fails with mut = 0;

fn chk(name as *u8, got as f64, want as f64) as void {
    let is f64 as d = m.abs_f64(got - want);
    let is f64 as tol = 0.0000000001 + m.abs_f64(want) * 0.0000000001;
    if (d > tol) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d (scaled 1e9)\n",
                  name, cast(i64, got * 1000000000.0), cast(i64, want * 1000000000.0));
    }
}

fn chk_i(name as *u8, got as i32, want as i32) as void {
    if (got != want) {
        fails = fails + 1;
        io.printf("  FAIL %s: got=%d want=%d\n", name, cast(i64, got), cast(i64, want));
    }
}

// Within one unit in the last place of the correctly rounded result (glibc's,
// given as its bit pattern). For arguments near a multiple of pi, where the
// value left after range reduction is all low bits, a relative 1e-10 lets a
// reduction that keeps only 53 bits of pi/2 pass; this does not.
fn chk_ulp(name as *u8, got as f64, want_bits as i64) as void {
    let is i64 as d with mut = m.f64_bits(got) - want_bits;
    if (d < 0) { d = 0 - d; }
    if (d > 1) {
        fails = fails + 1;
        io.printf("  FAIL %s: %ld ulps off\n", name, d);
    }
}

// Exactly the given bit pattern: exact results, infinities and signed zeros.
fn chk_bits(name as *u8, got as f64, want_bits as i64) as void {
    if (m.f64_bits(got) != want_bits) {
        fails = fails + 1;
        io.printf("  FAIL %s: bits %ld, want %ld\n", name, m.f64_bits(got), want_bits);
    }
}

fn main() as i32 {
    // Trigonometry. sin(1000) exercises the Cody-Waite range reduction: a
    // single-constant subtraction loses the low bits of n*(pi/2) by then.
    chk("sin(0)",       m.sin(0.0),                 0.0);
    chk("sin(pi/6)",    m.sin(0.5235987755982988),  0.5);
    chk("sin(1)",       m.sin(1.0),                 0.8414709848078965);
    chk("sin(-1)",      m.sin(-1.0),               -0.8414709848078965);
    chk("sin(10)",      m.sin(10.0),               -0.5440211108893698);
    chk("sin(1000)",    m.sin(1000.0),              0.8268795405320025);
    chk("cos(0)",       m.cos(0.0),                 1.0);
    chk("cos(1)",       m.cos(1.0),                 0.5403023058681398);
    chk("cos(10)",      m.cos(10.0),               -0.8390715290764524);
    chk("tan(1)",       m.tan(1.0),                 1.5574077246549023);

    // Large arguments and near-multiples of pi.
    chk_ulp("sin(355)",       m.sin(355.0),         0 - 4683853768973017629);
    chk_ulp("cos(355)",       m.cos(355.0),         0 - 4616189618058850740);
    chk_ulp("sin(22)",        m.sin(22.0),          0 - 4647115982661305868);
    chk_ulp("sin(103993)",    m.sin(103993.0),      0 - 4687104828337582617);
    chk_ulp("cos(103993)",    m.cos(103993.0),      4607182418798369399);
    chk_ulp("sin(833719)",    m.sin(833719.0),      4522571652817524816);
    chk_ulp("sin(1e6)",       m.sin(1000000.0),     0 - 4623395494513026969);
    chk_ulp("cos(1e6)",       m.cos(1000000.0),     4606612732610269996);
    chk_ulp("sin(2.5e6)",     m.sin(2500000.0),     4605196575134787070);
    chk_ulp("cos(2.5e6)",     m.cos(2500000.0),     0 - 4619554991000558804);
    chk_ulp("sin(1e8)",       m.sin(100000000.0),   4606566677895946763);
    chk_ulp("cos(1e8)",       m.cos(100000000.0),   0 - 4623154253124812759);

    // Exponential and logarithm, including a subnormal-free small argument
    // and a value large enough to exercise the 2^n reconstruction.
    chk("exp(0)",       m.exp(0.0),                 1.0);
    chk("exp(1)",       m.exp(1.0),                 2.718281828459045);
    chk("exp(-3.5)",    m.exp(-3.5),                0.03019738342231849);
    chk("exp(20)",      m.exp(20.0),                485165195.40979028);
    chk("log(1)",       m.log(1.0),                 0.0);
    chk("log(2)",       m.log(2.0),                 0.6931471805599453);
    chk("log(1000)",    m.log(1000.0),              6.907755278982137);
    chk("log(0.001)",   m.log(0.001),              -6.907755278982137);
    chk("log2(1024)",   m.log2(1024.0),             10.0);
    chk("log10(1e6)",   m.log10(1000000.0),         6.0);

    // pow: integer exponents take the squaring path (the only one that can
    // reach a negative base), fractional ones go through exp(e*log(b)).
    chk("pow(2,10)",    m.pow(2.0, 10.0),           1024.0);
    chk("pow(2,-3)",    m.pow(2.0, -3.0),           0.125);
    chk("pow(9,0.5)",   m.pow(9.0, 0.5),            3.0);
    chk("pow(-2,3)",    m.pow(-2.0, 3.0),          -8.0);

    // Inverse trigonometry, with atan2 covering the quadrant fixups.
    chk("atan(1)",      m.atan(1.0),                0.7853981633974483);
    chk("atan(-5)",     m.atan(-5.0),              -1.373400766945016);
    chk("atan2(1,1)",   m.atan2(1.0, 1.0),          0.7853981633974483);
    chk("atan2(1,-1)",  m.atan2(1.0, -1.0),         2.356194490192345);
    chk("asin(0.5)",    m.asin(0.5),                0.5235987755982989);
    chk("acos(0.5)",    m.acos(0.5),                1.0471975511965979);

    // Rounding — the negative cases are where truncate-toward-zero and floor
    // disagree, and where fmod has to keep the sign of the dividend.
    chk("floor(-2.5)",  m.floor(-2.5),             -3.0);
    chk("ceil(-2.5)",   m.ceil(-2.5),              -2.0);
    chk("round(-2.5)",  m.round(-2.5),             -3.0);
    chk("round(2.4)",   m.round(2.4),               2.0);
    chk("trunc(-2.9)",  m.trunc(-2.9),             -2.0);
    chk("fmod(7.5,2)",  m.fmod(7.5, 2.0),           1.5);
    chk("fmod(-7.5,2)", m.fmod(-7.5, 2.0),         -1.5);
    chk("hypot(3,4)",   m.hypot(3.0, 4.0),          5.0);
    chk("sqrt(2)",      m.sqrt(2.0),                1.4142135623730951);

    // Classification reads the bit pattern rather than comparing, because
    // float comparison cannot see a NaN (see the note in std/math.cst).
    chk_i("is_nan(nan)",    m.is_nan(m.nan()),      1);
    chk_i("is_nan(1.0)",    m.is_nan(1.0),          0);
    chk_i("is_inf(inf)",    m.is_inf(m.inf()),      1);
    chk_i("is_inf(1.0)",    m.is_inf(1.0),          0);
    chk_i("is_finite(1.0)", m.is_finite(1.0),       1);
    chk_i("is_finite(inf)", m.is_finite(m.inf()),   0);

    // Last-bit accuracy against correctly rounded references (mpmath),
    // including subnormal results, huge trig arguments and arguments
    // within 2^-60 of a multiple of pi/2.
    chk_ulp("exp(1)", m.exp(1.0), 4613303445314885481);
    chk_ulp("exp(-740)", m.exp(-740.0), 85);
    chk_ulp("exp(709.7)", m.exp(709.7), 9218153404534156820);
    chk_ulp("exp(-708.5)", m.exp(-708.5), 4060456990316460);
    chk_ulp("exp(1e-300)", m.exp(1.0e-300), 4607182418800017408);
    chk_ulp("log(5e-324)", m.log(5.0e-324), 0 - 4573612656913714749);
    chk_ulp("log(1.0000000000000002)", m.log(1.0000000000000002), 4372995238176751615);
    chk_ulp("log(0.9999999999999999)", m.log(0.9999999999999999), 0 - 4854880398305394688);
    chk_ulp("log(DBL_MAX)", m.log(1.7976931348623157e308), 4649454530587146735);
    chk_ulp("log2(3)", m.log2(3.0), 4609816855700290920);
    chk_ulp("log10(2)", m.log10(2.0), 4599094494223104511);
    chk_ulp("pow(2,0.5)", m.pow(2.0, 0.5), 4609047870845172685);
    chk_ulp("pow(10,308.25)", m.pow(10.0, 308.25), 9218771166294802899);
    chk_ulp("pow(10,-320.5)", m.pow(10.0, -320.5), 640);
    chk_ulp("pow(1.0000001,1e9)", m.pow(1.0000001, 1.0e9), 5256625748023871378);
    chk_ulp("pow(0.75,-2000.5)", m.pow(0.75, -2000.5), 8346144307199136766);
    chk_ulp("pow(-1.5,7)", m.pow(-1.5, 7.0), 0 - 4597869555312754688);
    chk_ulp("pow(2/3,1000)", m.pow(0.6666666666666666, 1000.0), 1972695231297108539);
    chk_ulp("sin(1.0e22)", m.sin(1.0e22), 0 - 4617520874450586729);
    chk_ulp("cos(1.0e22)", m.cos(1.0e22), 4602887919370356980);
    chk_ulp("tan(1.0e22)", m.tan(1.0e22), 0 - 4613357852672216489);
    chk_ulp("sin(1.0e300)", m.sin(1.0e300), 0 - 4617829991960222843);
    chk_ulp("cos(1.0e300)", m.cos(1.0e300), 0 - 4620014199950687039);
    chk_ulp("tan(1.0e300)", m.tan(1.0e300), 4609080455566175351);
    chk_ulp("sin(1.7976931348623157e308)", m.sin(1.7976931348623157e308), 4572370766535020183);
    chk_ulp("cos(1.7976931348623157e308)", m.cos(1.7976931348623157e308), 0 - 4616189728938546315);
    chk_ulp("tan(1.7976931348623157e308)", m.tan(1.7976931348623157e308), 0 - 4651001199893244796);
    chk_ulp("sin(5.319372648326541e255)", m.sin(5.319372648326541e255), 4607182418800017408);
    chk_ulp("cos(5.319372648326541e255)", m.cos(5.319372648326541e255), 0 - 4890545363570941393);
    chk_ulp("tan(5.319372648326541e255)", m.tan(5.319372648326541e255), 0 - 4342143312751798730);
    chk_ulp("sin(45.553093477052)", m.sin(45.553093477052), 4607182418800017408);
    chk_ulp("cos(45.553093477052)", m.cos(45.553093477052), 0 - 4888984932522025917);
    chk_ulp("tan(45.553093477052)", m.tan(45.553093477052), 0 - 4344166461044404026);
    chk_ulp("sin(91.106186954104)", m.sin(91.106186954104), 0 - 4884481332894655421);
    chk_ulp("cos(91.106186954104)", m.cos(91.106186954104), 0 - 4616189618054758400);
    chk_ulp("tan(91.106186954104)", m.tan(91.106186954104), 4338890703960120387);
    chk_ulp("sin(1647099.3291652855)", m.sin(1647099.3291652855), 0 - 4768847847412704249);
    chk_ulp("cos(1647099.3291652855)", m.cos(1647099.3291652855), 4607182418800017408);
    chk_ulp("tan(1647099.3291652855)", m.tan(1647099.3291652855), 0 - 4768847847412704249);
    chk_ulp("sin(-2.5e7)", m.sin(-2.5e7), 4602080819199835265);
    chk_ulp("cos(-2.5e7)", m.cos(-2.5e7), 0 - 4617231204949246953);
    chk_ulp("tan(-2.5e7)", m.tan(-2.5e7), 0 - 4620442422413062196);
    chk_ulp("tan(pi/2)", m.tan(1.5707963267948966), 4849535219099880885);
    chk_ulp("sin(0.7853981633974483)", m.sin(0.7853981633974483), 4604544271217802188);
    chk_ulp("cos(0.7853981633974483)", m.cos(0.7853981633974483), 4604544271217802189);
    chk_ulp("atan(1e300)", m.atan(1.0e300), 4609753056924675352);
    chk_ulp("atan(0.4375)", m.atan(0.4375), 4601100945962312701);
    chk_ulp("atan2(1e-300,1e300)", m.atan2(1.0e-300, 1.0e300), 0);
    chk_ulp("atan2(-3,-4)", m.atan2(-3.0, -4.0), 0 - 4610564415979616928);
    chk_ulp("atan2(3,-4)", m.atan2(3.0, -4.0), 4612807620875158880);
    chk_ulp("atan2(-3,4)", m.atan2(-3.0, 4.0), 0 - 4619400674601951519);
    chk_ulp("atan2(1e-310,-1e-310)", m.atan2(1.0e-310, -1.0e-310), 4612488097114038738);
    chk_ulp("asin(0.9999999999999999)", m.asin(0.9999999999999999), 4609753056857566488);
    chk_ulp("asin(-0.5000000000000001)", m.asin(-0.5000000000000001), 0 - 4620480658808147097);
    chk_ulp("acos(0.9999999999999999)", m.acos(0.9999999999999999), 4490088828488384512);
    chk_ulp("acos(-0.9999999999999999)", m.acos(-0.9999999999999999), 4614256656518491416);
    chk_ulp("acos(0.25)", m.acos(0.25), 4608615086221773605);
    chk_ulp("hypot(3e300,4e300)", m.hypot(3.0e300, 4.0e300), 9105677338657460995);
    chk_ulp("hypot(3e-310,4e-310)", m.hypot(3.0e-310, 4.0e-310), 101201126653655);
    chk_ulp("fmod(1e308,3)", m.fmod(1.0e308, 3.0), 4611686018427387904);
    chk_ulp("fmod(1e22,6.283185307179586)", m.fmod(1.0e22, 6.283185307179586), 4607468090304162112);

    // Exact results and C99 special values.
    chk_bits("exp(0)", m.exp(0.0), 4607182418800017408);
    chk_bits("exp(-0)", m.exp(-0.0), 4607182418800017408);
    chk_bits("exp(inf)", m.exp(m.inf()), 9218868437227405312);
    chk_bits("exp(-inf)", m.exp(m.neg_inf()), 0);
    chk_bits("exp(710)", m.exp(710.0), 9218868437227405312);
    chk_bits("exp(-746)", m.exp(-746.0), 0);
    chk_bits("log(1)", m.log(1.0), 0);
    chk_bits("log(0)", m.log(0.0), 0 - 4503599627370496);
    chk_bits("log(-0)", m.log(-0.0), 0 - 4503599627370496);
    chk_bits("log(inf)", m.log(m.inf()), 9218868437227405312);
    chk_bits("log2(1024)", m.log2(1024.0), 4621819117588971520);
    chk_bits("log2(2^-1074)", m.log2(5.0e-324), 0 - 4570933719455498240);
    chk_bits("log2(0.125)", m.log2(0.125), 0 - 4609434218613702656);
    chk_bits("log10(1e22)", m.log10(1.0e22), 4626885667169763328);
    chk_bits("log10(1e-300)", m.log10(1.0e-300), 0 - 4579386764849840128);
    chk_bits("log10(1000)", m.log10(1000.0), 4613937818241073152);
    chk_bits("pow(nan,0)", m.pow(m.nan(), 0.0), 4607182418800017408);
    chk_bits("pow(1,nan)", m.pow(1.0, m.nan()), 4607182418800017408);
    chk_bits("pow(-1,inf)", m.pow(-1.0, m.inf()), 4607182418800017408);
    chk_bits("pow(0.5,inf)", m.pow(0.5, m.inf()), 0);
    chk_bits("pow(2,-inf)", m.pow(2.0, m.neg_inf()), 0);
    chk_bits("pow(0.5,-inf)", m.pow(0.5, m.neg_inf()), 9218868437227405312);
    chk_bits("pow(-0,-1)", m.pow(-0.0, -1.0), 0 - 4503599627370496);
    chk_bits("pow(-0,-2)", m.pow(-0.0, -2.0), 9218868437227405312);
    chk_bits("pow(0,-0.5)", m.pow(0.0, -0.5), 9218868437227405312);
    chk_bits("pow(-inf,3)", m.pow(m.neg_inf(), 3.0), 0 - 4503599627370496);
    chk_bits("pow(-inf,2)", m.pow(m.neg_inf(), 2.0), 9218868437227405312);
    chk_bits("pow(inf,-1)", m.pow(m.inf(), -1.0), 0);
    chk_bits("pow(2,1024)", m.pow(2.0, 1024.0), 9218868437227405312);
    chk_bits("pow(2,-1074)", m.pow(2.0, -1074.0), 1);
    chk_bits("pow(2,-1075)", m.pow(2.0, -1075.0), 0);
    chk_bits("pow(-2,3)", m.pow(-2.0, 3.0), 0 - 4602678819172646912);
    chk_bits("pow(3,2)", m.pow(3.0, 2.0), 4621256167635550208);
    chk_bits("pow(9,0.5)", m.pow(9.0, 0.5), 4613937818241073152);
    chk_bits("pow(2,10)", m.pow(2.0, 10.0), 4652218415073722368);
    chk_bits("pow(10,-2)", m.pow(10.0, -2.0), 4576918229304087675);
    chk_bits("pow(0.5,-3)", m.pow(0.5, -3.0), 4620693217682128896);
    chk_bits("pow(5e-324,0.5)", m.pow(5.0e-324, 0.5), 2188749418902061056);
    chk_bits("sin(5e-324)", m.sin(5.0e-324), 1);
    chk_bits("cos(-0)", m.cos(-0.0), 4607182418800017408);
    chk_bits("atan2(0,0)", m.atan2(0.0, 0.0), 0);
    chk_bits("atan2(0,-0)", m.atan2(0.0, -0.0), 4614256656552045848);
    chk_bits("atan2(-0,-0)", m.atan2(-0.0, -0.0), 0 - 4609115380302729960);
    chk_bits("atan2(1,-inf)", m.atan2(1.0, m.neg_inf()), 4614256656552045848);
    chk_bits("atan2(-1,-inf)", m.atan2(-1.0, m.neg_inf()), 0 - 4609115380302729960);
    chk_bits("atan2(inf,inf)", m.atan2(m.inf(), m.inf()), 4605249457297304856);
    chk_bits("atan2(-inf,-inf)", m.atan2(m.neg_inf(), m.neg_inf()), 0 - 4610883939740737070);
    chk_bits("atan2(1,0)", m.atan2(1.0, 0.0), 4609753056924675352);
    chk_bits("atan2(-1,-0)", m.atan2(-1.0, -0.0), 0 - 4613618979930100456);
    chk_bits("atan2(-0,-1)", m.atan2(-0.0, -1.0), 0 - 4609115380302729960);
    chk_bits("atan(inf)", m.atan(m.inf()), 4609753056924675352);
    chk_bits("asin(1)", m.asin(1.0), 4609753056924675352);
    chk_bits("asin(-1)", m.asin(-1.0), 0 - 4613618979930100456);
    chk_bits("acos(1)", m.acos(1.0), 0);
    chk_bits("acos(-1)", m.acos(-1.0), 4614256656552045848);
    chk_bits("hypot(inf,nan)", m.hypot(m.inf(), m.nan()), 9218868437227405312);
    chk_bits("hypot(nan,-inf)", m.hypot(m.nan(), m.neg_inf()), 9218868437227405312);
    chk_bits("hypot(-0,0)", m.hypot(-0.0, 0.0), 0);
    chk_bits("hypot(3,4)", m.hypot(3.0, 4.0), 4617315517961601024);
    chk_bits("round(0.49999999999999994)", m.round(0.49999999999999994), 0);
    chk_bits("round(-2.5)", m.round(-2.5), 0 - 4609434218613702656);
    chk_bits("round(4503599627370497)", m.round(4503599627370497.0), 4841369599423283201);
    chk_bits("floor(1e300)", m.floor(1.0e300), 9094988921128908188);
    chk_bits("ceil(-1.5)", m.ceil(-1.5), 0 - 4616189618054758400);
    chk_bits("trunc(2^52+0.5..)", m.trunc(4503599627370495.5), 4841369599423283198);
    chk_bits("fmod(5e-324,1)", m.fmod(5.0e-324, 1.0), 1);
    chk_bits("fmod(1,inf)", m.fmod(1.0, m.inf()), 4607182418800017408);
    chk_bits("fmod(-7.5,-2)", m.fmod(-7.5, -2.0), 0 - 4613937818241073152);

    // Zeros that keep their sign.
    chk_bits("sin(-0)", m.sin(-0.0), 0 - 9223372036854775807 - 1);
    chk_bits("tan(-0)", m.tan(-0.0), 0 - 9223372036854775807 - 1);
    chk_bits("atan(-0)", m.atan(-0.0), 0 - 9223372036854775807 - 1);
    chk_bits("asin(-0)", m.asin(-0.0), 0 - 9223372036854775807 - 1);
    chk_bits("atan2(-0,0)", m.atan2(-0.0, 0.0), 0 - 9223372036854775807 - 1);
    chk_bits("atan2(-1,inf)", m.atan2(-1.0, m.inf()), 0 - 9223372036854775807 - 1);
    chk_bits("pow(-0,3)", m.pow(-0.0, 3.0), 0 - 9223372036854775807 - 1);
    chk_bits("pow(-inf,-3)", m.pow(m.neg_inf(), -3.0), 0 - 9223372036854775807 - 1);
    chk_bits("floor(-0)", m.floor(-0.0), 0 - 9223372036854775807 - 1);
    chk_bits("ceil(-0.5)", m.ceil(-0.5), 0 - 9223372036854775807 - 1);
    chk_bits("round(-0.4)", m.round(-0.4), 0 - 9223372036854775807 - 1);
    chk_bits("trunc(-0.7)", m.trunc(-0.7), 0 - 9223372036854775807 - 1);
    chk_bits("fmod(-6,3)", m.fmod(-6.0, 3.0), 0 - 9223372036854775807 - 1);

    // NaN in, NaN out; domain errors give NaN.
    chk_i("sin(inf)", m.is_nan(m.sin(m.inf())), 1);
    chk_i("cos(nan)", m.is_nan(m.cos(m.nan())), 1);
    chk_i("tan(-inf)", m.is_nan(m.tan(m.neg_inf())), 1);
    chk_i("log(-1)", m.is_nan(m.log(-1.0)), 1);
    chk_i("log2(-1)", m.is_nan(m.log2(-1.0)), 1);
    chk_i("exp(nan)", m.is_nan(m.exp(m.nan())), 1);
    chk_i("pow(-8,1/3)", m.is_nan(m.pow(-8.0, 0.3333333333333333)), 1);
    chk_i("pow(nan,1)", m.is_nan(m.pow(m.nan(), 1.0)), 1);
    chk_i("asin(1.0000000000000002)", m.is_nan(m.asin(1.0000000000000002)), 1);
    chk_i("acos(-2)", m.is_nan(m.acos(-2.0)), 1);
    chk_i("atan(nan)", m.is_nan(m.atan(m.nan())), 1);
    chk_i("atan2(nan,1)", m.is_nan(m.atan2(m.nan(), 1.0)), 1);
    chk_i("hypot(nan,1)", m.is_nan(m.hypot(m.nan(), 1.0)), 1);
    chk_i("fmod(inf,1)", m.is_nan(m.fmod(m.inf(), 1.0)), 1);
    chk_i("fmod(1,0)", m.is_nan(m.fmod(1.0, 0.0)), 1);
    chk_i("floor(nan)", m.is_nan(m.floor(m.nan())), 1);

    if (fails != 0) { io.printf("  math_test: %d failure(s)\n", cast(i64, fails)); }
    return fails;
}
