// Vector loops on short trips: the room test now comes before the overlap
// tests and the CPU flag, and a loop counting from 0 tests its ranges without
// the counter. Every length around the vector widths, from 0 and from later
// starts, on separate arrays and on overlapping ones, against a loop whose
// call keeps it scalar.
use "../std/mem.cst" as mem;

let is i64 as sink with mut = 0;

fn keep(x as i64) as void { sink = sink + x; }

fn lower(src as *u16, n as i64, dst as *u16) as u16 {
    let is u16 as seen with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u16 as c = src[i];
        seen = seen | c;
        let is u16 as upper with mut = 0;
        if (c >= 65 && c <= 90) { upper = 32; }
        dst[i] = c | upper;
        i = i + 1;
    }
    return seen;
}

fn lower_ref(src as *u16, n as i64, dst as *u16) as u16 {
    let is u16 as seen with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u16 as c = src[i];
        keep(1);
        seen = seen | c;
        let is u16 as upper with mut = 0;
        if (c >= 65 && c <= 90) { upper = 32; }
        dst[i] = c | upper;
        i = i + 1;
    }
    return seen;
}

fn add_from(a as *i32, b as *i32, from as i64, n as i64) as i64 {
    let is i64 as t with mut = 0;
    let is i64 as i with mut = from;
    while (i < n) { a[i] = a[i] + b[i]; t = t + cast(i64, b[i]); i = i + 1; }
    return t;
}

fn add_from_ref(a as *i32, b as *i32, from as i64, n as i64) as i64 {
    let is i64 as t with mut = 0;
    let is i64 as i with mut = from;
    while (i < n) { keep(1); a[i] = a[i] + b[i]; t = t + cast(i64, b[i]); i = i + 1; }
    return t;
}

fn down(a as *i32, b as *i32, n as i64) as void {
    let is i64 as i with mut = n - 1;
    while (i >= 0) { a[i] = b[i] + 7; i = i - 1; }
}

fn down_ref(a as *i32, b as *i32, n as i64) as void {
    let is i64 as i with mut = n - 1;
    while (i >= 0) { keep(1); a[i] = b[i] + 7; i = i - 1; }
}

fn fill16(p as *u16, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { p[i] = cast(u16, 60 + (i * 7) % 40); i = i + 1; }
}

fn fill32(p as *i32, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { p[i] = cast(i32, i * 3 - 5); i = i + 1; }
}

fn same16(p as *u16, q as *u16, n as i64) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) { if (p[i] != q[i]) { return 0; } i = i + 1; }
    return 1;
}

fn same32(p as *i32, q as *i32, n as i64) as i32 {
    let is i64 as i with mut = 0;
    while (i < n) { if (p[i] != q[i]) { return 0; } i = i + 1; }
    return 1;
}

let is [200]u16 as a16 with mut;
let is [200]u16 as b16 with mut;
let is [200]i32 as a32 with mut;
let is [200]i32 as b32 with mut;
let is [200]i32 as c32 with mut;
let is [200]i32 as d32 with mut;

fn main() as i32 {
    let is *u16 as x16 = cast(*u16, &a16);
    let is *u16 as y16 = cast(*u16, &b16);
    let is *i32 as p = cast(*i32, &a32);
    let is *i32 as q = cast(*i32, &b32);
    let is *i32 as r = cast(*i32, &c32);
    let is *i32 as s = cast(*i32, &d32);
    let is i64 as n with mut = 0;
    while (n < 70) {
        // the output a few lanes away from the input, on both sides
        let is i64 as off with mut = 0 - 17;
        while (off <= 17) {
            fill16(x16, 200); fill16(y16, 200);
            let is u16 as s1 = lower(x16 + 40, n, x16 + 40 + off);
            let is u16 as s2 = lower_ref(y16 + 40, n, y16 + 40 + off);
            if (s1 != s2) { return 1; }
            if (same16(x16, y16, 200) == 0) { return 2; }

            fill32(p, 200); fill32(q, 200); fill32(r, 200); fill32(s, 200);
            let is i64 as t1 = add_from(p + 40, p + 40 + off, 0, n);
            let is i64 as t2 = add_from_ref(q + 40, q + 40 + off, 0, n);
            if (t1 != t2) { return 3; }
            if (same32(p, q, 200) == 0) { return 4; }

            let is i64 as t3 = add_from(r + 40, r + 40 + off, 3, n);
            let is i64 as t4 = add_from_ref(s + 40, s + 40 + off, 3, n);
            if (t3 != t4) { return 5; }
            if (same32(r, s, 200) == 0) { return 6; }

            fill32(p, 200); fill32(q, 200);
            down(p + 40, p + 40 + off, n);
            down_ref(q + 40, q + 40 + off, n);
            if (same32(p, q, 200) == 0) { return 7; }
            off = off + 1;
        }
        n = n + 1;
    }
    if (sink == 0) { return 8; }
    return 0;
}
