// tests/float_literal_test.cst — a float literal is the f64 nearest to what was
// written, and may carry an exponent.
//
// There was no exponent: `1e30` did not lex, so a constant like it was written
// out as thirty-one digits. And the parser added each fraction digit times
// 0.1^k, one rounding per digit, so `0.0015` came out two ulps from the nearest
// double and `1e30` written out in full one ulp. Every digit is now read as one
// integer and scaled by one power of ten.
//
// The expected bit patterns are the nearest doubles, taken from a correctly
// rounding parser (Python's float()). Exit code is the number of failures.
use "../std/io.cst" as io;

let is i32 as fails with mut = 0;

fn bits(x as f64) as i64 {
    let is f64 as v with mut = x;
    return *cast(*i64, &v);
}

fn check(name as *u8, got as i64, want as i64) as void {
    if (got != want) {
        io.printf("FAIL %s: got %ld want %ld\n", name, got, want);
        fails = fails + 1;
    }
}

fn main() as i32 {
    check("1e30", bits(1e30), 5055640609639927018);
    check("1e30 written out", bits(1000000000000000000000000000000.0), 5055640609639927018);
    check("1.5e-3", bits(1.5e-3), 4564560351926583034);
    check("0.0015", bits(0.0015), 4564560351926583034);
    check("0.1", bits(0.1), 4591870180066957722);
    check("123456.789", bits(123456.789), 4683220299150161609);
    check("3.14159265358979", bits(3.14159265358979), 4614256656552045841);
    check("6.02214076e23", bits(6.02214076e23), 4962933279127225623);
    check("2E+8", bits(2E+8), 4730986895511650304);
    check("25e-1", bits(25e-1), 4612811918334230528);
    check("1e-5", bits(1e-5), 4532020583610935537);
    check("-2.5e2", bits(-2.5e2), 0 - 4580371927268327424);
    check("4.9e-324 (smallest denormal)", bits(4.9e-324), 1);
    check("1e400 is infinity", bits(1e400), 9218868437227405312);
    check("1_000.5e1", bits(1_000.5e1), bits(10005.0));

    let is f32 as h = 1e3;
    if (h != 1000.0) { io.printf("FAIL f32 1e3\n"); fails = fails + 1; }

    // `e` with no digit after it is not an exponent.
    let is i64 as e with mut = 2;
    let is i64 as k = 3;
    e = k * e;
    if (e != 6) { io.printf("FAIL integer next to e\n"); fails = fails + 1; }

    if (fails == 0) { io.printf("float_literal: ok\n"); }
    return fails;
}
