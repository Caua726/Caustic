// tests/vec_byte_fill_test.cst
//
// At -O2 a byte fill `p[i] = k` runs 32 bytes at a time with AVX2, else 16,
// and the scalar loop finishes the rest (src/ir/vec, detect_fill /
// vectorize_fill). Every length around the vector widths, a start that is not
// aligned, a start index other than 0, constants a sign or zero extension
// would tell apart, a k from a parameter, i8 as well as u8, and guard bytes on
// both sides that must stay as they were. Loops that must stay scalar (step 2,
// a store that also reads) give the same answers.
//
// Exit code 0 on success, else the number of the failing check.

fn fill_k(p as *u8, n as i32) as void {
    let is i32 as i with mut = 0;
    while (i < n) { p[i] = cast(u8, 128); i = i + 1; }
}

fn fill_v(p as *u8, n as i32, k as u8) as void {
    let is i32 as i with mut = 0;
    while (i < n) { p[i] = k; i = i + 1; }
}

fn fill_from(p as *u8, s as i32, n as i32) as void {
    let is i32 as i with mut = s;
    while (i < n) { p[i] = cast(u8, 255); i = i + 1; }
}

fn fill_i8(p as *i8, n as i32) as void {
    let is i32 as i with mut = 0;
    while (i < n) { p[i] = cast(i8, 0 - 1); i = i + 1; }
}

fn fill_step2(p as *u8, n as i32) as void {
    let is i32 as i with mut = 0;
    while (i < n) { p[i] = cast(u8, 7); i = i + 2; }
}

fn shift_left(p as *u8, n as i32) as void {
    let is i32 as i with mut = 0;
    while (i < n) { p[i] = p[i + 1]; i = i + 1; }
}

// Bytes [0, a) and [b, size) must hold `g`, bytes [a, b) must hold `k`.
fn check(p as *u8, size as i32, a as i32, b as i32, g as u8, k as u8) as i32 {
    let is i32 as i with mut = 0;
    while (i < size) {
        let is u8 as want with mut = g;
        if (i >= a && i < b) { want = k; }
        if (p[i] != want) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn reset(p as *u8, size as i32) as void {
    let is i32 as i with mut = 0;
    while (i < size) { p[i] = cast(u8, 0); i = i + 1; }
}

fn main() as i32 {
    let is i32 as size = 1100;
    let is [1100]u8 as arr;
    let is *u8 as buf = cast(*u8, &arr);
    let is [9]i32 as lens;
    lens[0] = 0; lens[1] = 1; lens[2] = 15; lens[3] = 16; lens[4] = 17;
    lens[5] = 31; lens[6] = 32; lens[7] = 33; lens[8] = 1000;
    let is i32 as t with mut = 0;
    while (t < 9) {
        let is i32 as n = lens[t];
        reset(buf, size);
        fill_k(cast(*u8, cast(i64, buf) + 1), n);
        if (check(buf, size, 1, 1 + n, cast(u8, 0), cast(u8, 128)) == 0) { return 1 + t; }
        reset(buf, size);
        fill_v(cast(*u8, cast(i64, buf) + 3), n, cast(u8, 255));
        if (check(buf, size, 3, 3 + n, cast(u8, 0), cast(u8, 255)) == 0) { return 20 + t; }
        reset(buf, size);
        fill_v(buf, n, cast(u8, 1));
        if (check(buf, size, 0, n, cast(u8, 0), cast(u8, 1)) == 0) { return 40 + t; }
        reset(buf, size);
        fill_from(buf, 5, n + 5);
        if (check(buf, size, 5, n + 5, cast(u8, 0), cast(u8, 255)) == 0) { return 60 + t; }
        reset(buf, size);
        fill_i8(cast(*i8, cast(i64, buf) + 2), n);
        if (check(buf, size, 2, 2 + n, cast(u8, 0), cast(u8, 255)) == 0) { return 80 + t; }
        t = t + 1;
    }
    // start past the end: nothing written
    reset(buf, size);
    fill_from(buf, 40, 10);
    if (check(buf, size, 0, 0, cast(u8, 0), cast(u8, 0)) == 0) { return 100; }

    reset(buf, size);
    fill_step2(buf, 100);
    let is i32 as i with mut = 0;
    while (i < 110) {
        let is u8 as want with mut = cast(u8, 0);
        if (i < 100 && i % 2 == 0) { want = cast(u8, 7); }
        if (buf[i] != want) { return 101; }
        i = i + 1;
    }

    i = 0;
    while (i < 100) { buf[i] = cast(u8, i); i = i + 1; }
    shift_left(buf, 99);
    i = 0;
    while (i < 99) {
        if (buf[i] != cast(u8, i + 1)) { return 102; }
        i = i + 1;
    }
    return 0;
}
