// tests/byte_scalar_test.cst
//
// At -O2 an integer cast of a constant folds to the constant (opt_prop.cst),
// a byte load read only by `== k` / `!= k` before a branch becomes
// `cmp BYTE PTR [a], k` (emit_inst.cst, try_load_cmp), and `base + i` read
// only by the next load or store folds into the operand as `[b + i]`
// (emit.cst, try_addr_add). The checks cover constants that wrap, signed
// bytes, byte values a sign or zero extension would tell apart, an empty
// else arm, and addresses of every access width.
//
// Exit code 0 on success, else the number of the failing check.

fn count_eq(p as *u8, n as i32, k as u8) as i32 {
    let is i32 as c with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) { if (p[i] == k) { c = c + 1; } i = i + 1; }
    return c;
}

fn count_lit(p as *u8, n as i32) as i32 {
    let is i32 as c with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) {
        if (p[i] == cast(u8, 0)) { c = c + 1; }
        if (p[i] == cast(u8, 1)) { c = c + 10; }
        if (p[i] == cast(u8, 128)) { c = c + 100; }
        if (p[i] != cast(u8, 255)) { c = c + 1000; }
        i = i + 1;
    }
    return c;
}

fn count_signed(p as *i8, n as i32) as i32 {
    let is i32 as c with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) {
        if (p[i] == cast(i8, 0 - 1)) { c = c + 1; }
        if (p[i] == cast(i8, 0 - 128)) { c = c + 10; }
        if (p[i] != cast(i8, 127)) { c = c + 100; }
        i = i + 1;
    }
    return c;
}

fn fill(p as *u8, n as i32) as void {
    let is i32 as i with mut = 0;
    while (i < n) {
        p[i] = cast(u8, 300);           // 300 & 255 = 44
        i = i + 1;
    }
}

fn wide(a as *i32, b as *i64, w as *u16, n as i32) as i64 {
    let is i32 as i with mut = 0;
    while (i < n) {
        a[i] = cast(i32, 4294967295);   // -1
        b[i] = cast(i64, i) * 3;
        w[i] = cast(u16, 70000);        // 70000 & 65535 = 4464
        i = i + 1;
    }
    let is i64 as s with mut = 0;
    i = 0;
    while (i < n) {
        s = s + cast(i64, a[i]) + b[i] + cast(i64, w[i]);
        i = i + 1;
    }
    return s;
}

fn main() as i32 {
    let is [64]u8 as buf;
    fill(&buf, 64);
    if (buf[0] != cast(u8, 44) || buf[63] != cast(u8, 44)) { return 1; }
    if (count_eq(&buf, 64, cast(u8, 44)) != 64) { return 2; }
    if (count_eq(&buf, 63, cast(u8, 44)) != 63) { return 3; }
    if (count_eq(&buf, 0, cast(u8, 44)) != 0) { return 4; }

    buf[0] = cast(u8, 0); buf[1] = cast(u8, 1); buf[2] = cast(u8, 128); buf[3] = cast(u8, 255);
    buf[4] = cast(u8, 1); buf[5] = cast(u8, 129);
    // 0 → 1+1000, 1 → 10+1000 (twice), 128 → 100+1000, 255 → 0, 129 → 1000
    if (count_lit(&buf, 6) != 5121) { return 5; }
    if (count_eq(&buf, 6, cast(u8, 255)) != 1) { return 6; }
    if (count_eq(&buf, 6, cast(u8, 128)) != 1) { return 7; }

    let is *i8 as sp = cast(*i8, &buf);
    // as i8: 0, 1, -128, -1, 1, -127
    if (count_signed(sp, 6) != 611) { return 8; }

    let is [10]i32 as a;
    let is [10]i64 as b;
    let is [10]u16 as w;
    // 10 * -1 + 3 * 45 + 10 * 4464
    if (wide(&a, &b, &w, 10) != 44765) { return 9; }
    if (a[9] != 0 - 1 || w[9] != cast(u16, 4464)) { return 10; }

    let is i8 as n8 = cast(i8, 200);    // -56
    if (cast(i64, n8) != 0 - 56) { return 11; }
    let is u32 as u = cast(u32, 0 - 1);
    if (cast(i64, u) != 4294967295) { return 12; }
    return 0;
}
