// tests/float_const_test.cst
//
// `with imut` float globals read as constants and f64 arithmetic on constants is
// done by the compiler. What must hold: the value is what the program would have
// computed, also through a module and through an address; f32 stays binary32; a
// NaN result stays a NaN; signed zero and infinity survive.
//
// Exit code 0 on success, else the number of the failing check.

use "../std/math.cst" as math;

let is f64 as RAD with imut = 1.0;
let is f64 as HALF with imut = RAD / 2.0;
let is f64 as NEG with imut = -2.5;
let is f32 as F with imut = 0.1;
let is f64 as THIRD with imut = 1.0 / 3.0;

let is f64 as one with mut = 1.0;
let is f64 as three with mut = 3.0;
let is f64 as zero with mut = 0.0;
let is f32 as f_tenth with mut = 0.1;

fn read_at(p as *f64) as f64 { return *p; }

fn main() as i32 {
    if (RAD != 1.0) { return 1; }
    if (HALF != 0.5) { return 2; }
    if (NEG != 0.0 - 2.5) { return 3; }
    if (F != f_tenth) { return 4; }
    if (cast(f64, F) == 0.1) { return 5; }
    if (THIRD != one / three) { return 6; }
    if (read_at(&RAD) != RAD) { return 7; }
    if (read_at(&HALF) != HALF) { return 8; }
    if (read_at(&THIRD) != THIRD) { return 9; }
    if (RAD / 2.0 != one / 2.0) { return 10; }
    let is f64 as a = 1.0 / 3.0;
    if (a != one / three) { return 11; }
    let is f64 as b = 0.1 + 0.2;
    let is f64 as tenth with mut = 0.1;
    let is f64 as fifth with mut = 0.2;
    if (b != tenth + fifth) { return 12; }
    let is f64 as nan = 0.0 / 0.0;
    if (nan == nan) { return 13; }
    let is f64 as inf = 1.0 / 0.0;
    if (inf != one / zero || inf <= 1000000.0) { return 14; }
    let is f64 as nz = 0.0 * (0.0 - 1.0);
    if (1.0 / nz != 0.0 - inf) { return 15; }
    if (math.sqrt(4.0) != 2.0) { return 16; }
    return 0;
}
