// tests/vec_scan_test.cst
//
// Loops that look like a sum but are not a plain reduction, which the -O2
// vectorizer once took for one: a prefix sum (`st[k] = tot; tot = tot +
// c[k]`) had its stores dropped; a map that also sums lost the sum; a sum
// whose bound is reloaded from memory in every test read that bound before
// the loop had loaded it (and crashed). Each must give the scalar answer:
// the stores all made, the bound read where it is valid. Checked against
// element-by-element references, trip counts around every vector width.
//
// Exit code 0 on success, else the number of the failing check.

let is i64 as opaque with mut = 0;

struct H { n as i32; pad as i32; }

fn prefix(cnt as *i32, st as *i32, nb as i32) as i32 {
    let is i32 as tot with mut = 0;
    let is i32 as b with mut = 0;
    while (b < nb) { st[b] = tot; tot = tot + cnt[b]; b = b + 1; }
    st[nb] = tot;
    return tot;
}

fn shifted(cnt as *i32, st as *i32, nb as i32) as void {
    st[0] = 0;
    let is i32 as b with mut = 0;
    while (b < nb) { st[b + 1] = st[b] + cnt[b]; b = b + 1; }
}

fn sum_reload(cnt as *i32, h as *H) as i32 {
    let is i32 as tot with mut = 0;
    let is i32 as b with mut = 0;
    while (b < h.n) { tot = tot + cnt[b]; b = b + 1; }
    return tot;
}

fn map_and_sum(d as *i64, a as *i64, b as *i64, n as i64) as i64 {
    let is i64 as s with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { d[i] = a[i] + b[i]; s = s + a[i]; i = i + 1; }
    return s;
}

fn main() as i32 {
    let is [100]i32 as c;
    let is [101]i32 as st;
    let is [100]i64 as a; let is [100]i64 as b; let is [100]i64 as d;
    let is i64 as k with mut = 0;
    while (k < 100) {
        c[k] = cast(i32, k * 7 - 300);
        a[k] = k * 1000003; b[k] = 5 - k;
        k = k + 1;
    }
    let is [12]i64 as ns;
    ns[0] = 0; ns[1] = 1; ns[2] = 3; ns[3] = 4; ns[4] = 7; ns[5] = 8; ns[6] = 9;
    ns[7] = 16; ns[8] = 17; ns[9] = 31; ns[10] = 50; ns[11] = 99;
    let is i64 as t with mut = 0;
    while (t < 12) {
        let is i64 as n = ns[t] + opaque;
        let is i32 as fail = cast(i32, t * 10);
        k = 0;
        while (k < 101) { st[k] = 77; k = k + 1 + opaque; }
        let is i32 as tot = prefix(cast(*i32, &c), cast(*i32, &st), cast(i32, n));
        let is i32 as acc with mut = 0;
        k = 0;
        while (k <= n) {
            if (st[k] != acc) { return fail + 1; }
            if (k < n) { acc = acc + c[k]; }
            k = k + 1 + opaque;
        }
        if (tot != acc) { return fail + 2; }
        if (n < 100 && st[n + 1] != 77) { return fail + 3; }
        shifted(cast(*i32, &c), cast(*i32, &st), cast(i32, n));
        acc = 0;
        k = 0;
        while (k <= n) {
            if (st[k] != acc) { return fail + 4; }
            if (k < n) { acc = acc + c[k]; }
            k = k + 1 + opaque;
        }
        let is H as h; h.n = cast(i32, n); h.pad = 0 - 1;
        if (sum_reload(cast(*i32, &c), &h) != tot) { return fail + 5; }
        let is i64 as s = map_and_sum(cast(*i64, &d), cast(*i64, &a), cast(*i64, &b), n);
        let is i64 as rs with mut = 0;
        k = 0;
        while (k < n) {
            if (d[k] != a[k] + b[k]) { return fail + 6; }
            rs = rs + a[k];
            k = k + 1 + opaque;
        }
        if (s != rs) { return fail + 7; }
        t = t + 1;
    }
    return 0;
}
