// Constants keep their type's signedness and width in every compile-time
// folder: global initializers, imut globals, and imut functions (which take no
// floats, and once read a float literal's integer field).
let is u64 as a_KM with imut = cast(u64, 0 - 1) % cast(u64, 3);
let is u64 as a_KD with imut = cast(u64, 0 - 1) / cast(u64, 3);
let is u64 as a_GM with mut = cast(u64, 0 - 1) % cast(u64, 3);
let is u64 as a_GS with mut = cast(u64, 0 - 1) >> cast(u64, 60);
let is u32 as a_GW with mut = cast(u32, 4000000000) * cast(u32, 2);
let is u64 as a_A with imut = cast(u64, 0 - 1);
fn a_f(x as u64) as u64 with imut { return x % cast(u64, 3); }
let is u32 as a_KW with imut = cast(u32, 4000000000) * cast(u32, 2);
fn a_fw(x as u32) as u32 with imut { return x * cast(u32, 2); }
fn a_main() as i32 {
    let is i32 as bad with mut = 0;
    if (cast(i64, a_KM) != 0) { bad = bad | 1; }
    if (cast(i64, a_KD) != 6148914691236517205) { bad = bad | 2; }
    if (cast(i64, a_GM) != 0) { bad = bad | 4; }
    if (cast(i64, a_GS) != 15) { bad = bad | 8; }
    if (cast(i64, a_GW) != 3705032704) { bad = bad | 16; }
    if (a_A < cast(u64, 5)) { bad = bad | 32; }
    if (cast(i64, a_KW) != 3705032704) { bad = bad | 64; }
    if (cast(i64, a_f(a_A)) != 0) { bad = bad | 128; }
    return bad;
}
let is u64 as b_A with imut = 0xFFFFFFFFFFFFFFFF;
let is u64 as b_T with imut = 3;
let is u64 as b_F with imut = 5;
let is u64 as b_B with imut = b_A % b_T;
let is u64 as b_C with imut = b_A / b_T;
let is u32 as b_W with imut = 4000000000;
let is u32 as b_TWO with imut = 2;
let is u32 as b_W2 with imut = b_W * b_TWO;
fn b_f(x as u64) as u64 with imut { return x % b_T; }
fn b_lt(x as u64, y as u64) as i32 with imut { if (x < y) { return 1; } return 0; }
fn b_fw(x as u32) as u32 with imut { return x * b_TWO; }
fn b_main() as i32 {
    let is i32 as bad with mut = 0;
    if (cast(i64, b_B) != 0) { bad = bad | 1; }
    if (cast(i64, b_C) != 6148914691236517205) { bad = bad | 2; }
    if (cast(i64, b_W2) != 3705032704) { bad = bad | 4; }
    if (cast(i64, b_f(b_A)) != 0) { bad = bad | 8; }
    if (b_lt(b_A, b_F) != 0) { bad = bad | 16; }
    if (cast(i64, b_fw(b_W)) != 3705032704) { bad = bad | 32; }
    if (b_A < b_F) { bad = bad | 64; }
    if (cast(i64, b_A % b_T) != 0) { bad = bad | 128; }
    return bad;
}
fn ff(x as f64) as f64 with imut { return x + 1.5; }
fn u64_of(x as i64) as u64 { return cast(u64, x); }
fn limit_of(bound as i64) as i64 {
    let is u64 as b = cast(u64, bound);
    let is u64 as limit = (cast(u64, 0) - b) % b;
    return cast(i64, limit);
}
fn main() as i32 {
    let is i32 as bad with mut = 0;
    if (a_main() != 0) { bad = bad | 1; }
    if (b_main() != 0) { bad = bad | 2; }
    if (ff(2.0) != 3.5) { bad = bad | 4; }
    if (limit_of(7) != 2) { bad = bad | 8; }
    if (cast(i64, u64_of(0 - 1) % u64_of(3)) != 0) { bad = bad | 16; }
    return bad;
}
