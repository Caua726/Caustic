// tests/array_dim_test.cst
//
// `[N]T` where N is the name of a `with imut` constant.
//
// This used to parse as an array of length ZERO. parse_type read
// cur().int_val for whatever token followed the bracket without checking it
// was a number, and an identifier's int_val is 0 — so the declaration was
// accepted, sizeof reported 0, the variable got a zero-byte slot, and every
// write through it landed on the neighbour. The failure had no diagnostic at
// any stage; it surfaced as a corrupted unrelated variable, or a segfault.
//
// The canary checks below are the real test. sizeof being right is necessary
// but not sufficient — what matters is that writing N bytes through the array
// touches nothing else on the frame.
//
// Exit 0 = all pass. Non-zero = the numbered check that failed.

use "../std/io.cst" as io;

let is i64 as N     with imut = 256;
let is i64 as SMALL with imut = 7;
let is i64 as ONE   with imut = 1;
let is i64 as ZERO  with imut = 0;

// Arithmetic in the initializer folds too — the dimension comes from the
// folded value, not from a literal in the source.
let is i64 as DERIVED with imut = 4 * 16 + 8;

let is [N]u8 as G_BUF with mut;
let is i64 as G_AFTER with mut = 999;

fn fill(b as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { b[i] = cast(u8, 0xEE); i = i + 1; }
}

// A named dimension on a local, with a canary either side of it.
fn local_canaries() as i64 {
    let is i64 as before with mut = 111;
    let is [N]u8 as a;
    let is i64 as after with mut = 222;
    fill(cast(*u8, &a), 256);
    if (before != 111) { return 1; }
    if (after != 222) { return 2; }
    return 0;
}

fn small_canaries() as i64 {
    let is i64 as before with mut = 333;
    let is [SMALL]i64 as a;
    let is i64 as after with mut = 444;
    let is i64 as i with mut = 0;
    while (i < 7) { a[i] = 0 - 1; i = i + 1; }
    if (before != 333) { return 1; }
    if (after != 444) { return 2; }
    return 0;
}

fn main() as i32 {
    // --- sizeof agrees with the literal spelling ---
    if (sizeof([N]u8) != 256) { return 1; }
    if (sizeof([N]u8) != sizeof([256]u8)) { return 2; }
    if (sizeof([SMALL]i64) != 56) { return 3; }
    if (sizeof([ONE]u8) != 1) { return 4; }
    if (sizeof([DERIVED]u8) != 72) { return 5; }
    // A constant of 0 is a legal length; it is a literal 0 that used to be
    // indistinguishable from the failure.
    if (sizeof([ZERO]u8) != 0) { return 6; }
    // Element type is respected, not assumed to be a byte.
    if (sizeof([SMALL]i32) != 28) { return 7; }
    if (sizeof([SMALL]u8) != 7) { return 8; }

    // --- literals still work, unchanged ---
    if (sizeof([16]u8) != 16) { return 9; }
    if (sizeof([0]u8) != 0) { return 10; }
    if (sizeof([3]i64) != 24) { return 11; }

    // --- the neighbours survive a full write ---
    if (local_canaries() != 0) { return 12; }
    if (small_canaries() != 0) { return 13; }

    // --- a global array with a named dimension reserves real space ---
    // A zero-sized .bss global aliases whatever follows it, so filling the
    // array would have overwritten G_AFTER.
    G_AFTER = 999;
    fill(cast(*u8, &G_BUF), 256);
    if (G_AFTER != 999) { return 14; }
    if (G_BUF[255] != cast(u8, 0xEE)) { return 15; }
    if (G_BUF[0] != cast(u8, 0xEE)) { return 16; }

    // --- indexing reaches the last element ---
    let is [N]u8 as a;
    a[255] = cast(u8, 77);
    a[0] = cast(u8, 88);
    if (a[255] != cast(u8, 77)) { return 17; }
    if (a[0] != cast(u8, 88)) { return 18; }

    // --- a named dimension works as a parameter and a return type context ---
    let is [SMALL]i64 as s;
    let is i64 as i with mut = 0;
    while (i < 7) { s[i] = i * 3; i = i + 1; }
    if (s[6] != 18) { return 19; }

    io.write_str(1, "array_dim: ok\n");
    return 0;
}
