// tests/tail_recursion_test.cst
//
// At -O2 a call a function makes to itself in tail position becomes a jump
// back to its top (src/ir/opt_tre.cst), with `return x + f(..)` summed into an
// accumulator. Every shape here must give the same answer as the plain
// recursion: swapped and rotated arguments, i32 wrap-around, several returns,
// a void walk over an array, f64 parameters, and two calls that must NOT move
// (a product, and a sum that reads memory the recursion writes).
// `deep` recurses 10^8 times, which only fits in the stack once it is a loop,
// so the test runs at -O2 only.
//
// Exit code 0 on success, else the number of the failing check.

fn gcd(a as i64, b as i64) as i64 {
    if (b == 0) { return a; }
    return gcd(b, a % b);
}
fn sum32(n as i32) as i32 {
    if (n <= 0) { return 0; }
    return n + sum32(n - 1);
}
fn sumr(n as i64) as i64 {
    if (n == 0) { return 100; }
    if (n == 7) { return 1000 + sumr(n - 1); }
    return sumr(n - 1) + n * 3;
}
fn fill(p as *i64, i as i32, n as i32) as void {
    if (i >= n) { return; }
    p[i] = cast(i64, i) * 5;
    fill(p, i + 1, n);
}
fn rot(a as i64, b as i64, c as i64, k as i64) as i64 {
    if (k == 0) { return a * 100 + b * 10 + c; }
    return rot(c, a, b, k - 1);
}
fn notail(n as i64) as i64 {
    if (n == 0) { return 1; }
    return notail(n - 1) * 2;
}
fn bump(p as *i64, n as i64) as i64 {
    if (n == 0) { return 0; }
    p[0] = p[0] + 1;
    return bump(p, n - 1) + p[0];
}
fn fdown(x as f64, k as i64) as f64 {
    if (k == 0) { return x; }
    return fdown(x * 0.5 + 1.0, k - 1);
}
fn deep(n as i64) as i64 {
    if (n == 0) { return 0; }
    return 1 + deep(n - 1);
}
fn narrow(x as i32, k as i32) as i32 {
    if (k == 0) { return x; }
    return narrow(x + 2000000000, k - 1);
}

fn main() as i32 {
    if (gcd(1071, 462) != 21) { return 1; }
    if (sum32(1000) != 500500) { return 2; }
    if (sumr(20) != 1709) { return 3; }
    let is [10]i64 as arr;
    fill(cast(*i64, &arr), 0, 10);
    if (arr[9] + arr[3] != 60) { return 4; }
    if (rot(1, 2, 3, 7) != 312) { return 5; }
    if (notail(20) != 1048576) { return 6; }
    let is i64 as cell with mut = 0;
    if (bump(&cell, 4) != 16) { return 7; }
    if (cast(i64, fdown(10.0, 30) * 1000.0) != 2000) { return 8; }
    if (narrow(5, 7) != 1115098117) { return 9; }
    if (deep(100000000) != 100000000) { return 10; }
    return 0;
}
