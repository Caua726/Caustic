// Refused in a whole-program build for Windows: a Linux wrapper's raw
// syscall is reachable there. Its twin is tests/windows/target_imports.cst,
// the same wrapper behind os.current().
use "../../std/os/linux.cst" as linux;

fn main() as i32 {
    if (linux.getpid() <= 0) { return 1; }
    return 0;
}
