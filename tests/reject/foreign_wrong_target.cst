// Refused in a whole-program build for a target that is not Windows: the
// call is reachable there and its library cannot be loaded. Its twin is
// tests/foreign_target_test.cst, the same call behind os.current().
extern "user32.dll" fn GetDesktopWindow() as *u8;

fn main() as i32 {
    if (GetDesktopWindow() == cast(*u8, 0)) { return 1; }
    return 0;
}
