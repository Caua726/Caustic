// tests/reject/fnsig_call.cst — MUST NOT COMPILE: call() with an f64 where the pointer type takes an i64.
// The rest is tests/reject/ok_fnsig.cst, line for line; see it for why.
type Cb = fn(i64, *u8) as i32;
struct S { cb as Cb; }

fn good(a as i64, p as *u8) as i32 { return cast(i32, a); }
fn bad(a as f64) as i64 { return 7; }
fn takes(f as Cb) as i32 { return call(f, 2, cast(*u8, 0)); }

fn main() as i32 {
    let is S as s with mut;
    let is i64 as n = 40;
    let is f64 as x = 1.5;
    s.cb = fn_ptr(good);
    let is i32 as r = call(s.cb, x, cast(*u8, 0));
    if (r != 40) { return 1; }
    if (takes(fn_ptr(good)) != 2) { return 2; }
    if (bad(x) != 7) { return 3; }
    return 0;
}
