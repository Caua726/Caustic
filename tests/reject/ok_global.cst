// tests/reject/ok_global.cst — the twin of dup_global.cst, and it MUST compile
// and run. See the comment there for why the pair exists.
use "../../std/io.cst" as io;

let is i64 as LIMIT with imut = 128;

fn main() as i32 {
    if (LIMIT != 128) { return 1; }
    io.printf("%ld\n", LIMIT);
    return 0;
}
