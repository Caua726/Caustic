// tests/reject/dup_global.cst — MUST NOT COMPILE.
//
// Two top-level `let`s of the same name. This used to be swallowed:
// declare_var handed the second declaration the FIRST variable, so the second
// initializer wrote into it — the last value won at runtime — while codegen
// emitted the definition twice and the assembler kept the first. Nothing
// reported anything at any stage.
//
// Everything else here is deliberately trivial, and tests/reject/ok_global.cst
// is this exact file with the duplicate removed. The pair is the test: if this
// one ever fails for some unrelated reason, its twin fails too and the suite
// says so, instead of a broken fixture quietly passing as a rejection.
use "../../std/io.cst" as io;

let is i64 as LIMIT with imut = 128;
let is i64 as LIMIT with imut = 256;

fn main() as i32 {
    io.printf("%ld\n", LIMIT);
    return 0;
}
