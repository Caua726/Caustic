// tests/reject/ok_fnsig.cst — the twin of the four fnsig_*.cst rejections, and
// it MUST compile and run. Each of those is this file with ONE line changed, so
// a fixture broken for any other reason takes this one down with it.
//
// A function type used to accept any function: `fn(f64) as i64` stored into an
// `fn(i64, *u8) as i32` compiled, and call() through it checked only the
// number of arguments — its type check compared size AND kind, so it fired
// only when both differed, and never between pointers.
type Cb = fn(i64, *u8) as i32;
struct S { cb as Cb; }

fn good(a as i64, p as *u8) as i32 { return cast(i32, a); }
fn bad(a as f64) as i64 { return 7; }
fn takes(f as Cb) as i32 { return call(f, 2, cast(*u8, 0)); }

fn main() as i32 {
    let is S as s with mut;
    let is i64 as n = 40;
    let is f64 as x = 1.5;
    s.cb = fn_ptr(good);
    let is i32 as r = call(s.cb, n, cast(*u8, 0));
    if (r != 40) { return 1; }
    if (takes(fn_ptr(good)) != 2) { return 2; }
    if (bad(x) != 7) { return 3; }
    return 0;
}
