// tests/reject/convert_float.cst — MUST NOT COMPILE: an f64 variable passed for an i64 parameter.
// The rest is tests/reject/ok_convert.cst, line for line; see it for why.
fn take_i64(a as i64) as i64 { return a; }
fn take_i32(a as i32) as i32 { return a; }
fn take_f32(a as f32) as f32 { return a; }
fn first(p as *i64) as i64 { return p[0]; }

fn main() as i32 {
    let is i64 as wide = 7;
    let is f64 as real = 2.5;
    let is u8 as byte = 200;
    let is [4]i64 as arr;
    arr[0] = 11;
    let is i32 as small with mut = 0;
    small = cast(i32, wide);
    if (take_i64(real) != 2) { return 1; }
    if (take_i32(wide < 9) != 1) { return 2; }
    if (take_i32(byte) != 200) { return 3; }
    if (first(arr) != 11) { return 4; }
    if (take_i32(0 - 1) != 0 - 1) { return 5; }
    if (take_f32(0.0 - 40.0) != 0.0 - 40.0) { return 6; }
    if (small != 7) { return 7; }
    return 0;
}
