// tests/reject/dup_generic.cst — MUST NOT COMPILE: a plain function taking the
// name of a generic one in the same module. The twin is
// tests/reject/ok_module_names.cst.
use "../../std/io.cst" as io;

extern fn ext_probe() as i64;

let is i64 as LIMIT with imut = 128;

fn pick() as i64 { return LIMIT; }

fn ident gen T (x as T) as T { return x; }
fn ident(x as i64) as i64 { return x; }

fn main() as i32 {
    if (ident gen i64 (pick()) != 128) { return 1; }
    io.printf("%ld\n", pick());
    return 0;
}
