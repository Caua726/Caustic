// tests/reject/ok_module_names.cst — the twin of dup_fn.cst, dup_extern.cst,
// dup_generic.cst and fn_global_clash.cst, and it MUST compile and run. It
// declares a function, an extern, a generic function and a global, each name
// once; each of those files is this one with a second declaration of one of
// the names. See dup_global.cst for why rejections come in pairs.
use "../../std/io.cst" as io;

extern fn ext_probe() as i64;

let is i64 as LIMIT with imut = 128;

fn pick() as i64 { return LIMIT; }

fn ident gen T (x as T) as T { return x; }

fn main() as i32 {
    if (ident gen i64 (pick()) != 128) { return 1; }
    io.printf("%ld\n", pick());
    return 0;
}
