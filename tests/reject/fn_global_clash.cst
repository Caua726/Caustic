// tests/reject/fn_global_clash.cst — MUST NOT COMPILE: a global named like a
// function of the same module, declared before it. Both are `<module>_pick`
// to the assembler, which was the first to notice. The twin is
// tests/reject/ok_module_names.cst.
use "../../std/io.cst" as io;

extern fn ext_probe() as i64;

let is i64 as pick = 3;
let is i64 as LIMIT with imut = 128;

fn pick() as i64 { return LIMIT; }

fn ident gen T (x as T) as T { return x; }

fn main() as i32 {
    if (ident gen i64 (pick()) != 128) { return 1; }
    io.printf("%ld\n", pick());
    return 0;
}
