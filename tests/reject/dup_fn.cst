// tests/reject/dup_fn.cst — MUST NOT COMPILE: a module defining `pick` twice.
// Both definitions mangle to the same symbol, and nothing said so until the
// assembler found the label defined twice — no file, no line. The twin is
// tests/reject/ok_module_names.cst.
use "../../std/io.cst" as io;

extern fn ext_probe() as i64;

let is i64 as LIMIT with imut = 128;

fn pick() as i64 { return LIMIT; }
fn pick() as i64 { return 256; }

fn ident gen T (x as T) as T { return x; }

fn main() as i32 {
    if (ident gen i64 (pick()) != 128) { return 1; }
    io.printf("%ld\n", pick());
    return 0;
}
