// tests/exceptions/misuse.cst
//
// leave() on a frame that is neither the head nor already unwound is a
// begin/enter/leave pairing bug. It used to be a silent no-op, which left the
// stack pointing at a frame the caller believes is gone. It must be
// diagnosed: exit 2. Its twin is leave_ok.cst, the same shape with the order
// fixed.
//
// Expect exit 2.

use "../../std/exceptions.cst" as ex;

fn main() as i32 {
    let is ex.Frame as a;
    let is ex.Frame as b;
    ex.enter(&a);
    ex.enter(&b);
    ex.leave(&a);              // a is not the head: misuse
    return 0;
}
