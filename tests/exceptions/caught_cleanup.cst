// tests/exceptions/caught_cleanup.cst
//
// The twin of uncaught.cst: the same guard, but with a handler registered, so
// the throw unwinds past the guard and must run it. The guard exits 9, which
// is therefore the expected exit code — proving the fixture's guard is wired
// up at all, and that "the cleanup did not run" in the twin is a real answer
// rather than a dead callback.
//
// Expect exit 9.

use "../../std/io.cst" as io;
use "../../std/exceptions.cst" as ex;

fn boom(a as i64) as void {
    io.exit(9);
}

fn main() as i32 {
    let is ex.Frame as f;
    let is i64 as c = ex.begin(&f);
    if (c != 0) { return cast(i32, c); }
    ex.enter(&f);
    defer ex.leave(&f);

    let is ex.Frame as g;
    ex.guard(&g, fn_ptr(boom), 0);
    defer ex.release(&g);

    ex.throw(7);
    return 0;
}
