// tests/exceptions/backtrace_o2.cst
//
// The same walk as backtrace.cst, at -O2. There most functions run without a
// frame pointer and the walk has to go through the .eh_frame unwind tables;
// the frame-pointer chain alone would skip every such frame. backtrace.cst's
// depth1..3 would be inlined here, so the chain is a recursion instead:
// walk(6)..walk(0) <- main <- _start is nine frames, of which every walk frame
// is one the frame-pointer chain cannot see.
//
// The exit code is 0 on success, or 100 + the line count when it is too low.

use "../../std/io.cst" as io;
use "../../std/exceptions.cst" as ex;

fn walk(fd as i64, n as i64) as i64 {
    if (n == 0) { ex.backtrace(fd, 0); return 0; }
    return walk(fd, n - 1) + 1;
}

fn main() as i32 {
    let is i64 as fd = io._open_write("build/bt_o2.txt");
    if (fd < 0) { return 90; }
    let is i64 as d = walk(fd, 6);
    io._close_fd(fd);
    if (d != 6) { return 92; }

    let is i64 as rfd = io._open_read("build/bt_o2.txt");
    if (rfd < 0) { return 91; }
    let is [1024]u8 as buf;
    let is i64 as got = io._read_fd(rfd, cast(*u8, &buf), 1024);
    io._close_fd(rfd);

    let is i32 as lines with mut = 0;
    let is i64 as i with mut = 0;
    while (i < got) {
        if (buf[i] == 10) { lines = lines + 1; }
        i = i + 1;
    }
    if (lines < 8) { return 100 + lines; }
    return 0;
}
