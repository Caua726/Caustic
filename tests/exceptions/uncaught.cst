// tests/exceptions/uncaught.cst
//
// An uncaught throw must abort WITHOUT running the cleanups it would have
// unwound past. The guard below would exit 9 if it ran; the correct behaviour
// is the uncaught path's exit 1. Its twin is caught_cleanup.cst, where a
// handler IS registered and the same guard must run.
//
// Expect exit 1.

use "../../std/io.cst" as io;
use "../../std/exceptions.cst" as ex;

fn boom(a as i64) as void {
    io.exit(9);
}

fn main() as i32 {
    let is ex.Frame as g;
    ex.guard(&g, fn_ptr(boom), 0);
    ex.throw(7);
    return 0;
}
