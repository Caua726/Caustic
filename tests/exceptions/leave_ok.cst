// tests/exceptions/leave_ok.cst
//
// The twin of misuse.cst: the same two frames, popped in the right order, so
// nothing is diagnosed and the program exits 0.
//
// Expect exit 0.

use "../../std/exceptions.cst" as ex;

fn main() as i32 {
    let is ex.Frame as a;
    let is ex.Frame as b;
    ex.enter(&a);
    ex.enter(&b);
    ex.leave(&b);              // b is the head
    ex.leave(&a);              // and now so is a
    return 0;
}
