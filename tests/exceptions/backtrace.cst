// tests/exceptions/backtrace.cst
//
// The frame-pointer walk must produce one line per frame of a known call
// chain and terminate. Compiled without -O (the harness default) so nothing is
// inlined and the depth is exact: depth3 <- depth2 <- depth1 <- main <- _start
// is five frames, plus whatever the runtime adds below.
//
// The exit code is 0 on success, or the line count when it is too low, so a
// failure reports how short it was.

use "../../std/io.cst" as io;
use "../../std/exceptions.cst" as ex;

fn depth3(fd as i64) as void { ex.backtrace(fd, 0); }
fn depth2(fd as i64) as void { depth3(fd); }
fn depth1(fd as i64) as void { depth2(fd); }

fn main() as i32 {
    let is i64 as fd = io._open_write("build/bt.txt");
    if (fd < 0) { return 90; }
    depth1(fd);
    io._close_fd(fd);

    let is i64 as rfd = io._open_read("build/bt.txt");
    if (rfd < 0) { return 91; }
    let is [1024]u8 as buf;
    let is i64 as got = io._read_fd(rfd, cast(*u8, &buf), 1024);
    io._close_fd(rfd);

    let is i32 as lines with mut = 0;
    let is i64 as i with mut = 0;
    while (i < got) {
        if (buf[i] == 10) { lines = lines + 1; }
        i = i + 1;
    }
    if (lines < 4) { return lines; }
    return 0;
}
