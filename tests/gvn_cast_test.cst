// tests/gvn_cast_test.cst
//
// At -O2 global value numbering (ir/opt_gvn.cst) merges identical CASTs and
// identical expressions over a loop variable, and keys every value by its
// type: the same integer converted to i32 and to u32, to f32 and to f64, or
// truncated to i8 and to u8, are different values. The loops below read the
// same casts of their variables in several blocks (an index shared by two
// arrays, a triangular inner loop like syr2k's) and check the results against
// values worked out by hand.
//
// Exit code 0 on success, else the number of the failing check.

// The same values converted to several types, in two blocks.
fn conversions(x as i64, sel as i32) as i64 {
    let is i64 as r with mut = 0;
    if (sel > 0) {
        r = cast(i64, cast(u32, x)) - cast(i64, cast(i32, x));
    } else {
        r = cast(i64, cast(u8, x)) * 1000 + cast(i64, cast(i8, x));
    }
    let is f32 as s = cast(f32, x);
    let is f64 as d = cast(f64, x);
    if (cast(f64, s) == d) { r = r + 1; }
    return r + cast(i64, cast(u32, x)) - cast(i64, cast(i32, x));
}

// a[j * m + k] and b[j * m + k] share their index; k and j are i32 loop
// variables, read through casts in the header and in the body.
fn tri(c as *i64, a as *i64, b as *i64, n as i32, m as i32) as void {
    let is i32 as i with mut = 0;
    while (i < n) {
        let is i32 as k with mut = 0;
        while (k < m) {
            let is i32 as j with mut = 0;
            while (j <= i) {
                c[i * n + j] = c[i * n + j] + a[j * m + k] * b[i * m + k] + b[j * m + k] * a[i * m + k];
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

// A loop variable read as i32, as i64 and as a float in each iteration.
fn mixed(n as i32) as f64 {
    let is f64 as acc with mut = 0.0;
    let is i64 as wide with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) {
        if (i % 3 == 0) { acc = acc + cast(f64, i) * 0.5; }
        else { wide = wide + cast(i64, i) * 3; }
        acc = acc + cast(f64, i);
        i = i + 1;
    }
    return acc + cast(f64, wide);
}

fn main() as i32 {
    // x = 2^32 + 2^31 + 5: u32 2147483653, i32 -2147483643; difference 2^32.
    let is i64 as x = 4294967296 + 2147483648 + 5;
    if (conversions(x, 1) != 4294967296 + 4294967296) { return 1; }
    // u8 of x is 5, i8 of x is 5; f32 cannot hold x exactly.
    if (conversions(x, 0) != 5005 + 4294967296) { return 2; }
    // 1000: u8 232, i8 -24, and an f32 holds it exactly.
    if (conversions(1000, 0) != 1000 * 232 - 24 + 1) { return 3; }

    let is i32 as n = 7;
    let is i32 as m = 5;
    let is [49]i64 as c;
    let is [35]i64 as a;
    let is [35]i64 as b;
    let is i32 as t with mut = 0;
    while (t < 49) { c[t] = 0; t = t + 1; }
    t = 0;
    while (t < 35) { a[t] = cast(i64, t + 1); b[t] = cast(i64, 2 * t - 3); t = t + 1; }
    tri(cast(*i64, &c), cast(*i64, &a), cast(*i64, &b), n, m);
    // c[i][j] = sum_k a[j][k] b[i][k] + b[j][k] a[i][k], for j <= i.
    let is i64 as sum with mut = 0;
    let is i32 as i with mut = 0;
    while (i < n) {
        let is i32 as j with mut = 0;
        while (j < n) {
            let is i64 as want with mut = 0;
            if (j <= i) {
                let is i32 as k with mut = 0;
                while (k < m) {
                    want = want + a[j * m + k] * b[i * m + k] + b[j * m + k] * a[i * m + k];
                    k = k + 1;
                }
            }
            if (c[i * n + j] != want) { return 4; }
            sum = sum + want;
            j = j + 1;
        }
        i = i + 1;
    }
    if (sum != 164360) { return 5; }

    // i = 0..99: sum i = 4950; multiples of 3 add i/2 (sum 1683 -> 841.5);
    // the others add 3i to wide (3 * (4950 - 1683) = 9801).
    if (mixed(100) != 4950.0 + 841.5 + 9801.0) { return 6; }
    return 0;
}
