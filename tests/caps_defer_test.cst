// More deferred calls in one scope than the defer stack held.
//
// The stack was a fixed 64 entries and push_defer returned silently past
// it, so the 65th `defer` in a scope never ran — the count came out one
// short with no diagnostic. The counter lives in main because a defer runs
// before each return of the scope that scheduled it, which makes a check
// inside `work` impossible to observe from the inside.
let is i32 as g with mut = 0;

fn bump() as void { g = g + 1; }

fn work() as void {
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
    defer bump();
}

fn main() as i32 {
    work();
    if (g != 65) { return 1; }
    return 0;
}
