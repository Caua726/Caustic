// The SSE2 map loop stores through an address of its own, which the code
// generator may fold into the store: x[i] = x[i] + z[i] once wrote into z.
let is [64]f64 as xs with mut;
let is [64]f64 as zs with mut;

fn add(x as *f64, z as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < 64) { x[i] = x[i] + z[i]; i = i + 1; }
}

fn main() as i32 {
    let is i32 as k with mut = 0;
    while (k < 64) { xs[k] = cast(f64, k); zs[k] = 1000.0; k = k + 1; }
    add(cast(*f64, &xs), cast(*f64, &zs));
    k = 0;
    while (k < 64) {
        if (xs[k] != cast(f64, k) + 1000.0) { return 1; }
        if (zs[k] != 1000.0) { return 2; }
        k = k + 1;
    }
    return 0;
}
