// Every way a program reaches a library's data. The exit code names what failed.
use "data_lib.cst" as l;

// R_X86_64_64 sites holding a library symbol's address, in .data and a custom section.
let is *u8 as get_fp = fn_ptr(l.lib_get);
let is *u8 as sec_fp with section(".csldata") = fn_ptr(l.lib_get);

fn main() as i32 {
    // One value: a write from here is what the library reads.
    l.counter = 41;
    if (l.lib_get() != 41) { return 1; }
    // And an access with an offset.
    l.lib_fill();
    if (l.lib_table[3] != 103) { return 2; }
    l.lib_table[5] = 7;
    if (l.lib_table_at(5) != 7) { return 3; }
    if (l.lib_pair.b != 9) { return 4; }
    if (l.lib_text[2] != cast(u8, 99)) { return 5; }
    // The initialized copy, read from here and written from here.
    if (l.seeded != 77) { return 6; }
    l.seeded = 78;
    if (l.lib_seeded() != 78) { return 7; }
    l.counter = 5;
    if (call(get_fp) != 5) { return 8; }
    l.counter = 6;
    if (call(sec_fp) != 6) { return 9; }
    return 0;
}
