// A library holding each kind of global a program can name: zero-initialized,
// initialized, an array, a struct and a string constant.
struct Pair { a as i64; b as i64; }

let is i64 as counter with mut = 0;
let is i64 as seeded with mut = 77;
let is [8]i64 as lib_table with mut;
let is Pair as lib_pair with mut;
let is *u8 as lib_text with imut = "abcdef";

fn lib_get() as i64 { return counter; }

fn lib_fill() as void {
    let is i64 as i with mut = 0;
    while (i < 8) { lib_table[i] = 100 + i; i = i + 1; }
    lib_pair.b = 9;
}

fn lib_table_at(i as i64) as i64 { return lib_table[i]; }
fn lib_seeded() as i64 { return seeded; }
