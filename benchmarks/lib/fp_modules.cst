// benchmarks/lib/fp_modules.cst — the eight floating-point modules shared by
// the programs in kernels/fp_modules. Not a benchmark: run.cst skips lib/.
//
// Each module is a long f64 loop whose result has a known exact value; the
// module returns its error against that value. Modules 3 to 8 integrate
// with the trapezoidal rule, using truncated polynomial series for sin and
// cos (coefficients A and B below). The programs print each error scaled
// by 1e-30, so only its sign shows, next to timing columns kept at zero:
// the printed text then does not depend on the machine.
// Output goes to stdout through `say`, which also keeps a 64-bit FNV-1a
// checksum of everything printed for the programs' self-check.
use "../../std/io.cst" as io;

let is u64 as out_hash with mut = 14695981039346656037;

// Series coefficients: sin (A), cos (B), the rational integrand of module 1
// (D, E).
let is f64 as A0 = 1.0;
let is f64 as A1 = 0.0 - 0.1666666666671334;
let is f64 as A2 = 0.833333333809067E-2;
let is f64 as A3 = 0.198412715551283E-3;
let is f64 as A4 = 0.27557589750762E-5;
let is f64 as A5 = 0.2507059876207E-7;
let is f64 as A6 = 0.164105986683E-9;
let is f64 as B1 = 0.0 - 0.4999999999982;
let is f64 as B2 = 0.4166666664651E-1;
let is f64 as B3 = 0.0 - 0.1388888805755E-2;
let is f64 as B4 = 0.24801428034E-4;
let is f64 as B5 = 0.0 - 0.2754213324E-6;
let is f64 as B6 = 0.20189405E-8;
let is f64 as D1 = 0.3999999946405E-1;
let is f64 as D2 = 0.96E-3;
let is f64 as D3 = 0.1233153E-5;
let is f64 as E2 = 0.48E-3;
let is f64 as E3 = 0.411051E-6;
let is f64 as PI_REF = 3.14159265358979324;

fn say(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn say_text(s as *u8) as void { say(s, io.strlen(s)); }

fn header() as void {
    say_text("\n");
    say_text("   FLOPS C Program (Double Precision), V2.0 18 Dec 1992\n\n");
    say_text("   Module     Error        RunTime      MFLOPS\n");
    say_text("                            (usec)\n");
}

// One result line: the module number, its error and two zero timings.
fn line(module as i32, err as f64) as void {
    let is [128]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    say(bp, io.sprintf(bp, 128, "     %d   %13.4lf  %10.4lf  %10.4lf\n", module, err * 1e-30, 0.0, 0.0));
}

// sin(u) and cos(u) from the series, w = u * u; a3 and a5 are passed in
// because one program flips their signs part way through.
fn sin_poly(w as f64, a3 as f64, a5 as f64) as f64 {
    return (((((A6 * w + a5) * w + A4) * w + a3) * w + A2) * w + A1) * w + 1.0;
}

fn sin_series(u as f64, w as f64, a3 as f64, a5 as f64) as f64 {
    return u * sin_poly(w, a3, a5);
}

fn cos_series(w as f64) as f64 {
    return w * (w * (w * (w * (w * (B6 * w + B5) + B4) + B3) + B2) + B1) + 1.0;
}

// Module 1: integral of a rational function over [0, 1] in n steps; its
// reciprocal should be near 25.2. Writes the step count module 2 onward
// use, 40000 * trunc(1/result) / scale, to *next_n.
fn rational_integral(n as i64, scale as f64, next_n as *i64) as f64 {
    let is f64 as x = 1.0 / cast(f64, n);
    let is f64 as s with mut = 0.0;
    let is f64 as v with mut = 0.0;
    let is f64 as w = 1.0;
    let is i64 as i with mut = 1;
    while (i <= n - 1) {
        v = v + w;
        let is f64 as u = v * x;
        s = s + (D1 + u * (D2 + u * D3)) / (w + u * (D1 + u * (E2 + u * E3)));
        i = i + 1;
    }
    let is f64 as ends = (D1 + D2 + D3) / (1.0 + D1 + E2 + E3);
    let is f64 as sa = x * (ends + D1 + 2.0 * s) / 2.0;
    let is f64 as sb = 1.0 / sa;
    *next_n = cast(i64, cast(f64, 40000 * cast(i64, sb)) / scale);
    return sb - 25.2;
}

// Module 2: pi from m terms of the series for atan(1), after a first loop
// that only alternates the sign of s. Writes the step count the next
// modules use, trunc(sa * x / m) from the loop's sums, to *next_m.
fn pi_series(m as i64, next_m as *i64) as f64 {
    let is f64 as s with mut = 0.0 - 5.0;
    let is f64 as sa with mut = 0.0 - 1.0;
    let is i64 as i with mut = 1;
    while (i <= m) {
        s = 0.0 - s;
        sa = sa + s;
        i = i + 1;
    }
    let is f64 as u with mut = sa;
    let is f64 as v with mut = 0.0;
    let is f64 as w with mut = 0.0;
    let is f64 as x with mut = 0.0;
    i = 1;
    while (i <= m) {
        s = 0.0 - s;
        sa = sa + s;
        u = u + 2.0;
        x = x + (s - u);
        v = v - s * u;
        w = w + s / u;
        i = i + 1;
    }
    *next_m = cast(i64, sa * x / cast(f64, m));
    let is f64 as est = 4.0 * w / 5.0 + 5.0 / v;
    let is f64 as piprg = est - 31.25 / (v * v * v);
    return piprg - PI_REF;
}

// Module 3: integral of sin over [0, pi/3] (exactly 0.5), with the series'
// odd terms subtracted (the signs of A3 and A5 as first given).
fn sine_integral(m as i64) as f64 {
    let is f64 as x = PI_REF / (3.0 * cast(f64, m));
    let is f64 as s with mut = 0.0;
    let is f64 as v with mut = 0.0;
    let is i64 as i with mut = 1;
    while (i <= m - 1) {
        v = v + 1.0;
        let is f64 as u = v * x;
        let is f64 as w = u * u;
        s = s + u * ((((((A6 * w - A5) * w + A4) * w - A3) * w + A2) * w + A1) * w + 1.0);
        i = i + 1;
    }
    let is f64 as u = PI_REF / 3.0;
    let is f64 as w = u * u;
    let is f64 as end = u * ((((((A6 * w - A5) * w + A4) * w - A3) * w + A2) * w + A1) * w + 1.0);
    return x * (end + 2.0 * s) / 2.0 - 0.5;
}

// Module 4: integral of cos over [0, pi/3], against the sin series at pi/3.
fn cosine_integral(m as i64, a3 as f64, a5 as f64) as f64 {
    let is f64 as x = PI_REF / (3.0 * cast(f64, m));
    let is f64 as s with mut = 0.0;
    let is i64 as i with mut = 1;
    while (i <= m - 1) {
        let is f64 as u = cast(f64, i) * x;
        let is f64 as w = u * u;
        s = s + w * (w * (w * (w * (w * (B6 * w + B5) + B4) + B3) + B2) + B1) + 1.0;
        i = i + 1;
    }
    let is f64 as u = PI_REF / 3.0;
    let is f64 as w = u * u;
    let is f64 as sa = x * (cos_series(w) + 1.0 + 2.0 * s) / 2.0;
    let is f64 as sb = u * ((((((A6 * w + a5) * w + A4) * w + a3) * w + A2) * w + A1) * w + A0);
    return sa - sb;
}

// Module 5: integral of tan over [0, pi/3] (ln 2).
fn tangent_integral(m as i64, a3 as f64, a5 as f64) as f64 {
    let is f64 as x = PI_REF / (3.0 * cast(f64, m));
    let is f64 as s with mut = 0.0;
    let is i64 as i with mut = 1;
    while (i <= m - 1) {
        let is f64 as u = cast(f64, i) * x;
        let is f64 as w = u * u;
        s = s + sin_series(u, w, a3, a5) / cos_series(w);
        i = i + 1;
    }
    let is f64 as u = PI_REF / 3.0;
    let is f64 as w = u * u;
    let is f64 as end = sin_series(u, w, a3, a5) / cos_series(w);
    return x * (end + 2.0 * s) / 2.0 - 0.6931471805599453;
}

// Module 6: integral of sin * cos over [0, pi/4] (0.25).
fn sine_cosine_integral(m as i64, a3 as f64, a5 as f64) as f64 {
    let is f64 as x = PI_REF / (4.0 * cast(f64, m));
    let is f64 as s with mut = 0.0;
    let is i64 as i with mut = 1;
    while (i <= m - 1) {
        let is f64 as u = cast(f64, i) * x;
        let is f64 as w = u * u;
        s = s + sin_series(u, w, a3, a5) * cos_series(w);
        i = i + 1;
    }
    let is f64 as u = PI_REF / 4.0;
    let is f64 as w = u * u;
    let is f64 as end = sin_series(u, w, a3, a5) * cos_series(w);
    return x * (end + 2.0 * s) / 2.0 - 0.25;
}

// Module 7: integrals of 1/(x+1), x/(x^2+1) and x^2/(x^3+1) over
// [0, 102.33...], combined so the result is near -500.2. Writes the next
// step count, -2000 * trunc(result) / scale, to *next_m.
fn reciprocal_integrals(m as i64, scale as f64, next_m as *i64) as f64 {
    let is f64 as w = 1.0;
    let is f64 as top = 102.3321513995275;
    let is f64 as v = top / cast(f64, m);
    let is f64 as s with mut = 0.0;
    let is i64 as i with mut = 1;
    while (i <= m - 1) {
        let is f64 as x = cast(f64, i) * v;
        let is f64 as u = x * x;
        s = s - w / (x + w) - x / (u + w) - u / (x * u + w);
        i = i + 1;
    }
    let is f64 as u = top * top;
    let is f64 as end = 0.0 - w - w / (top + w) - top / (u + w) - u / (top * u + w);
    let is f64 as sa = 18.0 * v * (end + 2.0 * s);
    let is i64 as next = 0 - 2000 * cast(i64, sa);
    *next_m = cast(i64, cast(f64, next) / scale);
    return sa + 500.2;
}

// Module 8: integral of sin * cos^2 over [0, pi/3] (7/24).
fn sine_cosine_squared_integral(m as i64, a3 as f64, a5 as f64) as f64 {
    let is f64 as x = PI_REF / (3.0 * cast(f64, m));
    let is f64 as s with mut = 0.0;
    let is i64 as i with mut = 1;
    while (i <= m - 1) {
        let is f64 as u = cast(f64, i) * x;
        let is f64 as w = u * u;
        let is f64 as c = cos_series(w);
        s = s + c * c * u * sin_poly(w, a3, a5);
        i = i + 1;
    }
    let is f64 as u = PI_REF / 3.0;
    let is f64 as w = u * u;
    let is f64 as c = cos_series(w);
    let is f64 as end = sin_series(u, w, a3, a5) * c * c;
    return x * (end + 2.0 * s) / 2.0 - 0.29166666666666667;
}
