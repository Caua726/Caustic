// The size of a run: the number the command line gives at `index`, or
// `otherwise` when it gives none. Read at run time on purpose, because a program
// that takes its size from its arguments cannot have it folded by the compiler.

fn number(argc as i64, argv as *u8, index as i64, otherwise as i64) as i64 {
    if (argc <= index) { return otherwise; }
    let is *i64 as args = cast(*i64, argv);
    let is *u8 as s = cast(*u8, args[index]);
    let is i64 as v with mut = 0;
    let is i64 as k with mut = 0;
    while (s[k] >= 48 && s[k] <= 57) { v = v * 10 + cast(i64, s[k]) - 48; k = k + 1; }
    return v;
}
