// Pancake flipping over all 11! permutations of 1..11: for every permutation
// whose first and last elements are not already in place, reverse the
// leading run until 1 comes first and count the reversals; report the most.
// The first 30 permutations, in generation order, are printed.
// Self-check: the maximum (51) and a hash of the printed permutations.
use "../../std/io.cst" as io;

let is u64 as out_hash with mut = 14695981039346656037;

fn hash_bytes(b as *u8, len as i64) as void {
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn flips_max(n as i32) as i64 {
    let is [32]i32 as perm;
    let is [32]i32 as perm1;
    let is [32]i32 as count;
    let is [512]u8 as line;
    let is i64 as most with mut = 0;
    let is i32 as n1 = n - 1;
    let is i32 as i with mut = 0;
    while (i < n) { perm1[i] = i; count[i] = 0; i = i + 1; }

    let is i32 as r with mut = n;
    let is i32 as printed with mut = 0;
    while (1 == 1) {
        if (printed < 30) {
            let is i64 as len with mut = 0;
            i = 0;
            while (i < n) {
                len = len + io.sprintf(cast(*u8, cast(i64, &line) + len), 16, "%d", perm1[i] + 1);
                i = i + 1;
            }
            line[len] = 10;
            len = len + 1;
            io.write_bytes(io.STDOUT, cast(*u8, &line), len);
            hash_bytes(cast(*u8, &line), len);
            printed = printed + 1;
        }
        while (r != 1) { count[r - 1] = r; r = r - 1; }

        if (perm1[0] != 0 && perm1[n1] != n1) {
            let is i64 as flips with mut = 0;
            i = 1;
            while (i < n) { perm[i] = perm1[i]; i = i + 1; }
            let is i32 as k with mut = perm1[0];   // perm[0], kept in a register
            while (k != 0) {
                let is i32 as lo with mut = 1;
                let is i32 as hi with mut = k - 1;
                while (lo < hi) {
                    let is i32 as t = perm[lo];
                    perm[lo] = perm[hi];
                    perm[hi] = t;
                    lo = lo + 1;
                    hi = hi - 1;
                }
                flips = flips + 1;
                let is i32 as nk = perm[k];
                perm[k] = k;
                k = nk;
            }
            if (most < flips) { most = flips; }
        }

        // Next permutation: rotate the first r+1 elements left by one, carry
        // into the next counter when this one runs out.
        while (1 == 1) {
            if (r == n) { return most; }
            let is i32 as first = perm1[0];
            i = 0;
            while (i < r) { perm1[i] = perm1[i + 1]; i = i + 1; }
            perm1[r] = first;
            count[r] = count[r] - 1;
            if (count[r] > 0) { break; }
            r = r + 1;
        }
    }
    return most;
}

fn main() as i32 {
    let is i32 as n = 11;
    let is i64 as most = flips_max(n);
    io.printf("Pfannkuchen(%d) = %ld\n", n, most);
    if (most != 51) { return 1; }
    if (out_hash != 8699121779807628397) { return 1; }
    return 0;
}
