// A 20-round add-rotate-xor stream cipher core (four column rounds and four
// row rounds per double round, on a 4x4 block of u32 words), drawing
// 537919489 words one at a time from 64-byte blocks, with the first word
// of the state as the block counter.
// Self-check: the last word drawn must be 0xf655703d (also the exit code's
// test), and the printed lines hash to the expected value.
use "../../std/io.cst" as io;

let is [16]u32 as state with mut;
let is [16]u32 as block with mut;
let is u32 as pos with mut = 0;
let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn rotl(v as u32, s as u32) as u32 {
    return (v << s) | (v >> (32 - s));
}

// One quarter round on words a, b, c, d of x.
fn quarter(x as *u32, a as i64, b as i64, c as i64, d as i64) as void {
    x[b] = x[b] ^ rotl(x[a] + x[d], 7);
    x[c] = x[c] ^ rotl(x[b] + x[a], 9);
    x[d] = x[d] ^ rotl(x[c] + x[b], 13);
    x[a] = x[a] ^ rotl(x[d] + x[c], 18);
}

fn core(out as *u32, input as *u32) as void {
    let is [16]u32 as w;
    let is *u32 as x = cast(*u32, &w);
    let is i64 as i with mut = 0;
    while (i < 16) { x[i] = input[i]; i = i + 1; }
    let is i32 as r with mut = 20;
    while (r > 0) {
        quarter(x, 0, 4, 8, 12);
        quarter(x, 5, 9, 13, 1);
        quarter(x, 10, 14, 2, 6);
        quarter(x, 15, 3, 7, 11);
        quarter(x, 0, 1, 2, 3);
        quarter(x, 5, 6, 7, 4);
        quarter(x, 10, 11, 8, 9);
        quarter(x, 15, 12, 13, 14);
        r = r - 2;
    }
    i = 0;
    while (i < 16) { out[i] = x[i] + input[i]; i = i + 1; }
}

// The next word of the stream; a new block is made every 16 words.
fn next_word() as u32 {
    if (pos == 0) {
        core(cast(*u32, &block), cast(*u32, &state));
        state[0] = state[0] + 1;
    }
    pos = (pos + 1) & 15;
    return block[pos];
}

fn main() as i32 {
    let is u32 as i with mut = 0;
    while (i < 16) {
        state[i] = (0xedababe5 + (i + 13)) ^ (0xdeadbeef - i);
        i = i + 1;
    }
    i = 0;
    while (i < 537919488) { next_word(); i = i + 1; }
    let is u32 as val = next_word();
    let is [64]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    emit(bp, io.sprintf(bp, 64, "got:       %x\n", val));
    emit(bp, io.sprintf(bp, 64, "should be: %x\n", 0xf655703d));
    if (val != 0xf655703d) { return 1; }
    if (out_hash != 9265983256963960031) { return 2; }
    return 0;
}
