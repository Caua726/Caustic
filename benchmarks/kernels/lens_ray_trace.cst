// Optical ray tracing through a four-surface achromatic telescope objective
// (the 4-inch design worked by hand in the amateur telescope-making
// literature), 1000000 times: a marginal and a paraxial ray in the D line,
// marginal rays in the C and F lines, by Snell's law at each spherical
// surface with sin, asin, tan and cos; then the longitudinal spherical
// aberration, the offense against the sine condition and the axial
// chromatic aberration. The results, printed to 11 decimals, must equal
// reference values exactly.
// Self-check: all eight result lines match their references, and the
// printed text hashes to the expected value.
use "../../std/io.cst" as io;
use "../../std/math.cst" as math;

let is i32 as ITERATIONS with imut = 1000000;

// Surfaces 1..4: radius of curvature, refractive index, dispersion, edge
// thickness.
let is [25]f64 as surf with mut;
let is [9]f64 as line_wl with mut;      // spectral lines A..H, 1-based
let is i32 as surfaces with mut = 4;
let is i32 as paraxial with mut = 0;

let is f64 as radius with mut = 0.0;
let is f64 as obj_dist with mut = 0.0;
let is f64 as ray_h with mut = 0.0;
let is f64 as slope with mut = 0.0;
let is f64 as from_n with mut = 0.0;
let is f64 as to_n with mut = 0.0;

let is u64 as out_hash with mut = 14695981039346656037;

fn say(s as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, s, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, s[k])) * 1099511628211; k = k + 1; }
}

fn say_text(s as *u8) as void { say(s, io.strlen(s)); }

fn sf(i as i32, j as i32) as f64 { return surf[i * 5 + j]; }

fn set_surface(i as i32, r as f64, n as f64, v as f64, t as f64) as void {
    surf[i * 5 + 1] = r;
    surf[i * 5 + 2] = n;
    surf[i * 5 + 3] = v;
    surf[i * 5 + 4] = t;
}

// Carries the ray across one surface, paraxially or exactly.
fn cross_surface() as void {
    if (paraxial == 1) {
        if (radius != 0.0) {
            let is f64 as isin with mut = 0.0;
            if (obj_dist == 0.0) {
                slope = 0.0;
                isin = ray_h / radius;
            } else {
                isin = ((obj_dist - radius) / radius) * slope;
            }
            let is f64 as rsin = (from_n / to_n) * isin;
            let is f64 as old = slope;
            slope = slope + isin - rsin;
            if (obj_dist != 0.0) { ray_h = obj_dist * old; }
            obj_dist = ray_h / slope;
            return;
        }
        obj_dist = obj_dist * (to_n / from_n);
        slope = slope * (from_n / to_n);
        return;
    }
    if (radius != 0.0) {
        let is f64 as isin with mut = 0.0;
        if (obj_dist == 0.0) {
            slope = 0.0;
            isin = ray_h / radius;
        } else {
            isin = ((obj_dist - radius) / radius) * math.sin(slope);
        }
        let is f64 as iang = math.asin(isin);
        let is f64 as rsin = (from_n / to_n) * isin;
        let is f64 as old = slope;
        slope = slope + iang - math.asin(rsin);
        let is f64 as sag with mut = math.sin((old + iang) / 2.0);
        sag = 2.0 * radius * sag * sag;
        obj_dist = ((radius * math.sin(old + iang)) * (1.0 / math.tan(slope))) + sag;
        return;
    }
    let is f64 as rang = 0.0 - math.asin((from_n / to_n) * math.sin(slope));
    obj_dist = obj_dist * ((to_n * math.cos(0.0 - rang)) / (from_n * math.cos(slope)));
    slope = 0.0 - rang;
}

// Traces a ray of height h in spectral line `wl` through all surfaces.
fn trace(wl as i32, h as f64) as void {
    obj_dist = 0.0;
    ray_h = h;
    from_n = 1.0;
    let is i32 as i with mut = 1;
    while (i <= surfaces) {
        radius = sf(i, 1);
        to_n = sf(i, 2);
        if (to_n > 1.0) {
            to_n = to_n + ((line_wl[4] - line_wl[wl]) / (line_wl[3] - line_wl[6])) * ((sf(i, 2) - 1.0) / sf(i, 3));
        }
        cross_surface();
        from_n = to_n;
        if (i < surfaces) { obj_dist = obj_dist - sf(i, 4); }
        i = i + 1;
    }
}

fn main() as i32 {
    line_wl[1] = 7621.0;
    line_wl[2] = 6869.955;
    line_wl[3] = 6562.816;
    line_wl[4] = 5895.944;
    line_wl[5] = 5269.557;
    line_wl[6] = 4861.344;
    line_wl[7] = 4340.477;
    line_wl[8] = 3968.494;
    let is f64 as aperture = 4.0;
    set_surface(1, 27.05, 1.5137, 63.6, 0.52);
    set_surface(2, 0.0 - 16.68, 1.0, 0.0, 0.138);
    set_surface(3, 0.0 - 16.68, 1.6164, 36.7, 0.38);
    set_surface(4, 0.0 - 78.1, 1.0, 0.0, 0.0);

    let is [160]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    say_text("Ready to begin John Walker's floating point accuracy\n");
    say(bp, io.sprintf(bp, 160, "and performance benchmark.  %d iterations will be made.\n\n", ITERATIONS));
    say(bp, io.sprintf(bp, 160, "\nMeasured run time in seconds should be divided by %.f\n", cast(f64, ITERATIONS) / 1000.0));
    say_text("to normalise for reporting results.  For archival results,\n");
    say_text("adjust iteration count so the benchmark runs about five minutes.\n\n");

    let is [4]f64 as od_sa;          // [paraxial * 2 + 0] distance, + 1 slope
    let is f64 as od_c with mut = 0.0;
    let is f64 as od_f with mut = 0.0;
    let is f64 as lspher with mut = 0.0;
    let is f64 as osc with mut = 0.0;
    let is f64 as lchrom with mut = 0.0;
    let is f64 as max_lspher with mut = 0.0;
    let is f64 as max_osc with mut = 0.0;
    let is f64 as max_lchrom with mut = 0.0;
    let is i32 as it with mut = 0;
    while (it < ITERATIONS) {
        paraxial = 0;
        while (paraxial <= 1) {
            trace(4, aperture / 2.0);
            od_sa[paraxial * 2] = obj_dist;
            od_sa[paraxial * 2 + 1] = slope;
            paraxial = paraxial + 1;
        }
        paraxial = 0;
        trace(3, aperture / 2.0);
        od_c = obj_dist;
        trace(6, aperture / 2.0);
        od_f = obj_dist;
        lspher = od_sa[2] - od_sa[0];
        osc = 1.0 - (od_sa[2] * od_sa[3]) / (math.sin(od_sa[1]) * od_sa[0]);
        lchrom = od_f - od_c;
        max_lspher = math.sin(od_sa[1]);
        max_lspher = 0.0000926 / (max_lspher * max_lspher);
        max_osc = 0.0025;
        max_lchrom = max_lspher;
        it = it + 1;
    }

    let is [8]*u8 as want;
    want[0] = "   Marginal ray          47.09479120920   0.04178472683";
    want[1] = "   Paraxial ray          47.08372160249   0.04177864821";
    want[2] = "Longitudinal spherical aberration:        -0.01106960671";
    want[3] = "    (Maximum permissible):                 0.05306749907";
    want[4] = "Offense against sine condition (coma):     0.00008954761";
    want[5] = "    (Maximum permissible):                 0.00250000000";
    want[6] = "Axial chromatic aberration:                0.00448229032";
    want[7] = "    (Maximum permissible):                 0.05306749907";
    let is [640]u8 as got_buf;
    let is *u8 as got = cast(*u8, &got_buf);
    io.sprintf(got, 80, "%15s   %21.11f  %14.11f", "Marginal ray", od_sa[0], od_sa[1]);
    io.sprintf(cast(*u8, cast(i64, got) + 80), 80, "%15s   %21.11f  %14.11f", "Paraxial ray", od_sa[2], od_sa[3]);
    io.sprintf(cast(*u8, cast(i64, got) + 160), 80, "Longitudinal spherical aberration:      %16.11f", lspher);
    io.sprintf(cast(*u8, cast(i64, got) + 240), 80, "    (Maximum permissible):              %16.11f", max_lspher);
    io.sprintf(cast(*u8, cast(i64, got) + 320), 80, "Offense against sine condition (coma):  %16.11f", osc);
    io.sprintf(cast(*u8, cast(i64, got) + 400), 80, "    (Maximum permissible):              %16.11f", max_osc);
    io.sprintf(cast(*u8, cast(i64, got) + 480), 80, "Axial chromatic aberration:             %16.11f", lchrom);
    io.sprintf(cast(*u8, cast(i64, got) + 560), 80, "    (Maximum permissible):              %16.11f", max_lchrom);

    let is i32 as errors with mut = 0;
    let is i32 as i with mut = 0;
    while (i < 8) {
        let is *u8 as r = want[i];
        let is *u8 as g = cast(*u8, cast(i64, got) + cast(i64, i) * 80);
        let is i64 as k with mut = 0;
        while (r[k] != 0 && r[k] == g[k]) { k = k + 1; }
        if (r[k] != g[k]) {
            say(bp, io.sprintf(bp, 160, "\nError in results on line %d...\n", i + 1));
            say(bp, io.sprintf(bp, 160, "Expected:  \"%s\"\n", r));
            say(bp, io.sprintf(bp, 160, "Received:  \"%s\"\n", g));
            say_text("(Errors)    ");
            let is i64 as n = io.strlen(r);
            k = 0;
            while (k < n) {
                if (r[k] == g[k]) { say_text(" "); } else { say_text("^"); errors = errors + 1; }
                k = k + 1;
            }
            say_text("\n");
        }
        i = i + 1;
    }
    if (errors > 0) {
        let is *u8 as plural with mut = "";
        if (errors > 1) { plural = "s"; }
        say(bp, io.sprintf(bp, 160, "\n%d error%s in results.  This is VERY SERIOUS.\n", errors, plural));
        return 1;
    }
    say_text("\nNo errors in results.\n");
    if (out_hash != 8113963012318922599) { return 2; }
    return 0;
}
