// Two-dimensional complex FFT of a 256x256 f64 grid (a lattice of lines
// every 16 cells), forward then inverse, 63 times without rescaling, by the
// general multi-dimensional radix-2 transform: bit-reversal reordering along
// each dimension, then butterflies with twiddles from a sine recurrence.
// The result, mapped linearly onto 0..255 by the range of the real parts,
// must give back the lines (255) and the background (0) everywhere.
// Output goes to stderr.
// Self-check: no mismatched cell, and the hash of the printed line.
use "../../std/io.cst" as io;
use "../../std/math.cst" as math;
use "../../std/mem.cst" as mem;

let is i32 as EDGE with imut = 256;
let is i32 as PASSES with imut = 63;
let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDERR, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

// In-place transform of data[1..2*total] (interleaved re, im) with
// dims[1..ndim] points per dimension, the last one varying fastest;
// sign +1 forward, -1 inverse (unscaled).
fn transform(data as *f64, dims as *i32, ndim as i32, sign as i32) as void {
    let is i32 as total with mut = 1;
    let is i32 as d with mut = 1;
    while (d <= ndim) { total = total * dims[d]; d = d + 1; }
    let is i32 as before with mut = 1;
    d = ndim;
    while (d >= 1) {
        let is i32 as n = dims[d];
        let is i32 as after = total / (n * before);
        let is i32 as step1 = before << 1;
        let is i32 as step2 = step1 * n;
        let is i32 as span = step2 * after;
        // Bit reversal along this dimension.
        let is i32 as rev with mut = 1;
        let is i32 as i2 with mut = 1;
        while (i2 <= step2) {
            if (i2 < rev) {
                let is i32 as i1 with mut = i2;
                while (i1 <= i2 + step1 - 2) {
                    let is i32 as i3 with mut = i1;
                    while (i3 <= span) {
                        let is i32 as r3 = rev + i3 - i2;
                        let is f64 as t0 = data[i3];
                        data[i3] = data[r3];
                        data[r3] = t0;
                        let is f64 as t1 = data[i3 + 1];
                        data[i3 + 1] = data[r3 + 1];
                        data[r3 + 1] = t1;
                        i3 = i3 + step2;
                    }
                    i1 = i1 + 2;
                }
            }
            let is i32 as bit with mut = step2 >> 1;
            while (bit >= step1 && rev > bit) {
                rev = rev - bit;
                bit = bit >> 1;
            }
            rev = rev + bit;
            i2 = i2 + step1;
        }
        // Butterflies of growing length.
        let is i32 as half with mut = step1;
        while (half < step2) {
            let is i32 as full = half << 1;
            let is f64 as theta = cast(f64, sign) * 6.28318530717959 / cast(f64, full / step1);
            let is f64 as sh = math.sin(0.5 * theta);
            let is f64 as wpr = 0.0 - 2.0 * sh * sh;
            let is f64 as wpi = math.sin(theta);
            let is f64 as wr with mut = 1.0;
            let is f64 as wi with mut = 0.0;
            let is i32 as i3 with mut = 1;
            while (i3 <= half) {
                let is i32 as i1 with mut = i3;
                while (i1 <= i3 + step1 - 2) {
                    let is i32 as k1 with mut = i1;
                    while (k1 <= span) {
                        let is i32 as k2 = k1 + half;
                        let is f64 as tr = wr * data[k2] - wi * data[k2 + 1];
                        let is f64 as ti = wr * data[k2 + 1] + wi * data[k2];
                        data[k2] = data[k1] - tr;
                        data[k2 + 1] = data[k1 + 1] - ti;
                        data[k1] = data[k1] + tr;
                        data[k1 + 1] = data[k1 + 1] + ti;
                        k1 = k1 + full;
                    }
                    i1 = i1 + 2;
                }
                let is f64 as wold = wr;
                wr = wold * wpr - wi * wpi + wr;
                wi = wi * wpr + wold * wpi + wi;
                i3 = i3 + step1;
            }
            half = full;
        }
        before = before * n;
        d = d - 1;
    }
}

fn on_line(i as i32, j as i32) as i32 {
    if ((i & 15) == 8 || (j & 15) == 8) { return 1; }
    return 0;
}

fn main() as i32 {
    let is i64 as cells = cast(i64, EDGE * EDGE);
    let is *f64 as data = cast(*f64, mem.core.mmap_anon((cells + 1) * 16));
    let is [3]i32 as dims;
    dims[0] = 0;
    dims[1] = EDGE;
    dims[2] = EDGE;
    let is i32 as i with mut = 0;
    while (i < EDGE) {
        let is i32 as j with mut = 0;
        while (j < EDGE) {
            if (on_line(i, j) == 1) { data[1 + (EDGE * i + j) * 2] = 128.0; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < PASSES) {
        transform(data, cast(*i32, &dims), 2, 1);
        transform(data, cast(*i32, &dims), 2, 0 - 1);
        i = i + 1;
    }

    // Range of the values in the first half of the array, read as pairs.
    let is f64 as rmin with mut = 10000000000.0;
    let is f64 as rmax with mut = 0.0 - 10000000000.0;
    let is i64 as x with mut = 1;
    while (x <= cells) {
        let is f64 as r = data[x];
        if (r < rmin) { rmin = r; }
        if (r > rmax) { rmax = r; }
        x = x + 2;
    }
    let is f64 as base = rmin;
    let is f64 as scale = 255.0 / (rmax - rmin);

    let is [128]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    let is i32 as wrong with mut = 0;
    i = 0;
    while (i < EDGE) {
        let is i32 as j with mut = 0;
        while (j < EDGE) {
            let is i32 as got = cast(i32, (data[1 + (EDGE * i + j) * 2] - base) * scale);
            let is i32 as want with mut = 0;
            if (on_line(i, j) == 1) { want = 255; }
            if (got != want) {
                wrong = wrong + 1;
                emit(bp, io.sprintf(bp, 128, "Wrong answer at (%d,%d)!  Expected %d, got %d.\n", i, j, want, got));
            }
            j = j + 1;
        }
        i = i + 1;
    }
    if (wrong == 0) {
        emit(bp, io.sprintf(bp, 128, "%d passes.  No errors in results.\n", PASSES));
    } else {
        emit(bp, io.sprintf(bp, 128, "%d passes.  %d errors in results.\n", PASSES, wrong));
        return 1;
    }
    if (out_hash != 16541053154634238708) { return 2; }
    return 0;
}
