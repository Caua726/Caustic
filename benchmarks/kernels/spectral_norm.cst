// Spectral norm of the infinite matrix A(i,j) = 1/((i+j)(i+j+1)/2 + i + 1),
// truncated to 2000x2000, by 10 rounds of the power method on A^T A.
// Self-check: the printed norm.
use "../../std/io.cst" as io;
use "../../std/math.cst" as math;

let is i32 as N with imut = 2000;
let is [2000]f64 as u with mut;
let is [2000]f64 as v with mut;
let is [2000]f64 as tmp with mut;

fn eval_a(i as i32, j as i32) as f64 {
    return 1.0 / cast(f64, (i + j) * (i + j + 1) / 2 + i + 1);
}

fn a_times(n as i32, x as *f64, ax as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < n) {
        ax[i] = 0.0;
        let is i32 as j with mut = 0;
        while (j < n) { ax[i] = ax[i] + eval_a(i, j) * x[j]; j = j + 1; }
        i = i + 1;
    }
}

fn at_times(n as i32, x as *f64, ax as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < n) {
        ax[i] = 0.0;
        let is i32 as j with mut = 0;
        while (j < n) { ax[i] = ax[i] + eval_a(j, i) * x[j]; j = j + 1; }
        i = i + 1;
    }
}

fn ata_times(n as i32, x as *f64, out as *f64) as void {
    a_times(n, x, cast(*f64, &tmp));
    at_times(n, cast(*f64, &tmp), out);
}

fn main() as i32 {
    let is i32 as i with mut = 0;
    while (i < N) { u[i] = 1.0; i = i + 1; }
    i = 0;
    while (i < 10) {
        ata_times(N, cast(*f64, &u), cast(*f64, &v));
        ata_times(N, cast(*f64, &v), cast(*f64, &u));
        i = i + 1;
    }
    let is f64 as vbv with mut = 0.0;
    let is f64 as vv with mut = 0.0;
    i = 0;
    while (i < N) { vbv = vbv + u[i] * v[i]; vv = vv + v[i] * v[i]; i = i + 1; }
    let is [64]u8 as buf;
    let is *u8 as b = cast(*u8, &buf);
    let is i64 as len = io.sprintf(b, 64, "%0.9f\n", math.sqrt(vbv / vv));
    io.write_bytes(io.STDOUT, b, len);
    let is *u8 as want = "1.274224152\n";
    let is i64 as k with mut = 0;
    while (k <= len) { if (b[k] != want[k]) { return 1; } k = k + 1; }
    return 0;
}
