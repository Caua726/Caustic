// DNA sequence generator: 10 million characters cycled from a fixed
// sequence, then 15 million and 25 million drawn from two weighted alphabets
// by linear search over single-precision cumulative probabilities, all in
// 60-column lines (about 51 MB of output).
// Self-check: the generator's final state and a sum over the drawn letters.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

struct Amino {
    p as f32;
    c as u8;
}

let is i64 as WIDTH with imut = 60;
let is u64 as last with mut = 42;
let is u64 as drawn_sum with mut = 0;
let is [15]Amino as iub with mut;
let is [4]Amino as homo with mut;
let is [65536]u8 as obuf with mut;
let is io.Writer as out with mut;
let is mem.bins.Bins as heap with mut;

fn myrandom(max as f32) as f32 {
    last = (last * 3877 + 29573) % 139968;
    return max * cast(f32, cast(i64, last)) / cast(f32, 139968);
}

fn set(list as *Amino, k as i32, p as f32, c as u8) as void {
    list[k].p = p;
    list[k].c = c;
}

fn accumulate(list as *Amino, len as i32) as void {
    let is f32 as cp with mut = 0.0;
    let is i32 as i with mut = 0;
    while (i < len) {
        cp = cp + list[i].p;
        list[i].p = cp;
        i = i + 1;
    }
}

fn repeat_fasta(s as *u8, count0 as i64) as void {
    let is i64 as len = io.strlen(s);
    let is *u8 as s2 = mem.bins.bins_alloc(&heap, len + WIDTH);
    mem.memcpy(s2, s, len);
    mem.memcpy(cast(*u8, cast(i64, s2) + len), s, WIDTH);
    let is i64 as count with mut = count0;
    let is i64 as pos with mut = 0;
    while (count > 0) {
        let is i64 as line with mut = WIDTH;
        if (count < line) { line = count; }
        io.writer_bytes(&out, cast(*u8, cast(i64, s2) + pos), line);
        io.put(&out, 10);
        pos = pos + line;
        if (pos >= len) { pos = pos - len; }
        count = count - line;
    }
    mem.bins.bins_free(&heap, s2);
}

fn random_fasta(list as *Amino, count0 as i64) as void {
    let is [61]u8 as buf;
    let is i64 as count with mut = count0;
    while (count > 0) {
        let is i64 as line with mut = WIDTH;
        if (count < line) { line = count; }
        let is i64 as pos with mut = 0;
        while (pos < line) {
            let is f32 as r = myrandom(1.0);
            let is i64 as i with mut = 0;
            while (list[i].p < r) { i = i + 1; }
            buf[pos] = list[i].c;
            drawn_sum = drawn_sum + cast(u64, list[i].c);
            pos = pos + 1;
        }
        buf[line] = 10;
        io.writer_bytes(&out, cast(*u8, &buf), line + 1);
        count = count - line;
    }
}

fn main() as i32 {
    let is i64 as n = 5000000;
    out = io.Writer(io.STDOUT, cast(*u8, &obuf), 65536);

    set(cast(*Amino, &iub), 0, 0.27, 97);    // a
    set(cast(*Amino, &iub), 1, 0.12, 99);    // c
    set(cast(*Amino, &iub), 2, 0.12, 103);   // g
    set(cast(*Amino, &iub), 3, 0.27, 116);   // t
    set(cast(*Amino, &iub), 4, 0.02, 66);    // B
    set(cast(*Amino, &iub), 5, 0.02, 68);    // D
    set(cast(*Amino, &iub), 6, 0.02, 72);    // H
    set(cast(*Amino, &iub), 7, 0.02, 75);    // K
    set(cast(*Amino, &iub), 8, 0.02, 77);    // M
    set(cast(*Amino, &iub), 9, 0.02, 78);    // N
    set(cast(*Amino, &iub), 10, 0.02, 82);   // R
    set(cast(*Amino, &iub), 11, 0.02, 83);   // S
    set(cast(*Amino, &iub), 12, 0.02, 86);   // V
    set(cast(*Amino, &iub), 13, 0.02, 87);   // W
    set(cast(*Amino, &iub), 14, 0.02, 89);   // Y
    set(cast(*Amino, &homo), 0, 0.3029549426680, 97);
    set(cast(*Amino, &homo), 1, 0.1979883004921, 99);
    set(cast(*Amino, &homo), 2, 0.1975473066391, 103);
    set(cast(*Amino, &homo), 3, 0.3015094502008, 116);
    accumulate(cast(*Amino, &iub), 15);
    accumulate(cast(*Amino, &homo), 4);

    let is *u8 as alu = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA";

    io.writer_bytes(&out, ">ONE Homo sapiens alu\n", 22);
    repeat_fasta(alu, 2 * n);
    io.writer_bytes(&out, ">TWO IUB ambiguity codes\n", 25);
    random_fasta(cast(*Amino, &iub), 3 * n);
    io.writer_bytes(&out, ">THREE Homo sapiens frequency\n", 30);
    random_fasta(cast(*Amino, &homo), 5 * n);
    io.flush(&out);
    if (last != 98282 || drawn_sum != 4092895564) { return 1; }
    return 0;
}
