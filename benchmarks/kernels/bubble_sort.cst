// Bubble sort of 500 integers from a 16-bit linear congruential generator
// (seed 74755, x = (1309x + 13849) mod 65536, shifted down by 50000), redone
// from the same seed 100 times; run r prints the (r+1)-th smallest.
// Self-check: each run's ends equal the smallest and largest seen while
// filling, and the 100 printed lines hash to the expected value.
use "../../std/io.cst" as io;

let is i32 as COUNT with imut = 500;
let is i64 as OCAP with imut = 4096;

let is [501]i32 as list with mut;      // 1-based
let is i64 as seed with mut = 0;
let is i32 as biggest with mut = 0;
let is i32 as littlest with mut = 0;
let is i32 as bad with mut = 0;

let is [4096]u8 as obuf with mut;
let is i64 as olen with mut = 0;

fn ocur() as *u8 { return cast(*u8, cast(i64, &obuf) + olen); }

// Writes what was collected; 1 unless it hashes (FNV-1a) to `want`.
fn flush_check(want as u64) as i32 {
    let is *u8 as b = cast(*u8, &obuf);
    io.write_bytes(io.STDOUT, b, olen);
    let is u64 as h with mut = 14695981039346656037;
    let is i64 as k with mut = 0;
    while (k < olen) { h = (h ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
    if (h != want) { return 1; }
    return 0;
}

fn next_rand() as i32 {
    seed = (seed * 1309 + 13849) & 65535;
    return cast(i32, seed);
}

fn fill() as void {
    seed = 74755;
    biggest = 0;
    littlest = 0;
    let is i32 as i with mut = 1;
    while (i <= COUNT) {
        let is i64 as t = cast(i64, next_rand());
        let is i32 as v = cast(i32, t % 100000 - 50000);
        list[i] = v;
        if (v > biggest) { biggest = v; }
        else if (v < littlest) { littlest = v; }
        i = i + 1;
    }
}

fn sort_once(run as i32) as void {
    fill();
    let is i32 as top with mut = COUNT;
    while (top > 1) {
        let is i32 as i with mut = 1;
        while (i < top) {
            let is i32 as a = list[i];
            let is i32 as b = list[i + 1];
            if (a > b) {
                list[i] = b;
                list[i + 1] = a;
            }
            i = i + 1;
        }
        top = top - 1;
    }
    if (list[1] != littlest || list[COUNT] != biggest) {
        bad = 1;
        olen = olen + io.sprintf(ocur(), OCAP - olen, "Error3 in Bubble.\n");
    }
    olen = olen + io.sprintf(ocur(), OCAP - olen, "%d\n", list[run + 1]);
}

fn main() as i32 {
    let is i32 as r with mut = 0;
    while (r < 100) { sort_once(r); r = r + 1; }

    return bad | flush_check(14788423722927218988);
}
