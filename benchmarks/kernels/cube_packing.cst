// Packs a 5x5x5 cube (inside an 8x8x8 grid whose border counts as filled)
// with 18 pieces of 13 orientations in 4 classes (thirteen 4x2x1 boxes, three
// 3x1x1 rods, one 2x2x1 and one 2x2x2), by depth-first search that always
// fills the lowest empty cell; each of 100 rounds rebuilds the tables, solves,
// and prints the first empty cell after the first piece and the number of
// trial calls.
// Self-check: every round finds a packing in 2005 trials, and the 200 lines
// hash to the expected value.
use "../../std/io.cst" as io;

let is i32 as SIZE with imut = 511;
let is i32 as D with imut = 8;
let is i32 as TYPES with imut = 13;
let is i64 as OCAP with imut = 4096;

let is [512]i32 as grid with mut;
let is [6656]i32 as shape with mut;     // TYPES rows of SIZE + 1 cells
let is [13]i32 as reach with mut;       // last cell a piece's shape covers
let is [13]i32 as kind with mut;        // class of each orientation
let is [4]i32 as left with mut;         // pieces of each class still unused
let is i32 as trials with mut = 0;
let is i32 as bad with mut = 0;

let is [4096]u8 as obuf with mut;
let is i64 as olen with mut = 0;

fn ocur() as *u8 { return cast(*u8, cast(i64, &obuf) + olen); }

// Writes what was collected; 1 unless it hashes (FNV-1a) to `want`.
fn flush_check(want as u64) as i32 {
    let is *u8 as b = cast(*u8, &obuf);
    io.write_bytes(io.STDOUT, b, olen);
    let is u64 as h with mut = 14695981039346656037;
    let is i64 as k with mut = 0;
    while (k < olen) { h = (h ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
    if (h != want) { return 1; }
    return 0;
}

fn fits(t as i32, at as i32) as i32 {
    let is i32 as row = t * (SIZE + 1);
    let is i32 as k with mut = 0;
    while (k <= reach[t]) {
        if (shape[row + k] != 0) {
            if (grid[at + k] != 0) { return 0; }
        }
        k = k + 1;
    }
    return 1;
}

// Puts the piece in and returns the first empty cell from `at` on, or 0.
fn place(t as i32, at as i32) as i32 {
    let is i32 as row = t * (SIZE + 1);
    let is i32 as k with mut = 0;
    while (k <= reach[t]) {
        if (shape[row + k] != 0) { grid[at + k] = 1; }
        k = k + 1;
    }
    left[kind[t]] = left[kind[t]] - 1;
    k = at;
    while (k <= SIZE) {
        if (grid[k] == 0) { return k; }
        k = k + 1;
    }
    return 0;
}

fn lift(t as i32, at as i32) as void {
    let is i32 as row = t * (SIZE + 1);
    let is i32 as k with mut = 0;
    while (k <= reach[t]) {
        if (shape[row + k] != 0) { grid[at + k] = 0; }
        k = k + 1;
    }
    left[kind[t]] = left[kind[t]] + 1;
}

fn trial(at as i32) as i32 {
    trials = trials + 1;
    let is i32 as t with mut = 0;
    while (t < TYPES) {
        if (left[kind[t]] != 0) {
            if (fits(t, at) == 1) {
                let is i32 as next = place(t, at);
                if (trial(next) == 1 || next == 0) { return 1; }
                lift(t, at);
            }
        }
        t = t + 1;
    }
    return 0;
}

// Orientation t is a box of (a+1) x (b+1) x (c+1) cells.
fn define(t as i32, a as i32, b as i32, c as i32, cls as i32) as void {
    let is i32 as i with mut = 0;
    while (i <= a) {
        let is i32 as j with mut = 0;
        while (j <= b) {
            let is i32 as k with mut = 0;
            while (k <= c) {
                shape[t * (SIZE + 1) + i + D * (j + D * k)] = 1;
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    kind[t] = cls;
    reach[t] = a + D * b + D * D * c;
}

fn round() as void {
    let is i32 as m with mut = 0;
    while (m <= SIZE) { grid[m] = 1; m = m + 1; }
    let is i32 as i with mut = 1;
    while (i <= 5) {
        let is i32 as j with mut = 1;
        while (j <= 5) {
            let is i32 as k with mut = 1;
            while (k <= 5) { grid[i + D * (j + D * k)] = 0; k = k + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    m = 0;
    while (m < TYPES * (SIZE + 1)) { shape[m] = 0; m = m + 1; }
    define(0, 3, 1, 0, 0);
    define(1, 1, 0, 3, 0);
    define(2, 0, 3, 1, 0);
    define(3, 1, 3, 0, 0);
    define(4, 3, 0, 1, 0);
    define(5, 0, 1, 3, 0);
    define(6, 2, 0, 0, 1);
    define(7, 0, 2, 0, 1);
    define(8, 0, 0, 2, 1);
    define(9, 1, 1, 0, 2);
    define(10, 1, 0, 1, 2);
    define(11, 0, 1, 1, 2);
    define(12, 1, 1, 1, 3);
    left[0] = 13;
    left[1] = 3;
    left[2] = 1;
    left[3] = 1;
    let is i32 as start = 1 + D * (1 + D * 1);
    trials = 0;
    let is i32 as first with mut = 0;
    if (fits(0, start) == 1) {
        first = place(0, start);
    } else {
        bad = 1;
        olen = olen + io.sprintf(ocur(), OCAP - olen, "Error1 in Puzzle\n");
    }
    if (trial(first) == 0) {
        bad = 1;
        olen = olen + io.sprintf(ocur(), OCAP - olen, "Error2 in Puzzle.\n");
    } else if (trials != 2005) {
        bad = 1;
        olen = olen + io.sprintf(ocur(), OCAP - olen, "Error3 in Puzzle.\n");
    }
    olen = olen + io.sprintf(ocur(), OCAP - olen, "%d\n", first);
    olen = olen + io.sprintf(ocur(), OCAP - olen, "%d\n", trials);
}

fn main() as i32 {
    let is i32 as r with mut = 0;
    while (r < 100) { round(); r = r + 1; }
    return bad | flush_check(15009384200402748805);
}
