// Lower-casing UTF-16 text with an all-ASCII fast path: for every length
// from 0 to 31 characters, a buffer of repeated "HELLO WORLD!HELL" is
// converted 10M times (each character OR-ed with 0x20 when it is A-Z, and
// all characters OR-ed together to tell whether any is outside ASCII).
// Self-check: every conversion reports all-ASCII, and the printed lines hash
// to the expected value.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is u64 as out_hash with mut = 14695981039346656037;
let is i64 as ascii_runs with mut = 0;
let is mem.bins.Bins as heap with mut;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

// Writes the lower-case form of src[0..n) to dst; 1 when every character
// was ASCII.
fn lower(src as *u16, n as i64, dst as *u16) as i32 {
    let is u16 as seen with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u16 as c = src[i];
        seen = seen | c;
        let is u16 as upper with mut = 0;
        if (c >= 65 && c <= 90) { upper = 32; }
        dst[i] = c | upper;
        i = i + 1;
    }
    if ((seen & 0xFF80) == 0) { return 1; }
    return 0;
}

fn run_length(n as i64) as void {
    let is *u8 as pattern = "HELLO WORLD!HELL";
    let is i64 as padded = ((n + 15) / 16) * 16;
    let is *u16 as text = cast(*u16, mem.bins.bins_alloc(&heap, padded * 2 + 2));
    let is *u16 as out = cast(*u16, mem.bins.bins_alloc(&heap, padded * 2 + 2));
    let is i64 as i with mut = 0;
    while (i < padded) { text[i] = cast(u16, pattern[i % 16]); i = i + 1; }
    let is [64]u8 as buf;
    emit(cast(*u8, &buf), io.sprintf(cast(*u8, &buf), 64, "iterations (%ld characters)\n", n));
    i = 0;
    while (i < padded) { out[i] = 0; i = i + 1; }
    let is i64 as r with mut = 0;
    while (r < 10000000) {
        ascii_runs = ascii_runs + cast(i64, lower(text, n, out));
        r = r + 1;
    }
}

fn main() as i32 {
    heap = mem.bins.bins_new(65536);
    let is i64 as n with mut = 0;
    while (n < 32) { run_length(n); n = n + 1; }
    if (ascii_runs != 320000000) { return 2; }
    if (out_hash != 9321975594928363039) { return 1; }
    return 0;
}
