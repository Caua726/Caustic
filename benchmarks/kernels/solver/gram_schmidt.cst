// Modified Gram-Schmidt QR factorization of a 1000x1200 matrix (entry
// (i, j) = 100 * ((i*j) mod 1000) / 1000 + 10): column norms, scaling and
// projections, giving Q (1000x1200) and the upper triangular R (1200x1200).
// Prints R then Q with two decimals, 20 to a line, between dump markers.
// Self-check: the checksum of the printed text.
use "../../../std/math.cst" as math;
use "../../lib/arrays.cst" as arr;

let is i32 as M with imut = 1000;
let is i32 as N with imut = 1200;

fn init(a as *f64, r as *f64, q as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < M) {
        let is i32 as j with mut = 0;
        while (j < N) {
            a[i * N + j] = cast(f64, (i * j) % M) / cast(f64, M) * 100.0 + 10.0;
            q[i * N + j] = 0.0;
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) { r[i * N + j] = 0.0; j = j + 1; }
        i = i + 1;
    }
}

fn gramschmidt(a as *f64, r as *f64, q as *f64) as void {
    let is i32 as k with mut = 0;
    while (k < N) {
        let is f64 as nrm with mut = 0.0;
        let is i32 as i with mut = 0;
        while (i < M) { nrm = nrm + a[i * N + k] * a[i * N + k]; i = i + 1; }
        r[k * N + k] = math.sqrt(nrm);
        i = 0;
        while (i < M) { q[i * N + k] = a[i * N + k] / r[k * N + k]; i = i + 1; }
        let is i32 as j with mut = k + 1;
        while (j < N) {
            r[k * N + j] = 0.0;
            i = 0;
            while (i < M) { r[k * N + j] = r[k * N + j] + q[i * N + k] * a[i * N + j]; i = i + 1; }
            i = 0;
            while (i < M) { a[i * N + j] = a[i * N + j] - q[i * N + k] * r[k * N + j]; i = i + 1; }
            j = j + 1;
        }
        k = k + 1;
    }
}

fn main() as i32 {
    let is *f64 as a = arr.alloc_f64(cast(i64, M) * cast(i64, N));
    let is *f64 as r = arr.alloc_f64(cast(i64, N) * cast(i64, N));
    let is *f64 as q = arr.alloc_f64(cast(i64, M) * cast(i64, N));
    init(a, r, q);
    gramschmidt(a, r, q);
    arr.dump_start();
    arr.dump_begin("R");
    let is i64 as k with mut = 0;
    let is i64 as rn = cast(i64, N) * cast(i64, N);
    while (k < rn) { arr.dump_value(r[k], k); k = k + 1; }
    arr.dump_end("R");
    arr.dump_begin("Q");
    k = 0;
    let is i64 as qn = cast(i64, M) * cast(i64, N);
    while (k < qn) { arr.dump_value(q[k], k); k = k + 1; }
    arr.dump_end("Q");
    arr.dump_finish();
    return arr.finish(6827173865957010006);
}
