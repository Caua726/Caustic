// Forward substitution L x = b for a 2000x2000 lower triangular L (row i,
// column j <= i holds 2 (i - j + 2001) / 2000) and b[i] = i. Prints x in
// the 16-character code of lib/arrays.cst.
// Self-check: the checksum of the printed vector.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 2000;

fn init(l as *f64, x as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        x[i] = -999.0;
        b[i] = cast(f64, i);
        let is i32 as j with mut = 0;
        while (j <= i) { l[i * N + j] = cast(f64, i + N - j + 1) * 2.0 / cast(f64, N); j = j + 1; }
        i = i + 1;
    }
}

fn trisolv(l as *f64, x as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        x[i] = b[i];
        let is i32 as j with mut = 0;
        while (j < i) { x[i] = x[i] - l[i * N + j] * x[j]; j = j + 1; }
        x[i] = x[i] / l[i * N + i];
        i = i + 1;
    }
}

fn main() as i32 {
    let is i64 as n = cast(i64, N);
    let is *f64 as l = arr.alloc_f64(n * n);
    let is *f64 as x = arr.alloc_f64(n);
    let is *f64 as b = arr.alloc_f64(n);
    init(l, x, b);
    trisolv(l, x, b);
    arr.row_f64(x, n);
    return arr.finish(18335344390566891761);
}
