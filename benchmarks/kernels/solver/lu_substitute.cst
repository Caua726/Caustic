// LU factorization without pivoting of a 2000x2000 positive definite matrix
// (built as L L' from a unit lower triangular L, below the diagonal row i
// column j holding 1 - j/2000; the n^3 product done by plain triple loop),
// each entry accumulated in a scalar, then forward and back substitution for
// b[i] = (i+1)/4000 + 4. Matrix, factorization and solve are done twice, and
// the two solutions must agree within 1e-5. Prints the solution with two
// decimals, 20 to a line, between dump markers.
// Self-check: the agreement, and the checksum of the printed text.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 2000;

fn init(a as *f64, b as *f64, x as *f64, y as *f64) as void {
    let is f64 as fnum = cast(f64, N);
    let is i32 as i with mut = 0;
    while (i < N) {
        x[i] = 0.0;
        y[i] = 0.0;
        b[i] = cast(f64, i + 1) / fnum / 2.0 + 4.0;
        i = i + 1;
    }
    i = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j <= i) { a[i * N + j] = cast(f64, (-j) % N) / cast(f64, N) + 1.0; j = j + 1; }
        j = i + 1;
        while (j < N) { a[i * N + j] = 0.0; j = j + 1; }
        a[i * N + i] = 1.0;
        i = i + 1;
    }
    let is i64 as nn = cast(i64, N) * cast(i64, N);
    let is *f64 as t2 = arr.alloc_f64(nn);
    let is i32 as t with mut = 0;
    while (t < N) {
        let is i32 as r with mut = 0;
        while (r < N) {
            let is i32 as s with mut = 0;
            while (s < N) { t2[r * N + s] = t2[r * N + s] + a[r * N + t] * a[s * N + t]; s = s + 1; }
            r = r + 1;
        }
        t = t + 1;
    }
    let is i64 as k with mut = 0;
    while (k < nn) { a[k] = t2[k]; k = k + 1; }
    arr.free_f64(t2, nn);
}

fn ludcmp(a as *f64, b as *f64, x as *f64, y as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < i) {
            let is f64 as w with mut = a[i * N + j];
            let is i32 as k with mut = 0;
            while (k < j) { w = w - a[i * N + k] * a[k * N + j]; k = k + 1; }
            a[i * N + j] = w / a[j * N + j];
            j = j + 1;
        }
        j = i;
        while (j < N) {
            let is f64 as w with mut = a[i * N + j];
            let is i32 as k with mut = 0;
            while (k < i) { w = w - a[i * N + k] * a[k * N + j]; k = k + 1; }
            a[i * N + j] = w;
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < N) {
        let is f64 as w with mut = b[i];
        let is i32 as j with mut = 0;
        while (j < i) { w = w - a[i * N + j] * y[j]; j = j + 1; }
        y[i] = w;
        i = i + 1;
    }
    i = N - 1;
    while (i >= 0) {
        let is f64 as w with mut = y[i];
        let is i32 as j with mut = i + 1;
        while (j < N) { w = w - a[i * N + j] * x[j]; j = j + 1; }
        x[i] = w / a[i * N + i];
        i = i - 1;
    }
}

fn main() as i32 {
    let is i64 as n = cast(i64, N);
    let is *f64 as a = arr.alloc_f64(n * n);
    let is *f64 as b = arr.alloc_f64(n);
    let is *f64 as x = arr.alloc_f64(n);
    let is *f64 as x2 = arr.alloc_f64(n);
    let is *f64 as y = arr.alloc_f64(n);
    init(a, b, x, y);
    ludcmp(a, b, x, y);
    init(a, b, x2, y);
    ludcmp(a, b, x2, y);
    if (arr.close_f64(x, x2, n) == 0) { return 1; }
    arr.dump_vector("x", x2, n);
    return arr.finish(3527148252880751447);
}
