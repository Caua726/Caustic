// Levinson-Durbin recursion for a Toeplitz system of order 2000 whose first
// row is r[i] = 2001 - i: each step a dot product, a scaled reversal and a
// copy back from a temporary. Runs twice from fresh inputs, and the two
// solutions must agree within 1e-5. Prints the solution with two decimals,
// 20 to a line, between dump markers.
// Self-check: the agreement, and the checksum of the printed text.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 2000;
let is [2000]f64 as z with mut;

fn init(r as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) { r[i] = cast(f64, N + 1 - i); i = i + 1; }
}

fn durbin(r as *f64, y as *f64) as void {
    y[0] = -r[0];
    let is f64 as beta with mut = 1.0;
    let is f64 as alpha with mut = -r[0];
    let is i32 as k with mut = 1;
    while (k < N) {
        beta = (1.0 - alpha * alpha) * beta;
        let is f64 as sum with mut = 0.0;
        let is i32 as i with mut = 0;
        while (i < k) { sum = sum + r[k - i - 1] * y[i]; i = i + 1; }
        alpha = -(r[k] + sum) / beta;
        i = 0;
        while (i < k) { z[i] = y[i] + alpha * y[k - i - 1]; i = i + 1; }
        i = 0;
        while (i < k) { y[i] = z[i]; i = i + 1; }
        y[k] = alpha;
        k = k + 1;
    }
}

fn main() as i32 {
    let is i64 as n = cast(i64, N);
    let is *f64 as r = arr.alloc_f64(n);
    let is *f64 as y = arr.alloc_f64(n);
    let is *f64 as y2 = arr.alloc_f64(n);
    init(r);
    durbin(r, y);
    init(r);
    durbin(r, y2);
    if (arr.close_f64(y, y2, n) == 0) { return 1; }
    arr.dump_vector("y", y2, n);
    return arr.finish(15274257830201784563);
}
