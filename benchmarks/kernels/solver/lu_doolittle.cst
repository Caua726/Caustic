// LU factorization without pivoting (Doolittle, in place) of a 2000x2000
// positive definite matrix built as L L' from a unit lower triangular L
// (below the diagonal, row i column j holds 1 - j/2000), the n^3 product
// done by plain triple loop. Matrix and factorization are made twice, into
// two copies, which must agree within 1e-5. Prints the factors in the
// 16-character code of lib/arrays.cst.
// Self-check: the agreement, and the checksum of the printed matrix.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 2000;

fn init(a as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j <= i) { a[i * N + j] = cast(f64, (-j) % N) / cast(f64, N) + 1.0; j = j + 1; }
        j = i + 1;
        while (j < N) { a[i * N + j] = 0.0; j = j + 1; }
        a[i * N + i] = 1.0;
        i = i + 1;
    }
    let is i64 as nn = cast(i64, N) * cast(i64, N);
    let is *f64 as b = arr.alloc_f64(nn);
    let is i32 as t with mut = 0;
    while (t < N) {
        let is i32 as r with mut = 0;
        while (r < N) {
            let is i32 as s with mut = 0;
            while (s < N) { b[r * N + s] = b[r * N + s] + a[r * N + t] * a[s * N + t]; s = s + 1; }
            r = r + 1;
        }
        t = t + 1;
    }
    let is i64 as k with mut = 0;
    while (k < nn) { a[k] = b[k]; k = k + 1; }
    arr.free_f64(b, nn);
}

fn lu(a as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < i) {
            let is i32 as k with mut = 0;
            while (k < j) { a[i * N + j] = a[i * N + j] - a[i * N + k] * a[k * N + j]; k = k + 1; }
            a[i * N + j] = a[i * N + j] / a[j * N + j];
            j = j + 1;
        }
        j = i;
        while (j < N) {
            let is i32 as k with mut = 0;
            while (k < i) { a[i * N + j] = a[i * N + j] - a[i * N + k] * a[k * N + j]; k = k + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn main() as i32 {
    let is i64 as nn = cast(i64, N) * cast(i64, N);
    let is *f64 as a = arr.alloc_f64(nn);
    let is *f64 as a2 = arr.alloc_f64(nn);
    init(a);
    lu(a);
    init(a2);
    lu(a2);
    if (arr.close_f64(a, a2, nn) == 0) { return 1; }
    arr.matrix_f64(a2, cast(i64, N), cast(i64, N));
    return arr.finish(3226490953298164494);
}
