// Bit reversal of 32- and 64-bit words by swapping ever larger groups
// (adjacent bits, pairs, nibbles, then bytes), for every i below 2^24; each
// result is checked against a byte-table reversal by summing the one and
// subtracting the other.
// Self-check: both sums return to zero, and the two printed lines hash to the
// expected value.
use "../../std/io.cst" as io;

let is [256]u8 as rev_byte with mut;
let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn reverse32(v as u32) as u32 {
    let is u32 as n with mut = v;
    n = ((n >> 1) & 0x55555555) | ((n & 0x55555555) << 1);
    n = ((n >> 2) & 0x33333333) | ((n & 0x33333333) << 2);
    n = ((n >> 4) & 0x0F0F0F0F) | ((n & 0x0F0F0F0F) << 4);
    return ((n & 0xFF000000) >> 24) | ((n & 0x00FF0000) >> 8)
         | ((n & 0x0000FF00) << 8) | ((n & 0x000000FF) << 24);
}

fn reverse64(v as u64) as u64 {
    let is u64 as n with mut = v;
    n = ((n >> 1) & 0x5555555555555555) | ((n & 0x5555555555555555) << 1);
    n = ((n >> 2) & 0x3333333333333333) | ((n & 0x3333333333333333) << 2);
    n = ((n >> 4) & 0x0F0F0F0F0F0F0F0F) | ((n & 0x0F0F0F0F0F0F0F0F) << 4);
    return ((n & 0xFF00000000000000) >> 56) | ((n & 0x00FF000000000000) >> 40)
         | ((n & 0x0000FF0000000000) >> 24) | ((n & 0x000000FF00000000) >> 8)
         | ((n & 0x00000000000000FF) << 56) | ((n & 0x000000000000FF00) << 40)
         | ((n & 0x0000000000FF0000) << 24) | ((n & 0x00000000FF000000) << 8);
}

fn table_reverse64(v as u64) as u64 {
    let is u64 as r with mut = 0;
    let is i32 as k with mut = 0;
    while (k < 8) {
        r = (r << 8) | cast(u64, rev_byte[cast(i64, (v >> cast(u64, k * 8)) & 255)]);
        k = k + 1;
    }
    return r;
}

fn table_reverse32(v as u32) as u32 {
    return cast(u32, table_reverse64(cast(u64, v)) >> 32);
}

fn main() as i32 {
    let is i32 as b with mut = 0;
    while (b < 256) {
        let is i32 as r with mut = 0;
        let is i32 as k with mut = 0;
        while (k < 8) {
            if ((b & (1 << k)) != 0) { r = r | (128 >> k); }
            k = k + 1;
        }
        rev_byte[b] = cast(u8, r);
        b = b + 1;
    }

    let is u64 as sum32 with mut = 0;
    let is u64 as sum64 with mut = 0;
    let is i32 as i with mut = 0;
    while (i < 0x1000000) {
        sum32 = sum32 + cast(u64, reverse32(cast(u32, i)));
        sum64 = sum64 + reverse64(cast(u64, i));
        i = i + 1;
    }
    i = 0;
    while (i < 0x1000000) {
        sum32 = sum32 - cast(u64, table_reverse32(cast(u32, i)));
        sum64 = sum64 - table_reverse64(cast(u64, i));
        i = i + 1;
    }

    let is u32 as w32 = 0x12345678;
    let is u64 as w64 = 0x0123456789012345;
    let is [128]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    emit(bp, io.sprintf(bp, 128, "0x%x -> 0x%x\n", w32, reverse32(w32)));
    emit(bp, io.sprintf(bp, 128, "0x%llx -> 0x%llx\n", w64, reverse64(w64)));
    if (sum32 != 0 || sum64 != 0) { return 1; }
    if (out_hash != 677065482880817204) { return 2; }
    return 0;
}
