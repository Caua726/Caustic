// First solution of the eight queens problem by backtracking over columns,
// with free flags for columns and both diagonals; solved 50 times per round,
// and each of 100 rounds prints its number.
// Self-check: every search finds a solution, and the 100 lines hash to the
// expected value.
use "../../std/io.cst" as io;

let is i64 as OCAP with imut = 4096;

let is i32 as bad with mut = 0;

let is [4096]u8 as obuf with mut;
let is i64 as olen with mut = 0;

fn ocur() as *u8 { return cast(*u8, cast(i64, &obuf) + olen); }

// Writes what was collected; 1 unless it hashes (FNV-1a) to `want`.
fn flush_check(want as u64) as i32 {
    let is *u8 as b = cast(*u8, &obuf);
    io.write_bytes(io.STDOUT, b, olen);
    let is u64 as h with mut = 14695981039346656037;
    let is i64 as k with mut = 0;
    while (k < olen) { h = (h ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
    if (h != want) { return 1; }
    return 0;
}

// Places the queen of row i and those below it; *found says whether it worked.
fn try_row(i as i32, found as *i32, col as *i32, sum as *i32, dif as *i32, at as *i32) as void {
    let is i32 as j with mut = 0;
    found[0] = 0;
    while (found[0] == 0 && j != 8) {
        j = j + 1;
        found[0] = 0;
        if (col[j] != 0 && sum[i + j] != 0 && dif[i - j + 7] != 0) {
            at[i] = j;
            col[j] = 0;
            sum[i + j] = 0;
            dif[i - j + 7] = 0;
            if (i < 8) {
                try_row(i + 1, found, col, sum, dif, at);
                if (found[0] == 0) {
                    col[j] = 1;
                    sum[i + j] = 1;
                    dif[i - j + 7] = 1;
                }
            } else {
                found[0] = 1;
            }
        }
    }
}

fn solve() as void {
    let is [9]i32 as col;
    let is [17]i32 as sum;
    let is [15]i32 as dif;
    let is [9]i32 as at;
    let is i32 as found with mut = 0;
    let is i32 as i with mut = 0 - 7;
    while (i <= 16) {
        if (i >= 1 && i <= 8) { col[i] = 1; }
        if (i >= 2) { sum[i] = 1; }
        if (i <= 7) { dif[i + 7] = 1; }
        i = i + 1;
    }
    try_row(1, &found, cast(*i32, &col), cast(*i32, &sum), cast(*i32, &dif), cast(*i32, &at));
    if (found == 0) {
        bad = 1;
        olen = olen + io.sprintf(ocur(), OCAP - olen, " Error in Queens.\n");
    }
}

fn main() as i32 {
    let is i32 as r with mut = 0;
    while (r < 100) {
        let is i32 as k with mut = 1;
        while (k <= 50) { solve(); k = k + 1; }
        olen = olen + io.sprintf(ocur(), OCAP - olen, "%d\n", r + 1);
        r = r + 1;
    }
    return bad | flush_check(8100852627345514866);
}
