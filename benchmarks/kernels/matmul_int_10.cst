// 10x10 integer matrix product through row pointers, recomputed 3 million
// times; prints four entries.
// Self-check: the four entries of M*M where M holds 1..100 row by row.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is mem.bins.Bins as heap with mut;
let is i32 as SIZE with imut = 10;

fn mkmatrix(rows as i32, cols as i32) as **i32 {
    let is **i32 as m = cast(**i32, mem.bins.bins_alloc(&heap, cast(i64, rows) * 8));
    let is i32 as count with mut = 1;
    let is i32 as i with mut = 0;
    while (i < rows) {
        let is *i32 as row = cast(*i32, mem.bins.bins_alloc(&heap, cast(i64, cols) * 4));
        m[i] = row;
        let is i32 as j with mut = 0;
        while (j < cols) { row[j] = count; count = count + 1; j = j + 1; }
        i = i + 1;
    }
    return m;
}

fn freematrix(rows as i32, m as **i32) as void {
    let is i32 as i with mut = rows - 1;
    while (i >= 0) { mem.bins.bins_free(&heap, cast(*u8, m[i])); i = i - 1; }
    mem.bins.bins_free(&heap, cast(*u8, m));
}

fn mmult(rows as i32, cols as i32, m1 as **i32, m2 as **i32, m3 as **i32) as **i32 {
    let is i32 as i with mut = 0;
    while (i < rows) {
        let is i32 as j with mut = 0;
        while (j < cols) {
            let is i32 as val with mut = 0;
            let is i32 as k with mut = 0;
            while (k < cols) {
                val = val + m1[i][k] * m2[k][j];
                k = k + 1;
            }
            m3[i][j] = val;
            j = j + 1;
        }
        i = i + 1;
    }
    return m3;
}

fn main() as i32 {
    let is i32 as n = 3000000;
    let is **i32 as m1 = mkmatrix(SIZE, SIZE);
    let is **i32 as m2 = mkmatrix(SIZE, SIZE);
    let is **i32 as mm with mut = mkmatrix(SIZE, SIZE);
    let is i32 as i with mut = 0;
    while (i < n) {
        mm = mmult(SIZE, SIZE, m1, m2, mm);
        i = i + 1;
    }
    io.printf("%d %d %d %d\n", mm[0][0], mm[2][3], mm[3][2], mm[4][4]);
    let is i32 as bad with mut = 0;
    if (mm[0][0] != 3355 || mm[2][3] != 13320 || mm[3][2] != 17865 || mm[4][4] != 23575) { bad = 1; }
    freematrix(SIZE, m1);
    freematrix(SIZE, m2);
    freematrix(SIZE, mm);
    return bad;
}
