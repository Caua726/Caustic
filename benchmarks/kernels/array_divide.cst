// Element-wise division a[i] /= b[i] over two 2048-element f64 arrays,
// repeated 131072 times: a chain of dependent divisions per element that
// only a loop interchange could shorten. The arrays start from single-
// precision cosines and sines of the index.
// Self-check: the hash of the two printed lines.
use "../../std/io.cst" as io;
use "../../std/math.cst" as math;

let is i64 as ROUNDS with imut = 131072;
let is i64 as SIZE with imut = 2048;

let is [2048]f64 as num with mut;
let is [2048]f64 as den with mut;
let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

// Single-precision sine and cosine, rounded from the double results.
fn cos32(x as f32) as f32 { return cast(f32, math.cos(cast(f64, x))); }
fn sin32(x as f32) as f32 { return cast(f32, math.sin(cast(f64, x))); }

fn divide_all(a as *f64, b as *f64) as void {
    let is i64 as r with mut = 0;
    while (r < ROUNDS) {
        let is i64 as i with mut = 0;
        while (i < SIZE) {
            a[i] = a[i] / b[i];
            i = i + 1;
        }
        r = r + 1;
    }
}

fn main() as i32 {
    let is *f64 as a = cast(*f64, &num);
    let is *f64 as b = cast(*f64, &den);
    let is [128]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    emit(bp, io.sprintf(bp, 128, " %i iterations of each test. ", ROUNDS));
    emit(bp, io.sprintf(bp, 128, " inner loop / array size %i.\n", SIZE));
    let is i64 as i with mut = 0;
    while (i < SIZE) {
        a[i] = 1.0000001 * cast(f64, cos32(cast(f32, SIZE - i)));
        b[i] = 1.0 + 0.0000000001 * cast(f64, sin32(cast(f32, i)));
        i = i + 1;
    }
    divide_all(a, b);
    emit(bp, io.sprintf(bp, 128, "%f\n", a[0]));
    if (out_hash != 3759566952473853828) { return 1; }
    return 0;
}
