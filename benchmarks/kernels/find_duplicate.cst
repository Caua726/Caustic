// The numbers 1..500000 plus one random repeat, shuffled (Fisher-Yates with
// a 15-bit linear congruential generator); the repeat is found by XOR-ing
// everything, 200 times per array, for 5 arrays.
// Self-check: each repeat equals the value planted in the array.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is mem.bins.Bins as heap with mut;
let is i32 as ARRAY_SIZE with imut = 500000;
let is u64 as next with mut = 1;
let is i32 as planted with mut = 0;

fn rand() as i32 {
    next = next * 1103515245 + 12345;
    return cast(i32, cast(u32, next / 65536) % 32767) + 1;
}

fn rand_int(lo as i32, hi as i32) as i32 {
    let is i32 as n = hi - lo + 1;
    let is i32 as k = cast(i32, cast(f64, n) * (cast(f64, rand()) / 32768.0));
    if (k == n) { return k + lo - 1; }
    return k + lo;
}

fn shuffle(items as *i32, len as i32) as void {
    let is u64 as i with mut = cast(u64, len - 1);
    while (i > 0) {
        let is u64 as k = cast(u64, cast(i32, cast(f64, i + 1) * (cast(f64, rand()) / 32768.0)));
        let is u64 as j with mut = k;
        if (k == i + 1) { j = k - 1; }
        let is i32 as aux = items[i];
        items[i] = items[j];
        items[j] = aux;
        i = i - 1;
    }
}

fn create_random_array(size as i32) as *i32 {
    let is i32 as len = size + 1;
    let is *i32 as r = cast(*i32, mem.bins.bins_alloc(&heap, cast(i64, len) * 4));
    let is i32 as i with mut = 0;
    while (i < len) { r[i] = i; i = i + 1; }
    r[0] = rand_int(1, size);
    planted = r[0];
    shuffle(r, len);
    return r;
}

fn find_duplicate(data as *i32, len as i32) as i32 {
    let is i32 as result with mut = 0;
    let is i32 as i with mut = 0;
    while (i < len) {
        result = result ^ (i + 1) ^ data[i];
        i = i + 1;
    }
    return result ^ len;
}

fn main() as i32 {
    let is i32 as bad with mut = 0;
    let is i32 as i with mut = 0;
    while (i < 5) {
        let is *i32 as arr = create_random_array(ARRAY_SIZE);
        let is i32 as dup with mut = 0;
        let is i32 as j with mut = 0;
        while (j < 200) { dup = find_duplicate(arr, ARRAY_SIZE + 1); j = j + 1; }
        mem.bins.bins_free(&heap, cast(*u8, arr));
        io.printf("Found duplicate: %d\n", dup);
        if (dup != planted) { bad = 1; }
        i = i + 1;
    }
    return bad;
}
