// A fixed 4x4 f64 matrix product, 50M times, through a function that builds
// all 16 results in a local array before copying them out (so the output
// may alias the inputs); each entry is a four-term row-by-column sum.
// Self-check: the hash of the printed matrix.
use "../../std/io.cst" as io;

let is [16]f64 as ma with mut;
let is [16]f64 as mb with mut;
let is [16]f64 as mc with mut;
let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn mul4(out as *f64, a as *f64, b as *f64) as void {
    let is [16]f64 as res;
    let is i64 as r with mut = 0;
    while (r < 4) {
        let is i64 as c with mut = 0;
        while (c < 4) {
            res[r * 4 + c] = a[r * 4] * b[c] + a[r * 4 + 1] * b[4 + c]
                           + a[r * 4 + 2] * b[8 + c] + a[r * 4 + 3] * b[12 + c];
            c = c + 1;
        }
        r = r + 1;
    }
    let is i64 as n with mut = 0;
    while (n < 16) { out[n] = res[n]; n = n + 1; }
}

fn set_row(m as *f64, r as i64, x0 as f64, x1 as f64, x2 as f64, x3 as f64) as void {
    m[r * 4] = x0;
    m[r * 4 + 1] = x1;
    m[r * 4 + 2] = x2;
    m[r * 4 + 3] = x3;
}

fn main() as i32 {
    let is *f64 as a = cast(*f64, &ma);
    let is *f64 as b = cast(*f64, &mb);
    let is *f64 as c = cast(*f64, &mc);
    set_row(a, 0, 4.5, 1.3, 6.0, 4.1);
    set_row(a, 1, 2.5, 7.2, 7.7, 1.7);
    set_row(a, 2, 6.7, 1.3, 9.4, 1.3);
    set_row(a, 3, 1.1, 2.2, 3.0, 2.1);
    set_row(b, 0, 1.0, 7.9, 5.1, 3.4);
    set_row(b, 1, 6.6, 2.8, 5.4, 9.2);
    set_row(b, 2, 5.0, 4.1, 4.1, 9.9);
    set_row(b, 3, 8.4, 3.7, 9.5, 6.4);
    let is i64 as n with mut = 0;
    while (n < 50000000) { mul4(c, a, b); n = n + 1; }

    let is [64]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    let is i64 as r with mut = 0;
    while (r < 4) {
        let is i64 as k with mut = 0;
        while (k < 4) { emit(bp, io.sprintf(bp, 64, "%8.2f", c[r * 4 + k])); k = k + 1; }
        emit(bp, io.sprintf(bp, 64, "\n"));
        r = r + 1;
    }
    if (out_hash != 3709427767700103295) { return 1; }
    return 0;
}
