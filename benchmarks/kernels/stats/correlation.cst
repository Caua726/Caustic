// Correlation matrix of 1200 variables over 1400 samples (sample i, variable
// j holds i*j/1200 + i): column means, standard deviations (those at or
// below 0.1 count as 1), centring and scaling, then the 1200x1200 matrix of
// column dot products, filled symmetrically. Prints the matrix in the
// 16-character code of lib/arrays.cst.
// Self-check: the checksum of the printed matrix.
use "../../../std/math.cst" as math;
use "../../lib/arrays.cst" as arr;

let is i32 as M with imut = 1200;
let is i32 as N with imut = 1400;

fn init(data as *f64) as f64 {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < M) {
            data[i * M + j] = cast(f64, i * j) / cast(f64, M) + cast(f64, i);
            j = j + 1;
        }
        i = i + 1;
    }
    return cast(f64, N);
}

fn correlate(float_n as f64, data as *f64, corr as *f64, mean as *f64, stddev as *f64) as void {
    let is f64 as eps = 0.1;
    let is i32 as i with mut = 0;
    let is i32 as j with mut = 0;
    while (j < M) {
        mean[j] = 0.0;
        i = 0;
        while (i < N) { mean[j] = mean[j] + data[i * M + j]; i = i + 1; }
        mean[j] = mean[j] / float_n;
        j = j + 1;
    }
    j = 0;
    while (j < M) {
        stddev[j] = 0.0;
        i = 0;
        while (i < N) {
            stddev[j] = stddev[j] + (data[i * M + j] - mean[j]) * (data[i * M + j] - mean[j]);
            i = i + 1;
        }
        stddev[j] = stddev[j] / float_n;
        stddev[j] = math.sqrt(stddev[j]);
        if (stddev[j] <= eps) { stddev[j] = 1.0; }
        j = j + 1;
    }
    i = 0;
    while (i < N) {
        j = 0;
        while (j < M) {
            data[i * M + j] = data[i * M + j] - mean[j];
            data[i * M + j] = data[i * M + j] / (math.sqrt(float_n) * stddev[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < M - 1) {
        corr[i * M + i] = 1.0;
        j = i + 1;
        while (j < M) {
            corr[i * M + j] = 0.0;
            let is i32 as k with mut = 0;
            while (k < N) {
                corr[i * M + j] = corr[i * M + j] + data[k * M + i] * data[k * M + j];
                k = k + 1;
            }
            corr[j * M + i] = corr[i * M + j];
            j = j + 1;
        }
        i = i + 1;
    }
    corr[(M - 1) * M + M - 1] = 1.0;
}

fn main() as i32 {
    let is *f64 as data = arr.alloc_f64(cast(i64, N) * cast(i64, M));
    let is *f64 as corr = arr.alloc_f64(cast(i64, M) * cast(i64, M));
    let is *f64 as mean = arr.alloc_f64(cast(i64, M));
    let is *f64 as stddev = arr.alloc_f64(cast(i64, M));
    let is f64 as float_n = init(data);
    correlate(float_n, data, corr, mean, stddev);
    arr.matrix_f64(corr, cast(i64, M), cast(i64, M));
    return arr.finish(3657805087531893111);
}
