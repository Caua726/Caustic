// Covariance matrix of 80 variables over 100 samples (sample i, variable j
// holds i*j/80): column means, centring, then the 80x80 matrix of column
// dot products divided by n - 1, filled symmetrically. Prints the matrix in
// the 16-character code of lib/arrays.cst.
// Self-check: the checksum of the printed matrix.
use "../../lib/arrays.cst" as arr;

let is i32 as M with imut = 80;
let is i32 as N with imut = 100;

fn init(data as *f64) as f64 {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < M) {
            data[i * M + j] = cast(f64, i) * cast(f64, j) / cast(f64, M);
            j = j + 1;
        }
        i = i + 1;
    }
    return cast(f64, N);
}

fn covariance(float_n as f64, data as *f64, cov as *f64, mean as *f64) as void {
    let is i32 as i with mut = 0;
    let is i32 as j with mut = 0;
    while (j < M) {
        mean[j] = 0.0;
        i = 0;
        while (i < N) { mean[j] = mean[j] + data[i * M + j]; i = i + 1; }
        mean[j] = mean[j] / float_n;
        j = j + 1;
    }
    i = 0;
    while (i < N) {
        j = 0;
        while (j < M) { data[i * M + j] = data[i * M + j] - mean[j]; j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < M) {
        j = i;
        while (j < M) {
            cov[i * M + j] = 0.0;
            let is i32 as k with mut = 0;
            while (k < N) {
                cov[i * M + j] = cov[i * M + j] + data[k * M + i] * data[k * M + j];
                k = k + 1;
            }
            cov[i * M + j] = cov[i * M + j] / (float_n - 1.0);
            cov[j * M + i] = cov[i * M + j];
            j = j + 1;
        }
        i = i + 1;
    }
}

fn main() as i32 {
    let is *f64 as data = arr.alloc_f64(cast(i64, N) * cast(i64, M));
    let is *f64 as cov = arr.alloc_f64(cast(i64, M) * cast(i64, M));
    let is *f64 as mean = arr.alloc_f64(cast(i64, M));
    let is f64 as float_n = init(data);
    covariance(float_n, data, cov, mean);
    arr.matrix_f64(cov, cast(i64, M), cast(i64, M));
    return arr.finish(3774437330781229107);
}
