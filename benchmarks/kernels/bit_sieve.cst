// Sieve of Eratosthenes with one bit per number in 32-bit words, up to
// 40960000, 20480000 and 10240000. Composite bits are cleared one by one
// with a test-then-flip.
// Self-check: the three prime counts.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is mem.bins.Bins as heap with mut;

fn main() as i32 {
    let is u32 as sz = 10000 << 12;
    let is i64 as bytes = cast(i64, sz / 8) + 4;
    let is *u32 as primes = cast(*u32, mem.bins.bins_alloc(&heap, bytes));
    if (cast(i64, primes) == 0) { return 1; }
    let is [3]u32 as want;
    want[0] = 2488465; want[1] = 1299069; want[2] = 679461;
    let is i32 as bad with mut = 0;
    let is u32 as m with mut = 0;
    while (m <= 2) {
        let is u32 as n = sz >> m;
        let is u32 as count with mut = 0;
        mem.memset(cast(*u8, primes), 255, cast(i64, n / 8) + 4);
        let is u32 as i with mut = 2;
        while (i <= n) {
            if ((primes[i / 32] & (cast(u32, 1) << (i % 32))) != 0) {
                count = count + 1;
                let is u32 as j with mut = i + i;
                while (j <= n) {
                    let is u32 as bit = cast(u32, 1) << (j % 32);
                    if ((primes[j / 32] & bit) != 0) { primes[j / 32] = primes[j / 32] ^ bit; }
                    j = j + i;
                }
            }
            i = i + 1;
        }
        io.printf("Primes up to %8u %8u\n", n, count);
        if (count != want[m]) { bad = 1; }
        m = m + 1;
    }
    mem.bins.bins_free(&heap, cast(*u8, primes));
    return bad;
}
