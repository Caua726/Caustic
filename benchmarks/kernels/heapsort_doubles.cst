// Heapsort of 8 million doubles drawn from a linear congruential generator,
// on a 1-based array; prints the largest.
// Self-check: the array comes out sorted, and the largest prints as 0.999993.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is mem.bins.Bins as heap with mut;
let is i64 as last with mut = 42;

fn gen_random(max as f64) as f64 {
    last = (last * 3877 + 29573) % 139968;
    return max * cast(f64, last) / 139968.0;
}

fn heapsort(n as i32, ra as *f64) as void {
    let is i32 as ir with mut = n;
    let is i32 as l with mut = (n >> 1) + 1;
    let is f64 as rra with mut = 0.0;
    while (1 == 1) {
        if (l > 1) {
            l = l - 1;
            rra = ra[l];
        } else {
            rra = ra[ir];
            ra[ir] = ra[1];
            ir = ir - 1;
            if (ir == 1) {
                ra[1] = rra;
                return;
            }
        }
        // Sift rra down from l.
        let is i32 as i with mut = l;
        let is i32 as j with mut = l << 1;
        while (j <= ir) {
            if (j < ir && ra[j] < ra[j + 1]) { j = j + 1; }
            if (rra < ra[j]) {
                ra[i] = ra[j];
                i = j;
                j = j + j;
            } else {
                j = ir + 1;
            }
        }
        ra[i] = rra;
    }
}

fn main() as i32 {
    let is i32 as n = 8000000;
    let is *f64 as ary = cast(*f64, mem.bins.bins_alloc(&heap, (cast(i64, n) + 1) * 8));
    let is i32 as i with mut = 1;
    while (i <= n) { ary[i] = gen_random(1.0); i = i + 1; }
    heapsort(n, ary);

    let is [64]u8 as buf;
    let is *u8 as b = cast(*u8, &buf);
    let is i64 as len = io.sprintf(b, 64, "%f\n", ary[n]);
    io.write_bytes(io.STDOUT, b, len);

    let is i32 as bad with mut = 0;
    i = 2;
    while (i <= n) { if (ary[i] < ary[i - 1]) { bad = 1; } i = i + 1; }
    mem.bins.bins_free(&heap, cast(*u8, ary));
    let is *u8 as want = "0.999993\n";
    let is i64 as k with mut = 0;
    while (k <= len) { if (b[k] != want[k]) { bad = 1; } k = k + 1; }
    return bad;
}
