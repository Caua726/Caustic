// Sieve of Eratosthenes over 2..8192 with a byte per number, repeated
// 170000 times.
// Self-check: there are 1028 primes up to 8192.
use "../../std/io.cst" as io;

let is [8193]u8 as flags with mut;

fn main() as i32 {
    let is i32 as reps with mut = 170000;
    let is i32 as count with mut = 0;
    while (reps > 0) {
        reps = reps - 1;
        count = 0;
        let is i64 as i with mut = 2;
        while (i <= 8192) { flags[i] = 1; i = i + 1; }
        i = 2;
        while (i <= 8192) {
            if (flags[i] != 0) {
                let is i64 as k with mut = i + i;
                while (k <= 8192) { flags[k] = 0; k = k + i; }
                count = count + 1;
            }
            i = i + 1;
        }
    }
    io.printf("Count: %d\n", count);
    if (count != 1028) { return 1; }
    return 0;
}
