// Two 1.5-million-element i32 arrays: y[i] += x[i], walked backwards, 1000
// times over.
// Self-check: y[0] = 1000 and y[n-1] = 1000 * n.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is mem.bins.Bins as heap with mut;

fn main() as i32 {
    let is i32 as n = 1500000;
    let is i64 as bytes = cast(i64, n) * 4;
    let is *i32 as x = cast(*i32, mem.bins.bins_alloc(&heap, bytes));
    let is *i32 as y = cast(*i32, mem.bins.bins_alloc(&heap, bytes));
    mem.memzero(cast(*u8, x), bytes);
    mem.memzero(cast(*u8, y), bytes);
    let is i32 as i with mut = 0;
    while (i < n) { x[i] = i + 1; i = i + 1; }
    let is i32 as k with mut = 0;
    while (k < 1000) {
        i = n - 1;
        while (i >= 0) { y[i] = y[i] + x[i]; i = i - 1; }
        k = k + 1;
    }
    io.printf("%d %d\n", y[0], y[n - 1]);
    let is i32 as first = y[0];
    let is i32 as lastv = y[n - 1];
    mem.bins.bins_free(&heap, cast(*u8, x));
    mem.bins.bins_free(&heap, cast(*u8, y));
    if (first != 1000 || lastv != 1000 * n) { return 1; }
    return 0;
}
