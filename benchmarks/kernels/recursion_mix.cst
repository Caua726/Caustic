// Five recursive functions: Ackermann A(3, 11), Fibonacci in doubles (38),
// Takeuchi on ints (30, 20, 10) and on doubles, and a tiny Fibonacci.
// Self-check: the five results.
use "../../std/io.cst" as io;

fn ack(x as i32, y as i32) as i32 {
    if (x == 0) { return y + 1; }
    let is i32 as inner with mut = 1;
    if (y != 0) { inner = ack(x, y - 1); }
    return ack(x - 1, inner);
}

fn fib(n as i32) as i32 {
    if (n < 2) { return 1; }
    return fib(n - 2) + fib(n - 1);
}

fn fib_fp(n as f64) as f64 {
    if (n < 2.0) { return 1.0; }
    return fib_fp(n - 2.0) + fib_fp(n - 1.0);
}

fn tak(x as i32, y as i32, z as i32) as i32 {
    if (y < x) { return tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y)); }
    return z;
}

fn tak_fp(x as f64, y as f64, z as f64) as f64 {
    if (y < x) { return tak_fp(tak_fp(x - 1.0, y, z), tak_fp(y - 1.0, z, x), tak_fp(z - 1.0, x, y)); }
    return z;
}

fn main() as i32 {
    let is i32 as n = 10;
    let is i32 as a = ack(3, n + 1);
    io.printf("Ack(3,%d): %d\n", n + 1, a);
    let is f64 as f = fib_fp(28.0 + cast(f64, n));
    io.printf("Fib(%.1f): %.1f\n", 28.0 + cast(f64, n), f);
    let is i32 as t = tak(3 * n, 2 * n, n);
    io.printf("Tak(%d,%d,%d): %d\n", 3 * n, 2 * n, n, t);
    let is i32 as f3 = fib(3);
    io.printf("Fib(3): %d\n", f3);
    let is f64 as tf = tak_fp(3.0, 2.0, 1.0);
    io.printf("Tak(3.0,2.0,1.0): %.1f\n", tf);
    if (a != 16381 || f != 63245986.0 || t != 11 || f3 != 3 || tf != 2.0) { return 1; }
    return 0;
}
