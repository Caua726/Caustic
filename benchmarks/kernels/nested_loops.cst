// Six nested counting loops of 46 trips each; the 32-bit counter wraps
// (46^6 = 9474296896 does not fit), and the wrapped value is the output.
// Self-check: 46^6 reduced to 32 bits.
use "../../std/io.cst" as io;

fn main() as i32 {
    let is i32 as n = 46;
    let is i32 as x with mut = 0;
    let is i32 as a with mut = 0;
    while (a < n) {
        let is i32 as b with mut = 0;
        while (b < n) {
            let is i32 as c with mut = 0;
            while (c < n) {
                let is i32 as d with mut = 0;
                while (d < n) {
                    let is i32 as e with mut = 0;
                    while (e < n) {
                        let is i32 as f with mut = 0;
                        while (f < n) { x = x + 1; f = f + 1; }
                        e = e + 1;
                    }
                    d = d + 1;
                }
                c = c + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    io.printf("%d\n", x);
    let is i64 as n64 = cast(i64, n);
    let is i64 as want = (n64 * n64 * n64 * n64 * n64 * n64) & 0xFFFFFFFF;
    if ((cast(i64, x) & 0xFFFFFFFF) != want) { return 1; }
    return 0;
}
