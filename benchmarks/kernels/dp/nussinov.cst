// Nussinov RNA folding: the maximum number of complementary base pairs
// (bases b1, b2 pair when b1 + b2 = 3) over every subsequence of a 2500-base
// sequence cycling 1 2 3 0, by dynamic programming over a 2500x2500 i32
// table filled from the bottom row up. Runs twice from fresh inputs, and the
// two tables must be equal. Prints the table, each entry as a double, in
// the 16-character code of lib/arrays.cst.
// Self-check: the agreement, and the checksum of the printed table.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 2500;

fn init(seq as *u8, table as *i32) as void {
    let is i32 as i with mut = 0;
    while (i < N) { seq[i] = cast(u8, (i + 1) % 4); i = i + 1; }
    i = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) { table[i * N + j] = 0; j = j + 1; }
        i = i + 1;
    }
}

fn max_score(a as i32, b as i32) as i32 {
    if (a >= b) { return a; }
    return b;
}

fn pairs(b1 as u8, b2 as u8) as i32 {
    if (cast(i32, b1) + cast(i32, b2) == 3) { return 1; }
    return 0;
}

fn nussinov(seq as *u8, table as *i32) as void {
    let is i32 as i with mut = N - 1;
    while (i >= 0) {
        let is i32 as j with mut = i + 1;
        while (j < N) {
            if (j - 1 >= 0) {
                table[i * N + j] = max_score(table[i * N + j], table[i * N + j - 1]);
            }
            if (i + 1 < N) {
                table[i * N + j] = max_score(table[i * N + j], table[(i + 1) * N + j]);
            }
            if (j - 1 >= 0 && i + 1 < N) {
                if (i < j - 1) {
                    table[i * N + j] = max_score(table[i * N + j], table[(i + 1) * N + j - 1] + pairs(seq[i], seq[j]));
                } else {
                    table[i * N + j] = max_score(table[i * N + j], table[(i + 1) * N + j - 1]);
                }
            }
            let is i32 as k with mut = i + 1;
            while (k < j) {
                table[i * N + j] = max_score(table[i * N + j], table[i * N + k] + table[(k + 1) * N + j]);
                k = k + 1;
            }
            j = j + 1;
        }
        i = i - 1;
    }
}

fn main() as i32 {
    let is i64 as nn = cast(i64, N) * cast(i64, N);
    let is *u8 as seq = arr.alloc_u8(cast(i64, N));
    let is *i32 as table = arr.alloc_i32(nn);
    let is *i32 as table2 = arr.alloc_i32(nn);
    init(seq, table);
    nussinov(seq, table);
    init(seq, table2);
    nussinov(seq, table2);
    if (arr.same_i32(table, table2, nn) == 0) { return 1; }
    let is i32 as i with mut = 0;
    while (i < N) {
        arr.row_i32(cast(*i32, cast(i64, table2) + cast(i64, i) * cast(i64, N) * 4), cast(i64, N));
        i = i + 1;
    }
    return arr.finish(6820187706580384869);
}
