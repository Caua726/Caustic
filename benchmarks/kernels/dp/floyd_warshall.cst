// Floyd-Warshall all-pairs shortest paths on a dense 2800-node graph of i32
// weights (edge (i, j) weighs (i*j mod 7) + 1, or 999 when i + j is a
// multiple of 7, 11 or 13). Runs twice from fresh inputs, and the two
// results must be equal. Prints the distance matrix, each entry as a double,
// in the 16-character code of lib/arrays.cst.
// Self-check: the agreement, and the checksum of the printed matrix.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 2800;

fn init(path as *i32) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) {
            path[i * N + j] = i * j % 7 + 1;
            if ((i + j) % 13 == 0 || (i + j) % 7 == 0 || (i + j) % 11 == 0) { path[i * N + j] = 999; }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn floyd_warshall(path as *i32) as void {
    let is i32 as k with mut = 0;
    while (k < N) {
        let is i32 as i with mut = 0;
        while (i < N) {
            let is i32 as j with mut = 0;
            while (j < N) {
                let is i32 as through = path[i * N + k] + path[k * N + j];
                if (path[i * N + j] >= through) { path[i * N + j] = through; }
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
}

fn main() as i32 {
    let is i64 as nn = cast(i64, N) * cast(i64, N);
    let is *i32 as path = arr.alloc_i32(nn);
    let is *i32 as path2 = arr.alloc_i32(nn);
    init(path);
    floyd_warshall(path);
    init(path2);
    floyd_warshall(path2);
    if (arr.same_i32(path, path2, nn) == 0) { return 1; }
    let is i32 as i with mut = 0;
    while (i < N) {
        arr.row_i32(cast(*i32, cast(i64, path2) + cast(i64, i) * cast(i64, N) * 4), cast(i64, N));
        i = i + 1;
    }
    return arr.finish(9105400059800074021);
}
