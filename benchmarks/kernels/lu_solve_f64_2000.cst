// Double-precision LU factorization with partial pivoting and the matching
// solve on a 2000x2000 system: columns allocated one by one, entries from a
// Park-Miller generator (seed 1325, xored with a mask around each step,
// scaled to [0, 1)), right side the row sums so the answer is all ones.
// Prints a fixed report line.
// Self-check: every component of the solution is within 1e-9 of one, and
// the report.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is i32 as N with imut = 2000;
let is i32 as NP1 with imut = 2001;

let is mem.bins.Bins as heap with mut;
let is i64 as seed with mut = 1325;

fn random_double() as f64 {
    seed = seed ^ 123459876;
    let is i64 as k = seed / 127773;
    seed = 16807 * (seed - k * 127773) - 2836 * k;
    if (seed < 0) { seed = seed + 2147483647; }
    let is f64 as result = 4.65661287525E-10 * cast(f64, seed);
    seed = seed ^ 123459876;
    return result;
}

fn absd(v as f64) as f64 {
    if (v < 0.0) { return 0.0 - v; }
    return v;
}

fn matgen(a as **f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) { a[j][i] = random_double(); j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N) { b[i] = 0.0; i = i + 1; }
    let is i32 as j with mut = 0;
    while (j < N) {
        let is *f64 as col = a[j];
        i = 0;
        while (i < N) { b[i] = b[i] + col[i]; i = i + 1; }
        j = j + 1;
    }
}

// Offset of the entry of largest magnitude in dx[off .. off+n) (the first of
// equals).
fn amax(n as i32, dx as *f64, off as i32) as i32 {
    if (n < 1) { return 0 - 1; }
    if (n == 1) { return 0; }
    let is i32 as best with mut = 0;
    let is f64 as big with mut = absd(dx[off]);
    let is i32 as i with mut = 1;
    while (i < n) {
        let is f64 as v = absd(dx[i + off]);
        if (v > big) { best = i; big = v; }
        i = i + 1;
    }
    return best;
}

fn scale(n as i32, da as f64, dx as *f64, off as i32) as void {
    let is i32 as i with mut = 0;
    while (i < n) { dx[i + off] = dx[i + off] * da; i = i + 1; }
}

// dy[yo ..] += da * dx[xo ..] over n entries.
fn axpy(n as i32, da as f64, dx as *f64, xo as i32, dy as *f64, yo as i32) as void {
    if (n <= 0 || da == 0.0) { return; }
    let is i32 as i with mut = 0;
    while (i < n) { dy[i + yo] = dy[i + yo] + da * dx[i + xo]; i = i + 1; }
}

fn factor(a as **f64, piv as *i32) as void {
    let is i32 as k with mut = 0;
    while (k < N - 1) {
        let is *f64 as col_k = a[k];
        let is i32 as kp1 = k + 1;
        let is i32 as l = amax(N - k, col_k, k) + k;
        piv[k] = l;
        if (col_k[l] != 0.0) {
            if (l != k) {
                let is f64 as t = col_k[l];
                col_k[l] = col_k[k];
                col_k[k] = t;
            }
            scale(N - kp1, (0.0 - 1.0) / col_k[k], col_k, kp1);
            let is i32 as j with mut = kp1;
            while (j < N) {
                let is *f64 as col_j = a[j];
                let is f64 as t = col_j[l];
                if (l != k) {
                    col_j[l] = col_j[k];
                    col_j[k] = t;
                }
                axpy(N - kp1, t, col_k, kp1, col_j, kp1);
                j = j + 1;
            }
        }
        k = k + 1;
    }
    piv[N - 1] = N - 1;
}

fn solve(a as **f64, piv as *i32, b as *f64) as void {
    let is i32 as k with mut = 0;
    while (k < N - 1) {
        let is i32 as l = piv[k];
        let is f64 as t = b[l];
        if (l != k) {
            b[l] = b[k];
            b[k] = t;
        }
        axpy(N - (k + 1), t, a[k], k + 1, b, k + 1);
        k = k + 1;
    }
    let is i32 as kb with mut = 0;
    while (kb < N) {
        k = N - (kb + 1);
        b[k] = b[k] / a[k][k];
        axpy(k, 0.0 - b[k], a[k], 0, b, 0);
        kb = kb + 1;
    }
}

fn main() as i32 {
    let is **f64 as a = cast(**f64, mem.bins.bins_alloc(&heap, cast(i64, N) * 8));
    let is i32 as i with mut = 0;
    while (i < N) {
        a[i] = cast(*f64, mem.bins.bins_alloc(&heap, cast(i64, NP1) * 8));
        i = i + 1;
    }
    let is *f64 as b = cast(*f64, mem.bins.bins_alloc(&heap, cast(i64, N) * 8));
    let is *f64 as x = cast(*f64, mem.bins.bins_alloc(&heap, cast(i64, N) * 8));
    let is *i32 as piv = cast(*i32, mem.bins.bins_alloc(&heap, cast(i64, N) * 4));

    matgen(a, b);
    factor(a, piv);
    solve(a, piv, b);

    let is i32 as bad with mut = 0;
    i = 0;
    while (i < N) {
        if (absd(b[i] - 1.0) > 0.000000001) { bad = 1; }
        i = i + 1;
    }
    mem.bins.bins_free(&heap, cast(*u8, piv));
    mem.bins.bins_free(&heap, cast(*u8, x));
    mem.bins.bins_free(&heap, cast(*u8, b));
    i = 0;
    while (i < N) { mem.bins.bins_free(&heap, cast(*u8, a[i])); i = i + 1; }
    mem.bins.bins_free(&heap, cast(*u8, a));

    let is [128]u8 as buf;
    let is *u8 as o = cast(*u8, &buf);
    let is i64 as len = io.sprintf(o, 128, "\nlpbench (Std. C) run time: %f\n\n", 0.0);
    io.write_bytes(io.STDOUT, o, len);
    let is *u8 as want = "\nlpbench (Std. C) run time: 0.000000\n\n";
    let is i64 as k with mut = 0;
    while (k <= len) { if (o[k] != want[k]) { bad = 1; } k = k + 1; }
    return bad;
}
