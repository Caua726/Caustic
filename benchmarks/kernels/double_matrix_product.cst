// Product of two 40x40 double-precision matrices filled from a 16-bit linear
// congruential generator (seed 74755, x = (1309x + 13849) mod 65536, entries
// (x mod 120 - 60) / 3), each entry an inner product written through a
// pointer; redone from the same seed 10 times, run r printing diagonal entry
// r+1.
// Self-check: the 10 printed lines hash to the expected value.
use "../../std/io.cst" as io;

let is i32 as N with imut = 40;
let is i32 as W with imut = 41;        // row stride; row and column 0 unused
let is i64 as OCAP with imut = 4096;

let is [1681]f64 as ma with mut;
let is [1681]f64 as mb with mut;
let is [1681]f64 as mr with mut;
let is i64 as seed with mut = 0;

let is [4096]u8 as obuf with mut;
let is i64 as olen with mut = 0;

fn ocur() as *u8 { return cast(*u8, cast(i64, &obuf) + olen); }

// Writes what was collected; 1 unless it hashes (FNV-1a) to `want`.
fn flush_check(want as u64) as i32 {
    let is *u8 as b = cast(*u8, &obuf);
    io.write_bytes(io.STDOUT, b, olen);
    let is u64 as h with mut = 14695981039346656037;
    let is i64 as k with mut = 0;
    while (k < olen) { h = (h ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
    if (h != want) { return 1; }
    return 0;
}

fn next_rand() as i32 {
    seed = (seed * 1309 + 13849) & 65535;
    return cast(i32, seed);
}

fn fill(m as *f64) as void {
    let is i32 as i with mut = 1;
    while (i <= N) {
        let is i32 as j with mut = 1;
        while (j <= N) {
            let is i32 as t = next_rand();
            m[i * W + j] = cast(f64, t - (t / 120) * 120 - 60) / 3.0;
            j = j + 1;
        }
        i = i + 1;
    }
}

fn inner(result as *f64, a as *f64, b as *f64, row as i32, col as i32) as void {
    let is f64 as s with mut = 0.0;
    let is i32 as i with mut = 1;
    while (i <= N) {
        s = s + a[row * W + i] * b[i * W + col];
        i = i + 1;
    }
    result[0] = s;
}

fn product(run as i32) as void {
    seed = 74755;
    fill(cast(*f64, &ma));
    fill(cast(*f64, &mb));
    let is *f64 as r = cast(*f64, &mr);
    let is i32 as i with mut = 1;
    while (i <= N) {
        let is i32 as j with mut = 1;
        while (j <= N) {
            inner(cast(*f64, cast(i64, r) + cast(i64, i * W + j) * sizeof(f64)), cast(*f64, &ma), cast(*f64, &mb), i, j);
            j = j + 1;
        }
        i = i + 1;
    }
    if (run < 10) {
        olen = olen + io.sprintf(ocur(), OCAP - olen, "%f\n", cast(f64, r[(run + 1) * W + run + 1]));
    }
}

fn main() as i32 {
    let is i32 as r with mut = 0;
    while (r < 10) { product(r); r = r + 1; }
    return flush_check(3010527317513105713);
}
