// Three-dimensional gradient noise (a 256-entry permutation table doubled to
// 512, quintic fade curves, twelve gradient directions picked from four
// hash bits, trilinear blending of the eight cube corners), summed over
// about 42.7M points of a lattice walk along x in steps of 0.1235, with y
// stepping 2.45 at a time from -346.1235 up past 23.2345 for each x.
// Self-check: the hash of the printed sum.
use "../../std/io.cst" as io;
use "../../std/math.cst" as math;

let is [512]i32 as perm with mut;
let is u64 as out_hash with mut = 14695981039346656037;

let is *u8 as TABLE = "151 160 137 91 90 15 131 13 201 95 96 53 194 233 7 225 140 36 103 30 69 142 8 99 37 240 21 10 23 190 6 148 247 120 234 75 0 26 197 62 94 252 219 203 117 35 11 32 57 177 33 88 237 149 56 87 174 20 125 136 171 168 68 175 74 165 71 134 139 48 27 166 77 146 158 231 83 111 229 122 60 211 133 230 220 105 92 41 55 46 245 40 244 102 143 54 65 25 63 161 1 216 80 73 209 76 132 187 208 89 18 169 200 196 135 130 116 188 159 86 164 100 109 198 173 186 3 64 52 217 226 250 124 123 5 202 38 147 118 126 255 82 85 212 207 206 59 227 47 16 58 17 182 189 28 42 223 183 170 213 119 248 152 2 44 154 163 70 221 153 101 155 167 43 172 9 129 22 39 253 19 98 108 110 79 113 224 232 178 185 112 104 218 246 97 228 251 34 242 193 238 210 144 12 191 179 162 241 81 51 145 235 249 14 239 107 49 192 214 31 181 199 106 157 184 84 204 176 115 121 50 45 127 4 150 254 138 236 205 93 222 114 67 29 24 72 243 141 128 195 78 66 215 61 156 180";

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn fade(t as f64) as f64 { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0); }

fn mix(t as f64, a as f64, b as f64) as f64 { return a + t * (b - a); }

fn grad(hash as i32, x as f64, y as f64, z as f64) as f64 {
    let is i32 as h = hash & 15;
    let is f64 as u with mut = y;
    if (h < 8) { u = x; }
    let is f64 as v with mut = z;
    if (h < 4) { v = y; } else if (h == 12 || h == 14) { v = x; }
    if ((h & 1) != 0) { u = 0.0 - u; }
    if ((h & 2) != 0) { v = 0.0 - v; }
    return u + v;
}

fn noise(px as f64, py as f64, pz as f64) as f64 {
    let is f64 as fx = math.floor(px);
    let is f64 as fy = math.floor(py);
    let is f64 as fz = math.floor(pz);
    let is i32 as cx = cast(i32, fx) & 255;
    let is i32 as cy = cast(i32, fy) & 255;
    let is i32 as cz = cast(i32, fz) & 255;
    let is f64 as x = px - fx;
    let is f64 as y = py - fy;
    let is f64 as z = pz - fz;
    let is f64 as u = fade(x);
    let is f64 as v = fade(y);
    let is f64 as w = fade(z);
    let is i32 as a = perm[cx] + cy;
    let is i32 as aa = perm[a] + cz;
    let is i32 as ab = perm[a + 1] + cz;
    let is i32 as b = perm[cx + 1] + cy;
    let is i32 as ba = perm[b] + cz;
    let is i32 as bb = perm[b + 1] + cz;
    let is f64 as near = mix(v, mix(u, grad(perm[aa], x, y, z), grad(perm[ba], x - 1.0, y, z)),
                                mix(u, grad(perm[ab], x, y - 1.0, z), grad(perm[bb], x - 1.0, y - 1.0, z)));
    let is f64 as far = mix(v, mix(u, grad(perm[aa + 1], x, y, z - 1.0), grad(perm[ba + 1], x - 1.0, y, z - 1.0)),
                               mix(u, grad(perm[ab + 1], x, y - 1.0, z - 1.0), grad(perm[bb + 1], x - 1.0, y - 1.0, z - 1.0)));
    return mix(w, near, far);
}

fn main() as i32 {
    let is i64 as pos with mut = 0;
    let is i32 as i with mut = 0;
    while (i < 256) {
        let is i32 as v with mut = 0;
        while (TABLE[pos] >= 48 && TABLE[pos] <= 57) { v = v * 10 + cast(i32, TABLE[pos]) - 48; pos = pos + 1; }
        pos = pos + 1;
        perm[i] = v;
        perm[256 + i] = v;
        i = i + 1;
    }

    let is f64 as sum with mut = 0.0;
    let is f64 as x with mut = 0.0 - 11352.57;
    while (x < 23561.57) {
        let is f64 as y with mut = 0.0 - 346.1235;
        while (y < 124.124) {
            let is f64 as z = 0.0 - 156.235;
            while (y < 23.2345) {
                sum = sum + noise(x, y, z);
                y = y + 2.45;
            }
            y = y + 1.4325;
        }
        x = x + 0.1235;
    }
    let is [64]u8 as buf;
    emit(cast(*u8, &buf), io.sprintf(cast(*u8, &buf), 64, "%e\n", sum));
    if (out_hash != 16232670033130630856) { return 1; }
    return 0;
}
