// Floating-point module 8 alone: the integral of series sin(x)cos(x)^2
// over [0, pi/3] by the trapezoidal rule in 156.25M steps.
// The shared modules and the output format are in lib/fp_modules.cst.
// Self-check: the hash of the printed lines.
use "../../lib/fp_modules.cst" as fp;

fn main() as i32 {
    fp.header();
    fp.line(8, fp.sine_cosine_squared_integral(156250000, fp.A3, fp.A5));
    if (fp.out_hash != 6109102114076064786) { return 1; }
    return 0;
}
