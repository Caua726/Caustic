// Floating-point module 5 alone: the integral of a series tan(x) (sin over
// cos, one division a step) over [0, pi/3] in 156.25M steps.
// The shared modules and the output format are in lib/fp_modules.cst.
// Self-check: the hash of the printed lines.
use "../../lib/fp_modules.cst" as fp;

fn main() as i32 {
    fp.header();
    fp.line(5, fp.tangent_integral(156250000, fp.A3, fp.A5));
    if (fp.out_hash != 16855755464463080595) { return 1; }
    return 0;
}
