// Floating-point module 4 alone: the integral of a series cos(x) over
// [0, pi/3] by the trapezoidal rule in 156.25M steps.
// The shared modules and the output format are in lib/fp_modules.cst.
// Self-check: the hash of the printed lines.
use "../../lib/fp_modules.cst" as fp;

fn main() as i32 {
    fp.header();
    fp.line(4, fp.cosine_integral(156250000, 0.0 - fp.A3, 0.0 - fp.A5));
    if (fp.out_hash != 2393216027440963862) { return 1; }
    return 0;
}
