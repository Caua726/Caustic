// Floating-point module 7 alone: three integrals of reciprocals of
// polynomials (three divisions a step) in 156.25M steps.
// The shared modules and the output format are in lib/fp_modules.cst.
// Self-check: the hash of the printed lines.
use "../../lib/fp_modules.cst" as fp;

fn main() as i32 {
    fp.header();
    let is i64 as next with mut = 0;
    fp.line(7, fp.reciprocal_integrals(156250000, 1.0, &next));
    if (fp.out_hash != 9471851007211057697) { return 1; }
    return 0;
}
