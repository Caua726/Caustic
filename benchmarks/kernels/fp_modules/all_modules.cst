// All eight floating-point modules in a row. Module 1 runs with 31250
// steps, then twice as many, and so on up to 512M (the original stops
// doubling once a pass takes a second; on current machines no pass does
// before the 512M cap, so the work here is the same). Its result sets the
// step count of module 2 (62912865), module 2's that of modules 3 to 7
// (62912870), module 7's that of module 8 (62912865 again), and
// the sin and cos series flip two coefficient signs from module 4 on.
// The shared modules and the output format are in lib/fp_modules.cst.
// Self-check: the hash of the printed lines.
use "../../lib/fp_modules.cst" as fp;
use "../../../std/io.cst" as io;

fn summary(label as *u8, v as f64) as void {
    let is [96]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    fp.say(bp, io.sprintf(bp, 96, "   %s = %10.4lf\n", label, v));
}

fn main() as i32 {
    let is f64 as scale = 0.015895;
    fp.header();
    let is i64 as m with mut = 0;
    let is f64 as err with mut = 0.0;
    let is i64 as n with mut = 15625;
    while (n != 512000000) {
        n = 2 * n;
        err = fp.rational_integral(n, scale, &m);
    }
    fp.line(1, err);
    let is i64 as m2 with mut = 0;
    fp.line(2, fp.pi_series(m, &m2));
    m = m2;
    fp.line(3, fp.sine_integral(m));
    let is f64 as a3 = 0.0 - fp.A3;
    let is f64 as a5 = 0.0 - fp.A5;
    fp.line(4, fp.cosine_integral(m, a3, a5));
    fp.line(5, fp.tangent_integral(m, a3, a5));
    fp.line(6, fp.sine_cosine_integral(m, a3, a5));
    let is i64 as m8 with mut = 0;
    fp.line(7, fp.reciprocal_integrals(m, scale, &m8));
    fp.line(8, fp.sine_cosine_squared_integral(m8, a3, a5));

    let is [96]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    fp.say_text("\n");
    fp.say(bp, io.sprintf(bp, 96, "   Iterations      = %10ld\n", m8));
    summary("NullTime (usec)", 0.0);
    summary("MFLOPS(1)      ", 0.0);
    summary("MFLOPS(2)      ", 0.0);
    summary("MFLOPS(3)      ", 0.0);
    summary("MFLOPS(4)      ", 0.0);
    fp.say_text("\n");
    if (fp.out_hash != 7410960048523115207) { return 1; }
    return 0;
}
