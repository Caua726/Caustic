// Floating-point module 2 alone: pi from 156.25M terms of the series for
// atan(1), after a sign-alternating warm-up loop of the same length.
// The shared modules and the output format are in lib/fp_modules.cst.
// Self-check: the hash of the printed lines.
use "../../lib/fp_modules.cst" as fp;

fn main() as i32 {
    fp.header();
    let is i64 as next with mut = 0;
    fp.line(2, fp.pi_series(156250000, &next));
    if (fp.out_hash != 11435753802031766401) { return 1; }
    return 0;
}
