// Floating-point module 3 alone: the integral of a series sin(x) over
// [0, pi/3] by the trapezoidal rule in 312.5M steps.
// The shared modules and the output format are in lib/fp_modules.cst.
// Self-check: the hash of the printed lines.
use "../../lib/fp_modules.cst" as fp;

fn main() as i32 {
    fp.header();
    fp.line(3, fp.sine_integral(312500000));
    if (fp.out_hash != 13024077208020547164) { return 1; }
    return 0;
}
