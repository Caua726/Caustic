// Floating-point module 1 alone: the integral of a rational function over
// [0, 1] in 312.5M steps (one division per step).
// The shared modules and the output format are in lib/fp_modules.cst.
// Self-check: the hash of the printed lines.
use "../../lib/fp_modules.cst" as fp;

fn main() as i32 {
    fp.header();
    let is i64 as next with mut = 0;
    fp.line(1, fp.rational_integral(312500000, 1.0, &next));
    if (fp.out_hash != 283285588164280071) { return 1; }
    return 0;
}
