// Floating-point module 6 alone: the integral of series sin(x)cos(x) over
// [0, pi/4] by the trapezoidal rule in 156.25M steps.
// The shared modules and the output format are in lib/fp_modules.cst.
// Self-check: the hash of the printed lines.
use "../../lib/fp_modules.cst" as fp;

fn main() as i32 {
    fp.header();
    fp.line(6, fp.sine_cosine_integral(156250000, fp.A3, fp.A5));
    if (fp.out_hash != 1996943574686220988) { return 1; }
    return 0;
}
