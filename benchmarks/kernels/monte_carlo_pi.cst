// Estimates pi by sampling 40M points of the unit square from two small
// linear congruential generators, one stepped in integers and one in
// single-precision floats (remainders taken by truncated division); each
// point's x^2 + y^2 goes into a running f32 total through a call, and the
// points inside the quarter circle are counted.
// Self-check: the hash of the printed lines.
use "../../std/io.cst" as io;

let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn add_to(sum as *f32, addend as *f32) as void {
    *sum = *sum + *addend;
}

fn main() as i32 {
    let is [128]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    emit(bp, io.sprintf(bp, 128, "Starting PI...\n"));
    let is f32 as ztot with mut = 0.0;
    let is i64 as low with mut = 1;
    let is i64 as ixran with mut = 1907;
    let is f32 as yran with mut = 5813.0;
    let is f32 as ymult = 1307.0;
    let is f32 as ymod = 5471.0;
    let is i64 as itot = 40000000;
    let is f32 as x with mut = 0.0;
    let is f32 as y with mut = 0.0;
    let is i64 as j with mut = 1;
    while (j <= itot) {
        let is i64 as iprod = 27611 * ixran;
        ixran = iprod - 74383 * (iprod / 74383);
        x = cast(f32, cast(f64, cast(f32, ixran)) / 74383.0);
        let is f32 as prod = ymult * yran;
        yran = prod - ymod * cast(f32, cast(i64, prod / ymod));
        y = yran / ymod;
        let is f32 as z with mut = x * x + y * y;
        add_to(&ztot, &z);
        if (cast(f64, z) <= 1.0) { low = low + 1; }
        j = j + 1;
    }
    emit(bp, io.sprintf(bp, 128, " x = %9.6f    y = %12.2f  low = %8d j = %7d\n",
                        cast(f64, x), cast(f64, y), cast(i32, low), cast(i32, j)));
    let is f32 as pi = cast(f32, 4.0 * cast(f64, cast(f32, low)) / cast(f64, cast(f32, itot)));
    emit(bp, io.sprintf(bp, 128, "Pi = %9.6f ztot = %12.2f itot = %8d\n",
                        cast(f64, pi), cast(f64, ztot) * 0.0, cast(i32, itot)));
    if (out_hash != 8779669838796543291) { return 1; }
    return 0;
}
