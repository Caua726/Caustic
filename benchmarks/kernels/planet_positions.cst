// The angle brought into [-pi, pi).
fn anpm(a as f64) as f64 {
    let is f64 as w = math.fmod(a, TWOPI);
    if (math.abs_f64(w) >= PI) {
        if (a < 0.0) { return w + TWOPI; }
        return w - TWOPI;
    }
    return w;
}

// Heliocentric position (pv[0..2]) and velocity (pv[3..5]) of planet np,
// equatorial, at Julian date jd0 + jd1.
fn planet_pv(jd0 as f64, jd1 as f64, np as i32, pv as *f64) as void {
    let is f64 as t = ((jd0 - J2000) + jd1) / JMILLENIA;
    let is i32 as e3 = np * 3;
    let is f64 as da with mut = a_t[e3] + (a_t[e3 + 1] + a_t[e3 + 2] * t) * t;
    let is f64 as dl with mut = (3600.0 * dlm_t[e3] + (dlm_t[e3 + 1] + dlm_t[e3 + 2] * t) * t) * A2R;
    let is f64 as de = e_t[e3] + (e_t[e3 + 1] + e_t[e3 + 2] * t) * t;
    let is f64 as dp = anpm((3600.0 * pi_t[e3] + (pi_t[e3 + 1] + pi_t[e3 + 2] * t) * t) * A2R);
    let is f64 as di = (3600.0 * dinc_t[e3] + (dinc_t[e3 + 1] + dinc_t[e3 + 2] * t) * t) * A2R;
    let is f64 as doh = anpm((3600.0 * omega_t[e3] + (omega_t[e3 + 1] + omega_t[e3 + 2] * t) * t) * A2R);

    let is f64 as dmu = 0.35953620 * t;
    let is i32 as p9 = np * 9;
    let is i32 as p10 = np * 10;
    let is i32 as k with mut = 0;
    while (k < 8) {
        let is f64 as arga = kp_t[p9 + k] * dmu;
        let is f64 as argl = kq_t[p10 + k] * dmu;
        da = da + (ca_t[p9 + k] * math.cos(arga) + sa_t[p9 + k] * math.sin(arga)) * 0.0000001;
        dl = dl + (cl_t[p10 + k] * math.cos(argl) + sl_t[p10 + k] * math.sin(argl)) * 0.0000001;
        k = k + 1;
    }
    let is f64 as arga8 = kp_t[p9 + 8] * dmu;
    da = da + t * (ca_t[p9 + 8] * math.cos(arga8) + sa_t[p9 + 8] * math.sin(arga8)) * 0.0000001;
    k = 8;
    while (k <= 9) {
        let is f64 as argl = kq_t[p10 + k] * dmu;
        dl = dl + t * (cl_t[p10 + k] * math.cos(argl) + sl_t[p10 + k] * math.sin(argl)) * 0.0000001;
        k = k + 1;
    }
    dl = math.fmod(dl, TWOPI);

    // Eccentric anomaly by Newton's method.
    let is f64 as am = dl - dp;
    let is f64 as ae with mut = am + de * math.sin(am);
    k = 0;
    while (1 == 1) {
        let is f64 as dae = (am - ae + de * math.sin(ae)) / (1.0 - de * math.cos(ae));
        ae = ae + dae;
        k = k + 1;
        if (k >= 10 || math.abs_f64(dae) < 1e-12) { break; }
    }

    let is f64 as ae2 = ae / 2.0;
    let is f64 as at = 2.0 * math.atan2(math.sqrt((1.0 + de) / (1.0 - de)) * math.sin(ae2), math.cos(ae2));
    let is f64 as r = da * (1.0 - de * math.cos(ae));
    let is f64 as v = GAUSSK * math.sqrt((1.0 + 1.0 / amas[np]) / (da * da * da));
    let is f64 as si2 = math.sin(di / 2.0);
    let is f64 as xq = si2 * math.cos(doh);
    let is f64 as xp = si2 * math.sin(doh);
    let is f64 as tl = at + dp;
    let is f64 as xsw = math.sin(tl);
    let is f64 as xcw = math.cos(tl);
    let is f64 as xm2 = 2.0 * (xp * xcw - xq * xsw);
    let is f64 as xf = da / math.sqrt(1.0 - de * de);
    let is f64 as ci2 = math.cos(di / 2.0);
    let is f64 as xms = (de * math.sin(dp) + xsw) * xf;
    let is f64 as xmc = (de * math.cos(dp) + xcw) * xf;
    let is f64 as xpxq2 = 2.0 * xp * xq;

    let is f64 as x = r * (xcw - xm2 * xp);
    let is f64 as y = r * (xsw + xm2 * xq);
    let is f64 as z = r * ((0.0 - xm2) * ci2);
    pv[0] = x;
    pv[1] = y * COSEPS - z * SINEPS;
    pv[2] = y * SINEPS + z * COSEPS;

    let is f64 as vx = v * (((0.0 - 1.0) + 2.0 * xp * xp) * xms + xpxq2 * xmc);
    let is f64 as vy = v * ((1.0 - 2.0 * xq * xq) * xmc - xpxq2 * xms);
    let is f64 as vz = v * (2.0 * ci2 * (xp * xms + xq * xmc));
    pv[3] = vx;
    pv[4] = vy * COSEPS - vz * SINEPS;
    pv[5] = vy * SINEPS + vz * COSEPS;
}

// Right ascension (hours), declination (degrees) and distance from a state.
fn ra_dec_dist(pv as *f64, rdd as *f64) as void {
    rdd[2] = math.sqrt(pv[0] * pv[0] + pv[1] * pv[1] + pv[2] * pv[2]);
    rdd[0] = math.atan2(pv[1], pv[0]) * R2H;
    if (rdd[0] < 0.0) { rdd[0] = rdd[0] + 24.0; }
    rdd[1] = math.asin(pv[2] / rdd[2]) * R2D;
}

fn main() as i32 {
    init_tables();
    let is [6]f64 as pv;
    let is [24]f64 as pos;
    let is i32 as i with mut = 0;
    while (i < TEST_LOOPS) {
        let is f64 as jd0 with mut = J2000;
        let is i32 as n with mut = 0;
        while (n < TEST_LENGTH) {
            jd0 = jd0 + 1.0;
            let is i32 as p with mut = 0;
            while (p < 8) {
                planet_pv(jd0, 0.0, p, cast(*f64, &pv));
                ra_dec_dist(cast(*f64, &pv), cast(*f64, cast(i64, &pos) + cast(i64, p * 3) * 8));
                p = p + 1;
            }
            n = n + 1;
        }
        i = i + 1;
    }
    let is i32 as p with mut = 0;
    while (p < 8) {
        olen = olen + io.sprintf(cast(*u8, cast(i64, &obuf) + olen), 1024 - olen, "%f %f %f\n", pos[p * 3], pos[p * 3 + 1], pos[p * 3 + 2]);
        p = p + 1;
    }

    let is *u8 as b = cast(*u8, &obuf);
    io.write_bytes(io.STDOUT, b, olen);
    let is u64 as h with mut = 14695981039346656037;
    let is i64 as k with mut = 0;
    while (k < olen) { h = (h ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
    if (h != 2339193838189384278) { return 1; }
    return 0;
}
