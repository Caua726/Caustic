// Positions of the eight planets from truncated mean orbital elements plus
// periodic terms (eight to ten cosine and sine pairs per element), solving
// Kepler's equation by Newton iteration and rotating to the equator, then
// right ascension, declination and distance, for noon on each of 36525
// consecutive days, the whole run repeated 20 times; prints the last day.
// Heavy on sin, cos, atan2, sqrt and fmod.
// Self-check: the eight printed lines hash to the expected value.
use "../../std/io.cst" as io;
use "../../std/math.cst" as math;

let is f64 as J2000 with imut = 2451545.0;
let is f64 as JMILLENIA with imut = 365250.0;
let is f64 as GAUSSK with imut = 0.01720209895;
let is f64 as SINEPS with imut = 0.3977771559319137;
let is f64 as COSEPS with imut = 0.9174820620691818;
let is i32 as TEST_LOOPS with imut = 20;
let is i32 as TEST_LENGTH with imut = 36525;

let is f64 as PI with mut = 3.14159265358979323846;
let is f64 as TWOPI with mut = 0.0;
let is f64 as A2R with mut = 0.0;
let is f64 as R2H with mut = 0.0;
let is f64 as R2D with mut = 0.0;

// Per planet: mean elements as constant, linear and quadratic terms in time.
let is [8]f64 as amas with mut;
let is [24]f64 as a_t with mut;          // semi-major axis
let is [24]f64 as dlm_t with mut;        // mean longitude
let is [24]f64 as e_t with mut;          // eccentricity
let is [24]f64 as pi_t with mut;         // longitude of perihelion
let is [24]f64 as dinc_t with mut;       // inclination
let is [24]f64 as omega_t with mut;      // longitude of the ascending node
// Periodic terms: frequencies and cosine/sine amplitudes.
let is [72]f64 as kp_t with mut;
let is [72]f64 as ca_t with mut;
let is [72]f64 as sa_t with mut;
let is [80]f64 as kq_t with mut;
let is [80]f64 as cl_t with mut;
let is [80]f64 as sl_t with mut;

let is [1024]u8 as obuf with mut;
let is i64 as olen with mut = 0;

fn put3(t as *f64, r as i32, x0 as f64, x1 as f64, x2 as f64) as void {
    t[r * 3] = x0; t[r * 3 + 1] = x1; t[r * 3 + 2] = x2;
}

fn put9(t as *f64, r as i32, x0 as f64, x1 as f64, x2 as f64, x3 as f64, x4 as f64, x5 as f64, x6 as f64, x7 as f64, x8 as f64) as void {
    let is *f64 as p = cast(*f64, cast(i64, t) + cast(i64, r * 9) * 8);
    p[0] = x0; p[1] = x1; p[2] = x2; p[3] = x3; p[4] = x4; p[5] = x5; p[6] = x6; p[7] = x7; p[8] = x8;
}

fn put10(t as *f64, r as i32, x0 as f64, x1 as f64, x2 as f64, x3 as f64, x4 as f64, x5 as f64, x6 as f64, x7 as f64, x8 as f64, x9 as f64) as void {
    let is *f64 as p = cast(*f64, cast(i64, t) + cast(i64, r * 10) * 8);
    p[0] = x0; p[1] = x1; p[2] = x2; p[3] = x3; p[4] = x4; p[5] = x5; p[6] = x6; p[7] = x7; p[8] = x8; p[9] = x9;
}

