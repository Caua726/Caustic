// Towers of Hanoi with 14 discs, the three pegs kept as linked stacks of
// cells drawn from an 18-cell free list (pushing checks the disc below is
// larger); each of 100 rounds prints the number of moves.
// Self-check: every round makes 16383 moves with no stack error, and the 100
// lines hash to the expected value.
use "../../std/io.cst" as io;

let is i32 as MAXCELLS with imut = 18;
let is i64 as OCAP with imut = 4096;

struct Cell {
    size as i32;
    next as i32;
}

let is [4]i32 as peg with mut;          // top cell of each peg, 0 = empty
let is [19]Cell as cells with mut;
let is i32 as free_head with mut = 0;
let is i32 as moves with mut = 0;
let is i32 as bad with mut = 0;

let is [4096]u8 as obuf with mut;
let is i64 as olen with mut = 0;

fn ocur() as *u8 { return cast(*u8, cast(i64, &obuf) + olen); }

// Writes what was collected; 1 unless it hashes (FNV-1a) to `want`.
fn flush_check(want as u64) as i32 {
    let is *u8 as b = cast(*u8, &obuf);
    io.write_bytes(io.STDOUT, b, olen);
    let is u64 as h with mut = 14695981039346656037;
    let is i64 as k with mut = 0;
    while (k < olen) { h = (h ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
    if (h != want) { return 1; }
    return 0;
}

fn fail(msg as *u8) as void {
    bad = 1;
    olen = olen + io.sprintf(ocur(), OCAP - olen, " Error in Towers: %s\n", msg);
}

fn take_cell() as i32 {
    if (free_head > 0) {
        let is i32 as c = free_head;
        free_head = cells[c].next;
        return c;
    }
    fail("out of space   ");
    return 0;
}

fn push(size as i32, s as i32) as void {
    let is i32 as top = peg[s];
    if (top > 0) {
        if (cells[top].size <= size) {
            fail("disc size error");
            return;
        }
    }
    let is i32 as c = take_cell();
    cells[c].next = top;
    peg[s] = c;
    cells[c].size = size;
}

fn pop(s as i32) as i32 {
    let is i32 as top = peg[s];
    if (top > 0) {
        let is i32 as size = cells[top].size;
        let is i32 as below = cells[top].next;
        cells[top].next = free_head;
        free_head = top;
        peg[s] = below;
        return size;
    }
    fail("nothing to pop ");
    return 0;
}

fn move_disc(from as i32, to as i32) as void {
    push(pop(from), to);
    moves = moves + 1;
}

fn tower(i as i32, j as i32, k as i32) as void {
    if (k == 1) {
        move_disc(i, j);
    } else {
        let is i32 as other = 6 - i - j;
        tower(i, other, k - 1);
        move_disc(i, j);
        tower(other, j, k - 1);
    }
}

fn round() as void {
    let is i32 as i with mut = 1;
    while (i <= MAXCELLS) { cells[i].next = i - 1; i = i + 1; }
    free_head = MAXCELLS;
    peg[1] = 0;
    let is i32 as d with mut = 14;
    while (d >= 1) { push(d, 1); d = d - 1; }
    peg[2] = 0;
    peg[3] = 0;
    moves = 0;
    tower(1, 2, 14);
    if (moves != 16383) {
        bad = 1;
        olen = olen + io.sprintf(ocur(), OCAP - olen, " Error in Towers.\n");
    }
    olen = olen + io.sprintf(ocur(), OCAP - olen, "%d\n", moves);
}

fn main() as i32 {
    let is i32 as r with mut = 0;
    while (r < 100) { round(); r = r + 1; }
    return bad | flush_check(597012243303132885);
}
