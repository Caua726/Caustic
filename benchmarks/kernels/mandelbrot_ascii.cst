// A 78x78 character picture of the Mandelbrot set: c runs over
// (j/40 - 0.5) + (i/40)i for i, j in [-39, 39), and a point is drawn as '*'
// when z stays within |z|^2 <= 4 for 65536 steps (z starting at c). Points
// inside the set cost the full 65536 complex squarings, written out by hand.
// Self-check: the hash of the picture.
use "../../std/io.cst" as io;

let is i32 as MAX_STEPS with imut = 65536;
let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn sqr(x as f64) as f64 { return x * x; }

fn norm2(re as f64, im as f64) as f64 { return sqr(re) + sqr(im); }

// Steps taken before escaping, counted from 1; MAX_STEPS + 1 means the point
// never escaped.
fn escape_steps(cre as f64, cim as f64) as i32 {
    let is f64 as zre with mut = cre;
    let is f64 as zim with mut = cim;
    let is i32 as i with mut = 1;
    while (norm2(zre, zim) <= 4.0) {
        let is i32 as was = i;
        i = i + 1;
        if (was >= MAX_STEPS) { break; }
        let is f64 as re = zre * zre - zim * zim + cre;
        zim = zre * zim + zim * zre + cim;
        zre = re;
    }
    return i;
}

fn main() as i32 {
    let is [80]u8 as row;
    let is *u8 as r = cast(*u8, &row);
    let is i32 as j with mut = 0 - 39;
    while (j < 39) {
        let is i32 as i with mut = 0 - 39;
        let is i64 as k with mut = 0;
        while (i < 39) {
            if (escape_steps(cast(f64, j) / 40.0 - 0.5, cast(f64, i) / 40.0) > MAX_STEPS) {
                r[k] = 42;
            } else {
                r[k] = 32;
            }
            k = k + 1;
            i = i + 1;
        }
        r[k] = 10;
        emit(r, k + 1);
        j = j + 1;
    }
    if (out_hash != 3026512315819631757) { return 1; }
    return 0;
}
