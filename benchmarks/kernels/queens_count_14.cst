// Counts every placement of 14 non-attacking queens on a 14x14 board: one
// queen per rank, files and both diagonals marked with the rank that owns
// them, walked with pointers as the queen moves along the rank.
// Self-check: 365596 solutions, and the two printed lines hash to the
// expected value.
use "../../std/io.cst" as io;

let is i32 as QUEENS with imut = 14;
let is i32 as MAXQ with imut = 100;
let is i32 as EMPTY with imut = 101;

let is [100]i32 as queen with mut;
let is [100]i32 as file with mut;
let is [199]i32 as fordiag with mut;
let is [199]i32 as bakdiag with mut;
let is i64 as solutions with mut = 0;
let is u64 as out_hash with mut = 14695981039346656037;

fn say(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn find(level as i32) as void {
    if (level == QUEENS) {
        solutions = solutions + 1;
        return;
    }
    let is *i32 as fp with mut = cast(*i32, &file);
    let is *i32 as fdp with mut = cast(*i32, cast(i64, &fordiag) + cast(i64, level) * 4);
    let is *i32 as bdp with mut = cast(*i32, cast(i64, &bakdiag) + cast(i64, level + QUEENS - 1) * 4);
    let is i32 as f with mut = 0;
    while (f < QUEENS) {
        if (fp[0] >= level && fdp[0] >= level && bdp[0] >= level) {
            queen[level] = f;
            fp[0] = level;
            fdp[0] = level;
            bdp[0] = level;
            find(level + 1);
            fp[0] = EMPTY;
            fdp[0] = EMPTY;
            bdp[0] = EMPTY;
        }
        f = f + 1;
        fp = cast(*i32, cast(i64, fp) + 4);
        fdp = cast(*i32, cast(i64, fdp) + 4);
        bdp = cast(*i32, cast(i64, bdp) - 4);
    }
}

fn main() as i32 {
    let is [128]u8 as buf;
    let is *u8 as b = cast(*u8, &buf);
    say(b, io.sprintf(b, 128, "%d queens on a %dx%d board...\n", QUEENS, QUEENS, QUEENS));
    let is i32 as i with mut = 0;
    while (i < MAXQ) { file[i] = EMPTY; i = i + 1; }
    i = 0;
    while (i < MAXQ + MAXQ - 1) { fordiag[i] = EMPTY; bakdiag[i] = EMPTY; i = i + 1; }
    find(0);
    if (solutions == 1) { say(b, io.sprintf(b, 128, "...there is 1 solution\n")); }
    else { say(b, io.sprintf(b, 128, "...there are %ld solutions\n", solutions)); }
    if (solutions != 365596 || out_hash != 11936750331872023697) { return 1; }
    return 0;
}
