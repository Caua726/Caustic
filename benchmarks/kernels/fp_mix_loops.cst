// A synthetic mix of ten loop modules, 100000 "loops" scaling each one's
// trip count: f64 updates of four scalars and of four array elements, the
// array passed to a six-step procedure, conditional jumps, integer
// arithmetic used as array indices, atan/sin/cos, small procedure calls
// through a pointer, array element shuffles, and sqrt(exp(log(x)/t)).
// Each module prints its trip count, two integers and four results.
// Self-check: the hash of the printed lines.
use "../../std/io.cst" as io;
use "../../std/math.cst" as math;

let is f64 as t_mul with mut = 0.0;
let is f64 as t_div with mut = 0.0;
let is f64 as t_two with mut = 0.0;
let is [5]f64 as e1 with mut;
let is i32 as gj with mut = 0;
let is i32 as gk with mut = 0;
let is i32 as gl with mut = 0;
let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn report(n as i64, j as i64, k as i64, x1 as f64, x2 as f64, x3 as f64, x4 as f64) as void {
    let is [160]u8 as buf;
    let is *u8 as bp = cast(*u8, &buf);
    emit(bp, io.sprintf(bp, 160, "%7ld %7ld %7ld %12.4e %12.4e %12.4e %12.4e\n", n, j, k, x1, x2, x3, x4));
}

fn report_array(n as i64, j as i64, k as i64) as void {
    report(n, j, k, e1[1], e1[2], e1[3], e1[4]);
}

// Six rounds of the four-element update, the last element divided by 2.
fn update_array(e as *f64) as void {
    gj = 0;
    while (gj < 6) {
        e[1] = (e[1] + e[2] + e[3] - e[4]) * t_mul;
        e[2] = (e[1] + e[2] - e[3] + e[4]) * t_mul;
        e[3] = (e[1] - e[2] + e[3] + e[4]) * t_mul;
        e[4] = (0.0 - e[1] + e[2] + e[3] + e[4]) / t_two;
        gj = gj + 1;
    }
}

fn rotate_elements() as void {
    e1[gj] = e1[gk];
    e1[gk] = e1[gl];
    e1[gl] = e1[gj];
}

fn halve_sum(x as f64, y as f64, z as *f64) as void {
    let is f64 as x1 = t_mul * (x + y);
    let is f64 as y1 = t_mul * (x1 + y);
    *z = (x1 + y1) / t_two;
}

fn main() as i32 {
    let is i64 as loops = 100000;
    t_mul = 0.499975;
    t_div = 0.50025;
    t_two = 2.0;
    let is i64 as n1 = 0;
    let is i64 as n2 = 12 * loops;
    let is i64 as n3 = 14 * loops;
    let is i64 as n4 = 345 * loops;
    let is i64 as n6 = 210 * loops;
    let is i64 as n7 = 32 * loops;
    let is i64 as n8 = 899 * loops;
    let is i64 as n9 = 616 * loops;
    let is i64 as n10 = 0;
    let is i64 as n11 = 93 * loops;
    let is i64 as i with mut = 0;

    // Module 1: simple variables.
    let is f64 as x1 with mut = 1.0;
    let is f64 as x2 with mut = 0.0 - 1.0;
    let is f64 as x3 with mut = 0.0 - 1.0;
    let is f64 as x4 with mut = 0.0 - 1.0;
    i = 1;
    while (i <= n1) {
        x1 = (x1 + x2 + x3 - x4) * t_mul;
        x2 = (x1 + x2 - x3 + x4) * t_mul;
        x3 = (x1 - x2 + x3 + x4) * t_mul;
        x4 = (0.0 - x1 + x2 + x3 + x4) * t_mul;
        i = i + 1;
    }
    report(n1, n1, n1, x1, x2, x3, x4);

    // Module 2: array elements.
    e1[1] = 1.0;
    e1[2] = 0.0 - 1.0;
    e1[3] = 0.0 - 1.0;
    e1[4] = 0.0 - 1.0;
    i = 1;
    while (i <= n2) {
        e1[1] = (e1[1] + e1[2] + e1[3] - e1[4]) * t_mul;
        e1[2] = (e1[1] + e1[2] - e1[3] + e1[4]) * t_mul;
        e1[3] = (e1[1] - e1[2] + e1[3] + e1[4]) * t_mul;
        e1[4] = (0.0 - e1[1] + e1[2] + e1[3] + e1[4]) * t_mul;
        i = i + 1;
    }
    report_array(n2, n3, n2);

    // Module 3: the array as a parameter.
    i = 1;
    while (i <= n3) { update_array(cast(*f64, &e1)); i = i + 1; }
    report_array(n3, n2, n2);

    // Module 4: conditional jumps.
    let is i32 as j with mut = 1;
    i = 1;
    while (i <= n4) {
        if (j == 1) { j = 2; } else { j = 3; }
        if (j > 2) { j = 0; } else { j = 1; }
        if (j < 1) { j = 1; } else { j = 0; }
        i = i + 1;
    }
    report(n4, cast(i64, j), cast(i64, j), x1, x2, x3, x4);

    // Module 6: integer arithmetic, the results used as indices.
    gj = 1;
    gk = 2;
    gl = 3;
    i = 1;
    while (i <= n6) {
        gj = gj * (gk - gj) * (gl - gk);
        gk = gl * gk - (gl - gj) * gk;
        gl = (gl - gk) * (gk + gj);
        e1[gl - 1] = cast(f64, gj + gk + gl);
        e1[gk - 1] = cast(f64, gj * gk * gl);
        i = i + 1;
    }
    report_array(n6, cast(i64, gj), cast(i64, gk));

    // Module 7: trigonometric functions.
    let is f64 as x with mut = 0.5;
    let is f64 as y with mut = 0.5;
    i = 1;
    while (i <= n7) {
        x = t_mul * math.atan(t_two * math.sin(x) * math.cos(x) / (math.cos(x + y) + math.cos(x - y) - 1.0));
        y = t_mul * math.atan(t_two * math.sin(y) * math.cos(y) / (math.cos(x + y) + math.cos(x - y) - 1.0));
        i = i + 1;
    }
    report(n7, cast(i64, gj), cast(i64, gk), x, x, y, y);

    // Module 8: procedure calls.
    x = 1.0;
    y = 1.0;
    let is f64 as z with mut = 1.0;
    i = 1;
    while (i <= n8) { halve_sum(x, y, &z); i = i + 1; }
    report(n8, cast(i64, gj), cast(i64, gk), x, y, z, z);

    // Module 9: array references.
    gj = 1;
    gk = 2;
    gl = 3;
    e1[1] = 1.0;
    e1[2] = 2.0;
    e1[3] = 3.0;
    i = 1;
    while (i <= n9) { rotate_elements(); i = i + 1; }
    report_array(n9, cast(i64, gj), cast(i64, gk));

    // Module 10: integer arithmetic.
    gj = 2;
    gk = 3;
    i = 1;
    while (i <= n10) {
        gj = gj + gk;
        gk = gj + gk;
        gj = gk - gj;
        gk = gk - gj - gj;
        i = i + 1;
    }
    report(n10, cast(i64, gj), cast(i64, gk), x1, x2, x3, x4);

    // Module 11: standard functions.
    x = 0.75;
    i = 1;
    while (i <= n11) {
        x = math.sqrt(math.exp(math.log(x) / t_div));
        i = i + 1;
    }
    report(n11, cast(i64, gj), cast(i64, gk), x, x, x, x);

    let is [4]u8 as nl;
    nl[0] = 10;
    emit(cast(*u8, &nl), 1);
    if (out_hash != 5366170156397689184) { return 1; }
    return 0;
}
