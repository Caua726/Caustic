// The two matrix-vector products of a biconjugate-gradient step, s = A'r and
// q = A p, for A 2100x1900, in one sweep over A. Prints the first 1900
// characters of the 16-character code (lib/arrays.cst) of s, then the first
// 2100 of the code of q: the output buffer of the original ends at the
// element count, not at count times 16.
// Self-check: the checksum of the printed text.
use "../../lib/arrays.cst" as arr;

let is i32 as M with imut = 1900;
let is i32 as N with imut = 2100;

fn init(a as *f64, r as *f64, p as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < M) { p[i] = cast(f64, i % M) / cast(f64, M); i = i + 1; }
    i = 0;
    while (i < N) {
        r[i] = cast(f64, i % N) / cast(f64, N);
        let is i32 as j with mut = 0;
        while (j < M) { a[i * M + j] = cast(f64, i * (j + 1) % N) / cast(f64, N); j = j + 1; }
        i = i + 1;
    }
}

fn bicg(a as *f64, s as *f64, q as *f64, p as *f64, r as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < M) { s[i] = 0.0; i = i + 1; }
    i = 0;
    while (i < N) {
        q[i] = 0.0;
        let is i32 as j with mut = 0;
        while (j < M) {
            s[j] = s[j] + r[i] * a[i * M + j];
            q[i] = q[i] + a[i * M + j] * p[j];
            j = j + 1;
        }
        i = i + 1;
    }
}

fn main() as i32 {
    let is *f64 as a = arr.alloc_f64(cast(i64, N) * cast(i64, M));
    let is *f64 as s = arr.alloc_f64(cast(i64, M));
    let is *f64 as q = arr.alloc_f64(cast(i64, N));
    let is *f64 as p = arr.alloc_f64(cast(i64, M));
    let is *f64 as r = arr.alloc_f64(cast(i64, N));
    init(a, r, p);
    bicg(a, s, q, p, r);
    arr.row_f64_prefix(s, cast(i64, M));
    arr.row_f64_prefix(q, cast(i64, N));
    return arr.finish(13793908833809839497);
}
