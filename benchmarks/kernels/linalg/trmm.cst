// Triangular matrix product B = 1.5 * A' * B with A a 1000x1000 unit lower
// triangular matrix and B 1000x1200. Prints B in the 16-character code of
// lib/arrays.cst.
// Self-check: the checksum of the printed matrix.
use "../../lib/arrays.cst" as arr;

let is i32 as M with imut = 1000;
let is i32 as N with imut = 1200;

fn init(a as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < M) {
        let is i32 as j with mut = 0;
        while (j < i) { a[i * M + j] = cast(f64, (i + j) % M) / cast(f64, M); j = j + 1; }
        a[i * M + i] = 1.0;
        j = 0;
        while (j < N) { b[i * N + j] = cast(f64, (N + (i - j)) % N) / cast(f64, N); j = j + 1; }
        i = i + 1;
    }
}

fn trmm(alpha as f64, a as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < M) {
        let is i32 as j with mut = 0;
        while (j < N) {
            let is i32 as k with mut = i + 1;
            while (k < M) { b[i * N + j] = b[i * N + j] + a[k * M + i] * b[k * N + j]; k = k + 1; }
            b[i * N + j] = alpha * b[i * N + j];
            j = j + 1;
        }
        i = i + 1;
    }
}

fn main() as i32 {
    let is *f64 as a = arr.alloc_f64(cast(i64, M) * cast(i64, M));
    let is *f64 as b = arr.alloc_f64(cast(i64, M) * cast(i64, N));
    init(a, b);
    trmm(1.5, a, b);
    arr.matrix_f64(b, cast(i64, M), cast(i64, N));
    return arr.finish(512427132623064790);
}
