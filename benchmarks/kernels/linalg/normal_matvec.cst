// y = A'(A x) for A 1900x2100 (the product behind the normal equations),
// one row of A at a time: its dot product with x, then that times the row
// added into y. Prints y in the 16-character code of lib/arrays.cst.
// Self-check: the checksum of the printed vector.
use "../../lib/arrays.cst" as arr;

let is i32 as M with imut = 1900;
let is i32 as N with imut = 2100;

fn init(a as *f64, x as *f64) as void {
    let is f64 as fnum = cast(f64, N);
    let is i32 as i with mut = 0;
    while (i < N) { x[i] = 1.0 + cast(f64, i) / fnum; i = i + 1; }
    i = 0;
    while (i < M) {
        let is i32 as j with mut = 0;
        while (j < N) { a[i * N + j] = cast(f64, (i + j) % N) / cast(f64, 5 * M); j = j + 1; }
        i = i + 1;
    }
}

fn atax(a as *f64, x as *f64, y as *f64, tmp as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) { y[i] = 0.0; i = i + 1; }
    i = 0;
    while (i < M) {
        tmp[i] = 0.0;
        let is i32 as j with mut = 0;
        while (j < N) { tmp[i] = tmp[i] + a[i * N + j] * x[j]; j = j + 1; }
        j = 0;
        while (j < N) { y[j] = y[j] + a[i * N + j] * tmp[i]; j = j + 1; }
        i = i + 1;
    }
}

fn main() as i32 {
    let is *f64 as a = arr.alloc_f64(cast(i64, M) * cast(i64, N));
    let is *f64 as x = arr.alloc_f64(cast(i64, N));
    let is *f64 as y = arr.alloc_f64(cast(i64, N));
    let is *f64 as tmp = arr.alloc_f64(cast(i64, M));
    init(a, x);
    atax(a, x, y, tmp);
    arr.row_f64(y, cast(i64, N));
    return arr.finish(9732398981798897770);
}
