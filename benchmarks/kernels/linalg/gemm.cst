// General matrix product C = 1.5*A*B + 1.2*C with A 1000x1200, B 1200x1100
// and C 1000x1100 (entries from small modular formulas over the indices),
// i-k-j loop order. The product is computed twice, on two copies of C, and
// the copies must agree within 1e-5. Prints C in the 16-character code of
// lib/arrays.cst.
// Self-check: the agreement, and the checksum of the printed matrix.
use "../../lib/arrays.cst" as arr;

let is i32 as NI with imut = 1000;
let is i32 as NJ with imut = 1100;
let is i32 as NK with imut = 1200;

fn init(c as *f64, c2 as *f64, a as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < NI) {
        let is i32 as j with mut = 0;
        while (j < NJ) {
            let is f64 as v = cast(f64, (i * j + 1) % NI) / cast(f64, NI);
            c[i * NJ + j] = v;
            c2[i * NJ + j] = v;
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < NI) {
        let is i32 as j with mut = 0;
        while (j < NK) { a[i * NK + j] = cast(f64, i * (j + 1) % NK) / cast(f64, NK); j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < NK) {
        let is i32 as j with mut = 0;
        while (j < NJ) { b[i * NJ + j] = cast(f64, i * (j + 2) % NJ) / cast(f64, NJ); j = j + 1; }
        i = i + 1;
    }
}

fn gemm(alpha as f64, beta as f64, c as *f64, a as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < NI) {
        let is i32 as j with mut = 0;
        while (j < NJ) { c[i * NJ + j] = c[i * NJ + j] * beta; j = j + 1; }
        let is i32 as k with mut = 0;
        while (k < NK) {
            j = 0;
            while (j < NJ) {
                c[i * NJ + j] = c[i * NJ + j] + alpha * a[i * NK + k] * b[k * NJ + j];
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

fn main() as i32 {
    let is *f64 as c = arr.alloc_f64(cast(i64, NI) * cast(i64, NJ));
    let is *f64 as c2 = arr.alloc_f64(cast(i64, NI) * cast(i64, NJ));
    let is *f64 as a = arr.alloc_f64(cast(i64, NI) * cast(i64, NK));
    let is *f64 as b = arr.alloc_f64(cast(i64, NK) * cast(i64, NJ));
    let is f64 as alpha = 1.5;
    let is f64 as beta = 1.2;
    init(c, c2, a, b);
    gemm(alpha, beta, c, a, b);
    gemm(alpha, beta, c2, a, b);
    if (arr.close_f64(c, c2, cast(i64, NI) * cast(i64, NJ)) == 0) { return 1; }
    arr.matrix_f64(c2, cast(i64, NI), cast(i64, NJ));
    return arr.finish(14321115179184002245);
}
