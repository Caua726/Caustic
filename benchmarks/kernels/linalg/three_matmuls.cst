// Three matrix products, G = (A*B)*(C*D), with A 800x1000, B 1000x900,
// C 900x1200 and D 1200x1100, each entry a dot product accumulated in place.
// Prints G (800x1100) in the 16-character code of lib/arrays.cst.
// Self-check: the checksum of the printed matrix.
use "../../lib/arrays.cst" as arr;

let is i32 as NI with imut = 800;
let is i32 as NJ with imut = 900;
let is i32 as NK with imut = 1000;
let is i32 as NL with imut = 1100;
let is i32 as NM with imut = 1200;

fn init(a as *f64, b as *f64, c as *f64, d as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < NI) {
        let is i32 as j with mut = 0;
        while (j < NK) { a[i * NK + j] = cast(f64, (i * j + 1) % NI) / cast(f64, 5 * NI); j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < NK) {
        let is i32 as j with mut = 0;
        while (j < NJ) { b[i * NJ + j] = cast(f64, (i * (j + 1) + 2) % NJ) / cast(f64, 5 * NJ); j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < NJ) {
        let is i32 as j with mut = 0;
        while (j < NM) { c[i * NM + j] = cast(f64, i * (j + 3) % NL) / cast(f64, 5 * NL); j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < NM) {
        let is i32 as j with mut = 0;
        while (j < NL) { d[i * NL + j] = cast(f64, (i * (j + 2) + 2) % NK) / cast(f64, 5 * NK); j = j + 1; }
        i = i + 1;
    }
}

fn three_mm(e as *f64, a as *f64, b as *f64, f as *f64, c as *f64, d as *f64, g as *f64) as void {
    // E = A*B
    let is i32 as i with mut = 0;
    while (i < NI) {
        let is i32 as j with mut = 0;
        while (j < NJ) {
            e[i * NJ + j] = 0.0;
            let is i32 as k with mut = 0;
            while (k < NK) { e[i * NJ + j] = e[i * NJ + j] + a[i * NK + k] * b[k * NJ + j]; k = k + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    // F = C*D
    i = 0;
    while (i < NJ) {
        let is i32 as j with mut = 0;
        while (j < NL) {
            f[i * NL + j] = 0.0;
            let is i32 as k with mut = 0;
            while (k < NM) { f[i * NL + j] = f[i * NL + j] + c[i * NM + k] * d[k * NL + j]; k = k + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    // G = E*F
    i = 0;
    while (i < NI) {
        let is i32 as j with mut = 0;
        while (j < NL) {
            g[i * NL + j] = 0.0;
            let is i32 as k with mut = 0;
            while (k < NJ) { g[i * NL + j] = g[i * NL + j] + e[i * NJ + k] * f[k * NL + j]; k = k + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn main() as i32 {
    let is *f64 as e = arr.alloc_f64(cast(i64, NI) * cast(i64, NJ));
    let is *f64 as a = arr.alloc_f64(cast(i64, NI) * cast(i64, NK));
    let is *f64 as b = arr.alloc_f64(cast(i64, NK) * cast(i64, NJ));
    let is *f64 as f = arr.alloc_f64(cast(i64, NJ) * cast(i64, NL));
    let is *f64 as c = arr.alloc_f64(cast(i64, NJ) * cast(i64, NM));
    let is *f64 as d = arr.alloc_f64(cast(i64, NM) * cast(i64, NL));
    let is *f64 as g = arr.alloc_f64(cast(i64, NI) * cast(i64, NL));
    init(a, b, c, d);
    three_mm(e, a, b, f, c, d, g);
    arr.matrix_f64(g, cast(i64, NI), cast(i64, NL));
    return arr.finish(16582090990763553089);
}
