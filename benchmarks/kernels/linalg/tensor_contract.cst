// Multiresolution-analysis kernel: each of the 150x140 rows of a 3-D array
// (160 entries each) is replaced by its product with a 160x160 matrix,
// through a row-sized temporary. Computed twice, on two copies of the array,
// which must agree within 1e-5. For each of the 150 planes, prints the last
// row in the 16-character code of lib/arrays.cst (the original fills one
// line buffer row by row and prints it once per plane).
// Self-check: the agreement, and the checksum of the printed rows.
use "../../lib/arrays.cst" as arr;

let is i32 as NQ with imut = 140;
let is i32 as NR with imut = 150;
let is i32 as NP with imut = 160;

fn init(a as *f64, a2 as *f64, c4 as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < NR) {
        let is i32 as j with mut = 0;
        while (j < NQ) {
            let is i32 as k with mut = 0;
            while (k < NP) {
                let is f64 as v = cast(f64, (i * j + k) % NP) / cast(f64, NP);
                a[(i * NQ + j) * NP + k] = v;
                a2[(i * NQ + j) * NP + k] = v;
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < NP) {
        let is i32 as j with mut = 0;
        while (j < NP) { c4[i * NP + j] = cast(f64, i * j % NP) / cast(f64, NP); j = j + 1; }
        i = i + 1;
    }
}

fn doitgen(a as *f64, c4 as *f64, sum as *f64) as void {
    let is i32 as r with mut = 0;
    while (r < NR) {
        let is i32 as q with mut = 0;
        while (q < NQ) {
            let is i32 as base = (r * NQ + q) * NP;
            let is i32 as p with mut = 0;
            while (p < NP) {
                sum[p] = 0.0;
                let is i32 as s with mut = 0;
                while (s < NP) { sum[p] = sum[p] + a[base + s] * c4[s * NP + p]; s = s + 1; }
                p = p + 1;
            }
            p = 0;
            while (p < NP) { a[base + p] = sum[p]; p = p + 1; }
            q = q + 1;
        }
        r = r + 1;
    }
}

fn main() as i32 {
    let is i64 as total = cast(i64, NR) * cast(i64, NQ) * cast(i64, NP);
    let is *f64 as a = arr.alloc_f64(total);
    let is *f64 as a2 = arr.alloc_f64(total);
    let is *f64 as sum = arr.alloc_f64(cast(i64, NP));
    let is *f64 as c4 = arr.alloc_f64(cast(i64, NP) * cast(i64, NP));
    init(a, a2, c4);
    doitgen(a, c4, sum);
    doitgen(a2, c4, sum);
    if (arr.close_f64(a, a2, total) == 0) { return 1; }
    let is i32 as i with mut = 0;
    while (i < NR) {
        arr.row_f64(cast(*f64, cast(i64, a2) + cast(i64, (i * NQ + NQ - 1) * NP) * 8), cast(i64, NP));
        i = i + 1;
    }
    return arr.finish(5744026681757976843);
}
