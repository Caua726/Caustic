// Symmetric matrix product C = 1.5*A*B + 1.2*C with A a 60x60 symmetric
// matrix stored in its lower triangle (the upper one holds -999 and is never
// read) and B, C 60x80. Prints C in the 16-character code of lib/arrays.cst.
// Self-check: the checksum of the printed matrix.
use "../../lib/arrays.cst" as arr;

let is i32 as M with imut = 60;
let is i32 as N with imut = 80;

fn init(c as *f64, a as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < M) {
        let is i32 as j with mut = 0;
        while (j < N) {
            c[i * N + j] = cast(f64, (i + j) % 100) / cast(f64, M);
            b[i * N + j] = cast(f64, (N + i - j) % 100) / cast(f64, M);
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < M) {
        let is i32 as j with mut = 0;
        while (j <= i) { a[i * M + j] = cast(f64, (i + j) % 100) / cast(f64, M); j = j + 1; }
        j = i + 1;
        while (j < M) { a[i * M + j] = -999.0; j = j + 1; }
        i = i + 1;
    }
}

fn symm(alpha as f64, beta as f64, c as *f64, a as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < M) {
        let is i32 as j with mut = 0;
        while (j < N) {
            let is f64 as temp2 with mut = 0.0;
            let is i32 as k with mut = 0;
            while (k < i) {
                c[k * N + j] = c[k * N + j] + alpha * b[i * N + j] * a[i * M + k];
                temp2 = temp2 + b[k * N + j] * a[i * M + k];
                k = k + 1;
            }
            c[i * N + j] = beta * c[i * N + j] + alpha * b[i * N + j] * a[i * M + i] + alpha * temp2;
            j = j + 1;
        }
        i = i + 1;
    }
}

fn main() as i32 {
    let is *f64 as c = arr.alloc_f64(cast(i64, M) * cast(i64, N));
    let is *f64 as a = arr.alloc_f64(cast(i64, M) * cast(i64, M));
    let is *f64 as b = arr.alloc_f64(cast(i64, M) * cast(i64, N));
    init(c, a, b);
    symm(1.5, 1.2, c, a, b);
    arr.matrix_f64(c, cast(i64, M), cast(i64, N));
    return arr.finish(18323308154964831143);
}
