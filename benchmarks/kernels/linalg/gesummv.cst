// Sum of two matrix-vector products, y = 1.5 A x + 1.2 B x, on 90x90
// matrices. Prints y in the 16-character code of lib/arrays.cst.
// Self-check: the checksum of the printed vector.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 90;

fn init(a as *f64, b as *f64, x as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        x[i] = cast(f64, i % N) / cast(f64, N);
        let is i32 as j with mut = 0;
        while (j < N) {
            a[i * N + j] = cast(f64, (i * j + 1) % N) / cast(f64, N);
            b[i * N + j] = cast(f64, (i * j + 2) % N) / cast(f64, N);
            j = j + 1;
        }
        i = i + 1;
    }
}

fn gesummv(alpha as f64, beta as f64, a as *f64, b as *f64, tmp as *f64, x as *f64, y as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        tmp[i] = 0.0;
        y[i] = 0.0;
        let is i32 as j with mut = 0;
        while (j < N) {
            tmp[i] = a[i * N + j] * x[j] + tmp[i];
            y[i] = b[i * N + j] * x[j] + y[i];
            j = j + 1;
        }
        y[i] = alpha * tmp[i] + beta * y[i];
        i = i + 1;
    }
}

fn main() as i32 {
    let is i64 as n = cast(i64, N);
    let is *f64 as a = arr.alloc_f64(n * n);
    let is *f64 as b = arr.alloc_f64(n * n);
    let is *f64 as tmp = arr.alloc_f64(n);
    let is *f64 as x = arr.alloc_f64(n);
    let is *f64 as y = arr.alloc_f64(n);
    init(a, b, x);
    gesummv(1.5, 1.2, a, b, tmp, x, y);
    arr.row_f64(y, n);
    return arr.finish(11715037768526734434);
}
