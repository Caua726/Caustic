// Two chained matrix products, D = 1.5*A*B*C + 1.2*D, with A 40x70, B 70x50,
// C 50x80 and D 40x80, through a 40x50 temporary. Prints D in the
// 16-character code of lib/arrays.cst.
// Self-check: the checksum of the printed matrix.
use "../../lib/arrays.cst" as arr;

let is i32 as NI with imut = 40;
let is i32 as NJ with imut = 50;
let is i32 as NK with imut = 70;
let is i32 as NL with imut = 80;

fn init(a as *f64, b as *f64, c as *f64, d as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < NI) {
        let is i32 as j with mut = 0;
        while (j < NK) { a[i * NK + j] = cast(f64, (i * j + 1) % NI) / cast(f64, NI); j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < NK) {
        let is i32 as j with mut = 0;
        while (j < NJ) { b[i * NJ + j] = cast(f64, i * (j + 1) % NJ) / cast(f64, NJ); j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < NJ) {
        let is i32 as j with mut = 0;
        while (j < NL) { c[i * NL + j] = cast(f64, (i * (j + 3) + 1) % NL) / cast(f64, NL); j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < NI) {
        let is i32 as j with mut = 0;
        while (j < NL) { d[i * NL + j] = cast(f64, i * (j + 2) % NK) / cast(f64, NK); j = j + 1; }
        i = i + 1;
    }
}

fn two_mm(alpha as f64, beta as f64, tmp as *f64, a as *f64, b as *f64, c as *f64, d as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < NI) {
        let is i32 as j with mut = 0;
        while (j < NJ) {
            tmp[i * NJ + j] = 0.0;
            let is i32 as k with mut = 0;
            while (k < NK) {
                tmp[i * NJ + j] = tmp[i * NJ + j] + alpha * a[i * NK + k] * b[k * NJ + j];
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < NI) {
        let is i32 as j with mut = 0;
        while (j < NL) {
            d[i * NL + j] = d[i * NL + j] * beta;
            let is i32 as k with mut = 0;
            while (k < NJ) {
                d[i * NL + j] = d[i * NL + j] + tmp[i * NJ + k] * c[k * NL + j];
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn main() as i32 {
    let is *f64 as tmp = arr.alloc_f64(cast(i64, NI) * cast(i64, NJ));
    let is *f64 as a = arr.alloc_f64(cast(i64, NI) * cast(i64, NK));
    let is *f64 as b = arr.alloc_f64(cast(i64, NK) * cast(i64, NJ));
    let is *f64 as c = arr.alloc_f64(cast(i64, NJ) * cast(i64, NL));
    let is *f64 as d = arr.alloc_f64(cast(i64, NI) * cast(i64, NL));
    init(a, b, c, d);
    two_mm(1.5, 1.2, tmp, a, b, c, d);
    arr.matrix_f64(d, cast(i64, NI), cast(i64, NL));
    return arr.finish(13875675646217748176);
}
