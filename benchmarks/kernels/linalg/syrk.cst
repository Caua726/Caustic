// Symmetric rank-k update of the lower triangle, C = 1.5*A*A' + 1.2*C, with
// A 1200x1000 and C 1200x1200. Computed twice, on two copies of C, which
// must agree within 1e-5. Prints C (the untouched upper triangle included)
// in the 16-character code of lib/arrays.cst.
// Self-check: the agreement, and the checksum of the printed matrix.
use "../../lib/arrays.cst" as arr;

let is i32 as M with imut = 1000;
let is i32 as N with imut = 1200;

fn init(c as *f64, c2 as *f64, a as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < M) { a[i * M + j] = cast(f64, (i * j + 1) % N) / cast(f64, N); j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) {
            let is f64 as v = cast(f64, (i * j + 2) % M) / cast(f64, M);
            c[i * N + j] = v;
            c2[i * N + j] = v;
            j = j + 1;
        }
        i = i + 1;
    }
}

fn syrk(alpha as f64, beta as f64, c as *f64, a as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j <= i) { c[i * N + j] = c[i * N + j] * beta; j = j + 1; }
        let is i32 as k with mut = 0;
        while (k < M) {
            j = 0;
            while (j <= i) {
                c[i * N + j] = c[i * N + j] + alpha * a[i * M + k] * a[j * M + k];
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

fn main() as i32 {
    let is *f64 as c = arr.alloc_f64(cast(i64, N) * cast(i64, N));
    let is *f64 as c2 = arr.alloc_f64(cast(i64, N) * cast(i64, N));
    let is *f64 as a = arr.alloc_f64(cast(i64, N) * cast(i64, M));
    init(c, c2, a);
    syrk(1.5, 1.2, c, a);
    syrk(1.5, 1.2, c2, a);
    if (arr.close_f64(c, c2, cast(i64, N) * cast(i64, N)) == 0) { return 1; }
    arr.matrix_f64(c2, cast(i64, N), cast(i64, N));
    return arr.finish(13240900176987395053);
}
