// Vector multiplication and matrix addition on N = 2000: A += u1 v1' +
// u2 v2', x = 1.2 A' y + z, w = 1.5 A x. Prints w with two decimals, 20 to
// a line, between dump markers.
// Self-check: the checksum of the printed text.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 2000;

fn init(a as *f64, u1 as *f64, v1 as *f64, u2 as *f64, v2 as *f64, w as *f64,
        x as *f64, y as *f64, z as *f64) as void {
    let is f64 as fnum = cast(f64, N);
    let is i32 as i with mut = 0;
    while (i < N) {
        u1[i] = cast(f64, i);
        u2[i] = (cast(f64, i + 1) / fnum) / 2.0;
        v1[i] = (cast(f64, i + 1) / fnum) / 4.0;
        v2[i] = (cast(f64, i + 1) / fnum) / 6.0;
        y[i] = (cast(f64, i + 1) / fnum) / 8.0;
        z[i] = (cast(f64, i + 1) / fnum) / 9.0;
        x[i] = 0.0;
        w[i] = 0.0;
        let is i32 as j with mut = 0;
        while (j < N) { a[i * N + j] = cast(f64, i * j % N) / cast(f64, N); j = j + 1; }
        i = i + 1;
    }
}

fn gemver(alpha as f64, beta as f64, a as *f64, u1 as *f64, v1 as *f64, u2 as *f64, v2 as *f64,
          w as *f64, x as *f64, y as *f64, z as *f64) as void {
    let is i32 as i with mut = 0;
    let is i32 as j with mut = 0;
    while (i < N) {
        j = 0;
        while (j < N) {
            a[i * N + j] = a[i * N + j] + u1[i] * v1[j] + u2[i] * v2[j];
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < N) {
        j = 0;
        while (j < N) { x[i] = x[i] + beta * a[j * N + i] * y[j]; j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N) { x[i] = x[i] + z[i]; i = i + 1; }
    i = 0;
    while (i < N) {
        j = 0;
        while (j < N) { w[i] = w[i] + alpha * a[i * N + j] * x[j]; j = j + 1; }
        i = i + 1;
    }
}

fn main() as i32 {
    let is i64 as n = cast(i64, N);
    let is *f64 as a = arr.alloc_f64(n * n);
    let is *f64 as u1 = arr.alloc_f64(n);
    let is *f64 as v1 = arr.alloc_f64(n);
    let is *f64 as u2 = arr.alloc_f64(n);
    let is *f64 as v2 = arr.alloc_f64(n);
    let is *f64 as w = arr.alloc_f64(n);
    let is *f64 as x = arr.alloc_f64(n);
    let is *f64 as y = arr.alloc_f64(n);
    let is *f64 as z = arr.alloc_f64(n);
    init(a, u1, v1, u2, v2, w, x, y, z);
    gemver(1.5, 1.2, a, u1, v1, u2, v2, w, x, y, z);
    arr.dump_vector("w", w, n);
    return arr.finish(81076141223787035);
}
