// Two matrix-vector products with one 2000x2000 matrix, x1 += A y1 (along
// rows) and x2 += A' y2 (down columns). Computed twice, on two copies of x1
// and x2, which must agree within 1e-5. Prints x1 then x2 in the
// 16-character code of lib/arrays.cst.
// Self-check: the agreement, and the checksum of the printed vectors.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 2000;

fn init(x1 as *f64, x2 as *f64, x1b as *f64, x2b as *f64, y1 as *f64, y2 as *f64, a as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        x1[i] = cast(f64, i % N) / cast(f64, N);
        x1b[i] = x1[i];
        x2[i] = cast(f64, (i + 1) % N) / cast(f64, N);
        x2b[i] = x2[i];
        y1[i] = cast(f64, (i + 3) % N) / cast(f64, N);
        y2[i] = cast(f64, (i + 4) % N) / cast(f64, N);
        let is i32 as j with mut = 0;
        while (j < N) { a[i * N + j] = cast(f64, i * j % N) / cast(f64, N); j = j + 1; }
        i = i + 1;
    }
}

fn mvt(x1 as *f64, x2 as *f64, y1 as *f64, y2 as *f64, a as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) { x1[i] = x1[i] + a[i * N + j] * y1[j]; j = j + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) { x2[i] = x2[i] + a[j * N + i] * y2[j]; j = j + 1; }
        i = i + 1;
    }
}

fn main() as i32 {
    let is i64 as n = cast(i64, N);
    let is *f64 as a = arr.alloc_f64(n * n);
    let is *f64 as x1 = arr.alloc_f64(n);
    let is *f64 as x2 = arr.alloc_f64(n);
    let is *f64 as x1b = arr.alloc_f64(n);
    let is *f64 as x2b = arr.alloc_f64(n);
    let is *f64 as y1 = arr.alloc_f64(n);
    let is *f64 as y2 = arr.alloc_f64(n);
    init(x1, x2, x1b, x2b, y1, y2, a);
    mvt(x1, x2, y1, y2, a);
    mvt(x1b, x2b, y1, y2, a);
    if (arr.close_f64(x1, x1b, n) == 0 || arr.close_f64(x2, x2b, n) == 0) { return 1; }
    arr.row_f64(x1b, n);
    arr.row_f64(x2b, n);
    return arr.finish(13251013212197378258);
}
