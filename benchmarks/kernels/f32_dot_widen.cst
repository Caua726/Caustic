// Dot products of two 2048-element f32 arrays, each product taken in f64,
// 500000 times: the arrays are refilled every round from two f32 offsets
// that step by 0.1 and 0.2 every tenth round and reset otherwise, so the
// work is f32 additions, int-to-float and float-to-double conversions.
// Self-check: the hash of the printed total.
use "../../std/io.cst" as io;

let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn dot_wide(x as *f32, y as *f32, n as i64) as f64 {
    let is f64 as acc with mut = 0.0;
    let is i64 as i with mut = 0;
    while (i < n) {
        acc = acc + cast(f64, x[i]) * cast(f64, y[i]);
        i = i + 1;
    }
    return acc;
}

fn main() as i32 {
    let is [2048]f32 as xs;
    let is [2048]f32 as ys;
    let is *f32 as x = cast(*f32, &xs);
    let is *f32 as y = cast(*f32, &ys);
    let is f64 as total with mut = 0.0;
    let is f32 as a with mut = 0.0;
    let is f32 as b with mut = 1.0;
    let is i32 as round with mut = 0;
    while (round < 500000) {
        if (round % 10 != 0) {
            a = 0.0;
            b = 1.0;
        } else {
            a = a + 0.1;
            b = b + 0.2;
        }
        let is i32 as j with mut = 0;
        while (j < 2048) {
            x[j] = a + cast(f32, j);
            y[j] = b + cast(f32, j);
            j = j + 1;
        }
        total = total + dot_wide(x, y, 2048);
        round = round + 1;
    }
    let is [64]u8 as buf;
    emit(cast(*u8, &buf), io.sprintf(cast(*u8, &buf), 64, "Total is %g\n", total));
    if (out_hash != 3748213009890330513) { return 1; }
    return 0;
}
