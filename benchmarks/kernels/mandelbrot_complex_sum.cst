// Mandelbrot iteration over a 5000x5000 grid, real parts in [-2, 2) and
// imaginary parts from -2 down towards -6, at most 10 steps per point, stopping when the modulus (via hypot) reaches 2; the
// final z of every point is added to a running complex sum, whose real part
// is printed as an integer. Complex products are written out by hand.
// Self-check: the hash of the printed line.
use "../../std/io.cst" as io;
use "../../std/math.cst" as math;

let is i32 as SIZE with imut = 5000;
let is f64 as sum_re with mut = 0.0;
let is f64 as sum_im with mut = 0.0;
let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn accumulate(re as f64, im as f64) as void {
    sum_re = sum_re + re;
    sum_im = sum_im + im;
}

fn grid() as void {
    let is i32 as x with mut = 0;
    while (x < SIZE) {
        let is i32 as y with mut = 0;
        while (y < SIZE) {
            // The step is applied as (k * 4.0) / 5000, in that order.
            let is f64 as cre = 0.0 - 2.0 + cast(f64, x) * 4.0 / 5000.0;
            let is f64 as cim = 0.0 - 2.0 - cast(f64, y) * 4.0 / 5000.0;
            let is f64 as zre with mut = 0.0;
            let is f64 as zim with mut = 0.0;
            let is i32 as n with mut = 0;
            while (n < 10) {
                let is f64 as re = zre * zre - zim * zim + cre;
                let is f64 as im = zre * zim + zim * zre + cim;
                zre = re;
                zim = im;
                if (math.hypot(zre, zim) >= 2.0) { break; }
                n = n + 1;
            }
            accumulate(zre, zim);
            y = y + 1;
        }
        x = x + 1;
    }
}

fn main() as i32 {
    grid();
    let is [64]u8 as buf;
    emit(cast(*u8, &buf), io.sprintf(cast(*u8, &buf), 64, "%d\n", cast(i32, sum_re)));
    if (out_hash != 18102037779010518554) { return 1; }
    return 0;
}
