// Newtonian gravity for the Sun and the four outer planets: 5 million
// steps of 0.01 days, energy printed before and after.
// Self-check: both printed energies.
use "../../std/io.cst" as io;
use "../../std/math.cst" as math;

struct Planet {
    x as f64; y as f64; z as f64;
    vx as f64; vy as f64; vz as f64;
    mass as f64;
}

let is f64 as PI with imut = 3.141592653589793;
let is f64 as DAYS_PER_YEAR with imut = 365.24;
let is i32 as NBODIES with imut = 5;
let is [5]Planet as bodies with mut;

fn set_body(k as i32, x as f64, y as f64, z as f64, vx as f64, vy as f64, vz as f64, mass as f64) as void {
    let is *Planet as b = &bodies[k];
    b.x = x; b.y = y; b.z = z;
    b.vx = vx * DAYS_PER_YEAR; b.vy = vy * DAYS_PER_YEAR; b.vz = vz * DAYS_PER_YEAR;
    b.mass = mass * (4.0 * PI * PI);
}

fn advance(n as i32, bs as *Planet, dt as f64) as void {
    let is i32 as i with mut = 0;
    while (i < n) {
        let is *Planet as b = &bs[i];
        let is i32 as j with mut = i + 1;
        while (j < n) {
            let is *Planet as b2 = &bs[j];
            let is f64 as dx = b.x - b2.x;
            let is f64 as dy = b.y - b2.y;
            let is f64 as dz = b.z - b2.z;
            let is f64 as distance = math.sqrt(dx * dx + dy * dy + dz * dz);
            let is f64 as mag = dt / (distance * distance * distance);
            b.vx = b.vx - dx * b2.mass * mag;
            b.vy = b.vy - dy * b2.mass * mag;
            b.vz = b.vz - dz * b2.mass * mag;
            b2.vx = b2.vx + dx * b.mass * mag;
            b2.vy = b2.vy + dy * b.mass * mag;
            b2.vz = b2.vz + dz * b.mass * mag;
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        let is *Planet as b = &bs[i];
        b.x = b.x + dt * b.vx;
        b.y = b.y + dt * b.vy;
        b.z = b.z + dt * b.vz;
        i = i + 1;
    }
}

fn energy(n as i32, bs as *Planet) as f64 {
    let is f64 as e with mut = 0.0;
    let is i32 as i with mut = 0;
    while (i < n) {
        let is *Planet as b = &bs[i];
        e = e + 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz);
        let is i32 as j with mut = i + 1;
        while (j < n) {
            let is *Planet as b2 = &bs[j];
            let is f64 as dx = b.x - b2.x;
            let is f64 as dy = b.y - b2.y;
            let is f64 as dz = b.z - b2.z;
            let is f64 as distance = math.sqrt(dx * dx + dy * dy + dz * dz);
            e = e - (b.mass * b2.mass) / distance;
            j = j + 1;
        }
        i = i + 1;
    }
    return e;
}

fn offset_momentum(n as i32, bs as *Planet) as void {
    let is f64 as px with mut = 0.0;
    let is f64 as py with mut = 0.0;
    let is f64 as pz with mut = 0.0;
    let is i32 as i with mut = 0;
    while (i < n) {
        px = px + bs[i].vx * bs[i].mass;
        py = py + bs[i].vy * bs[i].mass;
        pz = pz + bs[i].vz * bs[i].mass;
        i = i + 1;
    }
    let is f64 as solar_mass = 4.0 * PI * PI;
    bs[0].vx = (0.0 - px) / solar_mass;
    bs[0].vy = (0.0 - py) / solar_mass;
    bs[0].vz = (0.0 - pz) / solar_mass;
}

// Formats e, writes it, and compares it with what it should read.
fn report(e as f64, want as *u8) as i32 {
    let is [64]u8 as buf;
    let is *u8 as b = cast(*u8, &buf);
    let is i64 as len = io.sprintf(b, 64, "%.9f\n", e);
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k <= len) { if (b[k] != want[k]) { return 1; } k = k + 1; }
    return 0;
}

fn main() as i32 {
    // The Sun sits at rest at the origin; its mass is 1 in these units.
    bodies[0].x = 0.0; bodies[0].y = 0.0; bodies[0].z = 0.0;
    bodies[0].vx = 0.0; bodies[0].vy = 0.0; bodies[0].vz = 0.0;
    bodies[0].mass = 4.0 * PI * PI;
    // Jupiter, Saturn, Uranus, Neptune: position (AU), velocity (AU/day),
    // mass (solar masses).
    set_body(1, 4.84143144246472090e+00, 0.0 - 1.16032004402742839e+00, 0.0 - 1.03622044471123109e-01,
             1.66007664274403694e-03, 7.69901118419740425e-03, 0.0 - 6.90460016972063023e-05,
             9.54791938424326609e-04);
    set_body(2, 8.34336671824457987e+00, 4.12479856412430479e+00, 0.0 - 4.03523417114321381e-01,
             0.0 - 2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05,
             2.85885980666130812e-04);
    set_body(3, 1.28943695621391310e+01, 0.0 - 1.51111514016986312e+01, 0.0 - 2.23307578892655734e-01,
             2.96460137564761618e-03, 2.37847173959480950e-03, 0.0 - 2.96589568540237556e-05,
             4.36624404335156298e-05);
    set_body(4, 1.53796971148509165e+01, 0.0 - 2.59193146099879641e+01, 1.79258772950371181e-01,
             2.68067772490389322e-03, 1.62824170038242295e-03, 0.0 - 9.51592254519715870e-05,
             5.15138902046611451e-05);

    let is *Planet as bs = &bodies[0];
    offset_momentum(NBODIES, bs);
    let is i32 as bad with mut = report(energy(NBODIES, bs), "-0.169075164\n");
    let is i32 as i with mut = 1;
    while (i <= 5000000) { advance(NBODIES, bs, 0.01); i = i + 1; }
    bad = bad + report(energy(NBODIES, bs), "-0.169083134\n");
    return bad;
}
