// Ackermann's function A(3, 8): deep, narrow recursion, two calls per level.
// Self-check: A(3, n) = 2^(n+3) - 3.
use "../../std/io.cst" as io;

fn ack(m as i32, n as i32) as i32 {
    if (m == 0) { return n + 1; }
    if (n == 0) { return ack(m - 1, 1); }
    return ack(m - 1, ack(m, n - 1));
}

fn main() as i32 {
    let is i32 as n = 8;
    let is i32 as r = ack(3, n);
    io.printf("Ack(3,%d): %d\n", n, r);
    if (r != (1 << (n + 3)) - 3) { return 1; }
    return 0;
}
