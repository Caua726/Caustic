// 400 million steps of a linear congruential generator (a = 3877,
// c = 29573, m = 139968), each scaled to a double in [0, 100).
// Self-check: the printed last value.
use "../../std/io.cst" as io;

let is i64 as last with mut = 42;

fn gen_random(max as f64) as f64 {
    last = (last * 3877 + 29573) % 139968;
    return max * cast(f64, last) / 139968.0;
}

fn main() as i32 {
    let is i32 as n with mut = 400000000 - 1;
    while (n > 0) {
        gen_random(100.0);
        n = n - 1;
    }
    let is [64]u8 as buf;
    let is *u8 as b = cast(*u8, &buf);
    let is i64 as len = io.sprintf(b, 64, "%.9f\n", gen_random(100.0));
    io.write_bytes(io.STDOUT, b, len);
    let is *u8 as want = "32.768918610\n";
    let is i64 as k with mut = 0;
    while (k <= len) { if (b[k] != want[k]) { return 1; } k = k + 1; }
    return 0;
}
