// Doubly recursive Fibonacci on unsigned 64-bit, fib(0) = fib(1) = 1, n = 43:
// about 1.4 billion calls.
// Self-check: the same number computed by iteration.
use "../../std/io.cst" as io;

fn fib(n as u64) as u64 {
    if (n < 2) { return 1; }
    return fib(n - 2) + fib(n - 1);
}

fn main() as i32 {
    let is u64 as n = 43;
    let is u64 as r = fib(n);
    io.printf("%lu\n", r);
    let is u64 as a with mut = 1;
    let is u64 as b with mut = 1;
    let is u64 as k with mut = 1;
    while (k < n) { let is u64 as t = a + b; a = b; b = t; k = k + 1; }
    if (r != b) { return 1; }
    return 0;
}
