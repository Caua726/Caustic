// All permutations of 7 integers by recursive swapping, counting every call;
// five passes from a fresh array make one round of 43300 calls, and each of
// 100 rounds prints its count.
// Self-check: every count is 43300, and the 100 lines hash to the expected
// value.
use "../../std/io.cst" as io;

let is i64 as OCAP with imut = 4096;

let is [11]i32 as perm with mut;
let is u32 as calls with mut = 0;
let is i32 as bad with mut = 0;

let is [4096]u8 as obuf with mut;
let is i64 as olen with mut = 0;

fn ocur() as *u8 { return cast(*u8, cast(i64, &obuf) + olen); }

// Writes what was collected; 1 unless it hashes (FNV-1a) to `want`.
fn flush_check(want as u64) as i32 {
    let is *u8 as b = cast(*u8, &obuf);
    io.write_bytes(io.STDOUT, b, olen);
    let is u64 as h with mut = 14695981039346656037;
    let is i64 as k with mut = 0;
    while (k < olen) { h = (h ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
    if (h != want) { return 1; }
    return 0;
}

fn swap(a as *i32, b as *i32) as void {
    let is i32 as t = a[0];
    a[0] = b[0];
    b[0] = t;
}

fn reset() as void {
    let is i32 as i with mut = 1;
    while (i <= 7) { perm[i] = i - 1; i = i + 1; }
}

fn permute(n as i32) as void {
    calls = calls + 1;
    if (n != 1) {
        permute(n - 1);
        let is i32 as k with mut = n - 1;
        while (k >= 1) {
            swap(&perm[n], &perm[k]);
            permute(n - 1);
            swap(&perm[n], &perm[k]);
            k = k - 1;
        }
    }
}

fn round() as void {
    calls = 0;
    let is i32 as i with mut = 1;
    while (i <= 5) { reset(); permute(7); i = i + 1; }
    if (calls != 43300) {
        bad = 1;
        olen = olen + io.sprintf(ocur(), OCAP - olen, " Error in Perm.\n");
    }
    olen = olen + io.sprintf(ocur(), OCAP - olen, "%d\n", calls);
}

fn main() as i32 {
    let is i32 as r with mut = 0;
    while (r < 100) { round(); r = r + 1; }
    return bad | flush_check(5490368755113614405);
}
