// Two-dimensional Gauss-Seidel stencil (nine-point average, updated in
// place) on a 2000x2000 grid, 500 time steps. Runs twice from fresh inputs,
// and the two results must agree within 1e-5. Prints the grid in the
// 16-character code of lib/arrays.cst.
// Self-check: the agreement, and the checksum of the printed grid.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 2000;
let is i32 as TSTEPS with imut = 500;

fn init(a as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) { a[i * N + j] = (cast(f64, i) * cast(f64, j + 2) + 2.0) / cast(f64, N); j = j + 1; }
        i = i + 1;
    }
}

fn seidel(a as *f64) as void {
    let is i32 as t with mut = 0;
    while (t <= TSTEPS - 1) {
        let is i32 as i with mut = 1;
        while (i <= N - 2) {
            let is i32 as j with mut = 1;
            while (j <= N - 2) {
                a[i * N + j] = (a[(i - 1) * N + j - 1] + a[(i - 1) * N + j] + a[(i - 1) * N + j + 1]
                                + a[i * N + j - 1] + a[i * N + j] + a[i * N + j + 1]
                                + a[(i + 1) * N + j - 1] + a[(i + 1) * N + j] + a[(i + 1) * N + j + 1]) / 9.0;
                j = j + 1;
            }
            i = i + 1;
        }
        t = t + 1;
    }
}

fn main() as i32 {
    let is i64 as nn = cast(i64, N) * cast(i64, N);
    let is *f64 as a = arr.alloc_f64(nn);
    let is *f64 as a2 = arr.alloc_f64(nn);
    init(a);
    seidel(a);
    init(a2);
    seidel(a2);
    if (arr.close_f64(a, a2, nn) == 0) { return 1; }
    arr.matrix_f64(a2, cast(i64, N), cast(i64, N));
    return arr.finish(15420042218421525656);
}
