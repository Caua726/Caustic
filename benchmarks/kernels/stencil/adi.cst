// Alternating-direction implicit solver for 2-D heat conduction on a
// 1000x1000 grid, 500 time steps: each step a column sweep then a row sweep,
// each a tridiagonal (Thomas) solve per line with a forward elimination and
// a back substitution. Prints the grid in the 16-character code of
// lib/arrays.cst.
// Self-check: the checksum of the printed grid.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 1000;
let is i32 as TSTEPS with imut = 500;

fn init(u as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) { u[i * N + j] = cast(f64, i + N - j) / cast(f64, N); j = j + 1; }
        i = i + 1;
    }
}

fn adi(u as *f64, v as *f64, p as *f64, q as *f64) as void {
    let is f64 as dx = 1.0 / cast(f64, N);
    let is f64 as dy = 1.0 / cast(f64, N);
    let is f64 as dt = 1.0 / cast(f64, TSTEPS);
    let is f64 as b1 = 2.0;
    let is f64 as b2 = 1.0;
    let is f64 as mul1 = b1 * dt / (dx * dx);
    let is f64 as mul2 = b2 * dt / (dy * dy);
    let is f64 as a = -mul1 / 2.0;
    let is f64 as b = 1.0 + mul1;
    let is f64 as c = a;
    let is f64 as d = -mul2 / 2.0;
    let is f64 as e = 1.0 + mul2;
    let is f64 as f = d;

    let is i32 as t with mut = 1;
    while (t <= TSTEPS) {
        // Column sweep: u -> v.
        let is i32 as i with mut = 1;
        while (i < N - 1) {
            v[i] = 1.0;
            p[i * N] = 0.0;
            q[i * N] = v[i];
            let is i32 as j with mut = 1;
            while (j < N - 1) {
                p[i * N + j] = -c / (a * p[i * N + j - 1] + b);
                q[i * N + j] = (-d * u[j * N + i - 1] + (1.0 + 2.0 * d) * u[j * N + i] - f * u[j * N + i + 1]
                                - a * q[i * N + j - 1]) / (a * p[i * N + j - 1] + b);
                j = j + 1;
            }
            v[(N - 1) * N + i] = 1.0;
            j = N - 2;
            while (j >= 1) {
                v[j * N + i] = p[i * N + j] * v[(j + 1) * N + i] + q[i * N + j];
                j = j - 1;
            }
            i = i + 1;
        }
        // Row sweep: v -> u.
        i = 1;
        while (i < N - 1) {
            u[i * N] = 1.0;
            p[i * N] = 0.0;
            q[i * N] = u[i * N];
            let is i32 as j with mut = 1;
            while (j < N - 1) {
                p[i * N + j] = -f / (d * p[i * N + j - 1] + e);
                q[i * N + j] = (-a * v[(i - 1) * N + j] + (1.0 + 2.0 * a) * v[i * N + j] - c * v[(i + 1) * N + j]
                                - d * q[i * N + j - 1]) / (d * p[i * N + j - 1] + e);
                j = j + 1;
            }
            u[i * N + N - 1] = 1.0;
            j = N - 2;
            while (j >= 1) {
                u[i * N + j] = p[i * N + j] * u[i * N + j + 1] + q[i * N + j];
                j = j - 1;
            }
            i = i + 1;
        }
        t = t + 1;
    }
}

fn main() as i32 {
    let is i64 as nn = cast(i64, N) * cast(i64, N);
    let is *f64 as u = arr.alloc_f64(nn);
    let is *f64 as v = arr.alloc_f64(nn);
    let is *f64 as p = arr.alloc_f64(nn);
    let is *f64 as q = arr.alloc_f64(nn);
    init(u);
    adi(u, v, p, q);
    arr.matrix_f64(u, cast(i64, N), cast(i64, N));
    return arr.finish(17609186582937664301);
}
