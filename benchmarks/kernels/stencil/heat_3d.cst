// Heat equation on a 120x120x120 grid, 500 time steps, each two sweeps of a
// 7-point stencil (A into B, then B into A). Prints A in the 16-character
// code of lib/arrays.cst.
// Self-check: the checksum of the printed grid.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 120;
let is i32 as TSTEPS with imut = 500;

fn init(a as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) {
            let is i32 as k with mut = 0;
            while (k < N) {
                let is f64 as v = cast(f64, i + j + (N - k)) * 10.0 / cast(f64, N);
                a[(i * N + j) * N + k] = v;
                b[(i * N + j) * N + k] = v;
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

// One sweep of the stencil from src into dst.
fn sweep(src as *f64, dst as *f64) as void {
    let is i32 as i with mut = 1;
    while (i < N - 1) {
        let is i32 as j with mut = 1;
        while (j < N - 1) {
            let is i32 as k with mut = 1;
            while (k < N - 1) {
                let is i32 as c = (i * N + j) * N + k;
                dst[c] = 0.125 * (src[c + N * N] - 2.0 * src[c] + src[c - N * N])
                       + 0.125 * (src[c + N] - 2.0 * src[c] + src[c - N])
                       + 0.125 * (src[c + 1] - 2.0 * src[c] + src[c - 1])
                       + src[c];
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fn heat(a as *f64, b as *f64) as void {
    let is i32 as t with mut = 1;
    while (t <= TSTEPS) {
        sweep(a, b);
        sweep(b, a);
        t = t + 1;
    }
}

fn main() as i32 {
    let is i64 as total = cast(i64, N) * cast(i64, N) * cast(i64, N);
    let is *f64 as a = arr.alloc_f64(total);
    let is *f64 as b = arr.alloc_f64(total);
    init(a, b);
    heat(a, b);
    arr.matrix_f64(a, cast(i64, N) * cast(i64, N), cast(i64, N));
    return arr.finish(12589807990608282077);
}
