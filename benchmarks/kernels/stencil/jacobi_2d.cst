// Two-dimensional Jacobi stencil (five-point average times 0.2) on a
// 1300x1300 grid, 500 time steps of two sweeps each. Runs twice from fresh
// inputs, and the two results must agree within 1e-5. Prints the grid in
// the 16-character code of lib/arrays.cst.
// Self-check: the agreement, and the checksum of the printed grid.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 1300;
let is i32 as TSTEPS with imut = 500;

fn init(a as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        let is i32 as j with mut = 0;
        while (j < N) {
            a[i * N + j] = (cast(f64, i) * cast(f64, j + 2) + 2.0) / cast(f64, N);
            b[i * N + j] = (cast(f64, i) * cast(f64, j + 3) + 3.0) / cast(f64, N);
            j = j + 1;
        }
        i = i + 1;
    }
}

// One sweep from src into dst.
fn sweep(src as *f64, dst as *f64) as void {
    let is i32 as i with mut = 1;
    while (i < N - 1) {
        let is i32 as j with mut = 1;
        while (j < N - 1) {
            dst[i * N + j] = 0.2 * (src[i * N + j] + src[i * N + j - 1] + src[i * N + 1 + j]
                                    + src[(1 + i) * N + j] + src[(i - 1) * N + j]);
            j = j + 1;
        }
        i = i + 1;
    }
}

fn jacobi(a as *f64, b as *f64) as void {
    let is i32 as t with mut = 0;
    while (t < TSTEPS) {
        sweep(a, b);
        sweep(b, a);
        t = t + 1;
    }
}

fn main() as i32 {
    let is i64 as nn = cast(i64, N) * cast(i64, N);
    let is *f64 as a = arr.alloc_f64(nn);
    let is *f64 as a2 = arr.alloc_f64(nn);
    let is *f64 as b = arr.alloc_f64(nn);
    init(a, b);
    jacobi(a, b);
    init(a2, b);
    jacobi(a2, b);
    if (arr.close_f64(a, a2, nn) == 0) { return 1; }
    arr.matrix_f64(a2, cast(i64, N), cast(i64, N));
    return arr.finish(11058006010308485232);
}
