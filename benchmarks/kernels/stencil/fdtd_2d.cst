// Two-dimensional finite-difference time-domain electromagnetics on a
// 1000x1200 grid, 500 steps: the Ey and Ex fields from the curl of Hz, then
// Hz from the curl of E, with the first row of Ey driven by the step count.
// Runs twice from fresh inputs, on two sets of fields. Prints the second
// set's Ex, Ey and Hz, row by row interleaved, in the 16-character code of
// lib/arrays.cst.
// Self-check: the checksum of the printed fields.
use "../../lib/arrays.cst" as arr;

let is i32 as TMAX with imut = 500;
let is i32 as NX with imut = 1000;
let is i32 as NY with imut = 1200;

fn init(ex as *f64, ey as *f64, hz as *f64, fict as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < TMAX) { fict[i] = cast(f64, i); i = i + 1; }
    i = 0;
    while (i < NX) {
        let is i32 as j with mut = 0;
        while (j < NY) {
            ex[i * NY + j] = cast(f64, i) * cast(f64, j + 1) / cast(f64, NX);
            ey[i * NY + j] = cast(f64, i) * cast(f64, j + 2) / cast(f64, NY);
            hz[i * NY + j] = cast(f64, i) * cast(f64, j + 3) / cast(f64, NX);
            j = j + 1;
        }
        i = i + 1;
    }
}

fn fdtd(ex as *f64, ey as *f64, hz as *f64, fict as *f64) as void {
    let is i32 as t with mut = 0;
    while (t < TMAX) {
        let is i32 as j with mut = 0;
        while (j < NY) { ey[j] = fict[t]; j = j + 1; }
        let is i32 as i with mut = 1;
        while (i < NX) {
            j = 0;
            while (j < NY) {
                ey[i * NY + j] = ey[i * NY + j] - 0.5 * (hz[i * NY + j] - hz[(i - 1) * NY + j]);
                j = j + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < NX) {
            j = 1;
            while (j < NY) {
                ex[i * NY + j] = ex[i * NY + j] - 0.5 * (hz[i * NY + j] - hz[i * NY + j - 1]);
                j = j + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < NX - 1) {
            j = 0;
            while (j < NY - 1) {
                hz[i * NY + j] = hz[i * NY + j] - 0.7 * (ex[i * NY + j + 1] - ex[i * NY + j]
                                                         + ey[(i + 1) * NY + j] - ey[i * NY + j]);
                j = j + 1;
            }
            i = i + 1;
        }
        t = t + 1;
    }
}

fn main() as i32 {
    let is i64 as nn = cast(i64, NX) * cast(i64, NY);
    let is *f64 as ex = arr.alloc_f64(nn);
    let is *f64 as ey = arr.alloc_f64(nn);
    let is *f64 as hz = arr.alloc_f64(nn);
    let is *f64 as ex2 = arr.alloc_f64(nn);
    let is *f64 as ey2 = arr.alloc_f64(nn);
    let is *f64 as hz2 = arr.alloc_f64(nn);
    let is *f64 as fict = arr.alloc_f64(cast(i64, TMAX));
    init(ex, ey, hz, fict);
    fdtd(ex, ey, hz, fict);
    init(ex2, ey2, hz2, fict);
    fdtd(ex2, ey2, hz2, fict);
    let is i64 as ny = cast(i64, NY);
    let is i64 as i with mut = 0;
    while (i < cast(i64, NX)) {
        arr.row_f64(cast(*f64, cast(i64, ex2) + i * ny * 8), ny);
        arr.row_f64(cast(*f64, cast(i64, ey2) + i * ny * 8), ny);
        arr.row_f64(cast(*f64, cast(i64, hz2) + i * ny * 8), ny);
        i = i + 1;
    }
    return arr.finish(8788626351171360522);
}
