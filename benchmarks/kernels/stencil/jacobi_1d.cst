// One-dimensional Jacobi stencil (three-point average times 0.33333) on 2000
// points, 500 time steps of two sweeps each. Runs twice from fresh inputs,
// and the two results must agree within 1e-5. Prints the array in the
// 16-character code of lib/arrays.cst.
// Self-check: the agreement, and the checksum of the printed array.
use "../../lib/arrays.cst" as arr;

let is i32 as N with imut = 2000;
let is i32 as TSTEPS with imut = 500;

fn init(a as *f64, b as *f64) as void {
    let is i32 as i with mut = 0;
    while (i < N) {
        a[i] = (cast(f64, i) + 2.0) / cast(f64, N);
        b[i] = (cast(f64, i) + 3.0) / cast(f64, N);
        i = i + 1;
    }
}

fn jacobi(a as *f64, b as *f64) as void {
    let is i32 as t with mut = 0;
    while (t < TSTEPS) {
        let is i32 as i with mut = 1;
        while (i < N - 1) { b[i] = 0.33333 * (a[i - 1] + a[i] + a[i + 1]); i = i + 1; }
        i = 1;
        while (i < N - 1) { a[i] = 0.33333 * (b[i - 1] + b[i] + b[i + 1]); i = i + 1; }
        t = t + 1;
    }
}

fn main() as i32 {
    let is i64 as n = cast(i64, N);
    let is *f64 as a = arr.alloc_f64(n);
    let is *f64 as a2 = arr.alloc_f64(n);
    let is *f64 as b = arr.alloc_f64(n);
    init(a, b);
    jacobi(a, b);
    init(a2, b);
    jacobi(a2, b);
    if (arr.close_f64(a, a2, n) == 0) { return 1; }
    arr.row_f64(a2, n);
    return arr.finish(10481150583616253908);
}
