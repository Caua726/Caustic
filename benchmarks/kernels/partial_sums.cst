// Nine partial sums over k = 1..2500000: (2/3)^k, k^-0.5, the Flint Hills and
// Cookson Hills series (sin and cos), and five that run two terms at a time
// in separate odd/even accumulators (harmonic, zeta(2), alternating
// harmonic, Leibniz, 1/k(k+1)).
// Self-check: the hash of the nine printed lines.
use "../../std/io.cst" as io;
use "../../std/math.cst" as math;

let is u64 as out_hash with mut = 14695981039346656037;

fn line(value as f64, name as *u8) as void {
    let is [128]u8 as buf;
    let is *u8 as b = cast(*u8, &buf);
    let is i64 as len = io.sprintf(b, 128, "%.9f\t%s\n", value, name);
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn main() as i32 {
    let is i32 as n = 2500000;
    let is f64 as two_thirds with mut = 0.0;
    let is f64 as sqrts with mut = 0.0;
    let is f64 as flint with mut = 0.0;
    let is f64 as cookson with mut = 0.0;
    let is f64 as k with mut = 1.0;
    while (k <= cast(f64, n)) {
        two_thirds = two_thirds + math.pow(2.0 / 3.0, k - 1.0);
        sqrts = sqrts + 1.0 / math.sqrt(k);
        let is f64 as k3 = k * k * k;
        let is f64 as s = math.sin(k);
        let is f64 as c = math.cos(k);
        flint = flint + 1.0 / (k3 * s * s);
        cookson = cookson + 1.0 / (k3 * c * c);
        k = k + 1.0;
    }

    // Lane 0 takes the odd k, lane 1 the even k; the lanes add up at the end.
    let is f64 as poly0 with mut = 0.0;
    let is f64 as poly1 with mut = 0.0;
    let is f64 as harm0 with mut = 0.0;
    let is f64 as harm1 with mut = 0.0;
    let is f64 as zeta0 with mut = 0.0;
    let is f64 as zeta1 with mut = 0.0;
    let is f64 as alt0 with mut = 0.0;
    let is f64 as alt1 with mut = 0.0;
    let is f64 as greg0 with mut = 0.0;
    let is f64 as greg1 with mut = 0.0;
    let is f64 as k0 with mut = 1.0;
    let is f64 as k1 with mut = 2.0;
    while (k0 <= cast(f64, n)) {
        poly0 = poly0 + 1.0 / (k0 * (k0 + 1.0));
        poly1 = poly1 + 1.0 / (k1 * (k1 + 1.0));
        harm0 = harm0 + 1.0 / k0;
        harm1 = harm1 + 1.0 / k1;
        zeta0 = zeta0 + 1.0 / (k0 * k0);
        zeta1 = zeta1 + 1.0 / (k1 * k1);
        alt0 = alt0 + 1.0 / k0;
        alt1 = alt1 + (0.0 - 1.0) / k1;
        greg0 = greg0 + 1.0 / (2.0 * k0 - 1.0);
        greg1 = greg1 + (0.0 - 1.0) / (2.0 * k1 - 1.0);
        k0 = k0 + 2.0;
        k1 = k1 + 2.0;
    }

    line(two_thirds, "(2/3)^k");
    line(sqrts, "k^-0.5");
    line(poly0 + poly1, "1/k(k+1)");
    line(flint, "Flint Hills");
    line(cookson, "Cookson Hills");
    line(harm0 + harm1, "Harmonic");
    line(zeta0 + zeta1, "Riemann Zeta");
    line(alt0 + alt1, "Alternating Harmonic");
    line(greg0 + greg1, "Gregory");
    if (out_hash != 13539836376991844882) { return 1; }
    return 0;
}
