// Deriche recursive edge-detection filter on a 4096x2160 single-precision
// image (pixel (i, j) = ((313 i + 991 j) mod 65536) / 65535, alpha = 0.25):
// causal and anticausal second-order recursions along rows, summed, then the
// same down columns. Filter coefficients from expf and powf. Runs twice from
// fresh inputs into two output images, which must agree within 1e-5. Prints
// the image in the 16-character code of lib/arrays.cst.
// Self-check: the agreement, and the checksum of the printed image.
use "../../../std/math.cst" as math;
use "../../lib/arrays.cst" as arr;

let is i32 as W with imut = 4096;
let is i32 as H with imut = 2160;

fn expf(x as f32) as f32 { return cast(f32, math.exp(cast(f64, x))); }
fn powf(b as f32, e as f32) as f32 { return cast(f32, math.pow(cast(f64, b), cast(f64, e))); }

fn init(img_in as *f32) as f32 {
    let is i32 as i with mut = 0;
    while (i < W) {
        let is i32 as j with mut = 0;
        while (j < H) {
            img_in[i * H + j] = cast(f32, (313 * i + 991 * j) % 65536) / 65535.0;
            j = j + 1;
        }
        i = i + 1;
    }
    return 0.25;
}

fn deriche(alpha as f32, img_in as *f32, img_out as *f32, y1 as *f32, y2 as *f32) as void {
    let is f32 as k = (1.0 - expf(-alpha)) * (1.0 - expf(-alpha))
                      / (1.0 + 2.0 * alpha * expf(-alpha) - expf(2.0 * alpha));
    let is f32 as a1 = k;
    let is f32 as a5 = k;
    let is f32 as a2 = k * expf(-alpha) * (alpha - 1.0);
    let is f32 as a6 = a2;
    let is f32 as a3 = k * expf(-alpha) * (alpha + 1.0);
    let is f32 as a7 = a3;
    let is f32 as a4 = -k * expf(-2.0 * alpha);
    let is f32 as a8 = a4;
    let is f32 as b1 = powf(2.0, -alpha);
    let is f32 as b2 = -expf(-2.0 * alpha);
    let is f32 as c1 = 1.0;
    let is f32 as c2 = 1.0;

    let is i32 as i with mut = 0;
    let is i32 as j with mut = 0;
    while (i < W) {
        let is f32 as ym1 with mut = 0.0;
        let is f32 as ym2 with mut = 0.0;
        let is f32 as xm1 with mut = 0.0;
        j = 0;
        while (j < H) {
            y1[i * H + j] = a1 * img_in[i * H + j] + a2 * xm1 + b1 * ym1 + b2 * ym2;
            xm1 = img_in[i * H + j];
            ym2 = ym1;
            ym1 = y1[i * H + j];
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < W) {
        let is f32 as yp1 with mut = 0.0;
        let is f32 as yp2 with mut = 0.0;
        let is f32 as xp1 with mut = 0.0;
        let is f32 as xp2 with mut = 0.0;
        j = H - 1;
        while (j >= 0) {
            y2[i * H + j] = a3 * xp1 + a4 * xp2 + b1 * yp1 + b2 * yp2;
            xp2 = xp1;
            xp1 = img_in[i * H + j];
            yp2 = yp1;
            yp1 = y2[i * H + j];
            j = j - 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < W) {
        j = 0;
        while (j < H) { img_out[i * H + j] = c1 * (y1[i * H + j] + y2[i * H + j]); j = j + 1; }
        i = i + 1;
    }
    j = 0;
    while (j < H) {
        let is f32 as tm1 with mut = 0.0;
        let is f32 as ym1 with mut = 0.0;
        let is f32 as ym2 with mut = 0.0;
        i = 0;
        while (i < W) {
            y1[i * H + j] = a5 * img_out[i * H + j] + a6 * tm1 + b1 * ym1 + b2 * ym2;
            tm1 = img_out[i * H + j];
            ym2 = ym1;
            ym1 = y1[i * H + j];
            i = i + 1;
        }
        j = j + 1;
    }
    j = 0;
    while (j < H) {
        let is f32 as tp1 with mut = 0.0;
        let is f32 as tp2 with mut = 0.0;
        let is f32 as yp1 with mut = 0.0;
        let is f32 as yp2 with mut = 0.0;
        i = W - 1;
        while (i >= 0) {
            y2[i * H + j] = a7 * tp1 + a8 * tp2 + b1 * yp1 + b2 * yp2;
            tp2 = tp1;
            tp1 = img_out[i * H + j];
            yp2 = yp1;
            yp1 = y2[i * H + j];
            i = i - 1;
        }
        j = j + 1;
    }
    i = 0;
    while (i < W) {
        j = 0;
        while (j < H) { img_out[i * H + j] = c2 * (y1[i * H + j] + y2[i * H + j]); j = j + 1; }
        i = i + 1;
    }
}

fn main() as i32 {
    let is i64 as total = cast(i64, W) * cast(i64, H);
    let is *f32 as img_in = arr.alloc_f32(total);
    let is *f32 as img_out = arr.alloc_f32(total);
    let is *f32 as img_out2 = arr.alloc_f32(total);
    let is *f32 as y1 = arr.alloc_f32(total);
    let is *f32 as y2 = arr.alloc_f32(total);
    let is f32 as alpha with mut = init(img_in);
    deriche(alpha, img_in, img_out, y1, y2);
    alpha = init(img_in);
    deriche(alpha, img_in, img_out2, y1, y2);
    if (arr.close_f32(img_out, img_out2, total) == 0) { return 1; }
    let is i32 as i with mut = 0;
    while (i < W) {
        arr.row_f32(cast(*f32, cast(i64, img_out2) + cast(i64, i) * cast(i64, H) * 4), cast(i64, H));
        i = i + 1;
    }
    return arr.finish(6100117488550159141);
}
