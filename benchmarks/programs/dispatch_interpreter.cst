// A bytecode interpreter loop: 2047 commands (opcodes 1..31 in turn, then a
// stop) run 100000 times, each command dispatched through a 32-entry table
// of 31 distinct handlers and each one calling out to add its opcode to a u32 sum.
// The first command of a run is entered through the initial decode, before
// any handler has set the current opcode, so it adds 0.
// Self-check: the hash of the printed sum.
use "../../std/io.cst" as io;

let is u32 as total with mut = 0;
let is [32]*u8 as handlers with mut;
let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn execute(code as i32) as void with noinline {
    total = total + cast(u32, code);
}

// A handler returns 0 to stop the loop.
fn op_stop(code as i32) as i32 { return 0; }

fn op_1(code as i32) as i32 { execute(code); return 1; }
fn op_2(code as i32) as i32 { execute(code); return 1; }
fn op_3(code as i32) as i32 { execute(code); return 1; }
fn op_4(code as i32) as i32 { execute(code); return 1; }
fn op_5(code as i32) as i32 { execute(code); return 1; }
fn op_6(code as i32) as i32 { execute(code); return 1; }
fn op_7(code as i32) as i32 { execute(code); return 1; }
fn op_8(code as i32) as i32 { execute(code); return 1; }
fn op_9(code as i32) as i32 { execute(code); return 1; }
fn op_10(code as i32) as i32 { execute(code); return 1; }
fn op_11(code as i32) as i32 { execute(code); return 1; }
fn op_12(code as i32) as i32 { execute(code); return 1; }
fn op_13(code as i32) as i32 { execute(code); return 1; }
fn op_14(code as i32) as i32 { execute(code); return 1; }
fn op_15(code as i32) as i32 { execute(code); return 1; }
fn op_16(code as i32) as i32 { execute(code); return 1; }
fn op_17(code as i32) as i32 { execute(code); return 1; }
fn op_18(code as i32) as i32 { execute(code); return 1; }
fn op_19(code as i32) as i32 { execute(code); return 1; }
fn op_20(code as i32) as i32 { execute(code); return 1; }
fn op_21(code as i32) as i32 { execute(code); return 1; }
fn op_22(code as i32) as i32 { execute(code); return 1; }
fn op_23(code as i32) as i32 { execute(code); return 1; }
fn op_24(code as i32) as i32 { execute(code); return 1; }
fn op_25(code as i32) as i32 { execute(code); return 1; }
fn op_26(code as i32) as i32 { execute(code); return 1; }
fn op_27(code as i32) as i32 { execute(code); return 1; }
fn op_28(code as i32) as i32 { execute(code); return 1; }
fn op_29(code as i32) as i32 { execute(code); return 1; }
fn op_30(code as i32) as i32 { execute(code); return 1; }
fn op_31(code as i32) as i32 { execute(code); return 1; }

fn eval(prog as *i32) as void with noinline {
    let is i64 as pc with mut = 0;
    let is i32 as first = prog[pc];
    pc = pc + 1;
    if (first == 0) { return; }
    execute(0);
    while (true) {
        let is i32 as op = prog[pc];
        pc = pc + 1;
        if (call(handlers[op], op) == 0) { return; }
    }
}

fn main() as i32 {
    handlers[0] = fn_ptr(op_stop);
    handlers[1] = fn_ptr(op_1);
    handlers[2] = fn_ptr(op_2);
    handlers[3] = fn_ptr(op_3);
    handlers[4] = fn_ptr(op_4);
    handlers[5] = fn_ptr(op_5);
    handlers[6] = fn_ptr(op_6);
    handlers[7] = fn_ptr(op_7);
    handlers[8] = fn_ptr(op_8);
    handlers[9] = fn_ptr(op_9);
    handlers[10] = fn_ptr(op_10);
    handlers[11] = fn_ptr(op_11);
    handlers[12] = fn_ptr(op_12);
    handlers[13] = fn_ptr(op_13);
    handlers[14] = fn_ptr(op_14);
    handlers[15] = fn_ptr(op_15);
    handlers[16] = fn_ptr(op_16);
    handlers[17] = fn_ptr(op_17);
    handlers[18] = fn_ptr(op_18);
    handlers[19] = fn_ptr(op_19);
    handlers[20] = fn_ptr(op_20);
    handlers[21] = fn_ptr(op_21);
    handlers[22] = fn_ptr(op_22);
    handlers[23] = fn_ptr(op_23);
    handlers[24] = fn_ptr(op_24);
    handlers[25] = fn_ptr(op_25);
    handlers[26] = fn_ptr(op_26);
    handlers[27] = fn_ptr(op_27);
    handlers[28] = fn_ptr(op_28);
    handlers[29] = fn_ptr(op_29);
    handlers[30] = fn_ptr(op_30);
    handlers[31] = fn_ptr(op_31);

    let is [2048]i32 as cmds;
    let is i32 as i with mut = 0;
    while (i < 2047) { cmds[i] = i % 31 + 1; i = i + 1; }
    cmds[2047] = 0;
    let is i32 as run with mut = 0;
    while (run < 100000) {
        eval(cast(*i32, &cmds));
        run = run + 1;
    }
    let is [64]u8 as buf;
    emit(cast(*u8, &buf), io.sprintf(cast(*u8, &buf), 64, "Sum: %u\n", total));
    if (out_hash != 5511559659066545707) { return 1; }
    return 0;
}
