// A bytecode interpreter loop: 2047 commands (opcodes 1..31 in turn, then a
// stop) run 100000 times, each command dispatched through a 32-entry table
// of handlers and each handler calling out to add its opcode to a u32 sum.
// The first command of a run is entered through the initial decode, before
// any handler has set the current opcode, so it adds 0.
// Self-check: the hash of the printed sum.
use "../../std/io.cst" as io;

let is u32 as total with mut = 0;
let is [32]*u8 as handlers with mut;
let is u64 as out_hash with mut = 14695981039346656037;

fn emit(b as *u8, len as i64) as void {
    io.write_bytes(io.STDOUT, b, len);
    let is i64 as k with mut = 0;
    while (k < len) { out_hash = (out_hash ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
}

fn execute(code as i32) as void {
    total = total + cast(u32, code);
}

// A handler returns 0 to stop the loop.
fn op_stop(code as i32) as i32 { return 0; }

fn op_add(code as i32) as i32 {
    execute(code);
    return 1;
}

fn eval(prog as *i32) as void {
    let is i64 as pc with mut = 0;
    let is i32 as first = prog[pc];
    pc = pc + 1;
    if (first == 0) { return; }
    execute(0);
    while (true) {
        let is i32 as op = prog[pc];
        pc = pc + 1;
        if (call(handlers[op], op) == 0) { return; }
    }
}

fn main() as i32 {
    handlers[0] = fn_ptr(op_stop);
    let is i32 as h with mut = 1;
    while (h < 32) { handlers[h] = fn_ptr(op_add); h = h + 1; }

    let is [2048]i32 as cmds;
    let is i32 as i with mut = 0;
    while (i < 2047) { cmds[i] = i % 31 + 1; i = i + 1; }
    cmds[2047] = 0;
    let is i32 as run with mut = 0;
    while (run < 100000) {
        eval(cast(*i32, &cmds));
        run = run + 1;
    }
    let is [64]u8 as buf;
    emit(cast(*u8, &buf), io.sprintf(cast(*u8, &buf), 64, "Sum: %u\n", total));
    if (out_hash != 5511559659066545707) { return 1; }
    return 0;
}
