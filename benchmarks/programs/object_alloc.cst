// Allocate-initialise-free of small objects, 70 million times for each of
// two kinds (a toggle and its every-third-call subtype, methods held as
// function pointers), with a few method calls printed in between.
// Self-check: the 13 printed states, worked out from the flip rules.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

struct Toggle {
    state as u8;
    value as *u8;      // fn(*Toggle) as u8
    activate as *u8;   // fn(*Toggle) as *Toggle
}

// Embeds a Toggle as its first member.
struct NthToggle {
    base as Toggle;
    count_max as i32;
    counter as i32;
}

let is mem.bins.Bins as heap with mut;

fn toggle_value(t as *Toggle) as u8 { return t.state; }

fn toggle_activate(t as *Toggle) as *Toggle {
    if (t.state == 0) { t.state = 1; } else { t.state = 0; }
    return t;
}

fn init_toggle(t as *Toggle, start as u8) as *Toggle {
    t.state = start;
    t.value = fn_ptr(toggle_value);
    t.activate = fn_ptr(toggle_activate);
    return t;
}

fn new_toggle(start as u8) as *Toggle {
    return init_toggle(cast(*Toggle, mem.bins.bins_alloc(&heap, sizeof(Toggle))), start);
}

fn nth_toggle_activate(t as *NthToggle) as *NthToggle {
    t.counter = t.counter + 1;
    if (t.counter >= t.count_max) {
        if (t.base.state == 0) { t.base.state = 1; } else { t.base.state = 0; }
        t.counter = 0;
    }
    return t;
}

fn new_nth_toggle(start as u8, max_count as i32) as *NthToggle {
    let is *NthToggle as t = cast(*NthToggle, init_toggle(cast(*Toggle, mem.bins.bins_alloc(&heap, sizeof(NthToggle))), start));
    t.count_max = max_count;
    t.counter = 0;
    t.base.activate = fn_ptr(nth_toggle_activate);
    return t;
}

fn say(v as u8) as void {
    if (v != 0) { io.write_bytes(io.STDOUT, "true\n", 5); }
    else { io.write_bytes(io.STDOUT, "false\n", 6); }
}

fn main() as i32 {
    let is i32 as n = 70000000;
    let is i32 as bad with mut = 0;

    let is *Toggle as tog with mut = new_toggle(1);
    let is i32 as i with mut = 0;
    while (i < 5) {
        let is *Toggle as t = cast(*Toggle, call(tog.activate, tog));
        let is u8 as v = cast(u8, call(t.value, tog));
        say(v);
        if (cast(i32, v) != i % 2) { bad = 1; }   // false, true, false, ...
        i = i + 1;
    }
    mem.bins.bins_free(&heap, cast(*u8, tog));
    i = 0;
    while (i < n) {
        tog = new_toggle(1);
        mem.bins.bins_free(&heap, cast(*u8, tog));
        i = i + 1;
    }

    io.write_bytes(io.STDOUT, "\n", 1);

    let is *NthToggle as ntog with mut = new_nth_toggle(1, 3);
    i = 0;
    while (i < 8) {
        let is *Toggle as t = cast(*Toggle, call(ntog.base.activate, cast(*Toggle, ntog)));
        let is u8 as v = cast(u8, call(t.value, cast(*Toggle, ntog)));
        say(v);
        if (cast(i32, v) != ((i + 1) / 3 + 1) % 2) { bad = 1; }   // flips on calls 3, 6
        i = i + 1;
    }
    mem.bins.bins_free(&heap, cast(*u8, ntog));
    i = 0;
    while (i < n) {
        ntog = new_nth_toggle(1, 3);
        mem.bins.bins_free(&heap, cast(*u8, ntog));
        i = i + 1;
    }
    return bad;
}
