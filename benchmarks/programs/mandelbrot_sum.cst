// The Mandelbrot set on a 500x500 grid over [-1.5, 0.5] x [-1, 1], at most
// 50 iterations per point: each row's escape bits are packed eight to a byte
// and every byte is xored into a running sum. Run 10 times.
// Self-check: the sum is 191.
use "../../std/io.cst" as io;

let is i32 as ROUNDS with imut = 10;
let is i32 as SIZE with imut = 500;

fn mandelbrot(size as i32) as i32 {
    let is i32 as sum with mut = 0;
    let is i32 as byte_acc with mut = 0;
    let is i32 as bit_num with mut = 0;
    let is i32 as y with mut = 0;
    while (y < size) {
        let is f64 as ci = 2.0 * cast(f64, y) / cast(f64, size) - 1.0;
        let is i32 as x with mut = 0;
        while (x < size) {
            let is f64 as zrzr with mut = 0.0;
            let is f64 as zi with mut = 0.0;
            let is f64 as zizi with mut = 0.0;
            let is f64 as cr = 2.0 * cast(f64, x) / cast(f64, size) - 1.5;
            let is i32 as z with mut = 0;
            let is i32 as not_done with mut = 1;
            let is i32 as escape with mut = 0;
            while (not_done != 0 && z < 50) {
                let is f64 as zr = zrzr - zizi + cr;
                zi = 2.0 * zr * zi + ci;
                zrzr = zr * zr;
                zizi = zi * zi;
                if (zrzr + zizi > 4.0) {
                    not_done = 0;
                    escape = 1;
                }
                z = z + 1;
            }
            byte_acc = (byte_acc << 1) + escape;
            bit_num = bit_num + 1;
            if (bit_num == 8) {
                sum = sum ^ byte_acc;
                byte_acc = 0;
                bit_num = 0;
            } else if (x == size - 1) {
                byte_acc = byte_acc << (8 - bit_num);
                sum = sum ^ byte_acc;
                byte_acc = 0;
                bit_num = 0;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return sum;
}

fn main() as i32 {
    let is i32 as result with mut = 0;
    let is i32 as r with mut = 0;
    while (r < ROUNDS) {
        result = mandelbrot(SIZE);
        if (result != 191) {
            io.printf("mandelbrot_sum: wrong result %d\n", result);
            return 1;
        }
        r = r + 1;
    }
    io.printf("mandelbrot_sum: %d\n", result);
    return 0;
}
