// Searches for an arithmetic expression over the numbers 13, 32 and 14 (each
// used at most once, with + - * and exact division, every intermediate a
// positive integer) that comes to 1412, by iterative deepening over a work
// list that grows with each combination; with no exact answer it prints the
// closest one found (14+13=27; 27*32=864).
// Self-check: the printed lines hash to the expected value.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is i32 as NOOP with imut = 0;
let is i32 as ADD with imut = 1;
let is i32 as SUB with imut = 2;
let is i32 as MUL with imut = 3;
let is i32 as DIV with imut = 4;

struct Comb {
    a as i32;
    b as i32;
    op as i32;
}

let is mem.bins.Bins as heap with mut;
let is i32 as goal with mut = 0;
let is i32 as count with mut = 0;          // numbers given
let is *i32 as work with mut;              // given numbers, then results
let is *Comb as combs with mut;            // combinations on the current path
let is *Comb as best_combs with mut;
let is i32 as best with mut = 0;
let is i32 as best_depth with mut = 0;
let is i32 as max_depth with mut = 0;
let is i32 as stop with mut = 0;
let is i32 as nodes with mut = 0;

let is [1024]u8 as obuf with mut;
let is i64 as olen with mut = 0;

fn out(s as *u8) as void {
    let is i64 as n = io.strlen(s);
    mem.memcpy(cast(*u8, cast(i64, &obuf) + olen), s, n);
    olen = olen + n;
}

fn out_int(v as i32) as void {
    olen = olen + io.sprintf(cast(*u8, cast(i64, &obuf) + olen), 1024 - olen, "%d", v);
}

fn abs(x as i32) as i32 {
    if (x < 0) { return 0 - x; }
    return x;
}

fn comb_at(list as *Comb, i as i32) as *Comb {
    return cast(*Comb, cast(i64, list) + cast(i64, i) * sizeof(Comb));
}

fn value(c as *Comb) as i32 {
    if (c.op == ADD) { return c.a + c.b; }
    if (c.op == SUB) { return c.a - c.b; }
    if (c.op == MUL) { return c.a * c.b; }
    if (c.op == DIV) { return c.a / c.b; }
    return 0;
}

fn save(dst as *Comb, src as *Comb, len as i32) as void {
    let is i32 as i with mut = 0;
    while (i < len) {
        let is *Comb as dc = comb_at(dst, i);
        let is *Comb as sc = comb_at(src, i);
        dc.a = sc.a;
        dc.b = sc.b;
        dc.op = sc.op;
        i = i + 1;
    }
    comb_at(dst, len).op = NOOP;
}

fn show(list as *Comb, len as i32) as void {
    let is i32 as i with mut = 0;
    while (i < len) {
        let is *Comb as c = comb_at(list, i);
        out_int(c.a);
        if (c.op == NOOP) { out(" "); }
        else if (c.op == ADD) { out("+"); }
        else if (c.op == SUB) { out("-"); }
        else if (c.op == MUL) { out("*"); }
        else { out(":"); }
        out_int(c.b);
        out("=");
        out_int(value(c));
        if (i < len - 1) { out("; "); } else { out(".\n"); }
        i = i + 1;
    }
    out("\n");
}

fn search(depth as i32, used as i32) as void {
    if (stop != 0) { return; }
    nodes = nodes + 1;
    if (depth == max_depth) {
        let is i32 as last = work[count + depth - 1];
        if (abs(last - goal) < abs(best - goal)) {
            best = last;
            best_depth = depth;
            save(best_combs, combs, depth);
            if (best == goal) {
                show(combs, depth);
                stop = 1;
            }
        }
        return;
    }
    let is i32 as op with mut = ADD;
    while (op <= DIV) {
        let is i32 as i with mut = 0;
        while (i < count + depth) {
            if (((1 << i) & used) == 0) {
                let is i32 as j with mut = 0;
                while (j < i) {
                    if (((1 << j) & used) == 0) {
                        let is i32 as x with mut = work[i];
                        let is i32 as y with mut = work[j];
                        let is i32 as skip with mut = 0;
                        if ((op == MUL || op == DIV) && (x == 1 || y == 1)) { skip = 1; }
                        if (x == 0 || y == 0) { skip = 1; }
                        if (skip == 0 && op == DIV && x % y != 0) { skip = 1; }
                        if (skip == 0) {
                            if ((op == DIV || op == SUB) && x < y) {
                                let is i32 as t = x;
                                x = y;
                                y = t;
                            }
                            let is *Comb as c = comb_at(combs, depth);
                            c.a = x;
                            c.b = y;
                            c.op = op;
                            work[count + depth] = value(c);
                            search(depth + 1, used | (1 << i) | (1 << j));
                        }
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        op = op + 1;
    }
}

fn main() as i32 {
    let is [4]i32 as given;
    given[0] = 13;
    given[1] = 32;
    given[2] = 14;
    given[3] = 1412;
    count = 3;
    goal = given[count];
    work = cast(*i32, mem.bins.bins_alloc(&heap, cast(i64, 2 * count) * 4));
    combs = cast(*Comb, mem.bins.bins_alloc(&heap, cast(i64, count) * sizeof(Comb)));
    best_combs = cast(*Comb, mem.bins.bins_alloc(&heap, cast(i64, count) * sizeof(Comb)));
    let is i32 as i with mut = 0;
    while (i < 2 * count) { work[i] = 0; i = i + 1; }
    i = 0;
    while (i < count) {
        work[i] = given[i];
        comb_at(combs, i).op = NOOP;
        comb_at(best_combs, i).op = NOOP;
        i = i + 1;
    }

    i = 0;
    while (i < count) {
        if (abs(work[i] - goal) < abs(best - goal)) { best = work[i]; }
        i = i + 1;
    }
    if (best == goal) {
        out(".\n");
    } else {
        max_depth = 1;
        while (max_depth < count && stop == 0) {
            search(0, 0);
            if (stop == 0) { max_depth = max_depth + 1; }
        }
        if (stop == 0) { show(best_combs, best_depth); }
    }

    let is *u8 as b = cast(*u8, &obuf);
    io.write_bytes(io.STDOUT, b, olen);
    let is u64 as h with mut = 14695981039346656037;
    let is i64 as k with mut = 0;
    while (k < olen) { h = (h ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
    if (h != 3851428022145359657) { return 1; }
    return 0;
}
