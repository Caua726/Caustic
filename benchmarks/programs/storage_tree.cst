// Builds a tree of heap arrays seven levels deep: every inner array holds 4
// slots, each pointing at the array below; the leaves are arrays of 1 to 10
// empty slots, their sizes drawn from a 16-bit generator. Each array
// remembers its length, and the whole tree is freed recursively. The run is
// 10 rounds of 1000 trees.
// Self-check: every tree has 5461 arrays.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is i32 as ROUNDS with imut = 10;
let is i32 as INNER with imut = 1000;

let is mem.bins.Bins as heap with mut;
let is i32 as count with mut = 0;
let is i32 as seed with mut = 0;

fn next_random() as i32 {
    seed = (seed * 1309 + 13849) & 65535;
    return seed;
}

// An array of n slots: its length in word 0, then n child pointers, all null.
fn new_array(n as i64) as *i64 {
    let is *i64 as a = cast(*i64, mem.bins.bins_alloc(&heap, (n + 1) * 8));
    a[0] = n;
    let is i64 as i with mut = 1;
    while (i <= n) { a[i] = 0; i = i + 1; }
    return a;
}

fn free_array(a as *i64) as void {
    let is i64 as n = a[0];
    let is i64 as i with mut = 1;
    while (i <= n) {
        if (a[i] != 0) { free_array(cast(*i64, a[i])); }
        i = i + 1;
    }
    mem.bins.bins_free(&heap, cast(*u8, a));
}

fn build_tree_depth(depth as i32) as *i64 {
    count = count + 1;
    if (depth == 1) {
        return new_array(cast(i64, next_random() % 10 + 1));
    }
    let is *i64 as arr = new_array(4);
    let is i64 as i with mut = 1;
    while (i <= 4) {
        arr[i] = cast(i64, build_tree_depth(depth - 1));
        i = i + 1;
    }
    return arr;
}

fn benchmark() as i32 {
    seed = 74755;
    count = 0;
    free_array(build_tree_depth(7));
    return count;
}

fn main() as i32 {
    let is i32 as result with mut = 0;
    let is i32 as r with mut = 0;
    while (r < ROUNDS) {
        let is i32 as k with mut = 0;
        while (k < INNER) {
            result = benchmark();
            if (result != 5461) {
                io.printf("storage_tree: wrong result %d\n", result);
                return 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    io.printf("storage_tree: %d arrays\n", result);
    return 0;
}
