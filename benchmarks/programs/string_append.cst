// Append "hello\n" 10 million times to a heap string, finding the end with
// strlen after each regrowth (the buffer doubles, contents copied over).
// Self-check: the final length is 6 per append.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is mem.bins.Bins as heap with mut;

fn grow(p as *u8, old as i64, size as i64) as *u8 {
    let is *u8 as q = mem.bins.bins_alloc(&heap, size);
    if (cast(i64, q) == 0) { return q; }
    mem.memcpy(q, p, old);
    mem.bins.bins_free(&heap, p);
    return q;
}

fn main() as i32 {
    let is i32 as n = 10000000;
    let is *u8 as stuff = "hello\n";
    let is i64 as stufflen = io.strlen(stuff);
    let is i64 as buflen with mut = 32;
    let is *u8 as strbuf with mut = mem.bins.bins_alloc(&heap, buflen);
    if (cast(i64, strbuf) == 0) { return 1; }
    mem.memzero(strbuf, buflen);
    let is i64 as end with mut = 0;   // strend - strbuf
    let is i32 as i with mut = 0;
    while (i < n) {
        if (buflen - end < stufflen + 1) {
            strbuf = grow(strbuf, buflen, 2 * buflen);
            if (cast(i64, strbuf) == 0) { return 1; }
            buflen = 2 * buflen;
            end = io.strlen(strbuf);
        }
        // strcat at the known end: copy through the terminator.
        let is *u8 as d = cast(*u8, cast(i64, strbuf) + end);
        let is i64 as k with mut = 0;
        while (k <= stufflen) { d[k] = stuff[k]; k = k + 1; }
        end = end + stufflen;
        i = i + 1;
    }
    let is i64 as len = io.strlen(strbuf);
    io.printf("%d\n", len);
    mem.bins.bins_free(&heap, strbuf);
    if (len != stufflen * cast(i64, n)) { return 1; }
    return 0;
}
