// Towers of Hanoi with heap-allocated disks kept as linked stacks on three
// piles: a tower of 14 disks is built on pile 0 and its top 13 are moved to
// pile 1, checking on every push that no disk lands on a smaller one; then
// the piles are freed. The run is 10 rounds of 600 such games.
// Self-check: every game takes 8191 moves.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is i32 as ROUNDS with imut = 10;
let is i32 as INNER with imut = 600;

struct Disk {
    size as i32;
    next as *Disk;
}

let is mem.bins.Bins as heap with mut;
let is [3]*Disk as piles with mut;
let is i32 as moves_done with mut = 0;

fn fail(msg as *u8) as void {
    io.write_bytes(io.STDERR, msg, io.strlen(msg));
    io.exit(1);
}

fn new_disk(size as i32) as *Disk {
    let is *Disk as d = cast(*Disk, mem.bins.bins_alloc(&heap, sizeof(Disk)));
    d.size = size;
    d.next = cast(*Disk, 0);
    return d;
}

fn free_disks(d as *Disk) as void {
    if (cast(i64, d) == 0) { return; }
    free_disks(d.next);
    mem.bins.bins_free(&heap, cast(*u8, d));
}

fn push_disk(disk as *Disk, pile as i32) as void {
    let is *Disk as top = piles[pile];
    if (cast(i64, top) != 0 && disk.size >= top.size) {
        fail("Cannot put a big disk on a smaller one\n");
    }
    disk.next = top;
    piles[pile] = disk;
}

fn pop_disk_from(pile as i32) as *Disk {
    let is *Disk as top = piles[pile];
    if (cast(i64, top) == 0) {
        fail("Attempting to remove a disk from an empty pile\n");
    }
    piles[pile] = top.next;
    top.next = cast(*Disk, 0);
    return top;
}

fn move_top_disk(from_pile as i32, to_pile as i32) as void {
    push_disk(pop_disk_from(from_pile), to_pile);
    moves_done = moves_done + 1;
}

fn build_tower_at(pile as i32, disks as i32) as void {
    let is i32 as i with mut = disks;
    while (i >= 0) {
        push_disk(new_disk(i), pile);
        i = i - 1;
    }
}

fn move_disks(disks as i32, from_pile as i32, to_pile as i32) as void {
    if (disks == 1) {
        move_top_disk(from_pile, to_pile);
    } else {
        let is i32 as other_pile = 3 - from_pile - to_pile;
        move_disks(disks - 1, from_pile, other_pile);
        move_top_disk(from_pile, to_pile);
        move_disks(disks - 1, other_pile, to_pile);
    }
}

fn benchmark() as i32 {
    piles[0] = cast(*Disk, 0);
    piles[1] = cast(*Disk, 0);
    piles[2] = cast(*Disk, 0);
    build_tower_at(0, 13);
    moves_done = 0;
    move_disks(13, 0, 1);
    free_disks(piles[0]);
    free_disks(piles[1]);
    free_disks(piles[2]);
    return moves_done;
}

fn main() as i32 {
    let is i32 as result with mut = 0;
    let is i32 as r with mut = 0;
    while (r < ROUNDS) {
        let is i32 as k with mut = 0;
        while (k < INNER) {
            result = benchmark();
            if (result != 8191) {
                io.printf("towers_moves: wrong result %d\n", result);
                return 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    io.printf("towers_moves: %d moves\n", result);
    return 0;
}
