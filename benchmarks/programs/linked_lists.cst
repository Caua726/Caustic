// Circular doubly linked lists of 100 integers, 3 million rounds of: build
// 1..100 in one block, copy it, move every item from the front of the copy
// to the back of an empty list and from there back again (reversing), reverse
// the original in place by swapping links, and compare. The head node holds
// the length.
// Self-check: every round checks itself as it goes; the last length is 100.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

struct Dll {
    val as i32;
    next as *Dll;   // next item, or the head after the tail
    prev as *Dll;   // previous item, or the tail before the first
}

let is mem.bins.Bins as heap with mut;
let is i32 as SIZE with imut = 100;

fn node_at(l as *Dll, i as i32) as *Dll {
    return cast(*Dll, cast(i64, l) + cast(i64, i) * sizeof(Dll));
}

fn push_tail(head as *Dll, item as *Dll) as void {
    let is *Dll as tail = head.prev;
    tail.next = item;
    item.next = head;
    head.prev = item;
    item.prev = tail;
    head.val = head.val + 1;
}

fn pop_tail(head as *Dll) as *Dll {
    if (head.val == 0) { return cast(*Dll, 0); }
    let is *Dll as tail = head.prev;
    let is *Dll as prev = tail.prev;
    prev.next = head;
    head.prev = prev;
    head.val = head.val - 1;
    return tail;
}

fn pop_head(head as *Dll) as *Dll {
    if (head.val == 0) { return cast(*Dll, 0); }
    let is *Dll as next = head.next;
    head.next = next.next;
    next.next.prev = head;
    head.val = head.val - 1;
    return next;
}

fn equal(x as *Dll, y as *Dll) as i32 {
    let is *Dll as xp with mut = x;
    let is *Dll as yp with mut = y;
    while (xp.next != x) {
        if (xp.val != yp.val) { return 0; }
        xp = xp.next;
        yp = yp.next;
    }
    if (xp.val != yp.val) { return 0; }
    if (yp.next == y) { return 1; }
    return 0;
}

fn list_new() as *Dll {
    let is *Dll as l = cast(*Dll, mem.bins.bins_alloc(&heap, sizeof(Dll)));
    l.next = l;
    l.prev = l;
    l.val = 0;
    return l;
}

// The items from..to in one allocation; node 0 is the head.
fn sequence(from0 as i32, to0 as i32) as *Dll {
    let is i32 as from with mut = from0;
    let is i32 as to with mut = to0;
    if (from > to) { let is i32 as t = from; from = to; to = t; }
    let is i32 as size = to - from + 1;
    let is *Dll as l = cast(*Dll, mem.bins.bins_alloc(&heap, cast(i64, size + 1) * sizeof(Dll)));
    from = from - 1;
    let is i32 as i with mut = 0;
    while (i < size) {
        let is *Dll as a = node_at(l, i);
        let is *Dll as b = node_at(l, i + 1);
        a.next = b;
        b.prev = a;
        a.val = from;
        from = from + 1;
        i = i + 1;
    }
    let is *Dll as last = node_at(l, size);
    l.prev = last;
    last.next = l;
    last.prev = node_at(l, size - 1);
    last.val = from;
    l.val = size;
    return l;
}

fn copy(x as *Dll) as *Dll {
    let is i32 as size = x.val;
    let is *Dll as l = cast(*Dll, mem.bins.bins_alloc(&heap, cast(i64, size + 1) * sizeof(Dll)));
    let is *Dll as xp with mut = x;
    let is i32 as i with mut = 0;
    while (i < size) {
        let is *Dll as a = node_at(l, i);
        let is *Dll as b = node_at(l, i + 1);
        a.next = b;
        b.prev = a;
        a.val = xp.val;
        xp = xp.next;
        i = i + 1;
    }
    let is *Dll as last = node_at(l, size);
    l.prev = last;
    last.next = l;
    last.val = x.prev.val;
    return l;
}

fn reverse(head as *Dll) as void {
    let is *Dll as p with mut = head;
    while (1 == 1) {
        let is *Dll as t = p.next;
        p.next = p.prev;
        p.prev = t;
        p = t;
        if (p == head) { return; }
    }
}

fn fail(msg as *u8) as void {
    io.printf("%s\n", msg);
    io.exit(1);
}

fn test_lists() as i32 {
    let is *Dll as li1 = sequence(1, SIZE);
    let is *Dll as li2 = copy(li1);
    let is *Dll as li3 = list_new();
    if (equal(li2, li1) == 0) { fail("li2 and li1 are not equal"); }
    while (li2.val != 0) { push_tail(li3, pop_head(li2)); }
    if (li2.val != 0) { fail("li2 should be empty now"); }
    while (li3.val != 0) { push_tail(li2, pop_tail(li3)); }
    if (li3.val != 0) { fail("li3 should be empty now"); }
    reverse(li1);
    if (li1.next.val != SIZE) { fail("li1 first value wrong"); }
    if (li1.prev.val != 1) { fail("li1 last value wrong"); }
    if (li2.next.val != SIZE) { fail("li2 first value wrong"); }
    if (li2.prev.val != 1) { fail("li2 last value wrong"); }
    if (li1.val != SIZE) { fail("li1 size wrong"); }
    if (equal(li1, li2) == 0) { fail("li1 and li2 are not equal"); }
    let is i32 as len = li1.val;
    mem.bins.bins_free(&heap, cast(*u8, li1));
    mem.bins.bins_free(&heap, cast(*u8, li2));
    mem.bins.bins_free(&heap, cast(*u8, li3));
    return len;
}

fn main() as i32 {
    let is i32 as n with mut = 3000000;
    let is i32 as result with mut = 0;
    while (n > 0) { result = test_lists(); n = n - 1; }
    io.printf("%d\n", result);
    if (result != SIZE) { return 1; }
    return 0;
}
