fn main() as i32 {
    let is Buffer as text;
    text.p = cast(*u8, 0);
    text.n = 0;
    text.cap = 0;
    document(&text);
    if (text.n != 25820) {
        io.printf("json_parse: document is %d bytes\n", text.n);
        return 1;
    }
    let is i32 as r with mut = 0;
    while (r < ROUNDS) {
        let is i32 as k with mut = 0;
        while (k < INNER) {
            let is *JsonValue as result = parse(&text);
            let is i32 as ok = has_expected_content(result);
            free_value(result);
            if (ok == 0) {
                io.printf("json_parse: unexpected content\n");
                return 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    io.printf("json_parse: 156 operations\n");
    return 0;
}
