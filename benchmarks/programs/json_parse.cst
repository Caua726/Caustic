// A JSON parser over a 25820-byte document (156 user-interface operations
// with nested objects, arrays, strings, numbers and literals): it walks the
// text one-character string at a time, captures names, strings and numbers
// as heap copies, and builds a tree of values in growable vectors, objects
// indexing their names through a small hash table. The parsed document is
// checked and freed. The run is 10 rounds of 100 parses.
// Self-check: the document is an object whose "head" is an object and whose
// "operations" is an array of 156 values.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is i32 as ROUNDS with imut = 10;
let is i32 as INNER with imut = 100;

let is mem.bins.Bins as heap with mut;

fn alloc(n as i64) as *u8 { return mem.bins.bins_alloc(&heap, n); }
fn release(p as *u8) as void { mem.bins.bins_free(&heap, p); }

fn fail(msg as *u8) as void {
    io.write_bytes(io.STDERR, msg, io.strlen(msg));
    io.write_bytes(io.STDERR, "\n", 1);
    io.exit(1);
}

// ---------------------------------------------------------------------------
// Growable vector of word-sized elements; appending past the capacity
// doubles the storage.

let is i64 as INITIAL_SIZE with imut = 10;

struct Vector {
    storage as *i64;
    capacity as i64;
    first as i64;
    last as i64;
}

fn new_storage(n as i64) as *i64 {
    let is *i64 as s = cast(*i64, alloc(n * 8));
    mem.memset(cast(*u8, s), 0, n * 8);
    return s;
}

fn vec_init(v as *Vector, size as i64) as void {
    if (size == 0) { v.storage = cast(*i64, 0); } else { v.storage = new_storage(size); }
    v.capacity = size;
    v.first = 0;
    v.last = 0;
}

fn vec_new(size as i64) as *Vector {
    let is *Vector as v = cast(*Vector, alloc(sizeof(Vector)));
    vec_init(v, size);
    return v;
}

fn vec_dispose(v as *Vector) as void {
    if (cast(i64, v.storage) != 0) { release(cast(*u8, v.storage)); }
}

fn vec_free(v as *Vector) as void {
    vec_dispose(v);
    release(cast(*u8, v));
}

fn vec_append(v as *Vector, elem as i64) as void {
    if (cast(i64, v.storage) == 0) {
        v.storage = new_storage(INITIAL_SIZE);
        v.capacity = INITIAL_SIZE;
    } else if (v.last >= v.capacity) {
        v.capacity = v.capacity * 2;
        let is *i64 as ns = new_storage(v.capacity);
        let is i64 as i with mut = 0;
        while (i < v.last) { ns[i] = v.storage[i]; i = i + 1; }
        release(cast(*u8, v.storage));
        v.storage = ns;
    }
    v.storage[v.last] = elem;
    v.last = v.last + 1;
}

fn vec_at(v as *Vector, idx as i64) as *i64 {
    if (cast(i64, v.storage) == 0 || idx >= v.last - v.first) { return cast(*i64, 0); }
    return &v.storage[v.first + idx];
}

fn vec_is_empty(v as *Vector) as i32 { return v.last == v.first; }

fn vec_size(v as *Vector) as i64 { return v.last - v.first; }


// ---------------------------------------------------------------------------
// Strings: a heap copy with its length.

struct Str {
    p as *u8;
    n as i64;
}

fn str_new(src as *u8, n as i64) as *Str {
    let is *Str as s = cast(*Str, alloc(sizeof(Str)));
    s.n = n;
    s.p = alloc(n + 1);
    let is i64 as i with mut = 0;
    while (i < n) { s.p[i] = src[i]; i = i + 1; }
    s.p[n] = 0;
    return s;
}

fn str_free(s as *Str) as void {
    release(s.p);
    release(cast(*u8, s));
}

fn str_eq(a as *Str, b as *Str) as i32 {
    if (a.n != b.n) { return 0; }
    let is i64 as i with mut = 0;
    while (i < a.n) {
        if (a.p[i] != b.p[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn str_eq_lit(a as *Str, lit as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (i < a.n) {
        if (lit[i] == 0 || a.p[i] != lit[i]) { return 0; }
        i = i + 1;
    }
    return lit[i] == 0;
}

// A growable byte buffer for captures that span escapes.
struct Buffer {
    p as *u8;
    n as i64;
    cap as i64;
}

fn buf_add(b as *Buffer, src as *u8, n as i64) as void {
    if (b.n + n > b.cap) {
        let is i64 as cap with mut = b.cap * 2;
        if (cap < 16) { cap = 16; }
        while (cap < b.n + n) { cap = cap * 2; }
        let is *u8 as np = alloc(cap);
        let is i64 as i with mut = 0;
        while (i < b.n) { np[i] = b.p[i]; i = i + 1; }
        if (b.cap > 0) { release(b.p); }
        b.p = np;
        b.cap = cap;
    }
    let is i64 as k with mut = 0;
    while (k < n) { b.p[b.n + k] = src[k]; k = k + 1; }
    b.n = b.n + n;
}

// ---------------------------------------------------------------------------
// JSON values.

let is i32 as KIND_OBJECT with imut = 0;
let is i32 as KIND_ARRAY with imut = 1;
let is i32 as KIND_NUMBER with imut = 2;
let is i32 as KIND_STRING with imut = 3;
let is i32 as KIND_LITERAL with imut = 4;

// Objects use names, values and table; arrays values; the rest text.
struct JsonValue {
    kind as i32;
    is_null as i32;
    is_true as i32;
    is_false as i32;
    text as *Str;
    names as Vector;
    values as Vector;
    table as [32]i32;
}

fn new_value(kind as i32) as *JsonValue {
    let is *JsonValue as v = cast(*JsonValue, alloc(sizeof(JsonValue)));
    v.kind = kind;
    v.is_null = 0;
    v.is_true = 0;
    v.is_false = 0;
    v.text = cast(*Str, 0);
    vec_init(&v.names, 0);
    vec_init(&v.values, 0);
    return v;
}

fn free_value(v as *JsonValue) as void {
    let is i64 as i with mut = 0;
    while (i < vec_size(&v.values)) {
        free_value(cast(*JsonValue, *vec_at(&v.values, i)));
        i = i + 1;
    }
    i = 0;
    while (i < vec_size(&v.names)) {
        str_free(cast(*Str, *vec_at(&v.names, i)));
        i = i + 1;
    }
    vec_dispose(&v.values);
    vec_dispose(&v.names);
    if (cast(i64, v.text) != 0) { str_free(v.text); }
    release(cast(*u8, v));
}

fn is_object(v as *JsonValue) as i32 { return v.kind == KIND_OBJECT; }
fn is_array(v as *JsonValue) as i32 { return v.kind == KIND_ARRAY; }

fn new_object() as *JsonValue {
    let is *JsonValue as v = new_value(KIND_OBJECT);
    let is i32 as i with mut = 0;
    while (i < 32) { v.table[i] = 0; i = i + 1; }
    return v;
}

fn new_literal(text as *u8, n as i64, is_null as i32, is_true as i32, is_false as i32) as *JsonValue {
    let is *JsonValue as v = new_value(KIND_LITERAL);
    v.text = str_new(text, n);
    v.is_null = is_null;
    v.is_true = is_true;
    v.is_false = is_false;
    return v;
}

fn new_text_value(kind as i32, text as *Str) as *JsonValue {
    if (kind == KIND_NUMBER && text.n == 0) { fail("value is null"); }
    let is *JsonValue as v = new_value(kind);
    v.text = text;
    return v;
}

fn array_add(a as *JsonValue, value as *JsonValue) as void {
    if (cast(i64, value) == 0) { fail("value is null"); }
    vec_append(&a.values, cast(i64, value));
}

// The name's slot in the 32-entry table: its length times 1402589, masked.
fn hash_slot_for(name as *Str) as i32 {
    return cast(i32, name.n * 1402589) & 31;
}

fn table_add(o as *JsonValue, name as *Str, index as i32) as void {
    let is i32 as slot = hash_slot_for(name);
    if (index < 255) { o.table[slot] = (index + 1) & 255; } else { o.table[slot] = 0; }
}

fn table_get(o as *JsonValue, name as *Str) as i32 {
    let is i32 as slot = hash_slot_for(name);
    return (o.table[slot] & 255) - 1;
}

fn object_add(o as *JsonValue, name as *Str, value as *JsonValue) as void {
    if (name.n == 0) { fail("name is null"); }
    if (cast(i64, value) == 0) { fail("value is null"); }
    table_add(o, name, cast(i32, vec_size(&o.names)));
    vec_append(&o.names, cast(i64, name));
    vec_append(&o.values, cast(i64, value));
}

fn index_of(o as *JsonValue, name as *Str) as i32 {
    let is i32 as index = table_get(o, name);
    if (index != 0 - 1 && str_eq(name, cast(*Str, *vec_at(&o.names, cast(i64, index)))) != 0) { return index; }
    fail("not yet implemented, not relevant for the benchmark");
    return 0 - 1;
}

fn object_get(o as *JsonValue, name as *Str) as *JsonValue {
    if (name.n == 0) { fail("name is null"); }
    let is i32 as index = index_of(o, name);
    if (index == 0 - 1) { return cast(*JsonValue, 0); }
    return cast(*JsonValue, *vec_at(&o.values, cast(i64, index)));
}

// ---------------------------------------------------------------------------
// The parser. `cur` is the current character as a one-character string, or
// empty at the end of the text.

struct Parser {
    input as *u8;
    input_len as i64;
    index as i64;
    line as i32;
    column as i32;
    cur as *u8;
    cur_len as i64;
    capture_buffer as Buffer;
    capture_start as i64;
}

fn cur_is(p as *Parser, ch as char) as i32 {
    return p.cur_len == 1 && p.cur[0] == cast(u8, ch);
}

fn at_end(p as *Parser) as i32 { return p.cur_len == 0; }

fn read(p as *Parser) as void {
    if (cur_is(p, '\n') != 0) {
        p.line = p.line + 1;
        p.column = 0;
    }
    p.index = p.index + 1;
    if (p.index < p.input_len) {
        p.cur = &p.input[p.index];
        p.cur_len = 1;
    } else {
        p.cur_len = 0;
    }
}

fn expected(p as *Parser, what as *u8) as void {
    if (at_end(p) != 0) { fail("Unexpected end of input"); }
    io.write_bytes(io.STDERR, "Expected ", 9);
    fail(what);
}

fn read_char(p as *Parser, ch as char) as i32 {
    if (cur_is(p, ch) == 0) { return 0; }
    read(p);
    return 1;
}

fn is_digit(p as *Parser) as i32 {
    return cur_is(p, '0') != 0 || cur_is(p, '1') != 0 || cur_is(p, '2') != 0 || cur_is(p, '3') != 0
        || cur_is(p, '4') != 0 || cur_is(p, '5') != 0 || cur_is(p, '6') != 0 || cur_is(p, '7') != 0
        || cur_is(p, '8') != 0 || cur_is(p, '9') != 0;
}

fn is_white_space(p as *Parser) as i32 {
    return cur_is(p, ' ') != 0 || cur_is(p, '\t') != 0 || cur_is(p, '\n') != 0 || cur_is(p, '\r') != 0;
}

fn read_digit(p as *Parser) as i32 {
    if (is_digit(p) == 0) { return 0; }
    read(p);
    return 1;
}

fn skip_white_space(p as *Parser) as void {
    while (is_white_space(p) != 0) { read(p); }
}

fn read_required_char(p as *Parser, ch as char, what as *u8) as void {
    if (read_char(p, ch) == 0) { expected(p, what); }
}

fn start_capture(p as *Parser) as void { p.capture_start = p.index; }

fn capture_end(p as *Parser) as i64 {
    if (at_end(p) != 0) { return p.index; }
    return p.index - 1;
}

fn pause_capture(p as *Parser) as void {
    let is i64 as end = capture_end(p);
    buf_add(&p.capture_buffer, &p.input[p.capture_start], end - p.capture_start + 1);
    p.capture_start = 0 - 1;
}

fn end_capture(p as *Parser) as *Str {
    let is i64 as end = capture_end(p);
    let is *Str as captured with mut = cast(*Str, 0);
    if (p.capture_buffer.n == 0) {
        captured = str_new(&p.input[p.capture_start], end - p.capture_start + 1);
    } else {
        buf_add(&p.capture_buffer, &p.input[p.capture_start], end - p.capture_start + 1);
        captured = str_new(p.capture_buffer.p, p.capture_buffer.n);
        p.capture_buffer.n = 0;
    }
    p.capture_start = 0 - 1;
    return captured;
}

fn read_escape(p as *Parser) as void {
    read(p);
    let is u8 as c with mut = 0;
    if (cur_is(p, '"') != 0 || cur_is(p, '/') != 0 || cur_is(p, '\\') != 0) {
        c = p.cur[0];
    } else if (cur_is(p, 'b') != 0) {
        c = 8;
    } else if (cur_is(p, 'f') != 0) {
        c = 12;
    } else if (cur_is(p, 'n') != 0) {
        c = 10;
    } else if (cur_is(p, 'r') != 0) {
        c = 13;
    } else if (cur_is(p, 't') != 0) {
        c = 9;
    } else {
        expected(p, "valid escape sequence");
    }
    buf_add(&p.capture_buffer, &c, 1);
    read(p);
}

fn read_string_internal(p as *Parser) as *Str {
    read(p);
    start_capture(p);
    while (cur_is(p, '"') == 0) {
        if (cur_is(p, '\\') != 0) {
            pause_capture(p);
            read_escape(p);
            start_capture(p);
        } else {
            read(p);
        }
    }
    let is *Str as s = end_capture(p);
    read(p);
    return s;
}

fn read_name(p as *Parser) as *Str {
    if (cur_is(p, '"') == 0) { expected(p, "name"); }
    return read_string_internal(p);
}

fn read_fraction(p as *Parser) as i32 {
    if (read_char(p, '.') == 0) { return 0; }
    if (read_digit(p) == 0) { expected(p, "digit"); }
    while (read_digit(p) != 0) { }
    return 1;
}

fn read_exponent(p as *Parser) as i32 {
    if (read_char(p, 'e') == 0 && read_char(p, 'E') == 0) { return 0; }
    if (read_char(p, '+') == 0) { read_char(p, '-'); }
    if (read_digit(p) == 0) { expected(p, "digit"); }
    while (read_digit(p) != 0) { }
    return 1;
}

fn read_number(p as *Parser) as *JsonValue {
    start_capture(p);
    read_char(p, '-');
    let is i32 as first_is_zero = cur_is(p, '0');
    if (read_digit(p) == 0) { expected(p, "digit"); }
    if (first_is_zero == 0) {
        while (read_digit(p) != 0) { }
    }
    read_fraction(p);
    read_exponent(p);
    return new_text_value(KIND_NUMBER, end_capture(p));
}

fn read_array(p as *Parser) as *JsonValue {
    read(p);
    let is *JsonValue as array = new_value(KIND_ARRAY);
    skip_white_space(p);
    if (read_char(p, ']') != 0) { return array; }
    let is i32 as more with mut = 1;
    while (more != 0) {
        skip_white_space(p);
        array_add(array, read_value(p));
        skip_white_space(p);
        more = read_char(p, ',');
    }
    if (read_char(p, ']') == 0) { expected(p, "',' or ']'"); }
    return array;
}

fn read_object(p as *Parser) as *JsonValue {
    read(p);
    let is *JsonValue as object = new_object();
    skip_white_space(p);
    if (read_char(p, '}') != 0) { return object; }
    let is i32 as more with mut = 1;
    while (more != 0) {
        skip_white_space(p);
        let is *Str as name = read_name(p);
        skip_white_space(p);
        if (read_char(p, ':') == 0) { expected(p, "':'"); }
        skip_white_space(p);
        object_add(object, name, read_value(p));
        skip_white_space(p);
        more = read_char(p, ',');
    }
    if (read_char(p, '}') == 0) { expected(p, "',' or '}'"); }
    return object;
}

fn read_null(p as *Parser) as *JsonValue {
    read(p);
    read_required_char(p, 'u', "'u'");
    read_required_char(p, 'l', "'l'");
    read_required_char(p, 'l', "'l'");
    return new_literal("null", 4, 1, 0, 0);
}

fn read_true(p as *Parser) as *JsonValue {
    read(p);
    read_required_char(p, 'r', "'r'");
    read_required_char(p, 'u', "'u'");
    read_required_char(p, 'e', "'e'");
    return new_literal("true", 4, 0, 1, 0);
}

fn read_false(p as *Parser) as *JsonValue {
    read(p);
    read_required_char(p, 'a', "'a'");
    read_required_char(p, 'l', "'l'");
    read_required_char(p, 's', "'s'");
    read_required_char(p, 'e', "'e'");
    return new_literal("false", 5, 0, 0, 1);
}

fn read_value(p as *Parser) as *JsonValue {
    if (cur_is(p, 'n') != 0) { return read_null(p); }
    if (cur_is(p, 't') != 0) { return read_true(p); }
    if (cur_is(p, 'f') != 0) { return read_false(p); }
    if (cur_is(p, '"') != 0) { return new_text_value(KIND_STRING, read_string_internal(p)); }
    if (cur_is(p, '[') != 0) { return read_array(p); }
    if (cur_is(p, '{') != 0) { return read_object(p); }
    if (cur_is(p, '-') != 0 || cur_is(p, '0') != 0 || cur_is(p, '1') != 0 || cur_is(p, '2') != 0
        || cur_is(p, '3') != 0 || cur_is(p, '4') != 0 || cur_is(p, '5') != 0 || cur_is(p, '6') != 0
        || cur_is(p, '7') != 0 || cur_is(p, '8') != 0 || cur_is(p, '9') != 0) {
        return read_number(p);
    }
    expected(p, "value");
    return cast(*JsonValue, 0);
}

fn parse(text as *Buffer) as *JsonValue {
    let is Parser as p;
    p.input = text.p;
    p.input_len = text.n;
    p.index = 0 - 1;
    p.line = 1;
    p.column = 0;
    p.cur = text.p;
    p.cur_len = 0;
    p.capture_buffer.p = cast(*u8, 0);
    p.capture_buffer.n = 0;
    p.capture_buffer.cap = 0;
    p.capture_start = 0 - 1;
    read(&p);
    skip_white_space(&p);
    let is *JsonValue as result = read_value(&p);
    skip_white_space(&p);
    if (at_end(&p) == 0) { fail("Unexpected character"); }
    if (p.capture_buffer.cap > 0) { release(p.capture_buffer.p); }
    return result;
}

// ---------------------------------------------------------------------------

fn has_expected_content(result as *JsonValue) as i32 {
    if (is_object(result) == 0) { return 0; }
    let is *Str as head = str_new("head", 4);
    let is *Str as operations = str_new("operations", 10);
    let is i32 as ok with mut = 1;
    if (is_object(object_get(result, head)) == 0) { ok = 0; }
    else if (is_array(object_get(result, operations)) == 0) { ok = 0; }
    else if (vec_size(&object_get(result, operations).values) != 156) { ok = 0; }
    str_free(head);
    str_free(operations);
    return ok;
}

fn put(t as *Buffer, s as *u8) as void { buf_add(t, s, io.strlen(s)); }

fn document(t as *Buffer) as void {
    put(t, "{\"head\":{\"requestCounter\":4},\"operations\":[[\"destroy\",\"w54\"],[\"set\",\"w2\",{\"activeControl");
    put(t, "\":\"w99\"}],[\"set\",\"w21\",{\"customVariant\":\"variant_navigation\"}],[\"set\",\"w28\",{\"customVari");
    put(t, "ant\":\"variant_selected\"}],[\"set\",\"w53\",{\"children\":[\"w95\"]}],[\"create\",\"w95\",\"rwt.widget");
    put(t, "s.Composite\",{\"parent\":\"w53\",\"style\":[\"NONE\"],\"bounds\":[0,0,1008,586],\"children\":[\"w96\",");
    put(t, "\"w97\"],\"tabIndex\":-1,\"clientArea\":[0,0,1008,586]}],[\"create\",\"w96\",\"rwt.widgets.Label\",{");
    put(t, "\"parent\":\"w95\",\"style\":[\"NONE\"],\"bounds\":[10,30,112,26],\"tabIndex\":-1,\"customVariant\":\"v");
    put(t, "ariant_pageHeadline\",\"text\":\"TableViewer\"}],[\"create\",\"w97\",\"rwt.widgets.Composite\",{\"pa");
    put(t, "rent\":\"w95\",\"style\":[\"NONE\"],\"bounds\":[0,61,1008,525],\"children\":[\"w98\",\"w99\",\"w226\",\"w2");
    put(t, "28\"],\"tabIndex\":-1,\"clientArea\":[0,0,1008,525]}],[\"create\",\"w98\",\"rwt.widgets.Text\",{\"pa");
    put(t, "rent\":\"w97\",\"style\":[\"LEFT\",\"SINGLE\",\"BORDER\"],\"bounds\":[10,10,988,32],\"tabIndex\":22,\"ac");
    put(t, "tiveKeys\":[\"#13\",\"#27\",\"#40\"]}],[\"listen\",\"w98\",{\"KeyDown\":true,\"Modify\":true}],[\"create");
    put(t, "\",\"w99\",\"rwt.widgets.Grid\",{\"parent\":\"w97\",\"style\":[\"SINGLE\",\"BORDER\"],\"appearance\":\"tab");
    put(t, "le\",\"indentionWidth\":0,\"treeColumn\":-1,\"markupEnabled\":false}],[\"create\",\"w100\",\"rwt.wid");
    put(t, "gets.ScrollBar\",{\"parent\":\"w99\",\"style\":[\"HORIZONTAL\"]}],[\"create\",\"w101\",\"rwt.widgets.S");
    put(t, "crollBar\",{\"parent\":\"w99\",\"style\":[\"VERTICAL\"]}],[\"set\",\"w99\",{\"bounds\":[10,52,988,402],");
    put(t, "\"children\":[],\"tabIndex\":23,\"activeKeys\":[\"CTRL+#70\",\"CTRL+#78\",\"CTRL+#82\",\"CTRL+#89\",\"C");
    put(t, "TRL+#83\",\"CTRL+#71\",\"CTRL+#69\"],\"cancelKeys\":[\"CTRL+#70\",\"CTRL+#78\",\"CTRL+#82\",\"CTRL+#89");
    put(t, "\",\"CTRL+#83\",\"CTRL+#71\",\"CTRL+#69\"]}],[\"listen\",\"w99\",{\"MouseDown\":true,\"MouseUp\":true,\"");
    put(t, "MouseDoubleClick\":true,\"KeyDown\":true}],[\"set\",\"w99\",{\"itemCount\":118,\"itemHeight\":28,\"i");
    put(t, "temMetrics\":[[0,0,50,3,0,3,44],[1,50,50,53,0,53,44],[2,100,140,103,0,103,134],[3,240,180");
    put(t, ",243,0,243,174],[4,420,50,423,0,423,44],[5,470,50,473,0,473,44]],\"columnCount\":6,\"header");
    put(t, "Height\":35,\"headerVisible\":true,\"linesVisible\":true,\"focusItem\":\"w108\",\"selection\":[\"w10");
