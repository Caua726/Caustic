// The Takeuchi function on lists: tail(x, y, z) recurses three ways while y
// is shorter than x, comparing lengths by walking both lists. Lists of 15, 10
// and 6 heap-allocated elements are built, the result's length is taken, and
// the lists are freed. The run is 10 rounds of 1500 such calls.
// Self-check: every result has length 10.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is i32 as ROUNDS with imut = 10;
let is i32 as INNER with imut = 1500;

struct Element {
    val as i64;
    next as *Element;
}

let is mem.bins.Bins as heap with mut;

fn make_list(length as i32) as *Element {
    if (length == 0) { return cast(*Element, 0); }
    let is *Element as e = cast(*Element, mem.bins.bins_alloc(&heap, sizeof(Element)));
    e.val = cast(i64, length);
    e.next = cast(*Element, 0);
    e.next = make_list(length - 1);
    return e;
}

// Frees e and, as its owner, everything after it.
fn free_list(e as *Element) as void {
    if (cast(i64, e.next) != 0) { free_list(e.next); }
    mem.bins.bins_free(&heap, cast(*u8, e));
}

fn length(e as *Element) as i32 {
    if (cast(i64, e.next) == 0) { return 1; }
    return 1 + length(e.next);
}

fn is_shorter_than(x as *Element, y as *Element) as i32 {
    let is *Element as x_tail with mut = x;
    let is *Element as y_tail with mut = y;
    while (cast(i64, y_tail) != 0) {
        if (cast(i64, x_tail) == 0) { return 1; }
        x_tail = x_tail.next;
        y_tail = y_tail.next;
    }
    return 0;
}

fn tail(x as *Element, y as *Element, z as *Element) as *Element {
    if (is_shorter_than(y, x) != 0) {
        return tail(tail(x.next, y, z), tail(y.next, z, x), tail(z.next, x, y));
    }
    return z;
}

fn benchmark() as i32 {
    let is *Element as x = make_list(15);
    let is *Element as y = make_list(10);
    let is *Element as z = make_list(6);
    let is i32 as l = length(tail(x, y, z));
    free_list(x);
    free_list(y);
    free_list(z);
    return l;
}

fn main() as i32 {
    let is i32 as result with mut = 0;
    let is i32 as r with mut = 0;
    while (r < ROUNDS) {
        let is i32 as k with mut = 0;
        while (k < INNER) {
            result = benchmark();
            if (result != 10) {
                io.printf("list_tail: wrong result %d\n", result);
                return 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    io.printf("list_tail: length %d\n", result);
    return 0;
}
