// 100 balls with random positions and velocities bounce inside a 500x500
// box for 50 steps; the count of wall hits is the result. The run is 10
// rounds of 1500 such simulations, each from a fresh 16-bit generator.
// Self-check: every simulation counts 1331 bounces.
use "../../std/io.cst" as io;

let is i32 as ROUNDS with imut = 10;
let is i32 as INNER with imut = 1500;
let is i32 as BALLS with imut = 100;

struct Ball {
    x as i32;
    y as i32;
    x_vel as i32;
    y_vel as i32;
}

fn next_random(seed as *i32) as i32 {
    seed[0] = (seed[0] * 1309 + 13849) & 65535;
    return seed[0];
}

fn abs32(v as i32) as i32 {
    if (v < 0) { return 0 - v; }
    return v;
}

fn ball_init(b as *Ball, seed as *i32) as void {
    b.x = next_random(seed) % 500;
    b.y = next_random(seed) % 500;
    b.x_vel = next_random(seed) % 300 - 150;
    b.y_vel = next_random(seed) % 300 - 150;
}

// Moves the ball one step; 1 when it hit a wall.
fn ball_bounce(b as *Ball) as i32 {
    let is i32 as x_limit = 500;
    let is i32 as y_limit = 500;
    let is i32 as bounced with mut = 0;
    b.x = b.x + b.x_vel;
    b.y = b.y + b.y_vel;
    if (b.x > x_limit) { b.x = x_limit; b.x_vel = 0 - abs32(b.x_vel); bounced = 1; }
    if (b.x < 0) { b.x = 0; b.x_vel = abs32(b.x_vel); bounced = 1; }
    if (b.y > y_limit) { b.y = y_limit; b.y_vel = 0 - abs32(b.y_vel); bounced = 1; }
    if (b.y < 0) { b.y = 0; b.y_vel = abs32(b.y_vel); bounced = 1; }
    return bounced;
}

fn simulate() as i32 {
    let is i32 as seed with mut = 74755;
    let is [100]Ball as balls;
    let is i32 as bounces with mut = 0;
    let is i32 as i with mut = 0;
    while (i < BALLS) { ball_init(&balls[i], &seed); i = i + 1; }
    let is i32 as j with mut = 0;
    while (j < 50) {
        i = 0;
        while (i < BALLS) {
            if (ball_bounce(&balls[i]) != 0) { bounces = bounces + 1; }
            i = i + 1;
        }
        j = j + 1;
    }
    return bounces;
}

fn main() as i32 {
    let is i32 as result with mut = 0;
    let is i32 as r with mut = 0;
    while (r < ROUNDS) {
        let is i32 as k with mut = 0;
        while (k < INNER) {
            result = simulate();
            if (result != 1331) {
                io.printf("bounce_balls: wrong result %d\n", result);
                return 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    io.printf("bounce_balls: %d bounces\n", result);
    return 0;
}
