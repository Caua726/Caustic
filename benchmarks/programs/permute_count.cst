// Generates every permutation of a 6-element heap array by recursive swaps,
// counting the calls. The run is 10 rounds of 1000 such counts.
// Self-check: every count is 8660.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is i32 as ROUNDS with imut = 10;
let is i32 as INNER with imut = 1000;

let is mem.bins.Bins as heap with mut;
let is i32 as count with mut = 0;
let is *i32 as v with mut;

fn swap(i as i32, j as i32) as void {
    let is i32 as tmp = v[i];
    v[i] = v[j];
    v[j] = tmp;
}

fn permute(n as i32) as void {
    count = count + 1;
    if (n != 0) {
        let is i32 as n1 = n - 1;
        permute(n1);
        let is i32 as i with mut = n1;
        while (i >= 0) {
            swap(n1, i);
            permute(n1);
            swap(n1, i);
            i = i - 1;
        }
    }
}

fn benchmark() as i32 {
    count = 0;
    v = cast(*i32, mem.bins.bins_alloc(&heap, 6 * 4));
    mem.memset(cast(*u8, v), 0, 6 * 4);
    permute(6);
    mem.bins.bins_free(&heap, cast(*u8, v));
    return count;
}

fn main() as i32 {
    let is i32 as result with mut = 0;
    let is i32 as r with mut = 0;
    while (r < ROUNDS) {
        let is i32 as k with mut = 0;
        while (k < INNER) {
            result = benchmark();
            if (result != 8660) {
                io.printf("permute_count: wrong result %d\n", result);
                return 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    io.printf("permute_count: %d calls\n", result);
    return 0;
}
