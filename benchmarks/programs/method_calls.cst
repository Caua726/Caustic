// Objects that carry their methods as function pointers: a toggle whose
// state flips on every activate(), and a subtype that overrides activate()
// to flip only every third call. Each is driven 500 million times through
// activate(...)->value(...).
// Self-check: both final states follow from the call counts.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

// The common prefix: a Toggle pointer can address either object.
struct Toggle {
    state as u8;
    value as *u8;      // fn(*Toggle) as u8
    activate as *u8;   // fn(*Toggle) as *Toggle
}

struct NthToggle {
    state as u8;
    value as *u8;
    activate as *u8;
    count_max as i32;
    counter as i32;
}

let is mem.bins.Bins as heap with mut;

fn toggle_value(t as *Toggle) as u8 { return t.state; }

fn toggle_activate(t as *Toggle) as *Toggle {
    if (t.state == 0) { t.state = 1; } else { t.state = 0; }
    return t;
}

fn init_toggle(t as *Toggle, start as u8) as *Toggle {
    t.state = start;
    t.value = fn_ptr(toggle_value);
    t.activate = fn_ptr(toggle_activate);
    return t;
}

fn new_toggle(start as u8) as *Toggle {
    return init_toggle(cast(*Toggle, mem.bins.bins_alloc(&heap, sizeof(Toggle))), start);
}

fn nth_toggle_activate(t as *NthToggle) as *NthToggle {
    t.counter = t.counter + 1;
    if (t.counter >= t.count_max) {
        if (t.state == 0) { t.state = 1; } else { t.state = 0; }
        t.counter = 0;
    }
    return t;
}

fn new_nth_toggle(start as u8, max_count as i32) as *NthToggle {
    let is *NthToggle as t = cast(*NthToggle, init_toggle(cast(*Toggle, mem.bins.bins_alloc(&heap, sizeof(NthToggle))), start));
    t.count_max = max_count;
    t.counter = 0;
    t.activate = fn_ptr(nth_toggle_activate);
    return t;
}

fn say(v as u8) as void {
    if (v != 0) { io.write_bytes(io.STDOUT, "true\n\n", 6); }
    else { io.write_bytes(io.STDOUT, "false\n\n", 7); }
}

fn main() as i32 {
    let is i32 as n = 500000000;
    let is *Toggle as tog = new_toggle(1);
    let is u8 as val with mut = 1;
    let is i32 as i with mut = 0;
    while (i < n) {
        let is *Toggle as t = cast(*Toggle, call(tog.activate, tog));
        val = cast(u8, call(t.value, tog));
        i = i + 1;
    }
    say(val);
    let is u8 as val1 = val;
    mem.bins.bins_free(&heap, cast(*u8, tog));

    val = 1;
    let is *NthToggle as ntog = new_nth_toggle(val, 3);
    i = 0;
    while (i < n) {
        let is *NthToggle as t = cast(*NthToggle, call(ntog.activate, ntog));
        val = cast(u8, call(t.value, ntog));
        i = i + 1;
    }
    say(val);
    mem.bins.bins_free(&heap, cast(*u8, ntog));

    // Started true: one flip per call, then one per three calls.
    let is u8 as want1 = cast(u8, (n + 1) % 2);
    let is u8 as want2 = cast(u8, (n / 3 + 1) % 2);
    if (val1 != want1 || val != want2) { return 1; }
    return 0;
}
