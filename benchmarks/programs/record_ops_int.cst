// Record and string manipulation in the classic synthetic integer style, 100
// million rounds of: two status procedures, a string copy and compare of two
// 30-character strings, a short arithmetic loop through an out-parameter, a
// write into a 51-element and a 51x51 array, field updates through a pointer
// to a heap record, a character loop over an enumeration, a multiply, a
// divide and a call that decrements through a pointer. Prints nothing.
// Self-check: the globals, the arrays and the loop locals end with the values
// the rounds must leave (the counter in the 2-D array ends at rounds + 10).
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is i32 as LOOPS with imut = 100000000;

// The enumeration.
let is i32 as IDENT1 with imut = 0;
let is i32 as IDENT2 with imut = 10000;
let is i32 as IDENT3 with imut = 10001;
let is i32 as IDENT4 with imut = 10002;
let is i32 as IDENT5 with imut = 10003;

struct Record {
    ptr_comp as *Record;
    discr as i32;
    enum_comp as i32;
    int_comp as i32;
    string_comp as [31]u8;
}

let is mem.bins.Bins as heap with mut;
let is i32 as int_glob with mut = 0;
let is i32 as bool_glob with mut = 0;
let is u8 as char1_glob with mut = 0;
let is u8 as char2_glob with mut = 0;
let is [51]i32 as array1_glob with mut;
let is [2601]i32 as array2_glob with mut;    // 51 x 51
let is *Record as ptr_glb with mut;
let is *Record as ptr_glb_next with mut;

fn str_copy(dst as *u8, src as *u8) as void {
    let is i64 as i with mut = 0;
    while (src[i] != 0) { dst[i] = src[i]; i = i + 1; }
    dst[i] = 0;
}

fn str_cmp(a as *u8, b as *u8) as i32 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && a[i] == b[i]) { i = i + 1; }
    return cast(i32, a[i]) - cast(i32, b[i]);
}

fn proc1(p as *Record) as void {
    let is *Record as next = p.ptr_comp;
    p.int_comp = 5;
    next.int_comp = p.int_comp;
    next.ptr_comp = p.ptr_comp;
}

fn proc2(io_par as *i32) as void {
    let is i32 as loc with mut = io_par[0] + 10;
    let is i32 as e with mut = IDENT2;
    while (1 == 1) {
        if (char1_glob == 65) {
            loc = loc - 1;
            io_par[0] = loc - int_glob;
            e = IDENT1;
        }
        if (e == IDENT1) { return; }
    }
}

fn proc3(out as **Record) as void {
    if (cast(i64, ptr_glb) != 0) { out[0] = ptr_glb.ptr_comp; }
    else { int_glob = 100; }
    proc7(10, int_glob, &ptr_glb.int_comp);
}

fn proc4() as void {
    let is i32 as b with mut = 0;
    if (char1_glob == 65) { b = 1; }
    b = b | bool_glob;
    char2_glob = 66;
}

fn proc5() as void {
    char1_glob = 65;
    bool_glob = 0;
}

fn func3(e as i32) as i32 {
    if (e == IDENT3) { return 1; }
    return 0;
}

fn proc6(e_in as i32, e_out as *i32) as void {
    e_out[0] = e_in;
    if (func3(e_in) == 0) { e_out[0] = IDENT4; }
    if (e_in == IDENT1) { e_out[0] = IDENT1; }
    else if (e_in == IDENT2) {
        if (int_glob > 100) { e_out[0] = IDENT1; } else { e_out[0] = IDENT4; }
    }
    else if (e_in == IDENT3) { e_out[0] = IDENT2; }
    else if (e_in == IDENT5) { e_out[0] = IDENT3; }
}

fn proc7(a as i32, b as i32, out as *i32) as void {
    let is i32 as loc = a + 2;
    out[0] = b + loc;
}

fn proc8(a1 as *i32, a2 as *i32, i1 as i32, i2 as i32) as void {
    let is i32 as loc = i1 + 5;
    let is i32 as k = loc;
    a1[k] = i2;
    a1[k + 1] = a1[k];
    a1[k + 30] = loc;
    let is i32 as idx with mut = loc;
    while (idx <= loc + 1) {
        a2[k * 51 + idx] = loc;
        idx = idx + 1;
    }
    a2[k * 51 + k - 1] = a2[k * 51 + k - 1] + 1;
    a2[(k + 20) * 51 + k] = a1[k];
    int_glob = 5;
}

fn func1(c1 as u8, c2 as u8) as i32 {
    let is u8 as l1 = c1;
    let is u8 as l2 = l1;
    if (l2 != c2) { return IDENT1; }
    return IDENT2;
}

fn func2(s1 as *u8, s2 as *u8) as i32 {
    let is i32 as loc with mut = 1;
    let is u8 as c with mut = 0;
    while (loc <= 1) {
        if (func1(s1[loc], s2[loc + 1]) == IDENT1) {
            c = 65;
            loc = loc + 1;
        }
    }
    if (c >= 87 && c <= 90) { loc = 7; }
    if (c == 88) { return 1; }
    if (str_cmp(s1, s2) > 0) {
        loc = loc + 7;
        return 1;
    }
    return 0;
}

fn main() as i32 {
    let is [31]u8 as string1;
    let is [31]u8 as string2;
    let is *u8 as s1 = cast(*u8, &string1);
    let is *u8 as s2 = cast(*u8, &string2);

    ptr_glb_next = cast(*Record, mem.bins.bins_alloc(&heap, sizeof(Record)));
    ptr_glb = cast(*Record, mem.bins.bins_alloc(&heap, sizeof(Record)));
    ptr_glb.ptr_comp = ptr_glb_next;
    ptr_glb.discr = IDENT1;
    ptr_glb.enum_comp = IDENT3;
    ptr_glb.int_comp = 40;
    str_copy(cast(*u8, &ptr_glb.string_comp), "RECORDOPS PROGRAM, SOME STRING");
    str_copy(s1, "RECORDOPS PROGRAM, 1'ST STRING");
    array2_glob[8 * 51 + 7] = 10;

    let is i32 as loc1 with mut = 0;
    let is i32 as loc2 with mut = 0;
    let is i32 as loc3 with mut = 0;
    let is i32 as e with mut = 0;
    let is i32 as i with mut = 0;
    while (i < LOOPS) {
        proc5();
        proc4();
        loc1 = 2;
        loc2 = 3;
        str_copy(s2, "RECORDOPS PROGRAM, 2'ND STRING");
        e = IDENT2;
        if (func2(s1, s2) == 0) { bool_glob = 1; } else { bool_glob = 0; }
        while (loc1 < loc2) {
            loc3 = 5 * loc1 - loc2;
            proc7(loc1, loc2, &loc3);
            loc1 = loc1 + 1;
        }
        proc8(cast(*i32, &array1_glob), cast(*i32, &array2_glob), loc1, loc3);
        proc1(ptr_glb);
        let is u8 as ci with mut = 65;
        while (ci <= char2_glob) {
            if (e == func1(ci, 67)) { proc6(IDENT1, &e); }
            ci = ci + 1;
        }
        loc3 = loc2 * loc1;
        loc2 = loc3 / loc1;
        loc2 = 7 * (loc3 - loc2) - loc1;
        proc2(&loc1);
        i = i + 1;
    }

    let is i32 as bad with mut = 0;
    if (int_glob != 5 || bool_glob != 1 || char1_glob != 65 || char2_glob != 66) { bad = 1; }
    if (array1_glob[8] != 7 || array1_glob[9] != 7 || array1_glob[38] != 8) { bad = 1; }
    if (array2_glob[8 * 51 + 7] != 100000010 || array2_glob[8 * 51 + 8] != 8 || array2_glob[28 * 51 + 8] != 7) { bad = 1; }
    if (ptr_glb.int_comp != 5 || ptr_glb_next.int_comp != 5 || e != IDENT2) { bad = 1; }
    if (loc1 != 7 || loc2 != 39 || loc3 != 9) { bad = 1; }
    return bad;
}
