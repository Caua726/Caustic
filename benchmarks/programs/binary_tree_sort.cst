// Binary search tree of 5000 integers from a 16-bit linear congruential
// generator (seed 74755, x = (1309x + 13849) mod 65536, shifted down by
// 50000): recursive insertion of freshly allocated nodes (larger keys to the
// left, duplicates dropped), then a recursive check of the ordering. Each of
// 100 rounds builds a new tree (the old ones are never freed, as in a
// throwaway sort) and prints one input value.
// Self-check: every tree passes the ordering check, and the 100 lines hash to
// the expected value.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is i32 as COUNT with imut = 5000;
let is i64 as OCAP with imut = 4096;

struct Node {
    left as *Node;
    right as *Node;
    val as i32;
}

let is mem.bins.Bins as heap with mut;
let is [5001]i32 as list with mut;     // 1-based
let is i64 as seed with mut = 0;
let is i32 as bad with mut = 0;

let is [4096]u8 as obuf with mut;
let is i64 as olen with mut = 0;

fn ocur() as *u8 { return cast(*u8, cast(i64, &obuf) + olen); }

// Writes what was collected; 1 unless it hashes (FNV-1a) to `want`.
fn flush_check(want as u64) as i32 {
    let is *u8 as b = cast(*u8, &obuf);
    io.write_bytes(io.STDOUT, b, olen);
    let is u64 as h with mut = 14695981039346656037;
    let is i64 as k with mut = 0;
    while (k < olen) { h = (h ^ cast(u64, b[k])) * 1099511628211; k = k + 1; }
    if (h != want) { return 1; }
    return 0;
}

fn next_rand() as i32 {
    seed = (seed * 1309 + 13849) & 65535;
    return cast(i32, seed);
}

fn fill() as void {
    seed = 74755;
    let is i32 as i with mut = 1;
    while (i <= COUNT) {
        let is i64 as t = cast(i64, next_rand());
        list[i] = cast(i32, t % 100000 - 50000);
        i = i + 1;
    }
}

fn new_node(v as i32) as *Node {
    let is *Node as n = cast(*Node, mem.bins.bins_alloc(&heap, sizeof(Node)));
    n.left = cast(*Node, 0);
    n.right = cast(*Node, 0);
    n.val = v;
    return n;
}

fn insert(v as i32, t as *Node) as void {
    if (v > t.val) {
        if (cast(i64, t.left) == 0) { t.left = new_node(v); }
        else { insert(v, t.left); }
    } else if (v < t.val) {
        if (cast(i64, t.right) == 0) { t.right = new_node(v); }
        else { insert(v, t.right); }
    }
}

// 1 when every left child is larger and every right child smaller, all the
// way down.
fn ordered(p as *Node) as i32 {
    let is i32 as ok with mut = 1;
    if (cast(i64, p.left) != 0) {
        if (p.left.val <= p.val) { ok = 0; }
        else { ok = ordered(p.left) & ok; }
    }
    if (cast(i64, p.right) != 0) {
        if (p.right.val >= p.val) { ok = 0; }
        else { ok = ordered(p.right) & ok; }
    }
    return ok;
}

fn round(run as i32) as void {
    fill();
    let is *Node as root = new_node(list[1]);
    let is i32 as i with mut = 2;
    while (i <= COUNT) { insert(list[i], root); i = i + 1; }
    olen = olen + io.sprintf(ocur(), OCAP - olen, "%d\n", list[2 + run]);
    if (ordered(root) == 0) {
        bad = 1;
        olen = olen + io.sprintf(ocur(), OCAP - olen, " Error in Tree.\n");
    }
}

fn main() as i32 {
    let is i32 as r with mut = 0;
    while (r < 100) { round(r); r = r + 1; }
    return bad | flush_check(7691030079539255633);
}
