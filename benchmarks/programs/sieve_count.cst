// Sieve of Eratosthenes over 1..5000 in a fresh array of byte flags on the
// stack, counting primes. The run is 10 rounds of 3000 sieves.
// Self-check: every count is 669.
use "../../std/io.cst" as io;

let is i32 as ROUNDS with imut = 10;
let is i32 as INNER with imut = 3000;
let is i32 as NUM_FLAGS with imut = 5000;

fn sieve(flags as *u8, size as i32) as i32 {
    let is i32 as prime_count with mut = 0;
    let is i32 as i with mut = 2;
    while (i <= size) {
        if (flags[i - 1] != 0) {
            prime_count = prime_count + 1;
            let is i32 as k with mut = i + i;
            while (k <= size) {
                flags[k - 1] = 0;
                k = k + i;
            }
        }
        i = i + 1;
    }
    return prime_count;
}

fn benchmark() as i32 {
    let is [5000]u8 as flags;
    let is i32 as i with mut = 0;
    while (i < NUM_FLAGS) { flags[i] = 1; i = i + 1; }
    return sieve(&flags[0], 5000);
}

fn main() as i32 {
    let is i32 as result with mut = 0;
    let is i32 as r with mut = 0;
    while (r < ROUNDS) {
        let is i32 as k with mut = 0;
        while (k < INNER) {
            result = benchmark();
            if (result != 669) {
                io.printf("sieve_count: wrong result %d\n", result);
                return 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    io.printf("sieve_count: %d primes\n", result);
    return 0;
}
