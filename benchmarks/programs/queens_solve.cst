// First solution of the eight queens problem by backtracking over columns,
// with heap-allocated free flags for rows and both diagonals, found 10 times
// per benchmark call. The run is 10 rounds of 1000 calls.
// Self-check: every search finds a solution.
use "../../std/io.cst" as io;
use "../../std/mem.cst" as mem;

let is i32 as ROUNDS with imut = 10;
let is i32 as INNER with imut = 1000;

let is mem.bins.Bins as heap with mut;
let is *u8 as free_maxs with mut;
let is *u8 as free_rows with mut;
let is *u8 as free_mins with mut;
let is *i32 as queen_rows with mut;

fn get_row_column(r as i32, c as i32) as i32 {
    if (free_rows[r] != 0 && free_maxs[c + r] != 0 && free_mins[c - r + 7] != 0) { return 1; }
    return 0;
}

fn set_row_column(r as i32, c as i32, v as u8) as void {
    free_rows[r] = v;
    free_maxs[c + r] = v;
    free_mins[c - r + 7] = v;
}

fn place_queen(c as i32) as i32 {
    let is i32 as r with mut = 0;
    while (r < 8) {
        if (get_row_column(r, c) != 0) {
            queen_rows[r] = c;
            set_row_column(r, c, 0);
            if (c == 7) { return 1; }
            if (place_queen(c + 1) != 0) { return 1; }
            set_row_column(r, c, 1);
        }
        r = r + 1;
    }
    return 0;
}

fn queens() as i32 {
    free_rows = mem.bins.bins_alloc(&heap, 8);
    mem.memset(free_rows, 1, 8);
    free_maxs = mem.bins.bins_alloc(&heap, 16);
    mem.memset(free_maxs, 1, 16);
    free_mins = mem.bins.bins_alloc(&heap, 16);
    mem.memset(free_mins, 1, 16);
    queen_rows = cast(*i32, mem.bins.bins_alloc(&heap, 8 * 4));
    let is i32 as i with mut = 0;
    while (i < 8) { queen_rows[i] = 0 - 1; i = i + 1; }

    let is i32 as result = place_queen(0);

    mem.bins.bins_free(&heap, free_rows);
    mem.bins.bins_free(&heap, free_maxs);
    mem.bins.bins_free(&heap, free_mins);
    mem.bins.bins_free(&heap, cast(*u8, queen_rows));
    return result;
}

fn benchmark() as i32 {
    let is i32 as result with mut = 1;
    let is i32 as i with mut = 0;
    while (i < 10) {
        result = result != 0 && queens() != 0;
        i = i + 1;
    }
    return result;
}

fn main() as i32 {
    let is i32 as r with mut = 0;
    while (r < ROUNDS) {
        let is i32 as k with mut = 0;
        while (k < INNER) {
            if (benchmark() == 0) {
                io.printf("queens_solve: no solution\n");
                return 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    io.printf("queens_solve: solved\n");
    return 0;
}
