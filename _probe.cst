use "std/io.cst" as io;
struct V3 { x as f64; y as f64; z as f64; }
struct M4 { m as [16]f64; }
fn v3(x as f64, y as f64, z as f64) as V3 {
    let is V3 as r; r.x = x; r.y = y; r.z = z; return r;
}
fn v3_add(a as V3, b as V3) as V3 { return v3(a.x+b.x, a.y+b.y, a.z+b.z); }
fn m4_id() as M4 {
    let is M4 as r;
    let is i32 as i with mut = 0;
    while (i < 16) { r.m[i] = 0.0; i = i + 1; }
    r.m[0] = 1.0; r.m[5] = 1.0; r.m[10] = 1.0; r.m[15] = 1.0;
    return r;
}
fn main() as i32 {
    let is V3 as a = v3(1.0, 2.0, 3.0);
    let is V3 as b = v3(10.0, 20.0, 30.0);
    let is V3 as c = v3_add(a, b);
    io.printf("v3 soma: %d %d %d (esperado 11 22 33)\n", cast(i64,c.x), cast(i64,c.y), cast(i64,c.z));
    let is M4 as m = m4_id();
    io.printf("m4 diag: %d %d %d %d (esperado 1 1 1 1)\n",
        cast(i64,m.m[0]), cast(i64,m.m[5]), cast(i64,m.m[10]), cast(i64,m.m[15]));
    io.printf("m4 off : %d (esperado 0)\n", cast(i64,m.m[1]));
    return 0;
}
