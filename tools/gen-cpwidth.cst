// tools/gen-cpwidth.cst — writes std/unicode/cpwidth.cst.
//
// std/unicode/width.cst answers "how many columns" from the Unicode Character
// Database: General_Category for the zero-width marks and controls,
// Emoji_Presentation and East_Asian_Width for the wide ones. That takes the
// whole-of-Unicode property tables with it, and a module's tables are linked
// whether or not anything reads them — importing width.cst costs a program
// about 170 KB. A terminal needs one answer per code point and nothing else.
//
// So the answer is computed once, here, from width.cst's own cp_width_ucd, for
// every code point, and written out as the short list of ranges that are NOT
// one column wide. cpwidth.cst is that list plus a binary search: a few KB, the
// same result by construction, and tests/unicode_width_test.cst checks every
// code point against cp_width_ucd so the two cannot drift apart.
//
//   caustic tools/gen-cpwidth.cst -o build/gen-cpwidth && ./build/gen-cpwidth
//
// Run from the repository root; rerun whenever the UCD tables are regenerated.
use "../std/io.cst" as io;
use "../std/unicode/width.cst" as width;

let is i64 as MAXCP with imut = 1114111;

let is [262144]u8 as out with mut;
let is i64 as olen with mut = 0;

fn put(s as *u8) as void {
    let is i64 as i with mut = 0;
    while (s[i] != cast(u8, 0)) { out[olen] = s[i]; olen = olen + 1; i = i + 1; }
}

fn put_num(v as i64) as void {
    if (v == 0) { put("0"); return; }
    let is [24]u8 as b;
    let is i64 as x with mut = v;
    let is i64 as k with mut = 0;
    while (x > 0) { b[k] = cast(u8, 48 + x % 10); x = x / 10; k = k + 1; }
    while (k > 0) { k = k - 1; out[olen] = b[k]; olen = olen + 1; }
}

fn put_hexbyte(v as i64) as void {
    let is *u8 as hx = "0123456789abcdef";
    out[olen] = cast(u8, 92); out[olen + 1] = cast(u8, 120);           // \x
    out[olen + 2] = hx[(v >> 4) & 15]; out[olen + 3] = hx[v & 15];
    olen = olen + 4;
}

fn put_u32(v as i64) as void {
    put_hexbyte(v & 255);
    put_hexbyte((v >> 8) & 255);
    put_hexbyte((v >> 16) & 255);
    put_hexbyte((v >> 24) & 255);
}

// Ranges, collected first so the count can head the file.
let is [8192]i64 as r_start with mut;
let is [8192]i64 as r_end with mut;
let is [8192]i64 as r_w with mut;

fn main() as i32 {
    let is i64 as n with mut = 0;
    let is i64 as cp with mut = 0;
    while (cp <= MAXCP) {
        let is i64 as w = width.cp_width_ucd(cast(i32, cp));
        if (w != 1) {
            if (n > 0 && r_end[n - 1] == cp - 1 && r_w[n - 1] == w) {
                r_end[n - 1] = cp;
            } else {
                if (n >= 8192) { io.write_str(2, "gen-cpwidth: more than 8192 ranges\n"); return 1; }
                r_start[n] = cp; r_end[n] = cp; r_w[n] = w;
                n = n + 1;
            }
        }
        cp = cp + 1;
    }

    put("// GENERATED by tools/gen-cpwidth.cst from std/unicode/width.cst's\n");
    put("// cp_width_ucd. DO NOT EDIT. Regenerate from the repository root:\n");
    put("//   caustic tools/gen-cpwidth.cst -o build/gen-cpwidth && ./build/gen-cpwidth\n");
    put("//\n");
    put("// How many terminal columns a code point takes, without the property tables\n");
    put("// width.cst derives it from: the code points that are not one column wide, as\n");
    put("// sorted inclusive ranges, 8 bytes each — start (u32 LE), then end in the low\n");
    put("// 24 bits and the width (0 or 2) in the top 8. Everything else is 1.\n");
    put("// tests/unicode_width_test.cst checks every code point against cp_width_ucd.\n\n");
    put("let is i64 as N_RANGES with imut = ");
    put_num(n);
    put(";\n\nlet is *u8 as RANGES with imut = \"");
    let is i64 as i with mut = 0;
    while (i < n) {
        put_u32(r_start[i]);
        put_u32(r_end[i] | (r_w[i] << 24));
        i = i + 1;
    }
    put("\";\n\n");
    put("fn _u32(off as i64) as i64 {\n");
    put("    let is *u8 as t = RANGES;\n");
    put("    return cast(i64, t[off]) | (cast(i64, t[off + 1]) << 8)\n");
    put("         | (cast(i64, t[off + 2]) << 16) | (cast(i64, t[off + 3]) << 24);\n");
    put("}\n\n");
    put("// Columns cp takes: 0 (a combining mark, a control, a format character),\n");
    put("// 2 (East Asian Wide/Fullwidth, an emoji drawn as one), or 1.\n");
    put("fn cp_width(cp as i32) as i64 {\n");
    put("    let is i64 as c = cast(i64, cp);\n");
    put("    let is i64 as lo with mut = 0;\n");
    put("    let is i64 as hi with mut = N_RANGES - 1;\n");
    put("    while (lo <= hi) {\n");
    put("        let is i64 as mid = (lo + hi) / 2;\n");
    put("        let is i64 as s = _u32(mid * 8);\n");
    put("        let is i64 as ew = _u32(mid * 8 + 4);\n");
    put("        if (c < s) { hi = mid - 1; }\n");
    put("        else if (c > (ew & 16777215)) { lo = mid + 1; }\n");
    put("        else { return ew >> 24; }\n");
    put("    }\n");
    put("    return 1;\n");
    put("}\n");

    if (io.write_file_atomic("std/unicode/cpwidth.cst", cast(*u8, &out[0]), olen) != 0) {
        io.write_str(2, "gen-cpwidth: cannot write std/unicode/cpwidth.cst (run from the repository root)\n");
        return 1;
    }
    io.write_str(1, "gen-cpwidth: ");
    io.write_int(1, n);
    io.write_str(1, " ranges -> std/unicode/cpwidth.cst\n");
    return 0;
}
