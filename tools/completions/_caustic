#compdef caustic caustic-elf caustic.exe caustic.cse caustic.cse.exe caustic-universal.cse caustic-universal.cse.exe
# caustic — zsh completion.  Flags mirror src/main.cst:parse_args.
#
# install:  <prefix>/share/zsh/site-functions/_caustic
#     or:   ln -s .../tools/completions/_caustic  <a dir on your $fpath>
#           (the fpath entry has to precede compinit in ~/.zshrc)

# Every triple load_target (src/codegen/target.cst) accepts, canonical + aliases.
(( $+functions[_caustic_triples] )) || _caustic_triples() {
    local -a triples=(
        'linux-x86_64:static ELF, no libc — the default'
        'linux-aarch64:static ARM64 ELF'
        'windows-x86_64:PE/COFF .exe, kernel32 through the IAT'
        'windows-aarch64:ARM64 PE — refused, not implemented yet'
        'caustic:CSE container carrying x86_64 and ARM64'
        'caustic-x86_64:CSE image, x86_64'
        'caustic-aarch64:CSE image, ARM64'
        'caustic-x86_64-aarch64:CSE container, both architectures'
        'wasm32-wasi:WebAssembly module, 32-bit linear memory'
        'wasm32:alias of wasm32-wasi'
        'wasm64-wasi:WebAssembly with memory64'
        'wasm64:alias of wasm64-wasi'
    )
    _describe -t triples 'target triple' triples
}

# -l<name> resolves to lib<name>.so; offer what is installed next to the binary.
(( $+functions[_caustic_libs] )) || _caustic_libs() {
    local -a libs=(caustic)
    local self=${words[1]}
    local d f
    [[ $self == */* ]] || self=${commands[$self]:-}
    for d in ${self:+${self:h}/../lib/caustic} ~/.local/lib/caustic \
             /usr/local/lib/caustic /usr/lib/caustic; do
        [[ -d $d ]] || continue
        for f in $d/lib*.so(N); do
            f=${${f:t}#lib}; libs+=( ${f%.so} )
        done
    done
    _wanted libraries expl 'library' compadd -a libs
}

# The name -o almost always wants: the input's basename carrying the extension
# this target produces. A CSE build appends .cse / .cse.exe itself, so there the
# bare name is already right.
(( $+functions[_caustic_output] )) || _caustic_output() {
    local -a srcs
    local base triple sfx=""
    srcs=( ${(M)words:#*.cst} )
    if (( $#srcs )); then
        base=${srcs[1]:t:r}
        triple=${${${(M)words:#--target=*}[1]}#--target=}
        if (( ${words[(I)--shared]} )); then
            case $triple in
                windows-*) base="lib$base"; sfx=".dll" ;;
                caustic*)  base="lib$base"; sfx=".csl" ;;
                wasm*)     sfx=".wasm" ;;
                *)         base="lib$base"; sfx=".so" ;;
            esac
        else
            case $triple in
                windows-*) sfx=".exe" ;;
                wasm*)     sfx=".wasm" ;;
            esac
        fi
        _wanted output expl 'output file' compadd -- "$base$sfx"
    fi
    _files
}

_caustic() {
    _arguments -S \
        '(- *)--version[print the version and exit]' \
        '(- *)--help[print usage and exit]' \
        '-c[compile only, no main required — for libraries]' \
        '-o[write the executable here]:output file:_caustic_output' \
        '(-j --parallel)'{-j,--parallel}'[workers for --module-objects emission]:workers:(1 2 4 8 16 32)' \
        '--max-ram[resident memory cap in MB (0 = unlimited)]:MB:(0 256 512 1024 2048 4096 8192)' \
        '--shared[emit a shared library: .so, .dll or .csl]' \
        '--emit-interface[write the textual module interface]' \
        '--emit-csti[write the binary interface image (.csti)]' \
        '--emit-tokens[cache the lexer tokens]' \
        '--emit-ast[cache the AST]' \
        '--emit-ir[cache the IR]' \
        '--profile[report per-phase timing]' \
        '--cache[cache directory for incremental builds]:directory:_files -/' \
        '--module-objects[batch separate compilation, one .o per module]:directory:_files -/' \
        '--module-only[emit only this module'"'"'s own functions]' \
        '--emit-deps[write the resolved module path list, then stop]:file:_files' \
        '--csti-dir[directory of .csti interface images]:directory:_files -/' \
        '(-O0 -O1 -O2)-O0[no optimization]' \
        '(-O0 -O1 -O2)-O1[the fast tier — what the bootstrap uses]' \
        '(-O0 -O1 -O2)-O2[release tier: global passes + SIMD vectorization]' \
        '*--path[extra module search path]:directory:_files -/' \
        '(-q --quiet)'{-q,--quiet}'[only errors]' \
        '--no-asm-cache[skip writing the .s debug cache]' \
        '-debuglexer[dump the tokens]' \
        '-debugparser[dump the AST]' \
        '-debugir[dump the IR]' \
        '--freestanding[no _start stub — kernels and bare metal]' \
        '--allow-unsupported[downgrade __compile_error to a no-op]' \
        '--target=[cross-compile for this triple]:triple:_caustic_triples' \
        '--mode=[CSE flavour]:mode:((pure\:"CausticOS only, one architecture" compat\:"both OS paths, chosen at run time" bundle\:"polyglot every loader accepts"))' \
        '--entry=[entry point symbol]:symbol:(main)' \
        '--base=[base address, hex]:address:(0x400000 0x100000)' \
        '--app-version=[version string embedded in the CSE header]:version:' \
        '--stack-size=[user stack bytes declared in the CSE header]:bytes:(65536 131072 262144 1048576 8388608)' \
        '--extension=[suffix a CSE output carries]:suffix:(exe cse)' \
        '*-l+[link a shared library]:library:_caustic_libs' \
        '*:source file:_files -g "*.cst(-.)"'
}

_caustic "$@"
