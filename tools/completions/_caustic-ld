#compdef caustic-ld caustic-ld.exe caustic-ld.cse caustic-ld.cse.exe caustic-ld-universal.cse caustic-ld-universal.cse.exe
# caustic-ld — zsh completion.  Flags mirror caustic-linker/main.cst:main.
#
# install:  <prefix>/share/zsh/site-functions/_caustic-ld
#     or:   ln -s .../tools/completions/_caustic-ld  <a dir on your $fpath>

(( $+functions[_caustic_triples] )) || _caustic_triples() {
    local -a triples=(
        'linux-x86_64:static ELF, no libc — the default'
        'linux-aarch64:static ARM64 ELF'
        'windows-x86_64:PE/COFF .exe, kernel32 through the IAT'
        'windows-aarch64:ARM64 PE — refused, not implemented yet'
        'caustic:CSE container carrying x86_64 and ARM64'
        'caustic-x86_64:CSE image, x86_64'
        'caustic-aarch64:CSE image, ARM64'
        'caustic-x86_64-aarch64:CSE container, both architectures'
        'wasm32-wasi:WebAssembly module, 32-bit linear memory'
        'wasm32:alias of wasm32-wasi'
        'wasm64-wasi:WebAssembly with memory64'
        'wasm64:alias of wasm64-wasi'
    )
    _describe -t triples 'target triple' triples
}

(( $+functions[_caustic_ld_libs] )) || _caustic_ld_libs() {
    local -a libs=(caustic c m)
    local self=${words[1]}
    local d f
    [[ $self == */* ]] || self=${commands[$self]:-}
    for d in ${self:+${self:h}/../lib/caustic} ~/.local/lib/caustic \
             /usr/local/lib/caustic /usr/lib/caustic; do
        [[ -d $d ]] || continue
        for f in $d/lib*.so(N); do
            f=${${f:t}#lib}; libs+=( ${f%.so} )
        done
    done
    _wanted libraries expl 'library' compadd -a libs
}

_caustic_ld() {
    _arguments -S \
        '(- *)'{-h,--help}'[print usage and exit]' \
        '-o[output file (default a.out)]:output file:_files' \
        '--entry=[entry point symbol (default main)]:symbol:(main)' \
        '--base=[base address, hex (default 0x400000)]:address:(0x400000 0x100000)' \
        '--target=[link for this triple]:triple:_caustic_triples' \
        '--mode=[CSE flavour]:mode:((pure\:"CausticOS only, one architecture" compat\:"both OS paths, chosen at run time" bundle\:"polyglot every loader accepts"))' \
        '--extension=[suffix a CSE output carries]:suffix:(exe cse)' \
        '--strip[drop the symbol table]' \
        '--map[write a link map next to the output]' \
        '--keep-empty[keep empty sections]' \
        '--freestanding[no _start stub — kernels and bare metal]' \
        '--shared[emit an ET_DYN shared object]' \
        '--cse-combine[weld PE + ELF (+ CSE) into one polyglot]' \
        '--cse-fat[fuse per-architecture .cse images into one container]' \
        '*--image=[per-architecture CSE image for --cse-fat (up to 8)]:image:_files -g "*.cse*(-.)"' \
        '--pe=[Windows PE input for --cse-combine]:executable:_files -g "*.exe(-.)"' \
        '--elf=[Linux ELF input for --cse-combine]:executable:_files' \
        '--elf-arm64=[ARM64 ELF input for --cse-combine]:executable:_files' \
        '--pe-arm64=[ARM64 PE input for --cse-combine]:executable:_files -g "*.exe(-.)"' \
        '--cst=[CSE input for --cse-combine]:image:_files -g "*.cse*(-.)"' \
        '*-l+[link with a shared library]:library:_caustic_ld_libs' \
        '-v[say what is being linked]' \
        '*:object file:_files -g "*.(o|obj)(-.)"'
}

_caustic_ld "$@"
