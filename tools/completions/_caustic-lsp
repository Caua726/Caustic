#compdef caustic-lsp caustic-lsp.exe caustic-lsp.cse caustic-lsp.cse.exe caustic-lsp-universal.cse caustic-lsp-universal.cse.exe
# caustic-lsp — zsh completion.
#
# lsp/main.cst declares `fn main() as i32` — no argc, no argv. The server speaks
# JSON-RPC over stdio and is launched by an editor, not by hand, so the honest
# completion is to offer nothing at all. Returning non-zero (rather than just
# adding nothing) keeps zsh from falling back to filenames and suggesting
# arguments the binary cannot read.
#
# install:  <prefix>/share/zsh/site-functions/_caustic-lsp
#     or:   ln -s .../tools/completions/_caustic-lsp  <a dir on your $fpath>

_caustic_lsp() {
    _message -r 'caustic-lsp takes no arguments — it is an LSP server on stdio'
    return 1
}

_caustic_lsp "$@"
