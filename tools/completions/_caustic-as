#compdef caustic-as caustic-as.exe caustic-as.cse caustic-as.cse.exe caustic-as-universal.cse caustic-as-universal.cse.exe
# caustic-as — zsh completion.  Flags mirror caustic-assembler/main.cst:main.
#
# The assembler takes two flags and one input; the object it writes is named
# after that input (<f>.s -> <f>.s.o), so there is no -o to complete.
#
# install:  <prefix>/share/zsh/site-functions/_caustic-as
#     or:   ln -s .../tools/completions/_caustic-as  <a dir on your $fpath>

(( $+functions[_caustic_triples] )) || _caustic_triples() {
    local -a triples=(
        'linux-x86_64:static ELF, no libc — the default'
        'linux-aarch64:static ARM64 ELF'
        'windows-x86_64:PE/COFF .exe, kernel32 through the IAT'
        'windows-aarch64:ARM64 PE — refused, not implemented yet'
        'caustic:CSE container carrying x86_64 and ARM64'
        'caustic-x86_64:CSE image, x86_64'
        'caustic-aarch64:CSE image, ARM64'
        'caustic-x86_64-aarch64:CSE container, both architectures'
        'wasm32-wasi:WebAssembly module, 32-bit linear memory'
        'wasm32:alias of wasm32-wasi'
        'wasm64-wasi:WebAssembly with memory64'
        'wasm64:alias of wasm64-wasi'
    )
    _describe -t triples 'target triple' triples
}

_caustic_as() {
    _arguments -S \
        '--profile[report per-pass timing]' \
        '--target=[assemble for this triple]:triple:_caustic_triples' \
        '*:assembly source:_files -g "*.s(-.)"'
}

_caustic_as "$@"
